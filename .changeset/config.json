{
	"$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
	"changelog": "@changesets/cli/changelog",
	"commit": false,
	"fixed": [],
	"linked": [],
	"access": "public",
	"baseBranch": "master",
	"updateInternalDependencies": "patch",
	"ignore": [],
	"privatePackages": { "version": false, "tag": false },
	"snapshot": { "useCalculatedVersion": true },
	"___experimentalUnsafeOptions_WILL_CHANGE_IN_PATCH": { "updateInternalDependents": "always" },
	"changedFilePatterns": ["src/**", "skill/**", "claude/**", "docs/**", "package.json", "README.md"]
}
