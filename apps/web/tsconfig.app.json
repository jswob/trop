{
	"extends": "@jswob/style-guide/typescript/react",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"erasableSyntaxOnly": true,
		"noUncheckedSideEffectImports": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src"]
}
