{
	"name": "@app/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b --noEmit",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"e2e": "bun --env-file=../../.env playwright test",
		"e2e:ui": "bun --env-file=../../.env playwright test --ui",
		"e2e:headed": "bun --env-file=../../.env playwright test --headed",
		"e2e:debug": "bun --env-file=../../.env playwright test --debug",
		"e2e:codegen": "bun --env-file=../../.env playwright codegen",
		"e2e:install": "playwright install chromium"
	},
	"dependencies": {
		"@elysiajs/eden": "^1.3.2",
		"@internationalized/date": "^3.12.2",
		"@app/api": "workspace:*",
		"@app/ui": "workspace:*",
		"@tanstack/react-query": "^5.85.3",
		"@tanstack/react-query-devtools": "^5.85.3",
		"@tanstack/react-router": "^1.120.3",
		"lucide-react": "^1.0.0",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@jswob/style-guide": "workspace:*",
		"@playwright/test": "1.64.1",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/router-plugin": "1.168.46",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"jsdom": "30.1.2",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	}
}
