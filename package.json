{
	"name": "app",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.3",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"api:build": "bun --cwd apps/api build",
		"api:dev": "bun --cwd apps/api dev",
		"api:test": "bun --cwd apps/api test:run",
		"api:typecheck": "bun --cwd apps/api typecheck",
		"build": "bun web:build && bun api:build",
		"changeset": "changeset",
		"clean:dist": "rm -rf apps/*/dist apps/*/build",
		"clean:modules": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
		"clean": "bun clean:modules && bun clean:dist",
		"db:base": "bun --cwd apps/api db:base",
		"db:clean": "bun --cwd apps/api db:clean",
		"db:down": "docker-compose stop postgres postgres-test postgres-e2e",
		"db:generate:custom": "bun --cwd apps/api db:generate:custom",
		"db:generate": "bun --cwd apps/api db:generate",
		"db:migrate:status": "bun --cwd apps/api db:migrate:status",
		"db:migrate": "bun --cwd apps/api db:migrate",
		"db:push:safe": "bun --cwd apps/api db:push:safe",
		"db:push": "bun --cwd apps/api db:push",
		"db:reset": "bun --cwd apps/api db:reset",
		"db:restore": "bun --cwd apps/api db:restore",
		"db:schema:check": "bun --cwd apps/api schema:check",
		"db:seed:delete": "bun --cwd apps/api db:seed:delete",
		"db:constraints": "bun --cwd apps/api db:constraints",
		"db:seed": "bun --cwd apps/api db:seed",
		"db:snapshot:list": "bun --cwd apps/api db:snapshot:list",
		"db:snapshot": "bun --cwd apps/api db:snapshot",
		"db:undo": "bun --cwd apps/api db:undo",
		"db:up": "docker-compose up -d",
		"designs": "bun --cwd apps/workbench designs",
		"designs:host": "bun --cwd apps/workbench designs:host",
		"designs:census": "bun --cwd apps/workbench designs:census",
		"designs:probe": "bun --cwd apps/workbench designs:probe",
		"designs:x": "bun --cwd apps/workbench designs:x",
		"designs:test": "bun --cwd apps/workbench test:run",
		"designs:typecheck": "bun --cwd apps/workbench typecheck",
		"dev": "concurrently \"bun:*:dev\" --prefix-colors auto",
		"down": "docker-compose --profile '*' down",
		"drizzle-fixtures:test": "bun --cwd packages/drizzle-fixtures test --run",
		"drizzle-fixtures:test:integration": "bun --cwd packages/drizzle-fixtures test --run src/integration",
		"drizzle-fixtures:typecheck": "bun --cwd packages/drizzle-fixtures typecheck",
		"drizzle-snapshots:test": "bun --cwd packages/drizzle-snapshots test --run",
		"drizzle-snapshots:typecheck": "bun --cwd packages/drizzle-snapshots typecheck",
		"drizzle-utils:test": "bun --cwd packages/drizzle-utils test --run",
		"drizzle-utils:typecheck": "bun --cwd packages/drizzle-utils typecheck",
		"e2e:headed": "bun --cwd apps/web e2e:headed",
		"e2e:install": "bun --cwd apps/web e2e:install",
		"e2e:restore": "bun --cwd apps/api e2e:restore",
		"e2e:setup": "bun --cwd apps/api e2e:setup",
		"e2e:ui": "bun --cwd apps/web e2e:ui",
		"e2e": "bun --cwd apps/web e2e",
		"evals:doctor": "bun --cwd apps/evals evals doctor",
		"evals:key": "bun --cwd apps/evals evals key",
		"evals:report": "bun --cwd apps/evals evals report",
		"evals:run": "bun --cwd apps/evals evals run",
		"evals:selftest": "bun --cwd apps/evals evals selftest",
		"evals:test": "bun --cwd apps/evals test --run",
		"evals:try": "bun --cwd apps/evals evals try",
		"evals:typecheck": "bun --cwd apps/evals typecheck",
		"evals:view": "bun --cwd apps/evals evals view",
		"format:check": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0 && prettier --check .",
		"format:eslint": "eslint . --fix --ext .ts,.tsx,.js,.jsx",
		"format:prettier": "prettier --write .",
		"format": "eslint . --fix --ext .ts,.tsx,.js,.jsx && prettier --write .",
		"llm-evals:test": "bun --cwd packages/llm-evals test --run",
		"llm-evals:typecheck": "bun --cwd packages/llm-evals typecheck",
		"lint:fix": "eslint . --fix --ext .ts,.tsx,.js,.jsx",
		"lint": "eslint . --report-unused-disable-directives --max-warnings 0 && bun typecheck && bun toolkit:check",
		"prepare": "husky",
		"refresh": "bun clean && bun install",
		"release:publish": "bun scripts/release.ts",
		"release:version": "changeset version && bun install && toolkit sync",
		"scripts:test": "vitest --run --project scripts",
		"scripts:typecheck": "tsc -p scripts",
		"setup": "bun scripts/setup.ts",
		"test:ui": "bun --cwd apps/api test:setup && vitest --ui",
		"test:watch": "bun --cwd apps/api test:setup && vitest",
		"test": "bun --cwd apps/api test:setup && vitest --run",
		"template:test": "vitest --run --project template",
		"template:typecheck": "tsc -p template",
		"toolkit:check": "toolkit check",
		"toolkit:test": "bun --cwd packages/toolkit test --run",
		"toolkit:typecheck": "bun --cwd packages/toolkit typecheck",
		"typecheck": "concurrently --max-processes 1 \"bun:*:typecheck\"",
		"ui:test": "bun --cwd packages/ui test --run",
		"ui:typecheck": "bun --cwd packages/ui typecheck",
		"up": "docker-compose --profile '*' up -d --build",
		"web:build": "bun --cwd apps/web build",
		"web:dev": "bun --cwd apps/web dev",
		"web:test": "bun --cwd apps/web test:run",
		"web:typecheck": "bun --cwd apps/web typecheck",
		"workbench": "bun --cwd apps/workbench workbench",
		"workbench:test": "bun --cwd packages/workbench test --run",
		"workbench:typecheck": "bun --cwd packages/workbench typecheck"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@eslint/js": "10.0.1",
		"@jswob/style-guide": "workspace:*",
		"@jswob/toolkit": "workspace:*",
		"@types/bun": "1.4.3",
		"@types/semver": "7.8.0",
		"@typescript/native": "npm:typescript@7.0.2",
		"concurrently": "10.0.6",
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-react-hooks": "7.1.1",
		"globals": "17.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"semver": "7.8.5",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "8.71.2",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "5.0.5"
	},
	"toolkit": {
		"agnostic": {
			"paths": [
				"packages/config",
				"packages/drizzle-fixtures",
				"packages/drizzle-snapshots",
				"packages/drizzle-utils",
				"packages/llm-evals",
				"packages/toolkit",
				"packages/workbench"
			],
			"words": []
		}
	}
}
