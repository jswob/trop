{
	"name": "@jswob/drizzle-fixtures",
	"version": "0.1.1",
	"description": "Type-safe test data for Drizzle ORM: fixtures, traits, hooks and composed factories",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jswob/bun-monorepo.git",
		"directory": "packages/drizzle-fixtures"
	},
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./types": "./src/types/index.ts"
	},
	"files": [
		"src",
		"docs",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/integration",
		"!src/fixtures"
	],
	"scripts": {
		"test": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"drizzle-orm": ">=0.44.4 <1"
	},
	"devDependencies": {
		"@faker-js/faker": "10.6.0",
		"@jswob/style-guide": "workspace:*",
		"@types/node": "26.6.5",
		"drizzle-orm": "0.45.4",
		"postgres": "3.4.9",
		"typescript": "7.0.2",
		"vite-tsconfig-paths": "6.1.1",
		"vitest": "5.0.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
