{
	"name": "@jswob/design-workbench",
	"version": "0.1.2",
	"description": "A design workbench that stages an app's screens on fixtures, with its verbs and its Claude Code skill",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jswob/bun-monorepo.git",
		"directory": "packages/workbench"
	},
	"type": "module",
	"bin": {
		"workbench": "./src/cli/main.ts"
	},
	"files": [
		"src",
		"skill",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/test"
	],
	"exports": {
		".": "./src/index.ts",
		"./config": "./src/config.ts",
		"./thesis": "./src/cli/thesis.ts"
	},
	"claude": {
		"skills": {
			"design": "skill"
		}
	},
	"scripts": {
		"test": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@jswob/toolkit": "workspace:^",
		"@playwright/test": "^1.50.0",
		"@tanstack/router-plugin": "^1.120.3",
		"zod": "^4.0.0"
	},
	"peerDependencies": {
		"@tanstack/react-router": "^1.120.3",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"vite": "^7.1.2 || ^8.0.0"
	},
	"devDependencies": {
		"@jswob/style-guide": "workspace:*",
		"@tanstack/react-router": "1.170.44",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"jsdom": "30.1.2",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.5"
	},
	"publishConfig": {
		"access": "public"
	}
}
