+  - 'crates/**/*.rs'
+ignores:
+  - 'crates/*/tests/**'
+  - 'crates/*/benches/**'
+utils:
+  in-test-module:
+    inside:
+      kind: mod_item
+      stopBy: end
+      follows:
+        kind: attribute_item
+        regex: '^#\[cfg\(test\)\]$'
+        stopBy:
+          not:
+            any:
+              - kind: attribute_item
+              - kind: line_comment
+              - kind: block_comment
+rule:
+  kind: index_expression
+  not:
+    matches: in-test-module
diff --git a/engine/tools/ast-grep/rules/no-macro-definition.yml b/engine/tools/ast-grep/rules/no-macro-definition.yml
new file mode 100644
