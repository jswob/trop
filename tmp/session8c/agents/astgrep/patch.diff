diff --git a/engine/tools/ast-grep/rules/no-dyn.yml b/engine/tools/ast-grep/rules/no-dyn.yml
new file mode 100644
index 0000000..ebbcaf3
--- /dev/null
+++ b/engine/tools/ast-grep/rules/no-dyn.yml
@@ -0,0 +1,16 @@
+id: no-dyn
+language: rust
+severity: error
+message: 'R-122: no dyn (trait objects) in the engine: dispatch through an enum and an exhaustive match'
+note: "Every trait object, in any position: &dyn T, Box<dyn T>, dyn Fn(..), and dyn written inside a macro's arguments. Tests included. A real need is a STOP-REPORT and a rules change (R-112); ast-grep rules take no #[expect] (R-109)."
+files:
+  - 'crates/**/*.rs'
+  - 'tests/runner/**/*.rs'
+rule:
+  any:
+    - kind: dynamic_type
+    - kind: identifier
+      regex: '^dyn$'
+      inside:
+        kind: token_tree
+        stopBy: end
diff --git a/engine/tools/ast-grep/rules/no-index.yml b/engine/tools/ast-grep/rules/no-index.yml
