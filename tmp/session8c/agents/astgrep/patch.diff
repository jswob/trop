index 0000000..5478fe1
--- /dev/null
+++ b/engine/tools/ast-grep/rules/no-index.yml
@@ -0,0 +1,28 @@
+id: no-index
+language: rust
+severity: error
+message: 'R-5: no indexing or slicing (v[i], v[a..], m[&k]) outside tests, maps included: use get and handle the miss'
