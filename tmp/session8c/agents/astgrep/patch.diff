diff --git a/engine/tools/ast-grep/rules/no-underscore-discard.yml b/engine/tools/ast-grep/rules/no-underscore-discard.yml
new file mode 100644
index 0000000..b66ef28
--- /dev/null
+++ b/engine/tools/ast-grep/rules/no-underscore-discard.yml
@@ -0,0 +1,46 @@
+id: no-underscore-discard
+language: rust
+severity: error
+message: 'R-66: no result discarded through _ = call() or let _name = call() in library code: handle the error or return it'
+note: "let _ = call() is clippy's let_underscore_must_use (and rustc's let_underscore_drop); this rule sees the two forms they don't. A call ending in ? isn't a discard: its error is returned. Test modules may."
+files:
+  - 'crates/*/src/**/*.rs'
+utils:
+  in-test-module:
+    inside:
+      kind: mod_item
+      stopBy: end
+      follows:
+        kind: attribute_item
+        regex: '^#\[cfg\(test\)\]$'
+        stopBy:
+          not:
+            any:
+              - kind: attribute_item
+              - kind: line_comment
+              - kind: block_comment
+  a-call:
+    any:
+      - kind: call_expression
+      - kind: macro_invocation
+rule:
+  any:
+    - kind: assignment_expression
+      has:
+        field: left
+        regex: '^_$'
+      all:
+        - has:
+            field: right
+            matches: a-call
+    - kind: let_declaration
+      has:
+        field: pattern
+        kind: identifier
+        regex: '^_\w+$'
+      all:
+        - has:
+            field: value
+            matches: a-call
+  not:
+    matches: in-test-module
diff --git a/engine/tools/ast-grep/rules/no-unwrap-path.yml b/engine/tools/ast-grep/rules/no-unwrap-path.yml
new file mode 100644
index 0000000..47fd83b
--- /dev/null
+++ b/engine/tools/ast-grep/rules/no-unwrap-path.yml
@@ -0,0 +1,29 @@
+id: no-unwrap-path
+language: rust
+severity: error
+message: 'R-2: no unwrap or expect written as a path (Option::unwrap, Result::expect, map(Option::unwrap)) outside tests: handle the missing value'
+note: "Option::{unwrap, expect} and Result::{unwrap, expect, unwrap_err, expect_err} named by path, with or without std::/core:: and turbofish; clippy's unwrap_used and expect_used see only the method-call form. Tests may: crates/*/tests/, benches, and a module right after #[cfg(test)]."
+files:
+  - 'crates/**/*.rs'
+ignores:
+  - 'crates/*/tests/**'
+  - 'crates/*/benches/**'
+utils:
+  in-test-module:
+    inside:
+      kind: mod_item
+      stopBy: end
+      follows:
+        kind: attribute_item
+        regex: '^#\[cfg\(test\)\]$'
+        stopBy:
+          not:
+            any:
+              - kind: attribute_item
+              - kind: line_comment
+              - kind: block_comment
+rule:
+  kind: scoped_identifier
+  regex: '(?s)^(::\s*)?<?\s*((std|core)\s*::\s*(option|result)\s*::\s*)?(Option|Result)\b.*::\s*(unwrap|expect|unwrap_err|expect_err)$'
+  not:
+    matches: in-test-module
