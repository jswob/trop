diff --git a/engine/tools/ast-grep/rules/derive-order-review.yml b/engine/tools/ast-grep/rules/derive-order-review.yml
new file mode 100644
index 0000000..5b85aa1
--- /dev/null
+++ b/engine/tools/ast-grep/rules/derive-order-review.yml
@@ -0,0 +1,25 @@
+id: derive-order-review
+language: rust
+severity: warning
+message: "R-118 (report): a derived PartialOrd or Ord (an order written from the source's field and variant order), listed for review: it must never reach output or a split (R-47)"
+files:
+  - 'crates/*/src/**/*.rs'
+utils:
+  in-test-module:
+    inside:
+      kind: mod_item
+      stopBy: end
+      follows:
+        kind: attribute_item
+        regex: '^#\[cfg\(test\)\]$'
+        stopBy:
+          not:
+            any:
+              - kind: attribute_item
+              - kind: line_comment
+              - kind: block_comment
+rule:
+  kind: attribute_item
+  regex: '(?s)\bderive\s*\(.*\b(PartialOrd|Ord)\b'
+  not:
+    matches: in-test-module
diff --git a/engine/tools/ast-grep/rules/inline-hint-review.yml b/engine/tools/ast-grep/rules/inline-hint-review.yml
new file mode 100644
index 0000000..e6aab86
--- /dev/null
+++ b/engine/tools/ast-grep/rules/inline-hint-review.yml
@@ -0,0 +1,30 @@
+id: inline-hint-review
+language: rust
+severity: warning
+message: 'R-130 (report): #[inline(always)] or #[cold] outside a fence, listed for review: optimised code lives only in fence modules'
+note: "The fences are this rule's ignores:, empty at the scaffold; the lead adds each fence's file through R-112."
+files:
+  - 'crates/*/src/**/*.rs'
+# The fences (R-130): one file each, added by the lead through R-112.
+ignores: []
+utils:
+  in-test-module:
+    inside:
+      kind: mod_item
+      stopBy: end
+      follows:
+        kind: attribute_item
+        regex: '^#\[cfg\(test\)\]$'
+        stopBy:
+          not:
+            any:
+              - kind: attribute_item
+              - kind: line_comment
+              - kind: block_comment
+rule:
+  any:
+    - kind: attribute_item
+    - kind: inner_attribute_item
+  regex: '(?s)^#!?\[\s*(cfg_attr\s*\(.*[(,]\s*)?(cold|inline\s*\(\s*always\s*\))\s*[,)\]]'
+  not:
+    matches: in-test-module
diff --git a/engine/tools/ast-grep/rules/lifetime-review.yml b/engine/tools/ast-grep/rules/lifetime-review.yml
new file mode 100644
index 0000000..58ae92f
--- /dev/null
+++ b/engine/tools/ast-grep/rules/lifetime-review.yml
@@ -0,0 +1,33 @@
+id: lifetime-review
+language: rust
+severity: warning
+message: "R-124 (report): an explicit lifetime, listed for review: only on short-lived views (a cursor over a text, a borrowed slice)"
+note: "Reported where each named lifetime is declared: in <'a, ...> on an item or impl, or in for<'a>. Every other named lifetime refers to one of those. 'static and '_ (which elided_lifetimes_in_paths requires) are not reported."
+files:
+  - 'crates/*/src/**/*.rs'
+utils:
+  in-test-module:
+    inside:
+      kind: mod_item
+      stopBy: end
+      follows:
+        kind: attribute_item
+        regex: '^#\[cfg\(test\)\]$'
+        stopBy:
+          not:
+            any:
+              - kind: attribute_item
+              - kind: line_comment
+              - kind: block_comment
+rule:
+  kind: lifetime
+  not:
+    any:
+      - regex: "^'(static|_)$"
+      - matches: in-test-module
+  any:
+    - inside:
+        kind: lifetime_parameter
+        field: name
+    - inside:
+        kind: for_lifetimes
diff --git a/engine/tools/ast-grep/rules/long-chain-review.yml b/engine/tools/ast-grep/rules/long-chain-review.yml
new file mode 100644
index 0000000..3e544dc
--- /dev/null
+++ b/engine/tools/ast-grep/rules/long-chain-review.yml
@@ -0,0 +1,65 @@
+id: long-chain-review
+language: rust
+severity: warning
+message: 'R-125 (report): a chain of 5 or more method calls, listed for review: about 4 steps at most, then a named function or a loop'
+note: "Counts the .name(..) calls along one chain (turbofish and ? between them included); the chain's first receiver, a call like Foo::new(), isn't counted. One hit per chain, on its last call."
+files:
+  - 'crates/*/src/**/*.rs'
+utils:
+  in-test-module:
+    inside:
+      kind: mod_item
+      stopBy: end
+      follows:
+        kind: attribute_item
+        regex: '^#\[cfg\(test\)\]$'
+        stopBy:
+          not:
+            any:
+              - kind: attribute_item
+              - kind: line_comment
+              - kind: block_comment
+  # a method call: x.f(..) or x.f::<T>(..)
+  method-call:
+    kind: call_expression
+    has:
+      field: function
+      any:
+        - kind: field_expression
+        - kind: generic_function
+          has:
+            field: function
+            kind: field_expression
+  # the nodes a chain runs through, from a call down to its receiver; anything else ends it
+  off-chain:
+    not:
+      any:
+        - kind: call_expression
+        - kind: field_expression
+        - kind: generic_function
+        - kind: try_expression
+rule:
+  matches: method-call
+  has:
+    stopBy:
+      matches: off-chain
+    matches: method-call
+    has:
+      stopBy:
+        matches: off-chain
+      matches: method-call
+      has:
+        stopBy:
+          matches: off-chain
+        matches: method-call
+        has:
+          stopBy:
+            matches: off-chain
+          matches: method-call
+  not:
+    any:
+      - inside:
+          stopBy:
+            matches: off-chain
+          matches: method-call
+      - matches: in-test-module
