model rule09
  tally 1
  on 2025-01-01
  note "RULE-09 part a: house rule D-3 decided on 1 January 2025 over that date's 5 paths. The card states which paths run dry, not the draws, so the outcome per path is a row keyed by the path's number."

source card "Probe card RULE-09: Halina's forecast of 1 January 2025 and house rule D-3"

index run = 1..5

input limit: num

input runs_dry[k in run]: bool

def ruined[p in path]: bool = runs_dry[p]

ask q_a: share(p in path: ruined[p]), share(p in path: ruined[p]) > limit paths 5 seed 1

version card_forecast
  cite card
  known 2025-01-01
  limit = 0.2 "D-3: more than 20 % of the paths"
  runs_dry = false "the forecast of 1 January 2025: the money lasts to 85"
  runs_dry[2] = true "path 2 runs dry before 85"
  runs_dry[4] = true "path 4 runs dry before 85"
