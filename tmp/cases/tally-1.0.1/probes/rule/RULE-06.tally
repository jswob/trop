model rule06
  tally 1
  on 2025-04-15
  start 2025-01-01
  end 2025-04-30
  note "RULE-06: rule B-1's floor raised on 10 April to 3 000.00 from January. The sweeps of January to March stay as done (a state pay is never re-measured, L 5.13.3); the gap is read against what they left."

source card "Probe card RULE-06: Piotr and Ola's account, what the sweeps left"

source rule_b1_v1 "House rule B-1, version 1, from 1 January 2025"

source rule_b1_v2 "House rule B-1, version 2, written 10 April 2025: keep 3 000.00, from January"

index month = month 2025-01..2025-04

place konto: account DUK

place savings: account DUK

input keep_floor[m in month]: money DUK

pay sweep[m in month]
  from konto
  to savings
  amount max(0, bal(konto) - keep_floor[m])
  on day_of(m, 15)

ask q_gap: keep_floor[m] - bal(konto, day_of(m, 15)) for m in [2025-01, 2025-02, 2025-03]

ask q_total: sum(m in month where m <= 2025-03: keep_floor[m] - bal(konto, day_of(m, 15)))

ask q_floor: keep_floor[2025-04]

ask q_not_rebooked: check flows(savings, 2025-02-01..2025-04-14) = flows(savings, 2025-02-01..2025-04-14) as if {known 2025-04-09}

version b1_v1
  cite rule_b1_v1
  governs 2025-01..
  known 2025-01-01
  keep_floor = 2000 "B-1 v1: keep 2 000.00 and sweep the rest"

version done_q1
  cite card
  known 2025-01-01
  stated[konto] = 2000 governs 2025-01-15 "the January sweep left 2 000.00"
  stated[konto] = 2000 governs 2025-02-15 "the February sweep left 2 000.00"
  stated[konto] = 2000 governs 2025-03-15 "the March sweep left 2 000.00"

version b1_v2
  cite rule_b1_v2
  governs 2025-01..
  known 2025-04-10
  keep_floor = 3000 "B-1 v2: keep 3 000.00, from January"
