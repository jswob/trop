model rule08
  tally 1
  on 2025-06-15
  note "RULE-08: the 15th rule's floor is the mean of the three full months before the decision's month, half up to 0.01."

source card "Probe card RULE-08: Ania's spending and the 15th rule's floor"

index month = month 2025-01..2025-06

input spending[m in month]: money DUK

input window: int

def floor_on[m in month]: money DUK
  note "the floor on the 15th of month m"
  rule base = round(mean(k in month where k < m and m - k <= window: spending[k]), 0.01, half-up)

ask q: floor_on[2025-04], floor_on[2025-06]

version card_2025
  cite card
  known 2025-01-01
  spending[2025-01] = 3100 "January"
  spending[2025-02] = 2900 "February"
  spending[2025-03] = 3650 "March"
  spending[2025-04] = 3200 "April"
  spending[2025-05] = 2950 "May"
  window = 3 "rule 1: the three full months before the decision's month"
