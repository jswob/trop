model rule04
  tally 1
  on 2025-06-30
  note "RULE-04: R-X reads R-Y and R-Y reads R-X at the same key, and no law names a solver; the loader refuses the reality (LOAD-CYCLE), naming invest_x -> reserve_y -> invest_x."

source card "Probe card RULE-04: rules R-X and R-Y"

input available: money DUK question "How much is there before the tax reserve? The card doesn't say."

input gain_rate: num question "What gain does R-Y expect on what R-X invests this month? The card doesn't say."

input reserve_share: num

def invest_x: num DUK
  note "R-X: invest half of what is left after the tax reserve"
  rule rx = (available - reserve_y) / 2

def reserve_y: num DUK
  note "R-Y: the tax reserve is 20 % of the expected gains on what R-X invests"
  rule ry = reserve_share * gain_rate * invest_x

ask q: invest_x

version card_rules
  cite card
  known 2025-06-30
  reserve_share = 0.2 "R-Y: 20 %"
