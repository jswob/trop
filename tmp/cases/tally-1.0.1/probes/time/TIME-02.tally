model time02
  tally 1
  on 2026-10-25
  note "Probe TIME-02: due dates and the third-to-last business day under a holiday calendar that gains a holiday in 2026."

source probe_card "Probe card TIME-02 (made-up story and rules)"

index cmonth = month 2020-05..2026-06

input holidays: dates

def due[m in cmonth]: date at day_of(m + 1, 20)
  note "the contribution for month m is due by the 20th of the next month; if the 20th is not a business day, the next business day"
  rule base v card = next_business(day_of(m + 1, 20), holidays)

def third_last[m in cmonth]: date
  note "question (c): the third business day counted back from the end of month m"
  rule base v card = add_business(end_of(m), -3, holidays)

ask q_dates: due[2026-05], due[2020-05], third_last[2026-06]

version card
  cite probe_card
  known 2026-10-25
  holidays = [] governs ..2025 "rule 2: the 22 June holiday didn't exist before 2026"
  holidays = [2026-06-22] governs 2026 "rule 2: a holiday on 22 June, in force from 2026"
