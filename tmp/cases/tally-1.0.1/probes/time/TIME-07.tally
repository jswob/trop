model time07
  tally 1
  on 2025-05-31
  start 2025-05-01
  end 2025-05-31
  note "Probe TIME-07: pay and the 15th rule on one day, in the stated order and in the reverse."

source probe_card "Probe card TIME-07 (made-up story and rules)"

place konto: account DUK
place savings: account DUK

input keep_floor: money DUK
input pay_amt: money DUK
input pay_day: date
input rule_day: date

pay sweep
  from konto
  to savings
  amount max(0, bal(konto) - keep_floor)
  on rule_day

pay wage
  from outside_duk
  to konto
  amount pay_amt
  on pay_day

ask q_reverse: max(0, bal(konto, add_days(rule_day, -1)) - keep_floor)

ask q_stated: flows(sweep, 2025-05-15)

version card
  cite probe_card
  known 2025-05-01
  note "Stipulations, known from the model's start (L §4.5)."
  keep_floor = 2000.00 "rule 1: keep a floor of 2 000.00"
  opening[konto] = 1500.00 "story: 1 500.00 before anything happens on 15 May 2025; no movement before it"
  opening[savings] = 0 "no balance stated; nothing reads it"
  pay_amt = 6000.00 "story: her pay"
  pay_day = 2025-05-15 "story: the pay lands on 15 May 2025"
  rule_day = 2025-05-15 "story: the 15th rule runs that day"
