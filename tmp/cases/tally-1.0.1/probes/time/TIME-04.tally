model time04
  tally 1
  on 2026-10-25
  note "Probe TIME-04: a June-May benefit period split by a birth in October."

source probe_card "Probe card TIME-04 (made-up story and rules)"

index bmonth = month 2023-06..2024-05
  v card
  note "the benefit period, June 2023 to May 2024"
index child = [zosia]

input born[c in child]: date
input monthly_amt: money DUK

def monthly_benefit[c in child, m in bmonth]: money DUK
  note "rule 1: for each month of the period in which the child lives; rule 2: the month of birth pro-rated by its own days"
  rule birth_month excepts full v card when month_of(born[c]) = m = round(monthly_amt * overlap_days(born[c], add_days(end_of(m), -1), m) / days(start_of(m), end_of(m)), 0.01, half-up)
  rule full v card = monthly_amt
  rule unborn excepts full v card when born[c] >= end_of(m) = 0

def period_total[c in child]: money DUK = sum(m in bmonth: monthly_benefit[c, m])

ask q_benefit: monthly_benefit[zosia, 2023-10], period_total[zosia]

version card
  cite probe_card
  known 2026-10-25
  born[zosia] = 2023-10-17 "story: born on 17 October 2023"
  monthly_amt = 100.00 "rule 1"
