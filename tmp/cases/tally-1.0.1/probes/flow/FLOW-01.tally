model flow01
  tally 1
  on 2026-10-25
  start 2025-01-01
  end 2025-01-31
  note "FLOW-01: a wallet counted twice; the balancing flow between the counts."
  note "The counts are stated balances (LANGUAGE 5.18): each anchors the wallet. An anchor books nothing; its difference, stated - booked, is the balance line of the residual ledger (ENGINE 6.3)."

source card "Probe card FLOW-01 (made up): story and rules"

place bank: account DUK

place wallet: cash DUK

input atm_amount: money DUK

input atm_day: date

input count_end: date

input count_start: date

def balancing: money DUK
  note "rules 1-2: end - start - recorded flows"
  rule base v card_rules = bal(wallet, count_end) - bal(wallet, count_start) - flows(wallet, add_days(count_start, 1)..count_end)

pay atm
  from bank
  to wallet
  amount atm_amount
  on atm_day

ask q_balancing: balancing

ask q_holds: check bal(wallet, 2025-01-01) + flows(wallet, 2025-01-02..2025-01-31) + balancing = bal(wallet, 2025-01-31)

ask q_ledger: residuals wallet 2025-01-02..2025-01-31

version card_facts
  cite card
  known 2025-01-01
  atm_amount = 300.00 "story: 300.00 from the cash machine"
  atm_day = 2025-01-10 "story: on 10 January"
  count_end = 2025-01-31 "story"
  count_start = 2025-01-01 "story"
  stated[wallet] = 400.00 governs 2025-01-01 "story: counted 400.00 on 1 January 2025"
  stated[wallet] = 250.00 governs 2025-01-31 "story: counted 250.00 on 31 January"

version card_rules
  cite card
  known 2025-01-01
