model flow02
  tally 1
  on 2026-10-25
  start 2024-09-01
  end 2024-09-30
  note "FLOW-02: a car sale whose price goes to the lender, the dealer's fee and the owners."
  note "The legs are three pays sharing one date. Tally has no event that groups pays, so nothing makes them settle together (LANGUAGE 5.13)."

source card "Probe card FLOW-02 (made up): story and rules"

place buyer: outside DUK

place car_credit: debt DUK

place dealer: outside DUK

place owners_acc: account DUK

input dealer_fee: money DUK

input payoff_amount: money DUK

input sale_day: date

input sale_price: money DUK

def owners_amount: money DUK
  note "rules 1-2: the rest of the price to the owners"
  rule base v card_rules = sale_price - payoff_amount - dealer_fee

pay leg_fee
  from buyer
  to dealer
  amount dealer_fee
  on sale_day

pay leg_lender
  from buyer
  to car_credit
  amount payoff_amount
  on sale_day

pay leg_owners
  from buyer
  to owners_acc
  amount owners_amount
  on sale_day

ask q_legs: flows(leg_lender, 2024-09), flows(leg_fee, 2024-09), flows(leg_owners, 2024-09)

ask q_legs_sum: check flows(leg_lender, 2024-09) + flows(leg_fee, 2024-09) + flows(leg_owners, 2024-09) = sale_price

version card_facts
  cite card
  known 2024-09-01
  dealer_fee = 600.00 "story: keeps a fee of 600.00"
  opening[car_credit] = -18350.00 "story: the credit's payoff"
  opening[owners_acc] = 0.00
  payoff_amount = 18350.00 "story: the credit's payoff, 18 350.00"
  sale_day = 2024-09-15 "story: 15 September 2024"
  sale_price = 42000.00 "story: for 42 000.00"

version card_rules
  cite card
  known 2024-09-01
