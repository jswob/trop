model cur02
  tally 1
  on 2026-10-25
  note "CUR-02: ten conversions against their total converted once. The payments give no dates, so the money is written as defs (LANGUAGE 5.9)."

source card "Probe card CUR-02 (made up): story and rules"

index payment = 1..10

input amount[i in payment]: money FLR

input fx: num DUK/FLR

def booked: money DUK = sum(i in payment: converted[i])

def converted[i in payment]: money DUK
  note "rule 1: each converted transfer a whole number of minor units, half up"
  rule base v card_rules = round(amount[i] * fx, 0.01, half-up)

def difference: money DUK = view - booked

def view: money DUK
  note "rule 2: the total converted at once, a view"
  rule base v card_rules = round(sum(i in payment: amount[i]) * fx, 0.01, half-up)

ask q_totals: booked, view, difference

version card_facts
  cite card
  known 2026-10-25
  amount = 33.33 "story: ten payments of 33.33 FLR each"
  fx = 4.2857 "story: converted at 4.2857"

version card_rules
  cite card
  known 2026-10-25
