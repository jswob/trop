model own04
  tally 1
  on 2026-10-25
  start 2025-01-01
  end 2025-12-31
  note "OWN-04: one flat under each of four regimes; each person's part."
  note "Ownership is owns[p, x] with stakes in an entity looked through once (LANGUAGE 3.6); the regime is a key of an index (N-506)."

source card "Probe card OWN-04 (made up): story and rules"

index party = [ania, tomek, piotr, ola, halina, marta, kuba, zb_estate]

index regime = [community, separate, co_owned, in_estate]

place flat_co: asset DUK priced flat_value

place flat_comm: asset DUK priced flat_value

place flat_est: asset DUK priced flat_value

place flat_sep: asset DUK priced flat_value

input community_part: num

input flat_value: money DUK

input owns[p in party, x in place]: num

input regime_of[x in place]: key regime

input spouse_in[p in party, x in place]: bool

input stake[p in party, e in party]: num

input valued_on: date

def part_value[p in party, x in place]: num DUK = worth(x, valued_on) * share_of[p, x]

def share_of[p in party, x in place]: num
  note "rule 1: community half to each spouse; separate, co-owned and the estate by their shares"
  rule base v card_rules = owns[p, x] + sum(e in party: stake[p, e] * owns[e, x])
  rule comm excepts base v card_rules when regime_of[x] = community = if spouse_in[p, x] then community_part else 0

ask q_co_owned: part_value[p, flat_co] for p in [piotr, ola]

ask q_community: part_value[p, flat_comm] for p in [ania, tomek]

ask q_estate: part_value[p, flat_est] for p in [halina, ania, piotr, marta, kuba]

ask q_separate: part_value[p, flat_sep] for p in [ania]

version card_facts
  cite card
  known 2025-01-01
  flat_value = 300000.00 "story: each worth 300 000.00"
  owns = 0 "story: no other owner"
  owns[ania, flat_sep] = 1 "story: Ania's separate property"
  owns[piotr, flat_co] = 0.6 "story: Piotr and Ola 60/40"
  owns[ola, flat_co] = 0.4 "story: Piotr and Ola 60/40"
  owns[zb_estate, flat_est] = 1 "story: in Zbigniew's estate"
  regime_of[flat_co] = co_owned "story"
  regime_of[flat_comm] = community "story"
  regime_of[flat_est] = in_estate "story"
  regime_of[flat_sep] = separate "story"
  spouse_in = false "story"
  spouse_in[ania, flat_comm] = true "story: Ania and Tomek's community property"
  spouse_in[tomek, flat_comm] = true "story: Ania and Tomek's community property"
  stake = 0 "story: no other stake"
  stake[halina, zb_estate] = 0.25 "story: Halina 1/4"
  stake[ania, zb_estate] = 0.1875 "story: 3/16"
  stake[piotr, zb_estate] = 0.1875 "story: 3/16"
  stake[marta, zb_estate] = 0.1875 "story: 3/16"
  stake[kuba, zb_estate] = 0.1875 "story: 3/16"
  valued_on = 2025-01-01 "story: the value stated, no date given"

version card_rules
  cite card
  known 2025-01-01
  community_part = 0.5 "rule 1: half to each spouse"
