model own06
  tally 1
  on 2026-10-25
  note "OWN-06: a gifted lot whose cost the law sets at its value on the gift's day, sold later."

source card "Probe card OWN-06 (made up): story and rules"

unit fund_unit "a unit of fund F"

index lot = [gift_lot]

input gift_day[l in lot]: date

input giver_cost[l in lot]: money DUK

input lot_units[l in lot]: num fund_unit

input price_f: num DUK/fund_unit

input sale_day[l in lot]: date

def gain[l in lot]: num DUK = proceeds[l] - receiver_cost[l]

def gain_on_giver_cost[l in lot]: num DUK = proceeds[l] - giver_cost[l]

def proceeds[l in lot]: num DUK at sale_day[l] = lot_units[l] * price_f

def receiver_cost[l in lot]: num DUK at gift_day[l]
  note "rule 1: the gifted lot's cost is its value on the gift's day"
  rule base v card_rules = lot_units[l] * price_f

ask q_gain: receiver_cost[gift_lot], gain[gift_lot], gain_on_giver_cost[gift_lot]

version card_facts
  cite card
  known 2026-10-25
  gift_day[gift_lot] = 2023-05-10 "story: given on 10 May 2023"
  giver_cost[gift_lot] = 5000.00 "story: Halina bought them for 5 000.00"
  lot_units[gift_lot] = 100 "story: 100 units"
  price_f = 62.00 governs 2023-05-10 "story: that day's price"
  price_f = 70.00 governs 2024-08-01 "story: sold at 70.00"
  sale_day[gift_lot] = 2024-08-01 "story: sold on 1 August 2024"

version card_rules
  cite card
  known 2026-10-25
