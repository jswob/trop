model own07
  tally 1
  on 2026-10-25
  note "OWN-07: three lots in two accounts, one partial sale; FIFO within the account, and across both for contrast."

source card "Probe card OWN-07 (made up): story and rules"

unit g_unit "a unit of fund G"

index brokerage = [acc_x, acc_y]

index lot = [l1, l2, l3]

index sale = [s1]

input lot_account[l in lot]: key brokerage

input lot_bought[l in lot]: date

input lot_cost[l in lot]: money DUK

input lot_units[l in lot]: num g_unit

input sale_account[s in sale]: key brokerage

input sale_price: num DUK/g_unit

input sale_units[s in sale]: num g_unit

def cost[s in sale]: num DUK = sum(l in lot: fifo_account.taken[l, s] * lot_cost[l] / lot_units[l])

def cost_across[s in sale]: num DUK = sum(l in lot: fifo_across.taken[l, s] * lot_cost[l] / lot_units[l])

def gain[s in sale]: num DUK = proceeds[s] - cost[s]

def gain_across[s in sale]: num DUK = proceeds[s] - cost_across[s]

def proceeds[s in sale]: num DUK = sale_units[s] * sale_price

fill fifo_account
  v card_rules
  note "rule 1: first in, first out, within the account sold from"
  supply lot_units[l] for l in lot
  demand sale_units[s] for s in sale
  arc lot_account[l] = sale_account[s]
  order lot_bought[l]

fill fifo_across
  note "contrast: first in, first out across both accounts"
  supply lot_units[l] for l in lot
  demand sale_units[s] for s in sale
  arc true
  order lot_bought[l]

ask q_across: cost_across[s1], gain_across[s1]

ask q_per_account: cost[s1], gain[s1]

version card_facts
  cite card
  known 2026-10-25
  lot_account[l1] = acc_x "story: X: L1"
  lot_account[l2] = acc_y "story: Y: L2"
  lot_account[l3] = acc_x "story: X: L3"
  lot_bought[l1] = 2022-01-10 "story"
  lot_bought[l2] = 2022-03-01 "story"
  lot_bought[l3] = 2022-06-01 "story"
  lot_cost[l1] = 1000.00 "story"
  lot_cost[l2] = 1200.00 "story"
  lot_cost[l3] = 900.00 "story"
  lot_units[l1] = 10 "story"
  lot_units[l2] = 10 "story"
  lot_units[l3] = 10 "story"
  sale_account[s1] = acc_x "story: sells from X"
  sale_price = 130.00 "story: at 130.00"
  sale_units[s1] = 15 "story: 15 units"

version card_rules
  cite card
  known 2026-10-25
