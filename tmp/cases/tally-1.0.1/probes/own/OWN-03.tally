model own03
  tally 1
  on 2026-10-25
  start 2024-12-31
  end 2025-03-31
  note "OWN-03: next spring's tax on this year's income in net worth from the year's end; still owed at the run's end."

source card "Probe card OWN-03 (made up): story and rules"

index tyear = year 2024..2024

place konto: account DUK

place tax_debt: debt DUK

place tax_office: outside DUK

input tax_due[y in tyear]: date

input tax_for[y in tyear]: money DUK

pay tax_accrue[y in tyear]
  from tax_debt
  to tax_office
  amount tax_for[y]
  on add_days(end_of(y), -1)
  for y

pay tax_payment[y in tyear]
  from konto
  to tax_debt
  amount tax_for[y]
  on tax_due[y]
  for y

ask q_net_worth_dec31: sum(x in place where kind(x) = account or kind(x) = debt: bal(x, 2024-12-31))

ask q_owed_at_end: -bal(tax_debt, 2025-03-31), tax_due[2024]

version card_facts
  cite card
  known 2024-12-31
  opening[konto] = 10000.00 "story: holds 10 000.00 on 31 December 2024"
  opening[tax_debt] = 0.00
  tax_due[2024] = 2025-04-30 "story: due by 30 April 2025"
  tax_for[2024] = 1840.00 "story: her tax for 2024"
