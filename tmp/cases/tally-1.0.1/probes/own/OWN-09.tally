model own09
  tally 1
  on 2026-10-25
  note "OWN-09: one series of indexed bonds redeemed in its third interest year: interest per bond, the fee, the tax, the payout."

source card "Probe card OWN-09 (made up): story and rules"

index iyear = 1..3

index month = month 2023-01..2026-12

input bonds: int

input bought: date

input cpi_yoy[m in month]: rate simple /year
  note "the price index's yearly change, read by rule 1 as the reference rate"

input face: money DUK

input fee: money DUK

input first_rate: rate simple /year

input lag: int

input margin: rate simple /year

input redeemed: date

input tax_rate: num

def earned[k in iyear]: money DUK
  note "rule 2: per bond, half up to 0.01; a part year by its days over the interest year's days"
  rule full v card_rules = round(value[k] * periodic(rate_of[k], year), 0.01, half-up)
  rule part excepts full v card_rules when redeemed < year_end[k] = round(value[k] * periodic(rate_of[k], year) * days(year_start[k], redeemed) / days(year_start[k], year_end[k]), 0.01, half-up)
  rule unheld excepts part v card_rules when redeemed <= year_start[k] = 0

def fee_per_bond: money DUK
  note "rule 3: never more than the bond's interest"
  rule base v card_rules = min(fee, interest_per_bond)

def interest_per_bond: money DUK = sum(k in iyear: earned[k])

def payout: money DUK = bonds * (face + interest_per_bond) - bonds * fee_per_bond - tax

def rate_of[k in iyear]: rate simple /year
  note "rule 1: year 1 the first rate; later the index for the month lag months before the year starts, plus the margin"
  rule first excepts later v card_rules when k = 1 = first_rate
  rule later v card_rules = cpi_yoy[month_of(year_start[k]) - lag] + margin

def tax: money DUK
  note "rule 4: 19 % of the holding's interest less fees, half up to whole DUK"
  rule base v card_rules = round(tax_rate * bonds * (interest_per_bond - fee_per_bond), 1, half-up)

def value[k in iyear]: money DUK
  note "rule 2: capitalised yearly"
  rule first excepts later v card_rules when k = 1 = face
  rule later v card_rules = value[k - 1] + earned[k - 1]

def year_end[k in iyear]: date = add_years(bought, k)

def year_start[k in iyear]: date = add_years(bought, k - 1)

ask q_bonds: interest_per_bond, fee_per_bond, tax, payout

ask q_years: rate_of[k], earned[k] for k in iyear

version card_facts
  cite card
  known 2026-10-25
  bonds = 50 "story: 50 bonds"
  bought = 2023-03-01 "story: bought 1 March 2023"
  face = 100.00 "story: 100.00 each"
  redeemed = 2025-09-01 "story: redeemed 1 September 2025"

version card_rules
  cite card
  known 2026-10-25
  cpi_yoy[2024-01] = 0.037 "rule 5: January 2024 3.70 %"
  cpi_yoy[2025-01] = 0.049 "rule 5: January 2025 4.90 %"
  fee = 2.00 "rule 3: 2.00 a bond"
  first_rate = 0.068 "rule 1: year 1 6.80 %"
  lag = 2 "rule 1: two months before the year starts"
  margin = 0.0125 "rule 1: plus 1.25 %"
  tax_rate = 0.19 "rule 4: 19 %"
