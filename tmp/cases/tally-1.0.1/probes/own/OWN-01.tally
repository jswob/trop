model own01
  tally 1
  on 2026-10-25
  start 2025-01-01
  end 2025-12-31
  note "OWN-01: a savings account opened on 1 March with a month-end fee; the fees of the first quarter and net worth on 15 February."
  note "A place has no lifetime in Tally (LANGUAGE 5.9): every declared place exists from the run's start. The opening day is an input, opened[x], read by the fee's when and by the asks' where."

source card "Probe card OWN-01 (made up): story and rules"

index month = month 2025-01..2025-12

place bank_fees: outside DUK

place current: account DUK

place savings: account DUK

input fee_amount: money DUK

input opened[x in place]: date

pay fee[m in month]
  from savings
  to bank_fees
  amount fee_amount
  on add_days(end_of(m), -1)
  when opened[savings] <= add_days(end_of(m), -1)

ask q_a_fees: flows(fee, 2025-01..2025-03)

ask q_b_lines: bal(x, 2025-02-15) for x in place where kind(x) = account and opened[x] <= 2025-02-15

ask q_b_net_worth: sum(x in place where kind(x) = account and opened[x] <= 2025-02-15: bal(x, 2025-02-15))

version card_facts
  cite card
  known 2025-01-01
  opened[current] = 2015-01-01 "story: held for years"
  opened[savings] = 2025-03-01 "story: opened on 1 March 2025"
  stated[current] = 1000.00 governs 2025-02-15 "story: holds 1 000.00 on 15 February 2025"

version card_rules
  cite card
  known 2025-01-01
  fee_amount = 5.00 "rule 2: a fee of 5.00 at each month's end while open"
