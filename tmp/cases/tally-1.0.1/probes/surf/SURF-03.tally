model surf03
  tally 1
  on 2025-10-24
  start 2025-10-24
  end 2029-12-31
  note "SURF-03: Halina's lifetime as a household model writes it. The life table is a fixed input with rows; the yearly death is a draw on each path; the seed, the path count and the mean across paths live in the ask, outside any one path."

source household "The household's forecast settings"

source life_table "Halina's stated life table"

index age_year = 85..88

index person = [halina]

input q_die[k in person, a in age_year]: num question "What is the chance of dying within this year of age?"

draw die[p in path, k in person, a in age_year] ~ binomial(1, q_die[k, a])

def death_age[p in path, k in person]: key age_year = first(a in age_year where die[p, k, a] = 1)

def years_lived[p in path, k in person]: int
  note "the whole years lived before the year of death, on path p"
  rule base = pos(death_age[p, k]) - 1

ask lifetime_mean: mean(p in path: years_lived[p, halina]) paths 60000 seed 20251024

version halina_table
  cite life_table
  known 2025-10-24
  q_die[halina, 85] = 0.2 "at 85"
  q_die[halina, 86] = 0.3 "at 86"
  q_die[halina, 87] = 0.5 "at 87"
  q_die[halina, 88] = 1 "at 88"
