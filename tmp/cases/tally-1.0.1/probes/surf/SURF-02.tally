model surf02
  tally 1
  on 2025-01-01
  note "SURF-02: an estate's buyout rule. The condition compares two amounts (>, a question); the rule's own = states the value. An heir with no share gets - (does not apply), apart from a negative buyout (he pays in). The keeper's total is one aggregate over the heirs."

source estate "The estate's division rule (card SURF-02)"

source modeller "Illustrative figures; the card's rule gives none"

index heir = [ewa, jan, olek]

input advance[h in heir]: money DUK

input heir_share[h in heir]: num

input value_at_death: money DUK

input value_at_division: money DUK

def buyout[h in heir]: num DUK
  rule risen when value_at_division > value_at_death = heir_share[h] * value_at_division - advance[h]
  rule not_risen when value_at_division <= value_at_death = ? "What is an heir's buyout when the flat's value did not rise? The rule doesn't say."
  rule no_share excepts not_risen, risen when heir_share[h] = - = -

def keeper_pays: num DUK = sum(h in heir where buyout[h] != -: buyout[h])

ask q_buyouts: buyout[h] for h in heir

ask q_keeper: keeper_pays

version illustration
  cite modeller
  known 2025-01-01
  assumed "illustrative figures: the card's rule gives none"
  advance = 0 "no advance"
  advance[olek] = 200000 "an advance larger than his part"
  heir_share[ewa] = 0.5 "half"
  heir_share[jan] = - "no share: the buyout does not apply"
  heir_share[olek] = 0.5 "half"
  value_at_death = 300000 "the flat at the death"
  value_at_division = 360000 "the flat at the division"
