model surf04
  tally 1
  on 2025-01-01
  start 2025-01-01
  end 2025-12-31
  note "SURF-04: the contribution formula stated once, as the def contrib, and read in three places: the monthly payroll (a pay), the yearly return's check (a check ask) and a what-if with a raise (a with pin). The scenario file redefine states contrib again and is refused at load (LOAD-DUP)."

source contract "The employment contract's gross"

source contrib_law "The contribution law: 9.76 % of gross, on gross only until the year's gross to date reaches the cap, rounded half up to 0.01"

source what_if "The household's what-if: a raise"

index month = month 2025-01..2025-12

place fund: outside DUK

place konto: account DUK

input contrib_cap: money DUK

input contrib_rate: num

input raised_salary: money DUK

input salary: money DUK

def contrib[m in month]: money DUK
  rule base v contrib_2025 = round(contrib_rate * max(0, min(gross[m], contrib_cap - gross_before[m])), 0.01, half-up)

def gross[m in month]: money DUK = salary

def gross_before[m in month]: money DUK = sum(k in month where year_of(k) = year_of(m) and k < m: gross[k])

pay contrib_pay[m in month]
  from konto
  to fund
  amount contrib[m]
  on day_of(m, 10)

ask payroll: contrib[m] for m in month

ask return_check: check flows(contrib_pay, 2025) = sum(m in month: contrib[m])

ask raise: sum(m in month: contrib[m]) with salary = raised_salary

version contrib_2025
  cite contrib_law
  governs 2025..
  known 2025-01-01
  contrib_cap = 100000 assumed "illustration: the card names a cap but gives no figure" "the cap"
  contrib_rate = 0.0976 "9.76 % of gross"

version gross_2025
  cite contract
  known 2025-01-01
  salary = 12000 assumed "illustration: the card gives no gross" "monthly gross"

version raise_2025
  cite what_if
  known 2025-01-01
  raised_salary = 13000 assumed "illustration: the card gives no raise" "the what-if's gross"
