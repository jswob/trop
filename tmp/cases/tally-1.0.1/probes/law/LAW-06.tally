model law06
  tally 1
  on 2026-10-25
  note "Probe LAW-06: a filing election per year. With none stated the tax is a hole; with one, both sides are shown beside the elected one."

source card "Probe card LAW-06 (tmp/cases/probes/law/LAW-06.md): story, rules 1-3 and question"

index filing = [joint, separate]

index person = [tomek, ania]

index yr = year 2023..2024

input election[y in yr]: key filing question "Which filing election, joint or separate, did Tomek and Ania make for this year?"

input income[p in person, y in yr]: money DUK question "What did this spouse earn in this year?"

band scale(x: num DUK): num
  note "rule 3: marginal rates, read with marginal()"

def joint_tax[y in yr]: num DUK
  note "rule 2: joint, twice the scale on half the combined income"
  rule base v card_law = 2 * marginal(scale, sum(p in person: income[p, y]) / 2)

def separate_tax[y in yr]: num DUK
  note "rule 2: separate, each pays the scale on their own income"
  rule base v card_law = sum(p in person: marginal(scale, income[p, y]))

def tax[y in yr]: num DUK
  note "rule 1: no election, no tax: no rule applies without one, so a missing election leaves the tax a hole (L 5.10 step 5)"
  rule joint v card_law when election[y] = joint = joint_tax[y]
  rule separate v card_law when election[y] = separate = separate_tax[y]

ask a_2023: tax[2023]

ask b_2024: joint_tax[2024], separate_tax[2024], election[2024], tax[2024]

version card_law
  cite card
  known 2026-10-25
  note "the card's own rules, stipulations known from on (L 4.5)"
  scale: [0, 60000] = 0.12 "rule 3: 12 % up to and including 60 000.00"
  scale: (60000, inf) = 0.32 "rule 3: 32 % on the excess"

version card_facts
  cite card
  known 2026-10-25
  note "story: for 2023 their dossier states no filing choice, so election[2023] has no row (the gap rule, L 4.6)"
  election[2024] = joint "story: for 2024 they state joint"
  income[ania, 2023..2024] = 30000 "story: Ania earns 30 000.00 in 2023 and 2024"
  income[tomek, 2023..2024] = 90000 "story: Tomek earns 90 000.00 DUK in 2023 and 2024"
