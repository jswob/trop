model law11
  tally 1
  on 2026-10-25
  note "Probe LAW-11: a gift tax that adds the same giver's gifts of the 5 years before, and credits what earlier gifts already used."

source card "Probe card LAW-11 (tmp/cases/probes/law/LAW-11.md): story, rules 1-2 and question"

index gift = [g2020, g2024]

index person = [halina, piotr]

input free: money DUK question "How much of the sum is free of tax?"

input g_amt[g in gift]: money DUK question "How much was the gift?"

input g_from[g in gift]: key person question "Who gave the gift?"

input g_on[g in gift]: date question "On what day was the gift given?"

input g_to[g in gift]: key person question "Who received the gift?"

input rate: num question "What is the gift tax rate?"

input years: int question "Over how many years before a gift are earlier gifts added?"

def cum[g in gift]: money DUK
  note "rule 1: the gift plus the same giver's gifts within the years before it"
  rule base v card_law = g_amt[g] + sum(j in gift where earlier[g, j]: g_amt[j])

def earlier[g in gift, j in gift]: bool
  note "rule 1: gift j is from the same giver to the same receiver, within the years before gift g"
  rule base v card_law = (g_from[j] = g_from[g] and g_to[j] = g_to[g] and g_on[j] < g_on[g] and g_on[j] > add_years(g_on[g], -years))

def tax[g in gift]: num DUK
  note "rule 2: 7 % of the taxable part; the card states no rounding"
  rule base v card_law = rate * taxable[g]

def taxable[g in gift]: money DUK
  note "rule 2: the sum above the free amount, less what the earlier gifts already used of it"
  rule base v card_law = max(0, cum[g] - free) - sum(j in gift where earlier[g, j]: taxable[j])

ask second_gift: cum[g2024], taxable[g2024], tax[g2024]

version card_law
  cite card
  known 2026-10-25
  note "the card's own rules, stipulations known from on (L 4.5)"
  free = 10000 "rule 1: 10 000.00 of the sum is free of tax"
  rate = 0.07 "rule 2: the tax is 7 %"
  years = 5 "rule 1: within the 5 years before a gift"

version card_facts
  cite card
  known 2026-10-25
  g_amt[g2020] = 6000 "story: 6 000.00 DUK on 1 April 2020"
  g_amt[g2024] = 9000 "story: 9 000.00 on 15 March 2024"
  g_from = halina "story: Halina gives both gifts"
  g_on[g2020] = 2020-04-01 "story: 1 April 2020"
  g_on[g2024] = 2024-03-15 "story: 15 March 2024"
  g_to = piotr "story: both to Piotr"
