model law02
  tally 1
  on 2026-10-25
  note "Probe LAW-02: a relief that tapers unit for unit above its limit, and a contribution with a cliff, each read at its edge and one minor unit above."

source card "Probe card LAW-02 (tmp/cases/probes/law/LAW-02.md): story, rules 1-2 and question"

index probe = [at_edge, above_edge]

input income[t in probe]: money DUK question "What is the yearly income in this probe of the relief?"

input revenue[t in probe]: money DUK question "What is the yearly revenue in this probe of the contribution?"

band contribution(x: money DUK): money DUK
  note "rule 2: the monthly contribution by yearly revenue"

band relief(x: money DUK): money DUK
  note "rule 1: the relief by yearly income; above the limit it is cut by 1.00 for each 1.00 over, never below 0"

ask relief_at_edge: income[t], relief(income[t]) for t in probe

ask contribution_at_edge: revenue[t], contribution(revenue[t]) for t in probe

version card_law
  cite card
  known 2026-10-25
  note "the card's own rules, stipulations known from on (L 4.5)"
  contribution: (-inf, 60000] = 300 "rule 2: 300.00 a month for yearly revenue not more than 60 000.00"
  contribution: (60000, inf) = 500 "rule 2: 500.00 for more"
  relief: (-inf, 100000] = 1200 "rule 1: 1 200.00 for income not more than 100 000.00"
  relief: (100000, inf) = max(0, 1200 - (x - band_lo(relief, x))) "rule 1: above it, cut by 1.00 for each 1.00 of income over, never below 0"

version card_question
  cite card
  known 2026-10-25
  income[at_edge] = 100000 "question: the relief at 100 000.00"
  income[above_edge] = 100000.01 "question: the relief at 100 000.01"
  revenue[at_edge] = 60000 "question: the contribution at 60 000.00"
  revenue[above_edge] = 60000.01 "question: the contribution at 60 000.01"
