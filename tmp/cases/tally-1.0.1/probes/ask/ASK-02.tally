model ask02
  tally 1
  on 2025-06-30
  start 2025-06-30
  end 2025-06-30
  note "Probe ASK-02: net worth per person on 30 June 2025, with one asset nobody has valued."

source probe_card "Probe card ASK-02 (made-up story and rules)"

index person = [piotr, ola]

place car: asset DUK priced car_value
place flat: asset DUK priced flat_value
place konto_piotr: account DUK

input asked_on: date
input car_value: money DUK question "What is Ola's car worth on 2025-06-30? Nobody has valued it."
input flat_value: money DUK
input owns[p in person, x in place]: num

def net_worth[p in person]: num DUK
  note "rule 1: a person's shares of what they own"
  rule base v card = sum(x in place where kind(x) != outside and owns[p, x] > 0: share_value[p, x])

def place_value[x in place]: num DUK
  note "rule 1: an asset at its last valuation, an account at its balance; no valuation is a hole"
  rule base v card = if kind(x) = account then bal(x, asked_on) else worth(x, asked_on)

def share_value[p in person, x in place]: num DUK
  rule base v card = owns[p, x] * place_value[x]

ask q_net_worth: net_worth[p] for p in person

ask q_parts: share_value[p, x] for p in person, x in place where kind(x) != outside and owns[p, x] > 0

version card
  cite probe_card
  known 2025-06-30
  note "Stipulations, known from the model's start (L §4.5)."
  asked_on = 2025-06-30 "question: on 30 June 2025"
  flat_value = 400000.00 governs 2025-01-10.. "story: valued 400 000.00 on 10 January 2025"
  opening[konto_piotr] = 20000.00 "story: Piotr's account holds 20 000.00"
  owns = 0 "story: nobody owns anything else"
  owns[ola, car] = 1 "story: Ola owns a car"
  owns[ola, flat] = 0.5 "story: half each"
  owns[piotr, flat] = 0.5 "story: half each"
  owns[piotr, konto_piotr] = 1 "story: Piotr's account"
