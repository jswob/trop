model val02
  tally 1
  on 2026-10-25

source idx_pub "VAL-02 card: the monthly price index"
source series_terms "VAL-02 card: the bond series' terms"

index mon = month 2024-12..2025-03

input cpi[m in mon]: num

input lag_months: int

input series_start: month

def read_month: month = series_start - lag_months

def read_value: num = cpi[read_month]

ask q: read_month, read_value

version idx_rows
  cite idx_pub
  known 2026-10-25
  cpi[2024-12] = 104.1 "December 2024"
  cpi[2025-01] = 104.9 "January 2025"
  cpi[2025-02] = 105.3 "February 2025"
  cpi[2025-03] = 105.0 "March 2025"

version terms
  cite series_terms
  known 2026-10-25
  lag_months = 2 "rule 1: the index two months before the month the series starts"
  series_start = 2025-03 "the series starts in March 2025"
