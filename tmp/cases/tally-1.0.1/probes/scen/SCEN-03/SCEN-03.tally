model scen03
  tally 1
  on 2026-10-25

source lease "SCEN-03 card: Halina's rent, 2 000.00 a month in 2025, raised each January by the previous year's price-index change"
source forecast "SCEN-03 card: the price index's base path, 3 % a year"
source what_if "SCEN-03 card: the override, 8 % for 2025-2027"

index yr = year 2025..2029

input bond_margin: num question "The card gives no bond margin over the index."

input cpi_change[y in yr]: num

input mortgage_margin: num question "The card gives no mortgage margin over the reference rate."

input pension_amt[y in yr]: money DUK question "The card gives no pension amount."

input ref_rate[y in yr]: num question "The card gives no reference rate REF."

input rent_2025: money DUK

def bond_rate[y in yr]: num = cpi_change[y] + bond_margin

def mortgage_rate[y in yr]: num = ref_rate[y] + mortgage_margin

def pension[y in yr]: num DUK = pension_amt[y] * (1 + cpi_change[y])

def rent[y in yr]: money DUK
  rule first excepts next when pos(y) = 1 = rent_2025
  rule next v lease_v = round(rent[y - 1] * (1 + cpi_change[y - 1]), 0.01, half-up)

ask reads_bonds: inputs-of bond_rate[2026] with scenario infl8

ask reads_mortgage: inputs-of mortgage_rate[2026] with scenario infl8

ask reads_pension: inputs-of pension[2026] with scenario infl8

ask reads_rent: inputs-of rent[2029] with scenario infl8

ask rent_2029: rent[2029] as if {scenario infl8}, rent[2029]

version base_path
  cite forecast
  known 2026-10-25
  assumed "the price index's base path: 3 % a year"
  cpi_change[2025..2029] = 0.03 "base path"

version lease_v
  cite lease
  known 2026-10-25
  rent_2025 = 2000.00 "2 000.00 a month in 2025"
