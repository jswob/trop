model scen02
  tally 1
  on 2026-10-25
  start 2024-09-01
  end 2024-12-31

source sale_contract "SCEN-02 card: the car sold on 15 September 2024, 23 050.00 after the credit's payoff"
source insurer "SCEN-02 card: the insurance refund of 20 September 2024"
source parking_notice "SCEN-02 card: notice given on the parking, paid for the last time on 1 October 2024"
source parking_terms "SCEN-02 card: the parking, 150.00 on the 1st of each month"
source credit_terms "SCEN-02 card: the car credit, 400.00 on the 20th of each month"
source what_if "SCEN-02 card: had they kept the car"

index mon = month 2024-09..2024-12

place konto: account DUK

input credit_from: month

input credit_inst: money DUK

input park_fee: money DUK

input park_last: month

input refund_amt: money DUK

input refund_day: date

input sale_day: date

input sale_net: money DUK

input sold: bool

pay credit[m in mon]
  from konto
  to outside_duk
  amount credit_inst
  on day_of(m, 20)
  when m >= credit_from and not sold

pay parking[m in mon]
  from konto
  to outside_duk
  amount park_fee
  on day_of(m, 1)
  when m <= park_last or not sold

pay refund
  from outside_duk
  to konto
  amount refund_amt
  on refund_day
  when sold

pay sale
  from outside_duk
  to konto
  amount sale_net
  on sale_day
  when sold

ask cash_diff: flows(konto, 2024-09-15..2024-12-31) as if {scenario kept} - flows(konto, 2024-09-15..2024-12-31)

ask monthly: flows(credit[m], 2024-09-15..2024-12-31) as if {scenario kept}, flows(credit[m], 2024-09-15..2024-12-31), flows(parking[m], 2024-09-15..2024-12-31) as if {scenario kept}, flows(parking[m], 2024-09-15..2024-12-31) for m in mon

ask one_offs: flows(sale, 2024-09-15..2024-12-31) as if {scenario kept}, flows(sale, 2024-09-15..2024-12-31), flows(refund, 2024-09-15..2024-12-31) as if {scenario kept}, flows(refund, 2024-09-15..2024-12-31)

version car_sold
  cite sale_contract
  known 2024-09-01
  sale_day = 2024-09-15 "sold 15 September 2024"
  sale_net = 23050.00 "received after the credit's payoff"
  sold = false governs ..2024-09-14 "before the sale"
  sold = true governs 2024-09-15.. "sold"

version credit_v
  cite credit_terms
  known 2024-09-01
  credit_from = 2024-10 "the card's inputs: kept, the instalments run on from October 2024"
  credit_inst = 400.00 "400.00 on the 20th of each month"

version notice_v
  cite parking_notice
  known 2024-09-01
  park_last = 2024-10 "paid for the last time on 1 October 2024"

version park_v
  cite parking_terms
  known 2024-09-01
  park_fee = 150.00 "150.00 on the 1st of each month"

version refund_v
  cite insurer
  known 2024-09-01
  refund_amt = 350.82 "insurance refund"
  refund_day = 2024-09-20 "paid 20 September 2024"
