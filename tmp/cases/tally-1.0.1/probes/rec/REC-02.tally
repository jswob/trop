model rec02
  tally 1
  on 2026-10-25

source wrzos_export "REC-02 card: Bank Wrzosowy's export for PKB-1201, March 2025: semicolon-separated, decimal comma, dates dd.mm.yyyy, two header lines, a balance-after column"
source acct_open "REC-02 card: the account's opening in March 2025"
source card "REC-02 card: its rules"

index row = 1..5

input opening_bal: money DUK

input row_after[r in row]: money DUK

input row_amt[r in row]: money DUK

input row_on[r in row]: date

def closing: money DUK
  rule last_row v card_rules = row_after[last(r in row)]

def faulty_amt: money DUK = sum(r in row where no_effect[r]: row_amt[r])

def naive_sum: money DUK = opening_bal + sum(r in row: row_amt[r])

def no_effect[r in row]: bool
  rule twice v card_rules = (row_after[r] = prev_after[r])

def prev_after[r in row]: money DUK
  rule base = row_after[r - 1]
  rule first excepts base when pos(r) = 1 = opening_bal

def without_faulty: money DUK = opening_bal + sum(r in row where not no_effect[r]: row_amt[r])

ask q: closing, naive_sum, without_faulty

ask issues: no_effect[r], row_amt[r] for r in row

ask moves_exactly: check naive_sum - without_faulty = faulty_amt

ask closes: check without_faulty = closing

version open_v
  cite acct_open
  known 2026-10-25
  opening_bal = 1000.00 "the account opens March 2025 at 1 000.00"

version export_2025_03
  cite wrzos_export
  known 2026-10-25
  row_after[1] = 800.00 "line 3: 03.03.2025;Sklep Rolnik;-200,00;800,00"
  row_after[2] = 1300.00 "line 4: 05.03.2025;Klient Kowal;500,00;1300,00"
  row_after[3] = 1300.00 "line 5: 05.03.2025;Klient Kowal;500,00;1300,00"
  row_after[4] = 1200.00 "line 6: 10.03.2025;Apteka;-100,00;1200,00"
  row_after[5] = 1150.00 "line 7: 12.03.2025;Kawiarnia;-50,00;1150,00"
  row_amt[1] = -200.00 "line 3"
  row_amt[2] = 500.00 "line 4"
  row_amt[3] = 500.00 "line 5"
  row_amt[4] = -100.00 "line 6"
  row_amt[5] = -50.00 "line 7"
  row_on[1] = 2025-03-03 "line 3"
  row_on[2] = 2025-03-05 "line 4"
  row_on[3] = 2025-03-05 "line 5"
  row_on[4] = 2025-03-10 "line 6"
  row_on[5] = 2025-03-12 "line 7"

version card_rules
  cite card
  known 2026-10-25
