model rec07
  tally 1
  on 2026-10-25

source fund_prices "REC-07 card: the fund's recorded price at the start of each year, years 0-6"
source plan "REC-07 card: the plan, 1 000.00 at the start of each of 3 years"
source card "REC-07 card: its rules"

unit fu "a unit of the fund"

index yr = 0..6

input buy: money DUK

input plan_years: int

input price[y in yr]: num DUK/fu

def end_value[s in yr]: money DUK
  rule replay v card_rules = round(units_bought[s] * price[s + plan_years], 0.01, half-up)

def units_bought[s in yr]: num fu = sum(k in yr where k >= s and k < s + plan_years: buy / price[k])

ask best: argmax(s in yr where s + plan_years <= last(k in yr): end_value[s]), max(s in yr where s + plan_years <= last(k in yr): end_value[s])

ask ends: end_value[s] for s in yr where s + plan_years <= last(k in yr)

ask worst: argmin(s in yr where s + plan_years <= last(k in yr): end_value[s]), min(s in yr where s + plan_years <= last(k in yr): end_value[s])

version plan_v
  cite plan
  known 2026-10-25
  buy = 1000.00 "1 000.00 a year"
  plan_years = 3 "three years of buying, valued at the start of the fourth"

version price_rows
  cite fund_prices
  known 2026-10-25
  price[0] = 100 "year 0"
  price[1] = 120 "year 1"
  price[2] = 90 "year 2"
  price[3] = 110 "year 3"
  price[4] = 130 "year 4"
  price[5] = 100 "year 5"
  price[6] = 150 "year 6"

version card_rules
  cite card
  known 2026-10-25
