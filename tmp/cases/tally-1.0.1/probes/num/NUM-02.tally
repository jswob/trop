model num02
  tally 1
  on 2026-10-25
  note "Probe NUM-02: a refund by unused days across a leap day, under the contract's convention and under actual/365."

source probe_card "Probe card NUM-02 (made-up story and rules)"

input cover_ends: date
input policy_end: date
input policy_start: date
input premium: money DUK

def policy_days: int
  note "rule 1: the days in the policy year (actual/actual), both ends counted"
  rule base v card = days(policy_start, policy_end) + 1

def refund_365: money DUK
  note "the contrast the question asks: the same refund over 365 days"
  rule base = round(premium * unused_days / 365, 0.01, half-up)

def refund_aa: money DUK
  note "rules 1 and 3: premium x unused days / days in the policy year, rounded half up to 0.01"
  rule base v card = round(premium * unused_days / policy_days, 0.01, half-up)

def unused_days: int
  note "rule 2: from the day after cover ends to the policy's last day, inclusive"
  rule base v card = days(cover_ends, policy_end)

ask q_refund: refund_aa, refund_365, unused_days

version card
  cite probe_card
  known 2026-10-25
  cover_ends = 2024-03-31 "story: cover ends at the end of 31 March 2024"
  policy_end = 2024-08-31 "story: the policy runs to 31 August 2024"
  policy_start = 2023-09-01 "story: the policy runs from 1 September 2023"
  premium = 732.00 "story: premium paid up front"
