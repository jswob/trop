model pty04
  tally 1
  on 2026-10-25
  note "PTY-04: a child relief with an income limit over both parents; one parent's restated income crosses it."
  note "Both statements of Tomek's income are stipulations, known from the model's on (LANGUAGE 4.5), so the restatement can't be a later version: two rows of income[tomek, 2024] known the same day would tie (4.6). The after view is a with pin."

source card "Probe card PTY-04 (made up): story and rules"

index child = [first_child]

index person = [ania, tomek]

index tyear = year 2024..2024

input income[p in person, y in tyear]: money DUK

input income_limit: money DUK

input income_restated[p in person, y in tyear]: money DUK

input parent[c in child, p in person]: bool

input relief_amount: money DUK

input split[c in child, p in person]: num

def eligible[c in child, y in tyear]: bool
  note "rule 1: joint income not more than the limit"
  rule base v card_rules = joint_income[c, y] <= income_limit

def joint_income[c in child, y in tyear]: money DUK = sum(p in person where parent[c, p]: income[p, y])

def relief[p in person, y in tyear]: num DUK
  note "rules 1-2: the relief split by the parents' statement"
  rule base v card_rules = sum(c in child where parent[c, p]: if eligible[c, y] then relief_amount * split[c, p] else 0)

ask q_after: joint_income[first_child, 2024], eligible[first_child, 2024], relief[p, 2024] for p in person with income[tomek, 2024] = income_restated[tomek, 2024]

ask q_before: joint_income[first_child, 2024], eligible[first_child, 2024], relief[p, 2024] for p in person

version card_facts
  cite card
  known 2026-10-25
  income[ania, 2024] = 60000.00 "story: Ania earns 60 000.00"
  income[tomek, 2024] = 52000.00 "story: Tomek 52 000.00"
  income_restated[tomek, 2024] = 52000.01 "story: Tomek's year restated with a raise"
  parent[first_child, ania] = true "story: one child"
  parent[first_child, tomek] = true "story: one child"
  split[first_child, ania] = 0.5 "rule 2: the parents' statement, half each"
  split[first_child, tomek] = 0.5 "rule 2: the parents' statement, half each"

version card_rules
  cite card
  known 2026-10-25
  income_limit = 112000.00 "rule 1"
  relief_amount = 1000.00 "rule 1"
