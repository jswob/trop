part tt_1
  tally 1
  law
  note "TT-1 · Transfer tax on a dwelling. The buyer from a seller who is not a VAT taxpayer pays 2 % of the market value (the price, unless below it) (.1); co-buyers each on their share of the value (.2); the notary collects it on the deed's day, rounded (.3, GEN-5 .1)."

source tt_1 "Transfer Tax Act, TT-1 Transfer tax on a dwelling (tmp/cases/law/acts.md)"

input tt1_rate: num question "What is the transfer tax rate on a dwelling (TT-1 .1)?"

version tt1_v1
  cite tt_1
  governs 2018-01-01..
  known 2017-09-01
  enters 2018-01-01
  note "TT-1 v1, in force 2018-01-01 until replaced, published 2017-09-01; governs purchases from 2018-01-01."
  tt1_rate = 0.02 "TT-1 v1 .1"
