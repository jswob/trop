part soc_2
  tally 1
  law
  note "SOC-2 · The health contribution: 9 % of gross pay less the SOC-1 contributions, rounded to the ort (.1, GEN-5 .3); parental pay bears none. v1 (pay paid to 2021-12-31): 7.75 % of the base comes off the tax, in the advance and the return (.2); v2 (from 2022-01-01): nothing comes off."

source soc_2 "Social Insurance Act, SOC-2 The health contribution of employees and pensioners (tmp/cases/law/acts.md)"

input soc2_rate: num question "What is the health contribution rate (SOC-2 .1)?"

input soc2_deductible: num question "What share of the health base comes off the tax (SOC-2 v1 .2)?"

version soc2_v1
  cite soc_2
  governs 2018-01-01..2021-12-31
  known 2017-09-01
  note "SOC-2 v1, in force 2018-01-01 – 2021-12-31, published 2017-09-01; governs pay and pensions paid 2018-01-01 – 2021-12-31."
  soc2_rate = 0.09 "SOC-2 v1 .1"
  soc2_deductible = 0.0775 "SOC-2 v1 .2"

version soc2_v2
  cite soc_2
  governs 2022-01-01..
  known 2021-11-15
  note "SOC-2 v2, in force 2022-01-01 until replaced, published 2021-11-15; governs pay and pensions paid from 2022-01-01; point 2: nothing is deducted from the tax."
  soc2_rate = 0.09 "SOC-2 v2 .1 (as v1)"
