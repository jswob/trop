part pit_14
  tally 1
  law
  note "PIT-14 · Exempt income: the child benefit; a sum an insurer pays on a person's death, a loan it pays off included; what is acquired by inheritance or gift (under IGT); what a co-owner receives to settle shares (CIV-4); the state's payments to a workplace plan (.1)."

source pit_14 "Personal Income Tax Act, PIT-14 Exempt income (tmp/cases/law/acts.md)"

input pit14_death_benefit_exempt: bool question "Is a sum an insurer pays on a person's death exempt from PIT (PIT-14 .1)?"

version pit14_v1
  cite pit_14
  governs 2018..
  known 2017-09-01
  enters 2018-01-01
  note "PIT-14 v1, in force 2018-01-01 until replaced, published 2017-09-01; governs tax years from 2018."
  pit14_death_benefit_exempt = true "PIT-14 v1 .1"
