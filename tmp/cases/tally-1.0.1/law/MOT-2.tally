part mot_2
  tally 1
  law
  note "MOT-2 · Road tax: a yearly tax by engine size (.1), paid by 31 March for a car registered on 1 January, else for the whole months left at 1/12 a month (.2); on a sale the seller is refunded 1/12 of the yearly tax for each whole month of the year after the month of the sale, rounded to the ort (.3, GEN-5 .3)."

source mot_2 "Motor Vehicles Act, MOT-2 Road tax (tmp/cases/law/acts.md)"

band mot2_tax(cc: int): money DUK
  note "the yearly road tax by engine capacity in cm3 (MOT-2 .1)"

version mot2_v1
  cite mot_2
  governs 2018..
  known 2017-09-01
  note "MOT-2 v1, in force 2018-01-01 until replaced, published 2017-09-01; governs tax years from 2018."
  mot2_tax: [0, 1600] = 360.00 "MOT-2 v1 .1: up to 1 600 cm3"
  mot2_tax: (1600, 2500] = 720.00 "MOT-2 v1 .1: up to 2 500 cm3"
  mot2_tax: (2500, inf) = 1200.00 "MOT-2 v1 .1: above 2 500 cm3"
