part igt_3
  tally 1
  law
  note "IGT-3 · Adding up, the free amount and the scale: what was acquired from the same person in the 5 years before the last acquisition is added to it, the free amount deducted once and the tax already paid deducted (.1); the free amount of the acquirer's group in force on the day the last acquisition's tax arises (.2); the group's scale on the amount above it (.3); rounded (.4)."

source igt_3 "Inheritance and Gift Tax Act, IGT-3 Adding up, the free amount and the scale (tmp/cases/law/acts.md)"

index igt_group = [group_1, group_2, group_3]
  v igt3_v1
  note "the acquirer's groups of IGT-1 .2"

band igt3_scale[g in igt_group](x: num DUK): num DUK
  note "the tax on the amount above the free amount, per group (IGT-3 .3)"

input igt_free[g in igt_group]: money DUK question "What is this group's free amount on the day the tax arises (IGT-3 .2)?"

input igt3_years: int question "Over how many years before the last acquisition are acquisitions added up (IGT-3 .1)?"

version igt3_v1
  cite igt_3
  governs 2018-01-01..
  known 2017-09-01
  note "IGT-3 v1, in force 2018-01-01 until replaced, published 2017-09-01; governs acquisitions from 2018-01-01."
  igt3_years = 5 "IGT-3 v1 .1"
  igt3_scale[group_1]: [0, 12000] = x * 0.03 "IGT-3 v1 .3, Group I: 3 % up to 12 000.00 DUK"
  igt3_scale[group_1]: (12000, 24000] = 360.00 + (x - band_lo(igt3_scale[group_1], x)) * 0.05 "IGT-3 v1 .3, Group I: 360.00 DUK and 5 % of the part above 12 000.00"
  igt3_scale[group_1]: (24000, inf) = 960.00 + (x - band_lo(igt3_scale[group_1], x)) * 0.07 "IGT-3 v1 .3, Group I: 960.00 DUK and 7 % of the part above 24 000.00"
  igt3_scale[group_2]: [0, 12000] = x * 0.07 "IGT-3 v1 .3, Group II: 7 %"
  igt3_scale[group_2]: (12000, 24000] = 840.00 + (x - band_lo(igt3_scale[group_2], x)) * 0.09 "IGT-3 v1 .3, Group II: 840.00 DUK and 9 %"
  igt3_scale[group_2]: (24000, inf) = 1920.00 + (x - band_lo(igt3_scale[group_2], x)) * 0.12 "IGT-3 v1 .3, Group II: 1 920.00 DUK and 12 %"
  igt3_scale[group_3]: [0, 12000] = x * 0.12 "IGT-3 v1 .3, Group III: 12 %"
  igt3_scale[group_3]: (12000, 24000] = 1440.00 + (x - band_lo(igt3_scale[group_3], x)) * 0.16 "IGT-3 v1 .3, Group III: 1 440.00 DUK and 16 %"
  igt3_scale[group_3]: (24000, inf) = 3360.00 + (x - band_lo(igt3_scale[group_3], x)) * 0.20 "IGT-3 v1 .3, Group III: 3 360.00 DUK and 20 %"

