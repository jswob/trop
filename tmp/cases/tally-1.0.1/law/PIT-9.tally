part pit_9
  tally 1
  law
  note "PIT-9 · The wrapped account: contributions up to the year's WRAP-LIMIT (.2); a withdrawal takes the contributions not yet withdrawn first, earliest year first, then the earnings (.4); the earnings withdrawn are taxed at 19 %, rounded, unless the holder is 60 or older and has contributed in at least 5 calendar years (.5)."

source pit_9 "Personal Income Tax Act, PIT-9 The wrapped account (tmp/cases/law/acts.md)"

input pit9_rate: num question "At what rate are the earnings withdrawn taxed (PIT-9 .5)?"

input pit9_age: int question "From what age is a withdrawal free of tax (PIT-9 .5)?"

input pit9_years: int question "In how many calendar years must the holder have contributed (PIT-9 .5)?"

input wrap_limit: money DUK question "What is this year's WRAP-LIMIT (PIT-9 .2)?"

version pit9_v1
  cite pit_9
  governs 2018-01-01..
  known 2017-09-01
  note "PIT-9 v1, in force 2018-01-01 until replaced, published 2017-09-01; governs contributions and withdrawals from 2018-01-01."
  pit9_rate = 0.19 "PIT-9 v1 .5"
  pit9_age = 60 "PIT-9 v1 .5"
  pit9_years = 5 "PIT-9 v1 .5"

