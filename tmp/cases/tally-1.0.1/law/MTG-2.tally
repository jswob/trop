part mtg_2
  tally 1
  law
  note "MTG-2 · Overpayment. A borrower may pay off a mortgage in part or in full at any time (.1). After 36 months from disbursement no fee; before, the agreement's fee, at most 3 % of the amount and never more than a year's interest on it at the day's rate (.2)."

source mtg_2 "Mortgage Credit Act, MTG-2 Overpayment (tmp/cases/law/acts.md)"

input mtg2_fee_cap: num question "What is the cap on an overpayment fee (MTG-2 .2)?"

input mtg2_free_months: int question "After how many months from disbursement is no overpayment fee allowed (MTG-2 .2)?"

version mtg2_v1
  cite mtg_2
  governs 2018-01-01..
  known 2017-09-01
  enters 2018-01-01
  note "MTG-2 v1, in force 2018-01-01 until replaced, published 2017-09-01; governs overpayments from 2018-01-01."
  mtg2_fee_cap = 0.03 "MTG-2 v1 .2"
  mtg2_free_months = 36 "MTG-2 v1 .2"
