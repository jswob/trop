part pit_4
  tally 1
  law
  note "PIT-4 · Advances on employment income. The month's base is the payer's PIT-2 base rounded (.1); the advance is the scale on the year-to-date bases less the scale on the earlier ones, less 1/12 of the reducing amount where a reducing statement is on file, (v1: less the health contribution up to 7.75 % of its base), never below 0, rounded (.2). The PIT-3 wording is the one in force on the payment day."
  note "pit4_v2_p4 governs payments made 2022-07-01 – 2022-12-31: the advance is computed with PIT-3 v2 (wording of pit4_lower_wording) and with PIT-3 v3, and the lower is withheld (.4)."

source pit_4 "Personal Income Tax Act, PIT-4 Advances on employment income (tmp/cases/law/acts.md)"

input pit4_lower_wording: date question "Which day's wording of PIT-3 is the PIT-3 v2 of PIT-4 v2 .4?"

version pit4_v1
  cite pit_4
  governs 2018-01-01..2021-12-31
  known 2017-09-01
  note "PIT-4 v1, in force 2018-01-01 – 2021-12-31, published 2017-09-01; governs advances on payments made 2018-01-01 – 2021-12-31."

version pit4_v2
  cite pit_4
  governs 2022-01-01..
  known 2021-11-15
  note "PIT-4 v2, in force 2022-01-01 until replaced, published 2021-11-15; governs advances on payments made from 2022-01-01 (points 1–3 as v1, without the health contribution)."

version pit4_v2_p4
  cite pit_4
  governs 2022-07-01..2022-12-31
  known 2021-11-15
  note "PIT-4 v2 point 4: for payments made 2022-07-01 – 2022-12-31, the lower of the advance under PIT-3 v2 and under PIT-3 v3."
  pit4_lower_wording = 2022-06-30 "PIT-4 v2 .4 names PIT-3 v2, whose wording was in force 2022-01-01 – 2022-06-30 (PIT-3 v2 in-force line)"
