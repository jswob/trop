  soc8_rate_first = 1.00 "SOC-8 v1 .2: 100 %"
  soc8_rate_rest = 0.70 "SOC-8 v1 .2: 70 %"
  soc8_rate_elected = 0.815 "SOC-8 v1 .2: 81.5 %"
  soc8_weeks_first = 20 "SOC-8 v1 .2"
  soc8_elect_days = 21 "SOC-8 v1 .2"
  soc8_base_cut = 0.1345 "SOC-8 v1 .3"
