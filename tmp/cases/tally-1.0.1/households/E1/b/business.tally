part business
  tally 1
  note "Piotr's sole trade (B-D01, B-D06): revenue, social and health contributions, the flat-rate tax, VAT, the florens and the car's sale. The law is in law/; this part holds the facts and the defs that apply the law to them."

input biz_start: date question "On which day did Piotr's business start (B-D01)?"

input sickness_from: date question "From which day does Piotr pay the voluntary sickness contribution (B-D03)?"

input b_sale[i in inv_duk]: (issued date, due date, cl key client, sup key pit10_supply, net money DUK, vat money DUK) question "What does this DUK sales invoice say (Faktura+)?"

input sale_flr[j in inv_flr]: (issued date, due date, cl key client, net money FLR, vat money FLR) question "What does this floren sales invoice say (Faktura+)?"

input b_buy[p in purchase]: (received date, bk key buy_kind, net money DUK, vat money DUK) question "What does this purchase invoice say (Faktura+)?"

input car_policy_end: date question "When does the car's liability cover end (B-D13)?"

input car_premium: money DUK question "What was the car policy's premium (B-D13)?"

input car_policy_fee: money DUK question "What handling fee does the insurer keep on an early end (B-D13 §9)?"

input b_car_cc: int question "What is the car's engine size in cm3 (B-D14)?"

input car_loan_left: money DUK question "What was left on the car loan after the 2025-09-15 instalment (B-D16)?"

input car_loan_rate: num question "What is the car loan's yearly interest rate (B-D12 .2)?"

input car_loan_fee: num question "What fee does the car loan's contract set on early repayment (B-D12 .5)?"

input car_loan_end: date question "When was the car loan agreed to end (B-D16)?"

input car_loan_repaid: date question "On which day was the car loan repaid (B-D16)?"

place inv_owed[i in inv_duk]: claim DUK

place inv_owed_flr[j in inv_flr]: claim FLR

version business_start
  cite b_d01
  known 2022-04-11
  biz_start = 2022-04-11 "B-D01: the business starts on 11 April 2022"

version sickness_notice
  cite b_d03
  known 2022-10-18
  sickness_from = 2022-11-01 "B-D03"

version car_policy
  cite b_d13
  known 2025-03-14
  car_policy_end = 2026-03-14 "B-D13: cover 15.03.2025 .. 14.03.2026"
  car_premium = 2190.00 "B-D13: premium 2 190.00 DUK"
  car_policy_fee = 15.00 "B-D13 §9: a handling fee of 15.00 DUK"

version car_tax_notice
  cite b_d14
  known 2025-01-01
  assumed "B-D14's day is not in its extract: the road tax notice of 2025 taken as known from the year's start"
  b_car_cc = 1998 "B-D14: engine 1 998 cm3"

version car_loan_terms
  cite b_d12
  known 2023-03-14
  car_loan_rate = 0.095 "B-D12 .2: fixed, 9.5 % a year"
  car_loan_fee = 0.01 "B-D12 .5: 1 % of the amount repaid early"

version car_loan_closed
  cite b_d16
  known 2025-09-16
  car_loan_left = 11218.86 "B-D16: balance after the instalment of 15 September 2025"
  car_loan_end = 2026-03-15 "B-D16: the agreed end, 15.03.2026"
  car_loan_repaid = 2025-09-16 "B-D16: repaid on 16.09.2025"

pay invoiced[i in inv_duk]
  from clients
  to inv_owed[i]
  amount b_sale[i].net + b_sale[i].vat
  on b_sale[i].issued

pay client_pay[i in inv_duk]
  from inv_owed[i]
  to cis
  amount b_sale[i].net + b_sale[i].vat
  on next_business(b_sale[i].due, holidays)

pay invoiced_flr[j in inv_flr]
  from elsewhere_flr
  to inv_owed_flr[j]
  amount sale_flr[j].net + sale_flr[j].vat
  on sale_flr[j].issued

pay kessel_pay[j in inv_flr]
  from inv_owed_flr[j]
  to b_lazur
  amount sale_flr[j].net + sale_flr[j].vat
  on next_business(sale_flr[j].due, holidays)

def fx_issue[j in inv_flr]: num DUK/FLR at prev_business(add_days(sale_flr[j].issued, -1), holidays) = fx_mid

def rev_flr[j in inv_flr]: money DUK = round(sale_flr[j].net * fx_issue[j], 0.01, half-up)

def vat_flr[j in inv_flr]: money DUK = round(sale_flr[j].vat * fx_issue[j], 0.01, half-up)

def rev[m in b_month]: money DUK = sum(i in inv_duk where month_of(b_sale[i].issued) = m: b_sale[i].net) + sum(j in inv_flr where month_of(sale_flr[j].issued) = m: rev_flr[j])

def rev_it[m in b_month]: money DUK = sum(i in inv_duk where month_of(b_sale[i].issued) = m and b_sale[i].sup = it: b_sale[i].net) + sum(j in inv_flr where month_of(sale_flr[j].issued) = m: rev_flr[j])

def rev_ytd[m in b_month]: money DUK = sum(k in b_month where year_of(k) = year_of(m) and k <= m: rev[k])

def rev_year[y in b_tax_year]: money DUK = sum(k in b_month where year_of(k) = y: rev[k])

def stage2_from: date = add_months(start_of(month_of(biz_start)), 7)

def stage3_from: date = add_months(start_of(month_of(biz_start)), 31)

def min_wage_jan[m in b_month]: money DUK at start_of(year_of(m)) = min_wage

def avg_proj[m in b_month]: money DUK at start_of(year_of(m)) = avg_wage_proj

def soc_base[m in b_month]: num DUK
  rule s1 when start_of(m) < stage2_from = 0
  rule s2 excepts s1 when start_of(m) < stage3_from = soc3_stage2_share * min_wage_jan[m]
  rule s3 excepts s1, s2 = soc3_stage3_share * avg_proj[m]

def soc_part_due[c in soc3_part, m in b_month]: bool
  rule all = true
  rule sick excepts all when c = sickness = start_of(m) >= sickness_from
  rule labour excepts all when c = labour = start_of(m) >= stage3_from

def social[m in b_month]: money DUK = sum(c in soc3_part where soc_part_due[c, m]: round(soc_base[m] * soc3_rate[c], 0.01, half-up))

def awq4[m in b_month]: money DUK at start_of(m) = avg_wage_q4

def b_health[m in b_month]: money DUK = round(soc4_rate * soc4_tier(rev_ytd[m]) * awq4[m], 0.01, half-up)

def paid_on[m in b_month]: date at add_days(add_months(start_of(m), 1), 19) = next_business(add_days(add_months(start_of(m), 1), 19), holidays)

def tax_raw[m in b_month]: money DUK = rev_it[m] - social[m - 1] - tax_carry[m]

def tax_carry[m in b_month]: money DUK
  rule jan when month_of(start_of(year_of(m))) = m = 0
  rule later excepts jan = max(0, 0 - tax_raw[m - 1])

def tax_flat[m in b_month]: money DUK = round(round(max(0, tax_raw[m]), 1, half-up) * pit10_flat_rate[it], 1, half-up)

def settle_owed[y in b_tax_year]: money DUK = sum(k in b_month where year_of(k) = y: round(soc4_rate * soc4_tier(rev_year[y]) * awq4[k], 0.01, half-up))

def health_paid[y in b_tax_year]: money DUK = sum(k in b_month where year_of(k) = y: b_health[k])

def settle_due[y in b_tax_year]: date at add_days(add_months(start_of(y), 15), 19) = next_business(add_days(add_months(start_of(y), 15), 19), holidays)

def deductible[p in purchase]: money DUK
  rule all = b_buy[p].vat
  rule car excepts all when b_buy[p].bk in [car, fuel] = round(b_buy[p].vat * vat5_car_share, 0.01, half-up)

def cost_b[p in purchase]: num DUK
  rule all = b_buy[p].net + b_buy[p].vat - deductible[p]
  rule running excepts all when b_buy[p].bk = fuel = (b_buy[p].net + b_buy[p].vat - deductible[p]) * pit11_running_share
  rule asset excepts all when b_buy[p].bk = car = 0

def car_basis: num DUK = sum(p in purchase where b_buy[p].bk = car: b_buy[p].net + b_buy[p].vat - deductible[p])

def depreciation[y in b_tax_year]: num DUK = car_basis * pit11_depreciation / 12 * count(k in b_month where year_of(k) = y and start_of(k) > first(p in purchase where b_buy[p].bk = car: b_buy[p].received) and start_of(k) < car_sold_on)

def car_sold_on: date = first(i in inv_duk where b_sale[i].sup = asset_sale: b_sale[i].issued)

def contrib_paid_in[y in b_tax_year]: money DUK = sum(k in b_month where year_of(paid_on[k]) = y: social[k])

def tax_b[y in b_tax_year]: money DUK = round(round(rev_year[y] - sum(p in purchase where year_of(b_buy[p].received) = y: cost_b[p]) - depreciation[y] - contrib_paid_in[y], 1, half-up) * pit10_profit_rate, 1, half-up)

def tax_c_year[y in b_tax_year]: money DUK = sum(k in b_month where year_of(k) = y: tax_flat[k])

def vat_limit: money DUK = round(vat2_limit * days(biz_start, end_of(year_of(biz_start))) / days(start_of(year_of(biz_start)), end_of(year_of(biz_start))), 0.01, half-up)

def supplies_to[i in inv_duk]: money DUK = sum(k in inv_duk where year_of(b_sale[k].issued) = year_of(b_sale[i].issued) and b_sale[k].issued <= b_sale[i].issued: b_sale[k].net)

def vat_cross: key inv_duk = first(i in inv_duk where year_of(b_sale[i].issued) = year_of(biz_start) and supplies_to[i] > vat_limit: i)

def vat_from: date = b_sale[vat_cross].issued

def out_vat[m in b_month]: money DUK = sum(i in inv_duk where month_of(b_sale[i].issued) = m and b_sale[i].issued >= vat_from: round(b_sale[i].net * vat_rate, 0.01, half-up)) + sum(j in inv_flr where month_of(sale_flr[j].issued) = m: vat_flr[j])

def in_vat[m in b_month]: money DUK = sum(p in purchase where month_of(b_buy[p].received) = m and b_buy[p].received >= vat_from: deductible[p])

def vat_raw[m in b_month]: money DUK = out_vat[m] - in_vat[m] - vat_carry[m]

def vat_carry[m in b_month]: money DUK
  rule first when start_of(m) <= vat_from = 0
  rule later excepts first = max(0, 0 - round(vat_raw[m - 1], 1, half-up))

def vat_payable[m in b_month]: money DUK = max(0, round(vat_raw[m], 1, half-up))

def vat_carried_out[m in b_month]: money DUK = max(0, 0 - round(vat_raw[m], 1, half-up))

def vat_due[m in b_month]: date at add_days(add_months(start_of(m), 1), 24) = next_business(add_days(add_months(start_of(m), 1), 24), holidays)

def sold_on[j in inv_flr]: date = first(r in laz_row where laz[r].inv = j and laz[r].amount < 0: laz[r].on)

def sold_flr[j in inv_flr]: money FLR = sum(r in laz_row where laz[r].inv = j and laz[r].amount < 0: 0 - laz[r].amount)

def buy_rate[j in inv_flr]: num DUK/FLR at sold_on[j] = lazur_buy

def duk_got[j in inv_flr]: money DUK = round(sold_flr[j] * buy_rate[j], 0.01, half-up)

def credited[j in inv_flr]: date at sold_on[j] = next_business(add_days(sold_on[j], 1), holidays)

index flr_fate = [sold, kept, unpaid]

def fate[j in inv_flr]: key flr_fate
  rule unpaid_rule = unpaid
  rule kept_rule excepts unpaid_rule when bal(inv_owed_flr[j], end_of(year_of(sale_flr[j].issued))) = 0 = kept
  rule sold_rule excepts unpaid_rule, kept_rule when sold_flr[j] > 0 = sold

def hr4_fx[d in b_day]: num DUK/FLR at prev_business(d, holidays) = fx_mid

def car_vat: money DUK = round(b_sale[first(i in inv_duk where b_sale[i].sup = asset_sale: i)].net * vat_rate, 0.01, half-up)

def car_tax: money DUK = round(sum(i in inv_duk where b_sale[i].sup = asset_sale: b_sale[i].net) * pit10_flat_rate[asset_sale], 1, half-up)

def car_loan_interest: money DUK = round(car_loan_left * car_loan_rate * days(add_days(car_loan_repaid, -1), car_loan_repaid) / 365, 0.01, half-up)

def car_loan_fee_due: money DUK
  rule long = round(car_loan_left * min(car_loan_fee, cc2_fee_long), 0.01, half-up)
  rule short excepts long when days(car_loan_repaid, car_loan_end) <= 365 = round(car_loan_left * min(car_loan_fee, cc2_fee_short), 0.01, half-up)

def car_policy_refund: money DUK = round(car_premium * days(car_sold_on, car_policy_end) / days(add_years(add_days(car_policy_end, 1), -1), add_days(car_policy_end, 1)), 0.01, down) - car_policy_fee

def road_tax_refund: money DUK = round(mot2_tax(b_car_cc) * count(k in b_month where year_of(k) = year_of(car_sold_on) and k > month_of(car_sold_on)) / 12, 0.01, half-up)

def car_vat_deducted: money DUK = sum(p in purchase where b_buy[p].bk = car: deductible[p])

def health_year[y in b_tax_year]: money DUK = settle_owed[y]
