  ola_housing_spent = ? "What will Ola spend on her own housing by 2024-12-31 beyond the deed (her 40 % of the kitchen if it is ordered: B-D35, not ordered)? PIT-12 .4"

version mortgage_terms
  cite b_d07
  known 2022-03-10
  mtg_amount = 420000.00 "B-D07 .1"
  mtg_terms = 300 "B-D07 .1"
  mtg_first = 2022-04-05 "B-D07 .1"
  mtg_margin = 2.10 "B-D07 .2"
  mtg_fee = 0.02 "B-D07 .5"
  b_held[*] = false assumed "an instalment is paid unless a notice suspends it (B-D07 .6)" "B-D07 .6"

version holidays_granted
  cite b_d08
  known 2023-01-24
  b_held[2022-08] = true "B-D08: notice of 01.08.2022"
  b_held[2022-09] = true "B-D08: notice of 22.08.2022"
  b_held[2022-11] = true "B-D08: notice of 24.10.2022"
  b_held[2022-12] = true "B-D08: notice of 21.11.2022"
  b_held[2023-02] = true "B-D08: notice of 23.01.2023"

version flat_fee_2025
  cite b_d09
  known 2024-12-12
  assoc_fee = 690.00 governs 2025-01..2025-12 "B-D09"

version flat_policy
  cite b_d10
  known 2025-03-10
  flat_insurance = 520.00 "B-D10: paid on 10.03.2025 by Aleksandra Wilk"

version hr1
  cite b_house_rules
  known 2022-03-18
  hr1_order = 1700.00 "B-HR1 .2"
  order_rejected[*] = false assumed "a standing order goes through unless a statement shows it rejected" "B-HR1 .2"

version wrzos_march
  cite wrzos_export
  known 2025-04-02
  assumed "the statement's day is not stated: the 2nd of the next month"
  order_rejected[2025-03] = true "wrz-ola-2025-03.csv line 8 STANDING ORDER REJECTED flat share - insufficient funds"

def tt1_tax[p in person]: money DUK = round(tt1_rate * flat_price * own_share[p], 1, half-up)

def notary_part[p in person]: money DUK = round(notary_fee * own_share[p], 0.01, half-up)

def studio_income: money DUK = studio_price - studio_sale_cost - studio_cost

def studio_spent_deed: money DUK = own_paid[ola] + tt1_tax[ola] + notary_part[ola]

def studio_tax[s in [deed_only, in_end]]: money DUK
  rule deed_only_r when s = deed_only = round(round(studio_income - studio_income * studio_spent_deed / studio_price, 1, half-up) * pit12_rate, 1, half-up)
  rule end_r excepts deed_only_r when s = in_end = round(round(studio_income - studio_income * min(studio_price, studio_spent_deed + ola_housing_spent) / studio_price, 1, half-up) * pit12_rate, 1, half-up)

def rent_owned: money DUK = sum(k in b_month where start_of(k) <= lease_end and end_of(k) > deed_day: round(b_rent * overlap_days(deed_day, lease_end, k) / days(start_of(k), end_of(k)), 0.01, half-up))

def deposit_back: money DUK = b_deposit - deposit_kept

def mtg_due[m in b_month]: date at day_of(m, 5) = next_business(day_of(m, 5), holidays)

def mtg_live[m in b_month]: bool = start_of(m) >= start_of(month_of(mtg_first)) and not b_held[m] and mtg_n_before[m] < mtg_terms

def mtg_n_before[m in b_month]: int
  rule first when pos(m) = 1 = 0
  rule later excepts first = mtg_n_before[m - 1] + (if mtg_live[m - 1] then 1 else 0)

def mtg_reset_day[d in b_day]: date = max(deed_day, if d >= add_months(start_of(year_of(d)), 6) then add_months(start_of(year_of(d)), 6) else start_of(year_of(d)))

def mtg_rate[d in b_day]: num at prev_business(add_days(mtg_reset_day[d], -1), holidays) = (dukor_6m + mtg_margin) / 100

def mtg_rate_n[d in b_day]: rate nominal 12 /year = mtg_rate[d]

def mtg_prev_due[m in b_month]: date
  rule first when start_of(m) <= start_of(month_of(mtg_first)) = deed_day
  rule later excepts first = mtg_due[m - 1]

def mtg_period[d in b_day]: month = first(k in b_month where mtg_due[k] >= d: k)

def mtg_day_int[d in b_day]: num DUK = if b_held[mtg_period[d]] then 0 else mtg_bal[d] * mtg_rate[d] / 365

def mtg_interest[m in b_month]: money DUK = if mtg_live[m] then round(sum(d in b_day where d > mtg_prev_live_due[m] and d <= mtg_due[m]: mtg_day_int[d]), 0.01, half-up) else 0

def mtg_prev_live_due[m in b_month]: date
  rule first when mtg_n_before[m] = 0 = deed_day
  rule later excepts first = last(k in b_month where k < m and mtg_live[k]: mtg_due[k])

def mtg_reset_or_over[m in b_month]: bool = any(d in b_day where d > mtg_prev_live_due[m] and d <= mtg_due[m]: mtg_reset_day[d] = d or mtg_over_on[d] > 0)

def mtg_inst[m in b_month]: money DUK
  rule first when mtg_n_before[m] = 0 = round(mtg_bal[add_days(mtg_due[m], -1)] * periodic(mtg_rate_n[mtg_due[m]], month) / (1 - 1 / factor(mtg_rate_n[mtg_due[m]], mtg_terms - mtg_n_before[m], month)), 0.01, half-up)
  rule reset excepts first when mtg_reset_or_over[m] = round(mtg_bal[add_days(mtg_due[m], -1)] * periodic(mtg_rate_n[mtg_due[m]], month) / (1 - 1 / factor(mtg_rate_n[mtg_due[m]], mtg_terms - mtg_n_before[m], month)), 0.01, half-up)
  rule same excepts first, reset = mtg_inst[m - 1]
  rule last excepts first, reset, same when mtg_n_before[m] = mtg_terms - 1 = mtg_bal[add_days(mtg_due[m], -1)] + mtg_interest[m]

def mtg_principal_on[d in b_day]: money DUK = if mtg_live[month_of(d)] and d = mtg_due[month_of(d)] then mtg_inst[month_of(d)] - mtg_interest[month_of(d)] else 0

def mtg_fee_on[d in b_day]: money DUK = if d < add_months(deed_day, mtg2_free_months) then round(mtg_over_paid[d] * min(mtg_fee, mtg2_fee_cap), 0.01, half-up) else 0

def mtg_over_paid[d in b_day]: money DUK = sum(r in jodla_row where jodla_paid[r].booked = d and jodla_paid[r].jk = overpayment: jodla_paid[r].amt)

def mtg_over_on[d in b_day]: money DUK = mtg_over_paid[d] - mtg_fee_on[d]

def mtg_bal[d in b_day]: money DUK
  rule before when d < deed_day = 0
  rule paid_out excepts before when d = deed_day = mtg_amount
  rule later excepts before, paid_out = mtg_bal[d - 1] - mtg_principal_on[d] - mtg_over_on[d]

def mtg_interest_year[y in b_tax_year]: money DUK = sum(k in b_month where year_of(mtg_due[k]) = y: mtg_interest[k])

def mtg_last: date = last(k in b_month where mtg_live[k]: mtg_due[k])

def mtg_after_last[d in b_day]: money DUK = mtg_bal[last(k in b_month where mtg_live[k] and mtg_due[k] <= d: mtg_due[k])]

def flat_costs[y in b_tax_year]: money DUK = sum(r in jodla_row where year_of(jodla_paid[r].booked) = y: jodla_paid[r].amt) + sum(k in b_month where year_of(k) = y: assoc_fee) + flat_insurance

def ola_paid_flat[y in b_tax_year]: money DUK = sum(k in b_month where year_of(k) = y and not order_rejected[k]: hr1_order) + flat_insurance

def ola_share_flat[y in b_tax_year]: money DUK = round(flat_costs[y] * own_share[ola], 0.01, half-up)

def ola_owes_piotr[y in b_tax_year]: money DUK = ola_share_flat[y] - ola_paid_flat[y]
