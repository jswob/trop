part flat
  tally 1
  note "The flat ul. Wrzosowa 12/5 (B-D04), its mortgage 7710-22 at Bank Jodła (B-D07, B-D08, B-D28), the lease it replaced (B-D31, B-D32), Ola's studio (B-D33, B-D34) and the flat's costs (B-HR1, B-D09, B-D10)."

input flat_price: money DUK question "What was the flat's price (B-D04 .1)?"
input deed_day: date question "On which day was the deed signed (B-D04)?"
input own_share[p in person]: num question "What share of the flat does this person own (B-D04)?"
input own_paid[p in person]: money DUK question "What did this person pay of the price from their own money (B-D04 .2)?"
input notary_fee: money DUK question "What was the notary's fee (B-D04 .4)?"
input flat_value: money DUK question "What is the flat's latest valuation (B-D29)?"
input b_rent: money DUK question "What was the monthly rent of ul. Lipowa 4/7 (B-D31 .1)?"
input lease_end: date question "On which day did the lease end (B-D32)?"
input b_deposit: money DUK question "What deposit was paid on the lease (B-D31 .2)?"
input deposit_kept: money DUK question "What did the landlady keep of the deposit (B-D32)?"
input deposit_back_on: date question "On which day was the deposit returned (B-D32)?"
input studio_price: money DUK question "What did the studio sell for (B-D34)?"
input studio_sale_cost: money DUK question "What did selling the studio cost (B-D34: the agent's invoice)?"
input studio_cost: money DUK question "What did the studio cost to buy, with its tax and fees (B-D33)?"
input studio_sold: date question "When was the studio sold (B-D34)?"
input kitchen_price: money DUK question "What does the fitted kitchen cost (B-D35)?"
input ola_housing_spent: money DUK question "What has Ola spent on her own housing by the end of the third year after the sale, beyond the deed (PIT-12 .4)?"
input mtg_amount: money DUK question "What was the mortgage's amount (B-D07 .1)?"
input mtg_terms: int question "How many monthly instalments (B-D07 .1)?"
input mtg_first: date question "When is the first instalment (B-D07 .1)?"
input mtg_margin: num question "What is the margin over DUKOR 6M, in percentage points (B-D07 .2)?"
input mtg_fee: num question "What fee is charged on an overpayment within the free-fee months (B-D07 .5)?"
input b_held[m in b_month]: bool question "Was this month's instalment suspended under MTG-1 (B-D08)?"
input jodla_paid[r in jodla_row]: (booked date, jk key jodla_kind, amt money DUK, fee money DUK) question "What does this row of Bank Jodła's 2025 statement say (B-D28)?"
input assoc_fee: money DUK question "What is the building's monthly fee (B-D09)?"
input flat_insurance: money DUK question "What was the flat insurance's premium, and who paid it (B-D10)?"
input hr1_order: money DUK question "What does Ola send Piotr each month for the flat (B-HR1 .2)?"
input order_rejected[m in b_month]: bool question "Was Ola's standing order of this month rejected?"

place mortgage_cash: outside DUK

version deed
  cite b_d04
  known 2022-03-18
  flat_price = 600000.00 "B-D04 .1"
  deed_day = 2022-03-18 "B-D04"
  own_share[piotr] = 0.60 "B-D04: a 60 % share"
  own_share[ola] = 0.40 "B-D04: a 40 % share"
  own_paid[piotr] = 108000.00 "B-D04 .2"
  own_paid[ola] = 72000.00 "B-D04 .2"
  notary_fee = 4920.00 "B-D04 .4"

