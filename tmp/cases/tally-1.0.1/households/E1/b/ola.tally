part ola
  tally 1
  note "Ola's employment at Mewa Logistyka (B-D25, B-D25b, B-D26): gross, contributions, health, the advances (PIT-4, by the month pay is paid), the net that reaches Wrzos, and her returns (PIT-5, PIT-3)."

input ola_gross[m in b_month]: money DUK question "What is Ola's gross pay for this month?"
input ola_late[m in b_month]: date question "Was this month's pay paid on another day than the 28th rule?"
input ola_spend[m in b_month]: money DUK question "What did Ola spend from Wrzos this month (no statement kept)?"
input ola_ort: money DUK question "What is one ort in dukats (the search step for B-07)?"

version mewa_2024
  cite b_d25
  known 2023-12-16
  ola_gross[2024-01..2024-09] = 7200.00 "B-D25: from January 2024, 7 200.00 DUK"
  ola_gross[2024-11..2024-12] = 7200.00 "B-D25"
  ola_late[*] = - assumed "pay is paid by the 28th rule unless a letter moves it" "B-D25"
  ola_ort = 0.01 "the ort is the dukat's minor unit (questions.md: to the ort)"

version mewa_october
  cite wrzos_export
  known 2024-10-28
  ola_gross[2024-10] = ? "What was Ola's gross pay for October 2024? Her statement shows a net of 7 351.59 (wrz-ola-2024-10.csv line 18), not B-D25's 7 200.00 gross"

version mewa_2025
  cite b_d25b
  known 2024-12-16
  ola_gross[2025-01..2025-12] = 7600.00 "B-D25b: from January 2025, 7 600.00 DUK"

version mewa_late
  cite b_d26
  known 2025-03-03
  ola_late[2025-02] = 2025-03-07 "B-D26: February's pay on 7 March 2025 (read on 3 March)"

version ola_unseen
  cite b_story
  known 2025-04-02
  ola_spend[2025-04..2025-12] = ? "What did Ola spend from her Wrzos account from April 2025 on? She kept no statement after March 2025 (story.md, the table)"
  ola_spend[2024-11..2025-01] = ? "What did Ola spend from Wrzos from November 2024 to January 2025? No statement kept"

def ola_pay_on[m in b_month]: date
  rule rule28 = prev_business(day_of(m, 28), holidays)
  rule moved excepts rule28 when ola_late[m] != - = ola_late[m]

def ola_social[m in b_month]: money DUK = sum(c in soc1_part: round(ola_gross[m] * soc1_rate[c], 0.01, half-up))

def ola_health[m in b_month]: money DUK = round(soc2_rate * (ola_gross[m] - ola_social[m]), 0.01, half-up)

def ola_adv_base[m in b_month]: money DUK = round(ola_gross[m] - ola_social[m] - pit2_costs_month, 1, half-up)

def ola_advance[m in b_month]: money DUK at ola_pay_on[m] = max(0, round(ola_adv_base[m] * pit3_rate(ola_adv_base[m]) - pit3_reducing / 12, 1, half-up))

def ola_net[m in b_month]: money DUK = ola_gross[m] - ola_social[m] - ola_health[m] - ola_advance[m]

pay mewa_pay[m in b_month]
  from mewa
  to wrzos
  amount ola_net[m]
  on ola_pay_on[m]
  when start_of(m) >= start_of(month_of(day_of(2024-01, 1)))

pay ola_order[m in b_month]
  from wrzos
  to cis
  amount hr1_order
  on next_business(day_of(m, 5), holidays)
  when not order_rejected[m] and start_of(m) > deed_day

pay ola_spent[m in b_month]
  from wrzos
  to elsewhere
  amount ola_spend[m]
  on end_of(m)
  when ola_spend[m] != -

def ola_paid_in[m in b_month, y in b_tax_year]: bool = year_of(ola_pay_on[m]) = y

def ola_income[y in b_tax_year]: money DUK = sum(m in b_month where ola_paid_in[m, y]: ola_gross[m])

def ola_base[y in b_tax_year]: money DUK = round(sum(m in b_month where ola_paid_in[m, y]: ola_gross[m] - ola_social[m] - pit2_costs_month), 1, half-up)

def ola_tax[y in b_tax_year]: money DUK at end_of(y) = round(ola_base[y] * pit3_rate(ola_base[y]) - pit3_reducing, 1, half-up)

def ola_advances[y in b_tax_year]: money DUK = sum(m in b_month where ola_paid_in[m, y]: ola_advance[m])

def ola_result[y in b_tax_year]: money DUK = ola_advances[y] - ola_tax[y]

def joint_result[y in b_tax_year]: money DUK
  rule spouses_r when spouses = ? "Joint filing (PIT-6 .1) is for spouses: is there a marriage? Piotr and Ola aren't married (B-D04), and Piotr's business income is taxed under form (c), not with the scale"
  rule unmarried excepts spouses_r when not spouses = ? "What would a joint return be for an unmarried couple? PIT-6 .1 gives none: there is no joint unit, and Piotr's income is under form (c)"
