part e1_gifts
  tally 1
  note "E1-03: gifts and inheritances across the family. Halina's gifts to Ania are A's (A/gift.tally), Zbigniew's estate is D's (D/estate.tally). E1 adds what neither states: that each heir is close family of Zbigniew under IGT-4 .1, which D's exemption rules now test (households/E1/d/estate.tally), and that Halina gave from her own property."

input e1_close_family[h in heir]: bool question "Is this heir close family of Zbigniew Sowa under IGT-4 .1: a spouse, a descendant, an ascendant, a stepchild, a sibling or a step-parent?"

input e1_gift_own[a in acq]: bool question "Did the giver give this from her own property, outside the community with her husband (CIV-1.3)?"

def e1_gifts_in_estate: bool
  note "whether any of Halina's gifts to Ania came out of what became Zbigniew's estate: a gift of her own property did not (CIV-1.3), and D-D07 .1 lists no fund units among what she takes"
  rule base = any(a in acq where acq_from[a] = halina: not e1_gift_own[a])

version e1_d_d04
  cite d_d04
  known 2024-10-21
  e1_close_family[halina] = true "D-D04: his wife Halina Sowa; IGT-4 .1 names a spouse"
  e1_close_family[piotr] = true "D-D04: his children Piotr Sowa, Anna Lis and Marta; IGT-4 .1 names a descendant"
  e1_close_family[anna] = true "D-D04: his children Piotr Sowa, Anna Lis and Marta; IGT-4 .1 names a descendant"
  e1_close_family[marta] = true "D-D04: his children Piotr Sowa, Anna Lis and Marta; IGT-4 .1 names a descendant"
  e1_close_family[jakub] = true "D-D04: in place of his son Adam Sowa, who died before him, Adam's son Jakub Sowa; a grandson is a descendant (IGT-4 .1)"

version e1_gift_cash
  cite e1_story
  known 2021-04-30
  e1_gift_own[cash2021] = true "story.md line 36: from the money she inherited from her mother in 2018 (her own)"

version e1_gift_units
  cite e1_story
  known 2023-09-12
  e1_gift_own[units2023] = true "story.md line 37: Halina had bought them with her own money"
