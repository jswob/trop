part longview
  tally 1
  note "D-10 and D-11: the story's long view (story.md, The long view, points 1-10), run as D-HR3 says, on paths and with zero volatility. Its figures are the household's round assumptions, known 2026-09-30, each row assumed with its point."
  note "Years are lyear 2026..2064: the key 2026 holds the state on 1 January 2027 and the 2026 levels; money flows from 2027."

input lv_acct0: money DUK question "What does the account hold on 1 January 2027 (point 1)?"
input lv_fund0: money DUK question "What does the fund hold on 1 January 2027 (point 1)?"
input q_base: num question "What is the chance of dying in the year she turns 68 (point 2)?"
input q_growth: num question "By what factor does that chance grow with each year of age (point 2)?"
input q_last_age: int question "At what age is the chance 1 (point 2)?"
input lv_infl: num question "By how much do prices rise in this year (point 3)?"
input surv_2026: money DUK question "What is the survivor pension from March 2026 (point 4)?"
input own_2026: money DUK question "What is her own pension from March 2026 (point 4)?"
input min_2026: money DUK question "What is MIN-PENSION from March 2026 (point 4)?"
input rent_2026: money DUK question "What is the rent from March 2026 (point 5)?"
input fee_2026: money DUK question "What is the building fee in 2026 (point 5)?"
input spend_2026: money DUK question "What does she spend a year, in 2026 money (point 6)?"
input care_2026: money DUK question "What does care cost a year, in 2026 money (point 6)?"
input care_age: int question "From the year she turns what age does she pay for care (point 6)?"
input fund_mu: num question "What is the fund's mean return (point 7)?"
input fund_sd: num question "What is the fund's scale on the t draw (point 7)?"
input fund_df: int question "How many degrees of freedom has the t draw (point 7)?"
input r_floor_loss: num question "What is the largest loss a return can show (point 7)?"
input sweep: money DUK question "Above what balance does the account sweep into the fund (point 8)?"

bound py_stream "the paths as Python's random.Random(20261001 + path) draws them (D-HR3's seed)" because "a foreign program's random stream can't be held (L §5.17); the draws below are tally's SHA-256 inversion samples of the same distributions, so path figures agree with the key within their standard errors, not digit for digit"

draw life_u[p in path, y in lyear] ~ uniform(0, 1) to 1e-12

draw zr[p in path, y in lyear, j in draw5] ~ normal(0, 1) to 1e-12

def grow[y in lyear]: num = 1 + lv_infl

def factor[y in lyear]: num
  rule first when pos(y) = 1 = 1
  rule later when pos(y) > 1 = factor[y - 1] * grow[y]

def surv_lvl[y in lyear]: money DUK
  rule first when pos(y) = 1 = surv_2026
  rule later when pos(y) > 1 = round(surv_lvl[y - 1] * grow[y - 1], 0.01, half-up)

def own_lvl[y in lyear]: money DUK
  rule first when pos(y) = 1 = own_2026
  rule later when pos(y) > 1 = round(own_lvl[y - 1] * grow[y - 1], 0.01, half-up)

def min_lvl[y in lyear]: money DUK
  rule first when pos(y) = 1 = min_2026
  rule later when pos(y) > 1 = round(min_lvl[y - 1] * grow[y - 1], 0.01, hh_round)

def part_at[y in lyear, lv in lyear]: money DUK = max(0, min(round(own_lvl[lv] * soc7_part, 0.01, half-up), soc7_cap_mult * min_lvl[lv] - surv_lvl[lv]))

def gross_jf[y in lyear]: money DUK = if pos(y) > 1 then surv_lvl[y - 1] + part_at[y, y - 1] else 0

def gross_md[y in lyear]: money DUK = surv_lvl[y] + part_at[y, y]

def lv_gross[y in lyear]: money DUK = 2 * gross_jf[y] + 10 * gross_md[y]

def lv_health[y in lyear]: money DUK = 2 * round(gross_jf[y] * soc2_rate, 0.01, half-up) + 10 * round(gross_md[y] * soc2_rate, 0.01, half-up)

def lv_pit[y in lyear]: money DUK = round(max(0, marginal(pit3_rate, round(lv_gross[y], 1, half-up)) - pit3_reducing), 1, half-up)

def rent_lvl[y in lyear]: money DUK
  rule first when pos(y) = 1 = rent_2026
  rule later when pos(y) > 1 = round(rent_lvl[y - 1] * grow[y - 1], 0.01, hh_round)

def fee_lvl[y in lyear]: money DUK
  rule first when pos(y) = 1 = fee_2026
  rule later when pos(y) > 1 = round(fee_lvl[y - 1] * grow[y - 1], 0.01, hh_round)

def rent_year[y in lyear]: money DUK = if pos(y) > 1 then 2 * rent_lvl[y - 1] + 10 * rent_lvl[y] else 0

def ogr_year[y in lyear]: money DUK = round(flat_after[halina] * (rent_year[y] - 12 * fee_lvl[y]), 0.01, hh_round) - round(marginal(pit13_rate, rent_year[y] * flat_after[halina]), 1, half-up)

def age_in[y in lyear]: int = age(born_halina, add_days(end_of(y), -1))

def spend_year[y in lyear]: money DUK = round((spend_2026 + (if age_in[y] >= care_age then care_2026 else 0)) * factor[y], 0.01, hh_round)

def lv_money[y in lyear]: money DUK = lv_gross[y] - lv_health[y] - lv_pit[y] + ogr_year[y] - spend_year[y]

def q_die[a in life_age]: num
  rule base = round(q_base * pow(q_growth, pos(a) - 1), 0.0001, hh_round)
  rule last excepts base when a >= q_last_age = 1

def surv_prob[y in lyear]: num
  rule first when pos(y) = 1 = 1
  rule later when pos(y) > 1 = surv_prob[y - 1] * (1 - q_die[age_in[y]])

def exp_years: num = sum(y in lyear where pos(y) > 1: surv_prob[y])

def exp_tax: num DUK = sum(y in lyear where pos(y) > 1: surv_prob[y] * lv_pit[y])

def zv_pre[y in lyear]: num DUK = if pos(y) > 1 then zv_acct[y - 1] + lv_money[y] else 0

def zv_fpre[y in lyear]: money DUK = if pos(y) > 1 then round(zv_fund[y - 1] * (1 + fund_mu), 0.01, hh_round) else 0

def zv_acct[y in lyear]: money DUK
  rule first when pos(y) = 1 = lv_acct0
  rule later when pos(y) > 1 = if zv_pre[y] > sweep then sweep else if zv_pre[y] < 0 then zv_pre[y] + min(zv_fpre[y], -zv_pre[y]) else zv_pre[y]

def zv_fund[y in lyear]: money DUK
  rule first when pos(y) = 1 = lv_fund0
  rule later when pos(y) > 1 = if zv_pre[y] > sweep then zv_fpre[y] + zv_pre[y] - sweep else if zv_pre[y] < 0 then zv_fpre[y] - min(zv_fpre[y], -zv_pre[y]) else zv_fpre[y]

def zv_dry_year: year = if count(y in lyear where pos(y) > 1 and zv_acct[y] < 0) > 0 then first(y in lyear where pos(y) > 1 and zv_acct[y] < 0) else -

def zv_share: num = if zv_dry_year != - then surv_prob[zv_dry_year] else 0

def t_draw[p in path, y in lyear]: num = zr[p, y, 1] / (sqrt((zr[p, y, 2] * zr[p, y, 2] + zr[p, y, 3] * zr[p, y, 3] + zr[p, y, 4] * zr[p, y, 4] + zr[p, y, 5] * zr[p, y, 5]) / fund_df) to 1e-12)

def r_path[p in path, y in lyear]: num = max(-r_floor_loss, round(fund_mu + fund_sd * t_draw[p, y] / (sqrt(2) to 1e-12), 0.000001, hh_round))

def alive[p in path, y in lyear]: bool
  rule first when pos(y) = 1 = true
  rule later when pos(y) > 1 = alive[p, y - 1] and life_u[p, y] >= q_die[age_in[y]]

def p_pre[p in path, y in lyear]: num DUK = if pos(y) > 1 then p_acct[p, y - 1] + lv_money[y] else 0

def p_fpre[p in path, y in lyear]: money DUK = if pos(y) > 1 then round(p_fund[p, y - 1] * (1 + r_path[p, y]), 0.01, hh_round) else 0

def p_acct[p in path, y in lyear]: money DUK
  rule first when pos(y) = 1 = lv_acct0
  rule later when pos(y) > 1 = if p_pre[p, y] > sweep then sweep else if p_pre[p, y] < 0 then p_pre[p, y] + min(p_fpre[p, y], -p_pre[p, y]) else p_pre[p, y]

def p_fund[p in path, y in lyear]: money DUK
  rule first when pos(y) = 1 = lv_fund0
  rule later when pos(y) > 1 = if p_pre[p, y] > sweep then p_fpre[p, y] + p_pre[p, y] - sweep else if p_pre[p, y] < 0 then p_fpre[p, y] - min(p_fpre[p, y], -p_pre[p, y]) else p_fpre[p, y]

def p_nw[p in path, y in lyear]: money DUK = p_acct[p, y] + p_fund[p, y]

def p_years[p in path]: int = count(y in lyear where pos(y) > 1 and alive[p, y])

def p_tax[p in path]: money DUK = sum(y in lyear where pos(y) > 1 and alive[p, y]: lv_pit[y])

def p_dry[p in path]: bool = count(y in lyear where pos(y) > 1 and alive[p, y] and p_acct[p, y] < 0) > 0

def p_zv_dry[p in path]: bool = zv_dry_year != - and alive[p, zv_dry_year]

version long_view
  cite d_story
  known 2026-09-30
  note "story.md, The long view, decided with D-HR3 on 2026-09-30"
  lv_acct0 = 10000.00 assumed "point 1: a round figure taken as given"
  lv_fund0 = 45000.00 assumed "point 1: a round figure taken as given"
  q_base = 0.0120 assumed "point 2"
  q_growth = 1.105 assumed "point 2"
  q_last_age = 105 assumed "point 2: at 105 it is 1"
  lv_infl = 0.03 assumed "point 3: 3 % a year from 2026 on" governs 2026..
  surv_2026 = 5247.88 assumed "point 4, from March 2026"
  own_2026 = 3048.80 assumed "point 4, from March 2026"
  min_2026 = 1970.00 assumed "point 4, MIN-PENSION from March 2026 (gazette.csv line 1910)"
  rent_2026 = 1976.00 assumed "point 5, from March 2026"
  fee_2026 = 468.00 assumed "point 5, 2026"
  spend_2026 = 54000.00 assumed "point 6, in 2026 money"
  care_2026 = 36000.00 assumed "point 6, in 2026 money"
  care_age = 80 assumed "point 6: from the year she turns 80 (2039)"
  fund_mu = 0.05 assumed "point 7"
  fund_sd = 0.16 assumed "point 7"
  fund_df = 4 assumed "point 7"
  r_floor_loss = 0.95 assumed "point 7: never below -95 %"
  sweep = 15000.00 assumed "point 8"
