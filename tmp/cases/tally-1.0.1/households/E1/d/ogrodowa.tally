part ogrodowa
  tally 1
  note "The flat's money from July 2025: the rent (D-D25), the building fee (D-D27), the boiler (D-D28), and Kuba's 3/16 under D-HR1 (D-05)."

input lease_from: month question "From what month is the flat let (D-D25)?"

input lease_rent: money DUK question "What is the rent at the lease's start (D-D25)?"

input cpi_avg[y in year]: num question "What is the CPI average of this year, the year before = 100 (CPI-AVG, read by the lease)?"

input rent_day[m in d_month]: date question "On what day did the rent for this month reach the account?"

input fee_amt[y in year]: money DUK question "What is the monthly building fee in this year (D-D27)?"

input fee_dom: int question "On what day of the month is the fee collected (D-D27)?"

input boiler_amt: money DUK question "What did the boiler cost (D-D28)?"

input boiler_day: date question "On what day was the boiler paid?"

input kuba_part: num question "What part of the rent less the costs goes to Kuba (D-HR1)?"

input kuba_dom: int question "By what day of the month after the quarter is Kuba's part sent (D-HR1)?"

input kuba_reached[q in quarter]: date question "On what day did this quarter's part reach Kuba (- if nothing was sent)?"

def rent_amt[m in d_month]: money DUK
  note "D-D25: 1 900.00 from July 2025, on each 1 March from 2026 times CPI-AVG of the year before over 100, to the ort (no mode named)"
  rule first when m = lease_from = lease_rent
  rule later when m > lease_from = if is_march[m] then round(rent_amt[m - 1] * cpi_avg[year_of(m) - 1] / 100, 0.01, hh_round) else rent_amt[m - 1]

pay rent_in[m in d_month]
  from outside_duk
  to konto
  amount rent_amt[m]
  on rent_day[m]
  when m >= lease_from

pay fee_out[m in d_month]
  from konto
  to outside_duk
  amount fee_amt[year_of(m)]
  on next_business(day_of(m, fee_dom), holidays)

pay boiler_out
  from konto
  to outside_duk
  amount boiler_amt
  on boiler_day

def q_rent[q in quarter]: money DUK = flows(rent_in, start_of(q)..add_days(add_months(start_of(q), 3), -1))

def q_costs[q in quarter]: money DUK = flows(fee_out, start_of(q)..add_days(add_months(start_of(q), 3), -1)) + flows(boiler_out, start_of(q)..add_days(add_months(start_of(q), 3), -1))

def q_share[q in quarter]: money DUK = round((q_rent[q] - q_costs[q]) * kuba_part, 0.01, half-up)

def q_carry[q in quarter]: money DUK
  note "D-HR1: a negative share is carried into the next quarter"
  rule first when pos(q) = 1 = 0
  rule later when pos(q) > 1 = min(0, q_share[q - 1] + q_carry[q - 1])

def q_send[q in quarter]: money DUK = max(0, q_share[q] + q_carry[q])

def q_due_day[q in quarter]: date = day_of(month_of(add_months(start_of(q), 3)), kuba_dom)

def q_due[q in quarter]: date at q_due_day[q] = next_business(q_due_day[q], holidays)

def owed_kuba[d in d_day]: money DUK = sum(q in quarter where add_days(add_months(start_of(q), 3), -1) <= d: if q_due[q] > d then q_send[q] else if kuba_reached[q] != - and kuba_reached[q] > d then q_send[q] else 0)

version lease
  cite d_d25
  known 2025-06-24
  lease_from = 2025-07 "D-D25: from 1 July 2025"
  lease_rent = 1900.00 "D-D25: 1 900.00 DUK a month"

version cpi_avg_2025
  cite gazette
  governs 2025
  known 2026-01-15
  cpi_avg[2025] = 104.0 "gazette.csv line 24 CPI-AVG-2025"

version fees
  cite d_d27
  known 2025-12-11
  fee_amt[2024] = 420.00 "D-D27"
  fee_amt[2025] = 445.00 "D-D27"
  fee_amt[2026] = 468.00 "D-D27"
  fee_dom = 5 "D-D27: on the 5th, or the next business day"

version boiler_invoice
  cite d_d28
  known 2026-02-16
  boiler_amt = 6840.00 "D-D28"

version kuba_rule
  cite d_house_rules
  known 2025-06-24
  kuba_part = 0.1875 "D-HR1: Kuba's 3/16"
  kuba_dom = 10 "D-HR1: by the 10th of the next month, or the next business day"
