part estate
  tally 1
  note "D-01 and D-02: who inherits Zbigniew's estate (CIV-3), the division of 12 June 2025 (CIV-5, D-D07), and the inheritance tax (IGT-2, IGT-3, IGT-4)."

input div_day: date question "On what day was the estate divided (D-D07)?"

input div_flat_value: money DUK question "What value does the division agreement give the flat (D-D07)?"

input div_setoff: money DUK question "What set-off for the flat's fees does the agreement make (D-D07)?"

input refund_2024: money DUK question "What did Zbigniew's 2024 return refund to the estate (D-D31)?"

input div_paid_on: date question "On what day were the heirs paid (D-D07)?"

input flat_keeper[h in heir]: bool question "Does this heir keep a share of the flat after the division (D-D07)?"

input flat_own: bool question "Was the flat Zbigniew's own property, outside the community (CIV-1, D-D06)?"

input cert_final: date question "On what day did the certificate of inheritance become final (D-D04)?"

input reported_on[h in heir]: date question "On what day did this heir report the inheritance to the RO (IGT-4 .2)?"

input flat_value_at_tax: money DUK question "What was the flat worth on the day the tax arose (IGT-2 base)? The agreement's value is a price the heirs agreed, not a valuation."

input life_to_estate: bool question "Was the group life benefit paid into the estate rather than to a named beneficiary (D-D21)?"

def stock_alive[k in stock]: bool = stock_died[k] = - or (stock_died[k] != - and stock_died[k] > death_day)

def stock_counts[k in stock]: bool = stock_alive[k] or stock_issue[k] > 0

def stocks: int = count(k in stock where stock_counts[k])

def spouse_share: num = if married then max(1 / (stocks + 1), civ3_spouse_min) else 0

def heirs_in[k in stock]: int = count(h in heir where heir_stock[h] != - and heir_stock[h] = k)

def share[h in heir]: num
  note "CIV-3 .1: the spouse equal to a child, never below 1/4; the children share the rest; .2: a child who died before is replaced by its children in equal parts"
  rule child = if stock_counts[heir_stock[h]] then (1 - spouse_share) / stocks / heirs_in[heir_stock[h]] else 0
  rule spouse excepts child when h = halina = spouse_share

def bonds_all[d in d_day]: money DUK = sum(s in isb_series: d_lot[s] * bond_value[s, d])

def acct_at_death: money DUK = bal(konto, death_day)

def estate_divided: money DUK
  note "D-D07: the flat at the agreed value, half the bonds and half the account (community, CIV-2 .2, TSB-7 .1), the refund, less the set-off"
  rule base = round(div_flat_value + bonds_all[div_day] / 2 + acct_at_death / 2 + refund_2024 - div_setoff, 0.01, hh_round)

def keeper_base: money DUK = estate_divided - div_flat_value

def payout_exact[h in heir]: num DUK
  rule giver = share[h] * estate_divided
  rule keeper excepts giver when flat_keeper[h] = share[h] * keeper_base
  rule taker excepts keeper when h = halina = 0

def payout[h in heir]: money DUK = round(payout_exact[h], 1, down)

def d_deposit: money DUK = sum(h in heir where h != halina: payout[h])

def kept_by_rounding: num DUK = sum(h in heir where h != halina: payout_exact[h]) - d_deposit

def flat_after[h in heir]: num
  rule none = 0
  rule keeps excepts none when flat_keeper[h] = share[h]
  rule taker excepts keeps when h = halina = share[h] + sum(g in heir where g != halina and flat_keeper[g] = false: share[g])

def igt_arises: date = cert_final

def report_due: date = add_months(igt_arises, igt4_report_months)

def report_by: date at report_due = next_business(report_due, holidays)

def acq_value[h in heir]: money DUK = round(share[h] * (flat_value_at_tax + bonds_all[death_day] / 2 + acct_at_death / 2 + refund_2024), 0.01, hh_round)

def igt_tax[h in heir]: money DUK
  note "IGT-4: the close family exempt if reported within 6 months (.2), or if not above IGT-FREE-I (.3); otherwise Group I (IGT-3)"
  note "E1 copy: rules small and reported also hold IGT-4 .1's first condition, that the heir is close family, as the fact e1_close_family (households/E1/gifts.tally, from D-D04); D's own rules test the report and the free amount alone"
  rule taxed = round(igt3_scale[group_1](max(0, acq_value[h] - igt_free[group_1])), 1, half-up)
  rule small excepts taxed when e1_close_family[h] and acq_value[h] <= igt_free[group_1] = 0
  rule reported excepts small when e1_close_family[h] and reported_on[h] != - and reported_on[h] <= report_by = 0

def life_igt_taxed: bool = life_to_estate

version division
  cite d_d07
  known 2025-06-12
  div_day = 2025-06-12 "D-D07, date of the agreement"
  div_flat_value = 165000.00 "D-D07: the flat valued at 165 000.00 DUK for the division"
  div_setoff = 5610.00 "D-D07: set-off for the flat's fees Halina paid"
  div_paid_on = 2025-06-16 "D-D07: payouts from the notary's deposit on 2025-06-16"
  flat_keeper[halina] = false "D-D07: Halina takes the shares given up"
  flat_keeper[piotr] = false "D-D07: Piotr gives up his share for a payout"
  flat_keeper[anna] = false "D-D07: Anna gives up her share for a payout"
  flat_keeper[marta] = false "D-D07: Marta gives up her share for a payout"
  flat_keeper[jakub] = true "D-D07: Jakub keeps his 3/16"

version land_register
  cite d_d06
  known 2024-07-02
  flat_own = true "D-D06: owner Zbigniew Sowa alone, by inheritance from his mother"

version estate_refund
  cite d_d31
  known 2025-05-22
  refund_2024 = 1844 "D-D31: advances 1 844 less tax 0, paid 2025-05-21"

version inheritance_cert
  cite d_d04
  known 2024-10-21
  cert_final = 2024-11-03 "D-D04: final on 3 November 2024"

version halina_report
  cite d_d08
  known 2025-05-05
  reported_on[halina] = 2025-05-05 "D-D08"

version group_life
  cite d_d21
  known 2024-06-29
  life_to_estate = false "D-D21: paid to the named beneficiary, Halina Sowa"
