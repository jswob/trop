part e1_worth_part
  tally 1
  note "E1-02: what each of the six was worth at the end of 2025, each counted by their own household's rules (A-HR5, B-HR4, D-HR4; tmp/cases/E1/story.md), and Jakub, who has no household in the set, from D's papers; the family is the six added up. Each person's rule is the household's own reading (A-11, B-11, D-08), so the family counts no one twice."

index e1_person = [ania, tomek, piotr, ola, halina, jakub]
  note "the six whose worth the family counts: ania and tomek are A's spouse keys, piotr and ola B's person keys, halina and jakub D's heir keys (story.md, The family, lines 9–20). Jakub has no household of his own in the set and is counted from D's papers."

input e1_wrzos_end: money DUK question "What was Ola's Wrzos balance at the end of 2025? Its last statement is of March 2025"

input e1_jakub_rest: money DUK question "What did Jakub have and owe at the end of 2025 beyond his 3/16 of Ogrodowa and what Halina owed him?"

input e1_jakub_tax_unpaid: money DUK question "How much of his PIT-13 on his 3/16 of 2025's Ogrodowa rent (D-HR1 .4) had Jakub still to pay at the end of 2025?"

def e1_jakub_flat: money DUK
  note "Jakub's 3/16 of Ogrodowa at the valuation of D-D29 (D/sale.tally:56–59), as D values Halina's 13/16 (keep_value, D/sale.tally:39; D-HR4 .2)"
  rule base = round(valuation * flat_after[jakub], 0.01, hh_round)

def e1_worth[p in e1_person]: money DUK
  note "Ania and Tomek as A-11 reads them (A/asks/A-11.tally); Piotr as B-11 does (B/asks/B-11.tally); Ola as B-11 does, with her Wrzos balance, which B books from its plan after the March statement, taken out and asked for (e1_wrzos_end); Halina as D-08 does (d08_net_worth, D/asks-D-08.tally); Jakub from D's papers: his 3/16 of Ogrodowa, what Halina owed him, and what no text states (e1_jakub_rest, e1_jakub_tax_unpaid)"
  rule w_ania when p = ania = nw_person[ania]
  rule w_tomek when p = tomek = nw_person[tomek]
  rule w_piotr when p = piotr = worth_piotr[2025-12-31]
  rule w_ola when p = ola = worth_ola[2025-12-31] - bal(wrzos, 2025-12-31) + e1_wrzos_end
  rule w_halina when p = halina = bal(konto, 2025-12-31) + bonds_net[2025-12-31] + keep_value + sio_owes[2025-12-31] - owed_kuba[2025-12-31] - rent_adv[2025-12] - pen_due[2025] + house_value
  rule w_jakub when p = jakub = e1_jakub_flat + owed_kuba[2025-12-31] + e1_jakub_rest - e1_jakub_tax_unpaid

def e1_family: money DUK
  note "the family together: the six added up. A debt within the family (Ola's to Piotr, Halina's to Jakub) is one person's minus and another's plus, so it adds nothing"
  rule base = sum(p in e1_person: e1_worth[p])
