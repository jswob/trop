part e1_asks_03
  tally 1
  note "E1-03 · Gifts and inheritances (tmp/cases/E1/questions.md): as of and known 2025-12-31. The tax on Zbigniew's estate for Anna, Piotr and Jakub turns on whether each reported by report_by, which no text states, so it is two asks, one per case, each pinning reported_on (as D-02 does)."

ask e1_03_dates: igt_arises, report_by as known 2025-12-31

ask e1_03_anna_from_halina: gift_tax[cash2021], gift_tax[units2023], sum(a in acq where acq_from[a] = halina and acq_to[a] = ania: gift_tax[a]) as known 2025-12-31

ask e1_03_halina: reported_on[halina], igt_tax[halina] as known 2025-12-31

ask e1_03_reported: igt_tax[anna], igt_tax[piotr], igt_tax[jakub] with reported_on[anna] = report_by, reported_on[piotr] = report_by, reported_on[jakub] = report_by as known 2025-12-31

ask e1_03_not_reported: igt_tax[anna], igt_tax[piotr], igt_tax[jakub] with reported_on[anna] = -, reported_on[piotr] = -, reported_on[jakub] = - as known 2025-12-31

ask e1_03_gifts_in_estate: e1_gifts_in_estate as known 2025-12-31

ask e1_03_close_family: check all(h in heir: e1_close_family[h]) = true as known 2025-12-31
