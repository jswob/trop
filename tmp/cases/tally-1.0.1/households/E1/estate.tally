part e1_estate
  tally 1
  note "E1-01: Zbigniew's estate, paid out. D derives the shares and the payouts (D/estate.tally) and books Halina's payment into the notary's deposit (D/records.tally:25); D-D07 .5 names the accounts; B states Piotr's payout (B-D27) and its Cis savings export shows it (B/records/savings-2025.tally:14); A states Ania's (A-D36, A/worth.tally:18) and her Wrzos export shows it, in the one row of that export E1 writes (O:E1-5)."

index e1_account = [ln45-2090-0017-5521-3380-0002, ln61-1140-2004-0000-3402-9921-5503, ln52-2090-0017-4471-0098-0001]
  note "the payout accounts D-D07 .5 names: LN45 2090 0017 5521 3380 0002 (Piotr's, B's place savings), LN61 1140 2004 0000 3402 9921 5503 (Ania's, A's place ania_sav) and LN52 2090 0017 4471 0098 0001 (Jakub's, in no household). A key has no spaces or capitals (L §2.1), so each is its number in lower case with hyphens (O:E1-6)."

input e1_paid_to[h in heir]: key e1_account question "To which account did the notary pay this heir (D-D07 .5)?"

index e1_wrz_row: open
  note "the rows of Ania's Wrzos savings export (tmp/cases/A/records/wrz-ania-savings-2025.csv) that E1 reads"

input e1_wrz[r in e1_wrz_row]: movement DUK question "What does this row of Ania's Wrzos savings export show?"

input e1_piotr_notice: money DUK question "How much does the notary's notice B-D27 say was paid to Piotr?"

def e1_arrived[h in heir]: date
  note "the day the payout reached the heir's account, from that account's own record: Piotr's in B's Cis savings export, Ania's in her Wrzos export. Marta's and Jakub's accounts are in no household, so no record shows theirs."
  rule unrecorded = ? "On which day did this payout reach the heir's account? No record in the family shows it; D-D07 .5 says only where it was sent"
  rule rec_piotr excepts unrecorded when h = piotr = sav[s20250616a].on
  rule rec_anna excepts unrecorded when h = anna = e1_wrz[w20250616a].on

def e1_paid_in: money DUK
  note "what Halina paid into the notary's deposit: konto's row of 2025-06-12 (D/records.tally:25) is an outflow, so its sign turns"
  rule base = -bank[r20250612a].amount

def e1_deposit_left: money DUK
  note "what the deposit held once the notary paid out: what Halina paid in, less D's payouts to the four other heirs (d_deposit, D/estate.tally:59)"
  rule base = e1_paid_in - d_deposit

version e1_d_d07
  cite d_d07
  known 2025-06-12
  note "Marta's account has no row: D-D07 .5 says only 'to her account'"
  e1_paid_to[piotr] = ln45-2090-0017-5521-3380-0002 "D-D07 .5: to Piotr Sowa to LN45 2090 0017 5521 3380 0002"
  e1_paid_to[anna] = ln61-1140-2004-0000-3402-9921-5503 "D-D07 .5: to Anna Lis to LN61 1140 2004 0000 3402 9921 5503"
  e1_paid_to[jakub] = ln52-2090-0017-4471-0098-0001 "D-D07 .5: to Jakub Sowa to LN52 2090 0017 4471 0098 0001"

version e1_b_d27
  cite b_d27
  known 2025-06-16
  e1_piotr_notice = 38750.00 "B-D27: 38 750.00 DUK paid to Piotr Sowa, an heir, on 16.06.2025, to account LN45 2090 0017 5521 3380 0002"

version e1_wrz_2025
  cite wrz_ania
  governs 2025
  known 2026-01-15
  note "one row of the export, the one E1-01 reads. A modelled Ania's savings from the year-end statement alone (A/records.tally:66), and the export's other rows are not E1's to copy by hand, so the version covers nothing; the statement of 2025-12-31 anchors the balance A reads (L §5.18) (O:E1-5)"
  e1_wrz[w20250616a] = (2025-06-16, ania_sav, 38750.00, -) "wrz-ania-savings-2025.csv line 7: 16.06.2025;INCOMING TRANSFER;Kancelaria Notarialna Brzoza – escrow;payout, division of the estate of Zbigniew Sowa, A. Lis;38750,00;38750,00"
