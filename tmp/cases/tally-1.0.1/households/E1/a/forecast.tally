part sell_all
  tally 1
  note "E1 copy (O:E1-2): fc_place gets the rule other_currency, since in the family the built-in index place also holds B's places in florens, which no rule of A's types as money DUK (L §3.2)."
  note "A-12, what the forecast asks (story § The forecast, as we see it on 2026-01-15): the next car's day, everything in the wrapped and both Rzeka accounts at the end of 2035, the tax on selling it all that day, and what is left in January-2026 money. The walk is plan.tally's; the forecast's figures are rows of the scenario forecast (scenarios/forecast.tally), the paths stack on it."
  note "Selling it all is not booked: the sale is on the walk's last day, so its value is the places' balances that day, and its tax is computed here (PIT-8, PIT-9)."
  note "The gains tax reaches only the forecast's own purchases: every lot bought by the end of 2025 (Tomek's and Ania's in their Rzeka accounts, whose rows the importer can't read, O:A-1) is held more than 5 years on 2035-12-31 and so is exempt (PIT-8 .6); the walk's purchases are not lots (index lot is opened by rows, L §5.6), so they are read here from the pays that made them (awkward)."

input fc_sell_day: date question "On which day do we sell everything in the wrapped and Rzeka accounts (story § The forecast, item 5)?"

input fc_infl: num question "By what rate a month is money turned back into January-2026 money (story § The forecast, item 6)?"

input fc_months: int question "For how many months is money turned back into January-2026 money (story § The forecast, item 6)?"

input wrap_left_2025: money DUK question "What contributions not yet withdrawn did the wrapped account hold at the end of 2025 (PIT-9 .4)?"

input wrap_years_2025: int question "In how many calendar years up to 2025 did Ania contribute to the wrapped account (PIT-9 .5)?"

version wrap_history
  cite brz_wrap
  known 2026-01-15
  note "the contribution and withdrawal rows of brz-wrapped-ania.csv (lines 3–123), which the importer can't read (O:A-1); A-D35 states only that the 2024 withdrawal was within the contributions"
  wrap_left_2025 = ? "the contributions to the wrapped account up to 2025-12-31 less what the 2024 withdrawal took of them (brz-wrapped-ania.csv, O:A-1)"
  wrap_years_2025 = ? "the years with a contribution row in brz-wrapped-ania.csv (O:A-1)"

def fc_in[x in place]: bool
  note "story § The forecast, item 5: the wrapped account and both Rzeka accounts"
  rule none = false
  rule sold excepts none when x = wrap_cash or x = wrap_glb or x = wrap_bnd or x = rzt_cash or x = rzt_glb or x = rzt_div or x = rzt_idx or x = rzt_em or x = rza_cash or x = rza_glb or x = rza_mm = true

def fc_place[x in place]: money DUK
  note "a place's value at the end of fc_sell_day: an account's balance; a holding's units at that day's price, rounded to the ort"
  rule balance = bal(x, fc_sell_day)
  rule holding excepts balance when kind(x) = holding = round(worth(x, fc_sell_day), 0.01, half-up)
  rule other_currency excepts balance when kind(x) != holding and currency(x) != DUK = ? "E1 copy (O:E1-2): a place in another currency (B's florens); A-HR5 counts dukats, and no such place is Ania's or Tomek's"

def fc_value: money DUK
  note "story § The forecast, item 5: everything in the wrapped and Rzeka accounts on fc_sell_day"
  rule base = sum(x in place where fc_in[x]: fc_place[x])

def fc_wrap_value: money DUK
  note "PIT-9 .4: what selling it all withdraws from the wrapped account"
  rule base = sum(x in place where fc_in[x] and inv_holder[x] = ania and (x = wrap_cash or x = wrap_glb or x = wrap_bnd): fc_place[x])

def fc_wrap_left: money DUK
  note "PIT-9 .4: the contributions not yet withdrawn on fc_sell_day: those of the register to 2025, and what the walk paid in from walk_from"
  rule base = wrap_left_2025 + flows(invest_wrap, walk_from..fc_sell_day)

def fc_wrap_years: int
  note "PIT-9 .5: the calendar years with a contribution, the register's to 2025 and the walk's from 2026"
  rule base = wrap_years_2025 + count(y in tax_year where start_of(y) >= walk_from and start_of(y) <= fc_sell_day and flows(invest_wrap, start_of(y)..min(add_days(end_of(y), -1), fc_sell_day)) > 0)

def fc_wrap_tax: money DUK at fc_sell_day
  note "PIT-9 .4, .5: the earnings withdrawn, 19 % of them rounded, unless Ania is 60 or older and has contributed in 5 calendar years"
  rule base = round(max(0, fc_wrap_value - fc_wrap_left) * pit9_rate, 1, half-up)
  rule free excepts base when age(birth_day[ania], fc_sell_day) >= pit9_age and fc_wrap_years >= pit9_years = 0

def fc_gain_buy[m in month]: num DUK
  note "PIT-8 .2, .6: a purchase of BRZ-GLB-A the walk made in Tomek's Rzeka account, sold on fc_sell_day: its units at that day's price less what was paid with the fee; a purchase held more than 5 years is exempt. The car's sale in A-HR3 takes the oldest units first (PIT-8 .3), all bought before these"
  rule none = 0
  rule taxed excepts none when rule_day[m] >= walk_from and r_c[m] > 0 and fc_sell_day <= add_years(rule_day[m], pit8_exempt_years) = r_units[m] * px_glb[fc_sell_day] - (round(r_units[m] * px_glb[rule_day[m]], 0.01, half-up) + r_fee[m])

def fc_gains_tax: money DUK at fc_sell_day
  note "PIT-8 .4: the year's gains and losses added, the base rounded, 19 % of it rounded (the rate of the tax year of the sale; the what-if's 25 % from 2030)"
  rule base = round(round(max(0, sum(m in month: fc_gain_buy[m])), 1, half-up) * pit8_rate, 1, half-up)

def fc_real: money DUK
  note "story § The forecast, item 6: what is left after both taxes, divided by 1.0025 for each of the 119 months, to the ort"
  rule base = round((fc_value - fc_wrap_tax - fc_gains_tax) / pow(1 + fc_infl, fc_months), 0.01, half-up)

def fc_car_day: date
  note "A-HR3: the 15th on which the next car is bought"
  rule base = first(m in month where rule_day[m] >= walk_from and flows(hr3_car[m], rule_day[m]..rule_day[m]) > 0: rule_day[m])
