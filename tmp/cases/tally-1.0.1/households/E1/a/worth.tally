part worth
  tally 1
  note "E1 copy (O:E1-2): nw_place gets the rule other_currency, since in the family the built-in index place also holds B's places in florens, which no rule of A's types as money DUK (L §3.2)."
  note "A-HR5, how we count what we have (A-11): what we own together counts half each, the odd ort Tomek's (.1); what is one person's counts for that person (.2); pay earned but not yet paid counts at what will reach the account (.3); workplace-plan contributions count once the plan has credited them (.4), which the registers' units already are; a tax return's result not yet settled counts, shared like the pay it comes from (.5)."
  note "A place's share (owns, CIV-1) can't split one balance by origin: Ania's savings account holds her estate payout (hers, CIV-1 .3) and the interest it earned (community, CIV-1 .2), so nw_ania_sav_interest takes the interest out of her own and adds it to the community (awkward)."

input nw_day: date question "On which day is what we're worth counted?"

input estate_paid: money DUK question "How much of Ania's savings account is the estate payout (A-D36)?"

version nw_count
  cite questions
  known 2021-01-01
  nw_day = 2025-12-31 "questions.md A-11: at the end of 2025"

version estate_payout
  cite a_d36
  known 2025-06-13
  estate_paid = 38750.00 "A-D36: Anna Lis receives 38 750.00 DUK for her share, paid to LN61 … 5503 on 16 June 2025"

def nw_place[x in place]: money DUK
  note "a place's value at the end of nw_day: a holding's units at that day's price, rounded to the ort; an account's or a claim's balance"
  rule balance = bal(x, nw_day)
  rule holding excepts balance when kind(x) = holding = round(worth(x, nw_day), 0.01, half-up)
  rule other_currency excepts balance when kind(x) != holding and currency(x) != DUK = ? "E1 copy (O:E1-2): a place in another currency (B's florens); A-HR5 counts dukats, and no such place is Ania's or Tomek's"

def nw_ania_sav_interest: money DUK
  note "CIV-1 .2: the interest on Ania's savings, net of the tax withheld, is community; the rest of the balance is the estate payout (CIV-1 .3)"
  rule base = bal(ania_sav, nw_day) - estate_paid

def nw_pay_due: money DUK
  note "A-HR5 .3: Tomek's December 2025 pay, net, paid on 2026-01-15 (A-D02-2025, A-D04): earned, not yet paid on 2025-12-31; Ania's December pay was paid on 2025-12-31"
  rule base = net[nurt, month_of(add_days(nw_day, 1))]

def nw_return: money DUK
  note "A-HR5 .5: the 2025 joint return's result, owed to us (+) or by us (−), not yet settled on 2025-12-31; both pay incomes are community, so it is shared like them"
  rule base = round(-together_joint[year_of(nw_day)], 0.01, half-up)

def nw_community: money DUK
  note "A-HR5 .1: the places owned half each, and the community's other claims"
  rule base = sum(x in place where kind(x) != outside and owns[ania, x] = 0.5 and owns[tomek, x] = 0.5: nw_place[x]) + nw_pay_due + nw_return + nw_ania_sav_interest

def nw_own[s in spouse]: money DUK
  note "A-HR5 .2: the places only one person owns"
  rule base = sum(x in place where kind(x) != outside and owns[s, x] = 1: nw_place[x]) - (if s = ania then nw_ania_sav_interest else 0)

def nw_half[s in spouse]: money DUK
  note "A-HR5 .1: half each; if the sum doesn't split into two equal halves, the odd ort is Tomek's"
  rule ania_half when s = ania = round(nw_community / 2, 0.01, down)
  rule tomek_half when s = tomek = nw_community - round(nw_community / 2, 0.01, down)

def nw_person[s in spouse]: money DUK = nw_half[s] + nw_own[s]

def nw_household: money DUK = sum(s in spouse: nw_person[s])
