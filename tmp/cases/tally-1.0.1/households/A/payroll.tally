def g_due[e in payer, p in month]: money DUK
  note "the gross pay due for pay period p"
  rule monthly = gross[e, p] + extra[e, p]
  rule set excepts monthly when due_override[e, p] != - = due_override[e, p]

def pay_on[e in payer, m in month]: date at start_of(m)
  note "the payment day of month m; read in month m, so the holiday list read is that year's (GEN-1 rows govern one year each, O:A-5)"
  rule dom = prev_business(day_of(m, payday_dom[e, m]), holidays)
  rule last excepts dom when last_bd[e] = prev_business(add_days(end_of(m), -1), holidays)

def g_paid[e in payer, m in month]: money DUK
  note "gross pay paid in payment month m (PIT-2 .1); parental pay is the days of the period in the month before × a day's pay (SOC-8 .4)"
  rule work = g_due[e, m - lag[e]]
  rule parental excepts work when e = sio = round(overlap_days(leave_from, leave_to, m - 1) * sio_day_pay, 0.01, half-up)

def er_rate[e in payer]: num = wcp1_er_basic + plan_topup_er[e]

def ee_rate[e in payer]: num = wcp1_ee_basic + plan_extra_ee[e]

def er_paid[e in payer, m in month]: money DUK
  note "the employer's plan contributions paid in month m, on the pay paid in the month before (A-D08 .3, A-D09 .2): income of month m (WCP-2 .1), outside the SOC bases"
  rule none = 0
  rule plan excepts none when in_plan[e] = round(g_paid[e, m - 1] * er_rate[e], 0.01, half-up)

def ee_paid[e in payer, m in month]: money DUK
  note "the employee's plan contribution, deducted from the pay after tax and contributions (WCP-2 .2)"
  rule none = 0
  rule plan excepts none when in_plan[e] = round(g_paid[e, m] * ee_rate[e], 0.01, half-up)

def inc[e in payer, m in month]: money DUK = g_paid[e, m] + er_paid[e, m]

def ytd_gross[e in payer, m in month]: money DUK = sum(k in month where year_of(k) = year_of(m) and k < m: g_paid[e, k])

def capped[e in payer, m in month]: money DUK
  note "the part of the month's gross pay up to SOC-CAP on the year's gross from this employer (SOC-1 .2)"
  rule base = max(0, min(g_paid[e, m], soc_cap - ytd_gross[e, m]))

def soc_part[e in payer, m in month, c in soc1_part]: money DUK
  note "SOC-1 .1–.3: pension and disability on the capped part, sickness on all of it, each rounded to the ort half up; parental pay bears none"
  rule capped_part = round(capped[e, m] * soc1_rate[c], 0.01, half-up)
  rule sick excepts capped_part when c = sickness = round(g_paid[e, m] * soc1_rate[c], 0.01, half-up)
  rule parental excepts capped_part, sick when e = sio = 0

def soc[e in payer, m in month]: money DUK = sum(c in soc1_part: soc_part[e, m, c])

def health[e in payer, m in month]: money DUK
  note "SOC-2 .1: 9 % of gross pay less the SOC-1 contributions, to the ort half up; parental pay bears none"
  rule pay = round((g_paid[e, m] - soc[e, m]) * soc2_rate, 0.01, half-up)
  rule parental excepts pay when e = sio = 0

def costs[e in payer, m in month]: money DUK
  note "PIT-2 .2: the monthly costs for each month in which pay from an employment is paid; parental pay has none (A-D13-SIO-2023: costs 0.00)"
  rule none = 0
  rule paid excepts none when e != sio and g_paid[e, m] > 0 = pit2_costs_month

def mbase[e in payer, m in month]: money DUK
  note "PIT-4 .1: the month's PIT-2 base from this payer (PIT-2 .3, never below 0), rounded to whole dukats (GEN-5 .1)"
  rule base = round(max(0, inc[e, m] - soc[e, m] - costs[e, m]), 1, half-up)

def cum[e in payer, m in month]: money DUK = sum(k in month where year_of(k) = year_of(m) and k <= m: mbase[e, k])

def red12[e in payer]: num DUK
  note "1/12 of the yearly reducing amount where the statement is on file with this payer (PIT-4 .2)"
  rule none = 0
  rule filed excepts none when statement[e] = pit3_reducing / 12

def adv_scale[e in payer, m in month]: num DUK
  note "PIT-4 .2 before the health deduction and the rounding: the scale on this payer's bases to date less the scale on the earlier ones, less 1/12 of the reducing amount"
  rule base = marginal(pit3_rate, cum[e, m]) - marginal(pit3_rate, cum[e, m] - mbase[e, m]) - red12[e]

def adv_w[e in payer, m in month]: num DUK
  note "the PIT-3 version in force on the payment day (PIT-4 .2): the wording pin reads the scale entered by that day (L §4.3)"
  rule base = adv_scale[e, m] as if {wording pay_on[e, m] for [pit3_rate, pit3_reducing]}

def adv[e in payer, m in month]: money DUK
  note "PIT-4 .2: never below 0, rounded to whole dukats; v1 also less the month's health contribution up to 7.75 % of its base; v2 .4: in July–December 2022 the lower of the advance under PIT-3 v2 and under PIT-3 v3"
  rule v1 v pit4_v1 = round(max(0, adv_w[e, m] - min(health[e, m], soc2_deductible * (g_paid[e, m] - soc[e, m]))), 1, half-up)
  rule v2 v pit4_v2 = round(max(0, adv_w[e, m]), 1, half-up)
  rule lower excepts v2 v pit4_v2_p4 = min(round(max(0, adv_w[e, m]), 1, half-up), round(max(0, adv_scale[e, m] as if {wording pit4_lower_wording for [pit3_rate, pit3_reducing]}), 1, half-up))

def net[e in payer, m in month]: money DUK
  note "what reaches the account: gross pay less contributions, health, the employee's plan contribution and the advance"
  rule base = g_paid[e, m] - soc[e, m] - health[e, m] - ee_paid[e, m] - adv[e, m]
