part payroll
  tally 1
  note "Pay, by payer e and payment month m: what is paid in m, the employer's plan contributions paid with it, the SOC-1 and SOC-2 contributions, the PIT-2 base, the PIT-4 advance and the net. Pay is income on the day paid (PIT-2 .1); the employer's plan contributions are income on the day the employer pays them to the plan (WCP-2 .1)."
  note "Nurt pays the pay for a month on the 10th of the next month (A-D01 §4), the 15th from the pay for December 2024 (A-D04), on the last business day before where that day isn't one, with both plan contributions for a pay on the next payday (A-D08 .3). Kalina pays on the last business day of the month (A-D05 §3), the plan contributions for a month's pay on the 15th of the next month (A-D09 .2), so with the next pay's payroll. The SIO pays a month's parental pay by the 10th of the next month (A-D15)."
  note "Rounding: contributions to the ort half up (GEN-5 .3, SOC-1 .3, WCP-1 .4); the month's base and the advance to whole dukats, under 50 orts down, 50 and over up (GEN-5 .1, PIT-4 .1–.2). The employer's basic and top-up contributions are rounded once together: with the rates' sum of 2.5 % on pay in whole orts the two roundings agree for every pay of the dossier."

input gross[e in payer, p in month]: money DUK question "What is the monthly gross pay for this pay period?"

input extra[e in payer, p in month]: money DUK question "What one-off gross pay is paid with this pay period's pay?"

input due_override[e in payer, p in month]: money DUK question "What gross pay is due for this pay period, where it isn't the monthly pay?"

input lag[e in payer]: int question "How many months after its pay period is a pay paid?"

input payday_dom[e in payer, m in month]: int question "On which day of the payment month is the pay due?"

input last_bd[e in payer]: bool question "Is the pay paid on the last business day of the month?"

input in_plan[e in payer]: bool question "Does this payer pay workplace-plan contributions?"

input plan_extra_ee[e in payer]: num question "What additional contribution has the employee declared (WCP-1 .2)?"

input plan_topup_er[e in payer]: num question "What top-up does the employer's plan add (WCP-1 .3)?"

input leave_from: date question "When does Ania's parental pay start?"

input leave_to: date question "When does Ania's parental pay end?"

input sio_day_pay: money DUK question "What is a day's parental pay (SOC-8 .4)?"

version payroll_defaults
  cite modeller
  known 2021-01-01
  note "a month's pay is the monthly gross pay unless a document sets the month's pay otherwise; the SIO pays nothing until a decision"
  due_override[nurt, 2021-01..2035-12] = - "A-D01 §5: the monthly gross pay, as set each year"
  due_override[kalina, 2021-01..2035-12] = - "A-D05 §3: the monthly pay; §7 only for months not worked in full"
  extra[kalina, 2021-01..2035-12] = 0 "A-D05: no pay but the monthly pay"
  gross[sio, 2021-01..2035-12] = 0 "the SIO pays parental pay only (SOC-8), which g_paid computes from the decision"
  extra[sio, 2021-01..2035-12] = 0 "the SIO pays parental pay only"
  due_override[sio, 2021-01..2035-12] = - "the SIO pays parental pay only"

version nurt_terms
  cite a_d01
  known 2019-03-01
  lag[nurt] = 1 "A-D01 §4: the pay for a month is paid in the next month"
  payday_dom[nurt, 2021-01..2035-12] = 10 "A-D01 §4: on the 10th of the next month; where the 10th is not a business day, on the last business day before it"
  last_bd[nurt] = false "A-D01 §4"
  extra[nurt, 2021-01..2035-12] = 0 "A-D01 §5: the pay is the monthly gross pay set in writing each year"

version kalina_terms
  cite a_d05
  known 2018-06-01
  lag[kalina] = 0 "A-D05 §3: paid in the month it is for"
  last_bd[kalina] = true "A-D05 §3: on the last business day of the month it is for"

version nurt_plan
  cite a_d08
  known 2019-06-20
  in_plan[nurt] = true "A-D08: workplace plan of Nurt Software"
  plan_extra_ee[nurt] = 0.01 "A-D08 .2: Tomasz Lis has declared an additional contribution of 1 %"
  plan_topup_er[nurt] = 0.01 "A-D08 .1: the plan's top-up of 1.0 %"

version kalina_plan
  cite a_d09
  known 2019-06-24
  in_plan[kalina] = true "A-D09: workplace plan of Kalina Logistyka"
  plan_extra_ee[kalina] = 0 "A-D09 .1: no additional contribution declared"
  plan_topup_er[kalina] = 0 "A-D09 .1: no top-up"

version sio_terms
  cite a_d15
  known 2023-05-11
  lag[sio] = 1 "A-D15: each month's pay is paid by the 10th of the next month"
  payday_dom[sio, 2021-01..2035-12] = 10 assumed "A-D15 says by the 10th, not the day; the 10th is taken, on the last business day before it where it isn't one" "A-D15"
  last_bd[sio] = false "A-D15"
  in_plan[sio] = false "WCP-1: parental pay bears no plan contributions"
  plan_extra_ee[sio] = 0 "WCP-1: none on parental pay"
  plan_topup_er[sio] = 0 "WCP-1: none on parental pay"
  leave_from = 2023-04-27 "A-D15: 27 April 2023 – 24 April 2024"
  leave_to = 2024-04-24 "A-D15: 27 April 2023 – 24 April 2024"
  sio_day_pay = 123.44 "A-D15: a day's pay"

