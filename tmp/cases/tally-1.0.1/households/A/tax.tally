part tax
  tally 1
  note "The yearly returns (PIT-5, PIT-6, PIT-7). A payer's year comes from its yearly information (A-D13) once it has arrived, and is computed from the payroll before (A-02 as known 2022-05-31). A result is the tax less the advances: positive is payable, negative is a refund."
  note "The scenario no_cut (scenarios/no_cut.tally) restates PIT-3 v2 for 2022 on: its version nocut_on makes the advances computed again under it, as the key's without figures do (PIT-3 v2 throughout, advances too)."

index cause = [joint_filing, rate_cut]
  note "the two things A-01 names that made the 2022 refund larger"

input info[e in payer, y in tax_year]: (income money DUK, costs money DUK, soc money DUK, health_ded money DUK, advances money DUK) question "What does this payer's yearly information state for this tax year?"

input cut_before: date question "On which day was the PIT-3 wording before the July 2022 cut last in force?"

version no_info
  cite modeller
  known 2021-01-01
  note "a payer's yearly information arrives in February after the year; until it has, there is none, and the year is computed from the payroll"
  info[*, *] = - "no yearly information has arrived"

version info_2021
  cite a_d13_nurt_2021
  known 2022-02-24
  info[nurt, 2021] = (77280.00, 3000.00, 10141.30, 5057.55, 4960.00) "A-D13-NURT-2021: income, costs, social contributions, health deductible (7.75 %), advances"
  info[kalina, 2021] = (60897.00, 3000.00, 8070.00, 4024.58, 3419.00) "A-D13-KALINA-2021: income, costs, social contributions, health deductible (7.75 %), advances"

version info_2022
  cite a_d13_nurt_2022
  known 2023-02-24
  info[nurt, 2022] = (192490.00, 3000.00, 24236.10, -, 27411.00) "A-D13-NURT-2022: income, costs, social contributions, advances; no health deduction under SOC-2 v2"
  info[kalina, 2022] = (63333.00, 3000.00, 8392.80, -, 3402.00) "A-D13-KALINA-2022: income, costs, social contributions, advances"

version info_2023
  cite a_d13_nurt_2023
  known 2024-02-24
  info[nurt, 2023] = (81975.00, 3000.00, 10757.31, -, 4970.00) "A-D13-NURT-2023: income, costs, social contributions, advances"
  info[kalina, 2023] = (21271.20, 1000.00, 2808.36, -, 962.00) "A-D13-KALINA-2023: income, costs, social contributions, advances"

version info_sio_2023
  cite a_d13_sio_2023
  known 2024-03-01
  info[sio, 2023] = (26909.92, 0.00, 0.00, -, 3499.00) "A-D13-SIO-2023: parental pay, no costs or contributions, advances"

version pit3_cut_day
  cite pit_3
  governs 2022-01-01..2022-12-31
  known 2022-06-14
  cut_before = 2022-06-30 "PIT-3 v2 in force 2022-01-01 – 2022-06-30; v3 in force 2022-07-01, published 2022-06-14"

def y_inc[e in payer, y in tax_year]: money DUK
  rule calc = sum(m in month where year_of(m) = y: inc[e, m])
  rule doc excepts calc when info[e, y] != - = info[e, y].income

def y_soc[e in payer, y in tax_year]: money DUK
  rule calc = sum(m in month where year_of(m) = y: soc[e, m])
  rule doc excepts calc when info[e, y] != - = info[e, y].soc

def y_costs[e in payer, y in tax_year]: money DUK
  rule calc = sum(m in month where year_of(m) = y: costs[e, m])
  rule doc excepts calc when info[e, y] != - = info[e, y].costs

def y_hded[e in payer, y in tax_year]: num DUK
  note "SOC-2 v1 .2: the health contributions up to 7.75 % of their bases, read only by the PIT-5 v1 rules"
  rule calc = sum(m in month where year_of(m) = y: min(health[e, m], soc2_deductible * (g_paid[e, m] - soc[e, m])))
  rule doc excepts calc when info[e, y] != - = info[e, y].health_ded

def y_adv[e in payer, y in tax_year]: money DUK
  rule calc = sum(m in month where year_of(m) = y: adv[e, m])
  rule doc excepts calc when info[e, y] != - = info[e, y].advances
  rule nocut excepts doc v nocut_on = sum(m in month where year_of(m) = y: adv[e, m])

def base_p[s in spouse, y in tax_year]: money DUK
  note "PIT-5 .2: the sum of the person's PIT-2 bases from every payer (PIT-2 .3, never below 0), rounded (GEN-5 .1)"
  rule base = round(sum(e in payer where earner[e, y] = s: max(0, y_inc[e, y] - y_soc[e, y] - y_costs[e, y])), 1, half-up)

def adv_p[s in spouse, y in tax_year]: money DUK = sum(e in payer where earner[e, y] = s: y_adv[e, y])

def hded_p[s in spouse, y in tax_year]: num DUK = sum(e in payer where earner[e, y] = s: y_hded[e, y])

def relief_months[c in child, y in tax_year]: int
  note "PIT-7 .1: the months of the year in which the child was alive and under 18 on at least one day"
  rule base = count(k in month where year_of(k) = y and born[c] < end_of(k) and (born[c] >= start_of(k) or age(born[c], start_of(k)) < pit7_age))

def parents_income[y in tax_year]: money DUK = sum(s in spouse: base_p[s, y])

def relief[y in tax_year]: money DUK
  note "PIT-7 .1, .3: 125.00 DUK a month for each child, less the parents' income above 112 000.00 DUK, never below 0"
  rule base = max(0, sum(c in child: pit7_relief_month * relief_months[c, y]) - max(0, parents_income[y] - pit7_income_limit))

def relief_half[s in spouse, y in tax_year]: num DUK
  note "PIT-7 .4: the relief in halves, carried exactly (GEN-5 .5)"
  rule base = relief[y] / 2

def sep_tax[s in spouse, y in tax_year]: money DUK
  note "PIT-5 .3: the PIT-3 tax of the version governing the year, less the child relief (v1: less the health deductible), never below 0, rounded"
  rule v1 v pit5_v1 = round(max(0, marginal(pit3_rate, base_p[s, y]) - pit3_reducing - relief_half[s, y] - hded_p[s, y]), 1, half-up)
  rule v2 v pit5_v2 = round(max(0, marginal(pit3_rate, base_p[s, y]) - pit3_reducing - relief_half[s, y]), 1, half-up)

def res_sep[s in spouse, y in tax_year]: money DUK
  note "PIT-5 .4: a separate return's result, the tax less the advances"
  rule base = sep_tax[s, y] - adv_p[s, y]

def joint_base[y in tax_year]: money DUK
  note "PIT-6 .3: the combined base, rounded"
  rule base = round(base_p[ania, y] + base_p[tomek, y], 1, half-up)

def joint_tax[y in tax_year]: money DUK
  note "PIT-6 .3: twice the PIT-3 tax on half the combined base (the half exact), rounded"
  rule base = round(2 * max(0, marginal(pit3_rate, joint_base[y] / 2) - pit3_reducing), 1, half-up)

def part_floor[s in spouse, y in tax_year]: money DUK = round(joint_tax[y] * base_p[s, y] / joint_base[y], 1, floor)

def jpart[s in spouse, y in tax_year]: money DUK
  note "PIT-6 .5: each spouse's part in proportion to their base, in whole dukats; a dukat left over goes to the larger base"
  rule floor_part = part_floor[s, y]
  rule larger excepts floor_part when s = argmax(t in spouse: base_p[t, y]) = part_floor[s, y] + joint_tax[y] - sum(t in spouse: part_floor[t, y])

def res_joint[s in spouse, y in tax_year]: num DUK
  note "PIT-6 .4, PIT-5 .4: the spouse's part less the half of the child relief, never below 0, less the spouse's advances; reading E of pit6_health also takes the health deductible off under PIT-5 v1, rounded as PIT-5 v1 .3 rounds a tax"
  rule reliefs = max(0, jpart[s, y] - relief_half[s, y]) - adv_p[s, y]
  rule health excepts reliefs v pit5_v1 when pit6_health = health_off = round(max(0, jpart[s, y] - relief_half[s, y] - hded_p[s, y]), 1, half-up) - adv_p[s, y]

def together_sep[y in tax_year]: money DUK = sum(s in spouse: res_sep[s, y])

def together_joint[y in tax_year]: num DUK = sum(s in spouse: res_joint[s, y])

def gain[c in cause, y in tax_year]: num DUK
  note "how much larger each cause made the year's refund: joint filing, the separate returns less the joint one (PIT-6); the rate cut, the joint return with the PIT-3 wording before the cut, the advances as withheld, less the actual one (PIT-3 v3 governs the whole tax year 2022)"
  rule filing when c = joint_filing = together_sep[y] - together_joint[y]
  rule cut when c = rate_cut = together_joint[y] as if {wording cut_before for [pit3_rate, pit3_reducing]} - together_joint[y]
