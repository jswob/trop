scenario no_cut
  tally 1
  from 2022-01-01
  note "A-01's without: the July 2022 cut never made, PIT-3 v2 for 2022 on, advances too (questions.md A-01: without the cut). The rule nocut of y_adv (tax.tally) points at nocut_on, so the advances are computed again, not read from the yearly information."

version nocut_on
  cite questions
  enters 2022-01-01
  pit3_rate: [0, 120000] = 0.18 "PIT-3 v2 .1, kept in force: 18 % of the base up to 120 000.00 DUK"
  pit3_rate: (120000, inf) = 0.33 "PIT-3 v2 .1, kept in force: 33 % of the part above 120 000.00 DUK"
  pit3_reducing = 5400.00 "PIT-3 v2 .2, kept in force"
