def lot_start[l in lot]: num fund_u
  note "the units of the same account's earlier lots"
  rule base = sum(k in lot where lot_place[k] = lot_place[l] and pos(k) < pos(l): lot_units[k])

def sale_start[s in sale]: num fund_u
  note "the units the same account's earlier sales took"
  rule base = sum(t in sale where sale_place[t] = sale_place[s] and pos(t) < pos(s): sale_units[t])

def took[l in lot, s in sale]: num fund_u
  note "PIT-8 .3: the units of lot l that sale s took, first in first out, never across accounts"
  rule none = 0
  rule fifo excepts none when lot_place[l] = sale_place[s] = max(0, min(lot_start[l] + lot_units[l], sale_start[s] + sale_units[s]) - max(lot_start[l], sale_start[s]))

def px_at[x in place, d in day]: num DUK/fund_u
  note "the price of the fund a holding holds"
  rule glb when x = wrap_glb or x = rzt_glb or x = rza_glb or x = kop_glb = px_glb[d]
  rule bnd when x = wrap_bnd = px_bnd[d]
  rule div when x = rzt_div = px_div[d]
  rule mm when x = rza_mm = px_mm[d]
  rule idx when x = rzt_idx = px_idx[d]
  rule em when x = rzt_em = px_em[d]
  rule wcp when x = wcp_t or x = wcp_a = px_wcp[d]

def lot_cost[l in lot]: num DUK at lot_on[l]
  note "PIT-8 .2: the price paid with the purchase fee; a gifted lot costs its units times the fund's price of the last valuation day on or before the gift"
  rule paid = lot_paid[l]
  rule gift excepts paid when lot_gifted[l] = lot_units[l] * px_at[lot_place[l], prev_business(lot_on[l], holidays)]

def gain_part[l in lot, s in sale]: num DUK
  note "PIT-8 .2: the proceeds of the units lot l gave sale s (price times units, less their part of the sale fee) less their part of the lot's cost"
  rule base = took[l, s] * sale_px[s] - sale_fee[s] * took[l, s] / sale_units[s] - lot_cost[l] * took[l, s] / lot_units[l]

def exempt_part[l in lot, s in sale]: bool at sale_on[s]
  note "PIT-8 .6, GEN-3 .1: held more than 5 years, counting from the giver's acquisition for a gifted lot"
  rule base = sale_on[s] > add_years(lot_held_from[l], pit8_exempt_years)

def net_gain[p in spouse, y in tax_year]: num DUK
  note "PIT-8 .4: all of the person's gains and losses of the year added; an exempt part is left out (.6)"
  rule base = sum(l in lot, s in sale where inv_holder[sale_place[s]] = p and year_of(sale_on[s]) = y and took[l, s] > 0 and not exempt_part[l, s]: gain_part[l, s])

def cg_loss[p in spouse, o in tax_year]: num DUK = max(0, -net_gain[p, o])

def cg_gain[p in spouse, y in tax_year]: num DUK = max(0, net_gain[p, y])

def loss_avail[p in spouse, o in tax_year, y in tax_year]: num DUK
  note "what is left of the loss of year o at the start of year y"
  rule start = cg_loss[p, o]
  rule next excepts start when pos(y) > pos(o) + 1 = loss_left[p, o, y - 1]

def loss_want[p in spouse, o in tax_year, y in tax_year]: num DUK
  note "PIT-8 .5: in the 5 years after the loss, at most half of it in any one year"
  rule none = 0
  rule window excepts none when pos(y) > pos(o) and pos(y) <= pos(o) + pit8_carry_years = min(loss_avail[p, o, y], cg_loss[p, o] / 2)

fill carry[y in tax_year]
  note "PIT-8 .5: losses are used only against a net gain, the older first"
  supply loss_want[p, o, y] for p in spouse, o in tax_year
  demand cg_gain[q, y] for q in spouse
  arc p = q
  order o

def loss_used_from[p in spouse, o in tax_year, y in tax_year]: num DUK = carry[y].taken[p, o, p]

def loss_left[p in spouse, o in tax_year, y in tax_year]: num DUK = loss_avail[p, o, y] - loss_used_from[p, o, y]

def loss_used[p in spouse, y in tax_year]: num DUK = sum(o in tax_year: loss_used_from[p, o, y])

def loss_left_after[p in spouse, y in tax_year]: num DUK
  note "the losses still inside their 5 years after year y, and what is left of them"
  rule base = sum(o in tax_year where pos(o) <= pos(y) and pos(y) < pos(o) + pit8_carry_years: loss_left[p, o, y])

def cg_base[p in spouse, y in tax_year]: money DUK
  note "PIT-8 .4: the net gain less the losses carried in, rounded (GEN-5 .1)"
  rule base = round(cg_gain[p, y] - loss_used[p, y], 1, half-up)

def cg_tax[p in spouse, y in tax_year]: money DUK
  note "PIT-8 .4: 19 % of the base, rounded (GEN-5 .1)"
  rule base = round(cg_base[p, y] * pit8_rate, 1, half-up)

def broker_tax[p in spouse, y in tax_year]: money DUK
  note "A-D22's way, for comparison: every lot at the cost the transferring broker reported (A-D21), and no holding test"
  rule base = round(round(sum(l in lot, s in sale where inv_holder[sale_place[s]] = p and year_of(sale_on[s]) = y and took[l, s] > 0: took[l, s] * sale_px[s] - lot_reported[l] * took[l, s] / lot_units[l]), 1, half-up) * pit8_rate, 1, half-up)

index wd: open
  note "withdrawals from the wrapped account"

input wd_on[w in wd]: date question "On which day were the units redeemed for this withdrawal?"

input wd_amount[w in wd]: money DUK question "How much was withdrawn?"

input wd_contrib_left[w in wd]: money DUK question "What contributions not yet withdrawn did the account hold before this withdrawal (PIT-9 .4)?"

input wd_within[w in wd]: bool question "Does the provider state that the withdrawal is within the contributions not yet withdrawn?"

input wd_years[w in wd]: int question "In how many calendar years had the holder contributed by the withdrawal (PIT-9 .5)?"

version withdrawal_2024
  cite a_d35
  known 2024-03-08
  wd_on[w20240305] = 2024-03-05 "A-D35: redeemed on 5 March 2024"
  wd_amount[w20240305] = 19999.99 "A-D35: units of BRZ-BND-A worth 19 999.99 DUK"
  wd_contrib_left[w20240305] = ? "the contributions to the wrapped account up to 2024-03-05, the contribution rows of brz-wrapped-ania.csv, which the importer can't read (O:A-1)"
  wd_within[w20240305] = true "A-D35: the amount withdrawn is within the contributions not yet withdrawn; no tax is withheld"
  wd_years[w20240305] = ? "the years with a contribution row in brz-wrapped-ania.csv (O:A-1)"

def wd_earnings[w in wd]: money DUK
  note "PIT-9 .4: a withdrawal takes the contributions not yet withdrawn first, then the earnings"
  rule base = max(0, wd_amount[w] - wd_contrib_left[w])
  rule stated excepts base when wd_within[w] = 0

def wd_tax[w in wd]: money DUK at wd_on[w]
  note "PIT-9 .5: 19 % of the earnings withdrawn, rounded, unless the holder is 60 or older and has contributed in 5 calendar years"
  rule base = round(wd_earnings[w] * pit9_rate, 1, half-up)
  rule free excepts base when age(birth_day[inv_holder[wrap_cash]], wd_on[w]) >= pit9_age and wd_years[w] >= pit9_years = 0
