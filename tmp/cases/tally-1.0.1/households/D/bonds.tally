part bonds
  tally 1
  note "D-01, D-06, D-07, D-08: the 325 bonds (D-D22), their value under TSB-2 and TSB-3, the heirs' basis (TSB-6, TSB-7), the redemptions (D-D24a–d) and D-HR2's floor."

input bought[s in isb_series]: date question "On what day were this series' bonds bought (D-D22)?"

input lot[s in isb_series]: int question "How many bonds of this series were held on 17 May 2024 (D-D22)?"

input red_day[r in redemption]: date question "On what day was this redemption asked for?"

input red_n[r in redemption, s in isb_series]: int question "How many bonds of this series did this request redeem?"

input red_tax_stated[r in redemption]: money DUK question "What tax does the Treasury's statement show for this request?"

input red_net_stated[r in redemption]: money DUK question "What does the Treasury's statement show paid for this request?"

input hr2_floor: money DUK question "Below what end-of-day balance is a redemption asked for (D-HR2)?"

input hr2_least: money DUK question "At least how much must the bonds asked for come to, value less fee (D-HR2)?"

def iy_start[s in isb_series, k in iyear]: date = add_years(bought[s], k - 1)

def iy_rate[s in isb_series, k in iyear]: num at bought[s]
  note "TSB-2: R1 in the first interest year; later the CPI-YY two months before the year's first month, as published on its first day, less 100, plus the margin, never below 0"
  rule first when k = 1 = isb_r1[s] / 100
  rule later when k > 1 = max(0, (cpi_yy[month_of(iy_start[s, k]) - tsb2_lag] as if {known iy_start[s, k]}) - 100 + isb_margin[s]) / 100

def iy_value[s in isb_series, k in iyear]: money DUK
  rule first when k = 1 = tsb1_price
  rule later when k > 1 = round(iy_value[s, k - 1] * (1 + iy_rate[s, k - 1]), 0.01, half-up)

def iy_of[s in isb_series, d in day]: int = age(bought[s], d) + 1

def bond_value[s in isb_series, d in day]: money DUK = round(iy_value[s, iy_of[s, d]] * (1 + iy_rate[s, iy_of[s, d]] * days(iy_start[s, iy_of[s, d]], d) / days(iy_start[s, iy_of[s, d]], iy_start[s, iy_of[s, d] + 1])), 0.01, half-up)

def basis[s in isb_series]: money DUK = bond_value[s, death_day]

def fee_per[s in isb_series, d in day]: money DUK = min(tsb4_fee, bond_value[s, d] - basis[s])

def paid_per[s in isb_series, d in day]: money DUK = bond_value[s, d] - fee_per[s, d]

def held[s in isb_series, d in day]: int = lot[s] - sum(r in redemption where red_day[r] <= d: red_n[r, s])

def bonds_value[d in day]: money DUK = sum(s in isb_series: held[s, d] * bond_value[s, d])

def bonds_accrued[d in day]: money DUK = sum(s in isb_series: held[s, d] * (bond_value[s, d] - iy_value[s, iy_of[s, d]]))

def all_fees[d in day]: money DUK = sum(s in isb_series: held[s, d] * fee_per[s, d])

def series_tax[s in isb_series, d in day, n in wstep]: money DUK = round((paid_per[s, d] - basis[s]) * n * tsb5_rate, 1, half-up)

def all_tax[d in day]: money DUK = sum(s in isb_series: series_tax[s, d, held[s, d]])

def bonds_net[d in day]: money DUK = bonds_value[d] - all_fees[d] - all_tax[d]

def red_paid_on[r in redemption]: date at red_day[r] = add_business(red_day[r], tsb4_days, holidays)

def red_tax[r in redemption]: money DUK = sum(s in isb_series: series_tax[s, red_day[r], red_n[r, s]])

def red_net[r in redemption]: money DUK = sum(s in isb_series: red_n[r, s] * paid_per[s, red_day[r]]) - red_tax[r]

def before[r in redemption, s in isb_series]: int = lot[s] - sum(t in redemption where red_day[t] < red_day[r]: red_n[t, s])

def cum_net[r in redemption, s in isb_series]: money DUK = sum(t in isb_series where pos(t) <= pos(s): before[r, t] * (bond_value[t, red_day[r]] - fee_per[t, red_day[r]]))

def hr2_last[r in redemption]: key isb_series = first(s in isb_series where cum_net[r, s] >= hr2_least)

def hr2_n[r in redemption, s in isb_series]: int
  note "D-HR2: the earliest series first, the fewest whole bonds whose value less fee comes to the least amount"
  rule none = 0
  rule all excepts none when pos(s) < pos(hr2_last[r]) = before[r, s]
  rule last excepts none when s = hr2_last[r] = round((hr2_least - (cum_net[r, s] - before[r, s] * (bond_value[s, red_day[r]] - fee_per[s, red_day[r]]))) / (bond_value[s, red_day[r]] - fee_per[s, red_day[r]]), 1, ceil)

