part sale
  tally 1
  note "D-09: the offer of 15 September 2026 for Halina's 13/16 of Ogrodowa (D-D30), PIT-12 on the part she bought in the division, and the rent she keeps if she doesn't sell."

input offer_price: money DUK question "What does the buyer offer for the 13/16 (D-D30)?"

input agent_rate: num question "What share of the price is the agent's fee (D-D30)?"

input sale_day: date question "On what day would the sale be made (D-D30)?"

input valuation: money DUK question "What is the flat's latest valuation by an agent or a bank (D-HR4 .2, D-D29)?"

input notary_flat: money DUK question "What part of the division's notary fee was for the flat's transfer (D-D07)?"

input zb_flat_acquired: date question "On what day did Zbigniew acquire the flat (D-D06)?"

input sale_spent: money DUK question "How much of the price will Halina spend on her own housing within 3 years after the sale's year (PIT-12 .4)?"

def bought_part: num = flat_after[halina] - share[halina]

def sale_fee: money DUK = round(offer_price * agent_rate, 0.01, hh_round)

def inherited_taxed: bool = year_of(sale_day) <= year_of(zb_flat_acquired) + pit12_taxed_years

def bought_taxed: bool = year_of(sale_day) <= year_of(div_day) + pit12_taxed_years

def bought_cost: money DUK = round(bought_part * div_flat_value, 0.01, hh_round) + notary_flat

def sale_income: num DUK = (offer_price - sale_fee) * bought_part / flat_after[halina] - bought_cost

def sale_base: money DUK = round(sale_income - sale_income * sale_spent / offer_price, 1, half-up)

def sale_tax: money DUK
  rule taxed = round(sale_base * pit12_rate, 1, half-up)
  rule old excepts taxed when bought_taxed = false = 0

def sale_net: money DUK = offer_price - sale_fee - sale_tax

def keep_value: money DUK = round(valuation * flat_after[halina], 0.01, hh_round)

def year_rent[m in month]: money DUK = 12 * rent_amt[m]

def net_rent_year[m in month]: money DUK = round(flat_after[halina] * (year_rent[m] - 12 * fee_amt[year_of(m)]), 0.01, hh_round) - round(marginal(pit13_rate, year_rent[m] * flat_after[halina]), 1, half-up)

def breakeven[m in month]: num = round(sale_net / net_rent_year[m], 0.01, hh_round)

def advice: key choice = ? "Sell or keep: a choice the dossier leaves to Halina; no house rule or law decides it"

