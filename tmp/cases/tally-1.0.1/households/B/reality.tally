index person = [piotr, ola]

index day = day 2022-03-01..2047-12-31

index month = month 2022-03..2047-12

index tax_year = year 2022..2047

index client = [arnika, arnika_delta, studio_bez, pracownia_ul, kawiarnia_ziarno, kessel, auto_mlecz]

index buy_kind = [laptop, car, fuel, monitor]

index row_kind = [card, card_refund, friend_back, transfer]

index jodla_kind = [instalment, overpayment]

index owed_status = [not_yet_due, promised, expected, missed]

