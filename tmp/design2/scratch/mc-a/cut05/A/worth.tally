part worth
  tally 2
  note "A-HR5, how we count what we have (A-11): what we own together counts half each, the odd ort Tomek's (.1); what is one person's counts for that person (.2); pay earned but not yet paid counts at what will reach the account (.3); workplace-plan contributions count once the plan has credited them (.4), which the registers' units already are; a tax return's result not yet settled counts, shared like the pay it comes from (.5)."
  note "A place's share (owns, CIV-1) can't split one balance by origin: Ania's savings account holds her estate payout (hers, CIV-1 .3) and the interest it earned (community, CIV-1 .2), so nw_ania_sav_interest takes the interest out of her own and adds it to the community (awkward)."

input estate_paid: money DUK question "How much of Ania's savings account is the estate payout (A-D36)?"

input nw_community_0_5: num
  note "lifted from an inline figure of tally 1.0.1"

input nw_day: date question "On which day is what we're worth counted?"

input nw_half_2: int
  note "lifted from an inline figure of tally 1.0.1"

def nw_ania_sav_interest: money DUK at reader
  note "CIV-1 .2: the interest on Ania's savings, net of the tax withheld, is community; the rest of the balance is the estate payout (CIV-1 .3)"
  rule base = bal(ania_sav, nw_day) - estate_paid

def nw_community: money DUK at reader
  note "A-HR5 .1: the places owned half each, and the community's other claims"
  rule base = sum(nw_place[x] for x in places on nw_day where not x in outside and (not x in outside and owns[ania, x] == nw_community_0_5 and owns[tomek, x] == nw_community_0_5)) + nw_pay_due + nw_return + nw_ania_sav_interest

def nw_half[s in spouse]: money DUK at reader
  note "A-HR5 .1: half each; if the sum doesn't split into two equal halves, the odd ort is Tomek's"
  rule ania_half = round(nw_community / nw_half_2, minor(DUK), down) when s == ania
  rule tomek_half = nw_community - round(nw_community / nw_half_2, minor(DUK), down) when s == tomek

def nw_household: money DUK = sum(nw_person[s] for s in spouse) at reader

def nw_own[s in spouse]: money DUK at reader
  note "A-HR5 .2: the places only one person owns"
  rule base = sum(nw_place[x] for x in places on nw_day where not x in outside and (not x in outside and owns[s, x] == 1)) - (if s == ania then nw_ania_sav_interest else 0)

def nw_pay_due: money DUK at reader
  note "A-HR5 .3: Tomek's December 2025 pay, net, paid on 2026-01-15 (A-D02-2025, A-D04): earned, not yet paid on 2025-12-31; Ania's December pay was paid on 2025-12-31"
  rule base = net[nurt, month_of(add_days(nw_day, 1))]

def nw_person[s in spouse]: money DUK = nw_half[s] + nw_own[s] at reader

def nw_place[x in places]: money DUK at reader
  note "a place's value at the end of nw_day: a holding's units at that day's price, rounded to the ort; an account's or a claim's balance; read only for places not outside (nw_community, nw_own): the key filter `where not x in outside` is left off because the reference interpreter can't yet resolve a name in a def key's where (snapshot fault)"
  rule balance = bal(x, nw_day)
  rule holding beats balance = round(value(x, nw_day) in DUK by mk, minor(DUK), half-up) when x in holdings or x in wrapped

def nw_return: money DUK at reader
  note "A-HR5 .5: the 2025 joint return's result, owed to us (+) or by us (−), not yet settled on 2025-12-31; both pay incomes are community, so it is shared like them. Where the spouses may not file jointly (PIT-6 .1), the separate returns' results"
  rule base = round(-together_joint[year_of(nw_day)], minor(DUK), half-up) when joint_may[year_of(nw_day)]
  rule separate = round(-together_sep[year_of(nw_day)], minor(DUK), half-up) when not joint_may[year_of(nw_day)]

version nw_count
  cite questions
  governs always
  known 2021-01-01
  nw_day = 2025-12-31 "questions.md A-11: at the end of 2025"

version estate_payout
  cite a_d36
  governs always
  known 2025-06-13
  estate_paid = 38750.00 "A-D36: Anna Lis receives 38 750.00 DUK for her share, paid to LN61 … 5503 on 16 June 2025"
