part car
  tally 2
  note "The car: the credit's schedule (A-D24), the sale on 2024-08-20 (A-D27) and what it settles: the early repayment (A-D28, CC-1, CC-2), the insurance refund (A-D25 §9, MOT-1 .3), the road-tax refund (MOT-2 .3) and the commission refund (CC-1 .2, read by the axis cc1_refund). A-07 adds the legs; A-08 sets the money the sale brought in, from the records, against what keeping the car to the last instalment would have cost."
  note "A-08's counterfactual is written as defs over the documents and the statements, not as a scenario: the joint account is covered by its statements from 2024-08, and a scenario can't take back the observations booked on covered days (L §5.19), while the costs of keeping the car were never paid (awkward)."

index inst = int 1..48
  note "the credit's instalments (A-D24 .2)"

input car_cc: int question "What is the car's engine capacity in cm3 (A-D23)?"

input garage_day: int question "On which day of the month is the garage fee paid (A-D29)?"

input garage_fee: money DUK question "What is the garage space's monthly fee (A-D29)?"

input garage_last: month question "Which month was the garage last paid for?"

input ins_fee: money DUK question "What handling fee does the insurer take off a refund (A-D25 §9)?"

input ins_from: date question "When does the policy's period start (A-D25)?"

input ins_premium: money DUK question "What premium was paid for the policy (A-D25)?"

input ins_renewal: money DUK question "What premium would the renewal have cost (A-D26)?"

input ins_to: date question "When does the policy's period end (A-D25)?"

input loan_amount: money DUK question "How much was borrowed (A-D24 .1)?"

input loan_commission: money DUK question "What commission was paid on signing (A-D24 .5)?"

input loan_first: date question "When is the first instalment due (A-D24 .2)?"

input loan_instalment: money DUK question "What is the equal instalment (A-D24 .4)?"

input loan_rate: rate question "What is the credit's yearly interest rate (A-D24 .3)?"

input loan_term: int question "How many instalments has the credit (A-D24 .2)?"

input payoff_day: date question "On which day is the credit repaid early (A-D28)?"

input payoff_principal: money DUK question "What principal is owed after the last instalment before the early repayment (A-D28)?"

input road_refund_12: int
  note "lifted from an inline figure of tally 1.0.1"

input sale_day: date question "On which day was the car sold (A-D27)?"

input sale_price: money DUK question "For how much was the car sold (A-D27)?"

def accrued: money DUK at reader
  note "A-D24 .6: interest for the days since the last instalment day, balance times 7.9 % times the days / 365 (simple, Actual/365 Fixed), rounded to the ort"
  rule base = round(accrue(payoff_principal, loan_rate, last_paid_day, payoff_day, act365, simple), minor(DUK), half-up)

def car_left: money DUK at reader
  note "A-07: what the sale leaves once everything is settled: the price, less the early repayment, plus the three refunds"
  rule base = sale_price - payoff_total + ins_refund + road_refund + comm_refund

def comm_refund: money DUK at reader
  note "CC-1 .2: the commission paid on signing, for the months cut off; the act doesn't say whether in proportion to time or to the balances owed (axis cc1_refund); a refund rounded to the ort half up (GEN-5 .3)"
  rule by_balance = round(loan_commission * sum(l_bal_before[i] for i in inst where inst_day[i] > payoff_day) / sum(l_bal_before[i] for i in inst), minor(DUK), half-up) when cc1_refund == by_balance
  rule by_time = round(loan_commission * months_cut / loan_term, minor(DUK), half-up) when cc1_refund == by_time

def fee: money DUK at reader
  note "CC-2 .2, A-D24 .8: 1 % of the amount repaid early with more than a year left to the last instalment day, 0.5 % otherwise, never more than the interest left; a fee rounded to the ort half up (GEN-5 .3)"
  rule long beats short = round(min(cc2_fee_long * payoff_principal, interest_left), minor(DUK), half-up) when add_years(payoff_day, 1) < inst_day[loan_term]
  rule short = round(min(cc2_fee_short * payoff_principal, interest_left), minor(DUK), half-up)

def ins_refund: money DUK at reader
  note "MOT-1 .2–.3, A-D25 §9: the policy ends on the day of the sale; the premium times the days from the day after to the period's last day over the period's days, rounded down to the ort, less the handling fee"
  rule base = round(ins_premium * days_between(sale_day, ins_to) / (days_between(ins_from, ins_to) + 1), minor(DUK), down) - ins_fee

def inst_day[i in inst]: date = add_months(loan_first, i - 1) at reader

def interest_left: money DUK at reader
  note "CC-2 .2: the interest the consumer would have paid to the end, by the schedule"
  rule base = sum(l_interest[i] for i in inst where inst_day[i] > payoff_day)

def kept_cost: money DUK at reader
  note "A-08: what keeping the car to the last instalment (14 May 2025) would have cost: instalments after the repayment day, the renewed insurance (A-D26), the 2025 road tax for a car registered on 1 January (MOT-2 .1–.2) and the garage's months from September (A-D29)"
  rule base = sum(l_paid[i] for i in inst where inst_day[i] > payoff_day) + ins_renewal + mot2_tax(car_cc) + garage_fee * count(k in month where k > garage_last and day_of(k, garage_day) <= inst_day[loan_term])

def kept_less: money DUK at reader
  note "A-08: how much less money keeping the car would have left by 2025-05-14 than selling it, the car's own value aside"
  rule base = sold_in + kept_cost

def l_bal_after[i in inst]: money DUK = l_bal_before[i] - l_principal[i] at reader

def l_bal_before[i in inst]: money DUK at reader
  note "the balance owed in instalment month i"
  rule first = loan_amount when pos(i) == 1
  rule next = l_bal_after[i - 1] when pos(i) > 1

def l_interest[i in inst]: money DUK = round(l_bal_before[i] * periodic(loan_rate, month, nominal 12), minor(DUK), half-up) at reader

def l_paid[i in inst]: money DUK = l_principal[i] + l_interest[i] at reader

def l_principal[i in inst]: money DUK at reader
  note "A-D24 .4: the equal instalment less the month's interest; the last instalment settles what is left"
  rule last beats regular = l_bal_before[i] when i == loan_term
  rule regular = loan_instalment - l_interest[i]

def last_paid_day: date at reader
  note "the last instalment day before the early repayment"
  rule base = max(inst_day[i] for i in inst where inst_day[i] < payoff_day)

def months_cut: int at reader
  note "CC-1 .2: the instalments the early repayment cuts off"
  rule base = count(i in inst where inst_day[i] > payoff_day)

def payoff_total: money DUK = payoff_principal + accrued + fee at reader

def road_refund: money DUK at reader
  note "MOT-2 .3: 1/12 of the yearly tax for each whole month of the year after the month of the sale, rounded to the ort"
  rule base = round(mot2_tax(car_cc) / road_refund_12 * count(k in month where year_of(k) == year_of(sale_day) and k > month_of(sale_day)), minor(DUK), half-up)

def sold_in: money DUK at reader
  note "A-08: what came into the joint account and went out of it because of the sale, from the sale to the last instalment's day (wrz-joint statements: the price, the early repayment and the three refunds)"
  rule base = sum(o.cash.amount for o in car_settlements over sale_day..inst_day[loan_term] where o.cash.to == joint) - sum(o.cash.amount for o in car_settlements over sale_day..inst_day[loan_term] where o.cash.from == joint)

version car_bought
  cite a_d23
  governs always
  known 2021-05-14
  car_cc = 1798 "A-D23: engine 1 798 cm3"

version credit
  cite a_d24
  governs always
  known 2021-05-14
  loan_amount = 45000.00 "A-D24 .1"
  loan_commission = 2700.00 "A-D24 .5: paid by the borrowers on signing"
  loan_first = 2021-06-14 "A-D24 .2: the first on 14 June 2021, the last on 14 May 2025"
  loan_instalment = 1096.47 "A-D24 .4: equal instalments; the last one settles what is left"
  loan_rate = 7.9 %/year "A-D24 .3: fixed, 7.9 % a year; a month's interest is the balance times 7.9 % / 12, rounded to the ort"
  loan_term = 48 "A-D24 .2: 48 months"

version garage
  cite a_d29
  governs always
  known 2021-06-01
  garage_day = 10 "A-D29: paid on the 10th for that month"
  garage_fee = 180.00 "A-D29: 180.00 DUK a month"

version policy
  cite a_d25
  governs always
  known 2023-08-22
  ins_fee = 20.00 "A-D25 §9: less a handling fee of 20.00 DUK"
  ins_from = 2023-09-01 "A-D25: period 1 September 2023 – 31 August 2024"
  ins_premium = 1104.00 "A-D25: premium 1 104.00 DUK, paid"
  ins_to = 2024-08-31 "A-D25: period 1 September 2023 – 31 August 2024"

version renewal_offer
  cite a_d26
  governs always
  known 2024-07-27
  ins_renewal = 1236.00 "A-D26: renews on 1 September 2024 at 1 236.00 DUK, payable on 1 September 2024"

version garage_end
  cite story
  governs always
  known 2024-08-10
  garage_last = 2024-08 "story 2024-08-10: the last garage payment; we give the space up at the end of August"

version car_sale
  cite a_d27
  governs always
  known 2024-08-20
  sale_day = 2024-08-20 "A-D27: the car is handed over today, 20 August 2024"
  sale_price = 41500.00 "A-D27: 41 500.00 DUK, paid by transfer today"

version payoff
  cite a_d28
  governs always
  known 2024-08-21
  payoff_day = 2024-08-22 "A-D28: to repay the credit in full on 22 August 2024"
  payoff_principal = 9551.12 "A-D28: principal after the instalment of 14 August 2024"
