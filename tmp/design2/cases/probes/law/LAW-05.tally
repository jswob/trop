model law05
  tally 2
  on 2026-10-25
  start 2022-01-01
  end 2022-12-31
  note "Probe LAW-05: one income run under two rule sets, the lower tax kept."

source card "Probe card LAW-05 (tmp/cases/probes/law/LAW-05.md): story, rules 1-3 and question"

unit DUK: currency minor 0.01

index ruleset = [o, n]

input income: money DUK question "What is Tomek's 2022 income?"

input rate[s in ruleset]: num question "What rate does this rule set apply?"

input relief[s in ruleset]: money DUK question "What yearly relief does this rule set give?"

def kept: num DUK at reader
  note "rule 3: the lower of the two"
  rule base v card_law = min(tax[s] for s in ruleset)

def kept_set: key ruleset at reader
  note "rule 3 names the choice; the card states no tie-break, so a tie would be refused (RUN-TIE, L 5.11)"
  rule base v card_law = argmin(tax[s] for s in ruleset)

def tax[s in ruleset]: num DUK at reader
  note "rules 1-2: each set run on the same income; the card states no rounding"
  rule base v card_law = rate[s] * income - relief[s]

ask each_set: tax[s] for s in ruleset law 2022-12-31

ask lower_kept: kept, kept_set law 2022-12-31

version card_facts
  cite card
  governs always
  known 2022-01-01
  income = 50000 "story: Tomek's 2022 income is 50 000.00 DUK"

version card_law
  cite card
  governs always
  known 2022-01-01
  note "the card's own rule sets, stipulations known from the model's start (L 4.5)"
  rate[n] = 0.12 "rule 2: rule set N, 12 %"
  rate[o] = 0.17 "rule 1: rule set O, 17 %"
  relief[n] = 0 "rule 2: no relief"
  relief[o] = 3600 "rule 1: minus a yearly relief of 3 600.00"
