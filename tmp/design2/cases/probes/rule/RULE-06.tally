model rule06
  tally 2
  on 2025-04-15
  start 2025-01-01
  end 2025-04-30
  note "RULE-06: rule B-1's floor raised on 10 April to 3 000.00 from January. The sweeps of January to March are decisions, never re-measured (L 5.14.3), so v2 makes no adjustment; the gap is read against what they left, the balance readings of the 15th."
  note "konto's balance before the first reading isn't on the card: it lives from before the run with no opening, a hole until the January reading anchors it."

source card "Probe card RULE-06: Piotr and Ola's account, what the sweeps left"

source rule_b1_v1 "House rule B-1, version 1, from 1 January 2025: on the 15th, keep 2 000.00 and sweep the rest"

source rule_b1_v2 "House rule B-1, version 2, written 10 April 2025: keep 3 000.00, from January"

unit DUK: currency minor 0.01

place konto: accounts DUK lives 2024-12-01..

place savings: accounts DUK lives 2025-01-01..

input keep_floor[m in months]: money DUK

input sweep_dom: int

move sweep[m in months]: transfers
  on day_of(m, sweep_dom)
  at start_of(m)
  reads konto
  leg cash from konto to savings amount max(0, bal(konto) - keep_floor[m])

ask q_floor: keep_floor[2025-04] law 2025-04-15

ask q_gap: keep_floor[m] - bal(konto, day_of(m, sweep_dom)) for m in months where m <= 2025-03 law 2025-04-15

ask q_not_rebooked: check count(a in adjustments over 2025-01-01 .. 2025-04-30) == 0 law 2025-04-15

ask q_total: sum(keep_floor[m] - bal(konto, day_of(m, sweep_dom)) for m in months where m <= 2025-03) law 2025-04-15

version b1_v1
  cite rule_b1_v1
  governs 2025-01..
  known 2025-01-01
  keep_floor = 2000 "B-1 v1: keep 2 000.00 and sweep the rest"
  sweep_dom = 15 "B-1: on the 15th"

version done_q1
  cite card
  known 2025-01-01
  anchor konto
  stated[konto] = 2000 at 2025-01-15 end "the January sweep left 2 000.00"
  stated[konto] = 2000 at 2025-02-15 end "the February sweep left 2 000.00"
  stated[konto] = 2000 at 2025-03-15 end "the March sweep left 2 000.00"

version b1_v2
  cite rule_b1_v2
  governs 2025-01..
  known 2025-04-10
  replace keep_floor = 3000 "B-1 v2: keep 3 000.00, from January"
