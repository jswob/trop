model pty04
  tally 2
  on 2026-10-25
  start 2024-01-01
  end 2024-12-31
  note "PTY-04: a child relief with an income limit over both parents; one parent's restated income crosses it."
  note "Both statements of Tomek's income are stipulations, known from the run's start (LANGUAGE 4.5: late-known stipulations are not fixes), so the restatement can't be a later version: two rows of income[tomek, 2024] known the same day tie (4.6 step 4). The after view is a with pin."

source card "Probe card PTY-04 (made up): story and rules"

unit DUK: currency minor 0.01

index children = [first_child]

index persons = [ania, tomek]

index tax_years = year 2024..2024

input income[p in persons, y in tax_years]: money DUK

input income_limit: money DUK

input income_restated[p in persons, y in tax_years]: money DUK

input parent[c in children, p in persons]: bool

input relief_amount: money DUK

input split[c in children, p in persons]: num

def eligible[c in children, y in tax_years]: bool at start_of(y)
  note "rule 1: joint income not more than the limit"
  rule base v card_rules = joint_income[c, y] <= income_limit

def joint_income[c in children, y in tax_years]: money DUK = sum(income[p, y] for p in persons where parent[c, p]) at start_of(y)

def relief[p in persons, y in tax_years]: num DUK at start_of(y)
  note "rules 1-2: the relief split by the parents' statement"
  rule base v card_rules = sum(if eligible[c, y] then relief_amount * split[c, p] else 0 for c in children where parent[c, p])

ask q_after: joint_income[first_child, 2024], eligible[first_child, 2024], relief[p, 2024] for p in persons with income[tomek, 2024] = income_restated[tomek, 2024]

ask q_before: joint_income[first_child, 2024], eligible[first_child, 2024], relief[p, 2024] for p in persons

version card_facts
  cite card
  governs always
  known 2024-01-01
  income[ania, 2024] = 60000.00 "story: Ania earns 60 000.00"
  income[tomek, 2024] = 52000.00 "story: Tomek 52 000.00"
  income_restated[tomek, 2024] = 52000.01 "story: Tomek's year restated with a raise"
  parent[first_child, ania] = true "story: one child"
  parent[first_child, tomek] = true "story: one child"
  split[first_child, ania] = 0.5 "rule 2: the parents' statement, half each"
  split[first_child, tomek] = 0.5 "rule 2: the parents' statement, half each"

version card_rules
  cite card
  governs always
  known 2024-01-01
  income_limit = 112000.00 "rule 1"
  relief_amount = 1000.00 "rule 1"
