model own05
  tally 2
  on 2026-10-25
  start 2024-01-01
  end 2025-12-31
  note "OWN-05: community property dissolved by a death, then a buyout at a later valuation."
  note "The two valuations are readings (LANGUAGE 4.6, 5.8); a payout reads the valuation at its own law date, the division day or the death day. No money moves, so the flat's value is read as a fact, not through a place."

source card "Probe card OWN-05 (made up): story and rules"

unit DUK: currency minor 0.01

index parties = [halina, zbigniew, ania, piotr, marta, kuba]

input community_member[p in parties]: bool

input death_day: date

input decedent: key parties

input division_day: date

input estate_share[p in parties]: num

input flat_value: money DUK reading

input half: num

input keeper: key parties

def keeper_pays: num DUK = sum(payout[p] for p in parties where p != keeper) at reader

def payout[p in parties]: num DUK at division_day
  note "rule 3: each heir's share at the division's valuation"
  rule base v card_rules = share_after[p] * flat_value

def payout_at_death[p in parties]: num DUK = share_after[p] * flat_value at death_day

def share_after[p in parties]: num at reader
  note "rules 1-2: the survivor's half, plus the estate's half passed in shares"
  rule base v card_rules = (if community_member[p] and p != decedent then half else 0) + half * estate_share[p]

ask q_keeper_pays: keeper_pays law 2025-06-01

ask q_payout_at_death: payout_at_death[p] for p in [ania, piotr, marta, kuba]

ask q_payouts: payout[p] for p in [ania, piotr, marta, kuba]

ask q_shares: share_after[p] for p in [halina, ania, piotr, marta, kuba] law 2025-06-01

version card_facts
  cite card
  governs always
  known 2024-01-01
  community_member = false "story"
  community_member[halina] = true "story: community property"
  community_member[zbigniew] = true "story: community property"
  death_day = 2024-03-10 "story: he dies on 10 March 2024"
  decedent = zbigniew "story"
  division_day = 2025-06-01 "story: the division on 1 June 2025"
  flat_value = 400000.00 at 2024-03-10 "story: worth 400 000.00 when he dies"
  flat_value = 480000.00 at 2025-06-01 "story: valued at 480 000.00 at the division"
  keeper = halina "story: Halina keeps the flat"

version card_rules
  cite card
  governs always
  known 2024-01-01
  estate_share = 0 "rule 2: no other heir"
  estate_share[halina] = 0.25 "rule 2"
  estate_share[ania] = 0.1875 "rule 2"
  estate_share[piotr] = 0.1875 "rule 2"
  estate_share[marta] = 0.1875 "rule 2"
  estate_share[kuba] = 0.1875 "rule 2"
  half = 0.5 "rule 1: community splits in halves"
