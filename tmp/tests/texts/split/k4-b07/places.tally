version openings
  cite story
  known 2022-03-01
  note "The accounts existed before the run; their balances on 2022-03-01 are no fact of the dossier, so each is a hole until its first statement's reading anchors it."
  opening[cis] = ?"What was on Piotr's Cis current account on 2022-03-01? The first export is January 2025's." at 2022-03-01 start
  opening[savings] = ?"What was on Piotr's Cis savings account on 2022-03-01? The only export is 2025's." at 2022-03-01 start
  opening[wrzos] = ?"What was on Ola's Wrzos account on 2022-03-01? Her first statement is October 2024's." at 2022-03-01 start
