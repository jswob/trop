 "templates": [
  {
   "id": "oki_pl@2027",
   "kind": "law",
   "title_pl": "OKI: podatek od średniej wartości",
   "status": "tested",
   "says": "Each year: the average of the account's end-of-day values (over the days it existed), less the exemption for what it holds, times the year's rate; filed and paid by 31 May. No Belka on what is inside.",
   "sources": [
    "ustawa o OKI, Dz.U. 2026 poz. 1098, art. 23 (podstawa), art. 24 (wycena), art. 25 i 43 (stawka), art. 26 (zwolnienia), art. 29 (termin)"
   ],
   "params": {
    "oki": {
     "type": "place",
     "unit": "PLN",
     "ask_pl": "Które OKI?"
    },
    "account": {
     "type": "place",
     "unit": "PLN",
     "ask_pl": "Z którego konta płacimy podatek?"
    },
    "holds": {
     "type": "enum",
     "values": [
      "pln_funds",
      "deposits_bonds",
      "foreign"
     ],
     "ask_pl": "Co będzie na OKI: fundusze i akcje w PLN (wolne do 100 000 zł), lokaty i obligacje skarbowe (do 25 000 zł) czy ETF zagraniczny (bez kwoty wolnej)?"
    }
   },
   "lines": [
    {
     "id": "avg",
     "says_pl": "Średnia wartość w roku",
     "every": "year",
     "unit": "PLN",
     "value": "avg_balance(in.oki)"
    },
    {
     "id": "exempt",
     "says_pl": "Kwota wolna",
     "every": "year",
     "unit": "PLN",
     "value": "case(in.holds, 'pln_funds', p.oki.exempt_total, 'deposits_bonds', p.oki.exempt_deposits, 'foreign', 0)"
    },
    {
     "id": "tax",
     "says_pl": "Podatek OKI do 31 maja",
     "every": "year",
     "on": "next_year:05-31",
     "unit": "PLN",
     "value": "zl(max(0, v('avg') - v('exempt')) * p.oki.rate)",
     "pay": {
      "from": "in.account",
      "to": "urzad_skarbowy",
      "match": "oki"
     },
     "bd": "next"
    }
   ],
