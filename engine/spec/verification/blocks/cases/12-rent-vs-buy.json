    { "id": "rate_change", "says": "Zmiana oprocentowania z 5,91% na 4,91% od lipca: rata liczona od nowa na pozostały kapitał (402 007,90) i 295 rat, potem stała", "source": "umowa kredytu ze zmiennym oprocentowaniem (wyliczenie)", "collected_by": "author",
      "args": { "principal": 405000, "rate": { "dated": [ { "from": "1900-01-01", "value": 0.0591 }, { "from": "2026-07-01", "value": 0.0491 } ] }, "months": 300, "start": "2026-01-15", "account": "konto", "debt": "kredyt_hipoteczny" }, "year": 2026,
