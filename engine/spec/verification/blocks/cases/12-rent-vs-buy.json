  {
   "id": "koszty_zakupu_pl@2026",
   "kind": "law",
   "title_pl": "PCC, taksa notarialna i opłaty sądowe przy zakupie mieszkania",
   "status": "tested",
   "says": "On the deed: PCC 2% of the price (less the part bought by first-home buyers), half the maximum notary fee for a flat sale, a quarter of it on the loan for the mortgage, 23% VAT on each fee, 200 zł for the ownership entry and 200 zł plus 19 zł PCC for the mortgage. All collected by the notary on the day. Copies (wypisy) are not included.",
   "sources": ["ustawa o PCC, Dz.U. 2026 poz. 191, art. 7 i art. 9 pkt 17", "rozp. MS w sprawie taksy notarialnej, Dz.U. 2024 poz. 1566, § 3, § 6 pkt 19, § 7 ust. 1 pkt 1", "ustawa o kosztach sądowych, Dz.U. 2025 poz. 1228, art. 42", "NSA III FSK 281/25 (zwolnienie proporcjonalne)"],
   "params": {
    "purchase": { "type": "instance", "attach": true, "needs": { "price": "PLN", "loan": "PLN" }, "ask_pl": "Który zakup?" },
    "date": { "type": "date", "ask_pl": "Data aktu (ta sama co zakupu)" },
    "exempt_share": { "type": "number", "unit": "1", "ask_pl": "Czy to pierwsze mieszkanie? Jaka część kupują osoby, które nigdy nie miały mieszkania ani domu (0, 0,5, 1)?" },
    "account": { "type": "place", "unit": "PLN", "ask_pl": "Z którego konta?" }
   },
   "checks": [
    { "rule": "param_of(in.purchase, 'date') = in.date", "says_pl": "Koszty płaci się w dniu aktu: data musi być ta sama co zakupu.", "level": "error" },
    { "rule": "and(in.exempt_share >= 0, in.exempt_share <= 1)", "says_pl": "Część zwolniona to liczba od 0 do 1.", "level": "error" }
   ],
   "lines": [
    { "id": "pcc", "says_pl": "PCC", "every": "once", "on": "at:date", "unit": "PLN", "value": "zl(v('price', in.purchase) * p.pcc.rate * (1 - in.exempt_share))", "pay": { "from": "in.account", "to": "urzad_skarbowy" } },
    { "id": "notary_sale", "on": "at:date", "says_pl": "Taksa za umowę sprzedaży (netto)", "every": "once", "unit": "PLN", "value": "grosze(min(p.notary.taxa_max, p.notary.taxa_base + brackets(p.notary.taxa, v('price', in.purchase))) * p.notary.flat_sale_fraction)" },
    { "id": "notary_mortgage", "on": "at:date", "says_pl": "Taksa za hipotekę (netto)", "every": "once", "unit": "PLN", "value": "if(v('loan', in.purchase) > 0, grosze(min(p.notary.taxa_max, p.notary.taxa_base + brackets(p.notary.taxa, v('loan', in.purchase))) * p.notary.mortgage_fraction), 0)" },
    { "id": "notary", "says_pl": "Notariusz z VAT", "every": "once", "on": "at:date", "unit": "PLN", "value": "v('notary_sale') + grosze(v('notary_sale') * p.vat.rate) + v('notary_mortgage') + grosze(v('notary_mortgage') * p.vat.rate)", "pay": { "from": "in.account", "to": "notariusz" } },
    { "id": "court", "says_pl": "Wpisy do księgi wieczystej", "every": "once", "on": "at:date", "unit": "PLN", "value": "p.court.kw_ownership + if(v('loan', in.purchase) > 0, p.court.kw_mortgage, 0)", "pay": { "from": "in.account", "to": "sad" } },
    { "id": "pcc_mortgage", "says_pl": "PCC od hipoteki", "every": "once", "on": "at:date", "unit": "PLN", "value": "if(v('loan', in.purchase) > 0, p.pcc.mortgage_fixed, 0)", "pay": { "from": "in.account", "to": "urzad_skarbowy" } },
    { "id": "total", "on": "at:date", "says_pl": "Razem koszty", "every": "once", "unit": "PLN", "value": "v('pcc') + v('notary') + v('court') + v('pcc_mortgage')" }
   ],
   "tests": [
    { "id": "flat_650k", "says": "650 000, kredyt 520 000, bez zwolnienia: PCC 13 000, notariusz 1 685 + 387,55 + 712,50 + 163,88, sąd 400, PCC od hipoteki 19; razem 16 367,93", "source": "polish_facts.json flat_650k_costs (wyliczone z Dz.U. 2026 poz. 191, 2024 poz. 1566, 2025 poz. 1228)", "collected_by": "research agent",
