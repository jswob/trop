    { "id": "finwire_750k", "says": "750 000 na 25 lat: 5,82% → 4 750,08; 6,20% → 4 924,37", "source": "finwire 5.10.2026 (polish_facts.json mortgage_instalment_750k_582)", "collected_by": "research agent",
