      "year": 2026,
      "expect": [ { "line": "pcc", "period": "2026-06-01", "value": 13000 }, { "line": "notary_sale", "period": "2026-06-01", "value": 1685 }, { "line": "notary_mortgage", "period": "2026-06-01", "value": 712.5 }, { "line": "notary", "period": "2026-06-01", "value": 2948.93 }, { "line": "court", "period": "2026-06-01", "value": 400 }, { "line": "pcc_mortgage", "period": "2026-06-01", "value": 19 }, { "line": "total", "period": "2026-06-01", "value": 16367.93 }, { "line": "pcc", "period": "2026-06-01", "date": "2026-06-01" } ] },
    { "id": "first_home", "says": "To samo ze zwolnieniem z PCC: razem 3 367,93", "source": "polish_facts.json flat_650k_costs.total_with_first_home_exemption", "collected_by": "research agent",
