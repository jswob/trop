  {
   "id": "kredyt@1",
   "kind": "contract",
   "title_pl": "Kredyt w ratach równych",
   "status": "tested",
   "says": "Drawn on the start date into the account; from the next month a level instalment of interest at rate/12 and capital, paid on the instalment day; a new rate recomputes the instalment on the balance left; the last instalment closes the balance.",
   "sources": ["ustawa z 23.03.2017 o kredycie hipotecznym (rata równa według umowy kredytu)"],
   "params": {
    "principal": { "type": "money", "unit": "PLN", "ask_pl": "Ile kredytu?" },
    "rate": { "type": "number", "unit": "1", "ask_pl": "Oprocentowanie roczne (np. WIBOR + marża)?" },
    "months": { "type": "number", "unit": "1", "ask_pl": "Na ile miesięcy?" },
    "start": { "type": "date", "ask_pl": "Kiedy wypłata kredytu?" },
    "account": { "type": "place", "unit": "PLN", "ask_pl": "Z którego konta raty?" },
    "debt": { "type": "place", "unit": "PLN", "ask_pl": "Który dług?" },
    "bank": { "type": "place", "default": "bank", "says_pl": "komu odsetki" },
    "pay_on": { "type": "text", "default": "day:5", "says_pl": "dzień raty" }
   },
   "lines": [
    { "id": "drawdown", "says_pl": "Wypłata kredytu", "every": "once", "on": "at:start", "unit": "PLN", "value": "in.principal", "pay": { "from": "in.debt", "to": "in.account" } },
    { "id": "k", "says_pl": "Numer raty", "every": "month", "unit": "1", "value": "months_between(in.start, date)" },
    { "id": "opening", "says_pl": "Do spłaty na początek miesiąca", "every": "month", "unit": "PLN", "gate": "and(v('k') >= 1, v('k') <= in.months)", "value": "if(v('k') = 1, in.principal, prev('closing'))" },
    { "id": "interest", "says_pl": "Odsetki", "every": "month", "on": "in.pay_on", "bd": "next", "unit": "PLN", "gate": "and(v('k') >= 1, v('k') <= in.months)", "value": "grosze(v('opening') * in.rate / 12)", "pay": { "from": "in.account", "to": "in.bank" } },
    { "id": "rate_now", "says_pl": "Oprocentowanie w miesiącu", "every": "month", "unit": "1", "value": "in.rate" },
    { "id": "instalment", "says_pl": "Rata (stała; liczona od nowa przy zmianie oprocentowania)", "every": "month", "unit": "PLN", "gate": "and(v('k') >= 1, v('k') <= in.months)", "value": "if(v('k') = in.months, v('opening') + v('interest'), if(or(v('k') = 1, v('rate_now') != prev('rate_now')), grosze(annuity(v('opening'), in.rate / 12, in.months - v('k') + 1)), prev('instalment')))" },
    { "id": "capital", "says_pl": "Część kapitałowa", "every": "month", "on": "in.pay_on", "bd": "next", "unit": "PLN", "gate": "and(v('k') >= 1, v('k') <= in.months)", "value": "v('instalment') - v('interest')", "pay": { "from": "in.account", "to": "in.debt" } },
    { "id": "closing", "says_pl": "Do spłaty na koniec miesiąca", "every": "month", "unit": "PLN", "value": "v('opening') - v('capital')" }
   ],
   "tests": [
