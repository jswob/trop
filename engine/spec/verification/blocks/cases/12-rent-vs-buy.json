      "year": 2026, "expect": [ { "line": "pcc", "period": "2026-06-01", "value": 6000 } ] },
    { "id": "big_price_cap", "says": "Taksa nie przekracza 10 000 zł: przy 5 mln sprzedaż = 5 000 netto", "source": "Dz.U. 2024 poz. 1566, § 3 pkt 7 i § 6 pkt 19 (wyliczenie)", "collected_by": "author",
      "args": { "purchase": "t_buy", "date": "2026-06-01", "exempt_share": 1, "account": "konto" },
      "others": [{ "id": "t_buy", "template": "zakup_mieszkania@1", "args": { "price": 5000000, "own": 5000000, "date": "2026-06-01", "flat": "mieszkanie", "account": "konto" } }],
