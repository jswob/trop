 "templates": [
  {
   "id": "employment_pl@2022",
   "kind": "law",
   "title_pl": "Umowa o pracę: składki, zdrowotna, zaliczka PIT",
   "status": "tested",
   "says": "Each month the employer takes social contributions, health and a tax advance out of the gross pay and pays the rest. The structure holds since Polski Ład (2022); every amount is a dated Value.",
   "sources": [
    "ustawa o PIT art. 22 ust. 2, art. 27, art. 32",
    "ustawa o sus art. 19, 22",
    "ustawa o świadczeniach opieki zdrowotnej art. 79, 81",
    "Kodeks pracy art. 85"
   ],
   "joins": [
    "pit_return@2022"
   ],
   "params": {
    "job": {
     "type": "instance",
     "attach": true,
     "needs": {
      "gross": "PLN"
     },
     "ask_pl": "Do której pracy?"
    },
    "account": {
     "type": "place",
     "unit": "PLN",
     "ask_pl": "Na które konto wpływa pensja?"
    },
    "employer": {
     "type": "place",
     "default": "pracodawca",
     "says_pl": "kto płaci"
    },
    "pay_on": {
     "type": "text",
     "default": "next_month:10",
     "says_pl": "dzień wypłaty (Kodeks pracy art. 85: do 10. następnego miesiąca)"
    },
    "commuter": {
     "type": "bool",
     "default": false,
     "ask_pl": "Czy dojeżdżasz z innej miejscowości (koszty 300 zł)?"
    },
    "pit2": {
     "type": "bool",
     "default": true,
     "ask_pl": "Czy złożyłeś PIT-2 u pracodawcy?"
    },
    "form": {
     "type": "enum",
     "values": [
      "skala"
     ],
     "fixed": "skala",
     "says_pl": "Pensja z etatu jest zawsze na skali."
    }
   },
   "lines": [
    {
     "id": "soc.cap_base",
     "says_pl": "Podstawa emerytalna i rentowa do rocznego limitu",
     "every": "month",
     "unit": "PLN",
     "value": "max(0, min(v('gross', in.job), p.zus.annual_cap - ytd_before('gross', in.job)))"
    },
    {
     "id": "soc.pension",
     "says_pl": "Emerytalna",
     "every": "month",
     "unit": "PLN",
     "value": "grosze(v('soc.cap_base') * p.zus.employee.pension)"
    },
    {
     "id": "soc.disability",
     "says_pl": "Rentowa",
     "every": "month",
     "unit": "PLN",
     "value": "grosze(v('soc.cap_base') * p.zus.employee.disability)"
    },
    {
     "id": "soc.sickness",
     "says_pl": "Chorobowa",
     "every": "month",
     "unit": "PLN",
     "value": "grosze(v('gross', in.job) * p.zus.employee.sickness)"
    },
    {
     "id": "soc.total",
     "says_pl": "Składki społeczne razem",
     "every": "month",
     "unit": "PLN",
     "value": "grosze(v('soc.pension') + v('soc.disability') + v('soc.sickness'))"
    },
    {
     "id": "health",
     "says_pl": "Zdrowotna 9%",
     "every": "month",
     "unit": "PLN",
     "value": "grosze((v('gross', in.job) - v('soc.total')) * p.health.rate)"
    },
    {
     "id": "income",
     "says_pl": "Dochód",
     "every": "month",
     "unit": "PLN",
     "value": "v('gross', in.job) - if(in.commuter, p.pit.kup_commuter, p.pit.kup_employee) - v('soc.total')"
    },
    {
     "id": "tax.base",
     "says_pl": "Podstawa do złotego",
     "every": "month",
     "unit": "PLN",
     "value": "zl(max(0, v('income')))"
    },
    {
     "id": "pit.advance",
     "says_pl": "Zaliczka PIT",
     "every": "month",
     "unit": "PLN",
     "value": "zl(max(0, brackets(p.pit.scale, ytd('tax.base')) - brackets(p.pit.scale, ytd_before('tax.base')) - if(in.pit2, p.pit.reduction_monthly, 0)))",
     "pay": {
      "from": "in.employer",
      "to": "urzad_skarbowy"
     },
     "on": "next_month:20",
     "bd": "next"
    },
    {
     "id": "net",
     "says_pl": "Na konto",
     "every": "month",
     "on": "in.pay_on",
     "bd": "prev",
     "unit": "PLN",
     "value": "grosze(v('gross', in.job) - v('soc.total') - v('health') - v('pit.advance'))",
     "pay": {
      "from": "in.employer",
      "to": "in.account",
      "match": "wynagrodzenie"
     }
    },
    {
     "id": "pension.total",
     "says_pl": "Na emeryturę razem z częścią pracodawcy",
     "every": "month",
     "unit": "PLN",
     "value": "v('soc.pension') + grosze(v('soc.cap_base') * p.zus.employer.pension)"
    },
    {
     "id": "zus.pay",
     "says_pl": "Pracodawca przekazuje do ZUS",
     "every": "month",
     "on": "next_month:15",
     "unit": "PLN",
     "value": "v('soc.total') + v('health')",
     "pay": {
      "from": "in.employer",
      "to": "zus"
     },
     "bd": "next"
    }
   ],
