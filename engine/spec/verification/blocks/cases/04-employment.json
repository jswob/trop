  {
   "id": "pit_return@2022",
   "kind": "law",
   "title_pl": "Zeznanie roczne na skali (PIT-37), samodzielnie lub wspólnie",
   "status": "tested",
   "says": "After the year: the scale on the whole year's income, at the law in force on 31 December, less every advance paid. Married couples may split their income in half and pay twice the tax on one half.",
   "sources": [
    "ustawa o PIT art. 6 ust. 2, art. 27 ust. 1, art. 45 ust. 1"
   ],
   "params": {
    "a": {
     "type": "instances",
     "needs": {
      "income": "PLN",
      "pit.advance": "PLN"
     },
     "ask_pl": "Czyje dochody na skali (jedna osoba)?"
    },
    "b": {
     "type": "instances",
     "default": [],
     "needs": {
      "income": "PLN",
      "pit.advance": "PLN"
     },
     "ask_pl": "Rozliczasz się wspólnie z małżonkiem? Jego dochody."
    },
    "account": {
     "type": "place",
     "unit": "PLN",
     "ask_pl": "Z którego konta dopłata (i na które zwrot)?"
    }
   },
   "checks": [
    {
     "rule": "and(every_param(in.a, 'form', 'skala'), every_param(in.b, 'form', 'skala'))",
     "says_pl": "W tym zeznaniu tylko dochody na skali; wspólnie można się rozliczać tylko na skali.",
     "level": "error"
    }
   ],
   "lines": [
    {
     "id": "base_a",
     "says_pl": "Dochód pierwszej osoby",
