 "templates": [
  {
   "id": "nadwyzka_ike@1",
   "kind": "rule",
   "title_pl": "Nadwyżka: najpierw IKE, reszta dalej",
   "status": "confirmed",
   "says": "On the 15th, the surplus above the floor until the next pay goes to the IKE up to this year's limit; the rest to the other place.",
   "params": {
    "from": {
     "type": "place",
     "unit": "PLN",
     "ask_pl": "Z którego konta?"
    },
    "floor": {
     "type": "money",
     "unit": "PLN",
     "ask_pl": "Ile ma zostać na koncie w najniższym punkcie?"
    },
    "until": {
     "type": "line",
     "ask_pl": "Do której wypłaty liczymy?"
    },
    "ike": {
     "type": "place",
     "unit": "PLN",
     "ask_pl": "Które IKE?"
    },
    "rest": {
     "type": "place",
     "unit": "PLN",
     "ask_pl": "Dokąd reszta?"
    }
   },
   "lines": [
    {
     "id": "surplus",
     "says_pl": "Nadwyżka",
     "every": "month",
     "on": "day:15",
     "unit": "PLN",
     "value": "max(0, low_point(in.from, next_date(in.until)) - in.floor)"
    },
    {
     "id": "to_ike",
     "says_pl": "Na IKE",
     "every": "month",
     "on": "day:15",
     "order": 1,
     "unit": "PLN",
     "value": "min(v('surplus'), max(0, p.ike.limit - in_year(in.ike)))",
     "pay": {
      "from": "in.from",
      "to": "in.ike"
     }
    },
    {
     "id": "to_rest",
     "says_pl": "Reszta",
     "every": "month",
     "on": "day:15",
     "order": 2,
     "unit": "PLN",
     "value": "v('surplus') - v('to_ike')",
     "pay": {
      "from": "in.from",
      "to": "in.rest"
     }
    }
   ]
  },
  {
   "id": "belka_pl@2004",
