part bands_oracle
  tally 1
  note "Wartości wyroczni i tolerancje testu pasm gospodarstwa (DONE, bramka 7, część 2). Czytają je tylko pytania check w scenarios/surprises i scenarios/costly_repairs."
  note "Tolerancja = 4·SE + błąd kroku + własny błąd wyroczni (ENGINE §8), zaokrąglona w górę; wyprowadzenie w household-bands.md."

source bands_key "Klucz odpowiedzi pasm gospodarstwa: montecarlo/household-bands.md, wartości w formie zamkniętej"

index band_level = [q05, q25, q50, q75, q95]

index oracle_stat = [nw_1231_mean, paired_mean, paired_median, tm_konto_1231, tm_net_worth_1231, tm_room_11]

index share_stat = [no_repair, two_rents, zero_dip]

input oracle_konto[d in day, l in band_level]: num PLN

input oracle_konto_tol[d in day, l in band_level]: num PLN

input oracle_net_worth[d in day, l in band_level]: num PLN

input oracle_net_worth_tol[d in day, l in band_level]: num PLN

input oracle_room[m in month, l in band_level]: num PLN

input oracle_room_tol[m in month, l in band_level]: num PLN

input oracle_share[k in share_stat]: num

input oracle_share_tol[k in share_stat]: num

input oracle_value[k in oracle_stat]: num PLN

input oracle_value_tol[k in oracle_stat]: num PLN

