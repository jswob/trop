model mp03
  tally 1
  on 2026-10-19
  note "Polish intestate shares (art. 931 KC) and the forced share, zachowek (arts. 991-996 KC), over the four sources' worked examples."
  note "Estates: mini is the prawnik.cc mini-case; gp1 to gp3 are GazetaPrawna's Przykład 1 to 3; b3, b5 and b1 are rulecalc's three bullets; szczecin is the infor.pl report of III C 225/23."

source gazeta "Zachowek - jak obliczyć, komu przysługuje, kalkulator kwot (Kinga Załęcka, GazetaPrawna.pl, 2026-02-01)" at "https://www.gazetaprawna.pl/prawnik/orzecznictwo/artykuly/10965865,zachowek-jak-obliczyc-komu-przysluguje-kalkulator-kwot.html"

source infor "Sąd oblicza zachowek: Mieszkanie 191.500 zł ... Wzory [Przykład] (infor.pl, 2026-10-08)" at "https://www.infor.pl/prawo/spadki/zachowek-i-dzial-spadku/7050063,sad-oblicza-zachowek-mieszkanie-191500-zl-zachowki-3191666-zl-i-1063888-zl-wzory-przyklad.html"

source kc "Kodeks cywilny, ustawa z dnia 23 kwietnia 1964 r., Dz. U. 1964 nr 16 poz. 93, read in the tekst jednolity Dz. U. 2026 poz. 795 (stan prawny na dzień 19 maja 2026 r.), whose pages the locators cite" at "https://api.sejm.gov.pl/eli/acts/DU/2026/795/text.pdf"

source prawnik "Zachowek po darowiźnie mieszkania: kiedy się należy, jak liczyć, jak się bronić (prawnik.cc, 13 stycznia 2026)" at "https://prawnik.cc/blogs/zachowek-po-darowiznie-mieszkania-kiedy-sie-nalezy-jak-liczyc-jak-sie-bronic"

source rulecalc "Udział małżonka w spadku — art. 931 § 1 KC (rulecalc.com, ostatnia aktualizacja 18. 4. 2026)" at "https://rulecalc.com/pl/sady/kc-dziedziczenie-malzonek-1-4"

axis mp03_own_gift
  excluded "a gift later counted against the recipient's own zachowek is not added to the substrate, as the prawnik.cc mini-case computes it"
  added "that gift is also added to the substrate under art. 993 § 1 before art. 996 § 1 counts it against the zachowek"

axis mp03_round
  down "amounts are cut to the unit"
  half-up "amounts are rounded half up to the unit"

index claimant = [anna, gp1_child, gp2_child, gp3_heir, sz_child, sz_grandchild]

index estate = [mini, gp1, gp2, gp3, b3, b5, b1, szczecin]

index gift = [flat_bartek, money_anna, gift_gp3]

index line = [child, grandchild]

input children[e in estate]: int
  note "Children of the deceased, counting a predeceased child whose descendants inherit in his place (art. 931 § 2)."

input estate_net[e in estate]: money PLN

input estate_of[k in claimant]: key estate

input frac_other: num

input frac_protected: num

input gift_claimant[g in gift]: key claimant
  note "The claimant whose zachowek the gift is counted against (art. 996 § 1), or - when the recipient makes no claim."

input gift_estate[g in gift]: key estate

input gift_heir[g in gift]: bool
  note "The recipient is an heir or a person entitled to zachowek (art. 994 § 1)."

input gift_value[g in gift]: money PLN
  note "As the gift stood when made, at prices when the zachowek is fixed (art. 995 § 1)."

input gift_years[g in gift]: int
  note "Whole years from the gift to the opening of the estate."

input grandchildren[e in estate]: int
  note "Children of the predeceased child of the deceased."

input line_of[k in claimant]: key line

input lookback_years: int

input protected[k in claimant]: bool
  note "Permanently unable to work, or a minor descendant (art. 991 § 1)."

input spouse_min: num

input spouse_survives[e in estate]: bool

def child_amount[e in estate]: num PLN = estate_net[e] * child_part[e]

def child_part[e in estate]: num
  note "art. 931 § 1: the children share equally what the spouse doesn't take."
  rule base v kc1964 = (1 - spouse_part[e]) / children[e]

def counted[g in gift]: bool
  note "art. 993 § 1 adds gifts to the estate; art. 994 § 1 leaves out gifts made more than ten years before the opening to persons who are neither heirs nor entitled. Rule kept_out is the source reading of the axis mp03_own_gift."
  rule base v kc1964 = gift_heir[g] or gift_years[g] <= lookback_years
  rule kept_out excepts base when gift_claimant[g] != - and mp03_own_gift = excluded = false

def equal_share[e in estate]: money PLN
  note "rulecalc's equal share among all heirs, in whole złoty. The law sets no rounding, so the mode is the axis mp03_round."
  rule base = round(estate_net[e] / heirs[e], 1, mp03_round)

def fraction[k in claimant]: num
  note "art. 991 § 1: two thirds for a protected claimant, otherwise one half."
  rule base v kc1964 = if protected[k] then frac_protected else frac_other

def grandchild_part[e in estate]: num
  note "art. 931 § 2: a predeceased child's share goes to his children in equal parts."
  rule base v kc1964 = child_part[e] / grandchildren[e]

def heirs[e in estate]: int = children[e] + (if spouse_survives[e] then 1 else 0)

def intestate[k in claimant]: num
  note "The claimant's intestate share, the base of the zachowek (art. 991 § 1)."
  rule base v kc1964 when line_of[k] = child = child_part[estate_of[k]]
  rule grand v kc1964 when line_of[k] = grandchild = grandchild_part[estate_of[k]]

def own_gift[k in claimant]: money PLN = sum(g in gift where gift_claimant[g] != - and gift_claimant[g] = k: gift_value[g])

def spouse_amount[e in estate]: num PLN = estate_net[e] * spouse_part[e]

def spouse_part[e in estate]: num
  note "art. 931 § 1: equal shares, but the spouse's part is not less than one quarter of the estate."
  rule base v kc1964 = if spouse_survives[e] then max(spouse_min, 1 / heirs[e]) else 0

def substrate[e in estate]: money PLN
  note "The net estate with the counted gifts added (art. 993 § 1)."
  rule base v kc1964 = estate_net[e] + sum(g in gift where gift_estate[g] = e and counted[g]: gift_value[g])

def to_pay[k in claimant]: money PLN
  note "art. 996 § 1: a gift to the person entitled is counted against the zachowek; art. 991 § 2 gives the claim for the rest."
  rule base v kc1964 = max(0, zachowek[k] - own_gift[k])

def zachowek[k in claimant]: money PLN
  note "art. 991 § 1: the fraction of the intestate share, applied to the substrate. Rounded to the grosz; the mode is the axis mp03_round."
  rule base v kc1964 = round(substrate[estate_of[k]] * intestate[k] * fraction[k], 0.01, mp03_round)

ask a1_substrate: substrate[mini]

ask a2_intestate: intestate[anna]

ask a3_fraction: fraction[anna]

ask a4_zachowek: zachowek[anna]

ask a5_to_pay: to_pay[anna]

ask a6_rule_plain: intestate[anna] * fraction[anna]

ask a7_rule_protected: intestate[anna] * fraction[anna] with protected[anna] = true

ask gp1_zachowek: zachowek[gp1_child]

ask gp2_zachowek: zachowek[gp2_child]

ask gp3_theoretical: zachowek[gp3_heir]

ask gp3_to_pay: to_pay[gp3_heir]

ask rc1_three: equal_share[b3], spouse_amount[b3], child_amount[b3]

ask rc2_five: equal_share[b5], spouse_part[b5], spouse_amount[b5], child_amount[b5]

ask rc3_one: equal_share[b1], spouse_amount[b1], child_amount[b1]

ask sz_fraction: intestate[k] * fraction[k] for k in [sz_child, sz_grandchild]

ask sz_intestate: intestate[k] for k in [sz_child, sz_grandchild]

ask sz_zachowek: zachowek[k] for k in [sz_child, sz_grandchild]

version kc1964
  cite kc
  governs 1965-01-01..
  known 1964-05-18
  note "The Kodeks cywilny of 23 April 1964, as promulgated in Dz. U. 1964 nr 16 poz. 93, dated Warszawa, 18 maja 1964 (the Dziennik's own masthead, and promulgation 1964-05-18 in the Sejm ELI record api.sejm.gov.pl/eli/acts/DU/1964/93, both read 2026-10-19). It governs from 1 January 1965, its entry into force (entryIntoForce 1965-01-01 in the same record)."
  note "Arts. 931 § 1, 991 § 1 and 994 § 1 were compared with the 1964 Dziennik (api.sejm.gov.pl/eli/acts/DU/1964/93/text/O/D19640093.pdf): their wording, and so the four rows, are the 1964 act's. The 2026 tekst jednolity is their locator, not their version (§5.3)."
  note "The rules that point at this version follow arts. 931, 991 and 993-996 as they apply to gifts. Later amendments to art. 991 § 2 and art. 993 add legacies by vindication and family foundations, which no example has; they were not modelled."
  frac_other = 0.5 "art. 991 § 1 (t.j. 2026, p. 109): w innych zaś wypadkach – połowa wartości tego udziału"
  frac_protected = 2/3 "art. 991 § 1 (t.j. 2026, p. 109): dwie trzecie wartości udziału spadkowego"
  lookback_years = 10 "art. 994 § 1 (t.j. 2026, p. 109): dokonanych przed więcej niż dziesięciu laty"
  spouse_min = 0.25 "art. 931 § 1 (t.j. 2026, p. 102): nie może być mniejsza niż jedna czwarta całości spadku"

version infor_szczecin
  cite infor
  known 2026-10-08
  note "Sąd Rejonowy Szczecin-Centrum, III C 225/23, wyrok z 21 sierpnia 2024 r., as the portal reports it. A daughter took the flat under the will; two children and three grandchildren were left out."
  note "Known 2026-10-08: a real case, read in the report, which is dated 8 October 2026; the judgment itself was not fetched."
  children[szczecin] = 3 "Przykład: three children, one son predeceased"
  estate_net[szczecin] = 191500 "calculation lines: 191.500,00 (printed once as 190 500 zł); no debts, no gifts"
  estate_of[sz_child] = szczecin "Obliczenie zachowku dla syna albo córki"
  estate_of[sz_grandchild] = szczecin "Obliczenie zachowku dla wnuka albo wnuczki"
  grandchildren[szczecin] = 3 "Przykład: three grandchildren of the predeceased son"
  line_of[sz_child] = child "Jak obliczyć zachowek od mieszkania dla dzieci i wnuków"
  line_of[sz_grandchild] = grandchild "Jak obliczyć zachowek od mieszkania dla dzieci i wnuków"
  protected[sz_child] = false "intro: dorośli; nie ma niepełnosprawnych i małoletnich"
  protected[sz_grandchild] = false "intro: dorośli; nie ma niepełnosprawnych i małoletnich"
  spouse_survives[szczecin] = false assumed "the report mentions no spouse"

version gazeta_examples
  cite gazeta
  known 2026-10-19
  note "Section 'Przykładowe wyliczenia - jak obliczyć zachowek w praktyce?'. The article states each substrate directly."
  note "Known 2026-10-19: the examples are hypothetical, so their stipulations and the figures they state are known from the model's on date (§4.5). The article is dated 1 February 2026."
  children[gp1] = 2 "Przykład 1: two adult children"
  children[gp2] = 1 "Przykład 2: one minor child"
  estate_of[gp1_child] = gp1 "Przykład 1"
  estate_of[gp2_child] = gp2 "Przykład 2"
  estate_of[gp3_heir] = gp3 "Przykład 3"
  fraction[gp3_heir] = 0.5 "Przykład 3: 800 000 zł × 1/2 × 1/2"
  gift_claimant[gift_gp3] = gp3_heir "Przykład 3: the gift counted against the zachowek"
  gift_estate[gift_gp3] = gp3 "Przykład 3"
  gift_heir[gift_gp3] = true "Przykład 3: a gift to the entitled person"
  gift_value[gift_gp3] = 60000 "Przykład 3"
  intestate[gp3_heir] = 0.5 "Przykład 3: 800 000 zł × 1/2 × 1/2"
  line_of[gp1_child] = child "Przykład 1"
  line_of[gp2_child] = child "Przykład 2"
  protected[gp1_child] = false "Przykład 1: adult children"
  protected[gp2_child] = true "Przykład 2: a minor child"
  spouse_survives[gp1] = false assumed "Przykład 1 names only the two children"
  spouse_survives[gp2] = false assumed "Przykład 2 names only the child and gives the share as 1/1"
  substrate[gp1] = 600000 "Przykład 1"
  substrate[gp2] = 900000 "Przykład 2"
  substrate[gp3] = 800000 "Przykład 3"

version prawnik_case
  cite prawnik
  known 2026-10-19
  note "Section 'Przykład liczbowy (mini-case)'. A parent with two children gave a flat to Bartek; Anna claims her zachowek."
  note "Known 2026-10-19: the mini-case is hypothetical, so its stipulations are known from the model's on date, as the model has no start (§4.5). The article is dated 13 January 2026."
  children[mini] = 2 "Przykład liczbowy (mini-case): two children, Anna and Bartek"
  estate_net[mini] = 100000 "mini-case: 100 000 zł oszczędności"
  estate_of[anna] = mini "mini-case"
  gift_claimant[flat_bartek] = - "mini-case: Bartek makes no claim"
  gift_claimant[money_anna] = anna "mini-case, last paragraph: darowizny pieniężne, które podlegają zaliczeniu"
  gift_estate[flat_bartek] = mini "mini-case"
  gift_estate[money_anna] = mini "mini-case, last paragraph"
  gift_heir[flat_bartek] = true "mini-case: Bartek is a child of the deceased"
  gift_heir[money_anna] = true "mini-case: Anna is a child of the deceased"
  gift_value[flat_bartek] = 700000 "mini-case: według stanu z dnia darowizny, ale cen dzisiejszych"
  gift_value[money_anna] = 50000 "mini-case, last paragraph"
  gift_years[flat_bartek] = 8 "mini-case: 8 lat przed śmiercią"
  gift_years[money_anna] = ? "Kiedy Anna otrzymała darowizny pieniężne od rodzica?" "mini-case, last paragraph (no date given)"
  line_of[anna] = child "mini-case"
  protected[anna] = false "mini-case: pełnoletnia i zdolna do pracy"
  spouse_survives[mini] = false assumed "the mini-case mentions no spouse; the article's earlier two-child illustration says 'małżonek nie żyje'"

version rulecalc_examples
  cite rulecalc
  known 2026-10-19
  note "Section 'Przykłady obliczeń': a spouse inheriting with children."
  note "Known 2026-10-19: the examples are hypothetical, so their stipulations are known from the model's on date (§4.5). The page was last updated on 18 April 2026."
  children[b3] = 3 "Przykłady obliczeń, bullet 1: 3 dzieci"
  children[b5] = 5 "Przykłady obliczeń, bullet 2: 5 dzieci"
  children[b1] = 1 "Przykłady obliczeń, bullet 3: 1 dziecko"
  estate_net[b3] = 400000 "Przykłady obliczeń, bullet 1"
  estate_net[b5] = 400000 "Przykłady obliczeń, bullet 2"
  estate_net[b1] = 400000 "Przykłady obliczeń, bullet 3"
  spouse_survives[b3] = true "Przykłady obliczeń, bullet 1"
  spouse_survives[b5] = true "Przykłady obliczeń, bullet 2"
  spouse_survives[b1] = true "Przykłady obliczeń, bullet 3"
