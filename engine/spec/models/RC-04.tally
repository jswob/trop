  household_income[i34000] = 34000 "p. 4 table, row $34,000"
  household_income[i35000] = 35000 "p. 4 table, row $35,000"
  household_income[i36000] = 36000 "p. 4 table, row $36,000"
  household_income[i37000] = 37000 "p. 4 table, row $37,000"
  household_income[i38000] = 38000 "p. 4 table, row $38,000"
  household_income[i39000] = 39000 "p. 4 table, row $39,000"
  household_income[i40000] = 40000 "p. 4 table, row $40,000"
  household_income[i41000] = 41000 "p. 4 table, row $41,000"
  household_income[i42000] = 42000 "p. 4 table, row $42,000"
  household_income[i43000] = 43000 "p. 4 table, row $43,000"
  household_income[i44000] = 44000 "p. 4 table, row $44,000"
  rates_payable[r1200] = 1200 "p. 4 table, column $1,200 (level of rates payable for the 2019/2020 rating year)"
  rates_payable[r1400] = 1400 "p. 4 table, column $1,400"
  rates_payable[r1600] = 1600 "p. 4 table, column $1,600"
  rates_payable[r1800] = 1800 "p. 4 table, column $1,800"
  rates_payable[r2000] = 2000 "p. 4 table, column $2,000"
  rates_payable[r2200] = 2200 "p. 4 table, column $2,200"
  rates_payable[r2400] = 2400 "p. 4 table, column $2,400"
  rates_payable[r2600] = 2600 "p. 4 table, column $2,600"
  rates_payable[r2800] = 2800 "p. 4 table, column $2,800"
  rates_payable[r3000] = 3000 "p. 4 table, column $3,000"
  rates_payable[r3200] = 3200 "p. 4 table, column $3,200"
  rates_payable[r3500] = 3500 "p. 4 table, column $3,500"
