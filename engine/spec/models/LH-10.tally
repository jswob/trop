version v_modeller
  cite modeller
  known 2026-10-18
  note "A modeller's assumption standing for the case's own fact takes the date of the stipulations, the model's on (LANGUAGE 4.5)."
  day_count = monthly assumed "the document states no day count; Tabela 6 row 1 is consistent with interest of 1/12 of the annual rate a month, and Tab. 1-4 and the representative examples give no dates"
