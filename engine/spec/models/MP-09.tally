version dt2026_example
  cite olg_dt2026
  known 2026-10-18
  note "The facts of the Teil C Beispiel, page 4: a worked example's stipulations, known from the model's on, since it has no start (LANGUAGE §4.5)"
  child_age[k1] = 18 "page 4, C. Beispiel: im Alter von 18 Jahren (K1)"
  child_age[k2] = 7 "page 4, C. Beispiel: 7 Jahren (K2)"
  child_age[k3] = 5 "page 4, C. Beispiel: 5 Jahren (K3)"
  in_school[k1] = true "page 4, C. Beispiel: in allgemeiner Schulausbildung befindlich"
  income = 1750 "page 4, C. Beispiel: Bereinigtes Nettoeinkommen des Unterhaltspflichtigen (U): 1.750 EUR"
  lives_with_parent[k1] = true "page 4, C. Beispiel: die bei dem ... Elternteil (E) leben"
  lives_with_parent[k2] = true "page 4, C. Beispiel: die bei dem ... Elternteil (E) leben"
  lives_with_parent[k3] = true "page 4, C. Beispiel: die bei dem ... Elternteil (E) leben"

version mp09_assumed
  cite modeller
  known 2026-10-18
  note "An assumption that stands for a fact of the example: known with the stipulations, from the model's on (LANGUAGE §4.5)"
  unmarried[k1] = true assumed "the example treats K1 as a first-rank child; § 1603 Abs. 2 Satz 2 BGB requires unverheiratet, which the example does not state" "page 4, C. Beispiel"
