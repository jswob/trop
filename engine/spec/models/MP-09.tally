model mp09
  tally 1
  on 2026-10-18
  note "Düsseldorfer Tabelle 2026, Teil C (Mangelfälle), Beispiel: U owes cash maintenance to three children K1 (18, in allgemeiner Schulausbildung), K2 (7) and K3 (5), who live with E. E receives the Kindergeld and is not owed maintenance."
  note "Amounts are monthly. The month of 2026 is not stated, so the ages are read as stated rows, not from birth dates (§ 1612a Abs. 3 BGB)."

source bgb "Bürgerliches Gesetzbuch §§ 1603, 1609, 1612a, 1612b (gesetze-im-internet.de)" at "https://www.gesetze-im-internet.de/bgb/__1609.html"
source modeller "The modeller's own assumptions, each stated with its reason"
source olg_dt2026 "Düsseldorfer Tabelle, Stand: 01.01.2026 (Tabelle, Anmerkungen A–E, Anhang: Tabelle Zahlbeträge), OLG Düsseldorf" at "https://www.olg-duesseldorf.nrw.de/infos/Duesseldorfer_Tabelle/Tabelle-2026/DT_2026.pdf"

axis dt_cut_round
  nearest "each child's share rounded half up to the cent, independently (the source states no rule)"
  largest_rem "each share rounded down to the cent, the leftover cents to the largest remainders (the source states no rule)"

axis dt_u_work
  employed "U is in work (erwerbstätig), Anm. A.VII; the source does not state it"
  not_employed "U is not in work (nicht erwerbstätig), Anm. A.VII"

index agegroup = [a0_5, a6_11, a12_17, a18]

index child = [k1, k2, k3]

index incgroup = [g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15]

input child_age[c in child]: int question "Wie alt ist das Kind im maßgeblichen Monat?"

input dt_amount[g in incgroup, a in agegroup]: money EUR

input in_school[c in child]: bool question "Befindet sich das volljährige Kind in der allgemeinen Schulausbildung?"

input income: money EUR question "Wie hoch ist das bereinigte Nettoeinkommen des Unterhaltspflichtigen im Monat?"

input kindergeld: money EUR

input lives_with_parent[c in child]: bool question "Lebt das Kind im Haushalt der Eltern oder eines Elternteils?"

input selbstbehalt[w in dt_u_work]: money EUR

input unmarried[c in child]: bool question "Ist das volljährige Kind unverheiratet?"

band dt_age(n: int): key agegroup
  note "Altersstufen of the table, page 1"

band dt_group(x: money EUR): key incgroup
  note "Einkommensgruppen of the table, page 1. Bands are printed in whole euros; an income with cents above a printed upper bound is read as the next group."

def eigenbedarf: money EUR
  note "Notwendiger Eigenbedarf (Selbstbehalt) of U, Anm. A.VII"
  rule base v dt2026 = selbstbehalt[dt_u_work]

def einsatz[c in child]: money EUR
  note "Teil C: der Einsatzbetrag für den Kindesunterhalt entspricht dem Zahlbetrag"
  rule base v dt2026 = zahlbetrag[dt_group(income), dt_age(child_age[c])]

def einsatz_sum: money EUR = sum(c in child where first_rank[c]: einsatz[c])

def first_rank[c in child]: bool
  note "§ 1609 Nr. 1 BGB: minderjährige Kinder und Kinder im Sinne des § 1603 Abs. 2 Satz 2"
  rule base v bgb_2026 = child_age[c] < 18
  rule privileged excepts base v bgb_2026 when child_age[c] >= 18 = unmarried[c] and child_age[c] < 21 and lives_with_parent[c] and in_school[c]

def mangelfall: bool
  note "Teil C: das Einkommen reicht zur Deckung des Bedarfs gleichrangiger Unterhaltsberechtigter nicht aus"
  rule base v dt2026 = masse < einsatz_sum

def masse: money EUR
  note "Verteilungsmasse: Einkommen nach Abzug des notwendigen Eigenbedarfs"
  rule base v dt2026 = max(0, income - eigenbedarf)

def unterhalt[c in child]: money EUR
  note "Teil C: im Mangelfall wird die Verteilungsmasse im Verhältnis der Einsatzbeträge verteilt"
  rule base v dt2026 = einsatz[c]
  rule cut_largest excepts base v dt2026 when mangelfall and first_rank[c] and dt_cut_round = largest_rem = prorata(masse, einsatz[j] for j in child where first_rank[j], c, 0.01, rest largest)
  rule cut_nearest excepts base v dt2026 when mangelfall and first_rank[c] and dt_cut_round = nearest = prorata(masse, einsatz[j] for j in child where first_rank[j], c, 0.01, half-up, rest none)
  rule second excepts base when not first_rank[c] = ? "Nachrangige Kinder (§ 1609 Nr. 4 BGB) sind in diesem Modell nicht beschrieben."

def zahlbetrag[g in incgroup, a in agegroup]: money EUR
  note "Anhang page 6: Tabellenbetrag nach Abzug des Kindergeldanteils (hälftig bei Minderjährigen, voll bei Volljährigen), § 1612b Abs. 1 BGB"
  rule adult excepts base v dt2026 when a = a18 = dt_amount[g, a] - kindergeld
  rule base v dt2026 = dt_amount[g, a] - round(kindergeld / 2, 0.01, half-up)

ask q_eigenbedarf: eigenbedarf

ask q_einsatz: einsatz[c] for c in child

ask q_einsatz_sum: einsatz_sum

ask q_masse: masse

ask q_split_check: check sum(c in child: unterhalt[c]) = masse

ask q_unterhalt: unterhalt[c] for c in child

ask q_zahlbetrag: zahlbetrag[g1, a] for a in agegroup

version bgb_2026
  cite bgb
  known 2017-07-21
  note "§ 1609 Nr. 1 BGB in the wording of the Gesetz zur Änderung des Unterhaltsrechts of 21.12.2007 (BGBl. I Nr. 69 of 28.12.2007, S. 3189); § 1603 Abs. 2 Satz 2 BGB in the wording of the Gesetz zur Bekämpfung von Kinderehen of 17.07.2017 (BGBl. I Nr. 48 of 21.07.2017, S. 2429; lexetius.com/BGB/1603, Anm. 5-6)"
  note "Known from the later promulgation, 21.07.2017, since the rules of first_rank read both provisions. The rank rules cite this version."

version dt2026
  cite olg_dt2026
  governs 2026-01..
  known 2025-12-01
  note "Known from its publication: press release of the OLG Düsseldorf of 1 December 2025 (justiz.nrw/node/6813), the table ab sofort auf der Internetseite abrufbar. The PDF's own stamps (created 25 Nov, modified 28 Nov 2025) are before it."
