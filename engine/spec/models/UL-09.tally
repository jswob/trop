version law_stcrt2026
  cite stcrt_2026_3708
  governs 2025..
  known 2026-02-20
  note "Known from its publication in the Staatscourant, 20-02-2026."
  note "Also printed as the note 'Terugwerkende kracht' (Stcrt. 2026, 3708) under art. 5.2 of the Wet IB 2001 text geldig op 01-01-2025."
  ret_bank = 0.0137 "Artikel I: '1,44%' vervangen door '1,37%'; Artikel V onder a: terugwerkt tot en met 1 januari 2025"
  ret_debt = 0.027 "Artikel I: '2,61%' vervangen door '2,70%'; Artikel V onder a: terugwerkt tot en met 1 januari 2025"

