version v_modeller
  cite modeller
  known 2026-10-18
  note "A modeller's assumption standing for the case's own fact takes the date of the stipulations, the model's on (LANGUAGE 4.5)."
  age_months = 0 assumed "the release names only '60-latka' and '65-latek' and divides by the column-0 values" "p. 1, 'Przykładowe wyliczenia'"
  apply_on = 2026-04-01 assumed "the release says only that the new table applies to those retiring from 1 April 2026 to 31 March 2027; any day in that window gives the same table" "p. 1, last paragraph"
  reached_on = 2026-04-01 assumed "the day of reaching 60 or 65 is not stated; taken as the application day, so art. 26 ust. 6 changes nothing for the examples" "p. 1-2, last paragraph"

version v_zus
  cite zus
  known 2026-10-18
  note "The release's examples are a hypothetical case's stipulations, known from the model's on date, as it has no start (LANGUAGE 4.5). The release itself is dated 1 April 2026; regional press office, Bydgoszcz; the 2-page PDF on ZUS letterhead, created 2026-04-02 per its metadata."
  age_years[w60_500] = 60 "p. 1, 'Przykładowe wyliczenia', bullet 1: 60-latka"
  age_years[m65_500] = 65 "p. 1, 'Przykładowe wyliczenia', bullet 2: 65-latek"
  age_years[w60_700] = 60 "p. 1, 'Jeśli kapitał emerytalny wynosi 700 tys. zł', bullet 1: 60-latka"
  age_years[m65_700] = 65 "p. 1, 'Jeśli kapitał emerytalny wynosi 700 tys. zł', bullet 2: 65-latek"
  capital[w60_500] = 500000 "p. 1, 'Przykładowe wyliczenia', bullet 1: z kapitałem 500 tys. zł"
  capital[m65_500] = 500000 "p. 1, 'Przykładowe wyliczenia', bullet 2: z kapitałem 500 tys. zł"
  capital[w60_700] = 700000 "p. 1: Jeśli kapitał emerytalny wynosi 700 tys. zł, bullet 1"
  capital[m65_700] = 700000 "p. 1: Jeśli kapitał emerytalny wynosi 700 tys. zł, bullet 2"
