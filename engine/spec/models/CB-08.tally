model cb08
  tally 1
  on 2026-10-18
  note "26 CFR 1.988-2: a US individual's pound loan, (b)(9) Example 1 (cash method) and Example 2 (accrual method), and listed stock bought and sold for pounds by a cash basis individual, the (a)(2)(iv)(C) Example."
  note "X's functional currency is the dollar. The examples assume that any transaction involving an individual is a section 988 transaction ((b)(9) lead-in)."
  note "Each calendar year is one accrual period, as the Example 2 table treats it. Examples 1 and 2 don't say that X is a calendar year taxpayer."
  note "The regulation states no rounding, so nothing is rounded."

source ecfr_988_2 "26 CFR 1.988-2 Recognition and computation of exchange gain or loss (eCFR, Title 26 up to date as of 2026-10-15)" at "https://www.ecfr.gov/current/title-26/section-1.988-2"

index acctmethod = [cash_basis, accrual_basis]

index datekind = [trade, settle]

index example = [ex1, ex2]

index side = [buy, sell]

index yr = year 1992..1994

input avg_rate[y in yr]: num USD/GBP

input interest_gbp: money GBP

input method[e in example]: key acctmethod

input method_trade: key acctmethod

input principal_gbp: money GBP

input repaid_in: key yr

input spot_loan: num USD/GBP

input spot_paid[y in yr]: num USD/GBP

input trade_on[s in side]: date

input usd_converted: money USD

input usd_value[s in side, k in datekind]: money USD

def amount_realized: money USD = usd_value[sell, translation_basis[sell]]

def disposal_on: date
  note "Section 453(k), as the (a)(2)(iv)(C) Example applies it: listed stock that is sold is treated as disposed of on the trade date. The text of 453(k) was not fetched, so the rule cites the regulation's example."
  rule base v law988 = trade_on[sell]

def fx_gain_interest[e in example, y in yr]: num USD
  note "(b)(2)(ii)(B) and (b)(3): no exchange gain or loss on interest that isn't required to be accrued before receipt. For accrued interest: the pounds received, translated at the spot rate on the date received, less the same pounds translated at the average rate for the accrual period."
  rule accrual_method v law988 when method[e] = accrual_basis = interest_spot_value[y] - interest_avg_value[y]
  rule cash_method v law988 when method[e] = cash_basis = 0

def fx_gain_interest_total[e in example]: num USD = sum(y in yr: fx_gain_interest[e, y])

def fx_gain_principal: num USD at start_of(repaid_in)
  note "(b)(5): the principal translated at the spot rate on the date the payment is received, less the principal translated at the spot rate on the date the holder acquired the instrument. The principal is the holder's purchase price in pounds."
  rule base v law988 = principal_at_receipt - principal_at_loan

def gbp_basis: money USD
  note "The basis in the pounds received from the sale is their dollar value at the date used for the amount realized, as the (a)(2)(iv)(C) Example states."
  rule base v law988 = amount_realized

def interest_avg_value[y in yr]: num USD = interest_gbp * avg_rate[y]

def interest_income[e in example, y in yr]: num USD
  note "(b)(2)(ii): interest that isn't required to be accrued before receipt is translated at the spot rate on the date received. Interest that is required to be accrued is translated at the average rate for the accrual period."
  rule accrual_method v law988 when method[e] = accrual_basis = interest_avg_value[y]
  rule cash_method v law988 when method[e] = cash_basis = interest_spot_value[y]

def interest_spot_value[y in yr]: num USD = interest_gbp * spot_paid[y]

def principal_at_loan: num USD = principal_gbp * spot_loan

def principal_at_receipt: num USD = principal_gbp * spot_paid[repaid_in]

def stock_basis: money USD = usd_value[buy, translation_basis[buy]]

def stock_gain: money USD = amount_realized - stock_basis

def translation_basis[s in side]: key datekind at trade_on[s]
  note "(a)(2)(iv)(A)-(B): a cash basis taxpayer translates the currency paid for listed stock, or received for it, at the spot rate on the settlement date."
  rule accrual_method v law988 when method_trade = accrual_basis = ? "Which date does an accrual basis taxpayer translate at? The example covers only a cash basis taxpayer."
  rule cash_method v law988 when method_trade = cash_basis = settle

ask ex1_fx_on_interest: fx_gain_interest[ex1, y] for y in yr

ask ex1_interest: interest_income[ex1, y] for y in yr

ask ex2_fx_on_interest: fx_gain_interest[ex2, y] for y in yr

ask ex2_fx_on_interest_total: fx_gain_interest_total[ex2]

ask ex2_interest: interest_income[ex2, y] for y in yr

ask ex2_spot_value: interest_spot_value[y] for y in yr

ask loan_dollars: check usd_converted = principal_at_loan

ask principal_gain: fx_gain_principal

ask principal_lent: principal_at_loan

ask principal_received: principal_at_receipt

ask trade_amount_realized: amount_realized

ask trade_basis: stock_basis

ask trade_disposal: disposal_on

ask trade_gain: stock_gain

ask trade_gbp_basis: gbp_basis

version law988
  cite ecfr_988_2
  governs 1987-01-01..
  known 1992-03-17
  note "(g): the section is effective for taxable years beginning after December 31, 1986."
  note "Known from T.D. 8400, published in the Federal Register on March 17, 1992, which issued the section. The eCFR source note reads: 'T.D. 8400, 57 FR 9183, Mar. 17, 1992, as amended by T.D. 8491, 58 FR 53135, Oct. 14, 1993; T.D. 8860, 65 FR 2028, Jan. 13, 2000; T.D. 9157, 69 FR 52819, Aug. 30, 2004; T.D. 9795, 81 FR 88879, Dec. 8, 2016; T.D. 9882, 84 FR 69123, Dec. 17, 2019'."
  note "(a)(2)(iv), (b)(2)(ii), (b)(3), (b)(5) and (b)(9) Examples 1 and 2 are taken to be T.D. 8400's text: (a)(2)(v) still speaks of 'taxable years beginning after March 17, 1992'. The later amendments weren't checked paragraph by paragraph."

version ex988
  cite ecfr_988_2
  known 2026-10-18
  note "The facts of (b)(9) Examples 1 and 2 and of the (a)(2)(iv)(C) Example, as the regulation states them."
  note "These are the examples' stipulations, so they are known from the model's on date, as the case's world (LANGUAGE.md 4.5)."
  avg_rate[1992] = 1.32 "(b)(9) Ex. 2 (i), table"
  avg_rate[1993] = 1.37 "(b)(9) Ex. 2 (i), table"
  avg_rate[1994] = 1.42 "(b)(9) Ex. 2 (i), table"
  interest_gbp = 1000 "(b)(9) Ex. 1 (i): £1,000 on each 31 December of 1992, 1993 and 1994"
  method[ex1] = cash_basis "(b)(9) Ex. 1 (i)"
  method[ex2] = accrual_basis "(b)(9) Ex. 2 (i)"
  method_trade = cash_basis "(a)(2)(iv)(C) Example: a calendar year cash basis U.S. individual"
  principal_gbp = 10000 "(b)(9) Ex. 1 (i)"
  repaid_in = 1994 "(b)(9) Ex. 1 (i): repaid on 31 December 1994"
  spot_loan = 1.3 "(b)(9) Ex. 1 (i), table: 1 January 1992"
  spot_paid[1992] = 1.35 "(b)(9) Ex. 1 (i), table: 31 December 1992"
  spot_paid[1993] = 1.4 "(b)(9) Ex. 1 (i), table: 31 December 1993"
  spot_paid[1994] = 1.45 "(b)(9) Ex. 1 (i), table: 31 December 1994"
  trade_on[buy] = 1989-11-01 "(a)(2)(iv)(C) Example: purchase for settlement on November 5, 1989"
  trade_on[sell] = 1990-12-30 "(a)(2)(iv)(C) Example: sale for settlement on January 5, 1991"
  usd_converted = 13000 "(b)(9) Ex. 1 (i)"
  usd_value[buy, trade] = 140 "(a)(2)(iv)(C) Example: spot value of the £100 on November 1, 1989"
  usd_value[buy, settle] = 141 "(a)(2)(iv)(C) Example: £100 bought for $141 on November 5, 1989"
  usd_value[sell, trade] = 165 "(a)(2)(iv)(C) Example: spot value of the £110 on December 30, 1990"
  usd_value[sell, settle] = 166 "(a)(2)(iv)(C) Example: the £110 at the spot rate on January 5, 1991"
