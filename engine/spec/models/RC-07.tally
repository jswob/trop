version model_assumptions
  cite modeller
  governs always
  known 2026-10-18
  entry[b1040_25b] = 0 assumed "the case lists no entry for Form 1040 line 25b (Form(s) 1099 withholding), and the scenario has no Form 1099"
  entry[b1040_25c] = 0 assumed "the case lists no entry for Form 1040 line 25c (other forms), and the scenario has no other withholding form"
  entry[bse_05b] = 0 assumed "Schedule SE line 5a (church employee income) is blank, and line 5b is figured from line 5a"
  entry[bse_08b] = 0 assumed "the case lists no entry for Schedule SE line 8b (unreported tips, Form 4137), and the scenario has no Form 4137"
  entry[bse_08c] = 0 assumed "the case lists no entry for Schedule SE line 8c (wages, Form 8919), and the scenario has no Form 8919"
  w2_box7 = 0 assumed "the case's W-2 transcription lists no box 7 (social security tips)"
