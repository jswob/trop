  cite mp84
  known 2025-01-24
  note "promulgated 24 stycznia 2025 r. (the M.P. heading; ELI API field promulgation, https://api.sejm.gov.pl/eli/acts/MP/2025/84); the brochure's Tabela 4 row 2025 prints the same wage"
  avg_wage[2025] = 8549.18 "sole operative sentence: w czwartym kwartale w 2024 r. wyniosło 8549,18 zł"

version rm2025_1242
