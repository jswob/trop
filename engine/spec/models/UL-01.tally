  governs 2026-01..
  known 2025-09-15
  note "promulgated 15 września 2025 r. (ELI API field promulgation, https://api.sejm.gov.pl/eli/acts/DU/2025/1242); the ZUS page's karta podatkowa group prints the same wage"
  min_wage[2026] = 4806 "§ 1: od dnia 1 stycznia 2026 r. ... 4806 zł"

version mp2026_117
  cite mp117
  known 2026-01-26
  note "promulgated 26 stycznia 2026 r. (ELI API field promulgation, https://api.sejm.gov.pl/eli/acts/MP/2026/117)"
  avg_wage[2026] = 9228.64 "sole operative sentence: w czwartym kwartale w 2025 r. wyniosło 9228,64 zł"

version zus_page_2026
  cite zus_page
  known 2026-02-02
  note "the page's own date; its shares restate art. 81 ust. 2z, 2za and 2ya, whose amending acts the model doesn't trace, so the page is their source (§4.5 fallback)"
  karta_share[2026] = 1 "karta podatkowa group: 100% minimalnego wynagrodzenia od 1 stycznia 2026 r."
  share[nobiz] = 1 "second group, footnote [5]: 100% przeciętnego miesięcznego wynagrodzenia"
  share[collab] = 0.75 "third group, footnote [6] (art. 81 ust. 2ya): 75% przeciętnego miesięcznego wynagrodzenia"

version zus_brochure_2026
  cite zus_brochure
  known 2026-02-28
  note "the brochure is dated luty 2026 with no day; the last day of February is taken as its known date"
  mw_share[mw75] = 0.75 "p. 7, Tabela 4, column heading 75% minimalnego wynagrodzenia"
  mw_share[mw100] = 1 "p. 7, Tabela 4, column heading 100% minimalnego wynagrodzenia"
