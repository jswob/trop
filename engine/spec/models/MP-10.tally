model mp10
  tally 2
  on 2026-10-18
  start 2026-01-01
  end 2026-12-31
  note "Stadt Hanau's one-page copy of the Düsseldorfer Tabelle 2026, transcribed as printed and used as a lookup table."
  note "The income bands are whole euros as printed, so the band's argument is an int. The copy prints the lower ends of groups 11 to 15 below the upper end of the group before."

source hanau_dt2026 "Düsseldorfer Tabelle 2026 (Düsseldorfer Tabelle in € Stand 01. Januar 2026 (Kindergeld Stand 01. Januar 2026)), Stadt Hanau" at "https://gude.hanau.de/mam/formulare/merkblaetter/düsseldorfer_tabelle_2026.pdf"

unit EUR: currency minor 0.01

index agegroup = [a0_5, a6_11, a12_17, a18]

index incgroup = [g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, g11, g12, g13, g14, g15]

input hanau_amount[g in incgroup, a in agegroup]: money EUR
  note "the columns headed Mindestunterhalt (0-5, 6 - 11, 12 - 17) and the column ab 18"

input kg_half: money EUR
  note "the copy prints only the half Kindergeld, in every row and age band"

input probe: int question "Welches Nettoeinkommen (volle Euro) wird in der Tabelle nachgeschlagen?"

band hanau_group(income: int): key incgroup
  note "Nettoeinkommen des Unterhaltspflichtigen, table rows 1-15, bounds as printed"

def zahlbetrag[g in incgroup, a in agegroup]: money EUR at reader
  note "Zahlbetrag = Mindestunterhalt abzüglich Kindergeld, as the copy computes it per row"
  rule adult beats base = ?"Die Hanauer Kopie zieht in der Spalte ab 18 kein Kindergeld ab und nennt keinen Zahlbetrag." when a == a18
  rule base v hanau2026 = hanau_amount[g, a] - kg_half

ask q_group_in_overlap: hanau_group(probe) with probe = 5501 law 2026-10-18

ask q_group_outside_overlap: hanau_group(probe) with probe = 2100 law 2026-10-18

ask q_kg_half: kg_half law 2026-10-18

ask q_zahlbetrag: zahlbetrag[g, a] for g in incgroup, a in [a0_5, a6_11, a12_17] law 2026-10-18

version hanau2026
  cite hanau_dt2026
  governs 2026-01..
  known 2026-01-02
  note "Known date: the copy prints no date of its own (Stand 01. Januar 2026 is the date of the figures), so it is known from its earliest public stamp, the server's Last-Modified, Fri, 02 Jan 2026 12:15:32 GMT (LANGUAGE §4.5). Earlier rounds took the PDF's own stamps (author Stadt Hanau, created 2 Jan 2026 10:17, modified 2 Jan 2026 13:13), the same day; they don't count, since a public stamp exists (D8)"
  hanau_amount[g1, a0_5] = 486 "table row 1, 0-5 Mindestunterhalt"
  hanau_amount[g1, a6_11] = 558 "table row 1, 6 - 11 Mindestunterhalt"
  hanau_amount[g1, a12_17] = 653 "table row 1, 12 - 17 Mindestunterhalt"
