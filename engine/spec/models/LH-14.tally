model lh14
  tally 2
  on 2026-10-18
  start 2026-01-01
  end 2026-12-31
  note "US Windfall Elimination Provision: the reduced 90% factor by years of substantial earnings, the maximum reduction by eligibility year (ELY), SSA's ELY 2013 worked example, the 2024 and 2025 regular-formula illustrations, and the retroactive repeal by Public Law 118-273."
  note "The chart and the ELY 2013 example are pre-repeal computations for benefit months before 2024, so they are not gated by wep_applies, which covers benefit months 2023-01 to 2025-12."
  note "Known dates (§4.5): a law row from the approval of the act that gave the cited text its present wording, found in the amendment notes to 42 U.S.C. 402 and 415 (govinfo, US Code 2023 edition); a leaflet from its earliest public stamp, the server's Last-Modified for the PDF, which is earlier than its footer month's last day and its retrieval (the PDF's own stamps don't count where a public stamp exists); a web page from its printed 'last reviewed' or 'last updated' stamp, else its dated archive capture; the worked examples' and illustrations' stipulations, and the modeller's stand-ins for them, from on. Each version's note says which."

source lifted_1_0_1 "Figures tally 1.0.1 allowed inline in rules"

source pl100_647 "Technical and Miscellaneous Revenue Act of 1988, Pub. L. 100-647, 102 Stat. 3342, approved November 10, 1988" at "https://www.govinfo.gov/content/pkg/STATUTE-102/pdf/STATUTE-102-Pg3342.pdf"

source pl101_508 "Omnibus Budget Reconciliation Act of 1990, Pub. L. 101-508, 104 Stat. 1388, approved November 5, 1990" at "https://www.govinfo.gov/content/pkg/STATUTE-104/pdf/STATUTE-104-Pg1388.pdf"

source pl103_296 "Social Security Independence and Program Improvements Act of 1994, Pub. L. 103-296, 108 Stat. 1464, approved August 15, 1994" at "https://www.govinfo.gov/content/pkg/STATUTE-108/pdf/STATUTE-108-Pg1464.pdf"

source pl118_273 "Public Law 118-273, Social Security Fairness Act of 2023, 138 Stat. 3232" at "https://www.govinfo.gov/content/pkg/PLAW-118publ273/pdf/PLAW-118publ273.pdf"

source pl92_603 "Social Security Amendments of 1972, Pub. L. 92-603, 86 Stat. 1329, approved October 30, 1972" at "https://www.govinfo.gov/content/pkg/STATUTE-86/pdf/STATUTE-86-Pg1329.pdf"

source pl95_216 "Social Security Amendments of 1977, Pub. L. 95-216, 91 Stat. 1509, approved December 20, 1977" at "https://uscode.house.gov/statutes/pl/95/216.pdf"

source pl98_21 "Social Security Amendments of 1983, Pub. L. 98-21, 97 Stat. 65, approved April 20, 1983" at "https://uscode.house.gov/statutes/pl/98/21.pdf"

source ssa_bendpoints "SSA OACT, Benefit Formula Bend Points (Wayback capture 2025-01-02)" at "https://web.archive.org/web/20250102125805/https://www.ssa.gov/oact/cola/bendpoints.html"

source ssa_chart "SSA Retirement Planner, WEP maximum-reduction chart, last reviewed 12/19/2012" at "https://web.archive.org/web/20130215235541/http://ssa.gov/retire2/wep-chart.htm"

source ssa_examples "SSA Retirement Planner, WEP examples, ELY 2013 version (reviewed 2014-01-08)" at "https://web.archive.org/web/20140122055935/http://ssa.gov/retire2/wep-examples.htm"

source ssa_fairness "SSA, Social Security Fairness Act: WEP and GPO update, last updated March 3, 2025" at "https://web.archive.org/web/20250306160823/https://www.ssa.gov/benefits/retirement/social-security-fairness-act.html"

source ssa_pub2013 "SSA Publication No. 05-10045, Windfall Elimination Provision, January 2013 edition (PDF created and last saved 2012-12-21)" at "https://webarchive.library.unt.edu/web/20130214043925id_/http://ssa.gov/pubs/10045.pdf"

source ssa_pub2024 "SSA Publication No. 05-10045, Windfall Elimination Provision, January 2024 edition (PDF created 2023-11-27, last saved 2023-12-04)" at "https://web.archive.org/web/20241205211251/https://www.ssa.gov/pubs/EN-05-10045.pdf"

source ssa_pub2025 "SSA Publication No. 05-10045, Windfall Elimination Provision, January 2025 edition (PDF created and last saved 2024-11-07)" at "https://web.archive.org/web/20250217155239/https://www.ssa.gov/pubs/EN-05-10045.pdf"

unit USD: currency minor 0.01

axis chart_cut
  down "chart amounts truncated to $0.1"
  half-even "chart amounts to the nearest $0.1, ties to even"
  half-up "chart amounts to the nearest $0.1, ties up"
  up "chart amounts rounded up to $0.1"

axis ex_round
  footnote "examples page footnote: every benefit amount rounded down to the dollar, from the $1,000 ELY benefit"
  statute "PIA and COLA'd PIA down to the dime (§215(a)(1)(A), §215(i)), reduction up to the dime (§202(q)(8)), increase down to the dime, payable benefit down to the dollar (§215(g))"

axis guarantee
  applied "the cut is at most half the non-covered pension (§215(a)(7)(B)(i); leaflet 'A guarantee'); the example states no pension"
  ignored "the example's reading: the pension is large enough that the half-pension cap does not bind"

axis illus_cut
  dime "the illustrated benefit is the PIA rounded down to the dime (§215(a)(1)(A))"
  dollar "the illustrated benefit is rounded down to the dollar (§215(g))"

index bmonth = month 2023-01..2025-12

index claim_at = [at_fra, at_62, at_70]

index ed = [ed2024, ed2025]

index ely = int 1990..2025

index illus = [avg3000, avg8000]

index rr_kind = [low_paid, high_paid]
  note "the 2013 edition's two replacement rates: a lower-paid worker's, and the average over highly paid workers"

index tier = [t1, t2, t3]

index wepk = [with_wep, no_wep]

index yse = int 0..30

input affected_count: int question "How many people did WEP and GPO reduce or eliminate benefits for? SSA's caseload count; the case holds no caseload records (press release of 2025-03-04, paragraph 3)"

input apps_done_share: num question "What share of the new applications since the Act had SSA completed by the week ending 2025-02-28? SSA's workload count; the case holds no workload records (Fairness Act page)"

input apps_taken: int question "How many new applications had SSA taken since the Act by the week ending 2025-02-28? SSA's workload count; the case holds no workload records (Fairness Act page)"

input backpay_due: date question "By what day does SSA deposit the one-time retroactive payment? SSA's administrative schedule; the Act fixes none (Fairness Act page)"

input bp1[e in ely]: money USD question "First bend point for this year of eligibility: not in the case"

input bp2[e in ely]: money USD question "Second bend point for this year of eligibility: not in the case"

input chart_cell_0_1: money USD
  note "lifted from an inline figure of tally 1.0.1"

input chart_ex_benefit: money USD

input chart_ex_cola: num

input chart_min_years: key yse

input chart_to: key ely

input complex_months: int question "How many months may SSA take to adjust a complex, manually processed case? SSA's processing estimate; the case holds no processing records (Fairness Act page)"

input covered_share: num question "What share of state and local public employees work in Social Security-covered employment? A labour-force statistic; the case holds no employment data (Fairness Act page)"

input drc_pct: num

input early_cut: int

input early_pct_1: num

input early_pct_2: num

input ed_ely[d in ed]: key ely

input enacted: date

input ex_benefit_0_1: money USD
  note "lifted from an inline figure of tally 1.0.1"

input ex_claim[c in claim_at]: (early int, late int)

input ex_cola: num

input ex_cola_pia_0_1: money USD
  note "lifted from an inline figure of tally 1.0.1"

input ex_ely: key ely

input ex_pension: money USD question "Non-covered pension of the ELY 2013 example worker: the example states none"

input ex_pia_0_1: money USD
  note "lifted from an inline figure of tally 1.0.1"

input ex_pia_full: money USD

input ex_wep_cut_2: int
  note "lifted from an inline figure of tally 1.0.1"

input ex_years: key yse

input first_new_month: key bmonth

input illus_aime[d in ed, i in illus]: money USD

input illus_benefit_0_1: money USD
  note "lifted from an inline figure of tally 1.0.1"

input increase_top: money USD question "What is the largest monthly increase the repeal gives a beneficiary? It needs every affected beneficiary's benefit; the case holds none (Fairness Act page)"

input pay_lag: int

input pay_start: date question "On what day did SSA begin paying retroactive benefits and the higher monthly amounts? SSA's administrative schedule; the Act fixes none (Fairness Act page)"

input pia_pct[t in tier]: num

input retro_count: int question "How many people had SSA paid retroactive benefits through 2025-03-04? SSA's payment records, which the case doesn't hold (press release of 2025-03-04, paragraph 1)"

input retro_total: money USD question "How much had SSA paid in retroactive benefits through 2025-03-04? SSA's payment records, which the case doesn't hold (press release of 2025-03-04, paragraph 1)"

input rr_aime[r in rr_kind]: money USD

input rr_ely: key ely

input wep_applies[m in bmonth]: bool

input wep_pct[n in yse]: num

def chart_cell[e in ely, n in yse]: money USD = round(max_cut[e, n], chart_cell_0_1, chart_cut) at reader

def chart_ex_inc: money USD = round(chart_ex_benefit * chart_ex_cola, 1, down) at reader

def ex_benefit[k in wepk, c in claim_at]: money USD at reader
  note "the monthly benefit when claimed at FRA, at 62 or at 70"
  rule base = round(ex_pia[k] - round(ex_pia[k] * ex_red[c], ex_benefit_0_1, up) + round(ex_pia[k] * ex_inc[c], ex_benefit_0_1, down), 1, down)
  rule footnote beats base = round(ex_pia[k] * ex_factor[c], 1, down) when ex_round == footnote

def ex_cola_benefit[k in wepk]: money USD = ex_benefit[k, at_fra] + ex_cola_inc[k] at reader

def ex_cola_inc[k in wepk]: money USD at reader
  rule base = round(ex_cola_pia[k], 1, down) - ex_benefit[k, at_fra]
  rule footnote beats base = round(ex_benefit[k, at_fra] * ex_cola, 1, down) when ex_round == footnote

def ex_cola_pia[k in wepk]: money USD = round(ex_pia[k] * (1 + ex_cola), ex_cola_pia_0_1, down) at reader

def ex_cut_after[c in claim_at]: money USD = ex_benefit[no_wep, c] - ex_benefit[with_wep, c] at reader

def ex_factor[c in claim_at]: num = 1 - ex_red[c] + ex_inc[c] at reader

def ex_inc[c in claim_at]: num = drc_pct * ex_claim[c].late at reader

def ex_pia[k in wepk]: money USD at reader
  rule base = ex_pia_full when k == no_wep
  rule wep = round(ex_pia_full - ex_wep_cut, ex_pia_0_1, down) when k == with_wep
  rule wep_footnote beats wep = round(ex_pia_full - ex_wep_cut, 1, down) when k == with_wep and ex_round == footnote

def ex_red[c in claim_at]: num = early_pct_1 * min(ex_claim[c].early, early_cut) + early_pct_2 * max(0, ex_claim[c].early - early_cut) at reader

def ex_wep_cut: num USD at reader
  note "the example's AIME is not given; its cut is the full first-band cut, so the AIME is read as at least the first bend point"
  rule base = max_cut[ex_ely, ex_years]
  rule capped beats base = min(max_cut[ex_ely, ex_years], ex_pension / ex_wep_cut_2) when guarantee == applied

def illus_benefit[d in ed, i in illus]: money USD at reader
  rule base = round(illus_formula[d, i], illus_benefit_0_1, down)
  rule dollar beats base = round(illus_formula[d, i], 1, down) when illus_cut == dollar

def illus_formula[d in ed, i in illus]: num USD = pia_pct[t1] * min(illus_aime[d, i], bp1[ed_ely[d]]) + pia_pct[t2] * max(0, min(illus_aime[d, i], bp2[ed_ely[d]]) - bp1[ed_ely[d]]) + pia_pct[t3] * max(0, illus_aime[d, i] - bp2[ed_ely[d]]) at reader

def illus_rate[d in ed, i in illus]: num = illus_benefit[d, i] / illus_aime[d, i] at reader

def max_cut[e in ely, n in yse]: num USD = (pia_pct[t1] - wep_pct[n]) * bp1[e] at reader

def max_cut_m[e in ely, n in yse, m in bmonth]: num USD at start_of(m)
  note "the maximum WEP cut for benefit month m: zero where WEP no longer applies"
  rule base = max_cut[e, n]
  rule repealed beats base = 0 when not wep_applies[m]

def paid_month[m in bmonth]: month = m + pay_lag at start_of(m)

def retro_avg: num USD at reader
  note "the average retroactive payment: the total paid over the number of people paid"
  rule base = retro_total / retro_count

def rr_benefit[r in rr_kind]: num USD at reader
  note "the regular-formula benefit behind the 2013 edition's replacement rates, under its own 'How it works' formula; no rounding, since the edition gives the rates as 'about'"
  rule base = pia_pct[t1] * min(rr_aime[r], bp1[rr_ely]) + pia_pct[t2] * max(0, min(rr_aime[r], bp2[rr_ely]) - bp1[rr_ely]) + pia_pct[t3] * max(0, rr_aime[r] - bp2[rr_ely])

def rr_rate[r in rr_kind]: num at reader
  note "the replacement rate as the 2024 and 2025 editions compute theirs: the benefit over the average monthly earnings"
  rule base = rr_benefit[r] / rr_aime[r]

ask backpay_by: backpay_due law 2026-10-18

ask chart_example: chart_ex_inc law 2026-10-18

ask chart_rows: chart_cell[e, n] for e in ely where e <= chart_to, n in yse where n >= chart_min_years law 2026-10-18

ask cola_example: ex_cola_inc[with_wep], ex_cola_inc[no_wep], ex_cola_benefit[no_wep], ex_cola_benefit[with_wep] law 2026-10-18

ask cola_wep_cut: ex_cola_benefit[no_wep] - ex_cola_benefit[with_wep] law 2026-10-18

ask delayed_benefits: ex_benefit[with_wep, at_70], ex_benefit[no_wep, at_70] law 2026-10-18

ask delayed_increase: ex_inc[at_70] law 2026-10-18

ask delayed_wep_cut: ex_cut_after[at_70] law 2026-10-18

ask early_benefits: ex_benefit[with_wep, at_62], ex_benefit[no_wep, at_62] law 2026-10-18

ask early_factor: ex_factor[at_62] law 2026-10-18

ask early_wep_cut: ex_cut_after[at_62] law 2026-10-18

ask ely2013_benefit: ex_benefit[with_wep, at_fra] law 2026-10-18

ask ely2013_cut: ex_wep_cut law 2026-10-18

ask first_free_month: first(m in bmonth where not wep_applies[m]) law 2026-10-18

ask first_new_paid: paid_month[first_new_month] law 2026-10-18

ask illus_2024: illus_benefit[ed2024, i], illus_rate[ed2024, i] for i in illus law 2026-10-18

ask illus_2025: illus_benefit[ed2025, i], illus_rate[ed2025, i] for i in illus law 2026-10-18

ask jan2024_received: paid_month[2024-01] law 2026-10-18

ask last_wep_month: last(m in bmonth where wep_applies[m]) law 2026-10-18

ask last_wep_month_before: last(m in bmonth where wep_applies[m]) law 2025-01-04 as known 2025-01-04

ask max_2025_leaflet: max_cut_m[2025, 20, 2025-01] law 2025-01-02 as known 2025-01-02

ask max_2025_now: max_cut_m[2025, 20, 2025-01] law 2026-10-18

ask payments_start: pay_start law 2026-10-18

ask rr_2013_high: rr_rate[high_paid] law 2026-10-18

ask rr_2013_low: rr_rate[low_paid] law 2026-10-18

ask signed_on: enacted law 2026-10-18

ask stat_affected: affected_count law 2026-10-18

ask stat_apps: apps_taken, apps_done_share law 2026-10-18

ask stat_complex: complex_months law 2026-10-18

ask stat_covered: covered_share law 2026-10-18

ask stat_increase: increase_top law 2026-10-18

ask stat_paid: retro_count, retro_total, retro_avg law 2026-10-18

version lifted_figures
  cite lifted_1_0_1
  governs always
  known 1972-10-30
  chart_cell_0_1 = 0.1 "inline in tally 1.0.1: chart_cell line 145, round step"
  ex_benefit_0_1 = 0.1 "inline in tally 1.0.1: ex_benefit line 151, round step"
  ex_cola_pia_0_1 = 0.1 "inline in tally 1.0.1: ex_cola_pia line 160, round step"
  ex_pia_0_1 = 0.1 "inline in tally 1.0.1: ex_pia line 170, round step"
  ex_wep_cut_2 = 2 "inline in tally 1.0.1: ex_wep_cut line 178, factor"
  illus_benefit_0_1 = 0.1 "inline in tally 1.0.1: illus_benefit line 181, round step"

version pl92_603_v
  cite pl92_603
  governs always
  known 1972-10-30
  note "known: the Act's approval date (law from approval, §4.5). Which act: its Sec. 102(e)(1) rewrote §202(q)(1)(A), inserting provisions for widow's and widower's benefits, and so gave the cited clause its present wording (US Code notes to 42 U.S.C. 402, 1972 amendments). Pub. L. 103-296 Sec. 321(a)(3) (1994) only struck a dash after 'multiplied by', which keeps the wording. The 5/9-of-1-percent fraction itself dates from the 1956 amendments (women) and Pub. L. 87-64 (men, 1961); round 2 cited the 1961 Act. SSA's compilation of §202 (Wayback capture 2024-12-12) is the locator only (§5.3)"
  early_pct_1 = 1/180 "§202(q)(1)(A): 5/9 of 1 percent of such amount if such benefit is an old-age insurance benefit (SSA compilation of §202)"

version pl95_216_v
  cite pl95_216
  governs always
  known 1977-12-20
  note "known: the Act's approval date (law from approval, §4.5). Which act: the US Code notes to 42 U.S.C. 415 show no later change to §215(a)(1)(A)(i)-(iii); Pub. L. 97-35 (1981) reworded only the rounding words after clause (iii). Its Title II rewrote §215(a) with the 90/32/15 percent formula; the leaflets restate it ('How it works'). SSA's pre-repeal compilation of §215 (Wayback capture 2024-12-02) is the locator only (§5.3)"
  pia_pct[t1] = 0.9 "§215(a)(1)(A)(i), 90 percent; leaflets p. 1 'How it works': × 90%"
  pia_pct[t2] = 0.32 "§215(a)(1)(A)(ii), 32 percent; leaflets: × 32%"
  pia_pct[t3] = 0.15 "§215(a)(1)(A)(iii), 15 percent; leaflets: balance × 15%"

version pl98_21_v
  cite pl98_21
  governs always
  known 1983-04-20
  note "known: the Act's approval date (law from approval, §4.5). It enacted the WEP, §215(a)(7) (Sec. 113, 'Elimination of windfall benefits for individuals receiving pensions from noncovered employment'; SSA POMS RS 00605.360), the 5/12-of-1-percent reduction beyond 36 months (§202(q)(9), Sec. 201(b)(1)) and the 2/3-of-1-percent delayed credit for eligibility after 2004 (§202(w)(6), Sec. 114(b)). Which act: the US Code notes to 42 U.S.C. 402 and 415 show no later change to the wording of §202(q)(9)(A), §202(w)(6)(D) or §215(a)(7)(B)(ii)(V); Pub. L. 103-296 touched only (q)(9)'s opening words and (q)(9)(B), and Pub. L. 98-369 only (a)(7)(B)(ii)(I). The other WEP rows sit with the later acts that reworded their text: (D)'s table with Pub. L. 100-647, its 30-year sentence with Pub. L. 101-508, and (A) with Pub. L. 103-296. As enacted here, (D) eased the cut only from 26 years (97 Stat. 77). SSA's compilations of §202 (Wayback 2024-12-12) and of §215 before the repeal (Wayback 2024-12-02) are the locators only (§5.3); the leaflets' p. 2 second table prints the same percentages"
  drc_pct = 1/150 "§202(w)(6)(D): 2/3 of 1 percent, first eligible after 2004"
  early_cut = 36 "§202(q)(9)(A): the first 36 months"
  early_pct_2 = 1/240 "§202(q)(9)(A): five-twelfths of 1 percent"
  wep_pct[0..20] = 0.4 "§215(a)(7)(B)(ii)(V): 40.0 percent for eligibility in 1990 or later; leaflets p. 2 second table, 20 or fewer, 40%"

version pl100_647_v
  cite pl100_647
  governs always
  known 1988-11-10
  note "known: the Act's approval date (law from approval, §4.5). Which act: its Sec. 8003(a) substituted '20 years' for '25 years' in §215(a)(7)(D) and the present table, 21 to 29 years of coverage, for Pub. L. 98-21's four clauses (26 to 29 years: 50 to 80 percent), for benefits payable for months after December 1988 (Sec. 8003(b)); US Code notes to 42 U.S.C. 415, 1988 amendments. Every read here is for a later month, so the version states no span. SSA's compilation of §215 before the repeal (Wayback 2024-12-02) is the locator only (§5.3)"
  wep_pct[21] = 0.45 "§215(a)(7)(D) table: 21 years of coverage, 45 percent"
  wep_pct[22] = 0.5 "§215(a)(7)(D): 22, 50 percent"
  wep_pct[23] = 0.55 "§215(a)(7)(D): 23, 55 percent"
  wep_pct[24] = 0.6 "§215(a)(7)(D): 24, 60 percent"
  wep_pct[25] = 0.65 "§215(a)(7)(D): 25, 65 percent"
  wep_pct[26] = 0.7 "§215(a)(7)(D): 26, 70 percent"
  wep_pct[27] = 0.75 "§215(a)(7)(D): 27, 75 percent"
  wep_pct[28] = 0.8 "§215(a)(7)(D): 28, 80 percent"
  wep_pct[29] = 0.85 "§215(a)(7)(D): 29, 85 percent"

version pl101_508_v
  cite pl101_508
  governs always
  known 1990-11-05
  note "known: the Act's approval date (law from approval, §4.5). Which act: its Sec. 5122(b) struck '(as defined in paragraph (1)(C)(ii))' from the end of §215(a)(7)(D)'s first sentence, which exempts 30 or more years of coverage, and added the sentence that reads a year of coverage at 25 percent; so it gave the cited sentence its present wording (US Code notes to 42 U.S.C. 415, 1990 amendments). Pub. L. 98-21 enacted the exemption itself. SSA's compilation of §215 before the repeal (Wayback 2024-12-02) is the locator only (§5.3)"
  wep_pct[30] = 0.9 "§215(a)(7)(D), first sentence: 30 years or more of coverage, the paragraph does not apply, so §215(a)(1)(A)(i)'s 90 percent; leaflets: 30 or more, 90%"

version pl103_296_v
  cite pl103_296
  governs always
  known 1994-08-15
  note "known: the Act's approval date (law from approval, §4.5). Which act: its Sec. 308(b) rewrote the closing provisions of §215(a)(7)(A), adding the exclusion of a payment based wholly on uniformed service, for benefits payable for months after December 1994; it is the last act to change (A)'s wording before the repeal (US Code notes to 42 U.S.C. 415: Pub. L. 98-21 enacted (A); Pub. L. 100-647 Sec. 8011(a)(1) and Pub. L. 101-508 Sec. 5117(a)(3)(E)(ii) amended it before). SSA's compilation of §215 before the repeal (Wayback 2024-12-02) is the locator only (§5.3)"
  wep_applies = true "§215(a)(7)(A): individuals eligible after 1985 for a pension from noncovered employment"

version chart_v
  cite ssa_chart
  governs always
  known 2012-12-19
  note "known: the page's own stamp, 'Last reviewed or modified 12/19/2012' (§4.5); the example's stipulated benefit is in chart_ex_v"
  chart_ex_cola = 0.058 "'Example': in January, 2009 the 5.8% COLA"
  chart_min_years = 20 "chart header, column '20 or less'"
  chart_to = 2013 "chart rows ELY 1990-2013, last row"

version pub2013_v
  cite ssa_pub2013
  governs always
  known 2013-01-09
  note "known: the server's Last-Modified for the PDF, 2013-01-09, its earliest public stamp: earlier than the footer month's last day, 2013-01-31 ('January 2013'), the capture, 2013-02-15, and the retrieval day (§4.5). The PDF's own stamps (created and last saved 2012-12-21) don't count, since public stamps exist (D8). Round 2 took the month's last day; round 3 the last-saved stamp. The UNT link serves its capture of 2013-02-15, the same PDF"
  rr_aime[low_paid] = ?"What average monthly earnings stand behind the 2013 edition's lower-paid replacement rate? The edition states the rate with no earnings behind it" "p. 1 'Why a different formula is used'"
  rr_aime[high_paid] = ?"What average monthly earnings stand behind the 2013 edition's rate for highly paid workers? The edition states an average over a group with no earnings behind it" "p. 1 'Why a different formula is used'"

version examples_v
  cite ssa_examples
  governs always
  known 2014-01-22
  note "known: the dated archive capture read, 2014-01-22 (Wayback 20140122055935), its earliest public stamp; the page prints no stamp (§4.5). Its own meta tag dc.date.reviewed, 2014-01-08, doesn't count, since a public stamp exists (D8). The example worker's stipulations are in examples_ex_v"
  ex_cola = 0.015 "COLA Example: the 1.5% January, 2014 COLA"

