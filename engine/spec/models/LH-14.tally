version pl118_text_v
  cite pl118_273
  governs always
  known 2025-01-05
  note "known: the Act's approval date (law from approval, §4.5)"
  enacted = 2025-01-05 "last line of p. 2: 'Approved January 5, 2025.'"

version repeal_v
  cite pl118_273
  governs 2024-01..
  known 2025-01-05
  note "known: the Act's approval date (law from approval, §4.5). Sec. 3(a) strikes §215(a)(7); Sec. 4 applies it to benefits for months after December 2023. The Act says nothing on back pay, and on 2025-01-05 the reality couldn't know SSA's schedule for it, so this version has no arrears line: SSA's answer is the line of repeal_v in fairness_v (§5.13.3). Round 2 put arrears on 2025-03-31 here."
  replace wep_applies = false "Sec. 3(a), Sec. 4: benefits payable for months after December 2023"

version fairness_v
  cite ssa_fairness
  governs always
  known 2025-03-03
  note "known: the page's printed stamp, 'Last updated March 3, 2025' (§4.5)."
  note "Back pay: the page announces SSA's answer to the repeal's change: payments start February 25, 2025, with a one-time retroactive payment by the end of March (Q&A 'When will a person see their Social Security benefit increase'). That window, 2025-02-25 to 2025-03-31, lies in no single month, so the line dates it by its last day (§5.13.3). It is a later answer, of repeal_v, known from this page's stamp. The model books no pay, so the line reaches nothing."
  first_new_month = 2025-03 "Q&A 'When will a person see their Social Security benefit increase': the new monthly amount is for their March 2025 benefit"
  pay_lag = 1 "Q&A 'When will a person see…': Social Security benefits are paid one month behind"

