ask t1_s75_y30: rate_pct[e1926, s75, y30, w, fixed] for w in wr

ask t2_s0_y20: rate_pct[e1926, s0, y20, w, indexed] for w in wr

ask t2_s0_y25: rate_pct[e1926, s0, y25, w, indexed] for w in wr

ask t2_s0_y30: rate_pct[e1926, s0, y30, w, indexed] for w in wr

ask t2_s100_y20: rate_pct[e1926, s100, y20, w, indexed] for w in wr

ask t2_s100_y25: rate_pct[e1926, s100, y25, w, indexed] for w in wr

ask t2_s100_y30: rate_pct[e1926, s100, y30, w, indexed] for w in wr

ask t2_s25_y20: rate_pct[e1926, s25, y20, w, indexed] for w in wr

ask t2_s25_y25: rate_pct[e1926, s25, y25, w, indexed] for w in wr

ask t2_s25_y30: rate_pct[e1926, s25, y30, w, indexed] for w in wr

ask t2_s50_y20: rate_pct[e1926, s50, y20, w, indexed] for w in wr

ask t2_s50_y25: rate_pct[e1926, s50, y25, w, indexed] for w in wr

ask t2_s50_y30: rate_pct[e1926, s50, y30, w, indexed] for w in wr

ask t2_s75_y20: rate_pct[e1926, s75, y20, w, indexed] for w in wr

