ask t2_s75_y30: rate_pct[e1926, s75, y30, w, indexed] for w in wr

ask t3_s0_y20: rate_pct[e1946, s0, y20, w, fixed] for w in wr

ask t3_s0_y25: rate_pct[e1946, s0, y25, w, fixed] for w in wr

ask t3_s0_y30: rate_pct[e1946, s0, y30, w, fixed] for w in wr

ask t3_s100_y20: rate_pct[e1946, s100, y20, w, fixed] for w in wr

ask t3_s100_y25: rate_pct[e1946, s100, y25, w, fixed] for w in wr

ask t3_s100_y30: rate_pct[e1946, s100, y30, w, fixed] for w in wr

ask t3_s25_y20: rate_pct[e1946, s25, y20, w, fixed] for w in wr

