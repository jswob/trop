part pl_employment
  tally 1
  law
  note "Umowa o pracę: składki pracownika, zdrowotna, zaliczka PIT, zeznanie PIT-37 z ulgą na dziecko."
  note "Wycinek przykładowy z kwotami prototypu; nie przeszedł bramki."

input ee_rate[z in zus_part]: num

input kup_month: money PLN

input pit_reduction_month: money PLN

input relief_limit: money PLN

input relief_month: money PLN

input relief_parent[c in person]: key person question "Który z rodziców odlicza ulgę na to dziecko?"

input salary[j in job, m in month]: money PLN question "Ile wynosi pensja brutto z tej pracy w tym miesiącu?"

band pit_scale(x: num PLN): num PLN
  note "skala podatkowa, art. 27 ust. 1: podatek przed ulgami, po kwocie zmniejszającej"

def child_relief[p in person, y in tax_year]: money PLN
  rule base v pit_2022 = sum(c in person where parent[c, p] and relief_parent[c] = p: relief_months[c, y]) * relief_month
  rule over_limit excepts base v pit_2022 when pit37_base[p, y] > relief_limit = 0

def emp_base_capped[j in job, m in month]: money PLN = max(0, min(salary[j, m], zus_cap[year_of(m)] - emp_ytd[j, m]))

def emp_cum[j in job, m in month]: money PLN = sum(k in month where year_of(k) = year_of(m) and k <= m: emp_pit_base[j, k])

def emp_health[j in job, m in month]: money PLN
  rule base v health_2022 = round((salary[j, m] - emp_zus[j, m]) * health_rate, 0.01, half-up)

def emp_net[j in job, m in month]: money PLN = salary[j, m] - emp_zus[j, m] - emp_health[j, m] - emp_pit_adv[j, m]

def emp_pit_adv[j in job, m in month]: money PLN
  note "art. 32: zaliczka od narastającej podstawy, minus 1/12 kwoty zmniejszającej, do pełnych złotych"
  rule base v pit_2022 = max(0, round(pit_scale(emp_cum[j, m]) - pit_scale(emp_cum[j, m] - emp_pit_base[j, m]) - pit_reduction_month, 1, half-up))

def emp_pit_base[j in job, m in month]: money PLN
  rule base v pit_2022 = round(max(0, salary[j, m] - emp_zus[j, m] - kup_month), 1, half-up)

def emp_ytd[j in job, m in month]: money PLN = sum(k in month where year_of(k) = year_of(m) and k < m: salary[j, k])

def emp_zus[j in job, m in month]: money PLN
  note "emerytalna i rentowa do rocznej granicy 30-krotności, chorobowa bez granicy"
  rule base v sus_2026 = round(emp_base_capped[j, m] * ee_rate[pension], 0.01, half-up) + round(emp_base_capped[j, m] * ee_rate[disability], 0.01, half-up) + round(salary[j, m] * ee_rate[sickness], 0.01, half-up)

def pit37_base[p in person, y in tax_year]: money PLN
  rule base v pit_2022 = round(max(0, sum(j in job, m in month where works_for[j] = p and year_of(m) = y: salary[j, m] - emp_zus[j, m] - (if salary[j, m] > 0 then kup_month else 0))), 1, half-up)

def pit37_due[p in person, y in tax_year]: money PLN = pit37_tax[p, y] - sum(j in job, m in month where works_for[j] = p and year_of(m) = y: emp_pit_adv[j, m])

def pit37_tax[p in person, y in tax_year]: money PLN
  rule abroad excepts base, unused v pit_2022 when any(m in month where year_of(m) = y: residence[p, m] != pl) = ? "Zmiana rezydencji podatkowej w roku nie jest opisana (art. 3, umowa o unikaniu podwójnego opodatkowania)."
  rule base v pit_2022 = round(max(0, pit_scale(pit37_base[p, y]) - child_relief[p, y]), 1, half-up)
  rule unused excepts base v pit_2022 when child_relief[p, y] > max(0, pit_scale(pit37_base[p, y])) = ? "Niewykorzystana ulga na dziecko (art. 27f ust. 8): zwrot nie jest opisany."

def relief_months[c in person, y in tax_year]: int = count(m in month where year_of(m) = y and born[c] < end_of(m) and age(born[c], add_days(end_of(m), -1)) < 18)

def zus_cap[y in tax_year]: money PLN
  rule base v sus_2026 = 30 * proj_wage_y[y]

pay pit37_pay[p in person, y in tax_year]
  from konto
  to urzad_skarbowy
  amount pit37_due[p, y]
  on return_day[y]
  for y
  when pit37_due[p, y] > 0

pay pit37_refund[p in person, y in tax_year]
  from urzad_skarbowy
  to konto
  amount -pit37_due[p, y]
  on add_days(return_day[y], refund_days)
  for y
  when pit37_due[p, y] < 0

pay wage[j in job, m in month]
  from pracodawcy
  to konto
  amount emp_net[j, m]
  on next_business(add_months(day_of(m, 10), 1), holidays_pl)
  for m

version pit_2022
  cite pit_act
  governs 2022..
  known 2022-06-24
  kup_month = 250 "art. 22 ust. 2 pkt 1"
  pit_reduction_month = 300 "art. 32 ust. 3"
  relief_limit = 112000 "art. 27f ust. 1 pkt 1 lit. a"
  relief_month = 92.67 "art. 27f ust. 1 pkt 1: 1/6 z 556,02 zł za miesiąc"
  pit_scale: [0, 120000] = x * 0.12 - 3600 "art. 27 ust. 1, pierwszy próg"
  pit_scale: (120000, inf) = 10800 + (x - 120000) * 0.32 "art. 27 ust. 1, drugi próg"

version sus_2026
  cite sus_act
  governs 2026..
  known 2025-12-31
  ee_rate[disability] = 0.015 "art. 22 ust. 1 pkt b, część pracownika"
  ee_rate[pension] = 0.0976 "art. 22 ust. 1 pkt a, część pracownika"
  ee_rate[sickness] = 0.0245 "art. 22 ust. 1 pkt c"
