part pl_business
  tally 1
  law
  note "Jednoosobowa działalność (B2B): ryczałt, składki ZUS przedsiębiorcy (ulga na start, preferencyjne, pełne), zdrowotna na ryczałcie z rozliczeniem rocznym, VAT miesięczny."
  note "Wycinek przykładowy z kwotami prototypu; nie przeszedł bramki."

source ryczalt_act "Ustawa o zryczałtowanym podatku dochodowym od niektórych przychodów (tekst jednolity)"
source vat_act "Ustawa o podatku od towarów i usług (tekst jednolity)"

index form = [ryczalt, scale, linear]

index stage = [inactive, relief, preferential, standard]

index tier = [low, mid, high]

input health_share[t in tier]: num

input pref_share: num

input ryczalt_health_ded: num

input ryczalt_rate: num

input standard_share: num

input vat_rate: num

input zus_due[z in zus_part, s in stage]: bool

input zus_rate[z in zus_part]: num

band health_tier(rev: num PLN): key tier
  note "próg przychodów roku dla składki zdrowotnej na ryczałcie"

def active_months[y in tax_year]: int = count(m in month where year_of(m) = y and zus_stage[m] != inactive)

def health_month[m in month]: money PLN
  note "składka miesięczna według przychodów od początku roku"
  rule base v health_ryczalt_2022 = round(health_rate * health_share[health_tier(rev_ytd[m])] * health_base_y[year_of(m)], 0.01, half-up)

def health_paid[y in tax_year]: money PLN = sum(m in month where year_of(m) = y: flows(health_pay[m], start_of(m)..health_settle_day[y]))

def health_settle[y in tax_year]: money PLN = health_year[y] - health_paid[y]

def health_settle_day[y in tax_year]: date
  rule base v health_ryczalt_2022 = next_business(add_days(add_months(start_of(y), 16), 19), holidays_pl)

def health_year[y in tax_year]: money PLN
  note "rozliczenie roczne: składka miesięczna według przychodów całego roku, razy miesiące działalności"
  rule base v health_ryczalt_2022 = active_months[y] * round(health_rate * health_share[health_tier(revenue_year[y])] * health_base_y[y], 0.01, half-up)

def invoice_gross[c in client, m in month]: money PLN = fee_net[c, m] + vat_out[c, m]

def issue_day[m in month]: date = add_days(end_of(m), -1)

def pay_day[c in client, m in month]: date = next_business(add_days(issue_day[m], terms[c]), holidays_pl)

def pit28_due[y in tax_year]: money PLN = pit28_tax[y] - sum(m in month where year_of(m) = y: flows(ryczalt_pay[m], start_of(m)..return_day[y]))

def pit28_tax[y in tax_year]: money PLN
  rule base v ryczalt_2022 = round(round(max(0, revenue_year[y] - flows(zus_social_pay, y) - flows(health_pay, y) * ryczalt_health_ded), 1, half-up) * ryczalt_rate, 1, half-up)
  rule other_form excepts base v ryczalt_2022 when revenue_year[y] > 0 and tax_form[y] != ryczalt = ? "Zeznanie dla innej formy opodatkowania niż ryczałt nie jest opisane."

def revenue[m in month]: money PLN = sum(c in client: fee_net[c, m])

def revenue_year[y in tax_year]: money PLN = sum(m in month where year_of(m) = y: revenue[m])

def rev_ytd[m in month]: money PLN = sum(k in month where year_of(k) = year_of(m) and k <= m: revenue[k])

def ryczalt_adv[m in month]: money PLN
  note "zaliczka: stawka od przychodu miesiąca po odliczeniu składek społecznych i połowy zdrowotnej zapłaconych w miesiącu"
  rule base v ryczalt_2022 = round(round(max(0, revenue[m] - flows(zus_social_pay, m) - flows(health_pay, m) * ryczalt_health_ded), 1, half-up) * ryczalt_rate, 1, half-up)
  rule other_form excepts base v ryczalt_2022 when revenue[m] > 0 and tax_form[year_of(m)] != ryczalt = ? "Zaliczki dla innej formy opodatkowania niż ryczałt nie są opisane."

def vat_day[m in month]: date
  rule base v vat_2026 = next_business(add_months(day_of(m, 25), 1), holidays_pl)

def vat_due[m in month]: money PLN
  rule base v vat_2026 = round(sum(c in client: vat_out[c, m]) - cost_vat[m], 1, half-up)
  rule surplus excepts base v vat_2026 when sum(c in client: vat_out[c, m]) < cost_vat[m] = ? "Nadwyżka VAT naliczonego: przeniesienie na następny miesiąc czy zwrot (art. 87)?"

def vat_out[c in client, m in month]: money PLN
  rule base v vat_2026 = round(fee_net[c, m] * vat_rate, 0.01, half-up)

def vat_owed[d in day]: money PLN
  note "VAT należny z faktur już zapłaconych przez klientów, a jeszcze nie wpłacony do urzędu: nie nasz"
  rule base = sum(c in client, m in month where fee_net[c, m] > 0 and pay_day[c, m] <= d and vat_day[m] > d: vat_out[c, m])

def zus_base[m in month]: money PLN
  rule nobase v sus_rates_2026 when zus_stage[m] = inactive or zus_stage[m] = relief = 0
  rule pref v sus_rates_2026 when zus_stage[m] = preferential = round(min_wage_y[year_of(m)] * pref_share, 0.01, half-up)
  rule standard v sus_rates_2026 when zus_stage[m] = standard = round(proj_wage_y[year_of(m)] * standard_share, 0.01, half-up)

def zus_social[m in month]: money PLN = sum(z in zus_part where zus_due[z, zus_stage[m]] and (z != sickness or sickness_opt): round(zus_base[m] * zus_rate[z], 0.01, half-up))

pay client_pay[c in client, m in month]
  from klienci
  to konto
  amount invoice_gross[c, m]
  on pay_day[c, m]
  for m
  when fee_net[c, m] > 0

pay health_pay[m in month]
  from konto
  to zus
  amount health_month[m]
  on next_business(add_months(day_of(m, 20), 1), holidays_pl)
  for m
  when zus_stage[m] != inactive

pay health_settle_back[y in tax_year]
  from zus
  to konto
  amount -health_settle[y]
  on health_settle_day[y]
  for y
  when health_settle[y] < 0

pay health_settle_pay[y in tax_year]
  from konto
  to zus
  amount health_settle[y]
  on health_settle_day[y]
  for y
  when health_settle[y] > 0

pay pit28_pay[y in tax_year]
  from konto
  to urzad_skarbowy
  amount pit28_due[y]
  on return_day[y]
  for y
  when pit28_due[y] > 0

pay pit28_refund[y in tax_year]
  from urzad_skarbowy
  to konto
  amount -pit28_due[y]
  on add_days(return_day[y], refund_days)
  for y
  when pit28_due[y] < 0

pay ryczalt_pay[m in month]
  from konto
  to urzad_skarbowy
  amount ryczalt_adv[m]
  on next_business(add_months(day_of(m, 20), 1), holidays_pl)
  for m
  when ryczalt_adv[m] > 0

pay vat_pay[m in month]
  from konto
  to urzad_skarbowy
  amount vat_due[m]
  on vat_day[m]
  for m
  when vat_due[m] > 0

pay zus_social_pay[m in month]
  from konto
  to zus
  amount zus_social[m]
  on next_business(add_months(day_of(m, 20), 1), holidays_pl)
  for m
  when zus_social[m] > 0

version health_ryczalt_2022
  cite health_act
  governs 2022..
  known 2021-11-15
  health_share[high] = 1.8 "art. 81 ust. 2i pkt 3"
  health_share[low] = 0.6 "art. 81 ust. 2i pkt 1"
  health_share[mid] = 1 "art. 81 ust. 2i pkt 2"
  health_tier: [0, 60000] = low "art. 81 ust. 2i pkt 1"
  health_tier: (60000, 300000] = mid "art. 81 ust. 2i pkt 2"
  health_tier: (300000, inf) = high "art. 81 ust. 2i pkt 3"

version ryczalt_2022
  cite ryczalt_act
  governs 2022..
  known 2021-11-15
  ryczalt_health_ded = 0.5 "art. 11 ust. 1c"
  ryczalt_rate = 0.12 "art. 12 ust. 1 pkt 2b"

version sus_rates_2026
  cite sus_act
  governs 2026..
  known 2025-12-31
  pref_share = 0.3 "art. 18a ust. 1"
  standard_share = 0.6 "art. 18 ust. 8"
  zus_due = false "poza wymienionymi niżej"
  zus_due[accident, preferential] = true "art. 12"
  zus_due[accident, standard] = true "art. 12"
  zus_due[disability, preferential] = true "art. 6"
  zus_due[disability, standard] = true "art. 6"
  zus_due[labour_fund, standard] = true "ustawa o rynku pracy, art. 255"
  zus_due[pension, preferential] = true "art. 6"
  zus_due[pension, standard] = true "art. 6"
  zus_due[sickness, preferential] = true "art. 11 ust. 2, dobrowolna"
  zus_due[sickness, standard] = true "art. 11 ust. 2, dobrowolna"
  zus_rate[accident] = 0.0167 "art. 15 ust. 1, stawka dla płatnika do 9 ubezpieczonych"
  zus_rate[disability] = 0.08 "art. 22 ust. 1 pkt b"
  zus_rate[labour_fund] = 0.0245 "ustawa o rynku pracy, art. 255"
  zus_rate[pension] = 0.1952 "art. 22 ust. 1 pkt a"
  zus_rate[sickness] = 0.0245 "art. 22 ust. 1 pkt c"

version vat_2026
  cite vat_act
  governs 2026..
  known 2025-12-31
  vat_rate = 0.23 "art. 146ef ust. 1"
