part asks_core
  tally 2
  note "Zapisane pytania gospodarstwa. Plan zmiany (OPERATIONS §7) porównuje je przed i po."

ask explain_room: explain room[2026-11] in wife_stops law cut

ask health_settlement: health_settle[y] for y in [2026, 2027, 2028] in wife_stops law cut

ask ike_left: ike_limit[y] - flows(invest[ike], y) for y in [2026, 2027, 2028] in wife_stops law cut

ask konto_balance: bal(konto, d) with uncertain, bal(konto, d) with uncertain - vat_owed[d] for d in [2026-10-31, 2026-12-31, 2027-06-30, 2027-12-31] in wife_stops law cut

ask net_worth: sum(bal(x, d) with uncertain for x in places over .. where not x in outside and ((x in accounts or x in cash or x in claims or x in debts) and unit(x) == PLN)) + sum(value(wunits[w], d) in PLN by etf_price[month_of(d)] for w in wrapper) for d in [2026-12-31, 2031-12-31, 2041-12-31, 2059-12-31] in wife_stops law cut

ask pit28: pit28_due[y] for y in [2026, 2027, 2028] in wife_stops law cut

ask pit37: pit37_due[p, y] for p in person over .., y in [2026, 2027, 2028] in wife_stops law cut

ask replay_september: residuals konto 2026-09 law cut

ask social_and_health: zus_social[m], health_month[m] for m in [2026-10, 2027-01, 2028-09] in wife_stops law cut

ask taxes_paid: flows(urzad_skarbowy, y) for y in [2026, 2027, 2028] in wife_stops law cut

ask wife_net: emp_net[wife_acme, m] for m in [2026-10, 2027-01] in wife_stops law cut
