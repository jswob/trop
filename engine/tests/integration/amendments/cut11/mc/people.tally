part people
  tally 2

input born[p in person]: date question "Kiedy urodziła się ta osoba?"

input parent[c in person, k in person]: bool question "Czy ta osoba jest dzieckiem tej drugiej?"

input residence[p in person, m in month]: key country question "W jakim kraju ta osoba mieszka w tym miesiącu?"

input works_for[j in job]: key person

version people_2026
  cite household
  governs always
  known 2025-12-31
  born[me] = 1991-02-14 "dowód osobisty"
  born[wife] = 1992-07-03 "dowód osobisty"
  parent = false "brak dzieci"
  residence = pl governs 2026-01.. "meldunek w Krakowie"
  works_for[wife_acme] = wife "umowa o pracę"
