scenario refund_late over i9
  tally 2
  from 2028-01-15
  note "Outcome: the refund is received on 17 July 2028."

source outcome_late "Card I-9, question: the refund is received on 17 July 2028"

ask credits_late: credit_item[r] for r in foreign_income over 2027 in refund_late

ask tax_2027_late: tax_year[marek, 2027], gains_tax[marek, 2027], tax_year[marek, 2027] + gains_tax[marek, 2027], due_day[2027] in refund_late

ask added_2028_late: added[marek, 2028], due_day[2028] in refund_late

version refund_on_late
  cite outcome_late
  governs 2028-01-15..
  known 2027-01-01
  replace refund_day = 2028-07-17 "the refund is received on 17 July 2028"
