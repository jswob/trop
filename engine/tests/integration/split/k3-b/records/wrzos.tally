part wrzos_records
  tally 2
  note "Bank Wrzos statements of Ola's account LN27 1140 2004 0000 3402 8830 1177: October 2024, February and March 2025, all she kept (story). A ';' CSV with decimal commas (O:B-1), written out whole. The account is seen live: each day's rows are known on their day, one version per day with rows covering that day; the other days of a statement's month are covered by a version known when the statement came (the 2nd of the next month, assumed)."

version wrz_2024_10_rest
  cite wrzos_export
  governs 2024-10
  known 2024-11-02
  assumed "the statement's day is not stated: the 2nd of the next month"
  covers wrzos 2024-10-03..2024-10-06, wrzos 2024-10-09..2024-10-09, wrzos 2024-10-11..2024-10-15, wrzos 2024-10-17..2024-10-20, wrzos 2024-10-26..2024-10-27, wrzos 2024-10-30..2024-10-30
  anchor wrzos
  stated[wrzos] = 4127.55 DUK at 2024-10-01 start "wrz-ola-2024-10.csv line 5 Opening balance"

version wrz_2024_10_01
  cite wrzos_export
  governs 2024-10-01
  known 2024-10-01
  covers wrzos
  anchor wrzos
  wrzr[w20241001a] = (on: 2024-10-01, kind: card_pays, leg cash from wrzos to shops amount 30.49 DUK) "wrz-ola-2024-10.csv line 7 CARD PAYMENT Sklep Jagoda Kłodzin card ...1177"
  stated[wrzos] = 4097.06 DUK at 2024-10-01 end "wrz-ola-2024-10.csv line 7 Balance after"

