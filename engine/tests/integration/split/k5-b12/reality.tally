source house_rules "Household B's house rules B-HR1 – B-HR6 (tmp/cases/B/house-rules.md)"

source lazur_export "Bank Lazur export, floren account LN88 1020 0044 8813 FLR (tmp/cases/B/records/laz-8813-flr-2025.csv)"

source market "Market data: Bank Lazur's exchange table and DUKOR 6M fixings (tmp/cases/market/lazur-fx-flr.csv, dukor.csv)"

source modeller "Assumptions of this model, each with its reason"

source questions "Household B's questions and their answer rules (tmp/cases/B/questions.md)"

source story "Household B's own account, with known dates (tmp/cases/B/story.md)"

source wrzos_export "Bank Wrzos statements of Ola's account LN27 1140 2004 0000 3402 8830 1177 (tmp/cases/B/records/wrz-ola-*.csv)"

kind persons

kind cars

kind owed: place DUK signed
  note "what a client owes on one invoice. Signed, not claims (min 0): an invoice issued and paid on one day (FV 019/2025) books the observed payment and the planned invoice with no order between them (L §5.14.2: observations and plans come first), and claims refuses the leg that takes it below 0 within the day (RUN-PLACE); S:321"

kind card_pays: transfers
  note "a card payment on a statement"

kind card_refunds: transfers
  note "a card payment given back by the shop"

kind friend_backs: transfers
  note "a friend's half of a shared bill, paid back"

kind reversals: transfers
  note "a payment taken back by the payer's bank"

kind fx_credits: transfers
  note "dukats credited from a sale of florens at another bank"

kind fx_sales: transfers
  attr inv: key flr_invoices
  note "a sale of florens from the floren account, Piotr's own order; inv names the invoice whose florens it sells"

kind promises: transfers uncertain
  note "money promised to us on a day, not yet paid"

index bartek_parts: open

index buy_kinds = [laptop, car, fuel, monitor]

index buys: open

index car_uses = [business_only, mixed]

index clients = [arnika, arnika_delta, studio_bez, pracownia_ul, kawiarnia_ziarno, kessel, auto_mlecz]
  note "the clients named in the sales register; nothing about them is modelled but their names"

index flr_fates = [sold, kept, unpaid]

index flr_invoices: open

index invoices: open

index jodla_kinds = [instalment, overpayment]

index jodla_rows: open

index loan_days = day 2022-03-01..2048-12-31
  note "the mortgage's days, past the run's end, for its schedule (B-D07)"

index loan_months = month 2022-03..2048-12
  note "the mortgage's months, past the run's end, for its schedule (B-D07)"

index owed_statuses = [not_yet_due, promised, expected, missed]

version cast
  cite story
  known 2022-03-01
  note "The cast table (story.md lines 7-12), stated from the model's start (L §4.5: the case's own stipulations)."
  persons + [piotr] lives 1987-11-03..
  persons + [ola] lives 1990-06-21..

version car_bought
  cite b_d11
  known 2023-03-15
  cars + [ln4471k] lives 2023-03-15..

version car_sold
  cite b_d15
  known 2025-09-12
  replace cars + [ln4471k] lives 2023-03-15..2025-09-12
