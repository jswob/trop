  spend_amt[k9] = 9 "column head $9.0"
  spend_amt[k10] = 10 "column head $10.0"
  spend_amt[w20] = 1 "p. 94: intends to consume $1 after inflation a year"
  spend_amt[b40k] = 40000 "p. 95, text below Table 2: $40,000"
  spend_amt[b50k] = 50000 "p. 95, text below Table 2: $50,000"
  spend_amt[b60k] = 60000 "p. 94: $60,000 a year"
  spend_amt[b90k] = 90000 "p. 95, text below Table 2: $90,000"
  wealth[k2] = 100 "Tables 2 and 3: spending per $100 of initial nest egg"
  wealth[k3] = 100 "per $100"
  wealth[k4] = 100 "per $100"
  wealth[k5] = 100 "per $100"
  wealth[k6] = 100 "per $100"
  wealth[k7] = 100 "per $100"
  wealth[k8] = 100 "per $100"
  wealth[k9] = 100 "per $100"
  wealth[k10] = 100 "per $100"
  wealth[w20] = 20 "p. 94: w = 20, $20 per $1 of consumption"
  wealth[b40k] = 1000000 "p. 94: a $1,000,000 nest egg"
  wealth[b50k] = 1000000 "p. 94: a $1,000,000 nest egg"
