  wealth[b90k] = 1000000 "p. 94: a $1,000,000 nest egg"

version kalas2014_v
  cite kalas2014
  governs always
  known 2014-11-21
  note "No rows: it is the version eventual's base rule points at, so the slides' formula for eventual ruin is cited and the source is read (§5.3)"
  note "known: the date on the slides, 21 November 2014 (§4.5)"
