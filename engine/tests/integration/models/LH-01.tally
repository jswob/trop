model lh01
  tally 2
  on 2026-10-18
  start 2026-01-01
  end 2026-12-31
  note "US wash sales, IRC 1091: Publication 550 (2025) situations A to E, and the examples of 26 CFR 1.1091-1(h) and 26 CFR 1.1091-2(a)."
  note "Each worked situation is a key of sit. Its purchases are keys of lot, in order of acquisition; its sales are keys of sale, in order of disposition."
  note "A loss is matched with replacement lots of the same situation bought within the window, earliest acquisition first (26 CFR 1.1091-1(c), (d)), by the fill wash, which cites that order (version cfr1091_1_order)."

source cfr1091_1 "26 CFR 1.1091-1, Losses from wash sales of stock or securities (eCFR), retrieved 2026-10-18" at "https://www.ecfr.gov/current/title-26/section-1.1091-1"

source cfr1091_2 "26 CFR 1.1091-2, Basis of stock or securities acquired in wash sales (eCFR), retrieved 2026-10-18" at "https://www.ecfr.gov/current/title-26/section-1.1091-2"

source modeller "The modeller's wiring: not-applicable defaults for the per-share and stated-figure inputs, which no source states"

source pub550 "IRS Publication 550 (2025), Investment Income and Expenses, chapter 4, Wash Sales" at "https://www.irs.gov/pub/irs-pdf/p550.pdf"

source usc1091 "26 U.S. Code 1091, Loss from wash sales of stock or securities (LII), retrieved 2026-10-18" at "https://www.law.cornell.edu/uscode/text/26/1091"

unit USD: currency minor 0.01

unit shr "share of stock"

index lot = [a_old, a_new, b_sep, b_dec13, b_dec20, c_sep, c_feb3, c_feb4, c_feb5, c_feb6, d_b1, d_b2, d_b3, d_jan10, e_jun4, e_oct16, x1_dec1, x1_dec15, x2_sep21, x2_dec21, x2_dec27, x3_sep15, x3_feb15, x3_feb16, x3_feb17, x3_feb18, y1_old, y1_new, y2_old, y2_new]

index sale = [a_s, b_s, c_s, d_s1, d_s2, d_s3, e_s, x1_s, x2_s, x3_s, y1_s, y2_s]

index sit = [pa, pb, pc, pd, pe, x1, x2, x3, y1, y2]

input acq_on[l in lot]: date

input lot_cost[l in lot]: money USD

input lot_px[l in lot]: num USD/shr

input lot_sh[l in lot]: num shr

input lot_sit[l in lot]: key sit

input sale_amt[s in sale]: money USD

input sale_on[s in sale]: date

input sale_px[s in sale]: num USD/shr

input sale_sh[s in sale]: num shr

input sold_lot[s in sale]: key lot

input stated_loss[s in sale]: money USD

input stated_within[s in sale, l in lot]: bool

input window_days: int

def added[l in lot]: num USD = sum(wash.taken[s, l] * loss_ps[s] for s in sale where lot_sit[sold_lot[s]] == lot_sit[l]) at reader

def basis[l in lot]: num USD = cost[l] + added[l] at reader

def basis_d[l in lot]: num USD = cost[l] + sum(wash.taken[s, l] * (sold_cost[s] - proceeds[s]) / sale_sh[s] for s in sale where lot_sit[sold_lot[s]] == lot_sit[l]) at reader

def cost[l in lot]: num USD at reader
  rule base = lot_cost[l]
  rule per_share beats base = lot_px[l] * lot_sh[l] when lot_px[l] != none

def deductible[s in sale]: num USD = loss[s] - disallowed[s] at reader

def disallowed[s in sale]: num USD = loss_ps[s] * sum(wash.taken[s, l] for l in lot) at reader

def in_window[s in sale, l in lot]: bool at reader
  rule base = days_between(acq_on[l], sale_on[s]) <= window_days and days_between(sale_on[s], acq_on[l]) <= window_days
  rule stated beats base = stated_within[s, l] when stated_within[s, l] != none

def loss[s in sale]: num USD at reader
  rule base = max(0, sold_cost[s] - proceeds[s])
  rule stated beats base = stated_loss[s] when stated_loss[s] != none

def loss_ps[s in sale]: num USD/shr = loss[s] / sale_sh[s] at reader

def proceeds[s in sale]: num USD at reader
  rule base = sale_amt[s]
  rule per_share beats base = sale_px[s] * sale_sh[s] when sale_px[s] != none

def sold_cost[s in sale]: num USD = cost[sold_lot[s]] * sale_sh[s] / lot_sh[sold_lot[s]] at reader

fill wash
  v cfr1091_1_order
  supply sale_sh[s] for s in sale
  demand lot_sh[l] for l in lot
  arc lot_sit[l] == lot_sit[sold_lot[s]] and l != sold_lot[s] and loss[s] > 0 and in_window[s, l]
  order s, l ties by (pos(s), pos(l))

ask a_basis_new: basis[a_new] law 2026-10-18

ask a_disallowed: disallowed[a_s] law 2026-10-18

ask b_added_dec13: added[b_dec13] law 2026-10-18

ask b_basis_dec13: basis[b_dec13] law 2026-10-18

ask b_basis_dec20: basis[b_dec20] law 2026-10-18

ask b_deductible: deductible[b_s] law 2026-10-18

ask b_disallowed: disallowed[b_s] law 2026-10-18

ask b_loss: loss[b_s] law 2026-10-18

ask c_added_feb3: added[c_feb3] law 2026-10-18

ask c_added_feb4: added[c_feb4] law 2026-10-18

ask c_disallowed: disallowed[c_s] law 2026-10-18

ask d_disallowed_ps: disallowed[d_s1] / sale_sh[d_s1] law 2026-10-18

ask e_disallowed: disallowed[e_s] law 2026-10-18

ask x1_deductible: deductible[x1_s] law 2026-10-18

ask x2_basis_dec21: basis_d[x2_dec21] law 2026-10-18

ask x2_basis_dec27: basis_d[x2_dec27] law 2026-10-18

ask x2_deductible: deductible[x2_s] law 2026-10-18

ask x2_disallowed: disallowed[x2_s] law 2026-10-18

ask x3_matched: wash.taken[x3_s, l] for l in lot where lot_sit[l] == x3 law 2026-10-18

ask y1_basis_new: basis_d[y1_new] law 2026-10-18

ask y2_basis_new: basis_d[y2_new] law 2026-10-18

version usc1091_a
  cite usc1091
  governs always
  known 1954-08-16
  note "Law is known from its enactment (LANGUAGE §4.5). The 30-day window of subsection (a) is in the Internal Revenue Code of 1954 (Aug. 16, 1954, ch. 736, 68A Stat. 319), as the section's history on LII gives it; the later amendments of (a) listed there (Pub. L. 98-369, 1984; Pub. L. 100-647, 1988) don't change the window."
  window_days = 30 "subsection (a): a period beginning 30 days before the date of such sale and ending 30 days after such date"

version cfr1091_1_order
  cite cfr1091_1
  governs always
  known 1967-08-09
  note "Paragraphs (b) to (d): losses are taken in order of disposition, and shares are matched in order of acquisition, beginning with the earliest acquisition. The fill wash cites this version; it has no rows."
  note "The section's source note on eCFR: T.D. 6500, 25 FR 11910, Nov. 26, 1960, as amended by T.D. 6926, 32 FR 11468, Aug. 9, 1967. Which paragraphs T.D. 6926 changed wasn't checked, so the later publication is taken as the known date, and no view sees the rule too early."

version cfr1091_1_h
  cite cfr1091_1
  governs always
  known 2026-10-18
  note "Paragraph (h), Examples 1 to 3. Example 2 repeats Pub situation B with 1954-55 dates; Example 3 prices Pub situation C."
  note "The examples are hypothetical: their figures are stipulations, known from the model's on (LANGUAGE §4.5)."
