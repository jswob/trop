version wiring
  cite modeller
  governs always
  known 2026-10-18
  note "Not-applicable defaults that stand for the cases' own facts, so they take the stipulations' known date, the model's on (LANGUAGE §4.5)."
  lot_px = none "a lot has a per-share price only where the source gives one"
  sale_px = none "a sale has a per-share price only where the source gives one"
  stated_loss = none "a loss is stated as a fact only where the source gives no prices"
  stated_within = none "the window is stated as a fact only where the source gives no dates"
