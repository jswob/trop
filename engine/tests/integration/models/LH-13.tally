model lh13
  tally 2
  on 2026-10-18
  start 2026-01-01
  end 2026-12-31
  note "US Social Security, 2026: PIA bend points, indexing, highest-35 AIME, PIA with COLAs, early reduction and delayed credits. SSA OACT worked cases A and B, and the maximum-taxable earner retiring in January 2026."
  note "Known dates (§4.5): law rows from the approval of the act that enacted them; the SSA pages, which carry no updated stamp, from their retrieval date 2026-10-18; the worked cases' stipulations and the modeller's stand-ins for them from on, the same day. Each version's note says which."

source lifted_1_0_1 "Figures tally 1.0.1 allowed inline in rules"

source modeller "The modeller's readings of figures the case does not print, each stated with its reason"

source pl87_64 "Social Security Amendments of 1961, Pub. L. 87-64, 75 Stat. 131, approved June 30, 1961" at "https://uscode.house.gov/statutes/pl/87/64.pdf"

source pl95_216 "Social Security Amendments of 1977, Pub. L. 95-216, 91 Stat. 1509, approved December 20, 1977" at "https://uscode.house.gov/statutes/pl/95/216.pdf"

source pl98_21 "Social Security Amendments of 1983, Pub. L. 98-21, 97 Stat. 65, approved April 20, 1983" at "https://uscode.house.gov/statutes/pl/98/21.pdf"

source ssa_awi "SSA OACT, National Average Wage Index (Wayback capture 2026-10-17)" at "https://web.archive.org/web/20261017153502id_/https://www.ssa.gov/oact/COLA/AWI.html"

source ssa_cola "SSA OACT, Cost-Of-Living Adjustments series (Wayback capture 2026-10-17)" at "https://web.archive.org/web/20261017153547id_/https://www.ssa.gov/oact/COLA/colaseries.html"

source ssa_examplemax "SSA OACT, Workers with Maximum-Taxable Earnings (Wayback capture 2026-09-28)" at "https://web.archive.org/web/20260928203858id_/https://www.ssa.gov/oact/COLA/examplemax.html"

source ssa_nra "SSA OACT, Normal Retirement Age (Wayback capture 2026-10-10)" at "https://web.archive.org/web/20261010113840id_/https://www.ssa.gov/oact/progdata/nra.html"

source ssa_rb1 "SSA OACT, Benefit Calculation Examples for Workers Retiring in 2026, page 1 (Wayback capture 2026-09-28)" at "https://web.archive.org/web/20260928232848id_/https://www.ssa.gov/oact/progdata/retirebenefit1.html"

source ssa_rb2 "SSA OACT, Benefit Calculation Examples for Workers Retiring in 2026, page 2 (Wayback capture 2026-10-13)" at "https://web.archive.org/web/20261013082425id_/https://www.ssa.gov/oact/progdata/retirebenefit2.html"

unit USD: currency minor 0.01

axis index_cut
  dollar "each indexed amount rounded to the whole dollar, as retirebenefit1 prints it"
  exact "indexed amounts kept exact; the page states no rounding"
  penny "each indexed amount rounded to the nearer penny, 20 CFR 404.211(d)(3)"

index tier = [t1, t2, t3]

index worker = [case_a, case_b, max62, max65, max66, max67, max70]

index yr = int 1977..2026

input aime_calc_12: int
  note "lifted from an inline figure of tally 1.0.1"

input at_max[w in worker]: bool
  note "true where the source states the worker's earnings only as 'at the maximum taxable', with no yearly amounts; they are then the year's contribution and benefit base"

input awi[y in yr]: num USD question "National average wage index for this year: the case transcribes AWI.html rows 1977 and 1986 onward only"

input benefit_year: key yr

input bp1_1979: money USD

input bp2_1979: money USD

input cbb[y in yr]: money USD question "Contribution and benefit base for this year: the case fetched no base series, and retirebenefit1 gives it only for 1986-2025, through case B"

input claim_age[w in worker]: (yrs int, mos int)

input claim_months_12: int
  note "lifted from an inline figure of tally 1.0.1"

input cola[y in yr]: num question "COLA effective December of this year: the case gives colaseries rows 2021-2026 only"

input drc_end_age: int

input drc_pct: num

input early_cut: int

input early_pct_1: num

input early_pct_2: num

input earn[w in worker, y in yr]: money USD question "Covered earnings of this worker in this year: not in the case"

input earn_from[w in worker]: key yr

input earn_to[w in worker]: key yr

input elig_year[w in worker]: key yr

input idx_factor_2: int
  note "lifted from an inline figure of tally 1.0.1"

input increase_0_1: money USD
  note "lifted from an inline figure of tally 1.0.1"

input months_late_12: int
  note "lifted from an inline figure of tally 1.0.1"

input n_comp: int

input nra[w in worker]: (yrs int, mos int)

input nra_months_12: int
  note "lifted from an inline figure of tally 1.0.1"

input pia_0_1: money USD
  note "lifted from an inline figure of tally 1.0.1"

input pia_pct[t in tier]: num

input reduction_0_1: money USD
  note "lifted from an inline figure of tally 1.0.1"

def aime[w in worker]: money USD at reader
  note "the AIME the benefit uses: aime_calc, unless a source prints the AIME (the maximum-taxable earners' AIMEs are givens from examplemax)"
  rule base = aime_calc[w]

def aime_calc[w in worker]: money USD = round(total35[w] / (aime_calc_12 * n_comp), 1, down) at reader

def benefit[w in worker]: money USD = round(pia_now[w] - reduction[w] + increase[w], 1, down) at reader

def bp1[y in yr]: money USD = round(bp1_raw[y], 1, half-up) at reader

def bp1_raw[y in yr]: num USD = bp1_1979 * awi[y - 2] / awi[1977] at reader

def bp2[y in yr]: money USD = round(bp2_raw[y], 1, half-up) at reader

def bp2_raw[y in yr]: num USD = bp2_1979 * awi[y - 2] / awi[1977] at reader

def claim_months[w in worker]: int = claim_age[w].yrs * claim_months_12 + claim_age[w].mos at reader

def earnings[w in worker, y in yr]: money USD at reader
  note "covered earnings: the printed row, or the year's contribution and benefit base for a worker stated only as earning the maximum taxable"
  rule at_max beats base = cbb[y] when at_max[w]
  rule base = earn[w, y]

def formula[w in worker]: num USD = pia_pct[t1] * min(aime[w], bp1[elig_year[w]]) + pia_pct[t2] * max(0, min(aime[w], bp2[elig_year[w]]) - bp1[elig_year[w]]) + pia_pct[t3] * max(0, aime[w] - bp2[elig_year[w]]) at reader

def idx_factor[w in worker, y in yr]: num = if y >= elig_year[w] - idx_factor_2 then 1 else awi[elig_year[w] - idx_factor_2] / awi[y] at reader

def increase[w in worker]: money USD = round(pia_now[w] * drc_pct * months_late[w], increase_0_1, down) at reader

def indexed[w in worker, y in yr]: num USD at reader
  note "earnings times the indexing factor, §215(b)(3); whether the product is rounded is a reading"
  rule base = earnings[w, y] * idx_factor[w, y]
  rule dollar beats base = round(earnings[w, y] * idx_factor[w, y], 1, half-up) when index_cut == dollar
  rule penny beats base = round(earnings[w, y] * idx_factor[w, y], minor(USD), half-up) when index_cut == penny

def months_early[w in worker]: int = max(0, nra_months[w] - claim_months[w]) at reader

def months_late[w in worker]: int = max(0, min(claim_months[w], drc_end_age * months_late_12) - nra_months[w]) at reader

def nra_months[w in worker]: int = nra[w].yrs * nra_months_12 + nra[w].mos at reader

def pia[w in worker, y in yr]: money USD at reader
  note "the PIA payable for January to November of year y: the formula result of the year of first eligibility rounded down to the dime, then each December COLA of the years before y, rounded down to the dime each time (§215(a)(1)(A), §215(i)(2)(A)(ii))"
  rule base = round(formula[w], pia_0_1, down) when y == elig_year[w]
  rule cola_step = round(pia[w, y - 1] * (1 + cola[y - 1]), pia_0_1, down) when y > elig_year[w]

def pia_now[w in worker]: money USD = pia[w, benefit_year] at reader

def rank[w in worker, y in yr]: int = 1 + count(z in yr where z >= earn_from[w] and z <= earn_to[w] and (indexed[w, z] > indexed[w, y] or indexed[w, z] == indexed[w, y] and z < y)) at reader

def red_frac[w in worker]: num = early_pct_1 * min(months_early[w], early_cut) + early_pct_2 * max(0, months_early[w] - early_cut) at reader

def reduction[w in worker]: money USD = round(pia_now[w] * red_frac[w], reduction_0_1, up) at reader

def total35[w in worker]: num USD = sum(indexed[w, y] for y in yr where y >= earn_from[w] and y <= earn_to[w] and rank[w, y] <= n_comp) at reader

ask aimes: aime[w] for w in [case_a, case_b] law 2026-10-18

ask benefits: benefit[w] for w in [case_a, case_b] law 2026-10-18

ask bp_2021: bp1[2021], bp2[2021] law 2026-10-18

ask bp_2026: bp1[2026], bp2[2026] law 2026-10-18

ask bp_raw_2026: bp1_raw[2026], bp2_raw[2026] law 2026-10-18

ask chain_b: pia[case_b, y] for y in [2021, 2022, 2023, 2024, 2025, 2026] law 2026-10-18

ask dropped: indexed[w, y] for w in [case_a, case_b], y in yr where y >= earn_from[w] and y <= earn_to[w] and rank[w, y] > n_comp law 2026-10-18

ask formulas: formula[w] for w in [case_a, case_b] law 2026-10-18

ask indexing: idx_factor[w, y], indexed[w, y] for w in [case_a, case_b], y in yr where y >= earn_from[w] and y <= earn_to[w] law 2026-10-18

ask max_aime: aime_calc[w] for w in [max62, max65, max66, max67, max70] law 2026-10-18

ask max_benefits: benefit[w] for w in [max62, max65, max66, max67, max70] law 2026-10-18

ask months_a: months_early[case_a] law 2026-10-18

ask pias: pia_now[w] for w in [case_a, case_b] law 2026-10-18

ask reduction_60: red_frac[case_a] / 1 % law 2026-10-18

ask totals: total35[w] for w in [case_a, case_b] law 2026-10-18

version lifted_figures
  cite lifted_1_0_1
  governs always
  known 1961-06-30
  aime_calc_12 = 12 "inline in tally 1.0.1: aime_calc line 83, factor"
  claim_months_12 = 12 "inline in tally 1.0.1: claim_months line 95, factor"
  idx_factor_2 = 2 "inline in tally 1.0.1: idx_factor line 104, operand"
  increase_0_1 = 0.1 "inline in tally 1.0.1: increase line 106, round step"
  months_late_12 = 12 "inline in tally 1.0.1: months_late line 116, factor"
  nra_months_12 = 12 "inline in tally 1.0.1: nra_months line 118, factor"
  pia_0_1 = 0.1 "inline in tally 1.0.1: pia line 122, round step; pia line 123, round step"
  reduction_0_1 = 0.1 "inline in tally 1.0.1: reduction line 131, round step"

version pl87_64_v
  cite pl87_64
  governs always
  known 1961-06-30
  note "known: the Act's approval date (law from promulgation, §4.5), from the slip law at uscode.house.gov. The 5/9-of-1-percent monthly reduction was first enacted for women by the Social Security Amendments of 1956 (Pub. L. 84-880, approved 1956-08-01); this Act extended reduced benefits at 62 to men, so the row holds for every worker from it. SSA's compilation of §202 (Wayback capture 2026-10-05) is the locator only (§5.3)"
  early_pct_1 = 1/180 "§202(q)(1)(A), 5/9 of 1 percent per month (SSA compilation of §202)"

version pl95_216_v
  cite pl95_216
  governs always
  known 1977-12-20
  note "known: the Act's approval date (law from promulgation, §4.5). Its Title II rewrote §215(a): the 1979 bend points and the 90/32/15 percent formula. SSA's compilation of §215 (Wayback capture 2026-06-16) is the locator only (§5.3)"
  bp1_1979 = 180 "§215(a)(1)(B)(i), '$180 and $1,085, respectively' (SSA compilation of §215)"
  bp2_1979 = 1085 "§215(a)(1)(B)(i)"
  pia_pct[t1] = 0.9 "§215(a)(1)(A)(i), 90 percent"
  pia_pct[t2] = 0.32 "§215(a)(1)(A)(ii), 32 percent"
  pia_pct[t3] = 0.15 "§215(a)(1)(A)(iii), 15 percent"

version pl98_21_v
  cite pl98_21
  governs always
  known 1983-04-20
  note "known: the Act's approval date (law from promulgation, §4.5). It added the 5/12-of-1-percent reduction beyond 36 months (§202(q)(9), Sec. 201(b) of the Act), phased the delayed retirement credit up to 2/3 of 1 percent a month (§202(w)(6), Sec. 114) and moved the age at which credits stop from 72 to 70 (SSA POMS RS 00615.693: 'The 1983 Amendments changed the age at which delayed retirement credits (DRC) stopped'). SSA's compilation of §202 (Wayback capture 2026-10-05) is the locator only (§5.3)"
  drc_end_age = 70 "§202(w)(2)(A), months 'prior to the month in which such individual attained age 70' (SSA compilation of §202)"
  drc_pct = 1/150 "§202(w)(6)(D), 2/3 of 1 percent, first eligible after 2004"
  early_cut = 36 "§202(q)(9)(A), the first 36 months"
  early_pct_2 = 1/240 "§202(q)(9)(A), five-twelfths of 1 percent for any additional months"

