version examplemax_v
  cite ssa_examplemax
  governs always
  known 2026-10-18
  note "known: the page carries no updated stamp, so its retrieval date (§4.5); the worker it stipulates would be known from on, the same day"
  given aime[max62] = 14358 "table 'Worker with steady earnings at the maximum level since age 22', row 2026, 'Retirement at age 62 a', AIME"
  given aime[max65] = 12602 "row 2026, 'Retirement at age 65 b', AIME"
  given aime[max66] = 11724 "row 2026, 'Retirement at age 66 c', AIME"
  given aime[max67] = 11463 "row 2026, 'Retirement at age 67 d', AIME"
  given aime[max70] = 10593 "row 2026, 'Retirement at age 70 e', AIME"
  at_max[max62..max70] = true "table title, 'Worker with steady earnings at the maximum level since age 22'"
  claim_age[max62] = (yrs: 62, mos: 1) "footnote a, exact age 62 and 1 month, retirement in January 2026"
  claim_age[max65] = (yrs: 65, mos: 0) "footnote b, exact age 65 and 0 months"
  claim_age[max66] = (yrs: 66, mos: 0) "footnote c, exact age 66 and 0 months"
  claim_age[max67] = (yrs: 67, mos: 0) "footnote d, exact age 67 and 0 months"
  claim_age[max70] = (yrs: 70, mos: 0) assumed "footnote e says only retirement at age 70; read as 70 and 0 months" "footnote e"

version modeller_v
  cite modeller
  governs always
  known 2026-10-18
  note "known: the modeller's stand-ins for facts of the stipulated workers take the stipulations' date, on (§4.5)"
  earn_from[max62] = 1986 assumed "since age 22; age 62 in 2026 read as age 22 in 1986" "examplemax table title, 'since age 22'"
  earn_from[max65] = 1983 assumed "since age 22; age 62 in 2023 read as age 22 in 1983" "examplemax table title"
  earn_from[max66] = 1982 assumed "since age 22; age 62 in 2022 read as age 22 in 1982" "examplemax table title"
  earn_from[max67] = 1981 assumed "since age 22; age 62 in 2021 read as age 22 in 1981" "examplemax table title"
  earn_from[max70] = 1978 assumed "since age 22; age 62 in 2018 read as age 22 in 1978" "examplemax table title"
  earn_to[max62..max70] = 2025 assumed "retirement in January 2026; the last computation year read as 2025, the year before entitlement, as in retirebenefit1" "examplemax footnotes a-e"
  elig_year[max62] = 2026 assumed "examplemax prints no birth date; the transcriber's reading that reproduces the row: age 62 reached in 2026" "case notes, max-earner checks, age 62"
  elig_year[max65] = 2023 assumed "examplemax prints no birth date; age 65 in January 2026 read as age 62 in 2023" "case notes, age 65"
  elig_year[max66] = 2022 assumed "age 66 in January 2026 read as age 62 in 2022" "case notes, age 66"
  elig_year[max67] = 2021 assumed "age 67 in January 2026 read as age 62 in 2021, as case B" "case notes, age 67"
  elig_year[max70] = 2018 assumed "age 70 in January 2026 read as age 62 in 2018" "case notes, age 70 not checked"
  nra[max62] = (yrs: 67, mos: 0) assumed "examplemax prints no NRA; born 1963-64, NRA 67, the transcriber's reading" "case notes, age 62"
  nra[max65] = (yrs: 67, mos: 0) assumed "examplemax prints no NRA; born 1960-61, NRA 67" "case notes, age 65"
  nra[max66] = (yrs: 67, mos: 0) assumed "examplemax prints no NRA; born 1960, NRA 67" "case notes, age 66"
  nra[max67] = (yrs: 66, mos: 10) assumed "examplemax prints no NRA; born 1959, NRA 66 and 10 months" "case notes, age 67"
  nra[max70] = (yrs: 66, mos: 4) assumed "examplemax prints no NRA; born January 1956 read, so age 62 in 2018 and §216(l)(3)(B) gives 66 and 4 months (24 months from January 2017 times two-twelfths)" "case notes, age 70 not checked"

