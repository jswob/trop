  q130_s_0_0001 = 0.0001 "inline in tally 1.0.1: q130_s line 106, round step"
  q130_s_12 = 12 "inline in tally 1.0.1: q130_s line 105, factor; q130_s line 106, factor"
  q133_a_left_0_0001 = 0.0001 "inline in tally 1.0.1: q133_a_left line 110, round step"
  q133_n_12 = 12 "inline in tally 1.0.1: q133_n line 128, factor"
  q133_x_0_00001 = 0.00001 "inline in tally 1.0.1: q133_x line 139, round step"
  q60_gap_12 = 12 "inline in tally 1.0.1: q60_gap line 147, factor"
  q60_n_12 = 12 "inline in tally 1.0.1: q60_n line 153, factor"
  q60_newpv_12 = 12 "inline in tally 1.0.1: q60_newpv line 157, factor"
  q87_i_0_0001 = 0.0001 "inline in tally 1.0.1: q87_i line 175, round step"
  q89_j_0_0001 = 0.0001 "inline in tally 1.0.1: q89_j line 190, round step"
  q89_n_12 = 12 "inline in tally 1.0.1: q89_n line 196, factor"

version v_soa_s
  cite soa_s
  governs always
  known 2022-10-31
  note "A source with no date of its own, dated only by a month, takes the month's last day (LANGUAGE 4.5): the edition's update history ends October 2022, and the solutions print no other date. Retrieved 2026-10-18. The method of Solutions 60 (p. 18), 87 (p. 25), 89 (p. 26), 130 (p. 37) and 133 (p. 38): the prospective balance, the loan accumulated to time 2 before the first payment (87), the extra payments valued at the equivalent annual effective rate (89), the first two years' balance carried at 8% (130), and the intermediates the solutions print rounded and reuse."

version v_soa_q
  cite soa_q
  governs always
  known 2026-10-18
  note "The questions' data are a hypothetical case's stipulations, known from the model's on date, as it has no start (LANGUAGE 4.5). Retrieved 2026-10-18; PDF metadata: created 10 Oct 2022. Page numbers of this mirror."
