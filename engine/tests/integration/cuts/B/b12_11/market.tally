part market
  tally 2
  note "Market data the asks read (tmp/cases/market): DUKOR 6M fixings (yearly rates), for the mortgage's resets (B-D07 .2), and Bank Lazur's exchange table, the buy rate for florens (B-D23 §4). The files are CSVs with a title line, ';' and decimal commas (O:B-1), so only the days read are written out. Each figure is published on its own day, so each row is known on its day."

input dukor_6m[d in days]: rate question "What is the DUKOR 6M fixing of this day, a yearly rate (B-D07 .2)?"

input lazur_buy[d in days]: num DUK/FLR question "What is Bank Lazur's buy rate for florens on this day (B-D23 §4)?"

version dukor_6m_rows
  cite market
  governs always
  known 2022-03-17
  dukor_6m[2022-03-17] = 4.52 %/year known 2022-03-17 "dukor.csv line 309"
  dukor_6m[2022-06-30] = 7.01 %/year known 2022-06-30 "dukor.csv line 382"
  dukor_6m[2022-12-30] = 7.22 %/year known 2022-12-30 "dukor.csv line 509"
  dukor_6m[2023-06-30] = 6.96 %/year known 2023-06-30 "dukor.csv line 635"
  dukor_6m[2023-12-29] = 5.86 %/year known 2023-12-29 "dukor.csv line 761"
  dukor_6m[2024-06-28] = 5.84 %/year known 2024-06-28 "dukor.csv line 887"
  dukor_6m[2024-12-31] = 5.82 %/year known 2024-12-31 "dukor.csv line 1014"
  dukor_6m[2025-06-30] = 5.07 %/year known 2025-06-30 "dukor.csv line 1138"
  dukor_6m[2025-12-31] = 4.28 %/year known 2025-12-31 "dukor.csv line 1266"

