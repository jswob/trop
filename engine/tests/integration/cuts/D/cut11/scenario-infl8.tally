scenario infl8 over cpi103
  tally 2
  from 2027-01-01
  note "D-11: prices rise 8 % a year in 2027, 2028 and 2029, and 3 % again after; the CPI-YY of the months of 2027-2029 taken as 108."

version infl8_rows
  cite modeller
  governs 2027..2029
  known 2026-09-30
  replace cpi_yy = 108 assumed "D-11: CPI-YY 108 for the months of 2027-2029, with the 8 % years"
  replace lv_infl = 0.08 assumed "D-11: prices rise 8 % a year in 2027, 2028 and 2029"
