part tax
  tally 2
  note "D-04 and D-08: Halina's PIT on her pensions (PIT-2, PIT-3, PIT-4, PIT-5) and on the rent (PIT-13)."

input return_by: monthday question "On which day of the next year is the yearly return due (PIT-5 .1, PIT-13 .4)?"

input sio_adv_stated[y in year]: money DUK question "What advances does the SIO's yearly statement show for this year?"

input sio_paid_stated[y in year]: money DUK question "What pensions does the SIO's yearly statement show paid this year?"

input sio_reducing: bool question "Did the SIO apply 1/12 of the reducing amount to each advance this year (a reducing statement on file, PIT-4 .2)?"

def adv_base[m in month]: money DUK at start_of(m)
  note "PIT-4 .1: the month's base from the SIO, rounded to whole dukats; a pension bears no PIT-2 costs"
  rule base = round(sio_in[m], 1, half-up)

def bond_interest_stated: bool = not tsb8_final at reader

def pen_adv[m in month]: money DUK at start_of(m)
  note "PIT-4 v2 .2: the scale on the year's bases to date less the scale on the earlier ones, less 1/12 of the reducing amount, never below 0, rounded"
  rule base = round(max(0, marginal(pit3_rate, ytd_base[m]) - marginal(pit3_rate, ytd_base[m] - adv_base[m]) - (if sio_reducing then pit3_reducing * (1 month / 1 year) else 0)), 1, half-up)

def pen_adv_year[y in year]: money DUK = sum(pen_adv[m] for m in month where year_of(m) == y) at start_of(y)

def pen_base[y in year]: money DUK = round(pen_income[y], 1, half-up) at start_of(y)

def pen_due[y in year]: money DUK = pen_tax[y] - pen_adv_year[y] at start_of(y)

def pen_income[y in year]: money DUK at start_of(y)
  note "PIT-2 .1: counted on the day paid; the SIO's gross paid in the year, arrears included in the month paid"
  rule base = sum(sio_in[m] for m in month where year_of(m) == y)

def pen_tax[y in year]: money DUK = round(max(0, marginal(pit3_rate, pen_base[y]) - pit3_reducing), 1, half-up) at start_of(y)

def rent_adv[m in month]: money DUK at start_of(m)
  note "PIT-13 .3: the tax on the year's rent to date less the advances already paid"
  rule base = if start_of(m) == start_of(year_of(m)) then rent_tax_ytd[m] else rent_tax_ytd[m] - rent_tax_ytd[m - 1]

def rent_adv_year[y in year]: money DUK = sum(rent_adv[m] for m in month where year_of(m) == y) at start_of(y)

def rent_due[y in year]: money DUK = rent_tax[y] - rent_adv_year[y] at start_of(y)

def rent_rcv[y in year]: money DUK at start_of(y)
  note "PIT-13 .1: the rent received in the tax year, on the day it reached the account"
  rule base = sum(t.cash.amount for t in rent_payments over y)

def rent_share[y in year]: num DUK at start_of(y)
  note "PIT-13 .2: each co-owner on the rent times their share (CIV-4 .1)"
  rule base = rent_rcv[y] * flat_after[halina]

def rent_tax[y in year]: money DUK = round(marginal(pit13_rate, rent_share[y]), 1, half-up) at start_of(y)

def rent_tax_ytd[m in month]: money DUK = round(marginal(pit13_rate, rent_ytd[m] * flat_after[halina]), 1, half-up) at start_of(m)

def rent_ytd[m in month]: money DUK = sum(t.cash.amount for t in rent_payments over start_of(year_of(m)) .. add_days(end_of(m), -1)) at start_of(m)

def return_day[y in year]: date = day_of(y + 1, return_by) at start_of(y)

def return_due[y in year]: date at return_day[y]
  note "PIT-5 .1 by 30 April of the next year; a deadline on a day that isn't a business day moves to the next (GEN-2 .2)"
  rule base = if is_business(return_day[y], holidays) then return_day[y] else add_business(return_day[y], 1, holidays)

def ytd_base[m in month]: money DUK = sum(adv_base[k] for k in month where year_of(k) == year_of(m) and k <= m) at start_of(m)

version return_day_rows
  cite pit_5
  governs 2022..
  known 2021-11-15
  note "PIT-5 v2 .1: a return by 30 April of the next year (PIT-13 .4 the same for the rent). A day the act fixes in every year is a month-day row (L §3.1, §4.2)."
  return_by = 04-30 "PIT-5 v2 .1: 30 April of the next year"

version reducing_2025
  cite modeller
  governs always
  known 2025-02-14
  sio_reducing = true assumed "D-D16 shows the statement on file for 2024; nothing in the dossier withdraws it" governs 2025..

version sio_2024_statement
  cite d_d16
  governs always
  known 2025-02-14
  sio_adv_stated[2024] = 2136.00 "D-D16"
  sio_paid_stated[2024] = 46356.46 "D-D16"
  sio_reducing = true governs 2024 "D-D16: a reducing statement was on file for the whole year"

version sio_2025_statement
  cite d_d17
  governs always
  known 2026-02-13
  sio_adv_stated[2025] = 4098.00 "D-D17"
  sio_paid_stated[2025] = 61546.64 "D-D17"
  replace sio_reducing = true governs 2025 "D-D17: a reducing statement was on file for the whole year"
