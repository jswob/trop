version fee_links
  cite olcha
  governs 2025-07..2025-12
  known 2025-12-11
  note "The fee rows of July to December 2025 fulfil fee_out, which exists only once D-D27 (known 2025-12-11) states the fee plan; the links are added here by replace, so cuts before it read the rows unlinked (L §5.19)."
  replace bank[r20250707a] = (on: 2025-07-07, kind: flat_costs, leg cash from konto to world amount 445.00 DUK, fulfils: fee_out[2025-07]) "olcha-2025-07.csv line 13, linked once D-D27 states the fee plan"
  replace bank[r20250805a] = (on: 2025-08-05, kind: flat_costs, leg cash from konto to world amount 445.00 DUK, fulfils: fee_out[2025-08]) "olcha-2025-08.csv line 10, linked once D-D27 states the fee plan"
  replace bank[r20250905a] = (on: 2025-09-05, kind: flat_costs, leg cash from konto to world amount 445.00 DUK, fulfils: fee_out[2025-09]) "olcha-2025-09.csv line 11, linked once D-D27 states the fee plan"
  replace bank[r20251006a] = (on: 2025-10-06, kind: flat_costs, leg cash from konto to world amount 445.00 DUK, fulfils: fee_out[2025-10]) "olcha-2025-10.csv line 10, linked once D-D27 states the fee plan"
  replace bank[r20251105a] = (on: 2025-11-05, kind: flat_costs, leg cash from konto to world amount 445.00 DUK, fulfils: fee_out[2025-11]) "olcha-2025-11.csv line 10, linked once D-D27 states the fee plan"
  replace bank[r20251205a] = (on: 2025-12-05, kind: flat_costs, leg cash from konto to world amount 445.00 DUK, fulfils: fee_out[2025-12]) "olcha-2025-12.csv line 11, linked once D-D27 states the fee plan"

