  cite olcha
  governs 2025-06
  known 2025-06-12
  anchor konto
  bank[r20250612a] = (on: 2025-06-12, kind: transfers, leg cash from konto to world amount 124062.00 DUK) "olcha-2025-06.csv line 13: notary's deposit, payments to the heirs"
  stated[konto] = 2209.24 known 2025-06-13 at 2025-06-13 end "olcha-2025-06.csv line 13: no row on 2025-06-13, so the balance after line 13"
  stated[konto] = 1324.24 known 2025-06-17 at 2025-06-17 end "olcha-2025-06.csv line 15"
  stated[konto] = 4334.00 known 2025-06-19 at 2025-06-19 end "olcha-2025-06.csv line 16"
