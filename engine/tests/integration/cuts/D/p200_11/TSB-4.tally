part tsb_4
  tally 2
  law
  note "TSB-4 · Early redemption: any number of bonds of a series, paid on the third business day after the request (.1); each bond its value on the request day (TSB-3.2) less a fee of 2.00 DUK, never more than the value less 100.00 (.2); at maturity the value with no fee (.3)."

source tsb_4 "Treasury Savings Bonds, terms of issue, TSB-4 Redemption before maturity (tmp/cases/law/acts.md)"

input tsb4_days: int question "On which business day after the request is a redemption paid (TSB-4 .1)?"

input tsb4_fee: money DUK question "What is the early-redemption fee per bond (TSB-4 .2)?"

version tsb4_v1
  cite tsb_4
  governs 2018-01-01..
  known 2017-11-20
  enters 2018-01-01
  note "TSB-4 v1, in force 2018-01-01 until replaced, published 2017-11-20; governs series issued from January 2018."
  tsb4_days = 3 "TSB-4 v1 .1"
  tsb4_fee = 2.00 "TSB-4 v1 .2"
