part pensions
  tally 2
  note "D-03: Halina's old-age pension (SOC-5), Zbigniew's pension and the survivor pension (SOC-6, SOC-7), what the law entitles her to for each month and what the SIO paid for it."

input arrears_day: date question "On what day did the SIO pay the arrears (D-D15)?"

input earnings[y in year]: money DUK question "What were Halina's earnings in this year (D-D10)?"

input elected: key pkind question "Which pension did Halina elect to be paid in full (D-D13)?"

input soc6_month: int question "In which month of the year are pensions indexed, on its first day (SOC-6 .1)?"

input own_claim_from: date question "From what day is Halina's old-age pension paid (D-D11)?"

input pay_dom: int question "On what day of the month does the SIO pay (D-D09, D-D11)?"

input sio_decision: date question "On what day did the SIO decide the v2 claim (D-D15)?"

input sio_min_used: money DUK question "Which MIN-PENSION did the SIO's decision cap the two pensions at (D-D15)?"

input surv_claim: date question "On what day did Halina claim the survivor pension (D-D12)?"

input v2_claim: date question "On what day did Halina claim under SOC-7 v2 (D-D14)?"

input zb_first: money DUK question "What was Zbigniew's pension when it started (D-D09)?"

input zb_start: date question "From what day was Zbigniew's pension paid (D-D09)?"

def cap_law[m in month]: money DUK = soc7_cap_mult * min_pension at start_of(m)

def capital: money DUK at own_claim_from
  note "SOC-5 .2, .3: each year's contribution, rounded to the ort as a contribution (GEN-5 .3, .5: at the step that produces it), times the exact product of the later indices; the capital rounded"
  rule base = round(sum(round(earnings[y] * soc5_contrib, minor(DUK), half-up) * val_factor[y] for y in year where y < ret_year), minor(DUK), half-up)

def entitled[m in month]: money DUK at start_of(m)
  note "the gross the law entitles Halina to for month m"
  rule both beats one, own_only v soc7_v2 = surv[m] + max(0, min(part_full[m], cap_law[m] - surv[m])) when v2_on[m]
  rule one beats own_only = if elected == zb then surv[m] else lvl[own, m] when surv_on[m]
  rule own_only = lvl[own, m]

def index_day[y in year]: date = start_of(month_of(start_of(y)) + soc6_month - 1) at start_of(y)

def indexed_on[k in pkind, y in year]: bool at start_of(y)
  note "SOC-6 .1: indexed on 1 March of y if it started before 1 March of y - 1, or from the first 1 March after a full year of payment"
  rule base = add_years(pen_start[k], 1) <= index_day[y]

def is_march[m in month]: bool = start_of(m) == index_day[year_of(m)] at start_of(m)

def lvl[k in pkind, m in month]: money DUK at start_of(m)
  rule first = pen_first[k] when m == month_of(pen_start[k])
  rule later = if is_march[m] and indexed_on[k, year_of(m)] then round(lvl[k, m - 1] * pen_idx[year_of(m)], minor(DUK), half-up) else lvl[k, m - 1] when m > month_of(pen_start[k])

def own_first: money DUK = round(capital / le_months[age(born_halina, own_claim_from)], minor(DUK), half-up) at own_claim_from

def part_full[m in month]: money DUK = round(lvl[own, m] * soc7_part, minor(DUK), half-up) at start_of(m)

def pen_first[k in pkind]: money DUK at reader
  rule own = own_first when k == own
  rule zb = zb_first when k == zb

def pen_start[k in pkind]: date at reader
  rule own = own_claim_from when k == own
  rule zb = zb_start when k == zb

def ret_year: year = year_of(own_claim_from) at reader

def sio_for[m in month]: money DUK at start_of(m)
  note "the gross the SIO paid for month m (arrears counted in the month they are for): the law until v2, then its decision (D-D15)"
  rule decided beats law = surv[m] + sio_part[m] when v2_on[m]
  rule law = entitled[m]

def sio_in[m in month]: money DUK at start_of(m)
  note "the gross the SIO paid in month m: before its decision the survivor pension alone, the arrears with the first payment after it"
  rule arrears beats base = sio_for[m] + sum(sio_part[k] for k in month where v2_on[k] and k < m) when v2_on[m] and m == month_of(arrears_day)
  rule base = sio_for[m]
  rule waiting beats base = surv[m] when v2_on[m] and start_of(m) <= sio_decision

def sio_owes[d in day]: money DUK = sum(entitled[m] - sio_for[m] for m in month where add_days(end_of(m), -1) <= d and v2_on[m]) at start_of(d)

def sio_part[m in month]: money DUK = max(0, min(part_full[m], soc7_cap_mult * sio_min_used - surv[m])) at start_of(m)

def surv[m in month]: money DUK at start_of(m)
  note "SOC-7 .1: 85 % of Zbigniew's pension on the day of the death, indexed as if it had started when his did"
  rule first = round(lvl[zb, month_of(death_day)] * soc7_rate, minor(DUK), half-up) when m == month_of(surv_from)
  rule later = if is_march[m] and indexed_on[zb, year_of(m)] then round(surv[m - 1] * pen_idx[year_of(m)], minor(DUK), half-up) else surv[m - 1] when m > month_of(surv_from)

def surv_on[m in month]: bool at start_of(m)
  note "SOC-7 .1, .2: a spouse aged 50 or over at the death, on a claim, from the month the claim takes effect"
  rule base = surv_claim != none and married and age(born_halina, death_day) >= soc7_min_age and start_of(m) >= surv_from

def surv_from: date at death_day
  rule late = start_of(month_of(surv_claim) + 1)
  rule timely beats late = start_of(month_of(death_day) + 1) when surv_claim <= add_months(death_day, soc7_claim_months)

def v2_on[m in month]: bool at start_of(m)
  note "SOC-7 v2 .4: point 3 applies on a claim, from the month it takes effect"
  rule base = v2_claim != none and start_of(m) >= v2_effective

def v2_effective: date at v2_claim
  rule late = start_of(month_of(v2_claim) + 1)
  rule timely beats late = soc7_v2_from when v2_claim <= soc7_claim_by

def val_factor[y in year]: num at start_of(y)
  note "SOC-5 .3: the product of VAL-IDX for every year from y + 1 to R - 1, built backwards; 1 where there is none"
  rule earlier beats last = val_factor[y + 1] * val_idx[y + 1] when y < ret_year - 1
  rule last = 1 when y >= ret_year - 1

def zb_pay_day[m in month]: date at start_of(m)
  note "D-D09: paid on the 5th of each month, or the last business day before it"
  rule base = schedule(m, pay_dom, preceding, holidays)

version zb_pension_decision
  cite d_d09
  governs always
  known 2018-11-30
  zb_first = 3752.61 "D-D09: 3 752.61 DUK a month"
  zb_start = 2018-12-01 "D-D09: from 1 December 2018"

