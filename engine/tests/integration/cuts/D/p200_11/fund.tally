part fund
  tally 2
  note "D-12: 100 000.00 DUK in BRZ-DIV-D instead of the bonds, for each start month 2018-01..2023-09, 36 monthly withdrawals of 900.00, distributions less PIT-8 .7's 19 % into the cash. Prices are the month's first valuation day (market rows, one version per month, known that day)."

input dist_amt[e in dist]: num DUK/fund_unit question "What does this distribution pay per unit?"

input dist_ex[e in dist]: date question "What is this distribution's ex day?"

input dist_pay[e in dist]: date question "What is this distribution's pay day?"

input fund_capital: money DUK question "How much does she put in (D-12)?"

input fund_draw: money DUK question "How much does she take out each month (D-12)?"

input fund_months: int question "For how many months does she take it out (D-12)?"

input fv_day[m in month]: date question "What is this month's first valuation day of BRZ-DIV-D?"

input nav_first[m in month]: num DUK/fund_unit question "What is BRZ-DIV-D's price on this month's first valuation day?"

def f_best: key start_month = argmax(f_end[s] for s in start_month) ties by pos(s) at reader

def f_cash[s in start_month, k in wstep]: money DUK = f_pre[s, k] + round(f_sell[s, k] * f_price[s, k], minor(DUK), hh_round) - fund_draw at start_of(s)

def f_cash0[s in start_month]: money DUK = fund_capital - round(f_units[s, 0] * f_price[s, 0], minor(DUK), hh_round) at start_of(s)

def f_day[s in start_month, k in wstep]: date = fv_day[s + k] at start_of(s)

def f_dist[s in start_month, k in wstep]: money DUK = if k > 0 then sum(f_net[s, k, e] for e in dist where dist_ex[e] > f_day[s, k - 1] and dist_pay[e] <= f_day[s, k]) else 0 at start_of(s)

def f_end[s in start_month]: money DUK = round(f_units[s, fund_months] * f_price[s, fund_months], minor(DUK), hh_round) + f_cash[s, fund_months] at start_of(s)

def dist_tax_rate[e in dist]: num = pit8_rate at dist_pay[e]

def f_net[s in start_month, k in wstep, e in dist]: money DUK = if k > 0 then round(f_units[s, k - 1] * dist_amt[e], minor(DUK), hh_round) - round(f_units[s, k - 1] * dist_amt[e] * dist_tax_rate[e], 1, half-up) else 0 at start_of(s)

def f_pre[s in start_month, k in wstep]: money DUK = if k == 1 then f_cash0[s] + f_dist[s, k] else if k > 1 then f_cash[s, k - 1] + f_dist[s, k] else 0 at start_of(s)

def f_price[s in start_month, k in wstep]: num DUK/fund_unit = nav_first[s + k] at start_of(s)

def f_sell[s in start_month, k in wstep]: num fund_unit = if f_pre[s, k] >= fund_draw then 0 else round((fund_draw - f_pre[s, k]) / f_price[s, k], 1, ceil) at start_of(s)

def f_units[s in start_month, k in wstep]: num fund_unit at start_of(s)
  rule first = round(fund_capital / f_price[s, 0], 1, down) when k == 0
  rule later = f_units[s, k - 1] - f_sell[s, k] when k > 0

def f_worst: key start_month = argmin(f_end[s] for s in start_month) ties by pos(s) at reader

