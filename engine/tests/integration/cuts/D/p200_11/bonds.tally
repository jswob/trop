part bonds
  tally 2
  note "D-01, D-06, D-07, D-08: the 325 bonds (D-D22), their value under TSB-2 and TSB-3, the heirs' basis (TSB-6, TSB-7), the redemptions (D-D24a–d) and D-HR2's floor."

kind redemptions: transfers
  note "a redemption's payment into the account (TSB-4 .1)"

input bought[s in isb_series]: date question "On what day were this series' bonds bought (D-D22)?"

input hr2_floor: money DUK question "Below what end-of-day balance is a redemption asked for (D-HR2)?"

input hr2_least: money DUK question "At least how much must the bonds asked for come to, value less fee (D-HR2)?"

input lot[s in isb_series]: int question "How many bonds of this series were held on 17 May 2024 (D-D22)?"

input red_day[r in redemption]: date question "On what day was this redemption asked for?"

input red_n[r in redemption, s in isb_series]: int question "How many bonds of this series did this request redeem?"

input red_net_stated[r in redemption]: money DUK question "What does the Treasury's statement show paid for this request?"

input red_tax_stated[r in redemption]: money DUK question "What tax does the Treasury's statement show for this request?"

def all_fees[d in day]: money DUK = sum(held[s, d] * fee_per[s, d] for s in isb_series) at start_of(d)

def all_tax[d in day]: money DUK = sum(series_tax[s, d, held[s, d]] for s in isb_series) at start_of(d)

def basis[s in isb_series]: money DUK = bond_value[s, death_day] at reader

def before[r in redemption, s in isb_series]: int = lot[s] - sum(red_n[t, s] for t in redemption where red_day[t] != none and red_day[t] < red_day[r]) at reader

def bond_value[s in isb_series, d in day]: money DUK = round(iy_value[s, iy_of[s, d]] * (1 + iy_rate[s, iy_of[s, d]] * days_between(iy_start[s, iy_of[s, d]], d) / days_between(iy_start[s, iy_of[s, d]], iy_start[s, iy_of[s, d] + 1])), minor(DUK), half-up) at start_of(d)

def bonds_accrued[d in day]: money DUK = sum(held[s, d] * (bond_value[s, d] - iy_value[s, iy_of[s, d]]) for s in isb_series) at start_of(d)

def bonds_net[d in day]: money DUK = bonds_value[d] - all_fees[d] - all_tax[d] at start_of(d)

def bonds_value[d in day]: money DUK = sum(held[s, d] * bond_value[s, d] for s in isb_series) at start_of(d)

def cum_net[r in redemption, s in isb_series]: money DUK = sum(before[r, t] * (bond_value[t, red_day[r]] - fee_per[t, red_day[r]]) for t in isb_series where bought[t] <= bought[s]) at reader

def fee_per[s in isb_series, d in day]: money DUK = min(tsb4_fee, bond_value[s, d] - basis[s]) at bought[s]

def held[s in isb_series, d in day]: int = lot[s] - sum(red_n[r, s] for r in redemption where red_day[r] != none and red_day[r] <= d) at start_of(d)

def hr2_last[r in redemption]: key isb_series = argmin(bought[s] for s in isb_series where cum_net[r, s] >= hr2_least) at reader

def hr2_n[r in redemption, s in isb_series]: int at reader
  note "D-HR2 .2: the earliest series first, by the day they were bought, in whole bonds, as many as it takes for their value less the fee (TSB-4 .2) to come to at least the least amount"
  rule all beats none = before[r, s] when bought[s] < bought[hr2_last[r]]
  rule last beats none = round((hr2_least - (cum_net[r, s] - before[r, s] * (bond_value[s, red_day[r]] - fee_per[s, red_day[r]]))) / (bond_value[s, red_day[r]] - fee_per[s, red_day[r]]), 1, ceil) when s == hr2_last[r]
  rule none = 0

def iy_of[s in isb_series, d in day]: int = age(bought[s], d) + 1 at start_of(d)

def cpi_known[mo in tsb2_month, d in day]: num at reader
  note "TSB-2 .2: the CPI-YY of month mo as the gazette had published it by day d; the keys are values, so nothing but the index itself is read as known then (L §5.11, a pin's world covers every read inside it)"
  rule base = cpi_yy[mo] as if {known d}

def iy_rate[s in isb_series, k in iyear]: num at bought[s]
  note "TSB-2: R1 in the first interest year; later the CPI-YY two months before the year's first month, as published on its first day (or as known at the cut, if that is earlier), less 100, plus the margin, never below 0; the gazette states them in per cent (x * 1 % is x per cent)"
  rule first = isb_r1[s] * 1 % when k == 1
  rule later = max(0, cpi_known[month_of(iy_start[s, k]) - tsb2_lag, min(iy_start[s, k], cut)] * 1 % - 1 + isb_margin[s] * 1 %) when k > 1

def iy_start[s in isb_series, k in iyear]: date = add_years(bought[s], k - 1) at reader

def iy_value[s in isb_series, k in iyear]: money DUK at bought[s]
  rule first = tsb1_price when k == 1
  rule later = round(iy_value[s, k - 1] * (1 + iy_rate[s, k - 1]), minor(DUK), half-up) when k > 1

def paid_per[s in isb_series, d in day]: money DUK = bond_value[s, d] - fee_per[s, d] at start_of(d)

def red_net[r in redemption]: money DUK = sum(red_n[r, s] * paid_per[s, red_day[r]] for s in isb_series) - red_tax[r] at reader

def red_paid_on[r in redemption]: date at min(bought[s] for s in isb_series where red_n[r, s] > 0)
  note "TSB-4 .1 under the version that governs the series by their issue, read at the earliest series the request redeems: a request whose series fell under two versions would need the act to say which governs it"
  rule base = add_business(red_day[r], tsb4_days, holidays)

def red_tax[r in redemption]: money DUK = sum(series_tax[s, red_day[r], red_n[r, s]] for s in isb_series) at reader

def series_tax[s in isb_series, d in day, n in wstep]: money DUK = round((paid_per[s, d] - basis[s]) * n * tsb5_rate, 1, half-up) at start_of(d)

move redeem_pay[r in redemption where red_day[r] != none]: redemptions
  on red_paid_on[r]
  at red_day[r]
  leg cash from world to konto amount red_net[r]

version no_redemption
  cite modeller
  governs always
  known 2024-01-01
  red_day = none assumed "a redemption no statement shows yet has not been asked for; each D-D24 statement states its own day"

