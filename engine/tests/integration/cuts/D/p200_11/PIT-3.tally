  known 2021-11-15
  enters 2022-01-01
  note "PIT-3 v2, in force 2022-01-01 – 2022-06-30, published 2021-11-15; governs advances paid 2022-01-01 – 2022-06-30, in PIT-4 v2 .4 advances paid 2022-07-01 – 2022-12-31, and the tax for 2022 until v3 was published."
  pit3_rate: [0, 120000] = 0.18 "PIT-3 v2 .1: 18 % of the base up to 120 000.00 DUK"
  pit3_rate: (120000, inf) = 0.33 "PIT-3 v2 .1: 33 % of the part above 120 000.00 DUK"
  pit3_reducing = 5400.00 "PIT-3 v2 .2"

version pit3_v3
  cite pit_3
  governs 2022-01-01..2022-12-31
  known 2022-06-14
  enters 2022-07-01
  note "PIT-3 v3, in force 2022-07-01 until replaced, published 2022-06-14; governs the tax for tax years from 2022, the whole of 2022 included, and advances paid from 2022-07-01. This version holds its rows for 2022, where they replace v2's; pit3_v3_on holds the same rows from 2023 (one act, two versions: a band table's replace rows with no earlier table on part of their span are refused by the reference interpreter, W-A fault F6)."
  replace pit3_rate: [0, 120000] = 0.13 "PIT-3 v3 .1: 13 % of the base up to 120 000.00 DUK"
  replace pit3_rate: (120000, inf) = 0.33 "PIT-3 v3 .1: 33 % of the part above 120 000.00 DUK"
  replace pit3_reducing = 3900.00 "PIT-3 v3 .2"

version pit3_v3_on
