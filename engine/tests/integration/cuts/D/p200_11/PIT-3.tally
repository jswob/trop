  note "PIT-3 v3 from tax year 2023 on (see pit3_v3)."
  pit3_rate: [0, 120000] = 0.13 "PIT-3 v3 .1: 13 % of the base up to 120 000.00 DUK"
  pit3_rate: (120000, inf) = 0.33 "PIT-3 v3 .1: 33 % of the part above 120 000.00 DUK"
  pit3_reducing = 3900.00 "PIT-3 v3 .2"
