source house_rules "Household D's house rules, tmp/cases/D/house-rules.md"

source market "BRZ-DIV-D prices and distributions, tmp/cases/market/brz-div-d.csv and brz-distributions.csv"

source modeller "Assumptions of this model, each with its reason"

source olcha "Bank Olcha exports of the joint account LN73 4400 2011 0000 8817 2264 0001, tmp/cases/D/records/olcha-*.csv"

source story "Household D's story, tmp/cases/D/story.md"

unit fund_unit "one unit of the fund BRZ-DIV-D"

axis hh_round
  half-up "the source says to the ort, or to n decimal places, and names no mode: ties away from zero"
  half-even "the same, ties to the even multiple"

index choice = [sell, keep]

index day = day 2018-01-01..2064-12-31

index dist: open

index draw5 = int 1..5

index heir = [halina, piotr, anna, marta, jakub]

index iyear = int 1..11

index life_age = int 68..105

index lyear = year 2026..2064

index month = month 2018-01..2064-12

index pkind = [own, zb]

index quarter = month 2025-07..2027-09 by 3
  assumed "D-HR1 runs on, but a quarter is planned only while its due day falls in a year the holidays calendar has a row for (GEN-1's to 2026, the assumed row hol_2027 to 2027): 2027-Q4 is due in January 2028, and a due day that is a hole would spoil every span (L §5.14)"
  note "D-HR1's calendar quarters from July 2025, each key standing for the three months from it (L §4.1 by n)"

index redemption = [red_20250616, red_20250620, red_20250704, red_20260304]

index start_month = month 2018-01..2023-09

index stock = [s_piotr, s_anna, s_marta, s_adam]

index wstep = int 0..36

index year = year 1981..2064

place jakub_acct: outside lives 2004-02-11..

place konto: accounts DUK lives 2024-01-01..

place world: outside lives 1900-01-01..

version hol_2027
  cite modeller
  governs 2027
  known 2025-06-24
  note "2027's holidays, assumed so that the quarters of D-HR1 due in 2027 have business days; known with D-HR1 (kuba_rule), so every cut that plans a quarter sees it. GEN-1's own row for 2027, from the Spring Day notice, replaces it when it is known."
  holidays = calendar(weekends [sat, sun], added [2027-01-01, 2027-01-06, 2027-04-05, 2027-05-01, 2027-05-03, 2027-06-23, 2027-08-15, 2027-11-01, 2027-11-11, 2027-12-25, 2027-12-26]) assumed "no Spring Day notice for 2027 is known on the model's day (GEN-1 .3): its first Monday of April is taken" governs 2027 "GEN-1 v2 .2; Spring Day not settled (GEN-1 .3)"
