source market_files "Fund price files (tmp/cases/market/<fund>.csv)"

source modeller "The modeller's readings of facts the dossier leaves open, each with its reason"

source questions "Household A, questions (tmp/cases/A/questions.md)"

source rzk_a "Rzeka register, client 4471-07, Anna Lis (tmp/cases/A/records/rzk-4471-07-anna.csv)"

source rzk_t "Rzeka register, client 4471-02, Tomasz Lis (tmp/cases/A/records/rzk-4471-02-tomasz.csv)"

source story "Household A, story (tmp/cases/A/story.md)"

source wek_a "Wektor participant register, Anna Lis, Kalina's plan (tmp/cases/A/records/wek-wcp-lis-anna.csv)"

source wek_t "Wektor participant register, Tomasz Lis, Nurt's plan (tmp/cases/A/records/wek-wcp-lis-tomasz.csv)"

source wrz_ania "Bank Wrzos export, Ania's savings LN61 … 5503, 2025 (tmp/cases/A/records/wrz-ania-savings-2025.csv)"

source wrz_joint "Bank Wrzos exports, joint account LN27 … 0412, 2024-08 to 2025-12 (tmp/cases/A/records/wrz-joint-*.csv)"

kind funds: unit
  note "each fund a unit of its own (L §3.2, §5.7): glb BRZ-GLB-A, bnd BRZ-BND-A, div BRZ-DIV-D, mm BRZ-MM-A, idx WEK-IDX-D, em WEK-EM-A, wcp WEK-WCP-2055"

kind wrapped: place one min 0
  note "the holdings of Ania's wrapped account (A-D11, PIT-9), declared as holdings are (L §5.10) but a kind of their own: what is sold from them is taxed when withdrawn, not under PIT-8, so they hold no PIT-8 lots"

kind card_pays: transfers
  note "a card payment from the joint account (statement type CARD TRANSACTION)"

kind card_refunds: transfers
  note "a card refund into the joint account (CARD REFUND)"

kind paybacks: transfers
  note "a friend paying back a shared bill (an incoming transfer from a friend)"

kind standing_pays: transfers
  note "a standing order or instalment paid from the joint account (STANDING ORDER)"

kind wages_in: transfers

kind benefits_in: transfers

kind bills: transfers

kind tax_refunds: transfers

kind car_settlements: transfers
  note "what came in or went out because of the car's sale: the price, the early repayment and the three refunds (A-D27, A-D28, CC-1, MOT-1, MOT-2)"

kind cg_tax_pays: transfers
  attr payer: key spouse
  note "a payment of the tax on fund sales, with the spouse whose tax it is (the statement's title names A. Lis or T. Lis)"

kind invests: transfers
  note "money moved to the wrapped account or to a Rzeka account (A-HR1)"

kind own_moves: transfers
  note "money moved between our own accounts, not investing: to the Lazur reserve, a Rzeka payout"

kind distributions: transfers

kind taxes_withheld: transfers

kind wrap_withdrawals: transfers

kind lots_in: event certain
  leg units: funds
  note "units entering a holding as a lot of their own, the lots first in first out takes (PIT-8 .3)"

kind fund_buys: lots_in
  leg cash: DUK
  leg fee: DUK
  note "a purchase of fund units under PIT-8: units into a holding, the money placed and the fee out of the account's cash"

kind gifts_in: lots_in
  attr bought: month
  note "units received as a gift, with the month the giver bought them in (PIT-8 .2, .6; kop-30-118-552-ania.csv)"

kind lot_transfers: lots_in
  attr reported: money DUK
  attr bought: month
  attr gifted_on: date
  note "units moved in from another broker, keeping their lot (PIT-8 .3): the cost basis the other broker reported (A-D12 .4), the month the giver bought them in (PIT-8 .6) and the day of the gift that brought them (PIT-8 .2)"

kind lot_outs: event certain
  leg units: funds
  note "units moved out to another broker, seen from the account they leave"

kind fund_sales: event certain
  leg units: funds
  leg cash: DUK
  leg fee: DUK

kind wrap_buys: event certain
  leg units: funds
  leg cash: DUK
  note "a purchase inside the wrapped account (PIT-9, not PIT-8)"

kind wrap_redemptions: event certain
  leg units: funds
  leg cash: DUK

index child: open
  note "Zosia's key comes with the row of her birth, known 2023-04-27 (people.tally)"

index day = day 2021-01-01..2035-12-31

index month = month 2021-01..2035-12

index payer = [nurt, kalina, sio]
  note "Tomek's employer Nurt Software, Ania's employer Kalina Logistyka, and the Social Insurance Office paying Ania's parental pay"

index spouse = [ania, tomek]

index tax_year = year 2021..2035

version fund_units
  cite market_files
  known 2021-01-01
  assumed "the funds' launch days aren't in the dossier; each is taken as alive from 2018-01-01, before every price the files hold"
  funds + [bnd] lives 2018-01-01..
  funds + [div] lives 2018-01-01..
  funds + [em] lives 2018-01-01..
  funds + [glb] lives 2018-01-01..
  funds + [idx] lives 2018-01-01..
  funds + [mm] lives 2018-01-01..
  funds + [wcp] lives 2018-01-01..

version lifted_figures
  cite lifted_1_0_1
  governs always
  known 2018-06-01
  card_avg_3 = 3 "A-HR1 v2 .3: divided by three (inline in tally 1.0.1: card_avg line 108)"
  hr3_units_0_0001 = 0.0001 "A-HR3: units to 4 places (inline in tally 1.0.1: hr3_units line 245, round step)"
  joint_tax_2 = 2 "PIT-6 .3: twice the tax on half the combined base (inline in tally 1.0.1: joint_tax line 107)"
  loss_want_2 = 2 "PIT-8 .5: at most half of it (inline in tally 1.0.1: loss_want line 246)"
  nw_community_0_5 = 0.5 "A-HR5 .1: half of the common property (inline in tally 1.0.1: nw_community line 39)"
  nw_half_2 = 2 "A-HR5 .1: half each (inline in tally 1.0.1: nw_half lines 47, 48)"
  r_units_0_0001 = 0.0001 "units to 4 places (inline in tally 1.0.1: r_units line 216, round step)"
  red12_12 = 12 "PIT-4 .2: 1/12 of the yearly reducing amount (inline in tally 1.0.1: red12 line 218)"
  relief_half_2 = 2 "PIT-7 .4: in halves (inline in tally 1.0.1: relief_half line 90)"
  road_refund_12 = 12 "MOT-2: a year's tax in twelfths (inline in tally 1.0.1: road_refund line 150)"
  rule_day_15 = 15 "A-HR1: on the 15th (inline in tally 1.0.1: rule_day lines 58, 60)"
  w_bnd_money_2 = 2 "A-D11 .1: half in each fund (inline in tally 1.0.1: w_bnd_money line 164)"
  w_bnd_units_0_0001 = 0.0001 "units to 4 places (inline in tally 1.0.1: w_bnd_units line 174, round step)"
  w_glb_units_0_0001 = 0.0001 "units to 4 places (inline in tally 1.0.1: w_glb_units line 170, round step)"
