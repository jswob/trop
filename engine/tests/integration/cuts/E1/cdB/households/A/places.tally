  owns[tomek, rza_glb] = 0 governs 2024-02-12.. "A-D21: Ania's own"
  owns[ania, rza_cash] = 1 governs 2024-02-12.. "story 2024-03-07: the proceeds of the gifted units are hers (CIV-1 .3, in exchange for separate assets)"
  owns[tomek, rza_cash] = 0 governs 2024-02-12.. "story 2024-03-07: hers"
