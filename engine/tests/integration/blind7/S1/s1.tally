  bank[r10] = (on: 2025-05-10, kind: pays, leg cash from world to shared amount 3150.00 DUK) known 2025-05-10 "S1-R1 row 10: PAY OSTRA LOGISTIKA M.DANEK"
  bank[r11] = (on: 2025-05-10, kind: pays, leg cash from world to shared amount 2870.00 DUK) known 2025-05-10 "S1-R1 row 11: PAY VERNO TECH J.DANEK"
  bank[r12] = (on: 2025-05-12, kind: payments, leg cash from shared to world amount 12600.00 DUK, for_one: none) known 2025-05-12 "S1-R1 row 12: TRAVEL ARDENA BOOKING 5521"
  bank[r13] = (on: 2025-05-20, kind: payments, leg cash from shared to world amount 3950.00 DUK, for_one: none) known 2025-05-20 "S1-R1 row 13: HOUSEHOLD ORDER RENT BILLS SHOPPING"
