version stmt_r1
  cite banka_torvin
  governs 2027-02-14..2027-12-31
  known 2027-02-14
  anchor a1145
  note "S4-R1 holds all the account's rows from 2027-02-14 to 2027-12-31, but no covers line is written: on a covered day the death's and the division's relabels at the account (L 5.14), which no bank row shows, would be modelled past and never booked (L 5.19)"
  stated[a1145] = 38420.60 DUK at 2027-02-13 end "S4-R1 row 0: closing balance 13.02.2027"
  stated[a1145] of maleks = 38420.60 DUK at 2027-02-13 end "Cast: the joint account (SPS-1 point 1)"
  bank[r1] = (on: 2027-02-24, kind: estate_debt_pays, leg cash from a1145 to world amount 9845.35 DUK, debtor: edvin_estate) known 2027-02-24 "S4-R1 row 1: LIPA FUNERAL HOME INVOICE 2027/118 (SUC-1 point 2: an estate debt)"
  bank[r2] = (on: 2027-10-05, kind: closings, leg cash from a3390 to a1145 amount 7315.40 DUK) known 2027-10-05 "S4-R1 row 2: FROM 2208 3390 ACCOUNT CLOSED E.MALEK"
  bank[r3] = (on: 2027-10-12, kind: division_pays, leg cash from a1145 to pavo_own amount 31511.33 DUK, deed: deed_311, payee: pavo, payer: ruta) known 2027-10-12 "S4-R1 row 3: TO P.MALEK DEED 311/2027"

version death
  cite card_s4
  governs always
  known 2027-02-14
  note "Entries: Edvin dies on 2027-02-14 (no document); the marriage ends with him"
  estates + [edvin_estate] lives 2027-02-14..
  replace couples + [maleks] lives 1979-07-07..2027-02-14
  replace persons + [edvin] lives 1951-03-02..2027-02-14
  couple_of[edvin_estate] = maleks "Cast: married 1979-07-07"
  deceased_of[edvin_estate] = edvin "Entries: Edvin dies"
  survivor_of[edvin_estate] = ruta "Cast: Ruta, his wife"

version will
  cite will_doc
  governs 2027-02-14..
