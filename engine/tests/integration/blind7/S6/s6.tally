  cite banka_lenska
  governs 2025-11-01..2025-12-31
  known 2025-11-01
  note "S6-R2; its row of 18.12.2025 FROM M.HOLM SETTLEMENT 9 543,88 is the same movement as S6-R1 row 26, written once there"
  dbank[n1] = (on: 2025-11-05, kind: own_rows, leg cash from world to daria_own amount 3412.37 DUK) known 2025-11-05 "S6-R2: 05.11.2025 PAY ARVEN CLINIC"
  dbank[n2] = (on: 2025-11-24, kind: own_rows, leg cash from daria_own to world amount 2140.30 DUK) known 2025-11-24 "S6-R2: 24.11.2025 CARD"
  dbank[n3] = (on: 2025-12-05, kind: own_rows, leg cash from world to daria_own amount 3412.37 DUK) known 2025-12-05 "S6-R2: 05.12.2025 PAY ARVEN CLINIC"
  dbank[n5] = (on: 2025-12-22, kind: own_rows, leg cash from daria_own to world amount 2310.75 DUK) known 2025-12-22 "S6-R2: 22.12.2025 CARD"

version court
  cite court_d2
  governs always
  known 2025-11-05
  replace final_on[holms] = 2025-10-31 "S6-D2: the judgment of 09.10.2025 became final on 31.10.2025"

version d3_v
  cite settlement_d3
  governs 2025-12-15..
  known 2025-12-15
  deal_couple[deal_d3] = holms "S6-D3: Daria Holm and Marek Holm"
  deal_day[deal_d3] = 2025-12-15 governs always "S6-D3: signed 2025-12-15"
  deal_part = 0 "S6-D3 point 3: only the two have parts"
  deal_part[deal_d3, daria] = 0.5 "S6-D3 point 3: half of the former joint property"
  deal_part[deal_d3, marek] = 0.5 "S6-D3 point 3: half of the former joint property"
  deal_value[deal_d3, garage] = 17500.00 DUK "S6-D3 point 2: the car 17 500.00"
  settle_allot = 0 "S6-D3 point 1: the settlement gives nothing else"
  settle_allot[deal_d3, garage, daria] = 1 "S6-D3 point 1: Daria takes the car"
  settle_allot[deal_d3, joint, marek] = 1 "S6-D3 point 1: Marek takes the former joint money in account 5150 2077"
