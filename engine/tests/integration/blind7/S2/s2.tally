model s2
  tally 2
  on 2027-08-15
  start 2026-08-01
  end 2027-07-31
  note "Card S2: Talia and Oskar Veren, the gift of a car, gift tax and interest, MAR and GFT; all made up."

source card_s2 "Card S2, Cast and Entries: the stipulations of the case"
source mar_law "Card S2, Law: MAR-1 Spouses' property"
source gft_law "Card S2, Law: GFT-1 Gift tax"
source house_rules "Card S2, House rules: H-1 What we are worth"
source deed_d1 "Card S2, S2-D1: Notary Ilona Sabat, Vesk, deed of gift, issued 2026-08-31"
source portal_d2 "Card S2, S2-D2: Revenue Office portal, receipt of form SD-3, 2027-03-01"
source decision_d3 "Card S2, S2-D3: Revenue Office Vesk, decision 2027/SD/0388, issued 2027-04-12, received 2027-04-19"
source banka_lenska "Card S2, S2-R1: Banka Lenska, statement lines kept, account 0417 5520 9031"
source motor_register "Card S2, S2-R2: Motor Register used-car value lists kept, Vela Rino 1.4, year 2019 (a list is published on the 1st of each month)"

unit DUK: currency minor 0.01

unit car "a car (the Vela Rino 1.4 of 2019)"

kind persons: parties

kind couples: parties
  note "a married couple as the owner of its joint money (MAR-1)"

kind gifts: event certain
  leg what: car
  attr case: key gift_cases
  attr donee: key persons
  attr giver: key persons

kind joint_accounts: place DUK min 0
  owned by mar_arrive ties by (if p in couples then 1 else 0)
  step minor(DUK)
  takes k for w order take_rank[w, k.owner], take_rest[w, k.owner]
  note "an account holding a couple's joint money and each spouse's own money, kept as parts by owner"

kind tax_pays: event certain
  leg cash: DUK
  attr case: key gift_cases
  attr debtor: key persons
  note "a payment to the Revenue Office of a spouse's own tax or its interest (MAR-1 point 1: own debts)"

kind vehicles: place car min 0 priced last(car_list)
  owned by mar_arrive ties by (if p in couples then 1 else 0)
  step 1 car
  takes k for w order take_rank[w, k.owner], take_rest[w, k.owner]
  note "the household's cars, kept as parts by owner; a car counts at the latest Motor Register list (H-1 point 2)"

index gift_cases = [rino]
  note "the gift of the Vela Rino (S2-D1), its report (S2-D2) and its tax decision 2027/SD/0388 (S2-D3)"

index relations = [spouse, child, grandchild, parent, grandparent, sibling]
  note "relations a person may be to another; GFT-1 point 3 names which are close family"

place garage: vehicles lives 1900-01-01..
  note "where the household's cars are counted; an early day stands for its start (L 5.7)"

place joint: joint_accounts lives 1900-01-01..
  note "Banka Lenska 0417 5520 9031; the day it was opened isn't given, so an early day stands for it (L 5.7)"

place revenue: outside lives 1900-01-01..
  note "the Revenue Office, Vesk"

place world: outside lives 1900-01-01..

input bank: observed

input car_list: num DUK/car reading
  note "the Motor Register's used-car value for the Vela Rino 1.4 of 2019, per list"

input close_relation[r in relations]: bool

input deeds: observed

input delivered_on[c in gift_cases]: date question "On what day was the tax decision delivered (GFT-1 point 4)?"

input due_days: int

input filed_on[c in gift_cases]: date question "On what day was form SD-3 sent (GFT-1 point 3)?"

input int_rate: rate

input joint_share[p in persons, c in couples]: num
  note "H-1 point 1: the share of the joint money each spouse is worth"

input refund_share: num
  note "MAR-1 point 2: the share of joint money used for an own debt that is owed to the other spouse"

input relation_of[p in persons, q in persons]: key relations
  note "p is q's relation"

input report_months: int

input spouse_of[p in persons]: key persons

band gift_rate(v: num DUK): num
  note "GFT-1 point 2, as marginal rates over the gift's value"

def due[g in gifts]: date = add_days(delivered_on[g.case], due_days) at g.day
  note "GFT-1 point 4: due 14 days after the day the decision is delivered"

def gift_tax[g in gifts]: money DUK at g.day
  note "GFT-1 points 1-3: the tax on the gift's value on the day of possession; none if a close-family gift is reported in time"
  rule exempt beats taxed v gft1_v1 = 0 when close_relation[relation_of[g.giver, g.donee]] and filed_on[g.case] <= report_by[g]
  rule taxed v gft1_v1 = round(marginal(gift_rate, last(car_list, g.day) * g.what.amount), 1 DUK, half-up)

def interest_owed[g in gifts, d in days]: num DUK at d
  note "what is owed of the interest on the gift tax at the end of day d"
  rule assessed beats run v gft1_v1 = round(interest_run[g, d], 1 DUK, half-up) - interest_paid[g, d] when gift_tax[g] > 0 DUK and tax_paid[g, d] >= gift_tax[g]
  rule run v h1_v1 = interest_run[g, d] - interest_paid[g, d]

def interest_paid[g in gifts, d in days]: money DUK = paid[g, d] - tax_paid[g, d]
  note "GFT-1 point 6: what payments have given to the interest, after the tax"

def interest_run[g in gifts, d in days]: num DUK at d
  note "GFT-1 point 5: each day from the day after the due date to the day of payment, both included, on the tax unpaid that day, at 10 % a year divided by 365; not rounded until the tax is paid"
  rule gft1_5 v gft1_v1 = sum(accrue(gift_tax[g] - tax_paid[g, t - 1], int_rate, t - 1, t, act365, simple) for t in days where pos(t) > 1 and t <= d and t > due[g] and tax_paid[g, t - 1] < gift_tax[g])

def joint_used[p in persons, d in days]: money DUK = sum(o.cash.amount of c for o in tax_pays over .. d, c in couples on o.day where o.debtor == p)
  note "MAR-1 point 2: the joint money that payments of p's own debts took, up to the end of day d"

def mar_arrive[m in events, p in parties]: num at m.day
  note "MAR-1 point 1: whose each arrival is"
  rule given v mar1_v1 = (if p == m.donee then 1 else 0) when m in gifts
  rule pay v s2_r1_lines = (if p in couples then 1 else 0) when m in pads

def own_debts[p in persons, d in days]: num DUK = sum(tax_owed[g, d] + interest_owed[g, d] for g in gifts over .. where g.donee == p)
  note "MAR-1 point 1: a spouse's own taxes, with the interest on them, are their own debts"

def paid[g in gifts, d in days]: money DUK = sum(o.cash.amount for o in tax_pays over .. d where o.case == g.case)
  note "what has been paid on the gift's tax case up to the end of day d"

def report_by[g in gifts]: date = add_months(g.day, report_months) at g.day
  note "GFT-1 point 3: six months on from possession, the same-numbered day or that month's last day"

def take_rank[w in events, p in parties]: int at w.day
  note "MAR-1 point 2: common needs take joint money first; a spouse's own debt takes their own money first, then joint money"
  rule common v mar1_v1 = (if p in couples then 0 else 1)
  rule own_debt beats common v mar1_v1 = (if p == w.debtor then -1 else (if p in couples then 0 else 1)) when w in tax_pays

def take_rest[w in events, p in parties]: int at w.day
  note "MAR-1 point 2 names no money after the money it names first"
  rule named v mar1_v1 = 0 when p in couples
  rule own_named beats unnamed v mar1_v1 = 0 when w in tax_pays and p == w.debtor
  rule unnamed beats named v mar1_v1 = ?"MAR-1 point 2 doesn't say whose own money a payment takes once the money it names is used up" when not p in couples

def tax_owed[g in gifts, d in days]: money DUK at d
  note "H-1 point 2: a tax counts as owed from the day its obligation arises (possession, GFT-1 point 1) until paid"
  rule arisen v gft1_v1 = gift_tax[g] - tax_paid[g, d] when d >= g.day
  rule not_yet v gft1_v1 = 0 when d < g.day

def tax_paid[g in gifts, d in days]: money DUK = min(paid[g, d], gift_tax[g])
  note "GFT-1 point 6: a payment goes to the tax first"

def worth[p in persons, d in days]: num DUK at d
  note "H-1: own things and money, plus half the joint money, less own debts; a debt between the spouses counts for the one owed, against the one owing; no rounding"
  rule h1 v h1_v1 = sum((bal(x, d) of p) + joint_share[p, c] * (bal(x, d) of c) for x in joint_accounts on d, c in couples on d) + sum((value(x, d) in DUK of p) + joint_share[p, c] * (value(x, d) in DUK of c) for x in vehicles on d, c in couples on d) - own_debts[p, d] - refund_share * joint_used[p, d] + refund_share * joint_used[spouse_of[p], d]

ask s2_01: gift_tax[g], report_by[g], due[g] for g in gifts over .. as known 2027-03-15

ask s2_02: tax_owed[g, 2027-06-30], interest_owed[g, 2027-06-30] for g in gifts over .. as known 2027-07-05

ask s2_03: worth[p, d] for p in persons on 2027-07-31 where p != helga, d in [2026-12-31, 2027-06-30, 2027-07-31] as known 2027-08-15

version mar1_v1
  cite mar_law
  governs 2012-01-01..
  known 2011-06-30
  refund_share = 0.5 "MAR-1 point 2: they owe the other spouse half"

version gft1_v1
  cite gft_law
  governs 2015-01-01..
  known 2014-09-15
  close_relation[spouse] = true "GFT-1 point 3"
  close_relation[child] = true "GFT-1 point 3"
  close_relation[grandchild] = true "GFT-1 point 3"
  close_relation[parent] = true "GFT-1 point 3"
  close_relation[grandparent] = true "GFT-1 point 3"
  close_relation[sibling] = true "GFT-1 point 3"
  due_days = 14 "GFT-1 point 4"
  int_rate = 10 %/year "GFT-1 point 5"
  report_months = 6 "GFT-1 point 3: within 6 months of possession"
  gift_rate: [0 DUK, 10000 DUK) = 0 "GFT-1 point 2: nothing below 10 000,00"
  gift_rate: [10000 DUK, 30000 DUK) = 5 % "GFT-1 point 2"
  gift_rate: [30000 DUK, inf) = 9 % "GFT-1 point 2"

version h1_v1
  cite house_rules
  governs 2021-05-29..
  known 2026-08-01
  joint_share[oskar, veren] = 0.5 "H-1 point 1: half the joint money"
  joint_share[talia, veren] = 0.5 "H-1 point 1: half the joint money"

version cast
  cite card_s2
  governs always
  known 2026-08-01
  persons + [helga] lives 1941-07-03..
  persons + [oskar] lives 1992-11-23..
  persons + [talia] lives 1994-02-08..
  couples + [veren] lives 2021-05-29..
  relation_of[helga, talia] = grandparent "Cast: Helga Brant, Talia's grandmother"
  spouse_of[oskar] = talia "Cast: married 2021-05-29"
  spouse_of[talia] = oskar "Cast: married 2021-05-29"
  opening[garage] = 0 car at 2026-08-01 start "Cast: we own nothing else"

version motor_lists
  cite motor_register
  known 2026-08-01
  car_list = 41300 DUK/car known 2026-08-01 at 2026-08-01 "S2-R2: list of 2026-08-01"
  car_list = 40700 DUK/car known 2026-09-01 at 2026-09-01 "S2-R2: list of 2026-09-01"
  car_list = ?"the Motor Register list of 2026-10-01 isn't kept" known 2026-10-01 at 2026-10-01
  car_list = ?"the Motor Register list of 2026-11-01 isn't kept" known 2026-11-01 at 2026-11-01
  car_list = 39200 DUK/car known 2026-12-01 at 2026-12-01 "S2-R2: list of 2026-12-01"
  car_list = ?"the Motor Register list of 2027-01-01 isn't kept" known 2027-01-01 at 2027-01-01
  car_list = ?"the Motor Register list of 2027-02-01 isn't kept" known 2027-02-01 at 2027-02-01
  car_list = ?"the Motor Register list of 2027-03-01 isn't kept" known 2027-03-01 at 2027-03-01
  car_list = ?"the Motor Register list of 2027-04-01 isn't kept" known 2027-04-01 at 2027-04-01
  car_list = ?"the Motor Register list of 2027-05-01 isn't kept" known 2027-05-01 at 2027-05-01
  car_list = 36800 DUK/car known 2027-06-01 at 2027-06-01 "S2-R2: list of 2027-06-01"
  car_list = 36400 DUK/car known 2027-07-01 at 2027-07-01 "S2-R2: list of 2027-07-01"

version gift_deed
  cite deed_d1
  known 2026-08-31
  deeds[d1] = (on: 2026-08-31, kind: gifts, leg what from world to garage amount 1 car, case: rino, donee: talia, giver: helga) "S2-D1: Helga Brant gives Talia Veren her car, handed over today"

version sd3_receipt
  cite portal_d2
  governs always
  known 2027-03-01
  filed_on[rino] = 2027-03-01 "S2-D2: sent and received 01/03/2027 08:14"

version tax_decision
  cite decision_d3
  governs always
  known 2027-04-19
  note "the decision states taxed value 41 300,00 and tax 2 017,00; the tax here is computed by GFT-1 points 1-2, which the decision applies (point 4)"
  delivered_on[rino] = 2027-04-19 "S2-D3: received 2027-04-19"

version s2_r1_rows
  cite banka_lenska
  governs 2026-08-01..2027-07-31
  known 2027-06-10
  bank[r3] = (on: 2027-06-10, kind: tax_pays, leg cash from joint to revenue amount 2017.00 DUK, case: rino, debtor: talia) known 2027-06-10 "S2-R1 row 3: REVENUE OFFICE VESK 2027/SD/0388 TAX T.VEREN"
  bank[r5] = (on: 2027-07-15, kind: tax_pays, leg cash from joint to revenue amount 21.00 DUK, case: rino, debtor: talia) known 2027-07-15 "S2-R1 row 5: REVENUE OFFICE VESK 2027/SD/0388 INTEREST T.VEREN"

version s2_r1_open
  cite banka_lenska
  known 2027-08-02
  anchor joint
  note "the first closing balance kept; Cast: joint money plus 1 500,00 of Talia's own; the joint part is the rest of the closing balance, 12 480,55 less 1 500,00"
  stated[joint] = 12480.55 DUK at 2026-12-31 end "S2-R1 row 1: closing balance"
  stated[joint] of talia = 1500.00 DUK at 2026-12-31 end "Cast: 1 500,00 of Talia's own, from before the marriage"
  stated[joint] of veren = 10980.55 DUK at 2026-12-31 end "Cast: the rest is joint money"

version s2_r1_lines
  cite banka_lenska
  governs 2026-08-01..2027-07-31
  known 2027-08-02
  pad joint from world
  note "S2-R1: the balance never fell below 9 000,00; all other money in was pay, all other money out for common needs. A pad nets them: into the account it is pay, joint (MAR-1 point 1); out of it, common needs, joint money first (MAR-1 point 2)"
  stated[joint] = 15302.10 DUK at 2027-06-09 end "S2-R1 row 2: closing balance"
  stated[joint] = 14090.42 DUK at 2027-06-30 end "S2-R1 row 4: closing balance"
  stated[joint] = 13655.87 DUK at 2027-07-31 end "S2-R1 row 6: closing balance"
