part soc_3
  tally 2
  law
  note "SOC-3 · A sole trader's social contributions. Stage 1, from the start to the end of the 6th month after the starting month: none (.1). Stage 2, the next 24 months: base 30 % of the MIN-WAGE in force on 1 January (.2). Stage 3 after: base 60 % of the year's AVG-WAGE-PROJ (.3). Rates on the base: pension 19.50 %, disability 8.00 %, accident 1.67 %, sickness 2.45 % only if elected, labour fund 2.45 % only in stage 3; each rounded (.4, GEN-5 .3). The starting month pro rata (.5). Paid by the 20th of the next month (.6)."
  note "min_wage and avg_wage_proj are gazette figures (GEN-6), each row in the version of its notice."

source soc_3 "Social Insurance Act, SOC-3 A sole trader's social contributions (tmp/cases/law/acts.md)"

index soc3_part = [pension, disability, accident, sickness, labour]

input avg_wage_proj: money DUK question "What is this year's AVG-WAGE-PROJ (gazette AVG-WAGE-PROJ)?"

input min_wage: money DUK question "What is the MIN-WAGE in force on this day (gazette MIN-WAGE)?"

input soc3_rate[c in soc3_part]: num question "What is the rate of this contribution on the base (SOC-3 .4)?"

input soc3_stage2_share: num question "What share of MIN-WAGE is the stage-2 base (SOC-3 .2)?"

input soc3_stage3_share: num question "What share of AVG-WAGE-PROJ is the stage-3 base (SOC-3 .3)?"

version soc3_v1
  cite soc_3
  governs 2018-01-01..
  known 2017-09-01
  enters 2018-01-01
  note "SOC-3 v1, in force 2018-01-01 until replaced, published 2017-09-01; governs months of activity from January 2018. Stage lengths 6 and 24 months are literals the literal rule allows (L §7.1)."
  soc3_rate[pension] = 0.195 "SOC-3 v1 .4"
  soc3_rate[disability] = 0.08 "SOC-3 v1 .4"
  soc3_rate[accident] = 0.0167 "SOC-3 v1 .4"
  soc3_rate[sickness] = 0.0245 "SOC-3 v1 .4: only where sickness insurance is elected"
  soc3_rate[labour] = 0.0245 "SOC-3 v1 .4: only in stage 3"
  soc3_stage2_share = 0.30 "SOC-3 v1 .2"
  soc3_stage3_share = 0.60 "SOC-3 v1 .3"

