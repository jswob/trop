part lazur_2025
  tally 2
  note "Bank Lazur floren account LN88 1020 0044 8813 FLR, 2025: the whole export (18 rows). The account is seen live (story), so each day's rows are known on their day: one version per day with rows, covering from that day to the day before the next such day (the last to 2025-12-31); the account opened on 2025-01-02 (B-D23)."
  note "Kessel's payments fulfil kessel_pay; each sale of florens is Piotr's own order, a movement of kind fx_sales whose attribute names the invoice it sells (the story: Kessel's florens are sold on the day they arrive, except July's and August's)."

version laz_open
  cite lazur_export
  governs 2025-01-02..2025-03-02
  known 2025-01-02
  covers lazur
  anchor lazur
  note "no row before the first payment"
  stated[lazur] = 0.00 FLR at 2025-01-02 start "B-D23: the account opened 2025-01-02"

version laz_2025_03_03
  cite lazur_export
  governs 2025-03-03..2025-03-27
  known 2025-03-03
  covers lazur
  anchor lazur
  lazr[l20250303a] = (on: 2025-03-03, kind: transfers, leg cash from inv_owed_flr[fv_002_2025] to lazur amount 1952.00 FLR, fulfils: kessel_pay[fv_002_2025]) "laz-8813-flr-2025.csv line 2 incoming transfer KESSEL LENIA SP. FV 002/2025"
  lazr[l20250303b] = (on: 2025-03-03, kind: fx_sales, leg cash from lazur to world amount 1952.00 FLR, inv: fv_002_2025) "laz-8813-flr-2025.csv line 3 FX sale 1952.00 FLR at 4.1187 to 0001"
  stated[lazur] = 0.00 FLR at 2025-03-03 end "laz-8813-flr-2025.csv line 3 balance"

