part wcp_1
  tally 2
  law
  note "WCP-1 · Workplace plan contributions: the employee's basic 2 % of gross pay and up to 2 % more if declared (.2); the employer's basic 1.5 %, and up to 2.5 % more by its plan (.3); parental pay bears none; each contribution rounded to the ort (.4, GEN-5 .3); paid to the plan by the 15th of the next month; units bought at the price of the day the money is credited (.4)."

source wcp_1 "Workplace Capital Plans Act, WCP-1 Contributions (tmp/cases/law/acts.md)"

input wcp1_ee_basic: num question "What is the employee's basic contribution (WCP-1 .2)?"

input wcp1_ee_extra_max: num question "Up to what additional contribution may the employee declare (WCP-1 .2)?"

input wcp1_er_basic: num question "What is the employer's basic contribution (WCP-1 .3)?"

input wcp1_er_topup_max: num question "Up to what may the employer's plan add (WCP-1 .3)?"

version wcp1_v1
  cite wcp_1
  governs 2019-07-01..
  known 2019-01-15
  note "WCP-1 v1, in force 2019-07-01 until replaced, published 2019-01-15; governs pay paid from 2019-07-01."
  wcp1_ee_basic = 0.02 "WCP-1 v1 .2"
  wcp1_ee_extra_max = 0.02 "WCP-1 v1 .2"
  wcp1_er_basic = 0.015 "WCP-1 v1 .3"
  wcp1_er_topup_max = 0.025 "WCP-1 v1 .3"
