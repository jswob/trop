part rec_log
  tally 2
  note "Jan's log (records/dziennik-jana.csv): one row a day from 2024-07-01, where he slept (dom at home, marrenburg, wyjazd away on holiday), whether he was in Rosvald at any time of the day (rv) and whether he worked (wk). Kept daily, so each row is known on its day."

version jan_log
  cite dziennik
  governs always
  known 2024-07-01
  night[2024-07-01] = (sl: dom, rv: true, wk: true) known 2024-07-01 "dziennik-jana.csv line 2: dom; tak; tak"
