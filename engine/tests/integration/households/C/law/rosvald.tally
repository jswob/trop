part rosvald
  tally 2
  law
  note "The law of Rosvald that household C meets (tmp/cases-holdout/law/rosvald.md) and its gazette figures (rosvald-gazette.csv): business days (RGP-1), rounding (RGP-2: to the cent, half to even, only where named), the wage tax (RWT-1 – RWT-6), the worker's contribution (RSI-2) and the child benefit (RFF-1, RFF-2). The defs that apply it are in rosvald_pay.tally and benefit.tally."
  note "The tax year runs 1 April – 31 March (RWT-1 .2): rv_year is a year index from 04-01, its key 2024 the tax year 2024/25."

source rosvald_law "The law of Rosvald (tmp/cases-holdout/law/rosvald.md)"

source rosvald_gazette "Rosvald's gazette figures (tmp/cases-holdout/law/rosvald-gazette.csv)"

index rv_year = year 2024..2026 from 04-01
  note "Rosvald's tax years 2024/25, 2025/26, 2026/27 (RWT-1 .2)"

index rv_class = [class1, class2]

input rv_holidays: calendar question "Which days are Rosvald's business days (RGP-1)?"

input rwt_allow[c in rv_class, y in rv_year]: money FLR question "What is this class's monthly allowance in this tax year (RWT-4 .3, RWT-ALLOW)?"

input rwt_edge1[y in rv_year]: money FLR question "What is the upper edge of the 10 % band in this tax year (RWT-3 .3, RWT-EDGE1)?"

input rwt_edge2[y in rv_year]: money FLR question "What is the upper edge of the 24 % band in this tax year (RWT-3 .3, RWT-EDGE2)?"

input rwt_r1: num question "What is the wage tax's rate up to the first edge (RWT-3 .3)?"

input rwt_r2: num question "What is the wage tax's rate between the edges (RWT-3 .3)?"

input rwt_r3: num question "What is the wage tax's rate above the second edge (RWT-3 .3)?"

input rwt_presence_min: int question "How many days of presence let a worker claim a yearly assessment (RWT-6 .1)?"

input rwt_refund_days: int question "Within how many days of the decision is a refund paid (RWT-6 .4)?"

input rwt_step: money FLR question "To what step is the taxable pay rounded down (RWT-3 .2, RWT-6 .2)?"

input rsi_rate: num question "What is the worker's contribution rate (RSI-2 .1)?"

input rsi_ceil[y in year]: money FLR question "What is the monthly contribution ceiling of this calendar year (RSI-2 .1, RSI-CEIL)?"

input rff_child[y in year]: money FLR question "What is the monthly child benefit in this calendar year (RFF-1 .1, RFF-CHILD)?"

version rgp1_v1
  cite rosvald_law
  governs 2015-01-01..
  known 2014-06-02
  note "RGP-1 v1, in force 2015-01-01 until replaced, published 2014-06-02"
  rv_holidays = calendar(weekends [sat, sun], yearly [01-01, 05-01, 06-14, 10-03, 12-24, 12-25, 12-26, 12-31]) "RGP-1 v1 .1: Monday to Friday, except 1 January, 1 May, 14 June, 3 October, 24, 25, 26 and 31 December"

version rwt_v1
  cite rosvald_law
  governs always
  known 2014-09-01
  note "RWT-3, RWT-6 v1, published 2014-09-01; RSI-2 v1"
  rwt_r1 = 0.10 "RWT-3 v1 .3: 10 % up to RWT-EDGE1"
  rwt_r2 = 0.24 "RWT-3 v1 .3: 24 % of the part above it up to RWT-EDGE2"
  rwt_r3 = 0.38 "RWT-3 v1 .3: 38 % of the part above that"
  rwt_presence_min = 183 "RWT-6 v1 .1: at least 183 days of presence"
  rwt_refund_days = 14 "RWT-6 v1 .4: refunded within 14 days of the decision"
  rsi_rate = 0.135 "RSI-2 v1 .1: 13.50 % of each payment's gross"
  rwt_step = 10.00 "RWT-3 v1 .2, RWT-6 v1 .2: rounded down to a whole 10 FLR"

version rv_fig_2024
  cite rosvald_gazette
  governs always
  known 2023-11-30
  rsi_ceil[2024] = 7500.00 known 2023-12-14 "rosvald-gazette.csv line 14 RSI-CEIL-2024"
  rff_child[2024] = 210.00 known 2023-11-30 "rosvald-gazette.csv line 17 RFF-CHILD-2024"

version rv_fig_2024_25
  cite rosvald_gazette
  governs always
  known 2024-02-15
  rwt_allow[class1, 2024] = 950.00 "rosvald-gazette.csv line 2 RWT-ALLOW1-2024/25"
  rwt_allow[class2, 2024] = 1700.00 "rosvald-gazette.csv line 3 RWT-ALLOW2-2024/25"
  rwt_edge1[2024] = 1200.00 "rosvald-gazette.csv line 4 RWT-EDGE1-2024/25"
  rwt_edge2[2024] = 4000.00 "rosvald-gazette.csv line 5 RWT-EDGE2-2024/25"

