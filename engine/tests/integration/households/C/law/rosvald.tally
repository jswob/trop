  rwt_allow[class1, 2026] = 1000.00 "rosvald-gazette.csv line 10 RWT-ALLOW1-2026/27"
  rwt_allow[class2, 2026] = 1790.00 "rosvald-gazette.csv line 11 RWT-ALLOW2-2026/27"
  rwt_edge1[2026] = 1280.00 "rosvald-gazette.csv line 12 RWT-EDGE1-2026/27"
  rwt_edge2[2026] = 4200.00 "rosvald-gazette.csv line 13 RWT-EDGE2-2026/27"
