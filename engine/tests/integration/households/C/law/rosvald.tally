  rwt_allow[class2, 2025] = 1750.00 "rosvald-gazette.csv line 7 RWT-ALLOW2-2025/26"
  rwt_edge1[2025] = 1250.00 "rosvald-gazette.csv line 8 RWT-EDGE1-2025/26"
  rwt_edge2[2025] = 4100.00 "rosvald-gazette.csv line 9 RWT-EDGE2-2025/26"

version rv_fig_2026
  cite rosvald_gazette
  governs always
  known 2025-11-27
  rsi_ceil[2026] = 7900.00 known 2025-12-11 "rosvald-gazette.csv line 16 RSI-CEIL-2026"
  rff_child[2026] = 230.00 known 2025-11-27 "rosvald-gazette.csv line 19 RFF-CHILD-2026"

