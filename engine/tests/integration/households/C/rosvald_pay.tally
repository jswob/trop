part rosvald_pay
  tally 2
  note "Jan's pay in Rosvald (C-D14, C-D16, the payslips C-D20, the class notices C-D15, C-D17, C-D18) and Rosvald's wage tax on it (RWT, RSI-2), his days of presence (RWT-5, his log) and the yearly assessment (RWT-6, C-D19). A month is the month the pay is for; the payment is paid in the next month."
  note "The payslip for October 2025 is lost (story): its gross is the one whose net, by RSI-2 and RWT-3, is the net the Lazur row 'Lohn 10/2025' shows, the hours being whole (C-D14 .1): the least whole number of overtime hours whose net is that net (L §5.11, an inverse over a stepped range)."

index hours_ix = int 0..120
  note "overtime hours a month can hold, whole hours (C-D14 .1)"

input slip[m in month]: (paid date, cls key rv_class, hours int, gross money FLR, rsi money FLR, tax money FLR, net money FLR) question "What does Jan's payslip for this month say (C-D20)?"

input base_pay[m in month]: money FLR question "What is Jan's monthly base pay for this month's pay (C-D14 .1, C-D16)?"

input ot_rate[m in month]: money FLR question "What is Jan's overtime pay for an hour of this month (C-D14 .1, C-D16)?"

input lost_slip: month question "Which month's payslip is lost (story)?"

input notice_in[y in rv_year]: date question "On which day did Jan's class notice for this tax year reach the employer (C-D15, C-D17, C-D18)?"

input notice_cls[y in rv_year]: key rv_class question "Which class does Jan's class notice for this tax year give (RWT-4 .1)?"

input log_from: date question "From which day does Jan's log run?"

input rv_before_log[d in day]: bool question "Was Jan in Rosvald on this day, before his log starts (story 2024-07-01)?"

input rtb_decision[y in rv_year]: (decided date, presence_ok bool, pay money FLR, contrib money FLR, allowance money FLR, taxable money FLR, tax money FLR, withheld money FLR, refund money FLR) question "What does the RTB's decision on the yearly assessment of this tax year say (C-D19)?"

input rtb_claimed[y in rv_year]: date question "When did Jan claim the yearly assessment of this tax year (story, C-D21)?"

version contract
  cite c_d14
  governs always
  known 2024-06-10
  base_pay[2024-07..2025-03] = 4800.00 "C-D14 .1: base pay 4 800.00 FLR a month"
  ot_rate[2024-07..2025-03] = 37.50 "C-D14 .1: overtime 37.50 FLR an hour, in whole hours"

version annex_2025
  cite c_d16
  governs always
  known 2025-03-14
  base_pay[2025-04..2026-03] = 5000.00 "C-D16 2025-03-14: from the pay for April 2025, base pay 5 000.00 FLR"
  ot_rate[2025-04..2026-03] = 39.00 "C-D16 2025-03-14: overtime 39.00 FLR an hour"

version annex_2026
