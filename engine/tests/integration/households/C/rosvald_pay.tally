def paid_in[m in month, y in rv_year]: bool
  note "the pay of month m is paid in tax year y: it is paid in the next month (C-D14 .2: on the 5th of the next month, or the Rosvald business day before), and Jan works from his first day in Ostrel (C-D14)"
  rule base = m >= month_of(log_from) and m + 1 >= month_of(start_of(y)) and m + 1 < month_of(end_of(y))

def seen_net[m in month]: money FLR
  note "the net the Lazur floren side shows for the pay of month m (its row's text 'Lohn MM/YYYY')"
  rule base = sum(lf[d, s].cr for d in day, s in seq where d > end_of(m) - 1 day and d < end_of(m + 1) and lf[d, s] != none and lf[d, s].k == l_pay and lf[d, s].m == m)

def seen_paid[m in month]: date
  note "the day the Lazur floren side shows the pay of month m"
  rule base = first(d in day where d > end_of(m) - 1 day and d < end_of(m + 1) and any(lf[d, s] != none and lf[d, s].k == l_pay and lf[d, s].m == m for s in seq))

def cls_on[p in day]: key rv_class
  note "RWT-4 .1, .2: class 2 for a payment paid after the day the tax year's class notice reached the employer; class 1 otherwise"
  rule c1 = class1
  rule c2 beats c1 = notice_cls[rvy[p]] when p > notice_in[rvy[p]]

def rvy[p in day]: key rv_year
  note "RWT-1 .2: the tax year in which a payment is paid"
  rule base = first(y in rv_year where p >= start_of(y) and p < end_of(y))

def rsi_of[m in month, g in hours_ix]: money FLR
  note "RSI-2 .1: 13.50 % of the gross, up to the ceiling of the calendar year of payment, to the cent, half to even (RGP-2 .1); the gross with g hours of overtime, paid on the day the Lazur row shows"
  rule base = round(rsi_rate * min(gross_h[m, g], rsi_ceil[year_of(seen_paid[m])]), minor(FLR), half-even)

def gross_h[m in month, g in hours_ix]: money FLR
  note "C-D14 .1: base pay and overtime in whole hours"
  rule base = base_pay[m] + ot_rate[m] * g

def taxable_h[m in month, g in hours_ix]: money FLR
  note "RWT-3 .2: gross less the contribution less the class's monthly allowance, rounded down to a whole 10 FLR, never below 0"
  rule base = max(0 FLR, round(gross_h[m, g] - rsi_of[m, g] - rwt_allow[cls_on[seen_paid[m]], rvy[seen_paid[m]]], rwt_step, floor))

def tax_h[m in month, g in hours_ix]: money FLR
  note "RWT-3 .3: 10 % to RWT-EDGE1, 24 % to RWT-EDGE2, 38 % above, of the tax year of payment; rounded down to a whole floren"
  rule base = round(rwt_r1 * min(taxable_h[m, g], rwt_edge1[rvy[seen_paid[m]]]) + rwt_r2 * max(0 FLR, min(taxable_h[m, g], rwt_edge2[rvy[seen_paid[m]]]) - rwt_edge1[rvy[seen_paid[m]]]) + rwt_r3 * max(0 FLR, taxable_h[m, g] - rwt_edge2[rvy[seen_paid[m]]]), 1, floor)

def net_h[m in month, g in hours_ix]: money FLR = gross_h[m, g] - rsi_of[m, g] - tax_h[m, g]

def lost_hours[m in month]: int
  note "the least whole number of overtime hours whose net is the net the Lazur row shows (an inverse, L §5.11)"
  rule base = min(g for g in hours_ix where net_h[m, g] == seen_net[m])

def pay_gross[m in month]: money FLR
  note "the gross of the pay for month m: the payslip's, or for the lost slip the one the Lazur net gives"
  rule slip = slip[m].gross
  rule lost beats slip = gross_h[m, lost_hours[m]] when m == lost_slip

def pay_rsi[m in month]: money FLR
  rule slip = slip[m].rsi
  rule lost beats slip = rsi_of[m, lost_hours[m]] when m == lost_slip

def pay_tax[m in month]: money FLR
  rule slip = slip[m].tax
  rule lost beats slip = tax_h[m, lost_hours[m]] when m == lost_slip

def pay_net[m in month]: money FLR
  rule slip = slip[m].net
  rule lost beats slip = seen_net[m] when m == lost_slip

def pay_day[m in month]: date
  rule slip = slip[m].paid
  rule lost beats slip = seen_paid[m] when m == lost_slip

def pay_class[m in month]: key rv_class
  rule slip = slip[m].cls
  rule lost beats slip = cls_on[seen_paid[m]] when m == lost_slip

def in_rv[d in day]: bool
  note "RWT-5 .1: a day on which Jan was in Rosvald at any time: his log from its first day, the story before it"
  rule log = night[d].rv
  rule before beats log = rv_before_log[d] when d < log_from

def presence[y in rv_year]: int
  note "RWT-5 .1: the days of presence in the tax year"
  rule base = count(d in day where d >= start_of(y) and d < end_of(y) and in_rv[d])

def yr_gross[y in rv_year]: money FLR = sum(pay_gross[m] for m in month where paid_in[m, y])

def yr_rsi[y in rv_year]: money FLR = sum(pay_rsi[m] for m in month where paid_in[m, y])

def yr_withheld[y in rv_year]: money FLR = sum(pay_tax[m] for m in month where paid_in[m, y])

def yr_class[y in rv_year]: key rv_class
  note "RWT-6 .2: the worker's class on the year's last day"
  rule base = cls_on[end_of(y) - 1 day]

def yr_taxable[y in rv_year]: money FLR
  note "RWT-6 .2: the year's gross less the year's contributions less 12 times the monthly allowance of the class on the year's last day, rounded down to a whole 10 FLR, never below 0"
  rule base = max(0 FLR, round(yr_gross[y] - yr_rsi[y] - lifted[twelve] * rwt_allow[yr_class[y], y], rwt_step, floor))

def yr_tax[y in rv_year]: money FLR
  note "RWT-6 .3: RWT-3 .3 with each edge taken 12 times, rounded down to a whole floren"
  rule base = round(rwt_r1 * min(yr_taxable[y], lifted[twelve] * rwt_edge1[y]) + rwt_r2 * max(0 FLR, min(yr_taxable[y], lifted[twelve] * rwt_edge2[y]) - lifted[twelve] * rwt_edge1[y]) + rwt_r3 * max(0 FLR, yr_taxable[y] - lifted[twelve] * rwt_edge2[y]), 1, floor)

def yr_refund[y in rv_year]: money FLR
  note "RWT-6 .1, .4: what the assessment gives: the tax withheld less the yearly tax (positive: refunded within 14 days of the decision; negative: payable within 30 days); none where the days of presence are under 183, since then no claim may be made"
  rule base = yr_withheld[y] - yr_tax[y] when presence[y] >= rwt_presence_min
  rule short = none when presence[y] < rwt_presence_min

def refund_seen[y in rv_year]: money FLR
  note "the refund the Lazur floren side shows from the RTB for the tax year (the row's text names it)"
  rule base = sum(lf[d, s].cr for d in day, s in seq where d >= rtb_claimed[y] and lf[d, s] != none and lf[d, s].k == l_rtb)
