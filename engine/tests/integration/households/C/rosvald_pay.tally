  governs always
  known 2026-03-13
  base_pay[2026-04..2029-12] = 5150.00 "C-D16 2026-03-13: from the pay for April 2026, base pay 5 150.00 FLR"
  ot_rate[2026-04..2029-12] = 40.25 "C-D16 2026-03-13: overtime 40.25 FLR an hour"

version notice_2024
  cite c_d15
  governs always
  known 2024-07-01
  notice_in[2024] = 2024-07-01 "C-D15: received 2024-07-01 (employer's stamp)"
  notice_cls[2024] = class2 "C-D15: married, living with a child under 16; class 2 requested"

version notice_2025
  cite c_d17
  governs always
  known 2025-05-20
  notice_in[2025] = 2025-05-20 "C-D17: received 2025-05-20 (employer's stamp)"
  notice_cls[2025] = class2 "C-D17: class 2 requested"

version notice_2026
