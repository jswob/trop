  governs always
  known 2026-04-01
  notice_in[2026] = 2026-04-01 "C-D18: received 2026-04-01 (employer's stamp)"
  notice_cls[2026] = class2 "C-D18: class 2 requested"

version log_start
  cite story
  governs always
  known 2024-07-01
  log_from = 2024-07-01 "story § What happened, 2024-07-01; the log has one row a day from 2024-07-01"
  rv_before_log[2024-01-01..2024-06-30] = false "story 2024-07-01: before today he hadn't been in Rosvald at all in 2024"
  lost_slip = 2025-10 "story: Jan's payslip for October 2025 is lost; C-D20: the slip for October 2025 is missing"

version rtb_2024_25
  cite c_d19
  governs always
  known 2025-09-12
  rtb_decision[2024] = (decided: 2025-09-10, presence_ok: true, pay: 40462.50, contrib: 5462.44, allowance: 20400.00, taxable: 14600.00, tax: 1488.00, withheld: 3782.00, refund: 2294.00) "C-D19: claim filed 2025-06-12; at least 183 days; pay 40 462.50; contributions 5 462.44; allowance 20 400.00; taxable 14 600.00; yearly tax 1 488.00; withheld 3 782.00; refund 2 294.00 FLR"

version rtb_claims
  cite story
  governs always
  known 2025-06-12
  rtb_claimed[2024] = 2025-06-12 "story 2025-06-12: Jan claims Rosvald's assessment for 2024/25"
  rtb_claimed[2025] = 2026-07-14 known 2026-07-16 "story 2026-07-14, C-D21: claim received 2026-07-14"

