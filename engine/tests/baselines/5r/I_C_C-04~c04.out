  pinned: gift_used[y] = 0 DUK for y in year
  pinned: gift_used[y] = t for t in tl2[y, f] .. tu2[y, f] step 1 DUK where t * lifted[ten] >= bases_before[y] - due[y, f] as if {gift_used[y] = t}, y in year
  pinned: gift_used[y] = tl0[y, f] for y in year, f in filing
  pinned: gift_used[y] = tl1[y, f] for y in year, f in filing
  pinned: gift_used[y] = tu0[y] for y in year
  pinned: gift_used[y] = tu1[y, f] for y in year, f in filing
  law date 2026-09-30, cut 2026-09-30
