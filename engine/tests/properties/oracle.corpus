source s "invented"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2024-12-31..
place other: accounts PLN lives 2024-12-31..
place world: outside lives 1900-01-01..
input amt: money PLN
input w: date
input dx: date
input nz: int
input dz: date
move pw: transfers
  on w
  leg cash from world to konto amount amt
move px: transfers
  on dx
  leg cash from world to other amount amt
move pz: transfers
  on dz
  leg cash from world to konto amount round(amt / nz, minor(PLN), half-even)
version v
  cite s
  governs always
  known 2024-12-31
  amt = 100.00 PLN "s"
  w = window(2026-03-28, 2026-04-03) "s"
  dx = 2026-03-31 "s"
  nz = 0 "s"
  dz = 2026-04-04 "s"
  opening[konto] = 500.00 PLN at 2026-01-01 start "s"
  opening[other] = 500.00 PLN at 2026-01-01 start "s"
