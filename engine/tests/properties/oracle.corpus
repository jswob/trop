o_rd_comp_2.tally,11692:17:o_rd_comp_2.tally,11664:model o_rd_comp_2
  tally 2
  on 2026-07-19
  start 2026-01-01
  end 2027-12-31
source s "invented"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2024-12-31..
place other: accounts PLN lives 2024-12-31..
place world: outside lives 1900-01-01..
input amt: money PLN
input w: date
input dx: date
input bi: date
input bm: date
input bo: date
input da: date
input db: date
input di: date
input ei: date
input eo: date
input k: int
input mn: int
input mp: int
input nn: int
input np: int
input yn: int
input yp: int
input y: date
input len: calendar
def wc: date
  rule base = w
def wc2: date
  rule base = w
version v
  cite s
  governs always
  known 2024-12-31
  amt = 100.00 PLN "s"
  w = window(2026-05-12, 2026-05-17) "s"
  dx = 2026-05-14 "s"
  bi = 1996-05-14 "s"
  bm = 2024-05-14 "s"
  bo = 1996-08-22 "s"
  da = 2026-06-06 "s"
  db = 2026-04-26 "s"
  di = 2026-05-14 "s"
  ei = 2036-05-14 "s"
  eo = 2036-08-22 "s"
  k = 6 "s"
  mn = -6 "s"
  mp = 4 "s"
  nn = -35 "s"
  np = 35 "s"
  yn = -2 "s"
  yp = 3 "s"
  y = 2000-01-01 "s"
  len = calendar(weekends [sat, sun], yearly [01-01, 12-25]) "s"
  opening[konto] = 500.00 PLN at 2026-01-01 start "s"
  opening[other] = 500.00 PLN at 2026-01-01 start "s"
