,21:spelling/U:rec/REC-07,15:control:reprint,1:0,1739:--- m.tally
model rec07
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31

source card "REC-07 card: its rules"

source fund_prices "REC-07 card: the fund's recorded price at the start of each year, years 0-6"

source plan "REC-07 card: the plan, 1 000.00 at the start of each of 3 years"

unit DUK: currency minor 0.01

unit fu "a unit of the fund"

index yr = int 0..6

input buy: money DUK

input plan_years: int

input price[y in yr]: num DUK/fu

def end_value[s in yr]: money DUK at reader
  rule replay v card_rules = round(units_bought[s] * price[s + plan_years], minor(DUK), half-up)

def units_bought[s in yr]: num fu = sum(buy / price[k] for k in yr where k >= s and k < s + plan_years) at reader

ask best: argmax(end_value[s] for s in yr where s + plan_years <= last(k in yr)) ties by pos(s), max(end_value[s] for s in yr where s + plan_years <= last(k in yr)) law 2026-10-25

ask ends: end_value[s] for s in yr where s + plan_years <= last(k in yr) law 2026-10-25

ask worst: argmin(end_value[s] for s in yr where s + plan_years <= last(k in yr)) ties by pos(s), min(end_value[s] for s in yr where s + plan_years <= last(k in yr)) law 2026-10-25

version card_rules
  cite card
  governs always
  known 2026-01-01

version plan_v
  cite plan
  governs always
  known 2026-01-01
  buy = 1 000 "1 000.00 a year"
  plan_years = 3 "three years of buying, valued at the start of the fourth"

version price_rows
  cite fund_prices
  governs always
  known 2026-01-01
  price[0] = 100 "year 0"
  price[1] = 120 "year 1"
  price[2] = 90 "year 2"
  price[3] = 111 "year 3"
  price[4] = 130 "year 4"
  price[5] = 100 "year 5"
  price[6] = 150 "year 6"
sha256 3d95020d9559d79335c994e80e635f048eeb25118dba996b1e350f25f805e9f9
,23:spelling/U:time/TIME-01,10:base:probe,1:1,36:refused: REQ-ASK no ask zz_m0_probe
,23:spelling/U:time/TIME-01,12:base:reprint,1:0,1450:--- m.tally
model time01
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31
  note "Probe TIME-01: a purchase known only to the month, on a 5-year clock that ends in that month."

source probe_card "Probe card TIME-01 (made-up story and rules)"

unit DUK: currency minor 0.01

index lot = [l1]

input bought[l in lot]: date

input cgt_rate: num

input hold_years: int

input lot_cost[l in lot]: money DUK

input proceeds[l in lot]: money DUK

input sold[l in lot]: date

def exempt[l in lot]: bool at reader
  note "rule 1: exempt if the sale falls after the day 5 years from the purchase day (same day number; a month lacking it, its last day)"
  rule base v card = sold[l] > add_years(bought[l], hold_years)

def gain[l in lot]: money DUK = proceeds[l] - lot_cost[l] at reader

def tax[l in lot]: num DUK at reader
  note "rule 2: otherwise taxed at 19 %"
  rule base v card = cgt_rate * gain[l]
  rule exempt_sale beats base v card = 0 when exempt[l]

ask q_l1: gain[l1], tax[l1] law 2026-10-25

version card
  cite probe_card
  governs always
  known 2026-10-25
  bought[l1] = window(2019-03-01, 2019-03-31) "father's notes: lot L1, 10 units, bought in March 2019"
  cgt_rate = 0.19 "rule 2"
  hold_years = 5 "rule 1"
  lot_cost[l1] = 1 000 "father's notes"
  proceeds[l1] = 1 600 "story: sold for 1 600.00"
  sold[l1] = 2024-03-14 "story: sold on 14 March 2024"
sha256 686d893ef413d3713a6f6362670fbcad2813b5bf880107f18a2b1bb3064a79ab
