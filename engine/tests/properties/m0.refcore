  cite probe_card
  governs always
  known 2023-01-01
  note "Stipulations, known from the model's start (L §4.5)."
  abroad_limit = 183 "(a): above 183 days abroad"
  days_abroad[2024] = ?"How many days was Marek abroad in 2024? The field is blank on form F-12." "form F-12 for 2024, field days abroad"
  lot_on[g1] = 2023-01-10 "(b): lot G1, account X"
  lot_units[g1] = 101 g_unit "(b): lot G1, 100 units"
  sell_day = 2024-06-28 assumed "the card gives no day for the planned sale; any day after lot G1 gives the same refusal" "(b): his plan sells 120"
  sell_units = 120 g_unit "(b): his plan sells 120"
