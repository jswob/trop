place konto: accounts DUK lives 2024-12-31..

place tax_debt: debts DUK lives 2024-12-31..

place tax_office: outside lives 2024-12-31..

input tax_due[y in tax_years]: date

input tax_for[y in tax_years]: money DUK

move tax_accrue[y in tax_years]: transfers
  on add_days(end_of(y), -1)
  for y
  leg cash from tax_debt to tax_office amount tax_for[y]
  note "rule 1: owed from the year's end"

move tax_payment[y in tax_years]: transfers
  on tax_due[y]
  for y
  leg cash from konto to tax_debt amount tax_for[y]
  note "rule 1: paid when due"

ask q_net_worth_dec31: sum(bal(x, 2024-12-31) for x in places on 2024-12-31 where not x in outside)

ask q_owed_at_end: -bal(tax_debt, 2025-03-31), tax_due[2024]
--- b.tally
part rest
  tally 2

version card_facts
  cite card
  governs always
  known 2024-12-31
  opening[konto] = 10 000 at 2024-12-31 start "story: holds 10 000.00 on 31 December 2024"
  tax_due[2024] = 2025-04-30 "story: due by 30 April 2025"
  tax_for[2024] = 1 840 "story: her tax for 2024"
