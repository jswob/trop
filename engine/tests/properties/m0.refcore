ask before_unchanged: diff (tax[y] for y in yr) in rate25 against law13 law 2026-10-25

ask whatif_2030: tax[2030] with scenario rate25 law 2026-10-25

ask whatif_total: total with scenario rate25 law 2026-10-25

version card_forecast
  cite card
  governs always
  known 2026-01-01
  gain = 10 000 "story: Ania's forecast realises a gain of 10 000.00 DUK every year 2026-2035"

version card_law
  cite card
  governs always
  known 2026-01-01
  note "the card's own law, a stipulation known from the model's start (L 4.5)"
  rate = 0.19 "story: the gains tax is 19 %"
