  mrate[7..12] = 2 %/month "story: from month 7 the rate is reset to 2 % a month"
  n_months = 12 "story: repaid in 12 monthly annuity instalments"
  overpay = 0 "story: the one overpayment is the one after month 9"
  overpay[9] = 1000 "story: after paying month 9 he overpays 1 000.00"

version card_law
  cite card
  governs always
  known 2026-01-01
  note "the card's own rules, stipulations known from the model's start (L 4.5); no items, the rules point at it"
sha256 90c198dc6860ad4c3dff052d3f96939b819e121d091a3994a1f9d0e751877041
,20:order/U:life/LIFE-03,13:control:probe,1:1,36:refused: REQ-ASK no ask zz_m0_probe
,20:order/U:life/LIFE-03,15:control:reprint,1:0,3053:--- a.tally
model life03
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31
  note "Probe LIFE-03: an annuity loan re-levelled after a rate reset and after an overpayment that keeps the end date."

source card "Probe card LIFE-03 (tmp/cases/probes/life/LIFE-03.md): story, rules 1-2 and question"

unit DUK: currency minor 0.01
--- b.tally
part rest
  tally 2

index kk = int 1..12

input loan_amount: money DUK question "How much does Piotr borrow?"

input mrate[k in kk]: rate question "What monthly rate applies in this month?"

input n_months: int question "Over how many monthly instalments is the loan repaid?"

input overpay[k in kk]: money DUK question "How much does Piotr overpay after paying this month?"

def g[k in kk]: num = pow(1 + pm[k], n_months - k + 1) at reader

def inst[k in kk]: money DUK at reader
  note "rule 2: the level instalment, re-levelled at the start, after a reset and after an overpayment, over the months left"
  rule base v card_law = if k == 1 then level[k] else if relevel[k] then level[k] else inst[k - 1]

def interest[k in kk]: money DUK at reader
  note "rule 1: the balance times the monthly rate, rounded half up to 0.01"
  rule base v card_law = round(owed_start[k] * pm[k], minor(DUK), half-up)

def level[k in kk]: money DUK at reader
  note "rule 1: the instalment level over the months left, rounded half up to 0.01"
  rule base v card_law = round(owed_start[k] * pm[k] * g[k] / (g[k] - 1), minor(DUK), half-up)

def owed_end[k in kk]: money DUK = owed_start[k] - repaid[k] - overpay[k] at reader

def owed_start[k in kk]: money DUK = if k == 1 then loan_amount else owed_end[k - 1] at reader

def pm[k in kk]: num at reader
  note "the month's rate as a number: a monthly rate over one month is the rate itself under every compounding (L 3.3, t = 1), so the code written changes nothing"
  rule base = periodic(mrate[k], month, effective)

def relevel[k in kk]: bool at reader
  note "rule 2: a reset re-levels the instalment; an overpayment lowers it, keeping the end date"
  rule base v card_law = mrate[k] != mrate[k - 1] or overpay[k - 1] > 0

def repaid[k in kk]: money DUK = inst[k] - interest[k] at reader

ask instalments: inst[1], inst[7], inst[10] law 2026-10-25

ask schedule: interest[k], repaid[k], owed_end[k] for k in [1, 2, 3, 4, 5, 6, 7, 8, 9] law 2026-10-25

version card_facts
  cite card
  governs always
  known 2026-01-01
  loan_amount = 6000 "story: Piotr borrows 6 000.00 DUK"
  mrate[1..6] = 1 %/month "story: at 1 % a month"
  mrate[7..12] = 3 %/month "story: from month 7 the rate is reset to 2 % a month"
  n_months = 12 "story: repaid in 12 monthly annuity instalments"
  overpay = 0 "story: the one overpayment is the one after month 9"
  overpay[9] = 1000 "story: after paying month 9 he overpays 1 000.00"

version card_law
  cite card
  governs always
  known 2026-01-01
  note "the card's own rules, stipulations known from the model's start (L 4.5); no items, the rules point at it"
sha256 0bca156cb2f9c0cc4315c34e72ffc633ae2e792a7fa10d322ede6cdabe2929ae
,22:order/U:own/OWN-11/p06,11:whole:probe,1:1,36:refused: REQ-ASK no ask zz_m0_probe
,22:order/U:own/OWN-11/p06,13:whole:reprint,1:0,2477:--- m.tally
model own11_p06
  tally 2
  on 2026-10-30
  start 2026-01-01
  end 2026-04-30
  note "OWN-11 P-06: first in, first out: a place kept by batch only, whose takes clause orders the batches by their day (LANGUAGE 3.6); the gain per batch is one def over (sale, batch), written once, reading what the sale took of each batch (s.units.amount of b)."

source broker "The broker's register (made up)"

source card "Probe card OWN-11 (made up): story and rules"

unit DUK: currency minor 0.01

unit fz_units "a unit of fund Z"

kind fund_buys: event certain
  leg units: fz_units
  leg cash: DUK

kind fund_sales: event certain
  leg units: fz_units
  leg cash: DUK

kind lot_accounts: place fz_units min 0
  batched
  step 1 fz_units
  takes k for w order k.batch.day

place cash_acc: accounts DUK lives 2020-01-01..

place lots: lot_accounts lives 2026-01-01..

place market: outside lives 1900-01-01..

input fund_rows: observed

def gain[s in fund_sales, b in fund_buys]: num DUK at s.day
  note "rules 2-3: the units the sale took of the batch times the sale's price a unit less the batch's cost a unit"
  rule base v card_rules = s.units.amount of b * (s.cash.amount / s.units.amount - b.cash.amount / b.units.amount)

ask q_gain: gain[s, b] for s in fund_sales over 2026, b in fund_buys over 2026

ask q_left: bal(lots, 2026-04-30) of b for b in fund_buys over 2026

ask q_total_gain: sum(gain[s, b] for s in fund_sales over 2026, b in fund_buys over 2026)

version card_rules
  cite card
  governs always
  known 2026-01-01

version cash_open
  cite card
  known 2026-01-01
  opening[cash_acc] = 10 000 at 2026-01-01 start "the cash account at the run's start"

version register_2026
  cite broker
  governs 2026-01..2026-04
  known 2026-05-04
  fund_rows[b1] = (on: 2026-01-10, kind: fund_buys, leg units from market to lots amount 12 fz_units, leg cash from cash_acc to market amount 1 260 DUK) "line b1"
  fund_rows[b2] = (on: 2026-02-10, kind: fund_buys, leg units from market to lots amount 8 fz_units, leg cash from cash_acc to market amount 920 DUK) "line b2"
  fund_rows[b3] = (on: 2026-03-10, kind: fund_buys, leg units from market to lots amount 10 fz_units, leg cash from cash_acc to market amount 1 080 DUK) "line b3"
  fund_rows[s1] = (on: 2026-04-15, kind: fund_sales, leg units from lots to market amount 15 fz_units, leg cash from market to cash_acc amount 1 830 DUK) "line s1"
