,23:spelling/U:flow/FLOW-02,10:base:probe,1:1,36:refused: REQ-ASK no ask zz_m0_probe
,23:spelling/U:flow/FLOW-02,12:base:reprint,1:0,1980:--- m.tally
model flow02
  tally 2
  on 2026-10-25
  start 2024-09-01
  end 2024-09-30
  note "FLOW-02: a car sale whose price goes to the lender, the dealer's fee and the owners."
  note "The sale is one movement of an event kind with three legs (LANGUAGE 5.7, 5.14): each leg names both ends and lands on the movement's day."

source card "Probe card FLOW-02 (made up): story and rules"

unit DUK: currency minor 0.01

kind car_sales: event certain
  leg lender: DUK
  leg fee: DUK
  leg owners: DUK

place buyer: outside lives 2024-09-01..

place car_credit: debts DUK lives 2024-09-01..

place dealer: outside lives 2024-09-01..

place owners_acc: accounts DUK lives 2024-09-01..

input dealer_fee: money DUK

input payoff_amount: money DUK

input sale_day: date

input sale_price: money DUK

def owners_amount: money DUK at reader
  note "rules 1-2: the rest of the price to the owners"
  rule base v card_rules = sale_price - payoff_amount - dealer_fee

move sale: car_sales
  on sale_day
  at sale_day
  leg lender from buyer to car_credit amount payoff_amount
  leg fee from buyer to dealer amount dealer_fee
  leg owners from buyer to owners_acc amount owners_amount
  note "rule 1: one event with legs; rule 2: they settle together, on the sale's day"

ask q_legs: flows(sale.lender, 2024-09), flows(sale.fee, 2024-09), flows(sale.owners, 2024-09)

ask q_legs_sum: check flows(sale.lender, 2024-09) + flows(sale.fee, 2024-09) + flows(sale.owners, 2024-09) == sale_price

version card_facts
  cite card
  governs always
  known 2024-09-01
  dealer_fee = 600 "story: keeps a fee of 600.00"
  opening[car_credit] = -18 350 at 2024-09-01 start "story: the credit's payoff"
  payoff_amount = 18 350 "story: the credit's payoff, 18 350.00"
  sale_day = 2024-09-15 "story: 15 September 2024"
  sale_price = 42 000 "story: for 42 000.00"

version card_rules
  cite card
  governs always
  known 2024-09-01
sha256 252a85324626c603c5609f56e89a1d90c6b4428e87d7e021c5c1d8db3670adc4
