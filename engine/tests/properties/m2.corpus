source card "generated by engine/tests/properties/gen_m2.py"
unit DUK: currency minor 0.01

kind wages: event certain
  leg cash: DUK

input bank: observed
input contract: money DUK
input slip[m in month]: money DUK
input tax_rate: num
input law_truncates: bool
input pay_dom: int
input rent_amt: money DUK
input rent_dom: int
input save_amt: money DUK
input save_dom: int

place konto: accounts DUK lives 2024-01-01..
place sav: accounts DUK lives 2024-01-01..
place employer: outside lives 1900-01-01..
place landlord: outside lives 1900-01-01..
place shops: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..

def gross[m in month]: money DUK at start_of(m)
  rule contract = contract
  rule slip beats contract v plan = slip[m] when not missing(slip[m])
def tax[m in month]: money DUK at start_of(m)
  rule half_up = round(gross[m] * tax_rate, 1, half-up)
  rule truncated beats half_up = round(gross[m] * tax_rate, 1, down) when law_truncates
def net[m in month]: money DUK = gross[m] - tax[m] at start_of(m)

move pay[m in month]: wages
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from employer to konto amount net[m]
move rent[m in month]: transfers
  on day_of(m, rent_dom)
  at start_of(m)
  leg cash from konto to landlord amount rent_amt
move save[m in month]: transfers
  on day_of(m, save_dom)
  at start_of(m)
  leg cash from konto to sav amount save_amt

