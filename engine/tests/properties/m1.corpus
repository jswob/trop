source card "generated by engine/tests/properties/gen_m1.py"

unit DUK: currency minor 0.01

kind ext: place DUK signed outside

index month = month 2025-01..2025-06

index qs = [q1, q2, q3]

place out_0: ext lives 2025-01-01..

place out_1: ext lives 2025-01-01..

place acc_0: accounts DUK lives 2025-01-01..

place acc_1: accounts DUK lives 2025-01-01..

input amt_mv_0: money DUK question "How much does mv_0 move?"

input day_mv_0: date question "On what day does mv_0 move?"

move mv_0: transfers
  on day_mv_0
  at day_mv_0
  leg cash from out_1 to acc_1 amount amt_mv_0

input amt_mv_1: money DUK question "How much does mv_1 move?"

input day_mv_1: date question "On what day does mv_1 move?"

move mv_1: transfers
  on day_mv_1
  at day_mv_1
  leg cash from out_1 to acc_1 amount amt_mv_1

input plan_amt: money DUK question "How much does the plan move a month?"

input plan_off: int

move plan[m in month]: transfers
  on add_days(start_of(m), plan_off)
  at start_of(m)
  leg cash from out_0 to acc_1 amount plan_amt

input split_amt: money DUK question "How much is split?"

input split_day: date

input split_step: money DUK

input w[k in qs]: num

def share[k in qs]: money DUK = prorata(split_amt, w[j] for j in qs, k, split_step, rest largest ties by pos(j))

move split[k in qs]: transfers
  on split_day
  at split_day
  leg cash from acc_1 to out_0 amount share[k]

input fee_base: money DUK question "What is the fee's base?"

input fee_rate: num question "What is the fee's rate?"

input fee_day: date

band tier(x: num DUK): num

def fee: money DUK
  rule base = round(fee_base * fee_rate, minor(DUK), half-up)
  rule waived beats base = 0 DUK when fee_rate == 0

def bonus: money DUK = round(fee_base * tier(fee_base), minor(DUK), half-up)

move pay_fee: transfers
  on fee_day
  at fee_day
  leg cash from acc_1 to out_1 amount fee + bonus

input ks_floor: money DUK

input ks_off: int

move ksweep[m in month]: transfers
  on add_days(start_of(m), ks_off)
  at start_of(m)
  reads acc_0
  leg cash from acc_0 to out_1 amount max(0, bal(acc_0) - ks_floor)

version facts
  cite card
  governs always
  known 2025-01-01
  w[q1] = 8
  fee_base = 1107.99
  w[q2] = 4
  plan_amt = 891.68
  day_mv_1 = 2025-02-15
  split_amt = 391.17
  fee_rate = 0
  day_mv_0 = 2025-03-13
  fee_day = 2025-02-18
  split_step = 0.01
  opening[acc_1] = 4723.20 at 2025-01-01 start
  w[q3] = 6
  amt_mv_0 = 1498.74
  plan_off = 22
  ks_off = 17
  split_day = 2025-05-02
  amt_mv_1 = 1978.04
  opening[acc_0] = 1644.44 at 2025-01-01 start
  ks_floor = 709.24
  tier: [0, 1000) = 0.01
  tier: [1000, inf) = 0.02

ask lo: low(acc_0, 2025-03-06 .. 2025-03-28) from 2025-02-15

ask mn: min(bal(acc_0, d) from 2025-02-15 for d in 2025-03-06 .. 2025-03-28 step 1 day)
