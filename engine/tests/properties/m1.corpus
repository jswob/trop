place acc_0: accounts DUK lives 2025-01-01..

place acc_1: accounts DUK lives 2025-01-01..

place acc_2: accounts DUK lives 2025-01-01..

place acc_3: accounts DUK lives 2025-01-01..

input amt_mv_0: money DUK question "How much does mv_0 move?"

input day_mv_0: date question "On what day does mv_0 move?"

move mv_0: transfers
  on day_mv_0
  at day_mv_0
  leg cash from acc_0 to acc_3 amount amt_mv_0

input amt_mv_x: money DUK question "How much does mv_x move?"

input day_mv_x: date question "On what day does mv_x move?"

move mv_x: transfers
  on day_mv_x
  at day_mv_x
  leg cash from acc_2 to acc_1 amount amt_mv_x

input plan_amt: money DUK question "How much does the plan move a month?"

input plan_off: int

move plan[m in month]: transfers
  on add_days(start_of(m), plan_off)
  at start_of(m)
  leg cash from out_0 to acc_1 amount plan_amt

input split_amt: money DUK question "How much is split?"

input split_day: date

input split_step: money DUK

input w[k in qs]: num

def share[k in qs]: money DUK = prorata(split_amt, w[j] for j in qs, k, split_step, rest largest ties by pos(j))

move split[k in qs]: transfers
  on split_day
  at split_day
  leg cash from acc_3 to out_0 amount share[k]

input fee_base: money DUK question "What is the fee's base?"

input fee_rate: num question "What is the fee's rate?"

input fee_day: date

band tier(x: num DUK): num

def fee: money DUK
  rule base = round(fee_base * fee_rate, minor(DUK), half-up)
  rule waived beats base = 0 DUK when fee_rate == 0

def bonus: money DUK = round(fee_base * tier(fee_base), minor(DUK), half-up)

move pay_fee: transfers
  on fee_day
  at fee_day
  leg cash from acc_0 to out_0 amount fee + bonus

input ks_floor: money DUK

input ks_off: int

move ksweep[m in month]: transfers
  on add_days(start_of(m), ks_off)
  at start_of(m)
  reads acc_3
  leg cash from acc_3 to acc_2 amount max(0, bal(acc_3) - ks_floor)

