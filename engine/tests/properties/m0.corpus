unit DUK: currency minor 0.01

axis refund_reading
  by_time "T: pro rata by time, months left / all months"
  by_balance "B: by the falling balance, balances still owed in the months left / balances of all months"
,,5:order,18:order/U:num/NUM-04,7:control,37:run a.tally b.tally --ask zz_m0_probe,1276:7:a.tally,431:model num04
