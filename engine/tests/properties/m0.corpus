unit DUK: currency minor 0.01

input bond_margin: num question "The card gives no bond formula: what does the bond pay over the index?"

input cpi_change[y in years]: num

input mortgage_margin: num question "The card gives no mortgage formula: what is its margin over the reference rate?"

input pension_amt[y in years]: money DUK question "The card gives no pension formula: what is the pension before indexation?"

input ref_rate[y in years]: num question "The card gives no reference rate REF."

input rent_2025: money DUK

def bond_rate[y in years]: num = cpi_change[y] + bond_margin at start_of(y)

def mortgage_rate[y in years]: num = ref_rate[y] + mortgage_margin at start_of(y)

def pension[y in years]: num DUK = pension_amt[y] * (1 + cpi_change[y]) at start_of(y)

def rent[y in years]: money DUK at start_of(y)
  rule first beats next = rent_2025 when pos(y) == 1
  rule next v lease_v = round(rent[y - 1] * (1 + cpi_change[y - 1]), minor(DUK), half-up)

ask moved: readers-of cpi_change

