  bank[r0310] = (on: 2025-03-10, kind: transfers, leg cash from world to konto amount 4000.00 DUK) "story: 10th, +4 000.00"
  bank[r0312] = (on: 2025-03-12, kind: transfers, leg cash from konto to world amount 3000.00 DUK) "story: 12th, -3 000.00"
