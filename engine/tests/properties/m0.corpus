  cite card
  governs always
  known 2026-01-01
  gain = 10000 "story: Ania's forecast realises a gain of 10 000.00 DUK every year 2026-2035"

version card_law
  cite card
  governs always
  known 2026-01-01
  note "the card's own law, a stipulation known from the model's start (L 4.5)"
  rate = 0.19 "story: the gains tax is 19 %"
