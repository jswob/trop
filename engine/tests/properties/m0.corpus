,,8:spelling,21:spelling/U:ask/ASK-01,7:control,29:run m.tally --ask zz_m0_probe,2036:7:m.tally,2020:model ask01
  tally 2
  on 2025-04-01
  start 2025-03-01
  end 2025-03-31
  note "Probe ASK-01: the first date a balance is below a floor; the month's minimum and its date."

source probe_card "Probe card ASK-01 (made-up story and rules)"

unit DUK: currency minor 0.01

index mday = day 2025-03-01..2025-03-31

place konto: accounts DUK lives 2025-03-01..

place world: outside lives 2025-03-01..

input bank: observed

input low_mark: money DUK

ask q_primitives: first(d in mday where bal(konto, d) < low_mark), min(bal(konto, d) for d in mday), argmin(bal(konto, d) for d in mday) ties by d law 2025-04-01

version card
  cite probe_card
  governs always
  known 2025-03-01
  note "Stipulations, known from the model's start (L §4.5). Rule 1, the balance after each day's rows is the day's balance, is bal(x, d) (L §5.10). The balance stays at its minimum from 25 to 27 March; the card dates the minimum on the day it is reached (25 March), so the argmin ties go to the earliest day."
  low_mark = 2000.01 "question: below 2 000.00"
  opening[konto] = 5000.00 at 2025-03-01 start "story: 5 000.00 on 1 March 2025"

version march_rows
  cite probe_card
  governs 2025-03
  known 2025-04-01
  covers konto
  note "The story's March rows, complete for the account over March."
  bank[r0305] = (on: 2025-03-05, kind: transfers, leg cash from konto to world amount 1500.00 DUK) "story: 5th, -1 500.00"
  bank[r0310] = (on: 2025-03-10, kind: transfers, leg cash from world to konto amount 4000.00 DUK) "story: 10th, +4 000.00"
  bank[r0312] = (on: 2025-03-12, kind: transfers, leg cash from konto to world amount 3000.00 DUK) "story: 12th, -3 000.00"
  bank[r0320] = (on: 2025-03-20, kind: transfers, leg cash from konto to world amount 2600.00 DUK) "story: 20th, -2 600.00"
  bank[r0325] = (on: 2025-03-25, kind: transfers, leg cash from konto to world amount 500.00 DUK) "story: 25th, -500.00"
  bank[r0328] = (on: 2025-03-28, kind: transfers, leg cash from world to konto amount 6000.00 DUK) "story: 28th, +6 000.00"
,,8:spelling,23:spelling/U:flow/FLOW-02,4:base,29:run m.tally --ask zz_m0_probe,1921:7:m.tally,1905:model flow02
  tally 2
  on 2026-10-25
  start 2024-09-01
  end 2024-09-30
  note "FLOW-02: a car sale whose price goes to the lender, the dealer's fee and the owners."
  note "The sale is one movement of an event kind with three legs (LANGUAGE 5.7, 5.14): each leg names both ends and lands on the movement's day."

source card "Probe card FLOW-02 (made up): story and rules"

unit DUK: currency minor 0.01

kind car_sales: event certain
  leg lender: DUK
  leg fee: DUK
  leg owners: DUK

place buyer: outside lives 2024-09-01..

place car_credit: debts DUK lives 2024-09-01..

place dealer: outside lives 2024-09-01..

place owners_acc: accounts DUK lives 2024-09-01..

input dealer_fee: money DUK

input payoff_amount: money DUK

input sale_day: date

input sale_price: money DUK

def owners_amount: money DUK at reader
  note "rules 1-2: the rest of the price to the owners"
  rule base v card_rules = sale_price - payoff_amount - dealer_fee

move sale: car_sales
  on sale_day
  at sale_day
  leg lender from buyer to car_credit amount payoff_amount
  leg fee from buyer to dealer amount dealer_fee
  leg owners from buyer to owners_acc amount owners_amount
  note "rule 1: one event with legs; rule 2: they settle together, on the sale's day"

ask q_legs: flows(sale.lender, 2024-09), flows(sale.fee, 2024-09), flows(sale.owners, 2024-09)

ask q_legs_sum: check flows(sale.lender, 2024-09) + flows(sale.fee, 2024-09) + flows(sale.owners, 2024-09) == sale_price

version card_facts
  cite card
  governs always
  known 2024-09-01
  dealer_fee = 600.00 "story: keeps a fee of 600.00"
  opening[car_credit] = -18350.00 at 2024-09-01 start "story: the credit's payoff"
  payoff_amount = 18350.00 "story: the credit's payoff, 18 350.00"
  sale_day = 2024-09-15 "story: 15 September 2024"
  sale_price = 42000.00 "story: for 42 000.00"

version card_rules
  cite card
  governs always
  known 2024-09-01
