unit DUK: currency minor 0.01

place broker: accounts DUK lives 2025-06-15..

place konto: accounts DUK lives 2025-06-15..

place wrapped: accounts DUK lives 2025-06-15..

input keep_floor: money DUK

input rule_dom: int

input wrapped_limit: money DUK

input wrapped_used: money DUK

def surplus: money DUK at reader
  note "A-1: what is above the floor at this point of the walk; each decision that reads it sees konto as it stands when it runs (L 5.14.1)"
  rule base = max(0, bal(konto) - keep_floor)

def wrapped_room: money DUK = max(0, wrapped_limit - wrapped_used) at reader

move to_broker[m in months]: transfers
  on day_of(m, rule_dom)
  at start_of(m)
  reads konto
  after to_wrapped
  leg cash from konto to broker amount surplus

move to_wrapped[m in months]: transfers
  on day_of(m, rule_dom)
  at start_of(m)
  reads konto
  leg cash from konto to wrapped amount min(surplus, wrapped_room)

ask q: flows(wrapped, 2025-06-15), flows(broker, 2025-06-15), bal(konto, 2025-06-15) law 2025-06-15

