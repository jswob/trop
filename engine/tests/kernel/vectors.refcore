source card "Probe card LIFE-05 (tmp/cases/probes/life/LIFE-05.md): story, rules 1-3 and question"

unit DUK: currency minor 0.01

index inv = [i7, i8, i9]

index mo = month 2023-08..2025-12

input due_day: int question "By which day of the next month is the month's VAT due?"

input full_social: money DUK question "What is the full monthly social contribution?"

input inv_due[i in inv]: date question "On what day is the invoice due?"

input inv_month[i in inv]: month question "In which month was the invoice issued?"

input inv_net[i in inv]: money DUK question "What is the invoice's net value?"

input inv_paid[i in inv]: date question "On what day did the client pay the invoice?"

input reduced_months: int question "For how many first months of the business is the social contribution reduced?"

input reduced_social: money DUK question "What is the reduced monthly social contribution?"

input rev_other[m in mo]: money DUK question "What revenue did Piotr have this month besides the listed invoices?"

input started: key mo question "In which month did the business start?"

input vat_rate: num question "What is the VAT rate?"

band health(x: money DUK): money DUK
  note "rule 3: the monthly health contribution by the year's revenue to date"

def biz_month[m in mo]: int = m - started + 1 at start_of(m)

def cash_in[m in mo]: num DUK at start_of(m)
  note "rule 1: clients pay gross; the cash is the gross of the invoices paid in the month"
  rule base v card_law = sum(inv_net[i] * (1 + vat_rate) for i in inv where month_of(inv_paid[i]) == m)

def health_due[m in mo]: money DUK at start_of(m)
  rule base v card_law = health(ytd[m])

def late[i in inv]: bool = inv_paid[i] > inv_due[i] at reader

def rev[m in mo]: money DUK = rev_other[m] + sum(inv_net[i] for i in inv where inv_month[i] == m) at start_of(m)

def social[m in mo]: money DUK at start_of(m)
  note "rule 2: reduced in the business's first months (its first month is month 1), full after"
  rule full v card_law = full_social
  rule reduced beats full v card_law = reduced_social when biz_month[m] <= reduced_months

def vat[m in mo]: num DUK at start_of(m)
  note "rule 1: 23 % of the month's invoiced revenue; the card states no rounding"
  rule base v card_law = vat_rate * rev[m]

def vat_due[m in mo]: date at start_of(m)
  note "rule 1: due by the 25th of the next month"
  rule base v card_law = day_of(m + 1, due_day)

def ytd[m in mo]: money DUK = sum(rev[k] for k in mo where year_of(k) == year_of(m) and k <= m) at start_of(m)

ask late_invoices: i for i in inv where late[i] law 2025-03-31

ask march: vat[2025-03], vat_due[2025-03], biz_month[2025-03], social[2025-03], ytd[2025-03], health_due[2025-03], cash_in[2025-03] law 2025-03-31

