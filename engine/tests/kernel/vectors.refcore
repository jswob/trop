unit DUK: currency minor 0.01

unit fund_units "a unit of fund F"

index lots = [gift_lot]

input gift_day[l in lots]: date

input giver_cost[l in lots]: money DUK

input lot_units[l in lots]: num fund_units

input price_f: num DUK/fund_units reading

input sale_day[l in lots]: date

def gain[l in lots]: num DUK = proceeds[l] - receiver_cost[l] at reader

def gain_on_giver_cost[l in lots]: num DUK = proceeds[l] - giver_cost[l] at reader

def proceeds[l in lots]: num DUK = lot_units[l] * price_f at sale_day[l]

def receiver_cost[l in lots]: num DUK at gift_day[l]
  note "rule 1: the gifted lot's cost is its value on the gift's day; what the giver paid is not read"
  rule base v card_rules = lot_units[l] * price_f

