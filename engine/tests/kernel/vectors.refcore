  box_12abcd = false "PDF p. 3, lines 12a-12d: no box checked"
  entry[b1040_1b_1h] = 0 "PDF pp. 2-3, Form 1040 lines 1b-1i: blank"
  entry[b1040_2_7] = 0 "PDF pp. 2-3, Form 1040 lines 2a-7b: blank"
  entry[b1040_13a] = 0 "PDF pp. 2-3, Form 1040 line 13a: blank"
  entry[b1040_13b] = 0 "PDF pp. 2-3, Form 1040 line 13b: blank"
  entry[b1040_17] = 0 "PDF pp. 2-3, Form 1040 line 17: blank"
  entry[b1040_21] = 0 "PDF pp. 2-3, Form 1040 lines 19-21: blank"
