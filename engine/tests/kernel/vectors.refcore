  entry[b7206_09] = 0 "PDF p. 12, Form 7206 line 9: blank"
  entry[b7206_12] = 0 "PDF p. 12, Form 7206 lines 11 and 12: blank"
  entry[b7217_05b] = 0 "PDF p. 13, Form 7217 line 5b: blank"
  f7217_basis_in = 10000 "PDF p. 13, Form 7217 line 4: $ 10,000"
  f7217_cash = 4000 "PDF p. 13, Form 7217 line 5a: $ 4,000"
  f7217_liquidating = false "PDF p. 13, Form 7217 line 1, complete liquidation: Yes ✔ No"
  filing_status = single "PDF p. 2: ✔ Single"
  hi_paid = 1000 "PDF p. 12, Form 7206 line 1: 1,000"
  itemizes = false "PDF p. 1: the forms in the scenario are Form 1040, Schedules 1, 2, C and SE, Forms 7206, 7217 and W-2, with no Schedule A"
  p2_basis[item1] = 32507 "PDF p. 14, Form 7217 Part II row 1 (b): $ 32,507"
  sc_expense[x15] = 550 "PDF p. 8, Schedule C line 15 Insurance (other than health): 550"
  sc_expense[x17] = 125 "PDF p. 8, Schedule C line 17 Legal and professional services: 125"
