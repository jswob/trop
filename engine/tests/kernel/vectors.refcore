  sc_expense[x20b] = 2500 "PDF p. 8, Schedule C line 20b Rent or lease, other business property: 2,500"
  sc_expense[x22] = 6532 "PDF p. 8, Schedule C line 22 Supplies: 6,532"
  sc_expense[x23] = 200 "PDF p. 8, Schedule C line 23 Taxes and licenses: 200"
