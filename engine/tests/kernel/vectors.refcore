  governs always
  known 2026-01-01
  note "the card's own rule, a stipulation known from the model's start, the earlier of start and on (L 4.5)"
  benefit: (-inf, 50000] = 200 "rule 1: income not more than 50 000.00: 200.00"
  benefit: (50000, 80000) = 100 "rule 1: more than 50 000.00 and less than 80 000.00: 100.00"
  benefit: [80000, inf) = 0 "rule 1: not less than 80 000.00: 0.00"

