,33:cut11/b_r1s/law/pl/benefits.tally,1827:part pl_benefits
  tally 2
  law
  note "Świadczenie wychowawcze 800+: na każde dziecko do 18 lat mieszkające w Polsce, od miesiąca wniosku albo od miesiąca urodzenia, gdy wniosek złożono w ciągu 3 miesięcy."
  note "Wycinek przykładowy; nie przeszedł bramki."

source b800_act "Ustawa o pomocy państwa w wychowywaniu dzieci (tekst jednolity)"

kind b800_pay_pays: event certain
  leg cash: any

input b800_age: int

input b800_amount: money PLN

input b800_pay_20: int
  note "lifted from an inline figure of tally 1.0.1"

input b800_window: int

input claim_800[c in person]: date question "Kiedy złożono wniosek o 800+ dla tego dziecka?"

def b800_due[c in person, m in month]: bool at start_of(m)
  note "wniosek '-': jeszcze nie złożony; wtedy świadczenia nie ma, a wniosek złożony później dopłaca miesiące wstecz przez 'arrears' swojej wersji"
  rule base v b800_2024 = is_child[c] and born[c] < end_of(m) and residence[c, m] == pl and claim_800[c] != none and m >= b800_from[c] and age(born[c], add_days(end_of(m), -1)) < b800_age

def b800_from[c in person]: month at reader
  rule base v b800_2024 = month_of(claim_800[c])
  rule early beats base v b800_2024 = month_of(born[c]) when claim_800[c] <= add_months(born[c], b800_window)

def is_child[c in person]: bool = any(parent[c, p] for p in person over ..) at reader

move b800_pay[c in person over .., m in month]: b800_pay_pays
  on if is_business(day_of(m, b800_pay_20), holidays_pl) then day_of(m, b800_pay_20) else add_business(day_of(m, b800_pay_20), 1, holidays_pl)
  at start_of(m)
  for m
  when b800_due[c, m]
  leg cash from zus to konto amount b800_amount

version b800_2024
  cite b800_act
  governs 2024..
  known 2023-08-30
  b800_age = 18 "art. 4 ust. 2"
  b800_amount = 800 "art. 5 ust. 1"
  b800_window = 3 "art. 26 ust. 2"
,33:cut11/b_r1s/law/pl/business.tally,10080:part pl_business
  tally 2
  law
  note "Jednoosobowa działalność (B2B): ryczałt, składki ZUS przedsiębiorcy (ulga na start, preferencyjne, pełne), zdrowotna na ryczałcie z rozliczeniem rocznym, VAT miesięczny."
  note "Wycinek przykładowy z kwotami prototypu; nie przeszedł bramki."

source ryczalt_act "Ustawa o zryczałtowanym podatku dochodowym od niektórych przychodów (tekst jednolity)"

source vat_act "Ustawa o podatku od towarów i usług (tekst jednolity)"

kind health_pay_pays: event certain
  leg cash: any

index form = [ryczalt, scale, linear]

index stage = [inactive, relief, preferential, standard]

index tier = [low, mid, high]

input health_settle_day_16: int
  note "lifted from an inline figure of tally 1.0.1"

input health_settle_day_19: int
  note "lifted from an inline figure of tally 1.0.1"

input health_share[t in tier]: num

input pref_share: num

input ryczalt_health_ded: num

input ryczalt_pay_20: int
  note "lifted from an inline figure of tally 1.0.1"

input ryczalt_rate: num

input standard_share: num

input vat_day_25: int
  note "lifted from an inline figure of tally 1.0.1"

input vat_rate: num

input zus_due[z in zus_part, s in stage]: bool

input zus_rate[z in zus_part]: num

input zus_pay_dom: int
  note "lifted from an inline figure of tally 1.0.1"

band health_tier(rev: num PLN): key tier
  note "próg przychodów roku dla składki zdrowotnej na ryczałcie"

def active_months[y in tax_year]: int = count(m in month where year_of(m) == y and zus_stage[m] != inactive) at start_of(y)

def health_month[m in month]: money PLN at start_of(m)
  note "składka miesięczna według przychodów od początku roku"
  rule base v health_ryczalt_2022 = round(health_rate * health_share[health_tier(rev_ytd[m])] * health_base_y[year_of(m)], minor(PLN), half-up)

def health_paid[y in tax_year]: money PLN = sum(flows(health_pay[m], start_of(m)..health_settle_day[y]) for m in month where year_of(m) == y) at start_of(y)

def health_settle[y in tax_year]: money PLN = health_year[y] - health_paid[y] at start_of(y)

def health_settle_day[y in tax_year]: date at start_of(y)
  rule base v health_ryczalt_2022 = if is_business(add_days(add_months(start_of(y), health_settle_day_16), health_settle_day_19), holidays_pl) then add_days(add_months(start_of(y), health_settle_day_16), health_settle_day_19) else add_business(add_days(add_months(start_of(y), health_settle_day_16), health_settle_day_19), 1, holidays_pl)

def health_year[y in tax_year]: money PLN at start_of(y)
  note "rozliczenie roczne: składka miesięczna według przychodów całego roku, razy miesiące działalności"
  rule base v health_ryczalt_2022 = active_months[y] * round(health_rate * health_share[health_tier(revenue_year[y])] * health_base_y[y], minor(PLN), half-up)

def invoice_gross[c in client, m in month]: money PLN = fee_net[c, m] + vat_out[c, m] at start_of(m)

def issue_day[m in month]: date = add_days(end_of(m), -1) at start_of(m)

def pay_day[c in client, m in month]: date = if is_business(add_days(issue_day[m], terms[c]), holidays_pl) then add_days(issue_day[m], terms[c]) else add_business(add_days(issue_day[m], terms[c]), 1, holidays_pl) at start_of(m)

def pit28_due[y in tax_year]: money PLN = pit28_tax[y] - sum(flows(ryczalt_pay[m], start_of(m)..return_day[y]) for m in month where year_of(m) == y) at start_of(y)

def pit28_tax[y in tax_year]: money PLN at start_of(y)
  rule base v ryczalt_2022 = round(round(max(0, revenue_year[y] - flows(zus_social_pay, y) - flows(health_pay, y) * ryczalt_health_ded), 1, half-up) * ryczalt_rate, 1, half-up)
  rule other_form beats base v ryczalt_2022 = ?"Zeznanie dla innej formy opodatkowania niż ryczałt nie jest opisane." when revenue_year[y] > 0 and tax_form[y] != ryczalt

def rev_ytd[m in month]: money PLN = sum(revenue[k] for k in month where year_of(k) == year_of(m) and k <= m) at start_of(m)

def revenue[m in month]: money PLN = sum(fee_net[c, m] for c in client over ..) at start_of(m)

def revenue_year[y in tax_year]: money PLN = sum(revenue[m] for m in month where year_of(m) == y) at start_of(y)

def ryczalt_adv[m in month]: money PLN at start_of(m)
  note "zaliczka: stawka od przychodu miesiąca po odliczeniu składek społecznych i połowy zdrowotnej zapłaconych w miesiącu"
  rule base v ryczalt_2022 = round(round(max(0, revenue[m] - flows(zus_social_pay, m) - flows(health_pay, m) * ryczalt_health_ded), 1, half-up) * ryczalt_rate, 1, half-up)
  rule other_form beats base v ryczalt_2022 = ?"Zaliczki dla innej formy opodatkowania niż ryczałt nie są opisane." when revenue[m] > 0 and tax_form[year_of(m)] != ryczalt

def vat_day[m in month]: date at start_of(m)
  rule base v vat_2026 = if is_business(add_months(day_of(m, vat_day_25), 1), holidays_pl) then add_months(day_of(m, vat_day_25), 1) else add_business(add_months(day_of(m, vat_day_25), 1), 1, holidays_pl)

def vat_due[m in month]: money PLN at start_of(m)
  rule base v vat_2026 = round(sum(vat_out[c, m] for c in client over ..) - cost_vat[m], 1, half-up)
  rule surplus beats base v vat_2026 = ?"Nadwyżka VAT naliczonego: przeniesienie na następny miesiąc czy zwrot (art. 87)?" when sum(vat_out[c, m] for c in client over ..) < cost_vat[m]

def vat_out[c in client, m in month]: money PLN at start_of(m)
  rule base v vat_2026 = round(fee_net[c, m] * vat_rate, minor(PLN), half-up)

def vat_owed[d in day]: money PLN at start_of(d)
  note "VAT należny z faktur już zapłaconych przez klientów, a jeszcze nie wpłacony do urzędu: nie nasz"
  rule base = sum(vat_out[c, m] for c in client over .., m in month where fee_net[c, m] > 0 and pay_day[c, m] <= d and vat_day[m] > d)

def zus_base[m in month]: money PLN at start_of(m)
  rule nobase v sus_rates_2026 = 0 when zus_stage[m] == inactive or zus_stage[m] == relief
  rule pref v sus_rates_2026 = round(min_wage_y[year_of(m)] * pref_share, minor(PLN), half-up) when zus_stage[m] == preferential
  rule standard v sus_rates_2026 = round(proj_wage_y[year_of(m)] * standard_share, minor(PLN), half-up) when zus_stage[m] == standard

def zus_social[m in month]: money PLN = sum(round(zus_base[m] * zus_rate[z], minor(PLN), half-up) for z in zus_part where zus_due[z, zus_stage[m]] and (z != sickness or sickness_opt)) at start_of(m)

move client_pay[c in client over .., m in month]: transfers
  on pay_day[c, m]
  at start_of(m)
  for m
  when fee_net[c, m] > 0
  leg cash from klienci to konto amount invoice_gross[c, m]

move health_pay[m in month]: health_pay_pays
  on if is_business(add_months(day_of(m, zus_pay_dom), 1), holidays_pl) then add_months(day_of(m, zus_pay_dom), 1) else add_business(add_months(day_of(m, zus_pay_dom), 1), 1, holidays_pl)
  at start_of(m)
  for m
  when zus_stage[m] != inactive
  leg cash from konto to zus amount health_month[m]

move health_settle_back[y in tax_year]: transfers
  on health_settle_day[y]
  at start_of(y)
  for y
  when health_settle[y] < 0
  leg cash from zus to konto amount -health_settle[y]

move health_settle_pay[y in tax_year]: transfers
  on health_settle_day[y]
  at start_of(y)
  for y
  when health_settle[y] > 0
  leg cash from konto to zus amount health_settle[y]

move pit28_pay[y in tax_year]: transfers
  on return_day[y]
  at start_of(y)
  for y
  when pit28_due[y] > 0
  leg cash from konto to urzad_skarbowy amount pit28_due[y]

move pit28_refund[y in tax_year]: transfers
  on add_days(return_day[y], refund_days)
  at start_of(y)
  for y
  when pit28_due[y] < 0
  leg cash from urzad_skarbowy to konto amount -pit28_due[y]

move ryczalt_pay[m in month]: transfers
  on if is_business(add_months(day_of(m, ryczalt_pay_20), 1), holidays_pl) then add_months(day_of(m, ryczalt_pay_20), 1) else add_business(add_months(day_of(m, ryczalt_pay_20), 1), 1, holidays_pl)
  at start_of(m)
  for m
  when ryczalt_adv[m] > 0
  leg cash from konto to urzad_skarbowy amount ryczalt_adv[m]

move vat_pay[m in month]: transfers
  on vat_day[m]
  at start_of(m)
  for m
  when vat_due[m] > 0
  leg cash from konto to urzad_skarbowy amount vat_due[m]

move zus_social_pay[m in month]: transfers
  on if is_business(add_months(day_of(m, zus_pay_dom), 1), holidays_pl) then add_months(day_of(m, zus_pay_dom), 1) else add_business(add_months(day_of(m, zus_pay_dom), 1), 1, holidays_pl)
  at start_of(m)
  for m
  when zus_social[m] > 0
  leg cash from konto to zus amount zus_social[m]

version health_ryczalt_2022
  cite health_act
  governs 2022..
  known 2021-11-15
  health_share[high] = 1.8 "art. 81 ust. 2i pkt 3"
  health_share[low] = 0.6 "art. 81 ust. 2i pkt 1"
  health_share[mid] = 1 "art. 81 ust. 2i pkt 2"
  health_tier: [0, 60000] = low "art. 81 ust. 2i pkt 1"
  health_tier: (60000, 300000] = mid "art. 81 ust. 2i pkt 2"
  health_tier: (300000, inf) = high "art. 81 ust. 2i pkt 3"

version ryczalt_2022
  cite ryczalt_act
  governs 2022..
  known 2021-11-15
  ryczalt_health_ded = 0.5 "art. 11 ust. 1c"
  ryczalt_rate = 0.12 "art. 12 ust. 1 pkt 2b"

version sus_rates_2026
  cite sus_act
  governs 2026..
  known 2025-12-31
  pref_share = 0.3 "art. 18a ust. 1"
  standard_share = 0.6 "art. 18 ust. 8"
  zus_due = false "poza wymienionymi niżej"
  zus_due[accident, preferential] = true "art. 12"
  zus_due[accident, standard] = true "art. 12"
  zus_due[disability, preferential] = true "art. 6"
  zus_due[disability, standard] = true "art. 6"
  zus_due[labour_fund, standard] = true "ustawa o rynku pracy, art. 255"
  zus_due[pension, preferential] = true "art. 6"
  zus_due[pension, standard] = true "art. 6"
  zus_due[sickness, preferential] = true "art. 11 ust. 2, dobrowolna"
  zus_due[sickness, standard] = true "art. 11 ust. 2, dobrowolna"
  zus_rate[accident] = 0.0167 "art. 15 ust. 1, stawka dla płatnika do 9 ubezpieczonych"
  zus_rate[disability] = 0.08 "art. 22 ust. 1 pkt b"
  zus_rate[labour_fund] = 0.0245 "ustawa o rynku pracy, art. 255"
  zus_rate[pension] = 0.1952 "art. 22 ust. 1 pkt a"
  zus_rate[sickness] = 0.0245 "art. 22 ust. 1 pkt c"

version vat_2026
  cite vat_act
  governs 2026..
  known 2025-12-31
  vat_rate = 0.23 "art. 146ef ust. 1"
,31:cut11/b_r1s/law/pl/common.tally,4896:part pl_common
  tally 2
  law
  note "Wskaźniki wspólne: płaca minimalna, prognozowane przeciętne wynagrodzenie, podstawa zdrowotnej, kalendarz świąt, termin zeznania rocznego."
  note "Wycinek przykładowy z kwotami prototypu; nie przeszedł bramki (OPERATIONS §3)."

source dz_2025_1242 "Rozporządzenie RM w sprawie minimalnego wynagrodzenia za pracę w 2026 r., Dz.U. 2025 poz. 1242"

source health_act "Ustawa o świadczeniach opieki zdrowotnej finansowanych ze środków publicznych (tekst jednolity)"

source holidays_act "Ustawa z 18 stycznia 1951 r. o dniach wolnych od pracy (tekst jednolity)"

source mp_2025_1206 "Obwieszczenie w sprawie prognozowanego przeciętnego wynagrodzenia na 2026 r., M.P. 2025 poz. 1206"

source mp_2026_117 "Komunikat Prezesa GUS o przeciętnym wynagrodzeniu w IV kwartale 2025 r., M.P. 2026 poz. 117"

source ordynacja "Ustawa Ordynacja podatkowa (tekst jednolity)"

source pit_act "Ustawa o podatku dochodowym od osób fizycznych (tekst jednolity)"

source sus_act "Ustawa o systemie ubezpieczeń społecznych (tekst jednolity)"

index zus_part = [pension, disability, sickness, accident, labour_fund]

input health_base_wage: money PLN question "Ile wynosi przeciętne wynagrodzenie w IV kwartale poprzedniego roku (podstawa składki zdrowotnej)?"

input health_rate: num

input holidays_pl: calendar

input min_wage: money PLN question "Ile wynosi płaca minimalna w tym roku?"

input proj_wage: money PLN question "Ile wynosi prognozowane przeciętne wynagrodzenie na ten rok?"

input refund_days: int

input return_day_16: int
  note "lifted from an inline figure of tally 1.0.1"

input wage_growth: num

def health_base_y[y in tax_year]: money PLN at start_of(y)
  note "opublikowana kwota roku; bez niej rzut z poprzedniego roku"
  rule projected beats published v wage_fc_2026 = round(health_base_y[y - 1] * (1 + wage_growth), minor(PLN), half-up) when missing(health_base_wage) and pos(y) > 1
  rule published = health_base_wage

def min_wage_y[y in tax_year]: money PLN at start_of(y)
  note "opublikowana kwota roku; bez niej rzut z poprzedniego roku"
  rule projected beats published v wage_fc_2026 = round(min_wage_y[y - 1] * (1 + wage_growth), minor(PLN), half-up) when missing(min_wage) and pos(y) > 1
  rule published = min_wage

def proj_wage_y[y in tax_year]: money PLN at start_of(y)
  note "opublikowana kwota roku; bez niej rzut z poprzedniego roku"
  rule projected beats published v wage_fc_2026 = round(proj_wage_y[y - 1] * (1 + wage_growth), minor(PLN), half-up) when missing(proj_wage) and pos(y) > 1
  rule published = proj_wage

def return_day[y in tax_year]: date at start_of(y)
  note "30 kwietnia roku następnego, przesunięty na dzień roboczy"
  rule base v pit_return_2022 = if is_business(add_days(add_months(start_of(y), return_day_16), -1), holidays_pl) then add_days(add_months(start_of(y), return_day_16), -1) else add_business(add_days(add_months(start_of(y), return_day_16), -1), 1, holidays_pl)

version health_2022
  cite health_act
  governs 2022..
  known 2021-11-15
  health_rate = 0.09 "art. 79 ust. 1"

version pit_return_2022
  cite pit_act
  governs 2022..
  known 2022-06-24
  note "termin zeznania rocznego, art. 45 ust. 1"

version min_wage_2026
  cite dz_2025_1242
  governs 2026
  known 2025-09-15
  min_wage = 4806 "§ 1"

version proj_wage_2026
  cite mp_2025_1206
  governs 2026
  known 2025-12-19
  proj_wage = 9420 "pkt 1"

version holidays_2026_2030
  cite holidays_act
  governs 2026..2030
  known 2025-12-31
  holidays_pl = calendar(weekends [sat, sun], added [2026-01-01, 2026-01-06, 2026-04-06, 2026-05-01, 2026-06-04, 2026-11-11, 2026-12-24, 2026-12-25, 2027-01-01, 2027-01-06, 2027-03-29, 2027-05-03, 2027-05-27, 2027-11-01, 2027-11-11, 2027-12-24, 2028-01-06, 2028-04-17, 2028-05-01, 2028-05-03, 2028-06-15, 2028-08-15, 2028-11-01, 2028-12-25, 2028-12-26, 2029-01-01, 2029-04-02, 2029-05-01, 2029-05-03, 2029-05-31, 2029-08-15, 2029-11-01, 2029-12-24, 2029-12-25, 2029-12-26, 2030-01-01, 2030-04-22, 2030-05-01, 2030-05-03, 2030-06-20, 2030-08-15, 2030-11-01, 2030-11-11, 2030-12-24, 2030-12-25, 2030-12-26]) governs 2026..2030 "art. 1 pkt 1; święta w dni robocze"

version holidays_later
  cite modeller
  governs 2031..
  known 2025-12-31
  holidays_pl = calendar(weekends [sat, sun]) assumed "kalendarz świąt po 2030 nie jest wpisany; terminy przesuwają tylko soboty i niedziele"

version refund_rule
  cite ordynacja
  governs always
  known 2025-12-31
  refund_days = 45 "art. 77b § 1 pkt 1"

version wage_fc_2026
  cite modeller
  governs 2026..
  known 2025-12-31
  note "rzut wskaźników płacowych na lata bez opublikowanej kwoty (prototyp: indeks płac +4% rocznie)"
  wage_growth = 0.04 assumed "indeks płac +4% rocznie, założenie prototypu"

version health_base_2026
  cite mp_2026_117
  governs 2026
  known 2026-02-10
  health_base_wage = 9228.64 "pkt 1"
,35:cut11/b_r1s/law/pl/employment.tally,5600:part pl_employment
  tally 2
  law
  note "Umowa o pracę: składki pracownika, zdrowotna, zaliczka PIT, zeznanie PIT-37 z ulgą na dziecko."
  note "Wycinek przykładowy z kwotami prototypu; nie przeszedł bramki."

input ee_rate[z in zus_part]: num

input kup_month: money PLN

input pit_reduction_month: money PLN

input relief_limit: money PLN

input relief_month: money PLN

input relief_months_18: int
  note "lifted from an inline figure of tally 1.0.1"

input relief_parent[c in person]: key person question "Który z rodziców odlicza ulgę na to dziecko?"

input salary[j in job, m in month]: money PLN question "Ile wynosi pensja brutto z tej pracy w tym miesiącu?"

input wage_10: int
  note "lifted from an inline figure of tally 1.0.1"

input zus_cap_30: int
  note "lifted from an inline figure of tally 1.0.1"

band pit_scale(x: num PLN): num PLN
  note "skala podatkowa, art. 27 ust. 1: podatek przed ulgami, po kwocie zmniejszającej"

def child_relief[p in person, y in tax_year]: money PLN at start_of(y)
  rule base v pit_2022 = sum(relief_months[c, y] for c in person over .. where parent[c, p] and relief_parent[c] == p) * relief_month
  rule over_limit beats base v pit_2022 = 0 when pit37_base[p, y] > relief_limit

def emp_base_capped[j in job, m in month]: money PLN = max(0, min(salary[j, m], zus_cap[year_of(m)] - emp_ytd[j, m])) at start_of(m)

def emp_cum[j in job, m in month]: money PLN = sum(emp_pit_base[j, k] for k in month where year_of(k) == year_of(m) and k <= m) at start_of(m)

def emp_health[j in job, m in month]: money PLN at start_of(m)
  rule base v health_2022 = round((salary[j, m] - emp_zus[j, m]) * health_rate, minor(PLN), half-up)

def emp_net[j in job, m in month]: money PLN = salary[j, m] - emp_zus[j, m] - emp_health[j, m] - emp_pit_adv[j, m] at start_of(m)

def emp_pit_adv[j in job, m in month]: money PLN at start_of(m)
  note "art. 32: zaliczka od narastającej podstawy, minus 1/12 kwoty zmniejszającej, do pełnych złotych"
  rule base v pit_2022 = max(0, round(pit_scale(emp_cum[j, m]) - pit_scale(emp_cum[j, m] - emp_pit_base[j, m]) - pit_reduction_month, 1, half-up))

def emp_pit_base[j in job, m in month]: money PLN at start_of(m)
  rule base v pit_2022 = round(max(0, salary[j, m] - emp_zus[j, m] - kup_month), 1, half-up)

def emp_ytd[j in job, m in month]: money PLN = sum(salary[j, k] for k in month where year_of(k) == year_of(m) and k < m) at start_of(m)

def emp_zus[j in job, m in month]: money PLN at start_of(m)
  note "emerytalna i rentowa do rocznej granicy 30-krotności, chorobowa bez granicy"
  rule base v sus_2026 = round(emp_base_capped[j, m] * ee_rate[pension], minor(PLN), half-up) + round(emp_base_capped[j, m] * ee_rate[disability], minor(PLN), half-up) + round(salary[j, m] * ee_rate[sickness], minor(PLN), half-up)

def pit37_base[p in person, y in tax_year]: money PLN at start_of(y)
  rule base v pit_2022 = round(max(0, sum(salary[j, m] - emp_zus[j, m] - (if salary[j, m] > 0 then kup_month else 0) for j in job over .., m in month where works_for[j] == p and year_of(m) == y)), 1, half-up)

def pit37_due[p in person, y in tax_year]: money PLN = pit37_tax[p, y] - sum(emp_pit_adv[j, m] for j in job over .., m in month where works_for[j] == p and year_of(m) == y) at start_of(y)

def pit37_tax[p in person, y in tax_year]: money PLN at start_of(y)
  rule abroad beats base, unused v pit_2022 = ?"Zmiana rezydencji podatkowej w roku nie jest opisana (art. 3, umowa o unikaniu podwójnego opodatkowania)." when any(residence[p, m] != pl for m in month where year_of(m) == y)
  rule base v pit_2022 = round(max(0, pit_scale(pit37_base[p, y]) - child_relief[p, y]), 1, half-up)
  rule unused beats base v pit_2022 = ?"Niewykorzystana ulga na dziecko (art. 27f ust. 8): zwrot nie jest opisany." when child_relief[p, y] > max(0, pit_scale(pit37_base[p, y]))

def relief_months[c in person, y in tax_year]: int = count(m in month where year_of(m) == y and born[c] < end_of(m) and age(born[c], add_days(end_of(m), -1)) < relief_months_18) at start_of(y)

def zus_cap[y in tax_year]: money PLN at start_of(y)
  rule base v sus_2026 = zus_cap_30 * proj_wage_y[y]

move pit37_pay[p in person over .., y in tax_year]: transfers
  on return_day[y]
  at start_of(y)
  for y
  when pit37_due[p, y] > 0
  leg cash from konto to urzad_skarbowy amount pit37_due[p, y]

move pit37_refund[p in person over .., y in tax_year]: transfers
  on add_days(return_day[y], refund_days)
  at start_of(y)
  for y
  when pit37_due[p, y] < 0
  leg cash from urzad_skarbowy to konto amount -pit37_due[p, y]

move wage[j in job over .., m in month]: transfers
  on if is_business(add_months(day_of(m, wage_10), 1), holidays_pl) then add_months(day_of(m, wage_10), 1) else add_business(add_months(day_of(m, wage_10), 1), 1, holidays_pl)
  at start_of(m)
  for m
  leg cash from pracodawcy to konto amount emp_net[j, m]

