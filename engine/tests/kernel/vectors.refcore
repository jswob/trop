index oki_asset = [pln_funds, deposits_bonds, foreign]

input ike_limit_3: int
  note "lifted from an inline figure of tally 1.0.1"

input nbp_oct_2: int
  note "lifted from an inline figure of tally 1.0.1"

input nbp_ref: num question "Ile wynosi stopa referencyjna NBP?"

input oki_exempt[a in oki_asset]: money PLN

input oki_from: month

input oki_rate_0_0001: num
  note "lifted from an inline figure of tally 1.0.1"

input oki_rate_first: num

input oki_rate_floor: num

input oki_ref_share: num

input oki_tax_pay_17: int
  note "lifted from an inline figure of tally 1.0.1"

def ike_limit[y in tax_year]: money PLN at start_of(y)
  rule base v ike_2004 = ike_limit_3 * proj_wage_y[y]

def nbp_oct[y in tax_year]: num = nbp_ref at add_days(add_months(start_of(y), -nbp_oct_2), -1)

def oki_avg[y in tax_year]: num PLN at start_of(y)
  rule base v oki_rules = sum(value(wunits[oki], d) in PLN by etf_price[month_of(d)] + bal(wcash[oki], d) for d in day where year_of(d) == y) / days_between(start_of(y), end_of(y))

def oki_rate[y in tax_year]: num at start_of(y)
  rule base v oki_2027 = oki_rate_first

def oki_tax[y in tax_year]: money PLN at start_of(y)
  rule base v oki_rules = round(max(0, oki_avg[y] - oki_exempt[oki_holds]) * oki_rate[y], 1, half-up)

move oki_tax_pay[y in tax_year]: transfers
  on if is_business(add_days(add_months(start_of(y), oki_tax_pay_17), -1), holidays_pl) then add_days(add_months(start_of(y), oki_tax_pay_17), -1) else add_business(add_days(add_months(start_of(y), oki_tax_pay_17), -1), 1, holidays_pl)
  at start_of(y)
  for y
  when oki_from != none and start_of(y) >= start_of(oki_from) and oki_tax[y] > 0
  reads wcash, wunits
  leg cash from konto to urzad_skarbowy amount oki_tax[y]

