  tally 2
  on 2026-03-15
  start 2026-01-01
  end 2026-03-31
  note "T, issue #41, G10: observations (L §5.19, E §6.1): a transfer between two places two statements cover, one row in each, each booking its own end; a link to an instance that doesn't touch the row's places and one that lacks a leg (RUN-RECORD), each at a place of its own; two rows of different versions that fulfil one instance and disagree (WARN-LEGS) beside two that agree, two of one version that disagree, and two-leg rows that agree; a row a later version restates, read before and after; covered over two versions in turn, over a span half covered, and at a cut on a version's known day; a link whose instance's when reads an assumed row, the register of judging it carried by the row that names it."

source fixture "T's fixture for S's kernel tests (invented values)"

unit PLN: currency minor 0.01

unit etf_unit "a fund unit"

kind buys: event certain
  leg cash: PLN
  leg units: etf_unit

index month = month 2026-01..2026-02

place konto: accounts PLN lives 2026-01-01..

place save: accounts PLN lives 2026-01-01..

place k2: accounts PLN lives 2026-01-01..

place k3: accounts PLN lives 2026-01-01..

place k6: accounts PLN lives 2026-01-01..

place fund: holdings etf_unit priced fund_price lives 2026-01-01..

place fund2: holdings etf_unit priced fund_price lives 2026-01-01..

place shop: outside lives 2026-01-01..

place market: outside lives 2026-01-01..

place world: outside lives 2026-01-01..

input bank: observed

input fund_price[m in month]: num PLN/etf_unit

input rent_amt: money PLN

input rent_dom: int

input fee_day: date

input fee_amt: money PLN

input buy_dom: int

input buy_units[m in month]: num etf_unit

input gift_day: date

input gift_amt: money PLN

input rare_day: date

input rare_ok: bool

input rare_amt: money PLN

move rent[m in month]: transfers
  on day_of(m, rent_dom)
  leg cash from konto to shop amount rent_amt

move fee: transfers
  on fee_day
  leg cash from konto to shop amount fee_amt

move buy[m in month]: buys
  on day_of(m, buy_dom)
  leg cash from konto to market amount round(buy_units[m] * fund_price[m], minor(PLN), half-up)
  leg units from market to fund amount buy_units[m]

move buy2[m in month]: buys
  on day_of(m, buy_dom)
  leg cash from k2 to market amount round(buy_units[m] * fund_price[m], minor(PLN), half-up)
  leg units from market to fund2 amount buy_units[m]

move gift: transfers
  on gift_day
  leg cash from world to save amount gift_amt

move rare: transfers
  on rare_day
  when rare_ok
  leg cash from k6 to shop amount rare_amt

ask q_rare_k6: bal(k6, 2026-02-28) law cut

ask q_rare_konto: bal(konto, 2026-02-28) law cut

ask q_bal: bal(konto, d), bal(save, d), bal(k2, d), bal(k3, d), bal(fund, d) for d in [2026-01-04, 2026-01-10, 2026-01-31, 2026-02-28] law cut

ask q_early: bal(konto, d), bal(save, d) for d in [2026-01-10, 2026-01-31] law cut as known 2026-02-10

ask q_cov: covered(konto, 2026-01-01 .. 2026-02-28), covered(save, 2026-01-01 .. 2026-02-28), covered(save, 2026-01-01 .. 2026-01-31) law cut

ask q_cov_before: covered(konto, 2026-01-01 .. 2026-02-28) law cut as known 2026-03-01

ask q_cov_on: covered(konto, 2026-01-01 .. 2026-02-28) law cut as known 2026-03-02

