unit DUK: currency minor 0.01

index people = [halina, zbigniew, ania, piotr, marta, kuba]

input community_member[p in people]: bool

input death_day: date

input decedent: key people

input division_day: date

input estate_share[p in people]: num

input flat_value: money DUK reading

input half: num

input keeper: key people

def keeper_pays: num DUK = sum(payout[p] for p in people where p != keeper) at reader

def payout[p in people]: num DUK at division_day
  note "rule 3: each heir's share at the division's valuation"
  rule base v card_rules = share_after[p] * flat_value

def payout_at_death[p in people]: num DUK = share_after[p] * flat_value at death_day

def share_after[p in people]: num at reader
  note "rules 1-2: the survivor's half, plus the estate's half passed in shares"
  rule base v card_rules = (if community_member[p] and p != decedent then half else 0) + half * estate_share[p]

