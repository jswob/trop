input odd_day[k in ab]: date question "When does the odd payment go out?"

input odd_amt: money PLN

input odd2_day: date question "When does the second odd payment go out?"

input odd2_amt: money PLN

input odd0_day: date question "When does nothing go out?"

input hz_day: date

input hz_amt: money PLN question "Aa: how much is the first repair?"

input ha_day: date

input ha_amt: money PLN question "Zz: how much is the second repair?"

move rent[m in month]: transfers
  on day_of(m, rent_dom)
  leg cash from konto to shop amount rent_amt

move fee: transfers
  on fee_day
  leg cash from konto to shop amount fee_amt

move short: transfers
  on part_day
  leg cash from konto to shop amount part_amt

move promise: maybe
  on prom_day
  leg cash from world to konto amount prom_amt

move promise2: maybe
  on prom2_day
  leg cash from world to konto amount prom2_amt

move flagged: transfers
  on flag_day
  when flag
  leg cash from konto to shop amount flag_amt

move flagged2[m in month]: transfers
  on day_of(m, flag2_dom)
  when flag2[m]
  leg cash from konto to shop amount flag_amt

move tip[t in tips]: transfers
  on tip_day
  leg cash from konto to shop amount tip_amt

move sweep[m in month]: transfers
  on day_of(m, sweep_dom)
  reads konto
  leg cash from konto to save amount if bal(konto) > 0 then small else big

move odd[k in ab]: transfers
  on odd_day[k]
  leg cash from k4 to shop amount odd_amt

move odd2: transfers
  on odd2_day
  leg cash from k4 to shop amount odd2_amt

move odd0: transfers
  on odd0_day
  leg cash from k4 to shop amount 0

move hz: transfers
  on hz_day
  leg cash from k5 to shop amount hz_amt

move ha: transfers
  on ha_day
  leg cash from k5 to shop amount ha_amt

ask q_res: residuals konto 2026-01 law cut

ask q_res_feb: residuals konto 2026-02 law cut

ask q_res4: residuals k4 2026-01 law cut

ask q_res5: residuals k5 2026-01 law cut

ask q_bal: bal(konto, d), bal(buffer, d), bal(save, d) for d in [2026-01-09, 2026-01-20, 2026-01-28] law cut

ask q_buf: bal(buffer, 2026-01-09) law cut

ask q_bal_early: bal(konto, 2026-01-20), bal(buffer, 2026-01-20) law cut as known 2026-02-10

ask q_res_buf: residuals buffer 2026-01 law cut

ask q_res_save: residuals save 2026-01 law cut

