unit DUK: currency minor 0.01

index heir = [ewa, jan, olek]

input advance[h in heir]: money DUK

input heir_share[h in heir]: num

input value_at_death: money DUK

input value_at_division: money DUK

def buyout[h in heir]: num DUK at reader
  rule no_share beats not_risen, risen v division_rule = none when heir_share[h] == none
  rule not_risen v division_rule = ?"What is an heir's buyout when the flat's value did not rise? The rule doesn't say." when value_at_division <= value_at_death
  rule risen v division_rule = heir_share[h] * value_at_division - advance[h] when value_at_division > value_at_death

def keeper_pays: num DUK = sum(buyout[h] for h in heir where buyout[h] != none) at reader

