  entry[b1040_32] = 0 "PDF pp. 2-3, Form 1040 lines 26-32: blank"
  entry[bs1_inc] = 0 "PDF pp. 4-5, Schedule 1 lines 1-2, 4-7 and 9: blank (lines other than 3, 10, 15, 17, 26)"
  entry[bs1_adj] = 0 "PDF pp. 4-5, Schedule 1 lines 11-14, 16, 18-23 and 25: blank (lines other than 3, 10, 15, 17, 26)"
  entry[bs2_other] = 0 "PDF pp. 6-7, Schedule 2 lines other than 4 and 21: blank"
  entry[bsc_02] = 0 "PDF p. 8, Schedule C line 2: blank"
  entry[bsc_04] = 0 "PDF p. 8, Schedule C line 4: blank"
  entry[bsc_06] = 0 "PDF p. 8, Schedule C line 6: blank"
  entry[bsc_exp_other] = 0 "PDF p. 8, Schedule C other expense lines (8-14, 16, 19, 20a, 21, 24-27b): blank"
  entry[bsc_30] = 0 "PDF p. 8, Schedule C line 30: blank"
  entry[bse_01a] = 0 "PDF pp. 10-11, Schedule SE line 1a: blank"
  entry[bse_01b] = 0 "PDF pp. 10-11, Schedule SE line 1b: blank"
  entry[bse_k1] = 0 "PDF p. 1: the forms in the scenario include no Schedule K-1"
