  policy_end = 2024-12-31 "story: the insurance, 1 200.00 for 2024"
  policy_start = 2024-01-01 "story: the insurance, 1 200.00 for 2024"
  premium = 1200 "story: an insurance, 1 200.00 DUK for 2024 paid in January"
  sold = 2024-09-15 "story: Ania and Tomek sell their car on 15 September 2024"

