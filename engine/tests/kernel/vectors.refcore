source fixture "T's fixture for S's kernel tests (invented values)"

unit DUK: currency minor 0.01

index opt = [left, right]

index yr = year 2024..2026

kind boxes: place DUK signed

input a_amt: money DUK question "What is the amount?"

input b_amt: money DUK question "What is the amount?"

input c_amt: money DUK question "Which amount applies?"

input plain: money DUK

input forever: num

input by_year[y in yr]: num

input by_two[o in opt, y in yr]: num

input lim[x in boxes]: money DUK

input timeless[o in opt]: num

input given_amt: money DUK

def told: money DUK at reader
  rule base v card = ?"a stated reason"

def same_twice: money DUK at reader
  rule base v card = a_amt + b_amt

def two_questions: money DUK at reader
  rule base v card = c_amt + a_amt

def with_stated: money DUK at reader
  rule base v card = told + c_amt + given_amt

ask q_merge: same_twice, two_questions, with_stated, given_amt law 2026-10-25

ask q_plain: plain law 2026-10-25

ask q_forever: forever

ask q_timeless: timeless[left], timeless[right]

ask q_keys: by_year[2025], by_two[left, 2025], by_two[right, 2024] law 2026-10-25

ask q_life_in: lim[short_box], lim[long_box] law 2025-03-01

ask q_life_out: lim[short_box], lim[long_box] law 2025-09-01

ask q_life_old: lim[short_box] law 2025-09-01 as known 2025-03-01

version card
  cite fixture
  governs always
  known 2024-01-01
  given_amt = 10.00 "the one amount given"
  by_two[right, 2024] = 4 "right's 2024 value"
  timeless[left] = 1 "left's value for all time"

version v_forever
  cite fixture
  known 2024-01-01
  forever = 3 governs always "a fact for all time, on its own row"

version v_boxes
  cite fixture
  known 2024-01-01
  boxes + [short_box] lives 2025-01-01..
  boxes + [long_box] lives 2024-01-01..

version v_close
  cite fixture
  known 2025-06-01
  replace boxes + [short_box] lives 2025-01-01..2025-06-30

version v_lim
  cite fixture
  governs 2025-08-01..
  known 2024-01-01
  lim[long_box] = 50.00 "long_box's limit from August 2025"
,,1:0,945:q_forever: 3
  cut 2026-10-25
q_keys: (?"by_year at 2025: no value for 2025" (by_year[2025]), ?"by_two at left, 2025: no value for 2025" (by_two[left, 2025]), 4)
  law date 2026-10-25, cut 2026-10-25
q_life_in: (?"lim at short_box: no value at 2025-03-01" (lim[short_box]), ?"lim at long_box: no value at 2025-03-01" (lim[long_box]))
  law date 2025-03-01, cut 2026-10-25
q_life_old: ?"lim at short_box: no value at 2025-09-01" (lim[short_box])
  law date 2025-09-01, cut 2025-03-01
q_life_out: (none, 50.00 DUK)
  law date 2025-09-01, cut 2026-10-25
q_merge: (?"What is the amount?" (a_amt, b_amt), ?"What is the amount?" (a_amt) ?"Which amount applies?" (c_amt), ?"Which amount applies?" (c_amt) ?"a stated reason" (told), 10.00 DUK)
  law date 2026-10-25, cut 2026-10-25
q_plain: ?"plain: no value at 2026-10-25" (plain)
  law date 2026-10-25, cut 2026-10-25
q_timeless: (1, ?"timeless at right: no value" (timeless[right]))
  cut 2026-10-25
,9:g2/ranges,2:g2,19:run g2/ranges.tally,1964:15:g2/ranges.tally,1939:model g2_ranges
  tally 2
  on 2026-10-25
  start 2024-01-01
  end 2026-12-31
  note "T, issue #41, G2: the read rule's precedence (L §4.6 steps 1 and 3): a row with a span over one with always where neither is narrower, read before and after the span starts; * over a kind's things; a thing entered after a row for every key; two ranges overlapping by one key, neither inside the other, one with a span, beside a single key inside the later one. (Inputs keyed by a stepped range or a key list aren't built at S; ranges over them are refcore gaps, T's notes; a range over a kind is LOAD-UNIT.)"

source fixture "T's fixture for S's kernel tests (invented values)"

unit DUK: currency minor 0.01

index opt = [a, b]

index n = 1..10

index yr = year 2024..2026

kind boxes: place DUK signed

input lid[x in boxes]: num

input x2[o in opt, k in n]: num

input across[x in boxes]: num

input ov[y in yr]: num

ask q_lid: lid[box_a], lid[box_b] law 2026-10-25

ask q_x2_24: x2[a, 5], x2[a, 6], x2[b, 5] law 2024-06-30

ask q_x2_25: x2[a, 5], x2[a, 6], x2[b, 5] law 2025-06-30

ask q_ov_24: ov[2024], ov[2025], ov[2026] law 2024-06-30

ask q_ov_25: ov[2024], ov[2025], ov[2026] law 2025-06-30

ask q_across: across[box_a], across[late_box] law 2026-10-25

version v_things
  cite fixture
  known 2024-01-01
  boxes + [box_a] lives 2024-01-01..
  boxes + [box_b] lives 2024-01-01..

version v_rows
  cite fixture
  governs always
  known 2024-01-01
  lid[*] = 0 "every box"
  x2[a, *] = 1 "a at every key, for all time"
  across[*] = 5 "every box there on 2024-01-01"
  ov[2026] = 9 "one year, for all time"
  ov[2024..2025] = 1 "two years, for all time"

version v_x2
  cite fixture
  governs 2025-01-01..
  known 2024-01-01
  x2[*, 5] = 2 "key 5 for every option, from 2025"
  ov[2025..2026] = 2 "two years overlapping the first two by one, from 2025"

version v_late
  cite fixture
  known 2025-02-01
  boxes + [late_box] lives 2025-02-01..
