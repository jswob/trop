  note "T, issue #41, G1: how a num and money print (L §5.18, §2.4): the shortest exact decimal, a/b with its reading aid, the aid beside more than 15 significant digits, ties at the 15th digit, magnitudes from tiny to past the machine word, both signs, signed divisors, the machine word's least value and its negation."

source fixture "T's fixture for S's kernel tests (invented values)"

unit DUK: currency minor 0.01

index w = [third, neg_seventh, big_third, tiny, sig16_up, sig16_even, int19, int21, trim, carry, neg_tiny, zero, plain, neg_divisor, both_big, half, wide, square, minword]

input top[k in w]: num

input bottom[k in w]: num

input money_in[k in w]: money DUK

def t_q[k in w]: num at reader
  note "the quotient: a/b when it doesn't terminate"
  rule base v card = top[k] / bottom[k]

def t_prod[k in w]: num at reader
  rule base v card = top[k] * bottom[k]

def t_diff[k in w]: num at reader
  rule base v card = top[k] - bottom[k]

def t_sq[k in w]: num at reader
  note "the quotient squared: a small denominator squared past 2^63"
  rule base v card = t_q[k] * t_q[k]

def t_inv[k in w]: num at reader
  note "the top over the square: a division by it (a zero square refuses, RUN-DIV)"
  rule base v card = top[k] / t_sq[k]

def t_rev[k in w]: num at reader
  note "the top negated: the machine word's least value turned past its greatest"
  rule base v card = -top[k]

def t_abs[k in w]: money DUK at reader
  note "money's absolute value: negative, zero, positive, and the machine word's least value of minor units"
  rule base v card = abs(money_in[k])

def t_net[k in w]: money DUK at reader
  rule base v card = money_in[k] - money_in[half]

def t_sign[k in w]: num DUK at reader
  note "the money's sign rule by cases: below 0 itself, 0 itself, above 0 its double"
  rule below v card = money_in[k] when money_in[k] < 0
  rule nothing v card = 0 when money_in[k] == 0
  rule above v card = money_in[k] + money_in[k] when money_in[k] > 0

ask q_values: top[k], t_q[k] for k in w law 2026-10-25

ask q_more: t_prod[k], t_diff[k], t_sq[k], t_inv[k], t_rev[k] for k in w law 2026-10-25

ask q_money: money_in[k], t_net[k], t_sign[k], t_abs[k] for k in w law 2026-10-25

version card
  cite fixture
  governs always
  known 2026-10-25
  top[third] = 1 "1/3"
  bottom[third] = 3 "1/3"
  top[neg_seventh] = -22 "a negative a/b"
  bottom[neg_seventh] = 7 "a negative a/b"
  top[big_third] = 10000000000000000000 "10^19 / 3: an aid whose exponent is past 15"
  bottom[big_third] = 3 "10^19 / 3"
  top[tiny] = 1 "a small a/b"
