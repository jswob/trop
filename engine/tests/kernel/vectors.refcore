  health_base_wage = 9228.64 "pkt 1"
,34:cut11/b_r1/law/pl/employment.tally,5600:part pl_employment
  tally 2
  law
  note "Umowa o pracę: składki pracownika, zdrowotna, zaliczka PIT, zeznanie PIT-37 z ulgą na dziecko."
  note "Wycinek przykładowy z kwotami prototypu; nie przeszedł bramki."

input ee_rate[z in zus_part]: num

input kup_month: money PLN

input pit_reduction_month: money PLN

input relief_limit: money PLN

input relief_month: money PLN

input relief_months_18: int
  note "lifted from an inline figure of tally 1.0.1"

input relief_parent[c in person]: key person question "Który z rodziców odlicza ulgę na to dziecko?"

input salary[j in job, m in month]: money PLN question "Ile wynosi pensja brutto z tej pracy w tym miesiącu?"

input wage_10: int
  note "lifted from an inline figure of tally 1.0.1"

input zus_cap_30: int
  note "lifted from an inline figure of tally 1.0.1"

band pit_scale(x: num PLN): num PLN
  note "skala podatkowa, art. 27 ust. 1: podatek przed ulgami, po kwocie zmniejszającej"

def child_relief[p in person, y in tax_year]: money PLN at start_of(y)
  rule base v pit_2022 = sum(relief_months[c, y] for c in person over .. where parent[c, p] and relief_parent[c] == p) * relief_month
  rule over_limit beats base v pit_2022 = 0 when pit37_base[p, y] > relief_limit

def emp_base_capped[j in job, m in month]: money PLN = max(0, min(salary[j, m], zus_cap[year_of(m)] - emp_ytd[j, m])) at start_of(m)

def emp_cum[j in job, m in month]: money PLN = sum(emp_pit_base[j, k] for k in month where year_of(k) == year_of(m) and k <= m) at start_of(m)

def emp_health[j in job, m in month]: money PLN at start_of(m)
  rule base v health_2022 = round((salary[j, m] - emp_zus[j, m]) * health_rate, minor(PLN), half-up)

def emp_net[j in job, m in month]: money PLN = salary[j, m] - emp_zus[j, m] - emp_health[j, m] - emp_pit_adv[j, m] at start_of(m)

def emp_pit_adv[j in job, m in month]: money PLN at start_of(m)
  note "art. 32: zaliczka od narastającej podstawy, minus 1/12 kwoty zmniejszającej, do pełnych złotych"
  rule base v pit_2022 = max(0, round(pit_scale(emp_cum[j, m]) - pit_scale(emp_cum[j, m] - emp_pit_base[j, m]) - pit_reduction_month, 1, half-up))

def emp_pit_base[j in job, m in month]: money PLN at start_of(m)
  rule base v pit_2022 = round(max(0, salary[j, m] - emp_zus[j, m] - kup_month), 1, half-up)

def emp_ytd[j in job, m in month]: money PLN = sum(salary[j, k] for k in month where year_of(k) == year_of(m) and k < m) at start_of(m)

def emp_zus[j in job, m in month]: money PLN at start_of(m)
  note "emerytalna i rentowa do rocznej granicy 30-krotności, chorobowa bez granicy"
  rule base v sus_2026 = round(emp_base_capped[j, m] * ee_rate[pension], minor(PLN), half-up) + round(emp_base_capped[j, m] * ee_rate[disability], minor(PLN), half-up) + round(salary[j, m] * ee_rate[sickness], minor(PLN), half-up)

def pit37_base[p in person, y in tax_year]: money PLN at start_of(y)
  rule base v pit_2022 = round(max(0, sum(salary[j, m] - emp_zus[j, m] - (if salary[j, m] > 0 then kup_month else 0) for j in job over .., m in month where works_for[j] == p and year_of(m) == y)), 1, half-up)

def pit37_due[p in person, y in tax_year]: money PLN = pit37_tax[p, y] - sum(emp_pit_adv[j, m] for j in job over .., m in month where works_for[j] == p and year_of(m) == y) at start_of(y)

def pit37_tax[p in person, y in tax_year]: money PLN at start_of(y)
  rule abroad beats base, unused v pit_2022 = ?"Zmiana rezydencji podatkowej w roku nie jest opisana (art. 3, umowa o unikaniu podwójnego opodatkowania)." when any(residence[p, m] != pl for m in month where year_of(m) == y)
  rule base v pit_2022 = round(max(0, pit_scale(pit37_base[p, y]) - child_relief[p, y]), 1, half-up)
  rule unused beats base v pit_2022 = ?"Niewykorzystana ulga na dziecko (art. 27f ust. 8): zwrot nie jest opisany." when child_relief[p, y] > max(0, pit_scale(pit37_base[p, y]))

def relief_months[c in person, y in tax_year]: int = count(m in month where year_of(m) == y and born[c] < end_of(m) and age(born[c], add_days(end_of(m), -1)) < relief_months_18) at start_of(y)

def zus_cap[y in tax_year]: money PLN at start_of(y)
  rule base v sus_2026 = zus_cap_30 * proj_wage_y[y]

move pit37_pay[p in person over .., y in tax_year]: transfers
  on return_day[y]
  at start_of(y)
  for y
  when pit37_due[p, y] > 0
  leg cash from konto to urzad_skarbowy amount pit37_due[p, y]

move pit37_refund[p in person over .., y in tax_year]: transfers
  on add_days(return_day[y], refund_days)
  at start_of(y)
  for y
  when pit37_due[p, y] < 0
  leg cash from urzad_skarbowy to konto amount -pit37_due[p, y]

move wage[j in job over .., m in month]: transfers
  on if is_business(add_months(day_of(m, wage_10), 1), holidays_pl) then add_months(day_of(m, wage_10), 1) else add_business(add_months(day_of(m, wage_10), 1), 1, holidays_pl)
  at start_of(m)
  for m
  leg cash from pracodawcy to konto amount emp_net[j, m]

version pit_2022
  cite pit_act
  governs 2022..
  known 2022-06-24
  kup_month = 250 "art. 22 ust. 2 pkt 1"
  pit_reduction_month = 300 "art. 32 ust. 3"
  pit_scale: [0, 120000] = x * 0.12 - 3600 "art. 27 ust. 1, pierwszy próg"
  pit_scale: (120000, inf) = 10800 + (x - 120000) * 0.32 "art. 27 ust. 1, drugi próg"
  relief_limit = 112000 "art. 27f ust. 1 pkt 1 lit. a"
  relief_month = 92.67 "art. 27f ust. 1 pkt 1: 1/6 z 556,02 zł za miesiąc"

version sus_2026
  cite sus_act
  governs 2026..
  known 2025-12-31
  ee_rate[disability] = 0.015 "art. 22 ust. 1 pkt b, część pracownika"
  ee_rate[pension] = 0.0976 "art. 22 ust. 1 pkt a, część pracownika"
  ee_rate[sickness] = 0.0245 "art. 22 ust. 1 pkt c"
,32:cut11/b_r1/law/pl/wrappers.tally,3500:part pl_wrappers
  tally 2
  law
  note "IKE: roczny limit wpłat. OKI: od 2027, podatek od średniej wartości rachunku ponad kwotę wolną, płatny do 31 maja."
  note "Wycinek przykładowy z kwotami prototypu; nie przeszedł bramki."

source ike_act "Ustawa o indywidualnych kontach emerytalnych oraz indywidualnych kontach zabezpieczenia emerytalnego (tekst jednolity)"

source oki_act "Ustawa o osobistych kontach inwestycyjnych, Dz.U. 2026 poz. 1098 (z prototypu)"

source rpp "Komunikaty Rady Polityki Pieniężnej o stopach procentowych NBP"

index oki_asset = [pln_funds, deposits_bonds, foreign]

input ike_limit_3: int
  note "lifted from an inline figure of tally 1.0.1"

input nbp_oct_2: int
  note "lifted from an inline figure of tally 1.0.1"

input nbp_ref: num question "Ile wynosi stopa referencyjna NBP?"

input oki_exempt[a in oki_asset]: money PLN

input oki_from: month

input oki_rate_0_0001: num
  note "lifted from an inline figure of tally 1.0.1"

input oki_rate_first: num

input oki_rate_floor: num

input oki_ref_share: num

input oki_tax_pay_17: int
  note "lifted from an inline figure of tally 1.0.1"

def ike_limit[y in tax_year]: money PLN at start_of(y)
  rule base v ike_2004 = ike_limit_3 * proj_wage_y[y]

def nbp_oct[y in tax_year]: num = nbp_ref at add_days(add_months(start_of(y), -nbp_oct_2), -1)

def oki_avg[y in tax_year]: num PLN at start_of(y)
  rule base v oki_rules = sum(value(wunits[oki], d) in PLN by etf_price[month_of(d)] + bal(wcash[oki], d) for d in day where year_of(d) == y) / days_between(start_of(y), end_of(y))

def oki_rate[y in tax_year]: num at start_of(y)
  rule base v oki_2027 = oki_rate_first

def oki_tax[y in tax_year]: money PLN at start_of(y)
  rule base v oki_rules = round(max(0, oki_avg[y] - oki_exempt[oki_holds]) * oki_rate[y], 1, half-up)

move oki_tax_pay[y in tax_year]: transfers
  on if is_business(add_days(add_months(start_of(y), oki_tax_pay_17), -1), holidays_pl) then add_days(add_months(start_of(y), oki_tax_pay_17), -1) else add_business(add_days(add_months(start_of(y), oki_tax_pay_17), -1), 1, holidays_pl)
  at start_of(y)
  for y
  when oki_from != none and start_of(y) >= start_of(oki_from) and oki_tax[y] > 0
  reads wcash, wunits
  leg cash from konto to urzad_skarbowy amount oki_tax[y]

version ike_2004
  cite ike_act
  governs 2004..
  known 2004-04-20
  note "art. 13 ust. 1: limit wpłat to trzykrotność prognozowanego przeciętnego wynagrodzenia"

version nbp_2026_03
  cite rpp
  governs 2026-03-05..
  known 2026-03-04
  nbp_ref = 0.0375 "decyzja RPP z 4 marca 2026 r., utrzymana w październiku"

version oki_2027
  cite oki_act
  governs 2027
  known 2026-07-15
  note "art. 43: stawka przejściowa na pierwszy rok"
  oki_rate_first = 0.0085 "art. 43"

version oki_2028
  cite oki_act
  governs 2028..
  known 2026-07-15
  note "art. 25: 19% stopy referencyjnej NBP z 31 października roku poprzedniego, w dół do 0,01 pp, nie mniej niż 0,1%"
  replace rule oki_rate.base v oki_2028 = max(oki_rate_floor, round(oki_ref_share * nbp_oct[y], oki_rate_0_0001, floor))

version oki_rules
  cite oki_act
  governs 2027..
  known 2026-07-15
  oki_exempt[deposits_bonds] = 25000 "art. 26"
  oki_exempt[foreign] = 0 "art. 26: brak kwoty wolnej"
  oki_exempt[pln_funds] = 100000 "art. 26"
  oki_rate_floor = 0.001 "art. 25 ust. 2"
  oki_ref_share = 0.19 "art. 25 ust. 1"

version oki_start
  cite oki_act
  governs always
  known 2026-07-15
  replace oki_from = 2027-01 "przepis o wejściu w życie"
,22:cut11/b_r1/loans.tally,3307:part loans
  tally 2
  note "Kredyty gospodarstwa: rata równa (annuitet), odsetki od salda, nadpłata skraca okres. Wypłata trafia do sprzedawcy."

kind loan_payments: event certain
  leg principal: PLN
  leg interest: PLN
  leg overpay: PLN
  note "rata kredytu: część kapitałowa, odsetki i nadpłata, jednego dnia"

kind seller

index inst = int 1..480

index overpay_mode = [shorten, reduce]

place loan_debt[l in loan]: debts PLN lives 2026-01-01..

place sellers[s in seller]: outside lives 2026-01-01..

input loan_seller[l in loan]: key seller

input loan_terms[l in loan]: (principal money PLN, n int, apr rate, first_month month, due int)

input overpay[l in loan, k in inst]: money PLN

input overpay_choice[l in loan]: key overpay_mode

def annuity[l in loan]: money PLN at reader
  rule base = round(loan_terms[l].principal * inst_rate[l] * factor(loan_terms[l].apr, loan_terms[l].n, month, nominal 12) / (factor(loan_terms[l].apr, loan_terms[l].n, month, nominal 12) - 1), minor(PLN), half-up)
  rule zero beats base = round(loan_terms[l].principal / loan_terms[l].n, minor(PLN), half-up) when inst_rate[l] == 0

def debt_before[l in loan, k in inst]: money PLN at reader
  rule initial = loan_terms[l].principal when k == 1
  rule later = debt_before[l, k - 1] - principal_part[l, k - 1] - overpay_paid[l, k - 1] when k > 1

def inst_day[l in loan, k in inst]: date = day_of(loan_terms[l].first_month + (k - 1), loan_terms[l].due)

def inst_rate[l in loan]: num = periodic(loan_terms[l].apr, month, nominal 12) at reader

def instalment[l in loan, k in inst]: money PLN at reader
  rule reduce beats shorten = ?"Nadpłata ze zmniejszeniem raty: bank przelicza ratę; zasada przeliczenia nie jest wpisana." when overpay_choice[l] == reduce
  rule shorten = annuity[l]

def interest_part[l in loan, k in inst]: money PLN = round(debt_before[l, k] * inst_rate[l], minor(PLN), half-up) at reader

def overpay_paid[l in loan, k in inst]: money PLN = min(overpay[l, k], debt_before[l, k] - principal_part[l, k]) at reader

def principal_part[l in loan, k in inst]: money PLN at reader
  note "ostatnia rata umowy spłaca resztę, także grosze z zaokrąglenia raty"
  rule base = min(debt_before[l, k], instalment[l, k] - interest_part[l, k])
  rule last beats base = debt_before[l, k] when k >= loan_terms[l].n

move loan_instalment[l in loan over .., k in inst]: loan_payments
  on inst_day[l, k]
  at inst_day[l, k]
  when debt_before[l, k] > 0
  leg principal from konto to loan_debt[l] amount principal_part[l, k]
  leg interest from konto to kredytodawcy amount interest_part[l, k]
  leg overpay from konto to loan_debt[l] amount overpay_paid[l, k]

move loan_out[l in loan over ..]: transfers
  on day_of(loan_terms[l].first_month - 1, loan_terms[l].due)
  at day_of(loan_terms[l].first_month - 1, loan_terms[l].due)
  leg cash from loan_debt[l] to sellers[loan_seller[l]] amount loan_terms[l].principal

version laptop_loan
  cite household
  governs always
  known 2026-05-05
  loan + [laptop] lives 2026-05-05..
  loan_seller[laptop] = electro "umowa ratalna, sprzedawca"
  loan_terms[laptop] = (principal: 3000, n: 10, apr: 0 1/year, first_month: 2026-06, due: 5) "umowa ratalna 0%, § 2"
  overpay = 0 "brak nadpłat"
  overpay_choice = shorten "regulamin: nadpłata skraca okres"
,21:cut11/b_r1/pays.tally,5559:part pays
  tally 2
  note "Ruchy gospodarstwa poza prawem: czynsz, wydatki, koszty firmy, reguła 15., zakup jednostek, pożyczka Markowi."

kind etf_buys: event certain
  leg cash: PLN
  leg units: etf_unit

kind promises: transfers uncertain

kind spend_pays: event certain
  leg cash: any

input buy_dom: int
  note "lifted from an inline figure of tally 1.0.1"

input cost_net[m in month]: money PLN question "Ile netto wynoszą koszty firmy w tym miesiącu?"

input cost_vat[m in month]: money PLN question "Ile VAT naliczonego jest w kosztach firmy w tym miesiącu?"

input costs_pay_5: int
  note "lifted from an inline figure of tally 1.0.1"

input etf_mark: num PLN/etf_unit question "Jaka jest ostatnia znana cena jednostki ETF?"

input etf_return: num

input fee_net[c in client, m in month]: money PLN question "Ile netto wynosi faktura dla tego klienta za ten miesiąc?"

input inflation: num

input invest_dom: int
  note "lifted from an inline figure of tally 1.0.1"

input keep_floor: money PLN

input lend_amt[k in marek_loan]: money PLN

input lend_day[k in marek_loan]: date

input marek_amt[k in marek_part]: money PLN

input marek_day[k in marek_part]: date

input marek_promise: (amt money PLN, due date)

input oki_holds: key oki_asset question "Co jest na OKI: fundusze w PLN, lokaty i obligacje czy ETF zagraniczny?"

input rent: money PLN prices 2026 by cpi question "Ile wynosi czynsz najmu?"

input sickness_opt: bool

input spend_budget[c in category]: money PLN

input spend_price_year: year
  note "lifted from an inline figure of tally 1.0.1"

input spend_window: month

input tax_form[y in tax_year]: key form question "Jaką formę opodatkowania wybrano na ten rok?"

input terms[c in client]: int question "Ile dni ma termin płatności tego klienta?"

input zus_stage[m in month]: key stage question "Na jakim etapie składek ZUS jest działalność w tym miesiącu?"

def cpi[y in tax_year]: num at start_of(y)
  rule initial = 1 when pos(y) == 1
  rule next = cpi[y - 1] * (1 + inflation) when pos(y) > 1

def etf_growth[y in tax_year]: num at start_of(y)
  rule initial = 1 when pos(y) == 1
  rule next = etf_growth[y - 1] * (1 + etf_return) when pos(y) > 1

def etf_price[m in month]: num PLN/etf_unit = etf_mark * etf_growth[year_of(m)] at start_of(m)

def invest_amt[w in wrapper, m in month]: money PLN at start_of(m)
  note "reguła 15.: najpierw IKE do limitu roku, reszta na rachunek maklerski, od OKI na OKI"
  rule ike = min(room[m], max(0, ike_limit[year_of(m)] - flows(invest[ike], start_of(year_of(m))..day_of(m, invest_dom)))) when w == ike
  rule mak = if oki_from != none and m >= oki_from then 0 else room[m] when w == mak
  rule oki = if oki_from != none and m >= oki_from then room[m] else 0 when w == oki

def room[m in month]: money PLN at start_of(m)
  note "wolne środki ponad 1 000 zł do następnego uruchomienia reguły (dzień przed kolejnym 15.); VAT do zapłaty nie jest nasz"
  rule base = max(0, min(bal(konto, d) from day_of(m, invest_dom) - vat_owed[d] for d in day_of(m, invest_dom) .. add_days(add_months(day_of(m, invest_dom), 1), -1) step 1 day) - keep_floor)

def spend_day[d in day]: money PLN = round(sum(spend_month[c] for c in category) * cpi[year_of(d)] / cpi[spend_price_year] / days_between(start_of(month_of(d)), end_of(month_of(d))), minor(PLN), half-up) at start_of(d)

def spend_month[c in category]: money PLN at reader
  note "wydatki miesiąca w cenach 2026: z wyciągu za miesiąc estymacji, gdy go mamy; wcześniej budżet gospodarstwa"
  rule budget = spend_budget[c]
  rule learned beats budget = round((sum(o.cash.amount for o in bank over spend_window where o.fulfils == none and o in spending and o.cat == c and o.cash.from == konto) - sum(o.cash.amount for o in bank over spend_window where o.fulfils == none and o in spending and o.cat == c and o.cash.to == konto)) * cpi[spend_price_year] / cpi[year_of(spend_window)], minor(PLN), half-up) when spend_window != none and covered(konto, spend_window)

def units_to_buy[w in wrapper, m in month]: num etf_unit = round(bal(wcash[w]) / etf_price[m], 1 etf_unit, down) at start_of(m)

move buy[w in wrapper, m in month]: etf_buys
  on day_of(m, buy_dom)
  at start_of(m)
  reads wcash
  ties by pos(w)
  leg cash from wcash[w] to rynek amount round(units_to_buy[w, m] * etf_price[m], minor(PLN), half-up)
  leg units from rynek to wunits[w] amount units_to_buy[w, m]

move costs_pay[m in month]: transfers
  on if is_business(day_of(m, costs_pay_5), holidays_pl) then day_of(m, costs_pay_5) else add_business(day_of(m, costs_pay_5), 1, holidays_pl)
  at start_of(m)
  for m
  when cost_net[m] > 0
  leg cash from konto to dostawcy amount cost_net[m] + cost_vat[m]

move invest[w in wrapper, m in month]: transfers
  on day_of(m, invest_dom)
  at start_of(m)
  reads invest, konto
  ties by pos(w)
  leg cash from konto to wcash[w] amount invest_amt[w, m]

move marek_back[k in marek_part]: transfers
  on marek_day[k]
  at marek_day[k]
  leg cash from marek to konto amount marek_amt[k]

move marek_last: promises
  on marek_promise.due
  at marek_promise.due
  leg cash from marek to konto amount marek_promise.amt

move marek_lend[k in marek_loan]: transfers
  on lend_day[k]
  at lend_day[k]
  leg cash from konto to marek amount lend_amt[k]

move rent_pay[m in month]: transfers
  on day_of(m, 1)
  at start_of(m)
  for m
  leg cash from konto to wynajmujacy amount round(rent, minor(PLN), half-up)

move spend[d in day]: spend_pays
  on d
  at start_of(d)
  leg cash from konto to sklepy amount spend_day[d]
