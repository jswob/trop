  law date 2026-10-25, cut 2026-10-25
q_life_in: (?"lim at short_box: no value at 2025-03-01" (lim[short_box]), ?"lim at long_box: no value at 2025-03-01" (lim[long_box]))
  law date 2025-03-01, cut 2026-10-25
q_life_old: ?"lim at short_box: no value at 2025-09-01" (lim[short_box])
  law date 2025-09-01, cut 2025-03-01
q_life_out: (none, 50.00 DUK)
  law date 2025-09-01, cut 2026-10-25
q_merge: (?"What is the amount?" (a_amt, b_amt), ?"What is the amount?" (a_amt) ?"Which amount applies?" (c_amt), ?"Which amount applies?" (c_amt) ?"a stated reason" (told), 10.00 DUK)
  law date 2026-10-25, cut 2026-10-25
q_plain: ?"plain: no value at 2026-10-25" (plain)
  law date 2026-10-25, cut 2026-10-25
q_timeless: (1, ?"timeless at right: no value" (timeless[right]))
  cut 2026-10-25
