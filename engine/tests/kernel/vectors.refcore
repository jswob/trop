  entry[bse_08c] = 0 assumed "the case lists no entry for Schedule SE line 8c (wages, Form 8919), and the scenario has no Form 8919"
  w2_box7 = 0 assumed "the case's W-2 transcription lists no box 7 (social security tips)"
