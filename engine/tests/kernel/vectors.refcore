  note "Part IV Section C, column (e), Example: Xavier's assets. 'Date 1' and 'Date 2' are placeholders."
  note "The example's facts are stipulations, known from the model's on date (LANGUAGE.md 4.5)."
  basis[xavier, prop_a] = 200000 "Column (e), Example, Step 1 table, row 'Asset A'"
  basis[xavier, prop_b] = 800000 "Column (e), Example, Step 1 table, row 'Asset B'"
  basis[xavier, prop_c] = 800000 "Column (e), Example, Step 1 table, row 'Asset C'"
  expat_year[xavier] = 2025 assumed "the example's dates are placeholders ('Date 1'), so its year is taken from the title, 'Instructions for Form 8854 (2025)'"
  fmv[xavier, prop_a] = 2000000 "Column (e), Example, Step 1 table, row 'Asset A'"
  fmv[xavier, prop_b] = 1000000 "Column (e), Example, Step 1 table, row 'Asset B'"
  fmv[xavier, prop_c] = 500000 "Column (e), Example, Step 1 table, row 'Asset C'"
