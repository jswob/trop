source fixture "T's fixture for S's kernel tests (invented values)"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-03

index box = [first, second]

place konto: accounts PLN lives 2026-01-01..

place pocket: cash PLN lives 2026-01-01..

place jar[b in box]: accounts PLN lives 2026-01-01..

place savings: accounts PLN lives 2026-01-01..

place tin: accounts PLN lives 2026-01-01..2026-02-27

place tin0: accounts PLN lives 2026-01-01..2026-02-27

place jar3: accounts PLN lives 2026-03-01..

place oops_box: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

place shop: outside lives 2026-01-01..

input bank: observed

input rent: money PLN

input early_day: date

input late_day: date

input first_day: date

input pay_dom: int

input dec_dom: int

input early_amt: money PLN

input late_amt: money PLN

input low_mark: money PLN

input high_mark: money PLN

input top_amt: money PLN

input big_put: money PLN

input small_put: money PLN

input bill_dom: int

input bill_amt: money PLN

input keep_floor: money PLN

input fee_amt: money PLN

input divisor[m in month]: num

def room[m in month]: money PLN at start_of(m)
  note "a written projection: konto on the bill's day, from the decisions' day, above the floor"
  rule base = max(0, bal(konto, day_of(m, bill_dom)) from day_of(m, dec_dom) - keep_floor)

move rent_pay[m in month]: transfers
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from konto to world amount rent

move early: transfers
  on early_day
  at early_day
  leg cash from world to konto amount early_amt

move late: transfers
  on late_day
  at late_day
  leg cash from world to konto amount late_amt

move topup[m in month]: transfers
  on day_of(m, dec_dom)
  at start_of(m)
  reads pocket
  when bal(pocket) < low_mark
  leg cash from world to konto amount top_amt

move stash[b in box, m in month]: transfers
  on day_of(m, dec_dom)
  at start_of(m)
  reads konto
  ties by pos(b)
  leg cash from konto to jar[b] amount if bal(konto) > high_mark then big_put else small_put

move newyear: transfers
  on first_day
  at first_day
  leg cash from konto to shop amount fee_amt

move fee[m in month]: transfers
  on day_of(m, dec_dom)
  at start_of(m)
  leg cash from konto to shop amount fee_amt

move oops[m in month]: transfers
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from world to oops_box amount round(fee_amt / divisor[m], minor(PLN), half-up)

move early_dec: transfers
  on early_day
  at early_day
  reads pocket
  leg cash from world to pocket amount if bal(pocket) > big_put then small_put else fee_amt

move late_dec: transfers
  on late_day
  at late_day
  reads pocket
  leg cash from world to pocket amount if bal(pocket) > big_put then small_put else fee_amt

move bill[m in month]: transfers
  on day_of(m, bill_dom)
  at start_of(m)
  leg cash from konto to shop amount bill_amt

move save[m in month]: transfers
  on day_of(m, dec_dom)
  at start_of(m)
  reads konto
  leg cash from world to savings amount room[m]

move sweep[m in month]: transfers
  on day_of(m, dec_dom)
  at start_of(m)
  reads savings
  leg cash from savings to shop amount if bal(savings) > big_put then small_put else max(0, small_put - small_put)

ask q_room: room[m] for m in month law cut

ask q_tin: bal(tin, d), bal(tin0, d), bal(savings, d), bal(jar3, d), bal(oops_box, d) for d in [2026-02-26, 2026-02-27, 2026-02-28, 2026-03-31] law cut

ask q_bal: bal(konto, d), bal(pocket, d), bal(jar[first], d), bal(jar[second], d) for d in [2026-01-01, 2026-01-05, 2026-01-10, 2026-01-20, 2026-01-25, 2026-01-28, 2026-01-31, 2026-02-10, 2026-02-15, 2026-02-20, 2026-03-01, 2026-03-20, 2026-03-31] law cut

ask q_res: residuals konto 2026-01 law cut

