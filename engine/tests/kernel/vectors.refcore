source plan "T's invented plan"

input all7: calendar

input six: calendar

input every_md: calendar

input d0: date

input dom: int

def seek7: date = add_business(d0, 1, all7) at reader

def sched7: date = schedule(month_of(d0), dom, following, all7) at reader

def is7: bool = is_business(d0, all7) at reader

def seek6: date = add_business(d0, 1, six) at reader

def seek_md: date = add_business(d0, 1, every_md) at reader

