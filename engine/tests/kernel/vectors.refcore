unit DUK: currency minor 0.01

index sale = [fund_one, fund_two]

input gain_rate: num

input result[s in sale]: money DUK

def loss_carried: num DUK at reader
  note "rule 2: a negative net is carried to later years by its size"
  rule loss beats no_loss v card = -net when net < 0
  rule no_loss v card = 0

def net: money DUK at reader
  note "rule 1: the year's gains and losses are netted"
  rule base v card = sum(result[s] for s in sale)

def tax: num DUK at reader
  note "rule 2: 19 % of a positive net; a negative net gives 0"
  rule base v card = gain_rate * net
  rule loss beats base v card = 0 when net < 0

ask q_year: net, tax, loss_carried law 2026-10-25

