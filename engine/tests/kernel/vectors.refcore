  std_ded[single] = 15750 "p. 6, What's New: $15,750–Single or Married filing separately"
  std_ded[mfj] = 31500 "p. 6: $31,500–Married filing jointly or Qualifying surviving spouse"
  std_ded[mfs] = 15750 "p. 6: $15,750–Single or Married filing separately"
  std_ded[hoh] = 23625 "p. 6: $23,625–Head of household"
  std_ded[qss] = 31500 "p. 6: $31,500–Married filing jointly or Qualifying surviving spouse"
