  unfulfilled: t[2026-05]
  cut 2026-10-20
q_fb: (refused: RUN-RECORD settlement bank[r1] of adjustments[t[2026-03].cash, turn]: the leg is turned round, refused: RUN-RECORD settlement bank[r1] of adjustments[t[2026-03].cash, turn]: the leg is turned round)
  unfulfilled: t[2026-05]
  cut 2026-10-20
q_ff: (refused: RUN-RECORD settlement bank[r1] of adjustments[t[2026-03].cash, turn]: the leg is turned round, refused: RUN-RECORD settlement bank[r1] of adjustments[t[2026-03].cash, turn]: the leg is turned round)
  unfulfilled: t[2026-05]
  cut 2026-10-20
