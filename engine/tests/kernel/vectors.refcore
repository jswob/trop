source card "Probe card LIFE-02 (tmp/cases/probes/life/LIFE-02.md): story, rules 1-4 and question"

unit DUK: currency minor 0.01

index mo = month 2024-01..2024-12

input credit_owed: money DUK question "How much of the credit is still owed at the sale?"

input parking_fee: money DUK question "What does the parking contract cost a month?"

input policy_end: date question "On what day does the insurance's policy year end?"

input policy_start: date question "On what day does the insurance's policy year start?"

input premium: money DUK question "What is the insurance premium for the policy year?"

input sold: date question "On what day is the car sold?"

def car_tax_end: date at reader
  note "rule 4: the car tax ends with the sale"
  rule base v card_law = sold

def car_tax_refund: money DUK at reader
  note "rule 4: and is not refunded"
  rule base v card_law = 0

def credit_end: date at reader
  note "rule 2: repaid in full from the price on the day of sale"
  rule base v card_law = sold

def credit_repaid: money DUK at reader
  note "rule 2: the whole of what is still owed"
  rule base v card_law = credit_owed

def ins_days: int = days_between(policy_start, add_days(policy_end, 1)) at reader

def ins_end: date at reader
  note "rule 1: the insurance ends with the sale"
  rule base v card_law = sold

def ins_refund: money DUK at reader
  note "rule 1: the unused days from the next day to the end of the policy year, over the policy year's days, rounded half up to 0.01"
  rule base v card_law = round(premium * ins_unused / ins_days, minor(DUK), half-up)

def ins_unused: int = days_between(sold, policy_end) at reader

def notice: date at reader
  note "rule 3: notice is given on the day of sale"
  rule base v card_law = sold

def parking_end: date at reader
  note "rule 3: the end of the month after the notice"
  rule base v card_law = add_days(end_of(month_of(notice) + 1), -1)

def parking_paid_after: money DUK at reader
  note "rule 3: the months after the sale's month up to the end are still paid"
  rule base v card_law = sum(parking_fee for m in mo where m > month_of(sold) and m <= month_of(parking_end))

ask amounts: ins_unused, ins_days, ins_refund, credit_repaid, parking_paid_after, car_tax_refund law 2024-09-15

ask ends: ins_end, credit_end, parking_end, car_tax_end law 2024-09-15

