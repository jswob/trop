unit DUK: currency minor 0.01

input costs: money DUK

input income: money DUK

input relief: money DUK

input tax_rate: num

def advance: money DUK at reader
  note "rule 2: 17 % of the base minus the relief, rounded half up to whole DUK"
  rule base v card = round(tax_rate * base_amt - relief, 1, half-up)

def advance_once: money DUK at reader
  note "the contrast the question asks: no rounding of the base, one rounding at the end"
  rule base = round(tax_rate * (income - costs) - relief, 1, half-up)

def base_amt: money DUK at reader
  note "rule 1: income minus costs, rounded half up to whole DUK"
  rule base v card = round(income - costs, 1, half-up)

ask q_advance: advance, advance_once, advance - advance_once law 2026-10-25

