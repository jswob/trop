model g14_shifts
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.6 (#89, #48, P35, findings 3 to 6): a day, a month and a year shifted by the machine word's least and greatest value and past 64 bits, refused RUN-LIMIT where they pass 9999-12-31 or come before 0001-01-01, each beside its twin at the edge, answered; add_business by the least value; ranges of 3 keys with ends and step near ±9e18, and past 64 bits."

source plan "plan"

input d: date

input d0: date

input cal: calendar

input imin: int

input imax: int

input huge: int

input back: int

input back1: int

input fwd: int

input fwd1: int

input mfwd: int

input mfwd1: int

input zero: int

input n1: int

input n2m2: int

input s2: int

input b7: int

input b8: int

input hend: int

version v
  cite plan
  governs always
  known 2026-01-01
  d = 2026-06-01
  d0 = 0001-01-10
  cal = calendar(weekends [sat, sun])
  imin = -9223372036854775808
  imax = 9223372036854775807
  huge = 100000000000000000000
  back = 739767
  back1 = 739768
  fwd = 2912291
  fwd1 = 2912292
  mfwd = 95682
  mfwd1 = 95683
  zero = 0
  n1 = 1
  n2m2 = 1999998
  s2 = 2
  b7 = -7
  b8 = -8
  hend = 100000000000000999999

ask a1: d - back, d - back1

ask a2: d + fwd, d + fwd1

ask a3: d - huge, d + -huge, add_days(d, -huge), add_days(d, imin)

ask a4: add_months(d, mfwd), add_months(d, mfwd1), add_months(d, -huge), add_months(d, imax)

ask a5: d + huge * 1 month, d - huge * 1 month, d - imin * 1 day, d + imax * 1 quarter

ask a6: month_of(d) + huge, month_of(d) - imin, month_of(d) - huge, year_of(d) + imax

ask a7: month_of(d) + huge * 1 month, month_of(d) - imin * 1 month, year_of(d) + huge * 1 year

ask b1: add_business(d0, b7, cal), add_business(d0, b8, cal), add_business(d0, imin, cal), add_business(d0, -huge, cal)

ask b2: add_business(d, huge, cal)

ask k1: sum(n1 for k in imin .. imax step imax), sum(k for k in imin .. imax step imax)

ask k2: sum(n1 for k in -huge .. huge step huge), sum(k for k in huge .. huge), sum(n1 for k in huge .. hend)

ask k3: sum(n1 for k in zero .. n2m2 step s2), sum(n1 for k in imin .. imax), sum(n1 for k in -huge .. huge)

ask k4: sum(n1 for k in zero .. imax step imax), sum(k for k in imax .. imax step huge)
