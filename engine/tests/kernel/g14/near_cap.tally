model g14_near_cap
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.6 (#89, P37, the second review's G3): ranges whose ends or step lie near the 4 096-digit cap, their keys counted exactly (top is 4 096 nines); one of more than 1 000 000 keys refused RUN-LIMIT beside the twin of 1 000 000."

source plan "T's fixture (invented values)"

input top: int

input ntop: int

input n0: int

input n1: int

input n5: int

input s4091: int

input s4095: int

input s7: int

input a7: int

input b7: int

version v
  cite plan
  governs always
  known 2026-01-01
  top =  "4 096 nines, the cap"
  ntop = - "minus top"
  n0 = 0 "zero"
  n1 = 1 "one"
  n5 = 5 "five"
  s4091 =  "a step of 4 091 digits"
  s4095 =  "a step of 4 095 digits"
  s7 = 7 "seven"
  a7 = 6999993 "the millionth key of 0 step 7"
  b7 = 7000000 "one key past it"

ask g3: sum(n1 for k in top .. top), sum(n1 for k in top - n1 .. top), sum(n1 for k in n0 .. top step top), sum(n1 for k in ntop .. top step top)

ask g3_steps: sum(n1 for k in n0 .. n5 step s4091), sum(n1 for k in n0 .. n5 step s4095)

ask g3_limit: sum(n1 for k in ntop .. top), sum(n1 for k in n0 .. b7 step s7)

ask g3_twin: sum(n1 for k in n0 .. a7 step s7)
