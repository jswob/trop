model g7_flows_refused_day_twin
  tally 2
  on 2026-02-15
  start 2026-01-01
  end 2026-03-31
  note "T, pre-M1 (#97, chunk 5, #51): the twin of flows_refused_day, February answered: each split instance books into box on its day, each span's flows answer"

source fixture "invented values"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-03

place konto: accounts PLN lives 2026-01-01..

place box: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input dec_dom: int

input fee_amt: money PLN

input small_put: money PLN

input divisor[m in month]: num

move split[m in month]: transfers
  on day_of(m, dec_dom * divisor[m] / divisor[m])
  at start_of(m)
  reads box
  leg cash from world to box amount if bal(box) >= small_put then small_put else fee_amt

ask q_start: flows(box, 2026-01-01 .. 2026-01-31), flows(konto, 2026-01-01 .. 2026-01-31)

ask q_first_day: flows(box, 2026-01-01 .. 2026-01-01), flows(konto, 2026-01-01 .. 2026-01-01)

ask q_second_day: flows(box, 2026-01-02 .. 2026-01-31), flows(konto, 2026-01-02 .. 2026-01-31)

ask q_later: flows(box, 2026-02-01 .. 2026-02-28), flows(konto, 2026-02-01 .. 2026-02-28)

ask q_last: flows(box, 2026-03-01 .. 2026-03-31), flows(konto, 2026-03-01 .. 2026-03-31)

version facts
  cite fixture
  governs always
  known 2025-12-01
  dec_dom = 20 "the decision's day of the month"
  fee_amt = 3.00 "a fee"
  small_put = 1.00 "a small amount"
  divisor[2026-01] = 1 "answered"
  divisor[2026-02] = 4 "answered"
  divisor[2026-03] = 2 "answered"

version openings
  cite fixture
  governs always
  known 2025-12-31
  opening[box] = 0 at 2026-01-01 start
  opening[konto] = 100 at 2026-01-01 start
