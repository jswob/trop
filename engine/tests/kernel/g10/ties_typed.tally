model g10_ties_typed
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.2 (issue #33), G10: E §6.3 Order, E §4.1: lines of one group tied on their difference, day and group name go by the movement order, its terms compared each as its own type, keys in index order: rent[f2], rent[f3], then rent[f11] (key positions 2, 3 and 11), whatever order the statement's rows are written in. Each is matched by a row of the February statement as planned (difference 0.00, timing +0 days). The twin pair rent[f2] and rent[f3] sorts the same as text; tally 2.1.1 compared the order's text and printed rent[f11] between rent[f2] and rent[f3]."

source fixture "T's fixture for S's kernel tests (invented values)"

source bank_feed "T's invented bank feed"

unit PLN: currency minor 0.01

index flats = [f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11]

input bank: observed

input rent_amt: money PLN

input rent_day: date

place konto: accounts PLN lives 2026-01-01..

place landlord: outside lives 1900-01-01..

place unexplained: outside lives 1900-01-01..

move rent[f in flats]: transfers
  on rent_day
  when pos(f) == 2 or pos(f) == 3 or pos(f) == 11
  leg cash from konto to landlord amount rent_amt

ask led: residuals konto 2026-02

version facts
  cite fixture
  governs always
  known 2026-01-01
  rent_amt = 2 000.00 PLN
  rent_day = 2026-02-03
  opening[konto] = 10 000.00 PLN at 2026-01-01 start

version statement_02
  cite bank_feed
  governs 2026-02
  known 2026-03-02
  covers konto
  pad konto from unexplained
  bank[r1] = (on: 2026-02-03, kind: transfers, leg cash from konto to landlord amount 2 000.00 PLN, fulfils: rent[f11]) "line 1"
  bank[r2] = (on: 2026-02-03, kind: transfers, leg cash from konto to landlord amount 2 000.00 PLN, fulfils: rent[f3]) "line 2"
  bank[r3] = (on: 2026-02-03, kind: transfers, leg cash from konto to landlord amount 2 000.00 PLN, fulfils: rent[f2]) "line 3"
  stated[konto] = 4 000.00 PLN at 2026-02-28 end "saldo"
