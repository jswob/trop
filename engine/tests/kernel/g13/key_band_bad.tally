model g13_key_band_bad
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31
  note "T, pre-M1 (#97, chunk 4, G4a K1): a band row naming a key its index lacks, zzz: LOAD-KEY at load, refcore's text (L §5.9, §8.3); g13/key_band is its twin"

source s "s"

input r5: rate

input n1: int

index tier = [low, mid, high]

band tb(x: int): key tier

ask d: tb(n1)

version v
  cite s
  governs always
  known 2026-01-01
  r5 = 5 %/year "five"
  n1 = 1 "one"
  tb: [0, 10] = low "a"
  tb: (10, inf) = zzz "b"
