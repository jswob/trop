model g13_spacing_twin
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.6 (#81, P21), G13: the twin of g13/spacing, every token touching: the same answers."

source plan "T's invented plan"

index qs = [q1, q2]

input pair: (x int, y int)

input added[k in qs]: int

input base: int

def fields: int = pair.x + pair.y + pair.x

def keyed: int = added[q2] + max(base, added[q1])

def kept: bool = not (base > pair.y or base < added[q2])

version plan_2026
  cite plan
  governs always
  known 2026-01-01
  pair = (x: 4, y: 9)
  added[q1] = 7
  added[q2] = 2
  base = 3

ask q: fields, keyed, kept
