model g5_dec_where_lawdate
  tally 2
  on 2026-03-31
  start 2026-01-01
  end 2026-03-31
  note "T, pre-M1 (#97, chunk 4, #104): g5/dec_where_place with its place read from flag, replaced by a version known 1 March (G2 review B2): a decision refused by its key's where reads its legs' places at its point, its law at its law date and its facts at min(t, K), so February's reads flag = 1 and refuses box (L §8.4; E §4.2 step 3). Held for #104: refcore drops the instance"

source fixture "T's fixture for S's kernel tests (invented values)"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-03

place konto: accounts PLN lives 2026-01-01..

place box: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input dec_dom: int

input fee_amt: money PLN

input small_put: money PLN

input divisor[m in month]: num

input flag: int

move split[m in month where 1 / divisor[m] > 0]: transfers
  on day_of(m, dec_dom)
  at start_of(m)
  reads box
  leg cash from world to (if flag > 0 then box else konto) amount if bal(box) >= small_put then small_put else fee_amt

ask q_bal: bal(konto, d), bal(box, d) for d in [2026-01-20, 2026-02-19, 2026-02-20, 2026-03-20] law cut

version facts
  cite fixture
  governs always
  known 2025-12-01
  dec_dom = 20 "the decision's day of the month"
  fee_amt = 3.00 "a fee"
  small_put = 1.00 "a small amount"
  divisor[2026-01] = 1 "answered"
  divisor[2026-02] = 0 "a division by zero, refused"
  divisor[2026-03] = 2 "answered, but after February's refusal"
  flag = 1 "the flag"

version later
  cite fixture
  governs always
  known 2026-03-01
  replace flag = 0

version openings
  cite fixture
  governs always
  known 2025-12-31
  opening[konto] = 100 at 2026-01-01 start
  opening[box] = 0 at 2026-01-01 start
