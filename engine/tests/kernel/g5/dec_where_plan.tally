model g5_dec_where_plan
  tally 2
  on 2026-02-15
  start 2026-01-01
  end 2026-03-31
  note "T, pre-M1 (#97, chunk 4, #104): a decision refused by its key's where in February and a plan p refused at its when the same day, at box (G2 review B3): the decision's refusal comes at its point, after the day's plans, so box keeps the plan's (L §8.4; E §4.2 step 3). Its twin is g5/dec_where_plan_twin, the plan refused alone"

source fixture "T's fixture for S's kernel tests (invented values)"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-03

place konto: accounts PLN lives 2026-01-01..

place box: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input dec_dom: int

input fee_amt: money PLN

input small_put: money PLN

input divisor[m in month]: num

input sh[m in month]: int

move split[m in month where 1 / divisor[m] > 0]: transfers
  on day_of(m, dec_dom)
  at start_of(m)
  reads box
  leg cash from world to box amount if bal(box) >= small_put then small_put else fee_amt

move p[m in month]: transfers
  on day_of(m, dec_dom)
  when divisor[m - sh[m]] >= 0
  leg cash from world to box amount fee_amt

ask q_bal: bal(konto, d), bal(box, d) for d in [2026-01-20, 2026-02-19, 2026-02-20, 2026-03-20] law cut

version facts
  cite fixture
  governs always
  known 2025-12-01
  dec_dom = 20 "the decision's day of the month"
  fee_amt = 3.00 "a fee"
  small_put = 1.00 "a small amount"
  divisor[2026-01] = 1 "answered"
  divisor[2026-02] = 0 "a division by zero, refused"
  divisor[2026-03] = 2 "answered, but after February's refusal"
  sh[2026-01] = 0 "no shift"
  sh[2026-02] = 5 "a shift off the index"
  sh[2026-03] = 0 "no shift"

version openings
  cite fixture
  governs always
  known 2025-12-31
  opening[konto] = 100 at 2026-01-01 start
  opening[box] = 0 at 2026-01-01 start
