model scen01
  tally 2
  on 2026-10-25
  start 2025-01-01
  end 2025-12-31
  note "Piotr's base plan has no loan."

source loan_offer "SCEN-01 card: the amendment, a 10 000.00 loan at 0 % and an overpayment"

unit DUK: currency minor 0.01

index mon = month 2025-01..2025-12

place konto: accounts DUK lives 2025-01-01..

def net_worth[d in days]: num DUK = sum(value(x, d) in DUK for x in places on d where not x in outside)
