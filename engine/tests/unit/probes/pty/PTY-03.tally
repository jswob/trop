model pty03
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31
  note "PTY-03: an estate with four branches, one predeceased and represented; each heir's share, exact."
  note "The card gives no dates; its frame is one year and its facts are stipulations known from the start (LANGUAGE 4.5, 5.1)."

source card "Probe card PTY-03 (made up): story and rules"

index persons = [zbigniew, halina, ania, piotr, marta, adam, kuba]

input child[c in persons, p in persons]: bool

input decedent: key persons

input spouse_floor: num

input spouse_of[p in persons]: key persons

input survives[p in persons]: bool

def branch_count: int = count(c in persons where child[c, decedent]) at reader

def branch_share: num at reader
  rule base v card_rules = (1 - spouse_share) / branch_count

def parent_branch[h in persons]: key persons = first(c in persons where child[c, decedent] and child[h, c]) at reader

def share_of[h in persons]: num at reader
  rule child_share beats other v card_rules = branch_share when child[h, decedent] and survives[h]
  rule other = 0
  rule represent beats other v card_rules = branch_share / count(g in persons where child[g, parent_branch[h]] and survives[g]) when not child[h, decedent] and any(child[c, decedent] and not survives[c] and child[h, c] for c in persons)
  rule spouse beats other v card_rules = spouse_share when h == spouse_of[decedent]

def spouse_share: num at reader
  note "rule 1: equal heads, the spouse never below the floor"
  rule base v card_rules = max(spouse_floor, 1 / (branch_count + 1))

ask q_shares: share_of[h] for h in [halina, ania, piotr, marta, kuba] law 2026-01-01

ask q_shares_sum: check sum(share_of[h] for h in persons) == 1 law 2026-01-01

version card_facts
  cite card
  governs always
  known 2026-01-01
  child = false "story: no other child relations"
  child[ania, zbigniew] = true "story"
  child[piotr, zbigniew] = true "story"
  child[marta, zbigniew] = true "story"
  child[adam, zbigniew] = true "story"
  child[kuba, adam] = true "story: Adam's son"
  decedent = zbigniew "story: Zbigniew dies"
  spouse_of[zbigniew] = halina "story: his wife Halina"
  survives = true "story"
  survives[zbigniew] = false "story: the decedent"
  survives[adam] = false "story: Adam died before him"

version card_rules
  cite card
  governs always
  known 2026-01-01
  spouse_floor = 0.25 "rule 1: never below 1/4"
