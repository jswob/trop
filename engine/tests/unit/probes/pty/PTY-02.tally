model pty02
  tally 2
  on 2026-10-25
  start 2024-01-01
  end 2024-12-31
  note "PTY-02: a joint return's tax, traced back to each spouse in proportion to the tax each would pay alone."

source card "Probe card PTY-02 (made up): story and rules"

unit DUK: currency minor 0.01

index persons = [tomek, ania]

index tax_units = [lis_2024]

index tax_years = year 2024..2024

input income[p in persons, y in tax_years]: money DUK

input joint_factor: int
  note "rule 2: twice the scale's tax on half the income; the figure 2 is a row (LANGUAGE 7.1)"

input member[g in tax_units, p in persons]: bool

band scale(x: num DUK): num
  note "rule 1: marginal rates, read with marginal()"

def alone[p in persons, y in tax_years]: num DUK at start_of(y)
  rule base v card_rules = marginal(scale, income[p, y])

def combined[g in tax_units, y in tax_years]: money DUK = sum(income[p, y] for p in persons where member[g, p]) at start_of(y)

def joint[g in tax_units, y in tax_years]: num DUK at start_of(y)
  note "rule 2: twice the scale's tax on half the combined income"
  rule base v card_rules = joint_factor * marginal(scale, combined[g, y] / joint_factor)

def part_of[g in tax_units, p in persons, y in tax_years]: money DUK at start_of(y)
  note "rule 3: in proportion to the tax alone; floored to 0.01, leftover units to the largest remainders (the card states no tie rule)"
  rule base v card_rules = prorata(joint[g, y], alone[j, y] for j in persons where member[g, j], p, minor(DUK), rest largest)

ask q_alone: alone[p, 2024] for p in persons

ask q_joint: joint[lis_2024, 2024]

ask q_parts: part_of[lis_2024, p, 2024] for p in persons

ask q_parts_sum: check sum(part_of[lis_2024, p, 2024] for p in persons) == joint[lis_2024, 2024]

version card_facts
  cite card
  governs always
  known 2024-01-01
  income[tomek, 2024] = 90000.00 "story: Tomek earns a taxable 90 000.00"
  income[ania, 2024] = 30000.00 "story: Ania 30 000.00"
  member[lis_2024, tomek] = true "story: they file jointly"
  member[lis_2024, ania] = true "story: they file jointly"

version card_rules
  cite card
  governs always
  known 2024-01-01
  joint_factor = 2 "rule 2: twice the scale's tax on half the combined income"
  scale: [0, 60000] = 0.12 "rule 1: 12 % up to and including 60 000.00"
  scale: (60000, inf) = 0.32 "rule 1: 32 % on the excess"
