model val06
  tally 2
  on 2026-10-25
  start 2021-01-01
  end 2024-12-31

source card "VAL-06 card: its rules"

source idx_notice "VAL-06 card: the yearly indices"

source pension_acct "VAL-06 card: Halina's pension account, its earnings records"

unit DUK: currency minor 0.01

index yr = year 2021..2024

input earn[y in yr]: money DUK

input idx[y in yr]: num

def acct[y in yr]: money DUK at start_of(y)
  rule base v card_rules = round(acct[y - 1] * idx[y], minor(DUK), half-up) + earn[y]
  rule first beats base v card_rules = earn[y] when pos(y) == 1

ask q: acct[2024] law 2026-10-25

version card_rules
  cite card
  governs always
  known 2021-01-01

version earn_rows
  cite pension_acct
  governs always
  known 2021-01-01
  earn[2021] = 40000.00 "earnings 2021"
  earn[2022] = 44000.00 "earnings 2022"
  earn[2023] = 48000.00 "earnings 2023"
  earn[2024] = 0.00 "earnings 2024: none"

version idx_rows
  cite idx_notice
  governs always
  known 2021-01-01
  idx[2022] = 1.050 "index 2022"
  idx[2023] = 1.080 "index 2023"
  idx[2024] = 1.040 "index 2024"
