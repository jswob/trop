model val04
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31

source broker_stmt "VAL-04 card: the new broker's yearly statement"

source card "VAL-04 card: its rules"

source gift_deed "VAL-04 card: the gift, the giver's cost and the units' value on the day of the gift"

source sale_note "VAL-04 card: Ania's sale of the gifted fund units"

unit DUK: currency minor 0.01

input gift_value: money DUK

input giver_cost: money DUK

input proceeds: money DUK

input stmt_gain: money DUK

def cost_by_law: money DUK at reader
  rule gift v card_rules = gift_value

def cost_in_stmt: money DUK = proceeds - stmt_gain at reader

def gap: money DUK = stmt_gain - law_gain at reader

def law_gain: money DUK = proceeds - cost_by_law at reader

ask cause_check: check cost_in_stmt == giver_cost law 2026-10-25

ask gain_check: check stmt_gain == law_gain law 2026-10-25

ask q: stmt_gain, law_gain, gap, cost_in_stmt, cost_by_law law 2026-10-25

version card_rules
  cite card
  governs always
  known 2026-01-01

version gift_v
  cite gift_deed
  governs always
  known 2026-01-01
  gift_value = 6000.00 "worth 6 000.00 on the day of the gift"
  giver_cost = 4700.00 "the giver paid 4 700.00"

version sale_v
  cite sale_note
  governs always
  known 2026-01-01
  proceeds = 8900.00 "sold for 8 900.00"

version stmt_v
  cite broker_stmt
  governs always
  known 2026-01-01
  stmt_gain = 4200.00 "taxable gain as the statement shows it, kept as stated"
