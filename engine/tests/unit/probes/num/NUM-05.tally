model num05
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31
  note "Probe NUM-05: 100.00 split in thirds by a stated remainder rule; printed parts against the printed total."

source probe_card "Probe card NUM-05 (made-up story and rules)"

unit DUK: currency minor 0.01

index heir = [ania, piotr, marta]
  v card
  note "story: the heirs in the order listed"

input refund_total: money DUK

def heir_part[h in heir]: money DUK at reader
  note "rule 1: a third each, floored to 0.01; the units left over go one each in the order listed"
  rule base v card = prorata(refund_total, 1 for j in heir, h, minor(DUK), rest largest ties by pos(j))

def part_sum: money DUK = sum(heir_part[h] for h in heir) at reader

def printed_part[h in heir]: money DUK at reader
  note "rule 2: for display only"
  rule base v card = round(heir_part[h], 1, half-up)

def printed_sum: money DUK = sum(printed_part[h] for h in heir) at reader

def printed_total: money DUK at reader
  note "rule 2: for display only"
  rule base v card = round(refund_total, 1, half-up)

ask q_parts: heir_part[h], printed_part[h] for h in heir law 2026-10-25

ask q_totals: part_sum, printed_sum, printed_total law 2026-10-25

version card
  cite probe_card
  governs always
  known 2026-10-25
  refund_total = 100.00 "story: a refund of 100.00 DUK shared equally"
