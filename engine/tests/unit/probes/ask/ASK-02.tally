model ask02
  tally 2
  on 2025-06-30
  start 2025-06-30
  end 2025-06-30
  note "Probe ASK-02: net worth per person on 30 June 2025, with one asset nobody has valued."

source probe_card "Probe card ASK-02 (made-up story and rules)"

unit DUK: currency minor 0.01

index person = [piotr, ola]

place car: assets DUK priced car_value lives 2025-06-30..

place flat: assets DUK priced last(flat_value) lives 2025-06-30..

place konto_piotr: accounts DUK lives 2025-06-30..

input asked_on: date

input car_value: money DUK question "What is Ola's car worth on 2025-06-30? Nobody has valued it."

input flat_value: money DUK reading

input owns[p in person, x in places]: num

def net_worth[p in person]: num DUK at reader
  note "rule 1: a person's shares of what they own, each at its last valuation (an account at its balance); no valuation is a hole, never 0"
  rule base v card = sum(owns[p, x] * (value(x, asked_on) in DUK) for x in places on asked_on where not x in outside and owns[p, x] > 0)

ask q_net_worth: net_worth[p] for p in person law 2025-06-30 partial

version card
  cite probe_card
  governs always
  known 2025-06-30
  note "Stipulations, known from the model's start (L §4.5)."
  asked_on = 2025-06-30 "question: on 30 June 2025"
  flat_value = 400000.00 at 2025-01-10 "story: valued 400 000.00 on 10 January 2025; the flat is priced at its last valuation (rule 1)"
  opening[konto_piotr] = 20000.00 at 2025-06-30 start "story: Piotr's account holds 20 000.00"
  owns = 0 "story: nobody owns anything else"
  owns[ola, car] = 1 "story: Ola owns a car"
  owns[ola, flat] = 0.5 "story: half each"
  owns[piotr, flat] = 0.5 "story: half each"
  owns[piotr, konto_piotr] = 1 "story: Piotr's account"
