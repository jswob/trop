model rec04
  tally 2
  on 2026-10-25
  start 2025-01-01
  end 2025-12-31

source bank_rows "REC-04 card: the bank row of 3 April 2025"

source card "REC-04 card: its rules and its lexicon"

source client_mail "REC-04 card: the client's message about the rest"

source invoices "REC-04 card: Piotr's invoice INV-12"

source registry "REC-04 card: the counterparty registry; Kowal Sp. merged into Kowal-Nowak SA on 1 February 2025"

unit DUK: currency minor 0.01

index brow = [r1]

index certainty = [happened, expected, promised, missed]

index invoice = [inv_12]

index party = [kowal_sp, kowal_nowak]

index word = [probably]

input brow_amt[r in brow]: money DUK

input brow_from[r in brow]: key party

input brow_on[r in brow]: date

input inv_amount[i in invoice]: money DUK

input inv_client[i in invoice]: key party

input inv_due[i in invoice]: date

input lex_kind[w in word]: key certainty

input lex_p[w in word]: num

input match_window: int

input registered[p in party]: key party

input rest_on[i in invoice]: date question "When does the rest of the invoice come?"

input said[i in invoice]: key word

def match_of[r in brow]: key invoice = first(i in invoice where pay_match.taken[r, i] > 0) at reader

def matched[r in brow, i in invoice]: bool at brow_on[r]
  rule window v card_rules = registered[brow_from[r]] == registered[inv_client[i]] and days_between(inv_due[i], brow_on[r]) >= 0 and days_between(inv_due[i], brow_on[r]) <= match_window

def open_amt[i in invoice]: money DUK = inv_amount[i] - paid[i] at reader

def paid[i in invoice]: money DUK = sum(pay_match.taken[r, i] for r in brow) at reader

def rest_kind[i in invoice]: key certainty = lex_kind[said[i]] at reader

def rest_p[i in invoice]: num = lex_p[said[i]] at reader

fill pay_match
  v card_rules
  supply brow_amt[r] for r in brow
  demand inv_amount[i] for i in invoice
  arc matched[r, i]
  order brow_on[r] ties by (pos(r), pos(i))

ask q: match_of[r1], paid[inv_12], open_amt[inv_12], rest_kind[inv_12], rest_p[inv_12] law 2026-10-25

ask rest_asked: rest_on[inv_12] law 2026-10-25

version bank_v
  cite bank_rows
  governs always
  known 2025-01-01
  brow_amt[r1] = 1200.00 "1 200.00 received"
  brow_from[r1] = kowal_nowak "from Kowal-Nowak SA"
  brow_on[r1] = 2025-04-03 "3 April 2025"

version card_rules
  cite card
  governs always
  known 2025-01-01
  lex_kind[probably] = promised "lexicon: probably = promised"
  lex_p[probably] = 0.75 "lexicon: probability 0.75"
  match_window = 10 "rule 1: within 10 days after the due date"

version inv_v
  cite invoices
  governs always
  known 2025-01-01
  inv_amount[inv_12] = 2000.00 "INV-12, 2 000.00"
  inv_client[inv_12] = kowal_sp "billed to Kowal Sp."
  inv_due[inv_12] = 2025-03-31 "due 31 March 2025"

version mail_v
  cite client_mail
  governs always
  known 2025-01-01
  said[inv_12] = probably "the rest will probably come next week"

version registry_v
  cite registry
  governs always
  known 2025-01-01
  registered[kowal_nowak] = kowal_nowak "Kowal-Nowak SA"
  registered[kowal_sp] = kowal_sp governs ..2025-01-31 "Kowal Sp. before the merger"
  registered[kowal_sp] = kowal_nowak governs 2025-02-01.. "merged into Kowal-Nowak SA on 1 February 2025"
