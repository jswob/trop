model own10_p01
  tally 2
  on 2026-10-30
  start 2026-01-01
  end 2026-01-31
  note "OWN-10 P-01: arrivals labelled by the kind of event, by one arrival rule written once (LANGUAGE 3.6): an inheritance the heir's, interest and everything else the couple's."
  note "sav keeps its balance as parts by owner; the withdrawal takes the couple's part first (R3). The parts after a month of bank rows."

source card "Probe card OWN-10 (made up): story and rules"

source bank "The couple's bank: its January 2026 rows (made up)"

unit DUK: currency minor 0.01

kind couples: parties

kind persons: parties

kind inheritances: transfers
  attr heir: key parties

kind interests: transfers

kind savings: place DUK min 0
  owned by arrive
  step minor(DUK)
  takes k for w order (if k.owner == ania_tomek then 0 else 1)

place sav: savings lives 2026-01-01..

place world: outside lives 1900-01-01..

input bank_rows: observed

def arrive[m in events, p in parties]: num at m.day
  note "R1: an inheritance the heir's, interest and any other arrival the couple's"
  rule community v card_rules = (if p == ania_tomek then 1 else 0)
  rule earned beats community v card_rules = (if p == ania_tomek then 1 else 0) when m in interests
  rule inherited beats community v card_rules = (if p == m.heir then 1 else 0) when m in inheritances

ask q_parts: bal(sav, 2026-01-31) of p for p in parties on 2026-01-31

ask q_total: bal(sav, 2026-01-31)

version card_cast
  cite card
  known 2026-01-01
  note "the parties: things of the prelude kind parties, of the model's own subkinds"
  couples + [ania_tomek] lives 2015-06-20..
  persons + [ania] lives 1988-04-12..
  persons + [tomek] lives 1986-09-03..

version card_rules
  cite card
  governs always
  known 2026-01-01

version records_2026_01
  cite bank
  governs 2026-01
  known 2026-02-03
  bank_rows[r1] = (on: 2026-01-05, kind: inheritances, leg cash from world to sav amount 3000.00 DUK, heir: ania) "line 1"
  bank_rows[r2] = (on: 2026-01-20, kind: transfers, leg cash from world to sav amount 1500.00 DUK) "line 2"
  bank_rows[r3] = (on: 2026-01-25, kind: transfers, leg cash from sav to world amount 400.00 DUK) "line 3"
  bank_rows[r4] = (on: 2026-01-31, kind: interests, leg cash from world to sav amount 12.34 DUK) "line 4"
