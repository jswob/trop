model own10_p16
  tally 2
  on 2026-10-30
  start 2026-01-01
  end 2026-03-31
  note "OWN-10 P-16: the arrival rule reads start-of-day parts: the fund's income is each owner's in proportion to their units at the start of its day (LANGUAGE 3.6, 5.14.1), so Tomek's purchase that same day doesn't count."

source card "Probe card OWN-10 (made up): story and rules"

source bank "The couple's bank: its January 2026 rows (made up)"

unit DUK: currency minor 0.01

unit fz_units "a unit of fund Z"

kind couples: parties

kind persons: parties

kind distributions: transfers
  attr paid_by: key fund_accounts

kind fund_accounts: place fz_units min 0
  owned by arrive
  step 1 fz_units
  takes k for w order (if k.owner == ania_tomek then 0 else 1)

kind fund_buys: event certain
  leg units: fz_units
  leg cash: DUK
  attr buyer: key persons

kind savings: place DUK min 0
  owned by arrive
  step minor(DUK)
  takes k for w order (if k.owner == ania_tomek then 0 else 1)

place cash_acc: accounts DUK lives 2020-01-01..

place fund: fund_accounts lives 2026-01-01..

place market: outside lives 1900-01-01..

place sav: savings lives 2026-01-01..

place world: outside lives 1900-01-01..

input bank_rows: observed

def arrive[m in events, p in parties]: num at m.day
  note "rule 1: a purchase is its buyer's; rule 2: a fund's income by its owners' units at the start of its day; any other arrival the couple's"
  rule community v card_rules = (if p == ania_tomek then 1 else 0)
  rule bought beats community v card_rules = (if p == m.buyer then 1 else 0) when m in fund_buys
  rule income beats community v card_rules = bal(m.paid_by, m.day start) of p / bal(m.paid_by, m.day start) when m in distributions

ask q_fund: bal(fund, 2026-03-31) of p for p in parties on 2026-03-31

ask q_fund_start: bal(fund, 2026-03-31 start) of p for p in parties on 2026-03-31

ask q_sav: bal(sav, 2026-03-31) of p for p in parties on 2026-03-31

version card_cast
  cite card
  known 2026-01-01
  note "the parties: things of the prelude kind parties, of the model's own subkinds"
  couples + [ania_tomek] lives 2015-06-20..
  persons + [ania] lives 1988-04-12..
  persons + [tomek] lives 1986-09-03..

version cash_open
  cite card
  known 2026-01-01
  opening[cash_acc] = 10000.00 at 2026-01-01 start "the cash account at the run's start"

version card_rules
  cite card
  governs always
  known 2026-01-01

version records_2026_q1
  cite bank
  governs 2026-01..2026-03
  known 2026-04-02
  bank_rows[r1] = (on: 2026-01-15, kind: fund_buys, leg units from market to fund amount 30 fz_units, leg cash from cash_acc to market amount 600.00 DUK, buyer: ania) "line 1"
  bank_rows[r2] = (on: 2026-01-16, kind: fund_buys, leg units from market to fund amount 10 fz_units, leg cash from cash_acc to market amount 200.00 DUK, buyer: tomek) "line 2"
  bank_rows[r3] = (on: 2026-03-31, kind: fund_buys, leg units from market to fund amount 20 fz_units, leg cash from cash_acc to market amount 410.00 DUK, buyer: tomek) "line 3"
  bank_rows[r4] = (on: 2026-03-31, kind: distributions, leg cash from world to sav amount 100.01 DUK, paid_by: fund) "line 4"
