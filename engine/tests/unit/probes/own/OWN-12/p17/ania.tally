model own12_p17_a
  tally 2
  on 2026-10-30
  start 2026-01-01
  end 2026-06-30
  note "OWN-12 P-17, member a: household A (Ania and Tomek), alone. Its persons are a subkind of the prelude's parties."

source papers "own12_p17_a: the household's own papers (made up)"

unit DUK: currency minor 0.01

kind couples: parties

kind persons: parties

kind inheritances: transfers
  attr heir: key parties

kind savings: place DUK min 0
  owned by arrive
  step minor(DUK)
  takes k for w order (if k.owner == ania_tomek then 0 else 1)

place sav: savings lives 2026-01-01..

place world: outside lives 1900-01-01..

input rows: observed

def arrive[m in events, p in parties]: num at m.day
  note "R1: an inheritance the heir's, any other arrival the couple's"
  rule community v card_rules = (if p == ania_tomek then 1 else 0)
  rule inherited beats community v card_rules = (if p == m.heir then 1 else 0) when m in inheritances

ask q_parts: bal(sav, 2026-06-30) of p for p in parties on 2026-06-30

version cast
  cite papers
  known 2026-01-01
  couples + [ania_tomek] lives 2015-06-20..
  persons + [ania] lives 1988-04-12..
  persons + [tomek] lives 1986-09-03..

version card_rules
  cite papers
  governs always
  known 2026-01-01

version records_2026_01
  cite papers
  governs 2026-01
  known 2026-02-03
  rows[r1] = (on: 2026-01-05, kind: inheritances, leg cash from world to sav amount 2000.00 DUK, heir: ania) "line 1"
  rows[r2] = (on: 2026-01-08, kind: transfers, leg cash from world to sav amount 1500.00 DUK) "line 2"
