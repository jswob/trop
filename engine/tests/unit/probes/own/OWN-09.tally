model own09
  tally 2
  on 2026-10-25
  start 2023-01-01
  end 2025-12-31
  note "OWN-09: one series of indexed bonds redeemed in its third interest year: interest per bond, the fee, the tax, the payout."

source card "Probe card OWN-09 (made up): story and rules"

unit DUK: currency minor 0.01

index interest_years = int 1..3

input bonds: int

input bought: date

input cpi_yoy[m in months]: rate
  note "the price index's yearly change, read by rule 1 as the reference rate"

input face: money DUK

input fee: money DUK

input first_rate: rate

input lag: int

input margin: rate

input redeemed: date

input tax_rate: num

def earned[k in interest_years]: money DUK at reader
  note "rule 2: per bond, half up to 0.01; a part year by its days over the interest year's days"
  rule full v card_rules = round(value[k] * periodic(rate_of[k], year, simple), minor(DUK), half-up)
  rule part beats full v card_rules = round(value[k] * periodic(rate_of[k], year, simple) * days_between(year_start[k], redeemed) / days_between(year_start[k], year_end[k]), minor(DUK), half-up) when redeemed < year_end[k]
  rule unheld beats full, part v card_rules = 0 when redeemed <= year_start[k]

def fee_per_bond: money DUK at reader
  note "rule 3: never more than the bond's interest"
  rule base v card_rules = min(fee, interest_per_bond)

def interest_per_bond: money DUK = sum(earned[k] for k in interest_years) at reader

def payout: money DUK = bonds * (face + interest_per_bond) - bonds * fee_per_bond - tax at reader

def rate_of[k in interest_years]: rate at reader
  note "rule 1: year 1 the first rate; later the index for the month lag months before the year starts, plus the margin"
  rule first beats later v card_rules = first_rate when k == 1
  rule later v card_rules = cpi_yoy[month_of(year_start[k]) - lag] + margin

def tax: money DUK at reader
  note "rule 4: 19 % of the holding's interest less fees, half up to whole DUK"
  rule base v card_rules = round(tax_rate * bonds * (interest_per_bond - fee_per_bond), 1, half-up)

def value[k in interest_years]: money DUK at reader
  note "rule 2: capitalised yearly"
  rule first beats later v card_rules = face when k == 1
  rule later v card_rules = value[k - 1] + earned[k - 1]

def year_end[k in interest_years]: date = add_years(bought, k) at reader

def year_start[k in interest_years]: date = add_years(bought, k - 1) at reader

ask q_bonds: interest_per_bond, fee_per_bond, tax, payout law 2025-09-01

ask q_years: rate_of[k], earned[k] for k in interest_years law 2025-09-01

version card_facts
  cite card
  governs always
  known 2023-01-01
  bonds = 50 "story: 50 bonds"
  bought = 2023-03-01 "story: bought 1 March 2023"
  face = 100.00 "story: 100.00 each"
  redeemed = 2025-09-01 "story: redeemed 1 September 2025"

version card_rules
  cite card
  governs always
  known 2023-01-01
  cpi_yoy[2024-01] = 3.70 %/year "rule 5: January 2024 3.70 %"
  cpi_yoy[2025-01] = 4.90 %/year "rule 5: January 2025 4.90 %"
  fee = 2.00 "rule 3: 2.00 a bond"
  first_rate = 6.80 %/year "rule 1: year 1 6.80 %"
  lag = 2 "rule 1: two months before the year starts"
  margin = 1.25 %/year "rule 1: plus 1.25 %"
  tax_rate = 0.19 "rule 4: 19 %"
