model own11_p22_hole
  tally 2
  on 2026-10-30
  start 2026-01-01
  end 2026-01-31
  note "OWN-11 P-22 (a): a hole on purpose; its own twin is P-22 (b). Two transfers between two owned accounts on one day, each arrival keeping labels, read each other's take: a cycle of observed rows in one batch (LANGUAGE 5.14.2)."
  note "No form orders two rows of one batch, so whose money each carried is unknown: each account holds a hole part with its total known, and the statement's stated parts at the end of January heal it (LANGUAGE 5.19)."

source card "Probe card OWN-11 (made up): story and rules"

source bank "The couple's bank: its January 2026 rows (made up)"

unit DUK: currency minor 0.01

kind persons: parties

kind inheritances: transfers
  attr heir: key parties

kind savings: place DUK min 0
  owned by arrive
  step minor(DUK)
  takes k for w prorata ties by (if k.owner == ania then 0 else 1)

place acc2: savings lives 2026-01-01..

place sav: savings lives 2026-01-01..

place world: outside lives 1900-01-01..

input bank_rows: observed

def arrive[m in events, p in parties]: num at m.day
  note "rule 3: an inheritance the heir's; rule 1: money moved between the two keeps its labels"
  rule inherited v card_rules = (if p == m.heir then 1 else 0) when m in inheritances
  rule moved beats inherited v card_rules = m.cash.amount of p / m.cash.amount when m in transfers and m.cash.from in savings

ask q_parts_20: bal(x, 2026-01-20) of p for x in savings on 2026-01-20, p in persons on 2026-01-20

ask q_parts_31: bal(x, 2026-01-31) of p for x in savings on 2026-01-31, p in persons on 2026-01-31

ask q_totals_20: bal(x, 2026-01-20) for x in savings on 2026-01-20

version card_cast
  cite card
  known 2026-01-01
  persons + [ania] lives 1988-04-12..
  persons + [tomek] lives 1986-09-03..

version card_rules
  cite card
  governs always
  known 2026-01-01

version statement_2026_01
  cite bank
  governs 2026-01
  known 2026-02-03
  covers acc2, sav
  anchor acc2
  anchor sav
  bank_rows[r1] = (on: 2026-01-05, kind: inheritances, leg cash from world to sav amount 1000.00 DUK, heir: ania) "line 1"
  bank_rows[r2] = (on: 2026-01-06, kind: inheritances, leg cash from world to acc2 amount 1000.00 DUK, heir: tomek) "line 2"
  bank_rows[r3] = (on: 2026-01-15, kind: transfers, leg cash from sav to acc2 amount 500.00 DUK) "line 3"
  bank_rows[r4] = (on: 2026-01-15, kind: transfers, leg cash from acc2 to sav amount 300.00 DUK) "line 4"
  stated[acc2] = 1200.00 at 2026-01-31 end "the closing balance of acc2"
  stated[acc2] of ania = 400.00 at 2026-01-31 end "the statement: ania's part of acc2"
  stated[acc2] of tomek = 800.00 at 2026-01-31 end "the statement: tomek's part of acc2"
  stated[sav] = 800.00 at 2026-01-31 end "the closing balance of sav"
  stated[sav] of ania = 600.00 at 2026-01-31 end "the statement: ania's part of sav"
  stated[sav] of tomek = 200.00 at 2026-01-31 end "the statement: tomek's part of sav"
