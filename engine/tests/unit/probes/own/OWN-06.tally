model own06
  tally 2
  on 2026-10-25
  start 2023-01-01
  end 2024-12-31
  note "OWN-06: a gifted lot whose cost the law sets at its value on the gift's day, sold later."
  note "The fund's price is a reading (LANGUAGE 5.8): each def reads it at its own law date, the gift's day or the sale's day."

source card "Probe card OWN-06 (made up): story and rules"

unit DUK: currency minor 0.01

unit fund_units "a unit of fund F"

index lots = [gift_lot]

input gift_day[l in lots]: date

input giver_cost[l in lots]: money DUK

input lot_units[l in lots]: num fund_units

input price_f: num DUK/fund_units reading

input sale_day[l in lots]: date

def gain[l in lots]: num DUK = proceeds[l] - receiver_cost[l] at reader

def gain_on_giver_cost[l in lots]: num DUK = proceeds[l] - giver_cost[l] at reader

def proceeds[l in lots]: num DUK = lot_units[l] * price_f at sale_day[l]

def receiver_cost[l in lots]: num DUK at gift_day[l]
  note "rule 1: the gifted lot's cost is its value on the gift's day; what the giver paid is not read"
  rule base v card_rules = lot_units[l] * price_f

ask q_gain: receiver_cost[gift_lot], gain[gift_lot], gain_on_giver_cost[gift_lot] law 2024-08-01

version card_facts
  cite card
  governs always
  known 2023-01-01
  gift_day[gift_lot] = 2023-05-10 "story: given on 10 May 2023"
  giver_cost[gift_lot] = 5000.00 "story: Halina bought them for 5 000.00"
  lot_units[gift_lot] = 100 "story: 100 units"
  price_f = 62.00 at 2023-05-10 "story: that day's price"
  price_f = 70.00 at 2024-08-01 "story: sold at 70.00"
  sale_day[gift_lot] = 2024-08-01 "story: sold on 1 August 2024"

version card_rules
  cite card
  governs always
  known 2023-01-01
