unit PLN: currency minor 0.01

input cal_h: calendar
input cal_n: calendar
input cal_ok: calendar
input e_h: int
input e_n: int
input e_ok: int
input mo_h: month
input mo_n: month
input mo_ok: month
input roll_h: roll
input roll_n: roll
input roll_ok: roll

ask h_mo: schedule(mo_h, e_ok, roll_ok, cal_ok)
ask h_e: schedule(mo_ok, e_h, roll_ok, cal_ok)
ask h_roll: schedule(mo_ok, e_ok, roll_h, cal_ok)
ask h_cal: schedule(mo_ok, e_ok, roll_ok, cal_h)
ask h_mo__h_e: schedule(mo_h, e_h, roll_ok, cal_ok)
ask h_mo__n_e: schedule(mo_h, e_n, roll_ok, cal_ok)
ask h_mo__n_roll: schedule(mo_h, e_ok, roll_n, cal_ok)
