source s "invented"

unit PLN: currency minor 0.01
index js = [j1, j2]
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt2[j in js]: money PLN
input w2[j in js]: date
input sp: month
input lim: money PLN

move dk[j in js]: transfers
  on w2[j]
  reads konto
  when bal(konto) > lim
  leg cash from konto to world amount amt2[j]

def fk: money PLN = flows(dk, sp .. sp)
def fk1: money PLN = flows(dk[j1], sp .. sp)
def cn: int = count(m in transfers over sp .. sp)

ask e_fk: explain fk
ask e_fk1: explain fk1
ask e_cn: explain cn
ask i_fk: inputs-of fk
ask i_fk1: inputs-of fk1
ask i_cn: inputs-of cn

version v
  cite s
  governs always
  known 2026-01-01
  amt2[j1] = 10.00 PLN "s"
  amt2[j2] = 20.00 PLN "s"
  w2[j1] = 2026-04-05 "s"
  w2[j2] = 2026-06-06 "s"
  sp = 2026-04 "s"
  lim = 450.00 PLN "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
,,1:0,699:e_fk1: 10.00 PLN
  [1] fk1 = 10.00 PLN
      rule base: won
        [2] row v:sp = 2026-04
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
        [3] row v:w2[j1] = 2026-04-05
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
        [4] running read bal(konto) = 500.00 PLN, the balance up to this point of 2026-04-05
        [5] row v:lim = 450.00 PLN
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
        [6] row v:amt2[j1] = 10.00 PLN
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
  unfulfilled: dk[j1]
  cut 2026-06-20
,23:spec/g3/f6_holerun/e_fl,7:spec-g3,31:run f6_holerun.tally --ask e_fl,864:16:f6_holerun.tally,839:model f6
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "invented"

unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input amt_b: money PLN
input w: date
input wh: date
input sp: month

move dh: transfers
  on wh
  leg cash from world to konto amount amt
move dx: transfers
  on w
  reads konto
  leg cash from world to konto amount if wb then amt else amt_b

def wb: bool = bal(konto) > amt
def fl: money PLN = flows(dx, sp .. sp)

ask e_fl: explain fl
ask e_wb: explain wb
ask v_fl: fl

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  amt_b = 70.00 PLN "s"
  w = 2026-04-30 "s"
  wh = window(2026-04-29, 2026-05-02) "s"
  sp = 2026-04 "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
,,1:0,1111:e_fl: ?"date within window(2026-04-29, 2026-05-02) not precise enough for the day of dh" (wh)
  [1] fl = ?"date within window(2026-04-29, 2026-05-02) not precise enough for the day of dh" (wh)
      rule base: won
        [2] row v:sp = 2026-04
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
        [3] row v:w = 2026-04-30
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
        [4] wb = ?"date within window(2026-04-29, 2026-05-02) not precise enough for the day of dh" (wh)
            rule base: won
              [5] running read bal(konto) = ?"date within window(2026-04-29, 2026-05-02) not precise enough for the day of dh" (wh), the balance up to this point of 2026-04-30
              [6] row v:amt = 100.00 PLN
                  version v, source s, "invented", locator "s", governs always, known 2026-01-01
        (v:amt: see [6])
        [7] row v:amt_b = 70.00 PLN
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
  unknown day: wh
  unfulfilled: dx
  cut 2026-06-10
