  known 2026-01-01
  pct = 1 % "s"
  g = 2 %/year "s"
  fx = 4.3 "s"
  wage = 20 "s"
  hrs = 1 "s"
  r = 5 %/year "s"
  x = 1 PLN "s"
  i = 1 "s"
  n = 1 "s"
