  governs always
  known 2026-01-01
  cal_h = ?"which cal?" "s"
  cal_n = none "s"
  cal_ok = calendar(weekends [sat, sun], yearly [01-01]) "s"
  e_h = ?"which e?" "s"
  e_n = none "s"
  e_ok = 15 "s"
  mo_h = ?"which mo?" "s"
  mo_n = none "s"
  mo_ok = 2026-03 "s"
  roll_h = ?"which roll?" "s"
  roll_n = none "s"
  roll_ok = following "s"
