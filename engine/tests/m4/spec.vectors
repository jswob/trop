source s "invented"

unit PLN: currency minor 0.01
axis rd
  r1 "one"
  r2 "two"
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input amt_b: money PLN
input w: date
input sp: month

def ra: money PLN
  rule one = amt when rd == r1
  rule two = amt_b when rd == r2
move dx: transfers
  on w
  reads konto
  leg cash from world to konto amount if bal(konto) > amt then ra else amt

def fl: money PLN = flows(dx, sp .. sp)

ask e_fl: explain fl with rd = r2
ask e_fl2: explain fl
ask v_fl: fl with rd = r2

