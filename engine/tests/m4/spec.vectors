unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
unit hour "godzina"
input pct: num %
input g: num %/year
input fx: num PLN/EUR
input wage: num PLN/hour
input hrs: num hour
input r: rate
input x: money PLN
input i: int
input n: num
def gm: num %/year = g + g
ask a1: pct, pct + pct with pct = 5
