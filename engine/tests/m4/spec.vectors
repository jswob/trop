source s "invented for fence F7: flows(mv, span) read at a past booking cut"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-07

place konto: accounts PLN lives 2026-01-01..

place pot: accounts PLN lives 2026-01-01..

place landlord: outside lives 1900-01-01..

place shop: outside lives 1900-01-01..

input rent_amt[m in month]: money PLN

input fee_day[m in month]: date

input gift_day[m in month]: date

input fee_amt: money PLN

input top_dom: int

input share: num

input sp_jan: month

input sp_may: month

move rent[m in month]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from pot to landlord amount rent_amt[m]

move fee[m in month]: transfers
  on fee_day[m]
  at start_of(m)
  leg cash from pot to landlord amount fee_amt

move gift[m in month]: transfers
  on gift_day[m]
  at start_of(m)
  leg cash from pot to shop amount fee_amt

move top[m in month]: transfers
  on day_of(m, top_dom)
  at start_of(m)
  leg cash from konto to shop amount round(flows(rent, m) * share, minor(PLN), half-up)

move top_fee[m in month]: transfers
  on day_of(m, top_dom)
  at start_of(m)
  leg cash from konto to shop amount flows(fee, m .. (m + 1))

move top_gift[m in month]: transfers
  on day_of(m, top_dom)
  at start_of(m)
  leg cash from konto to shop amount flows(gift, m)

def t_jan: money PLN = flows(top, sp_jan .. sp_jan)

def f_may: money PLN = flows(top_fee, sp_may .. sp_may)

ask r: flows(top, m) for m in [2026-01, 2026-02, 2026-03, 2026-04, 2026-05, 2026-06, 2026-07]

ask fe: flows(top_fee, m) for m in [2026-01, 2026-03, 2026-04, 2026-05, 2026-06]

ask g: flows(top_gift, m) for m in [2026-01, 2026-04]

ask k: bal(konto, 2026-06-19)

ask e_jan: explain t_jan

ask i_jan: inputs-of t_jan

ask i_may: inputs-of f_may

version v
  cite s
  governs always
  known 2026-01-01
  fee_amt = 7.00 PLN "s"
  top_dom = 20 "s"
  share = 0.1 "s"
  sp_jan = 2026-01 "s"
  sp_may = 2026-05 "s"
  rent_amt[2026-01] = 900.00 PLN "s"
  rent_amt[2026-02] = -5.00 PLN "a refused instance: its amount is negative"
  rent_amt[2026-04] = 910.00 PLN "s"
  rent_amt[2026-05] = 920.00 PLN "s"
  rent_amt[2026-06] = 930.00 PLN "s"
  rent_amt[2026-07] = 940.00 PLN "s"
  fee_day[2026-01] = 2026-01-01 "the span's first day"
  fee_day[2026-02] = 2026-02-28 "the span's last day"
  fee_day[2026-03] = 2026-03-15 "s"
  fee_day[2026-04] = 2026-04-30 "s"
  fee_day[2026-05] = window(2026-05-03, 2026-05-08) "a hole day: a window"
  fee_day[2026-06] = 2026-06-01 "s"
  fee_day[2026-07] = 2026-07-31 "s"
  gift_day[2026-01] = 2026-01-10 "s"
  gift_day[2026-02] = 2026-02-10 "s"
  gift_day[2026-03] = 2026-03-10 "s"
  gift_day[2026-05] = 2026-05-10 "s"
  gift_day[2026-06] = 2026-06-10 "s"
  gift_day[2026-07] = 2026-07-10 "s"
  opening[konto] = 5000.00 PLN at 2026-01-01 start "s"
  opening[pot] = 9000.00 PLN at 2026-01-01 start "s"
,,1:0,873:e_jan: 90.00 PLN
  [1] t_jan = 90.00 PLN
      rule base: won
        [2] row v:sp_jan = 2026-01
            version v, source s, "invented for fence F7: flows(mv, span) read at a past booking cut", locator "s", governs always, known 2026-01-01
        [3] row v:top_dom = 20
            version v, source s, "invented for fence F7: flows(mv, span) read at a past booking cut", locator "s", governs always, known 2026-01-01
        [4] row v:rent_amt[2026-01] = 900.00 PLN
            version v, source s, "invented for fence F7: flows(mv, span) read at a past booking cut", locator "s", governs always, known 2026-01-01
        [5] row v:share = 0.1
            version v, source s, "invented for fence F7: flows(mv, span) read at a past booking cut", locator "s", governs always, known 2026-01-01
  unfulfilled: rent[2026-01]
  unfulfilled: top[2026-01]
  cut 2026-06-20
