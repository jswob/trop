input pn: money PLN
input ph: money PLN
input rh: rate
input r: rate
input d0: date
input d1: date

ask q_arith: pn + ph
ask q_arith2: max(pn, ph)
ask q_acc: accrue(pn, rh, d0, d1, act365, simple)
