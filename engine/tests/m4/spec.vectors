          [6] row v:w = 2026-04-30
              version v, source s, "invented", locator "s", governs always, known 2026-01-01
          [7] running read bal(konto) = 500.00 PLN, the balance up to this point of 2026-04-30
          [8] row v:amt = 100.00 PLN
              version v, source s, "invented", locator "s", governs always, known 2026-01-01
          [9] ra = 70.00 PLN
              rule one: not applicable
              rule two: won
                [10] row v:amt_b = 70.00 PLN
                    version v, source s, "invented", locator "s", governs always, known 2026-01-01
  [11] outside the pins [rd = r1]: 100.00 PLN
    [12] fl = 100.00 PLN
        rule base: won
          (v:sp: see [5])
          (v:w: see [6])
          [13] running read bal(konto) = 500.00 PLN, the balance up to this point of 2026-04-30
          (v:amt: see [8])
          [14] ra = 100.00 PLN
              rule one: won
                (v:amt: see [8])
              rule two: not applicable
  [15] outside the pins [rd = r2]: 70.00 PLN
    [16] fl = 70.00 PLN
        rule base: won
          (v:sp: see [5])
