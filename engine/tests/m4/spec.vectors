  tally 2
  on 2026-06-20
  start 2026-01-01
  end 2026-08-31

source s "invented"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01

axis rmode
  half-up "A"
  down "B"

kind exchanges: event certain
  leg eur: EUR
  leg pln: PLN

index month = month 2026-01..2026-08
index cs = [pl, ae]

place konto: accounts PLN lives 2026-01-01..
place pot: accounts PLN lives 2026-01-01..
place konto_eur: accounts EUR lives 2026-01-01..
place kantor_eur: outside lives 1900-01-01..
place kantor_pln: outside lives 1900-01-01..
place shop: outside lives 1900-01-01..

input bank: observed
input amt[m in month]: money EUR
input fx[m in month]: num PLN/EUR
input dom: int
input cal[c in cs]: calendar
input home[m in month]: key cs
input share: num
input top_dom: int
input n1: int

def pln_of[m in month]: money PLN = round(amt[m] * fx[m], minor(PLN), rmode)

move swap[m in month]: exchanges
  on schedule(m, dom, modified_following, cal[home[m]])
  at start_of(m)
  leg eur from konto_eur to kantor_eur amount amt[m]
  leg pln from kantor_pln to konto amount pln_of[m]

move top[m in month]: transfers
  on add_business(day_of(m, top_dom), n1, cal[home[m]])
  at start_of(m)
  leg cash from pot to shop amount round(flows(swap.pln, m) * share, minor(PLN), rmode)

move zed[m in month]: transfers
  on last_business(m, n1, cal[pl])
  at start_of(m)
  leg cash from pot to shop amount flows(top, m .. m) + flows(swap.pln, m - n1 .. m - n1)

def zf[m in month]: money PLN = flows(zed, m)
def ef[m in month]: money EUR = flows(swap.eur, m)

ask q1: flows(top, m) for m in month
ask q2: zf[m] for m in [2026-02, 2026-03, 2026-04, 2026-05, 2026-06]
ask q3: bal(pot, 2026-06-19), bal(konto, 2026-06-19), bal(konto_eur, 2026-06-19)
ask q4: swap[m].day, top[m].day, zed[m].day for m in [2026-01, 2026-02, 2026-03, 2026-05]
ask q5: bal(pot, 2026-06-19) with rmode = down
ask q6: bal(pot, 2026-06-19) as known 2026-03-10
ask q7: zf[2026-03], (zf[2026-03] as if {known 2026-03-10}), (zf[2026-03] as if {home[2026-03] = ae})
ask q8: explain zf[2026-03]
ask q9: inputs-of zf[2026-03]
ask q10: count(t in exchanges over 2026-01-01 .. 2026-06-30), sum(t.pln.amount for t in exchanges over 2026-01-01 .. 2026-06-30)
ask q11: ef[m] for m in [2026-01, 2026-02, 2026-03]
ask q12: explain swap[2026-02]
ask q13: bal(pot, 2026-08-31), bal(konto, 2026-08-31)

ask xx0: explain top[2026-04]
ask ii0: inputs-of top[2026-04]
ask xx1: explain zed[2026-05]
ask ii1: inputs-of zed[2026-05]
ask xx2: explain zed[2026-02]
ask ii2: inputs-of zed[2026-02]
ask xx3: explain ef[2026-01]
ask ii3: inputs-of ef[2026-01]
ask xx4: explain pln_of[2026-04]
ask ii4: inputs-of pln_of[2026-04]
ask xx5: explain swap[2026-04]
ask ii5: inputs-of swap[2026-04]
ask xx6: explain top[2026-05]
ask ii6: inputs-of top[2026-05]
ask xx7: explain zf[2026-06]
ask ii7: inputs-of zf[2026-06]
ask xx8: explain zf[2026-02]
ask ii8: inputs-of zf[2026-02]

