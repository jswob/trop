source s "invented for fence F7: o.fulfils naming the reading move's own instance at a past booking cut"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-05

place konto: accounts PLN lives 2026-01-01..

place card: accounts PLN lives 2026-01-01..

place shop: outside lives 1900-01-01..

input bank: observed

input base: money PLN

input guess: money PLN

input spend_dom: int

move spend[m in month]: transfers
  on day_of(m, spend_dom)
  at start_of(m)
  leg cash from konto to shop amount max(0, base - loose[m])

def loose[m in month]: money PLN at start_of(m)
  rule guessed = guess
  rule seen beats guessed = sum(o.cash.amount for o in bank over m where o.fulfils == none) when covered(card, m)

