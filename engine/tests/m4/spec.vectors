move dt: transfers
  on w
  reads konto
  when bal(konto) > lim
  leg cash from world to konto amount amt
move df: transfers
  on w
  reads konto
  when bal(konto) < lim
  leg cash from world to konto amount amt
move pf: transfers
  on w
  when pl < lim
  leg cash from world to konto amount amt

def cn: int = count(m in transfers over sp .. sp)
def ff: money PLN = flows(df, sp .. sp)
def fp: money PLN = flows(pf, sp .. sp)

