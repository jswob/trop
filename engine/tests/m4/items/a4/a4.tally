model a4
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "invented"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..
place konto2: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

input amt: money PLN
input lim: money PLN
input d1: date
input d2: date

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  lim = 50.00 PLN "s"
  d1 = 2026-04-10 "s"
  d2 = 2026-04-20 "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
  opening[konto2] = 20.00 PLN at 2026-03-01 start "s"

def low: bool = bal(konto) < lim
def low2: bool = bal(konto2) < lim

move off: transfers
  on d1
  when low
  reads konto
  leg cash from world to konto amount amt

move a: transfers
  on d1
  when low2
  reads konto2
  leg cash from world to konto amount amt

move b: transfers
  on d2
  when low
  reads konto
  leg cash from world to konto2 amount amt

ask e_off: explain low
ask e_cycle: explain low2
ask v_cycle: bal(konto, 2026-06-30), bal(konto2, 2026-06-30)
