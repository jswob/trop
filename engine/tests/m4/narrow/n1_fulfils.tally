model n1
  tally 2
  on 2026-06-20
  start 2026-01-01
  end 2026-07-31

source s "invented for fence F7: o.fulfils read at a past booking cut"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-07

place konto: accounts PLN lives 2026-01-01..

place card: accounts PLN lives 2026-01-01..

place landlord: outside lives 1900-01-01..

place shop: outside lives 1900-01-01..

input bank: observed

input rent_amt[m in month]: money PLN

input rent_day[m in month]: date

input base: money PLN

input guess: money PLN

input spend_dom: int

input sp_feb: month

input sp_may: month

move rent[m in month]: transfers
  on rent_day[m]
  at start_of(m)
  leg cash from konto to landlord amount rent_amt[m]

def loose[m in month]: money PLN at start_of(m)
  rule guessed = guess
  rule seen beats guessed = sum(o.cash.amount for o in bank over m where o.fulfils == none) when covered(card, m)

move spend[m in month]: transfers
  on day_of(m, spend_dom)
  at start_of(m)
  leg cash from konto to shop amount max(0, base - loose[m])

def s_feb: money PLN = flows(spend, sp_feb .. sp_feb)

def s_may: money PLN = flows(spend, sp_may .. sp_may)

ask k: bal(konto, 2026-06-19)

ask f: flows(spend, m) for m in [2026-01, 2026-02, 2026-03, 2026-04, 2026-05, 2026-06]

ask l: loose[m] for m in [2026-01, 2026-02, 2026-03, 2026-04, 2026-05, 2026-06]

ask e_feb: explain s_feb

ask i_feb: inputs-of s_feb

ask i_may: inputs-of s_may

version v
  cite s
  governs always
  known 2026-01-01
  base = 300.00 PLN "s"
  guess = 100.00 PLN "s"
  spend_dom = 25 "s"
  sp_feb = 2026-02 "s"
  sp_may = 2026-05 "s"
  rent_amt[2026-01] = 900.00 PLN "s"
  rent_amt[2026-02] = -5.00 PLN "a refused instance: its amount is negative"
  rent_amt[2026-04] = 900.00 PLN "s"
  rent_amt[2026-05] = 900.00 PLN "s"
  rent_amt[2026-06] = 900.00 PLN "s"
  rent_amt[2026-07] = 900.00 PLN "s"
  rent_day[2026-01] = 2026-01-05 "s"
  rent_day[2026-02] = 2026-02-05 "s"
  rent_day[2026-03] = 2026-03-05 "s"
  rent_day[2026-05] = window(2026-05-03, 2026-05-08) "a hole day: a window"
  rent_day[2026-06] = 2026-06-05 "s"
  rent_day[2026-07] = 2026-07-05 "s"
  opening[konto] = 9000.00 PLN at 2026-01-01 start "s"
  opening[card] = 1000.00 PLN at 2026-01-01 start "s"

version jan
  cite s
  governs 2026-01
  known 2026-01-21
  covers card
  bank[r0102] = (on: 2026-01-02, kind: transfers, leg cash from card to shop amount 40.00 PLN) "loose"
  bank[r0105] = (on: 2026-01-05, kind: transfers, leg cash from konto to landlord amount 900.00 PLN, fulfils: rent[2026-01]) "the rent, its own instance whole"

version feb
  cite s
  governs 2026-02
  known 2026-02-21
  covers card
  bank[r0203] = (on: 2026-02-03, kind: transfers, leg cash from card to shop amount 50.00 PLN) "loose"
  bank[r0205] = (on: 2026-02-05, kind: transfers, leg cash from konto to landlord amount 900.00 PLN, fulfils: rent[2026-02]) "names the refused instance"

version mar
  cite s
  governs 2026-03
  known 2026-03-21
  covers card
  bank[r0304] = (on: 2026-03-04, kind: transfers, leg cash from card to shop amount 60.00 PLN) "loose"
  bank[r0305] = (on: 2026-03-05, kind: transfers, leg cash from konto to landlord amount 900.00 PLN, fulfils: rent[2026-03]) "names the instance whose amount is a hole"

version apr
  cite s
  governs 2026-04
  known 2026-04-21
  covers card
  bank[r0406] = (on: 2026-04-06, kind: transfers, leg cash from konto to landlord amount 900.00 PLN, fulfils: rent[2026-04]) "names the instance whose day is a hole"
  bank[r0410] = (on: 2026-04-10, kind: transfers, leg cash from card to shop amount 70.00 PLN) "loose"

version may
  cite s
  governs 2026-05
  known 2026-05-21
  covers card
  bank[r0506] = (on: 2026-05-06, kind: transfers, leg cash from konto to landlord amount 900.00 PLN, fulfils: rent[2026-05]) "names the instance whose day is a window"
  bank[r0511] = (on: 2026-05-11, kind: transfers, leg cash from card to shop amount 80.00 PLN) "loose"
