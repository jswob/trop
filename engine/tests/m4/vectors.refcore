  earnings[1983] = 4934.00 "D-D10 table, 1983"
  earnings[1984] = 5511.00 "D-D10 table, 1984"
  earnings[1985] = 6260.00 "D-D10 table, 1985"
  earnings[1986] = 7146.00 "D-D10 table, 1986"
  earnings[1987] = 0.00 "D-D10 table, 1987"
  earnings[1988] = 9077.00 "D-D10 table, 1988"
  earnings[1989] = 10188.00 "D-D10 table, 1989"
  earnings[1990] = 11352.00 "D-D10 table, 1990"
  earnings[1991] = 0.00 "D-D10 table, 1991"
  earnings[1992] = 0.00 "D-D10 table, 1992"
  earnings[1993] = 15495.00 "D-D10 table, 1993"
  earnings[1994] = 17082.00 "D-D10 table, 1994"
  earnings[1995] = 19059.00 "D-D10 table, 1995"
  earnings[1996] = 21368.00 "D-D10 table, 1996"
  earnings[1997] = 23700.00 "D-D10 table, 1997"
