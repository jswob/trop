source s "invented"

input r: rate
input rd: rate
input rh: rate
input bh: bool
input ch: compounding

def per: num = periodic(r, month, if bh then simple else effective)
def perd: num = periodic(rd, day, ch)
def per2: num = periodic(rh, quarter, ch)
def grows: bool = per > periodic(r, month, simple) or true

ask q: per, perd, per2, grows

version v
  cite s
  governs always
  known 2026-01-01
  r = 12 %/year "s"
  rd = 0.01 %/day "s"
  rh = ?"which rate?" "s"
  bh = ?"simple or not?" "s"
  ch = ?"which compounding?" "s"
,,1:0,127:q: (?"simple or not?" (bh), ?"which compounding?" (ch), ?"which compounding?" (ch) ?"which rate?" (rh), true)
  cut 2026-10-25
