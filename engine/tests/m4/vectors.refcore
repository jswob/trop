source s "invented"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

input amt: money PLN
input w: date
input sp: month
input sp_end: month

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  w = 2026-04-30 "s"
  sp = 2026-04 "s"
  sp_end = 2026-05 "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"

move dx: transfers
  on w
  reads konto
  leg cash from world to konto amount if bal(konto) > 0 PLN then amt else amt

def fl: money PLN = flows(dx, sp .. sp_end)
def cn: int = count(m in transfers over sp .. sp_end)

ask e_flows: explain fl
ask e_count: explain cn
,,1:0,689:e_flows: 100.00 PLN
  [1] fl = 100.00 PLN
      rule base: won
        [2] row v:sp = 2026-04
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
        [3] row v:sp_end = 2026-05
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
        [4] row v:w = 2026-04-30
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
        [5] running read bal(konto) = 500.00 PLN, the balance up to this point of 2026-04-30
        [6] row v:amt = 100.00 PLN
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
  unfulfilled: dx
  cut 2026-06-10
