  sale_day = 2026-11-30 "D-D30: the deed on 30 November 2026"
,21:scenario-cpi103.tally,309:scenario cpi103 over halina
  tally 2
  from 2026-09-01
  note "D-11's own assumption: each CPI-YY not published by 2026-09-30 is taken as 103."

version cpi103_rows
