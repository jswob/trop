  slip[2025-02] = (paid: 2025-03-05, cls: class2, hours: 0, gross: 4800.00, rsi: 648.00, tax: 420.00, net: 3732.00) known 2025-03-05 "C-D20 row 2025-02"
  slip[2025-03] = (paid: 2025-04-04, cls: class1, hours: 7, gross: 5062.50, rsi: 683.44, tax: 638.00, net: 3741.06) known 2025-04-04 "C-D20 row 2025-03"
  slip[2025-04] = (paid: 2025-05-05, cls: class1, hours: 11, gross: 5429.00, rsi: 732.92, tax: 715.00, net: 3981.08) known 2025-05-05 "C-D20 row 2025-04"
  slip[2025-05] = (paid: 2025-06-05, cls: class2, hours: 3, gross: 5117.00, rsi: 690.80, tax: 465.00, net: 3961.20) known 2025-06-05 "C-D20 row 2025-05"
