  slip[2025-12] = (paid: 2026-01-05, cls: class2, hours: 2, gross: 5078.00, rsi: 685.53, tax: 458.00, net: 3934.47) known 2026-01-05 "C-D20 row 2025-12"
  slip[2026-01] = (paid: 2026-02-05, cls: class2, hours: 9, gross: 5351.00, rsi: 722.38, tax: 513.00, net: 4115.62) known 2026-02-05 "C-D20 row 2026-01"
  slip[2026-02] = (paid: 2026-03-05, cls: class2, hours: 6, gross: 5234.00, rsi: 706.59, tax: 489.00, net: 4038.41) known 2026-03-05 "C-D20 row 2026-02"
  slip[2026-03] = (paid: 2026-04-03, cls: class2, hours: 8, gross: 5312.00, rsi: 717.12, tax: 492.00, net: 4102.88) known 2026-04-03 "C-D20 row 2026-03"
  slip[2026-04] = (paid: 2026-05-05, cls: class2, hours: 10, gross: 5552.50, rsi: 749.59, tax: 543.00, net: 4259.91) known 2026-05-05 "C-D20 row 2026-04"
  slip[2026-05] = (paid: 2026-06-05, cls: class2, hours: 4, gross: 5311.00, rsi: 716.98, tax: 492.00, net: 4102.02) known 2026-06-05 "C-D20 row 2026-05"
  slip[2026-06] = (paid: 2026-07-03, cls: class2, hours: 7, gross: 5431.75, rsi: 733.29, tax: 516.00, net: 4182.46) known 2026-07-03 "C-D20 row 2026-06"
  slip[2026-07] = (paid: 2026-08-05, cls: class2, hours: 3, gross: 5270.75, rsi: 711.55, tax: 483.00, net: 4076.20) known 2026-08-05 "C-D20 row 2026-07"
  slip[2026-08] = (paid: 2026-09-04, cls: class2, hours: 0, gross: 5150.00, rsi: 695.25, tax: 459.00, net: 3995.75) known 2026-09-04 "C-D20 row 2026-08"

def paid_in[m in month, y in rv_year]: bool
  note "the pay of month m is paid in tax year y: it is paid in the next month (C-D14 .2: on the 5th of the next month, or the Rosvald business day before), and Jan works from his first day in Ostrel (C-D14)"
  rule base = m >= month_of(log_from) and m + 1 >= month_of(start_of(y)) and m + 1 < month_of(end_of(y))

def seen_net[m in month]: money FLR
  note "the net the Lazur floren side shows for the pay of month m (its row's text 'Lohn MM/YYYY')"
  rule base = sum(lf[d, s].cr for d in day, s in seq where d > end_of(m) - 1 day and d < end_of(m + 1) and lf[d, s] != none and lf[d, s].k == l_pay and lf[d, s].m == m)

def seen_paid[m in month]: date
  note "the day the Lazur floren side shows the pay of month m"
  rule base = first(d in day where d > end_of(m) - 1 day and d < end_of(m + 1) and any(lf[d, s] != none and lf[d, s].k == l_pay and lf[d, s].m == m for s in seq))

def cls_on[p in day]: key rv_class
  note "RWT-4 .1, .2: class 2 for a payment paid after the day the tax year's class notice reached the employer; class 1 otherwise"
  rule c1 = class1
  rule c2 beats c1 = notice_cls[rvy[p]] when p > notice_in[rvy[p]]

def rvy[p in day]: key rv_year
  note "RWT-1 .2: the tax year in which a payment is paid"
  rule base = first(y in rv_year where p >= start_of(y) and p < end_of(y))

def rsi_of[m in month, g in hours_ix]: money FLR
  note "RSI-2 .1: 13.50 % of the gross, up to the ceiling of the calendar year of payment, to the cent, half to even (RGP-2 .1); the gross with g hours of overtime, paid on the day the Lazur row shows"
  rule base = round(rsi_rate * min(gross_h[m, g], rsi_ceil[year_of(seen_paid[m])]), minor(FLR), half-even)

def gross_h[m in month, g in hours_ix]: money FLR
  note "C-D14 .1: base pay and overtime in whole hours"
  rule base = base_pay[m] + ot_rate[m] * g

def taxable_h[m in month, g in hours_ix]: money FLR
  note "RWT-3 .2: gross less the contribution less the class's monthly allowance, rounded down to a whole 10 FLR, never below 0"
  rule base = max(0 FLR, round(gross_h[m, g] - rsi_of[m, g] - rwt_allow[cls_on[seen_paid[m]], rvy[seen_paid[m]]], rwt_step, floor))

def tax_h[m in month, g in hours_ix]: money FLR
  note "RWT-3 .3: 10 % to RWT-EDGE1, 24 % to RWT-EDGE2, 38 % above, of the tax year of payment; rounded down to a whole floren"
  rule base = round(rwt_r1 * min(taxable_h[m, g], rwt_edge1[rvy[seen_paid[m]]]) + rwt_r2 * max(0 FLR, min(taxable_h[m, g], rwt_edge2[rvy[seen_paid[m]]]) - rwt_edge1[rvy[seen_paid[m]]]) + rwt_r3 * max(0 FLR, taxable_h[m, g] - rwt_edge2[rvy[seen_paid[m]]]), 1, floor)

def net_h[m in month, g in hours_ix]: money FLR = gross_h[m, g] - rsi_of[m, g] - tax_h[m, g]

def lost_hours[m in month]: int
  note "the least whole number of overtime hours whose net is the net the Lazur row shows (an inverse, L §5.11)"
  rule base = min(g for g in hours_ix where net_h[m, g] == seen_net[m])

def pay_gross[m in month]: money FLR
  note "the gross of the pay for month m: the payslip's, or for the lost slip the one the Lazur net gives"
  rule slip = slip[m].gross
  rule lost beats slip = gross_h[m, lost_hours[m]] when m == lost_slip

def pay_rsi[m in month]: money FLR
  rule slip = slip[m].rsi
  rule lost beats slip = rsi_of[m, lost_hours[m]] when m == lost_slip

def pay_tax[m in month]: money FLR
  rule slip = slip[m].tax
  rule lost beats slip = tax_h[m, lost_hours[m]] when m == lost_slip

def pay_net[m in month]: money FLR
  rule slip = slip[m].net
  rule lost beats slip = seen_net[m] when m == lost_slip

def pay_day[m in month]: date
  rule slip = slip[m].paid
  rule lost beats slip = seen_paid[m] when m == lost_slip

def pay_class[m in month]: key rv_class
  rule slip = slip[m].cls
  rule lost beats slip = cls_on[seen_paid[m]] when m == lost_slip

def in_rv[d in day]: bool
  note "RWT-5 .1: a day on which Jan was in Rosvald at any time: his log from its first day, the story before it"
  rule log = night[d].rv
  rule before beats log = rv_before_log[d] when d < log_from

def presence[y in rv_year]: int
  note "RWT-5 .1: the days of presence in the tax year"
  rule base = count(d in day where d >= start_of(y) and d < end_of(y) and in_rv[d])

def yr_gross[y in rv_year]: money FLR = sum(pay_gross[m] for m in month where paid_in[m, y])

def yr_rsi[y in rv_year]: money FLR = sum(pay_rsi[m] for m in month where paid_in[m, y])

def yr_withheld[y in rv_year]: money FLR = sum(pay_tax[m] for m in month where paid_in[m, y])

def yr_class[y in rv_year]: key rv_class
  note "RWT-6 .2: the worker's class on the year's last day"
  rule base = cls_on[end_of(y) - 1 day]

def yr_taxable[y in rv_year]: money FLR
  note "RWT-6 .2: the year's gross less the year's contributions less 12 times the monthly allowance of the class on the year's last day, rounded down to a whole 10 FLR, never below 0"
  rule base = max(0 FLR, round(yr_gross[y] - yr_rsi[y] - lifted[twelve] * rwt_allow[yr_class[y], y], rwt_step, floor))

def yr_tax[y in rv_year]: money FLR
  note "RWT-6 .3: RWT-3 .3 with each edge taken 12 times, rounded down to a whole floren"
  rule base = round(rwt_r1 * min(yr_taxable[y], lifted[twelve] * rwt_edge1[y]) + rwt_r2 * max(0 FLR, min(yr_taxable[y], lifted[twelve] * rwt_edge2[y]) - lifted[twelve] * rwt_edge1[y]) + rwt_r3 * max(0 FLR, yr_taxable[y] - lifted[twelve] * rwt_edge2[y]), 1, floor)

def yr_refund[y in rv_year]: money FLR
  note "RWT-6 .1, .4: what the assessment gives: the tax withheld less the yearly tax (positive: refunded within 14 days of the decision; negative: payable within 30 days); none where the days of presence are under 183, since then no claim may be made"
  rule base = yr_withheld[y] - yr_tax[y] when presence[y] >= rwt_presence_min
  rule short = none when presence[y] < rwt_presence_min

def refund_seen[y in rv_year]: money FLR
  note "the refund the Lazur floren side shows from the RTB for the tax year (the row's text names it)"
  rule base = sum(lf[d, s].cr for d in day, s in seq where d >= rtb_claimed[y] and lf[d, s] != none and lf[d, s].k == l_rtb)
,16:C/workshop.tally,7790:part workshop
  tally 2
  note "Jan's workshop (C-D09, C-D10, C-D11, C-D12; the registers and the business account): PIT-10 form (a), VAT monthly, sickness insurance elected; started 2021-02-01, ended 2024-06-14; the business account closed on 2024-06-28 into the joint account. Social contributions SOC-3 (stage 3 from September 2023; pro rata in the month the business closes, SOC-3 .5 as the supplement reads it), the health contribution SOC-4 (a), the monthly VAT returns VAT-4 (the June 2024 one the last, VAT-4 .4), the advances and the year's profit PIT-10 .3, .5, .7."
  note "Input VAT is deducted in the month of its invoice's date (VAT-5 .1 allows that month or the two after; the business account's VAT payments for January – May 2024 are checked against it in asks/C-01)."

input biz_start: date question "On which day did the workshop start (C-D09)?"

input biz_end: date question "On which day did the workshop's activity end (C-D09)?"

input biz_sick: bool question "Did Jan elect sickness insurance for the workshop (C-D09)?"

input biz_closed_acct: date question "On which day was the business account closed (C-D11)?"

input vat_filed[m in month]: date question "On which day was the VAT return for this month filed (C-D12)?"

input stage1_months: int question "How many months after the starting month does stage 1 run (SOC-3 .1)?"

input stage2_months: int question "How many months does stage 2 run (SOC-3 .2)?"

version register
  cite c_d09
  governs always
  known 2024-06-17
  biz_start = 2021-02-01 "C-D09: started 2021-02-01"
  biz_end = 2024-06-14 "C-D09 entry of 2024-06-17: activity ended on 2024-06-14"
  biz_sick = true "C-D09: SIO: sickness insurance elected from the start"

version closing
  cite story
  governs always
  known 2024-06-28
  biz_closed_acct = 2024-06-28 "C-D11: the account is closed on 2024-06-28; its balance transferred the same day to the joint account"
  vat_filed[2024-06] = 2024-07-15 known 2024-07-15 "C-D12: received on 2024-07-15, the VAT return for June 2024, marked as the last, with a request to refund the excess"

version soc3_stages
  cite soc_3
  governs always
  known 2017-09-01
  stage1_months = 6 "SOC-3 v1 .1: to the end of the 6th month after the month it starts"
  stage2_months = 24 "SOC-3 v1 .2: the next 24 months"

def stage3_from: date = add_months(start_of(month_of(biz_start)), stage1_months + 1 + stage2_months)

def month_days[m in month]: int = count(d in day where month_of(d) == m)

def active_days[m in month]: int = count(d in day where month_of(d) == m and d >= biz_start and d <= biz_end)

def soc_base[m in month]: num DUK at start_of(m)
  note "SOC-3 .3: in stage 3 the base is 60 % of the year's AVG-WAGE-PROJ; SOC-3 .5 (supplement): in the month the business closes, times the days of activity in the month over the month's days"
  rule s3 = soc3_stage3_share * avg_wage_proj * active_days[m] / month_days[m] when start_of(m) >= stage3_from

def soc_part_due[c in soc3_part, m in month]: bool
  rule all_ = true
  rule sick beats all_ = biz_sick when c == sickness
  rule labour beats all_ = start_of(m) >= stage3_from when c == labour

def soc_part[c in soc3_part, m in month]: money DUK at start_of(m)
  note "SOC-3 .4: each contribution rounded to the ort, half up (GEN-5 .3)"
  rule due = round(soc_base[m] * soc3_rate[c], minor(DUK), half-up) when soc_part_due[c, m]
  rule not_due = 0 DUK when not soc_part_due[c, m]

def social[m in month]: money DUK = sum(soc_part[c, m] for c in soc3_part)

def rev_m[m in month]: money DUK = sum(sale[i].net for i in sale_inv where month_of(sale[i].issued) == m and sale[i].issued <= biz_end)

def cost_m[m in month]: money DUK = sum(cost[i].net for i in cost_inv where month_of(cost[i].dated) == m and cost[i].dated <= biz_end)

def health[m in month]: money DUK at start_of(m)
  note "SOC-4 .1, form (a): 9 % of the month's income (revenue less costs), never below 9 % of the MIN-WAGE in force on 1 January of the year; rounded to the ort (.4)"
  rule base = round(max(soc4_rate * (rev_m[m] - cost_m[m]), soc4_rate * min_wage_jan[year_of(start_of(m))]), minor(DUK), half-up)

def min_wage_jan[y in year]: money DUK = min_wage at start_of(y)

def contrib_due_day[m in month]: date
  note "SOC-3 .6, SOC-4 .4: by the 20th of the next month; a deadline on a day that is no business day moves to the next (GEN-2 .2)"
  rule base = schedule(m + 1, pay_dom_20, following, holidays)

def vat_out[m in month]: money DUK = sum(sale[i].vat for i in sale_inv where month_of(sale[i].issued) == m and sale[i].issued <= biz_end)

def vat_in[m in month]: money DUK = sum(cost[i].vat for i in cost_inv where month_of(cost[i].dated) == m and cost[i].dated <= biz_end)

def vat_result[m in month]: money DUK
  note "VAT-4 .1, .3: the VAT on the month's invoices less the input VAT deducted in the month less the excess carried from the month before, rounded to whole dukats (GEN-5 .2); the month before January 2024 left none (its VAT was paid: the business account's row of 2024-01-25)"
  rule first = round(vat_out[m] - vat_in[m], 1, half-up) when m == month_of(start_of(year_of(biz_end)))
  rule carry = round(vat_out[m] - vat_in[m] - max(0 DUK, 0 DUK - vat_result[m - 1]), 1, half-up) when pos(m) > 1 and m > month_of(start_of(year_of(biz_end)))

def vat_paid[m in month]: money DUK = sum(wb[d, s].dr for d in day, s in seq where d <= biz_closed_acct and wb[d, s] != none and wb[d, s].k == b_vat and wb[d, s].m == m)

def last_vat_month: month = month_of(biz_end)

def vat_refund_by: date = vat_filed[last_vat_month] + vat4_refund_days

def vat_refunded_on: date = first(d in day where any(jw[d, s] != none and jw[d, s].k == j_vat_ref for s in seq))

def soc_paid_in[a in day, b in day]: money DUK = sum(wb[d, s].dr for d in day, s in seq where d >= a and d <= b and wb[d, s] != none and wb[d, s].k == b_soc)

def profit_to[m in month]: money DUK
  note "PIT-10 .3, .7: revenue (invoices dated to the closing day) less costs (cost invoices dated to it) less the social contributions paid in the period, the year to the end of month m (to the closing day at the latest)"
  rule base = sum(rev_m[k] - cost_m[k] for k in month where year_of(start_of(k)) == year_of(biz_end) and k <= m) - soc_paid_in[start_of(year_of(biz_end)), min(end_of(m) - 1 day, biz_end)]

def profit_2024: money DUK = profit_to[month_of(biz_end)]

def adv_paid[m in month]: money DUK = sum(wb[d, s].dr for d in day, s in seq where d <= biz_closed_acct and wb[d, s] != none and wb[d, s].k == b_pit_adv and wb[d, s].m == m)

def adv_paid_year[y in year]: money DUK = sum(adv_paid[m] for m in month where year_of(start_of(m)) == y)

def adv_due[m in month]: money DUK at end_of(m) - 1 day
  note "PIT-10 .5 (a): the PIT-3 tax (in force on the month's last day) on the year's profit to date, less the advances already paid for the year, never below 0, rounded"
  rule base = round(max(0 DUK, max(0 DUK, marginal(pit3_rate, profit_to[m]) - pit3_reducing) - sum(adv_paid[k] for k in month where year_of(start_of(k)) == year_of(start_of(m)) and k < m)), 1, half-up)

def out_after_close[y in year]: money DUK
  note "what our money (the joint account) paid for the workshop after the business account closed: the SIO's contributions, the RO's VAT and advances"
  rule base = sum(jw[d, s].dr for d in day, s in seq where year_of(d) == y and d > biz_closed_acct and jw[d, s] != none and (jw[d, s].k == j_soc_pay or jw[d, s].k == j_health_pay))

def in_after_close[y in year]: money DUK
  note "what came into our money for the workshop after the business account closed: the VAT refund (and in 2025 the health refund)"
  rule base = sum(jw[d, s].cr for d in day, s in seq where year_of(d) == y and d > biz_closed_acct and jw[d, s] != none and (jw[d, s].k == j_vat_ref or jw[d, s].k == j_health_ref))
,12:C/stas.tally,5778:part stas
  tally 2
  note "Staś's money (C-HR5, C-D36): what Irena sent 'dla Stasia', what the joint account held for him at each day's end (all he had been sent, up to the balance), the days it was short; and the gift tax on Irena's gifts (IGT-1 – IGT-5): Staś is her grandson (Group I, a descendant), but he has no account of his own, so a gift of money credited to his parents' joint account is not exempt (IGT-4 .4), and each gift needs a return within 1 month (IGT-5 .1)."
  note "The joint account's balance at a day's end is the balance after the day's last row (rec_joint), or the day before's where the day has none; on 2024-01-01 the story's opening."

input stas_has_account: bool question "Does Staś have a payment account of his own (story 2023-04-03)?"

input gift_amount: money DUK question "How much does Irena send each month (C-D36)?"

input gift_from: month question "From which month does Irena send it (C-D36, story 2023-04-03)?"

input records_from: date question "From which day do the joint account's rows run (records/jodla-wspolny.csv)?"

version irena_letter
  cite c_d36
  governs always
  known 2023-04-01
  gift_amount = 300.00 "C-D36: From April I'll send 300 every month, on the 3rd"
  gift_from = 2023-04 "C-D36: From April; story 2023-04-03: Irena's first 300.00"

version stas_facts
  cite story
  governs always
  known 2024-01-01
  stas_has_account = false "story 2023-04-03: Staś has no account of his own"
  records_from = 2024-01-01 "records/jodla-wspolny.csv: Okres 01.01.2024 – 30.09.2026"

def jw_rows[d in day]: int = count(s in seq where jw[d, s] != none)

def jw_end[d in day]: money DUK
  note "the joint account's balance at the end of day d"
  rule carry = jw_end[d - 1] when pos(d) > 1
  rule opening beats carry = open_bal[joint] when pos(d) == 1 and jw_rows[d] == 0
  rule seen beats carry, opening = jw[d, last(s in seq where jw[d, s] != none)].bal when jw_rows[d] > 0

def irena_in[d in day]: money DUK = sum(jw[d, s].cr for s in seq where jw[d, s] != none and jw[d, s].k == j_irena)

def sent_to[d in day]: money DUK
  note "C-HR5 .2: all Staś has been sent by the end of day d: what he had on 2024-01-01 (C-HR5 .3, story § What we had) and Irena's rows since"
  rule carry = sent_to[d - 1] + irena_in[d] when pos(d) > 1
  rule opening beats carry = stas_open + irena_in[d] when pos(d) == 1

def stas_held[d in day]: money DUK
  note "C-HR5 .2: at each day's end the joint account holds Staś's money first, up to all he has been sent"
  rule base = min(sent_to[d], jw_end[d])

def stas_short[d in day]: money DUK
  note "C-HR5 .2: the shortfall, ours to put back, where the balance is below all he has been sent"
  rule base = max(0 DUK, sent_to[d] - jw_end[d])

def days_short[d in day]: int
  note "the days from 2024-01-01 to d on whose end the account was short"
  rule base = count(x in day where x <= d and stas_short[x] > 0 DUK)

def short_max[d in day]: money DUK = max(stas_short[x] for x in day where x <= d)

def short_max_on[d in day]: date
  note "the first day, to d, on which the shortfall was the largest"
  rule base = first(x in day where x <= d and stas_short[x] == short_max[d])

def gift_day[m in month]: date
  note "the day Irena's gift of month m was credited: the joint account's row from 2024 on; before the rows run, the 3rd or the next business day (story 2023-04-03, C-D36)"
  rule letter = schedule(m, lifted[gift_dom], following, holidays)
  rule seen beats letter = first(d in day where month_of(d) == m and irena_in[d] > 0 DUK) when start_of(m) >= records_from

def gift_amt[m in month]: money DUK
  rule letter = gift_amount
  rule seen beats letter = sum(irena_in[d] for d in day where month_of(d) == m) when start_of(m) >= records_from

def gift_m[m in month]: bool = m >= gift_from and start_of(m) <= cut

def gift_exempt[m in month]: bool
  note "IGT-4 .1 exempts a descendant's acquisition, but a gift of money only where it was credited to the acquirer's payment account (IGT-4 .4); point 3 doesn't lift that"
  rule base = stas_has_account

def gift_return_due[m in month]: date at gift_day[m]
  note "IGT-5 .1: a return within 1 month of the day the tax arose (IGT-2 .1: the day the money was credited), GEN-3 .1; a deadline on a day that is no business day moves to the next one (GEN-2 .2)"
  rule base = if is_business(add_months(gift_day[m], igt5_return_months), holidays) then add_months(gift_day[m], igt5_return_months) else add_business(add_months(gift_day[m], igt5_return_months), 1, holidays) when not gift_exempt[m]
  rule exempt beats base = none when gift_exempt[m]

def returns_overdue[d in day]: int
  note "the gifts whose return was due before day d (none was filed: story 2023-04-03)"
  rule base = count(m in month where gift_m[m] and gift_return_due[m] != none and gift_return_due[m] < d)

def next_return[d in day]: date
  note "the first return due on or after day d"
  rule base = min(gift_return_due[m] for m in month where gift_m[m] and gift_return_due[m] != none and gift_return_due[m] >= d)

def gifts_5y[m in month]: money DUK at gift_day[m]
  note "IGT-3 .1: what Staś acquired from Irena in the 5 years before the last acquisition (the gift of month m), added to it"
  rule base = sum(gift_amt[k] for k in month where gift_m[k] and k <= m and gift_day[k] > add_years(gift_day[m], -igt3_years))

def gift_tax[m in month]: money DUK at gift_day[m]
  note "IGT-3: the Group I scale on what the added-up acquisitions exceed the free amount in force on the day the last one's tax arose, rounded (GEN-5 .1), less the tax already paid on the earlier ones (none was paid)"
  rule base = round(igt3_scale[group_1](max(0 DUK, gifts_5y[m] - igt_free[group_1])), 1, half-up) when not gift_exempt[m]
  rule exempt beats base = 0 DUK when gift_exempt[m]
,15:C/returns.tally,13421:part returns
  tally 2
  note "Our joint returns for 2024 and 2025 (PIT-5, PIT-6, PIT-7, and the supplement's PIT-5 .3, PIT-6 .4, PIT-16, PIT-17, PIT-18): Marta's bases from her payers' yearly statements (C-D04, C-D05, C-D08); Jan's from the workshop's profit (2024, PIT-10 form (a)) and his Rosvald pay (PIT-18 .1, each payment converted at FX-FLR of the last business day before its day). For 2024 Part I of the agreement has no effect (T-20 .2, protocol 2): the pay is taxed with the foreign tax credit (PIT-16 .3, PIT-18 .5). The 2024 return as corrected (C-D34) takes the RTB's refund of 2025-09-24 (C-D19) off the foreign tax, shared among the tax year's payments by their gross (PIT-18 .3). For 2025 the return as filed states the pay from 2025-01-03 on exempt with progression (C-D34, T-7, PIT-18 .4)."
  note "The tenth (C-HR6 .2): the least whole-dukat amount t with t at least a tenth of both bases before the gift less the tax due the return would show with t as the gift: a min over a stepped range of whole dukats (L §5.11), each candidate read with the gift pinned (as if). Its range runs from a tenth of the bases less the due with no gift (no t below it can meet the test, since a larger gift never raises the due) to a tenth of the bases."

index filing = [f_filed, f_corrected]

index lpayer = [przychodnia, sio_pay]

input stmt[p in lpayer, y in year]: (base money DUK, adv money DUK) question "What does this payer's yearly statement say for Marta for this year (C-D04, C-D05, C-D08)?"

input gift_paid[y in year]: money DUK question "What did we give Fundacja Pod Dębem in this year, by transfer from the joint account (C-D32)?"

input exempt_from: date question "From which payment on does our return state Jan's Rosvald pay exempt (C-D34)?"

input given_estimate[y in year]: money DUK question "What does the story call our estimate of this year's tenth, given in December?"

input next_gift_day[y in year]: date question "On which day was the December gift after this year given (C-D32)?"

input filed_on[y in year, f in filing]: date question "On which day was this return filed (C-D34)?"

input rv_refund_day[y in rv_year]: date question "On which day did the RTB's refund for this tax year come in (the Lazur row)?"

input refund_amt[y in rv_year]: money FLR question "What did the RTB refund for this tax year (C-D19, the Lazur row)?"

