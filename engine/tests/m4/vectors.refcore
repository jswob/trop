version fund_question
  cite modeller
  governs always
  known 2026-09-30
  fund_capital = 100000.00 assumed "D-12's what-if: 100 000.00 DUK"
  fund_draw = 900.00 assumed "D-12's what-if: 900.00 DUK a month"
  fund_months = 36 assumed "D-12's what-if: the next 36 months"
,14:longview.tally,12180:part longview
  tally 2
  note "D-10 and D-11: the story's long view (story.md, The long view, points 1-10), run as D-HR3 says, on paths and with zero volatility. Its figures are the household's round assumptions, known 2026-09-30, each row assumed with its point."
  note "Years are lyear 2026..2064: the key 2026 holds the state on 1 January 2027 and the 2026 levels; money flows from 2027. Her life and the fund's returns are random facts keyed by year, sampled per path (L §5.16); the story's Python stream (random.Random(20261001 + path)) can't be held, so path figures agree with it only within their standard errors (py_stream)."

input care_2026: money DUK question "What does care cost a year, in 2026 money (point 6)?"

input care_age: int question "From the year she turns what age does she pay for care (point 6)?"

input fee_2026: money DUK question "What is the building fee in 2026 (point 5)?"

input fund_df: int question "How many degrees of freedom has the t draw (point 7)?"

input fund_mu: num question "What is the fund's mean return (point 7)?"

input fund_sd: num question "What is the fund's scale on the t draw (point 7)?"

input life_u[y in lyear]: dist question "What uniform number does a path draw for her life in this year (point 2)?"

input lv_acct0: money DUK question "What does the account hold on 1 January 2027 (point 1)?"

input lv_fund0: money DUK question "What does the fund hold on 1 January 2027 (point 1)?"

input lv_index_month: int question "In which month of the year do the pensions and the rent rise, from its first day (points 4, 5)?"

input lv_infl: num question "By how much do prices rise in this year (point 3)?"

input min_2026: money DUK question "What is MIN-PENSION from March 2026 (point 4)?"

input own_2026: money DUK question "What is her own pension from March 2026 (point 4)?"

input q_base: num question "What is the chance of dying in the year she turns 68 (point 2)?"

input q_growth: num question "By what factor does that chance grow with each year of age (point 2)?"

input q_last_age: int question "At what age is the chance 1 (point 2)?"

input q_step: num question "To what step is the chance rounded (point 2)?"

input r_floor_loss: num question "What is the largest loss a return can show (point 7)?"

input r_scale_root: num question "The square root of what divides the t draw (point 7: T / sqrt 2)?"

input r_step: num question "To what step is a return rounded (point 7)?"

input rent_2026: money DUK question "What is the rent from March 2026 (point 5)?"

input spend_2026: money DUK question "What does she spend a year, in 2026 money (point 6)?"

input surv_2026: money DUK question "What is the survivor pension from March 2026 (point 4)?"

input sweep: money DUK question "Above what balance does the account sweep into the fund (point 8)?"

input zr[y in lyear, j in draw5]: dist question "What standard normal numbers does a path draw for the fund in this year (point 7)?"

def age_in[y in lyear]: int = age(born_halina, add_days(end_of(y), -1)) at start_of(y)

def alive[y in lyear]: bool at start_of(y)
  note "point 2: she dies in the first year whose uniform number is below that year's chance, and lives no part of it"
  rule first = true when pos(y) == 1
  rule later = alive[y - 1] and life_u[y] >= q_die[age_in[y]] when pos(y) > 1

def exp_tax: num DUK = sum(surv_prob[y] * lv_pit[y] for y in lyear where pos(y) > 1) at reader

def exp_years: num = sum(surv_prob[y] for y in lyear where pos(y) > 1) at reader

def factor[y in lyear]: num at start_of(y)
  rule first = 1 when pos(y) == 1
  rule later = factor[y - 1] * grow[y] when pos(y) > 1

def fee_lvl[y in lyear]: money DUK at start_of(y)
  note "point 5: each January from 2027 by the year before's factor, to the ort"
  rule first = fee_2026 when pos(y) == 1
  rule later = round(fee_lvl[y - 1] * grow[y - 1], minor(DUK), hh_round) when pos(y) > 1

def grow[y in lyear]: num = 1 + lv_infl at start_of(y)

def lv_gross[y in lyear]: money DUK = sum(lv_month_gross[m] for m in month where year_of(m) == y) at start_of(y)

def lv_health[y in lyear]: money DUK at start_of(y)
  note "point 4: health 9 % of each month's gross, to the ort (SOC-2 .1, GEN-5 .3)"
  rule base = sum(round(lv_month_gross[m] * soc2_rate, minor(DUK), half-up) for m in month where year_of(m) == y)

def lv_money[y in lyear]: money DUK = lv_gross[y] - lv_health[y] - lv_pit[y] + ogr_year[y] - spend_year[y] at start_of(y)

def lv_month_gross[m in month]: money DUK at start_of(m)
  note "point 4: the levels of the year before until the index month, the year's own from it"
  rule late = surv_lvl[year_of(m)] + part_at[year_of(m), year_of(m)] when start_of(m) >= start_of(month_of(start_of(year_of(m))) + lv_index_month - 1)
  rule early beats late = surv_lvl[year_of(m) - 1] + part_at[year_of(m), year_of(m) - 1] when start_of(m) < start_of(month_of(start_of(year_of(m))) + lv_index_month - 1)

def lv_month_rent[m in month]: money DUK = if start_of(m) >= start_of(month_of(start_of(year_of(m))) + lv_index_month - 1) then rent_lvl[year_of(m)] else rent_lvl[year_of(m) - 1] at start_of(m)

def lv_pit[y in lyear]: money DUK at start_of(y)
  note "point 4: the PIT-3 v3 scale on the year's gross rounded to whole dukats, less 3 900.00, rounded; point 9: the 2026 law"
  rule base = round(max(0, marginal(pit3_rate, round(lv_gross[y], 1, half-up)) - pit3_reducing), 1, half-up)

def min_lvl[y in lyear]: money DUK at start_of(y)
  rule first = min_2026 when pos(y) == 1
  rule later = round(min_lvl[y - 1] * grow[y - 1], minor(DUK), hh_round) when pos(y) > 1

def ogr_year[y in lyear]: money DUK at start_of(y)
  note "point 5: 13/16 of the year's rent less the year's fees, to the ort, less PIT-13's 8.5 % of 13/16 of the year's rent, rounded to whole dukats"
  rule base = round(flat_after[halina] * (rent_year[y] - fee_lvl[y] * (1 year / 1 month)), minor(DUK), hh_round) - round(marginal(pit13_rate, rent_year[y] * flat_after[halina]), 1, half-up)

def own_lvl[y in lyear]: money DUK at start_of(y)
  rule first = own_2026 when pos(y) == 1
  rule later = round(own_lvl[y - 1] * grow[y - 1], minor(DUK), half-up) when pos(y) > 1

def p_acct[y in lyear]: money DUK at start_of(y)
  note "point 8: above the sweep into the fund; below 0, fund units sold to bring it back to 0 as far as the fund goes"
  rule first = lv_acct0 when pos(y) == 1
  rule later = if p_pre[y] > sweep then sweep else if p_pre[y] < 0 then p_pre[y] + min(p_fpre[y], -p_pre[y]) else p_pre[y] when pos(y) > 1

def p_dry: bool = count(y in lyear where pos(y) > 1 and alive[y] and p_acct[y] < 0) > 0 at reader

def p_fpre[y in lyear]: money DUK = if pos(y) > 1 then round(p_fund[y - 1] * (1 + r_path[y]), minor(DUK), hh_round) else 0 at start_of(y)

def p_fund[y in lyear]: money DUK at start_of(y)
  rule first = lv_fund0 when pos(y) == 1
  rule later = if p_pre[y] > sweep then p_fpre[y] + p_pre[y] - sweep else if p_pre[y] < 0 then p_fpre[y] - min(p_fpre[y], -p_pre[y]) else p_fpre[y] when pos(y) > 1

def p_nw[y in lyear]: money DUK = p_acct[y] + p_fund[y] at start_of(y)

def p_pre[y in lyear]: money DUK = if pos(y) > 1 then p_acct[y - 1] + lv_money[y] else 0 at start_of(y)

def p_tax: money DUK = sum(lv_pit[y] for y in lyear where pos(y) > 1 and alive[y]) at reader

def p_years: int = count(y in lyear where pos(y) > 1 and alive[y]) at reader

def p_zv_dry: bool = zv_dry_year != none and alive[zv_dry_year] at reader

def part_at[y in lyear, lv in lyear]: money DUK at start_of(y)
  note "point 4, SOC-7 v2 .3: the part of her own pension for the months of y at the levels of lv, to the ort, cut so the two together are no more than 3 times MIN-PENSION"
  rule base = max(0, min(round(own_lvl[lv] * soc7_part, minor(DUK), half-up), soc7_cap_mult * min_lvl[lv] - surv_lvl[lv]))

def py_stream: num = ?"a foreign program's random stream (Python's random.Random(20261001 + path)) can't be held: tally's samples are SHA-256 inversions of the same distributions (L §5.16), so path figures agree with the key within their standard errors, not digit for digit"

def q_die[a in life_age]: num at reader
  rule base = round(q_base * pow(q_growth, pos(a) - 1), q_step, hh_round)
  rule last beats base = 1 when a >= q_last_age

def r_path[y in lyear]: num at start_of(y)
  note "point 7: R = 5 % + 16 % x T / sqrt 2, never below -95 %, rounded to 6 decimal places"
  rule base = max(-r_floor_loss, round(fund_mu + fund_sd * t_draw[y] / (sqrt(r_scale_root) to 1e-12), r_step, hh_round))

def rent_lvl[y in lyear]: money DUK at start_of(y)
  rule first = rent_2026 when pos(y) == 1
  rule later = round(rent_lvl[y - 1] * grow[y - 1], minor(DUK), hh_round) when pos(y) > 1

def rent_year[y in lyear]: money DUK = sum(lv_month_rent[m] for m in month where year_of(m) == y) at start_of(y)

def spend_year[y in lyear]: money DUK = round((spend_2026 + (if age_in[y] >= care_age then care_2026 else 0)) * factor[y], minor(DUK), hh_round) at start_of(y)

def surv_lvl[y in lyear]: money DUK at start_of(y)
  rule first = surv_2026 when pos(y) == 1
  rule later = round(surv_lvl[y - 1] * grow[y - 1], minor(DUK), half-up) when pos(y) > 1

def surv_prob[y in lyear]: num at start_of(y)
  rule first = 1 when pos(y) == 1
  rule later = surv_prob[y - 1] * (1 - q_die[age_in[y]]) when pos(y) > 1

def t_draw[y in lyear]: num at start_of(y)
  note "point 7: T = Z / sqrt(V / 4), V the sum of four squared standard normals drawn after Z"
  rule base = zr[y, 1] / (sqrt((zr[y, 2] * zr[y, 2] + zr[y, 3] * zr[y, 3] + zr[y, 4] * zr[y, 4] + zr[y, 5] * zr[y, 5]) / fund_df) to 1e-12)

def zv_acct[y in lyear]: money DUK at start_of(y)
  rule first = lv_acct0 when pos(y) == 1
  rule later = if zv_pre[y] > sweep then sweep else if zv_pre[y] < 0 then zv_pre[y] + min(zv_fpre[y], -zv_pre[y]) else zv_pre[y] when pos(y) > 1

def zv_dry_year: key lyear = if count(y in lyear where pos(y) > 1 and zv_acct[y] < 0) > 0 then first(y in lyear where pos(y) > 1 and zv_acct[y] < 0) else none at reader

def zv_fpre[y in lyear]: money DUK = if pos(y) > 1 then round(zv_fund[y - 1] * (1 + fund_mu), minor(DUK), hh_round) else 0 at start_of(y)

def zv_fund[y in lyear]: money DUK at start_of(y)
  rule first = lv_fund0 when pos(y) == 1
  rule later = if zv_pre[y] > sweep then zv_fpre[y] + zv_pre[y] - sweep else if zv_pre[y] < 0 then zv_fpre[y] - min(zv_fpre[y], -zv_pre[y]) else zv_fpre[y] when pos(y) > 1

def zv_pre[y in lyear]: money DUK = if pos(y) > 1 then zv_acct[y - 1] + lv_money[y] else 0 at start_of(y)

def zv_share: num = if zv_dry_year != none then surv_prob[zv_dry_year] else 0 at reader

version long_view
  cite story
  governs always
  known 2026-09-30
  note "story.md, The long view, decided with D-HR3 on 2026-09-30"
  care_2026 = 36000.00 assumed "point 6, in 2026 money"
  care_age = 80 assumed "point 6: from the year she turns 80 (2039)"
  fee_2026 = 468.00 assumed "point 5, 2026"
  fund_df = 4 assumed "point 7"
  fund_mu = 0.05 assumed "point 7"
  fund_sd = 0.16 assumed "point 7"
  life_u = uniform(0, 1) to 1e-12 assumed "point 2: one uniform number from [0, 1) for each year from 2027"
  lv_acct0 = 10000.00 assumed "point 1: a round figure taken as given"
  lv_fund0 = 45000.00 assumed "point 1: a round figure taken as given"
  lv_index_month = 3 assumed "points 4 and 5: on each 1 March from 2027"
  lv_infl = 0.03 assumed "point 3: 3 % a year from 2026 on" governs 2026..
  min_2026 = 1970.00 assumed "point 4, MIN-PENSION from March 2026 (gazette.csv line 1910)"
  own_2026 = 3048.80 assumed "point 4, from March 2026"
  q_base = 0.0120 assumed "point 2"
  q_growth = 1.105 assumed "point 2"
  q_last_age = 105 assumed "point 2: at 105 it is 1"
  q_step = 0.0001 assumed "point 2: rounded to 4 decimal places"
  r_floor_loss = 0.95 assumed "point 7: never below -95 %"
  r_scale_root = 2 assumed "point 7: T / sqrt 2"
  r_step = 0.000001 assumed "point 7: R rounded to 6 decimal places"
  rent_2026 = 1976.00 assumed "point 5, from March 2026"
  spend_2026 = 54000.00 assumed "point 6, in 2026 money"
  surv_2026 = 5247.88 assumed "point 4, from March 2026"
  sweep = 15000.00 assumed "point 8"
  zr = normal(0, 1) to 1e-12 assumed "point 7: Z and the four normals of V, standard normal"
,14:ogrodowa.tally,6421:part ogrodowa
  tally 2
  note "The flat's money: the rent from July 2025 (D-D25), the building fee (D-D27), the boiler (D-D28), and Kuba's 3/16 under D-HR1 (D-05). The rent, the fees and Kuba's transfers are planned here; the export rows records.tally writes fulfil them."

kind flat_costs: transfers
  note "the flat's costs Halina pays: the building fee and repairs (D-HR1 .1)"

kind kuba_payments: transfers
  note "Kuba's share sent to him (D-HR1 .3)"

kind rent_payments: transfers
  note "the tenant's rent into Halina's account (D-HR1 .1)"

index fee_month = month 2025-07..2027-09
  note "the months of D-D27's fee plan from July 2025, whose export rows records.tally writes up to the cut; the fees paid before July 2025 are inside the balances the exports state (anchor readings), as the no_repair version's note says"
  note "to 2027-09, the last month of the last key of the index quarter (reality.tally), so every quarter D-05 asks counts its fees; D-D27 states no fee for 2027, so its months' amounts are a hole (version fees)"

input boiler_amt: money DUK question "What did the boiler cost (D-D28)?"

input boiler_day: date question "On what day was the boiler paid (D-D28)?"

input cpi_avg[y in year]: num question "What is the CPI average of this year, the year before = 100 (CPI-AVG, read by the lease)?"

input fee_amt[y in year]: money DUK question "What is the monthly building fee in this year (D-D27)?"

input fee_dom: int question "On what day of the month is the fee collected (D-D27)?"

input kuba_dom: int question "By what day of the month after the quarter is Kuba's part sent (D-HR1 .3)?"

input kuba_part: num question "What part of the rent less the costs goes to Kuba (D-HR1 .2)?"

input lease_from: month question "From what month is the flat let (D-D25)?"

input lease_index_month: int question "In which month of the year is the rent indexed, from its first day (D-D25)?"

input lease_rent: money DUK question "What is the rent at the lease's start (D-D25)?"

input rent_due_dom: int question "By what day of the month is the rent due (D-D25)?"

def cq[q in quarter]: quarter
  note "the calendar quarter a key of the index quarter stands for"
  rule base = quarter_of(start_of(q))

def owed_kuba[d in day]: money DUK at start_of(d)
  note "D-HR4 .3: what Halina owes Kuba on day d: the parts of the quarters ended by d that haven't reached him by d"
  rule base = sum(if observed(kuba_send[q]) == none or observed(kuba_send[q]).day > d then q_send[q] else 0 for q in quarter where add_days(end_of(cq[q]), -1) <= d)

def q_carry[q in quarter]: money DUK at start_of(q)
  note "D-HR1 .3: a sum below 0 is carried into the next quarter"
  rule first = 0 when pos(q) == 1
  rule later = min(0, q_share[q - 1] + q_carry[q - 1]) when pos(q) > 1

def q_costs[q in quarter]: money DUK at start_of(q)
  note "D-HR1 .2: the flat's costs paid in the quarter, each counted on the day the money moved"
  rule base = sum(t.cash.amount for t in flat_costs over cq[q])

def q_due[q in quarter]: date at start_of(q)
  note "D-HR1 .3: by the 10th of the month after the quarter, the next business day where the 10th isn't one"
  rule base = schedule(month_of(end_of(cq[q])), kuba_dom, following, holidays)

def q_rent[q in quarter]: money DUK at start_of(q)
  note "D-HR1 .2: the rent received in the quarter, counted on the day the money moved"
  rule base = sum(t.cash.amount for t in rent_payments over cq[q])

def q_send[q in quarter]: money DUK = max(0, q_share[q] + q_carry[q]) at start_of(q)

def q_share[q in quarter]: money DUK at start_of(q)
  note "D-HR1 .2: 3/16 of the rent less the costs, to the ort, half up"
  rule base = round((q_rent[q] - q_costs[q]) * kuba_part, minor(DUK), half-up)

def rent_amt[m in month]: money DUK at start_of(m)
  note "D-D25: 1 900.00 from July 2025; on 1 March of each year from 2026 times CPI-AVG of the year before over 100, to the ort (no mode named)"
  rule first = lease_rent when m == lease_from
  rule later = if start_of(m) == start_of(month_of(start_of(year_of(m))) + lease_index_month - 1) then round(rent_amt[m - 1] * cpi_avg[year_of(m) - 1] * 1 %, minor(DUK), hh_round) else rent_amt[m - 1] when m > lease_from

move boiler_out: flat_costs
  on boiler_day
  leg cash from konto to world amount boiler_amt

move fee_out[m in fee_month where fee_dom != none]: flat_costs
  on schedule(m, fee_dom, following, holidays)
  at start_of(m)
  leg cash from konto to world amount fee_amt[year_of(m)]

move kuba_send[q in quarter where kuba_dom != none]: kuba_payments
  on q_due[q]
  at start_of(q)
  leg cash from konto to jakub_acct amount q_send[q]

move rent_in[m in month where lease_from != none and m >= lease_from]: rent_payments
  on day_of(m, rent_due_dom)
  at start_of(m)
  leg cash from world to konto amount rent_amt[m]

version kuba_rule
  cite house_rules
  governs always
  known 2025-06-24
  replace kuba_dom = 10 "D-HR1 .3: by the 10th of the month after the quarter, or the next business day"
  kuba_part = 0.1875 "D-HR1 .2: Kuba's 3/16"

version lease
  cite d_d25
  governs always
  known 2025-06-24
  replace lease_from = 2025-07 "D-D25: from 1 July 2025"
  lease_index_month = 3 "D-D25: on 1 March of each year from 2026"
  lease_rent = 1900.00 "D-D25: 1 900.00 DUK a month"
  rent_due_dom = 10 "D-D25: due by the 10th of the month"

version fees
  cite d_d27
  governs always
  known 2025-12-11
  fee_amt[2024] = 420.00 "D-D27"
  fee_amt[2025] = 445.00 "D-D27"
  fee_amt[2026] = 468.00 "D-D27"
  fee_amt[2027] = ?"What is the monthly building fee in 2027? D-D27 states the fees of 2024 to 2026 only"
  replace fee_dom = 5 "D-D27: collected on the 5th, or the next business day"

version cpi_avg_2025
  cite gazette
  governs 2025
  known 2026-01-15
  cpi_avg[2025] = 104.0 "gazette.csv line 24 CPI-AVG-2025"

version no_repair
  cite modeller
  governs always
  known 2024-01-01
  boiler_day = none assumed "a repair no invoice shows has not been paid; D-D28 states its own day"
  fee_dom = none assumed "no fee is planned before D-D27 states it; the fees paid before July 2025 are in the balances the exports state"
  kuba_dom = none assumed "nothing is sent to Kuba before D-HR1"
  lease_from = none assumed "the flat isn't let before D-D25"

version boiler_invoice
  cite d_d28
  governs always
  known 2026-02-16
  boiler_amt = 6840.00 "D-D28"
  replace boiler_day = 2026-02-18 "D-D28: paid by transfer on 18 February 2026"
,14:pensions.tally,9280:part pensions
  tally 2
  note "D-03: Halina's old-age pension (SOC-5), Zbigniew's pension and the survivor pension (SOC-6, SOC-7), what the law entitles her to for each month and what the SIO paid for it."

input arrears_day: date question "On what day did the SIO pay the arrears (D-D15)?"

input earnings[y in year]: money DUK question "What were Halina's earnings in this year (D-D10)?"

input elected: key pkind question "Which pension did Halina elect to be paid in full (D-D13)?"

input soc6_month: int question "In which month of the year are pensions indexed, on its first day (SOC-6 .1)?"

input own_claim_from: date question "From what day is Halina's old-age pension paid (D-D11)?"

input pay_dom: int question "On what day of the month does the SIO pay (D-D09, D-D11)?"

input sio_decision: date question "On what day did the SIO decide the v2 claim (D-D15)?"

input sio_min_used: money DUK question "Which MIN-PENSION did the SIO's decision cap the two pensions at (D-D15)?"

input surv_claim: date question "On what day did Halina claim the survivor pension (D-D12)?"

input v2_claim: date question "On what day did Halina claim under SOC-7 v2 (D-D14)?"

input zb_first: money DUK question "What was Zbigniew's pension when it started (D-D09)?"

input zb_start: date question "From what day was Zbigniew's pension paid (D-D09)?"

def cap_law[m in month]: money DUK = soc7_cap_mult * min_pension at start_of(m)

def capital: money DUK at own_claim_from
  note "SOC-5 .2, .3: each year's contribution, rounded to the ort as a contribution (GEN-5 .3, .5: at the step that produces it), times the exact product of the later indices; the capital rounded"
  rule base = round(sum(round(earnings[y] * soc5_contrib, minor(DUK), half-up) * val_factor[y] for y in year where y < ret_year), minor(DUK), half-up)

def entitled[m in month]: money DUK at start_of(m)
  note "the gross the law entitles Halina to for month m"
  rule both beats one, own_only v soc7_v2 = surv[m] + max(0, min(part_full[m], cap_law[m] - surv[m])) when v2_on[m]
  rule one beats own_only = if elected == zb then surv[m] else lvl[own, m] when surv_on[m]
  rule own_only = lvl[own, m]

def index_day[y in year]: date = start_of(month_of(start_of(y)) + soc6_month - 1) at start_of(y)

def indexed_on[k in pkind, y in year]: bool at start_of(y)
  note "SOC-6 .1: indexed on 1 March of y if it started before 1 March of y - 1, or from the first 1 March after a full year of payment"
  rule base = add_years(pen_start[k], 1) <= index_day[y]

def is_march[m in month]: bool = start_of(m) == index_day[year_of(m)] at start_of(m)

def lvl[k in pkind, m in month]: money DUK at start_of(m)
  rule first = pen_first[k] when m == month_of(pen_start[k])
  rule later = if is_march[m] and indexed_on[k, year_of(m)] then round(lvl[k, m - 1] * pen_idx[year_of(m)], minor(DUK), half-up) else lvl[k, m - 1] when m > month_of(pen_start[k])

def own_first: money DUK = round(capital / le_months[age(born_halina, own_claim_from)], minor(DUK), half-up) at own_claim_from

def part_full[m in month]: money DUK = round(lvl[own, m] * soc7_part, minor(DUK), half-up) at start_of(m)

def pen_first[k in pkind]: money DUK at reader
  rule own = own_first when k == own
  rule zb = zb_first when k == zb

def pen_start[k in pkind]: date at reader
  rule own = own_claim_from when k == own
  rule zb = zb_start when k == zb

def ret_year: year = year_of(own_claim_from) at reader

def sio_for[m in month]: money DUK at start_of(m)
  note "the gross the SIO paid for month m (arrears counted in the month they are for): the law until v2, then its decision (D-D15)"
  rule decided beats law = surv[m] + sio_part[m] when v2_on[m]
  rule law = entitled[m]

def sio_in[m in month]: money DUK at start_of(m)
  note "the gross the SIO paid in month m: before its decision the survivor pension alone, the arrears with the first payment after it"
  rule arrears beats base = sio_for[m] + sum(sio_part[k] for k in month where v2_on[k] and k < m) when v2_on[m] and m == month_of(arrears_day)
  rule base = sio_for[m]
  rule waiting beats base = surv[m] when v2_on[m] and start_of(m) <= sio_decision

def sio_owes[d in day]: money DUK = sum(entitled[m] - sio_for[m] for m in month where add_days(end_of(m), -1) <= d and v2_on[m]) at start_of(d)

def sio_part[m in month]: money DUK = max(0, min(part_full[m], soc7_cap_mult * sio_min_used - surv[m])) at start_of(m)

def surv[m in month]: money DUK at start_of(m)
  note "SOC-7 .1: 85 % of Zbigniew's pension on the day of the death, indexed as if it had started when his did"
  rule first = round(lvl[zb, month_of(death_day)] * soc7_rate, minor(DUK), half-up) when m == month_of(surv_from)
  rule later = if is_march[m] and indexed_on[zb, year_of(m)] then round(surv[m - 1] * pen_idx[year_of(m)], minor(DUK), half-up) else surv[m - 1] when m > month_of(surv_from)

def surv_on[m in month]: bool at start_of(m)
  note "SOC-7 .1, .2: a spouse aged 50 or over at the death, on a claim, from the month the claim takes effect"
  rule base = surv_claim != none and married and age(born_halina, death_day) >= soc7_min_age and start_of(m) >= surv_from

def surv_from: date at death_day
  rule late = start_of(month_of(surv_claim) + 1)
  rule timely beats late = start_of(month_of(death_day) + 1) when surv_claim <= add_months(death_day, soc7_claim_months)

def v2_on[m in month]: bool at start_of(m)
  note "SOC-7 v2 .4: point 3 applies on a claim, from the month it takes effect"
  rule base = v2_claim != none and start_of(m) >= v2_effective

def v2_effective: date at v2_claim
  rule late = start_of(month_of(v2_claim) + 1)
  rule timely beats late = soc7_v2_from when v2_claim <= soc7_claim_by

def val_factor[y in year]: num at start_of(y)
  note "SOC-5 .3: the product of VAL-IDX for every year from y + 1 to R - 1, built backwards; 1 where there is none"
  rule earlier beats last = val_factor[y + 1] * val_idx[y + 1] when y < ret_year - 1
  rule last = 1 when y >= ret_year - 1

def zb_pay_day[m in month]: date at start_of(m)
  note "D-D09: paid on the 5th of each month, or the last business day before it"
  rule base = schedule(m, pay_dom, preceding, holidays)

version zb_pension_decision
  cite d_d09
  governs always
  known 2018-11-30
  zb_first = 3752.61 "D-D09: 3 752.61 DUK a month"
  zb_start = 2018-12-01 "D-D09: from 1 December 2018"

