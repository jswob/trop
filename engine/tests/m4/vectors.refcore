  known 2017-09-01
  note "CC-2 v1, in force 2018-01-01 until replaced, published 2017-09-01; governs repayments from 2018-01-01."
  cc2_fee_long = 0.01 "CC-2 v1 .2"
  cc2_fee_short = 0.005 "CC-2 v1 .2"
,11:CIV-1.tally,688:part civ_1
  tally 2
  law
  note "CIV-1 · Property of spouses: community property from the marriage unless a contract sets separate property (.1); community is what either acquires during the marriage, earnings and the income of separate assets included (.2); separate is what a spouse owned before, acquires by inheritance or gift (unless given to both), or in exchange for separate assets (.3)."

source civ_1 "Civil and Family Code, CIV-1 Property of spouses (tmp/cases/law/acts.md)"

version civ1_v1
  cite civ_1
  governs 2018-01-01..
  known 2017-03-01
  note "CIV-1 v1, in force 2018-01-01 until replaced, published 2017-03-01; governs marriages from any date, from 2018-01-01."
,11:CIV-2.tally,668:part civ_2
  tally 2
  law
  note "CIV-2 · The end of community property: on a spouse's death, divorce or a marital contract, that day (.1); from that day each spouse, or the deceased's estate, holds half of every community asset and owes half of every community debt (.2)."
  note "No figure: the half is the literal 2 (L §7.1) in the households' defs."

source civ_2 "Civil and Family Code, CIV-2 The end of community property (tmp/cases/law/acts.md)"

version civ2_v1
  cite civ_2
  governs 2018-01-01..
  known 2017-03-01
  enters 2018-01-01
  note "CIV-2 v1, in force 2018-01-01 until replaced, published 2017-03-01; governs ends of community from 2018-01-01."
,11:CIV-3.tally,855:part civ_3
  tally 2
  law
  note "CIV-3 · Succession by law: with no will the spouse and the children inherit in equal shares, the spouse's never below 1/4, the children sharing the rest equally (.1); a child who died before is replaced by its own children in equal parts (.2); the heirs hold the estate in their shares from the death until the division, and bear its debts in them (.3)."

source civ_3 "Civil and Family Code, CIV-3 Succession by law (tmp/cases/law/acts.md)"

input civ3_spouse_min: num question "What is the least share of the estate the spouse inherits by law (CIV-3 .1)?"

version civ3_v1
  cite civ_3
  governs 2018-01-01..
  known 2017-03-01
  enters 2018-01-01
  note "CIV-3 v1, in force 2018-01-01 until replaced, published 2017-03-01; governs deaths from 2018-01-01."
  civ3_spouse_min = 0.25 "CIV-3 v1 .1: never less than 1/4"
,11:CIV-4.tally,695:part civ_4
  tally 2
  law
  note "CIV-4 · Co-ownership. Each co-owner bears the costs and takes the income of the thing by their share (.1); one who paid more than their share has a claim on the others for the excess, each for their share; rent collected by one is owed to the others for their shares (.2); no interest unless agreed (.3)."
  note "No figure: the households' cost-sharing defs apply it."

source civ_4 "Civil and Family Code, CIV-4 Co-ownership (tmp/cases/law/acts.md)"

version civ4_v1
  cite civ_4
  governs 2018-01-01..
  known 2017-03-01
  enters 2018-01-01
  note "CIV-4 v1, in force 2018-01-01 until replaced, published 2017-03-01; governs co-ownership from 2018-01-01."
,11:CIV-5.tally,758:part civ_5
  tally 2
  law
  note "CIV-5 · Division and buyouts: co-owners divide by agreement on any day (.1); one who takes an asset or a larger share pays each of the others the value given up, at the asset's value on the day of the division unless the agreement states another, times the share given up (.2); the payments are due by the day the agreement states (.3)."
  note "No figure: the agreement's own value, rounding and day are the household's rows."

source civ_5 "Civil and Family Code, CIV-5 Division and buyouts (tmp/cases/law/acts.md)"

version civ5_v1
  cite civ_5
  governs 2018-01-01..
  known 2017-03-01
  enters 2018-01-01
  note "CIV-5 v1, in force 2018-01-01 until replaced, published 2017-03-01; governs divisions from 2018-01-01."
,11:FAM-1.tally,2912:part fam_1
  tally 2
  law
  note "FAM-1 · The child benefit: a monthly amount for a child under 18 (.1), granted for benefit periods 1 June – 31 May; a claim filed by 30 April before the period gives it from June, a later claim from the month filed (.2; the filing day is a month-day row); for a child born during a period, a claim within 3 months of the birth gives it from the birth month, a later one from the month filed (.3); the birth month is prorated by days, rounded down to the ort (.4)."
  note "fam1_filed: the act doesn't say whether a claim sent by registered post is filed when posted or when the FBO receives it."

source fam_1 "Family Benefits Act, FAM-1 The child benefit (tmp/cases/law/acts.md)"

axis fam1_filed
  posted "a claim sent by registered post is filed on the day it is posted"
  received "a claim is filed on the day the FBO receives it"

index benefit_period = year 2018..2030 from 06-01
  v fam1_v1
  note "benefit periods run 1 June – 31 May (FAM-1 .2); key 2022 is 2022-06-01 – 2023-05-31"

input fam1_age: int question "Under what age is a child entitled (FAM-1 .1)?"

input fam1_amount: money DUK question "What is the monthly child benefit (FAM-1 .1)?"

input fam1_birth_months: int question "Within how many months of the birth must the claim be filed (FAM-1 .3)?"

input fam1_file_day: monthday question "On which day of the year is the last day to file a claim before its period (FAM-1 .2)?"

def fam1_file_by[p in benefit_period]: date at start_of(p)
  note "FAM-1 .2: the last day to file a claim for period p so that it gives the benefit from the period's start: the last 30 April before the period. The day is the month-day row fam1_file_day, found in the calendar year the period starts in, or the year before when that day isn't before the period's start"
  rule base = if fam1_file_in_year[p] < start_of(p) then fam1_file_in_year[p] else add_years(fam1_file_in_year[p], -1)

def fam1_file_in_year[p in benefit_period]: date at start_of(p)
  note "the filing day's month-day (fam1_file_day) in the calendar year in which period p starts"
  rule base = day_of(year_of(start_of(p)), fam1_file_day)

