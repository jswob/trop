  known 2026-01-01
  base = 12.25 PLN "s"
  base2 = 12 PLN "s"
  stp = 0.10 PLN "s"
  amt = 100 PLN "s"
,,1:0,168:a [rmode = half-up]: 12.30 PLN
  reading: rmode = half-up
  cut 2026-10-25
a [rmode = half-even | down]: 12.20 PLN
  reading: rmode = half-even | down
  cut 2026-10-25
