  opening[konto_eur] = 500 EUR at 2026-01-01 start "s"
version r1
  cite s
  governs 2026-01-01..2026-06-30
  known 2026-01-01
  fx = 4.30 "s"
version r2
  cite s
  governs 2026-06-01..2026-06-30
  known 2026-06-01
  replace fx = ?"the June rate?" "s"
,,1:0,77:a: (400.00 EUR, ?"the June rate?" (fx))
  unfulfilled: swap
  cut 2026-10-25
