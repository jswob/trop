source s "invented"

unit PLN: currency minor 0.01
unit EUR: currency minor 0.01

axis amode
  down "reading 1"
  up "reading 2"
  floor "reading 3"
  ceil "reading 4"
  half-up "reading 5"
  half-down "reading 6"
  half-even "reading 7"

input tp: num PLN
input tn: num PLN
input np: num PLN
input nn: num PLN
input odd: num PLN
input r5: num PLN
input r375: num PLN
input pct: num
input eur: num EUR
input months_n: int
input per_year: int
input premium: money PLN
input stp10: money PLN
input stp05: money PLN

def ra: money PLN = round(tp, stp10, amode)
def ran: money PLN = round(tn, stp10, amode)
def years_due: money PLN = premium * round(months_n / per_year, 1, up)

ask m_down: round(tp, stp10, down), round(tn, stp10, down), round(np, stp10, down), round(nn, stp10, down)
