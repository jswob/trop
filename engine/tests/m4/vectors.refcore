  lookback = 5 "rule 1: within the 5 years before a gift"
,,1:0,90:second_gift: (15 000.00 DUK, 5 000.00 DUK, 350 DUK)
  law date 2024-03-15, cut 2026-10-25
,9:I:M:CB-01,12:checks-green,34:run integration/models/CB-01.tally,4031:30:integration/models/CB-01.tally,3991:model cb01
  tally 2
  on 2026-10-19
  start 2026-01-01
  end 2026-12-31
  note "UN Model 2021, Commentary on Article 23 quoting OECD 2017 paras 18-27: one resident of State R, five relief methods side by side, cases (i) and (ii)."
  note "No currency is given, so amounts are in the abstract unit XXX. No tax year is given, so nothing governs a period."

source un_model_2021 "United Nations Model Double Taxation Convention between Developed and Developing Countries 2021 (ST/ESA/378), Commentary on Article 23" at "https://financing.desa.un.org/sites/default/files/2023-05/UN%20Model_2021.pdf"

unit XXX: currency minor 0.01

index case = [i, ii]

index method = [no_convention, exempt, progression, full_credit, ordinary_credit]

input income_r: money XXX

input income_s: money XXX

input income_total: money XXX

input rate_s[c in case]: num

input tax_s[c in case]: money XXX

band r_rate(income: money XXX): num
  note "State R's rate of tax on a total income; the source gives only two points and applies each to the whole base"

def deduction[m in method, c in case]: num XXX at reader
  note "the deduction State R allows for State S's tax, Article 23 B para 1 and Commentary paras 16 a) and b)"
  rule full = tax_s[c] when m == full_credit
  rule ordinary = min(tax_s[c], tax_r_on_s) when m == ordinary_credit

def rate_cut_on_r: num XXX = (r_rate(income_total) - r_rate(income_r)) * income_r at reader

def relief[m in method, c in case]: num XXX = tax_r_gross - tax_r[m, c] at reader

def tax_r[m in method, c in case]: num XXX at reader
  note "State R's tax under each method"
  rule credit = tax_r_gross - deduction[m, c] when m == full_credit or m == ordinary_credit
  rule exempt = r_rate(income_r) * income_r when m == exempt
  rule no_convention = tax_r_gross when m == no_convention
  rule progression = r_rate(income_total) * income_r when m == progression

def tax_r_gross: num XXX = r_rate(income_total) * income_total at reader

def tax_r_on_s: num XXX = r_rate(income_total) * income_s at reader

def total_tax[m in method, c in case]: num XXX = tax_r[m, c] + tax_s[c] at reader

ask q_all_in_r: tax_r_gross law 2026-10-19

ask q_deduction: deduction[m, c] for m in [full_credit, ordinary_credit], c in case law 2026-10-19

ask q_income_split: check income_total == income_r + income_s law 2026-10-19

ask q_rate_cut: rate_cut_on_r law 2026-10-19

ask q_relief: relief[m, c] for m in method, c in case law 2026-10-19

ask q_s_tax: check tax_s[c] == income_s * rate_s[c] for c in case law 2026-10-19

ask q_tax_on_s: tax_r_on_s law 2026-10-19

ask q_tax_r: tax_r[m, c] for m in method, c in case law 2026-10-19

ask q_total: total_tax[m, c] for m in method, c in case law 2026-10-19

