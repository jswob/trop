,12:C/loan.tally,7586:part loan
  tally 2
  note "Marta's loan to the community (C-HR7, C-D31): 30 000.00 paid out on 2025-06-20; each day CBL-REF in force that day over 365 of what is owed at the start of the day, added at each month's end and on the loan's last day (2026-09-16), to the ort, half up; 1 000.00 repaid from the joint account on the 10th of each month from August 2025 (the joint account's rows); forgiven at the start of 2026-09-17. The forgiveness is a gift to Jan of half the amount released (IGT-2 .4)."
  note "Whether a released debt is a gift of money that IGT-4 .4 reaches (exempt only where credited to the acquirer's payment account, and a release credits no account) is read two ways: the axis release_money. Whether Jan reports the release to the RO within 6 months (IGT-4 .2) no paper says: jan_reported is a hole, and the asks print each case."

axis release_money
  money "a released debt of money is a gift of money: credited to no account of Jan's, it is not exempt (IGT-4 .4), so a return is due within 1 month (IGT-5 .1)"
  not_money "a release is not a gift of money: IGT-4 .4 doesn't reach it, so it is exempt if reported within 6 months (IGT-4 .1, .2)"

input loan_principal: money DUK question "How much did Marta lend the community (C-HR7 .1)?"

input loan_paid_out: date question "On which day was the loan paid out (C-HR7 .1)?"

input loan_last_day: date question "Which is the loan's last day (C-HR7 .4)?"

input forgiven_on: date question "On which day does Marta forgive what is then owed (C-HR7 .4)?"

input jan_reported: bool question "Does Jan report the release to the RO within 6 months of it (IGT-4 .2)?"

input marta_gift_to_jan: money DUK question "How much did Marta give Jan from her own money on 2024-07-01 (story, the Lazur row)?"

input marta_gift_day: date question "On which day was Marta's gift to Jan credited to his account (the Lazur row)?"

version loan_agreement
  cite c_d31
  governs always
  known 2025-06-20
  loan_principal = 30000.00 "C-HR7 .1, C-D31: 30 000.00 from her own money, paid out on 2025-06-20"
  loan_paid_out = 2025-06-20 "C-HR7 .1: paid out on 2025-06-20; jodla-wspolny.csv line 525"
  loan_last_day = 2026-09-16 "C-HR7 .4: the loan's last day is 2026-09-16"
  forgiven_on = 2026-09-17 "C-HR7 .4: at the start of our tenth wedding anniversary, 2026-09-17"

version release_report
  cite story
  governs always
  known 2026-09-17
  jan_reported = ?"does Jan report Marta's release of the loan to the RO within 6 months of 2026-09-17 (IGT-4 .2)? no paper says" "story: nothing about a report of the release"

version gift_2024
  cite lazur_export
  governs always
  known 2024-07-01
  marta_gift_to_jan = 40000.00 "lazur-jan.csv line 5: DUK; PRZELEW PRZYCH.; Marta Wrona LN53 …; darowizna 40000.00; story 2024-07-01"
  marta_gift_day = 2024-07-01 "lazur-jan.csv line 5: 2024-07-01"

def loan_rate[d in day]: rate = cbl_ref at d

def loan_repaid_on[d in day]: money DUK = sum(jw[d, s].dr for s in seq where jw[d, s] != none and jw[d, s].k == j_loan_rep)

def loan_on[d in day]: bool = d >= loan_paid_out and d <= loan_last_day

def owed_start[d in day]: money DUK
  note "C-HR7 .2: what we owe at the start of day d: on the first day the 30 000.00, then what we owed at the end of the day before"
  rule first = loan_principal when d == loan_paid_out
  rule carry = owed_end[d - 1] when pos(d) > 1 and d > loan_paid_out and d <= loan_last_day

def day_interest[d in day]: num DUK
  note "C-HR7 .2: CBL-REF in force that day, over 365, of what we owe at the start of the day, exact"
  rule base = accrue(owed_start[d], loan_rate[d], d, d + 1, act365, simple)

def accrued[d in day]: num DUK
  note "the interest run since it was last added: added at each month's end and on the loan's last day (C-HR7 .2)"
  rule first = day_interest[d] when d == loan_paid_out
  rule fresh = day_interest[d] when d > loan_paid_out and month_of(d) != month_of(d - 1)
  rule carry = accrued[d - 1] + day_interest[d] when d > loan_paid_out and month_of(d) == month_of(d - 1)

def added[d in day]: money DUK
  note "C-HR7 .2: at each month's end and on the loan's last day, the interest run is added, to the ort, half up"
  rule none_today = 0 DUK
  rule add beats none_today = round(accrued[d], minor(DUK), half-up) when d == end_of(month_of(d)) - 1 day or d == loan_last_day

def owed_end[d in day]: money DUK
  note "what we owe at the end of day d: at its start, less the day's repayment, plus the interest added that day"
  rule base = owed_start[d] - loan_repaid_on[d] + added[d]

def loan_interest: money DUK = sum(added[d] for d in day where loan_on[d])

def loan_repaid: money DUK = sum(loan_repaid_on[d] for d in day where loan_on[d])

def owed_forgiven: money DUK
  note "C-HR7 .4: what we owe at the start of 2026-09-17, the end of the loan's last day"
  rule base = owed_end[loan_last_day]

def release_gift[s in spouse]: num DUK
  note "IGT-2 .4: the release is a gift of the amount released, on the day of the release; a debt the community owes one spouse released is a gift to the other spouse of half of it; the releasing spouse acquires nothing"
  rule other = owed_forgiven / lifted[two] when s == jan
  rule releaser = 0 DUK when s == marta

def jan_added_up: num DUK at forgiven_on
  note "IGT-3 .1: what Jan acquired from Marta in the 5 years before the release, added to it: the gift of 2024-07-01"
  rule base = release_gift[jan] + (if marta_gift_day > add_years(forgiven_on, -igt3_years) then marta_gift_to_jan else 0 DUK)

def jan_report_needed: bool at forgiven_on
  note "IGT-4 .2, .3: the report is what makes a close family's acquisition exempt; it is not required where the acquisition, added up under IGT-3 .1, is not above IGT-FREE-I; on reading money no report can make the release exempt (IGT-4 .4: a gift of money credited to no account of his), so none is needed for it"
  rule base = jan_added_up > igt_free[group_1] when release_money == not_money
  rule money_ = false when release_money == money

def jan_exempt: bool at forgiven_on
  note "IGT-4 .1 – .4: on reading money not exempt (.4); on reading not_money exempt where no report is required (.3) or Jan reports within 6 months (.2), a fact no paper gives"
  rule money_ = false when release_money == money
  rule not_money_ = not jan_report_needed or jan_reported when release_money == not_money

def roll_next[d in day]: date
  note "GEN-2 .2: a deadline on a day that is no business day moves to the next business day"
  rule base = if is_business(d, holidays) then start_of(d) else add_business(d, 1, holidays)

def jan_report_by: date at forgiven_on
  note "IGT-4 .2: within 6 months of the day the tax arose (IGT-2 .4: the day of the release), GEN-3 .1, GEN-2 .2"
  rule needed = roll_next[add_months(forgiven_on, igt4_report_months)] when jan_report_needed
  rule not_needed = none when not jan_report_needed

def jan_return_by: date at forgiven_on
  note "IGT-5 .1: a return within 1 month of the release where the acquisition is not exempt"
  rule exempt_ = none
  rule due beats exempt_ = roll_next[add_months(forgiven_on, igt5_return_months)] when not jan_exempt

def jan_gift_tax: money DUK at forgiven_on
  note "IGT-3: the Group I scale on what the added-up acquisitions exceed IGT-FREE-I, the base rounded (IGT-2 .3), the tax rounded (IGT-3 .4); none was paid on the earlier gift (exempt: not above the free amount, credited to his account, IGT-4 .3, .4)"
  rule exempt_ = 0 DUK
  rule taxed beats exempt_ = round(igt3_scale[group_1](max(0 DUK, round(jan_added_up, 1, half-up) - igt_free[group_1])), 1, half-up) when not jan_exempt
,12:C/stas.tally,5778:part stas
  tally 2
  note "Staś's money (C-HR5, C-D36): what Irena sent 'dla Stasia', what the joint account held for him at each day's end (all he had been sent, up to the balance), the days it was short; and the gift tax on Irena's gifts (IGT-1 – IGT-5): Staś is her grandson (Group I, a descendant), but he has no account of his own, so a gift of money credited to his parents' joint account is not exempt (IGT-4 .4), and each gift needs a return within 1 month (IGT-5 .1)."
  note "The joint account's balance at a day's end is the balance after the day's last row (rec_joint), or the day before's where the day has none; on 2024-01-01 the story's opening."

input stas_has_account: bool question "Does Staś have a payment account of his own (story 2023-04-03)?"

input gift_amount: money DUK question "How much does Irena send each month (C-D36)?"

input gift_from: month question "From which month does Irena send it (C-D36, story 2023-04-03)?"

input records_from: date question "From which day do the joint account's rows run (records/jodla-wspolny.csv)?"

version irena_letter
  cite c_d36
  governs always
  known 2023-04-01
  gift_amount = 300.00 "C-D36: From April I'll send 300 every month, on the 3rd"
  gift_from = 2023-04 "C-D36: From April; story 2023-04-03: Irena's first 300.00"

version stas_facts
  cite story
  governs always
  known 2024-01-01
  stas_has_account = false "story 2023-04-03: Staś has no account of his own"
  records_from = 2024-01-01 "records/jodla-wspolny.csv: Okres 01.01.2024 – 30.09.2026"

def jw_rows[d in day]: int = count(s in seq where jw[d, s] != none)

def jw_end[d in day]: money DUK
  note "the joint account's balance at the end of day d"
  rule carry = jw_end[d - 1] when pos(d) > 1
  rule opening beats carry = open_bal[joint] when pos(d) == 1 and jw_rows[d] == 0
  rule seen beats carry, opening = jw[d, last(s in seq where jw[d, s] != none)].bal when jw_rows[d] > 0

def irena_in[d in day]: money DUK = sum(jw[d, s].cr for s in seq where jw[d, s] != none and jw[d, s].k == j_irena)

def sent_to[d in day]: money DUK
  note "C-HR5 .2: all Staś has been sent by the end of day d: what he had on 2024-01-01 (C-HR5 .3, story § What we had) and Irena's rows since"
  rule carry = sent_to[d - 1] + irena_in[d] when pos(d) > 1
  rule opening beats carry = stas_open + irena_in[d] when pos(d) == 1

def stas_held[d in day]: money DUK
  note "C-HR5 .2: at each day's end the joint account holds Staś's money first, up to all he has been sent"
  rule base = min(sent_to[d], jw_end[d])

def stas_short[d in day]: money DUK
  note "C-HR5 .2: the shortfall, ours to put back, where the balance is below all he has been sent"
  rule base = max(0 DUK, sent_to[d] - jw_end[d])

def days_short[d in day]: int
  note "the days from 2024-01-01 to d on whose end the account was short"
  rule base = count(x in day where x <= d and stas_short[x] > 0 DUK)

def short_max[d in day]: money DUK = max(stas_short[x] for x in day where x <= d)

def short_max_on[d in day]: date
  note "the first day, to d, on which the shortfall was the largest"
  rule base = first(x in day where x <= d and stas_short[x] == short_max[d])

def gift_day[m in month]: date
  note "the day Irena's gift of month m was credited: the joint account's row from 2024 on; before the rows run, the 3rd or the next business day (story 2023-04-03, C-D36)"
  rule letter = schedule(m, lifted[gift_dom], following, holidays)
  rule seen beats letter = first(d in day where month_of(d) == m and irena_in[d] > 0 DUK) when start_of(m) >= records_from

def gift_amt[m in month]: money DUK
  rule letter = gift_amount
  rule seen beats letter = sum(irena_in[d] for d in day where month_of(d) == m) when start_of(m) >= records_from

def gift_m[m in month]: bool = m >= gift_from and start_of(m) <= cut

def gift_exempt[m in month]: bool
  note "IGT-4 .1 exempts a descendant's acquisition, but a gift of money only where it was credited to the acquirer's payment account (IGT-4 .4); point 3 doesn't lift that"
  rule base = stas_has_account

def gift_return_due[m in month]: date at gift_day[m]
  note "IGT-5 .1: a return within 1 month of the day the tax arose (IGT-2 .1: the day the money was credited), GEN-3 .1; a deadline on a day that is no business day moves to the next one (GEN-2 .2)"
  rule base = if is_business(add_months(gift_day[m], igt5_return_months), holidays) then add_months(gift_day[m], igt5_return_months) else add_business(add_months(gift_day[m], igt5_return_months), 1, holidays) when not gift_exempt[m]
  rule exempt beats base = none when gift_exempt[m]

def returns_overdue[d in day]: int
  note "the gifts whose return was due before day d (none was filed: story 2023-04-03)"
  rule base = count(m in month where gift_m[m] and gift_return_due[m] != none and gift_return_due[m] < d)

def next_return[d in day]: date
  note "the first return due on or after day d"
  rule base = min(gift_return_due[m] for m in month where gift_m[m] and gift_return_due[m] != none and gift_return_due[m] >= d)

def gifts_5y[m in month]: money DUK at gift_day[m]
  note "IGT-3 .1: what Staś acquired from Irena in the 5 years before the last acquisition (the gift of month m), added to it"
  rule base = sum(gift_amt[k] for k in month where gift_m[k] and k <= m and gift_day[k] > add_years(gift_day[m], -igt3_years))

def gift_tax[m in month]: money DUK at gift_day[m]
  note "IGT-3: the Group I scale on what the added-up acquisitions exceed the free amount in force on the day the last one's tax arose, rounded (GEN-5 .1), less the tax already paid on the earlier ones (none was paid)"
  rule base = round(igt3_scale[group_1](max(0 DUK, gifts_5y[m] - igt_free[group_1])), 1, half-up) when not gift_exempt[m]
  rule exempt beats base = 0 DUK when gift_exempt[m]
,18:E2/cside/e2c.tally,5839:part e2c
  tally 2
  note "Household E2 (tmp/cases-holdout/E2/story.md), its side in household C. C (tmp/cases-holdout/tally-2.0/C/full, by H1) is no member of E2's joint model (../joint): it can be pinned (hrun --reprint), but with C a member every cell of the join that reaches D's day walk runs past the 90 s limit (W-E2-4). So what E2 reads of C is asked here, in a run of C's own files, unchanged and read only, with this part beside them. The part changes none of C's items and states no row of them: it reads C's items bare (C's ids) and adds its own, every id prefixed e2c_, so C's own answers are what they are without it."
  note "E2-01: Marta's payout as the export of her own Bank Jodła account shows it (C's rows mo, records/jodla-marta.csv line 19) against C-D30. E2-02: what Jan acquired from Marta (C's loan.tally: the gift of 2024-07-01 and the release of 2026-09-17, IGT-2 .4; its tax turns on C's axis release_money and, on the reading not_money, on whether Jan reports the release within 6 months (IGT-4 .2), C's hole row jan_reported, so it is asked plain and with that row pinned true and false) and Staś from Irena (C's stas.tally), each with its tax as C derives it. E2-03: what Marta was paid, whether it is hers alone (CIV-1 .3), what she lent the community (C-HR7, C's loan_principal and her account's row), what the community owed her when she forgave the loan (C's owed_forgiven) and what that gave Jan (C's release_gift, in whole dukats)."

source e2c_c_d30 "C-D30 · Notary's notice of payment from the deposit (tmp/cases-holdout/C/docs/C-D30.md)"

source e2c_d_d04 "D-D04 · Certificate of inheritance (extract) (engine/tests/cases/D/docs/D-D04.md)"

input e2c_notice_paid: money DUK question "How much does the notary's notice C-D30 say was paid to Marta from the deposit?"

input e2c_notice_on: date question "On which day does C-D30 say the notary paid Marta?"

input e2c_by_inheritance: bool question "Did Marta acquire what the notary paid her as an heir, for the share she inherited (C-D30, D-D07 .4)?"

input e2c_for_both: bool question "Did the deceased state that what Marta inherits is for both spouses (CIV-1 .3)?"

def e2c_estate_in[d in day]: money DUK
  note "what the rows of Marta's own account on day d that C classes as the estate's payout (m_estate_in) credit"
  rule base = sum(mo[d, s].cr for s in seq where mo[d, s] != none and mo[d, s].k == m_estate_in)

def e2c_marta_arrived: date
  note "the first day, from the notary's payment (C-D30) to the cut, on which the export of Marta's own account shows the estate's payout arriving"
  rule base = first(x in day where x >= e2c_notice_on and x <= cut and e2c_estate_in[x] > 0 DUK)

def e2c_marta_paid: money DUK
  note "all that the export of Marta's own account shows arriving from the estate, to the cut"
  rule base = sum(e2c_estate_in[x] for x in day where x <= cut)

def e2c_lent_out: money DUK
  note "what the export of Marta's own account shows going out as the loan to the community (C classes the row m_loan_out: jodla-marta.csv line 20), to the cut"
  rule base = sum(mo[x, s].dr for x in day, s in seq where x <= cut and mo[x, s] != none and mo[x, s].k == m_loan_out)

def e2c_hers_alone: bool
  note "CIV-1 .3: what a spouse acquires by inheritance is her separate property, unless the giver states it is for both; what is acquired in exchange for separate assets is separate too, so the payout for the share she inherited and gave up (D-D07 .4) is hers alone"
  rule base = e2c_by_inheritance and not e2c_for_both

def e2c_gift_jan: money DUK
  note "what the forgiveness gave Jan (IGT-2 .4: half the amount released, C's release_gift[jan], carried exactly), in whole dukats as the question asks, rounded as IGT-2 .3 rounds a base (GEN-5 .1: under 50 orts down, 50 orts and over up)"
  rule base = round(release_gift[jan], 1, half-up)

version e2c_no_will
  cite e2c_d_d04
  governs always
  known 2024-10-21
  e2c_for_both = false "D-D04: the estate of Zbigniew Sowa, who left no will, is inherited by law (CIV-3): no statement of his makes Marta's share for both spouses"

version e2c_notice_c_d30
  cite e2c_c_d30
  governs always
  known 2025-06-16
  note "C-D30 is issued on 2025-06-16 and states no received date; the stories (E2 and C, 2025-06-16) know the payout that day"
  e2c_by_inheritance = true "C-D30: to Marta Wrona (née Sowa), heir of 3/16: her payout"
  e2c_notice_on = 2025-06-16 "C-D30: was paid today from the deposit (issued 2025-06-16)"
  e2c_notice_paid = 38750.00 DUK "C-D30: her payout of 38 750.00 DUK was paid today from the deposit to her account LN53 6100 3001 0000 2209 5148 0001"

