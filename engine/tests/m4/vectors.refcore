      rule base: won
        [2] row v:sp = 2026-04
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
        [3] row v:w = 2026-06-06
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
        [4] running read bal(konto) = 500.00 PLN, the balance up to this point of 2026-06-06
        [5] row v:amt = 10.00 PLN
            version v, source s, "invented", locator "s", governs always, known 2026-01-01
  cut 2026-06-20
