  slip[2025-07] = (paid: 2025-08-05, cls: class2, hours: 5, gross: 5195.00, rsi: 701.32, tax: 482.00, net: 4011.68) known 2025-08-05 "C-D20 row 2025-07"
  slip[2025-08] = (paid: 2025-09-05, cls: class2, hours: 0, gross: 5000.00, rsi: 675.00, tax: 441.00, net: 3884.00) known 2025-09-05 "C-D20 row 2025-08"
  slip[2025-09] = (paid: 2025-10-02, cls: class2, hours: 16, gross: 5624.00, rsi: 759.24, tax: 571.00, net: 4293.76) known 2025-10-02 "C-D20 row 2025-09"
  slip[2025-10] = ?"Jan's payslip for October 2025 (lost)" known 2025-11-05 "story: the payslip for October 2025 is lost"
