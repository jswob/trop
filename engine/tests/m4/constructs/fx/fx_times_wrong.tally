model fx_times_wrong
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31

source s "invented"

unit PLN: currency minor 0.01
unit EUR: currency minor 0.01

input fx: num PLN/EUR
input pln: money PLN

def wrong: num PLN = pln * fx

ask a: wrong

version v
  cite s
  governs always
  known 2026-01-01
  fx = 4.30 "s"
  pln = 1000 PLN "s"
