model first_things
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31

source s "invented"

unit PLN: currency minor 0.01

kind people

input inc[p in people]: money PLN
input on_day: date
input lim: money PLN

def first_rich: key people = first(p in people on on_day where inc[p] > lim)

ask a: first_rich

version v
  cite s
  governs always
  known 2026-01-01
  people + [ann] lives 2026-01-01..
  people + [bob] lives 2026-01-01..
  inc[ann] = 2 PLN "s"
  inc[bob] = 1 PLN "s"
  on_day = 2026-06-01 "s"
  lim = 0 PLN "s"
