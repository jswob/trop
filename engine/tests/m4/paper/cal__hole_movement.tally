model p
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31

source s "invented"

unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place landlord: outside lives 2026-01-01..
input len: calendar
input dom: int
input rent: money PLN
move pay[m in months]: transfers
  on schedule(m, dom, following, len)
  leg cash from konto to landlord amount rent
ask a: bal(konto, 2026-03-31), bal(konto, 2026-12-31)
ask b: count(t in transfers over 2026-01-01 .. 2026-03-31)
ask c: pay[2026-02].day
version v
  cite s
  governs always
  known 2026-01-01
  dom = 15 "s"
  rent = 100 PLN "s"
  opening[konto] = 5000 PLN at 2026-01-01 start "s"
version cal
  cite s
  governs 2026
  known 2026-01-01
  len = calendar(weekends [sat, sun], yearly [01-01], added [?"the extra 2026 holiday, announced later"])
