model p
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31

source s "invented"

unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
input len: calendar
input len2: calendar
input sat: date
input d0: date
def b_sat: bool = is_business(sat, len)
def b_w: bool = is_business(d0, len2)
def b_w2: bool = is_business(sat, len2)
ask a: b_sat
ask b: b_w, b_w2
version v
  cite s
  governs always
  known 2026-01-01
  sat = 2026-06-06 "s"
  d0 = 2026-06-04 "s"
version cal
  cite s
  governs 2026
  known 2026-01-01
  len = calendar(weekends [sat, sun], yearly [01-01], added [?"is 06-05 a holiday?"])
  len2 = calendar(weekends [sat, sun], yearly [01-01], added [window(2026-06-05, 2026-06-08)])
