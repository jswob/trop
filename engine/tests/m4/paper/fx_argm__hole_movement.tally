model p
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31

source s "invented"

unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind exchanges: event certain
  leg eur: EUR
  leg pln: PLN
place konto: accounts PLN lives 2026-01-01..
place konto_eur: accounts EUR lives 2026-01-01..
place kantor_eur: outside lives 2026-01-01..
place kantor_pln: outside lives 2026-01-01..
input fx[d in days]: num PLN/EUR
input w: date
input d2: date
input amt: money EUR
move swap: exchanges
  on w
  at w
  leg eur from konto_eur to kantor_eur amount amt
  leg pln from kantor_pln to konto amount round(amt * fx[w], minor(PLN), half-up)
move swap2: exchanges
  on d2
  at d2
  leg eur from konto_eur to kantor_eur amount amt
  leg pln from kantor_pln to konto amount round(amt * fx[d2], minor(PLN), half-up)
ask a: bal(konto_eur, 2026-12-31), bal(konto, 2026-12-31)
ask b: argmin(t.eur.amount for t in exchanges over 2026) ties by t.day
ask c: argmax(t.day for t in exchanges over 2026) ties by t.eur.amount
ask p: bal(konto, 2026-12-31) with w = 2026-03-03
version v
  cite s
  governs always
  known 2026-01-01
  w = window(2026-03-02, 2026-03-04) "s"
  d2 = 2026-05-04 "s"
  amt = 100 EUR "s"
  fx = 4.30 "s"
  opening[konto] = 1000 PLN at 2026-01-01 start "s"
  opening[konto_eur] = 500 EUR at 2026-01-01 start "s"
