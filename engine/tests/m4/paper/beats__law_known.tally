model p
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2027-12-31

source s "invented"

unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
input c: bool
input va: money PLN
input vb: money PLN
def x: money PLN at reader
  rule exc beats base v v27 = va when c
  rule base = vb
def y: money PLN at reader
  rule exc beats base governs 2027.. = va when c
  rule base = vb
ask l26: x, y law 2026-06-01
ask l27: x, y law 2027-06-01
ask k27: x, y law 2027-06-01 as known 2026-03-01
ask p27: x as if {law 2026-06-01}, x as if {known 2026-03-01} law 2027-06-01
ask e27: explain x law 2027-06-01 as known 2026-03-01
version v
  cite s
  governs always
  known 2026-01-01
  c = true "s"
  va = 1 PLN "s"
  vb = 2 PLN "s"
version v27
  cite s
  governs 2027..
  known 2026-06-01
