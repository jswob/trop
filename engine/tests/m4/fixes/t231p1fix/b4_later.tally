model b4l
  tally 2
  on 2026-05-20
  start 2026-01-01
  end 2026-03-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-02
place pot: accounts PLN lives 2026-01-01..
place pot2: accounts PLN lives 2026-01-01..
place landlord: outside lives 1900-01-01..
place world2: outside lives 1900-01-01..
input bank: observed
input amt: money PLN
input d5: int

move rent[m in month]: transfers
  on day_of(m, d5)
  leg cash from pot to landlord amount amt

ask c: bal(pot, 2026-03-31)
ask c2: bal(pot2, 2026-03-31)
ask rs: residuals pot 2026-01-01..2026-03-31
ask rs2: residuals pot2 2026-01-01..2026-03-31
ask rk: residuals pot 2026-01-01..2026-03-31 as known 2026-04-05
ask ck: bal(pot, 2026-03-31) as known 2026-04-05

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  d5 = 5 "s"
  opening[pot] = 9000.00 PLN at 2026-01-01 start "s"
  opening[pot2] = 500.00 PLN at 2026-01-01 start "s"

version q1
  cite s
  governs 2026-01-01..2026-03-31
  known 2026-04-01
  covers pot
  bank[a1] = (on: 2026-01-07, kind: transfers, leg cash from pot to landlord amount 110.00 PLN, fulfils: rent[2026-01]) "jan"

version q2
  cite s
  governs 2026-01-01..2026-03-31
  known 2026-04-10
  covers pot
  replace bank[a1] = (on: 2026-01-07, kind: transfers, leg cash from pot2 to world2 amount 110.00 PLN, fulfils: rent[2026-01]) "jan was from pot2"
  bank[a2] = (on: 2026-02-09, kind: transfers, leg cash from pot2 to world2 amount 120.00 PLN, fulfils: rent[2026-02]) "feb from pot2"
