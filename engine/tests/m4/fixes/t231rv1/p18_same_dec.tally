model p17
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-12-31

source s "probe"
unit PLN: currency minor 0.01
place wallet: accounts PLN lives 2025-01-01..
place world: outside lives 1900-01-01..
input d1: date
input d2: date
input a: money PLN
input bank: observed

move in1: transfers
  reads wallet
  on d1
  leg cash from world to wallet amount a + 0 * bal(wallet)
move in2: transfers
  on d2
  leg cash from world to wallet amount a

ask b4: bal(wallet, 2026-03-04)
ask b6: bal(wallet, 2026-03-06)
ask b8: bal(wallet, 2026-03-08)
ask b31: bal(wallet, 2026-03-31)
ask f: flows(wallet, 2026-03)
ask b31k: bal(wallet, 2026-03-31) as known 2026-03-31
ask ex: explain bal(wallet, 2026-03-31)

version v
  cite s
  governs always
  known 2025-12-01
  opening[wallet] = 0.00 PLN at 2026-01-01 start "s"
  d1 = 2026-03-05 "s"
  d2 = 2026-03-07 "s"
  a = 100.00 PLN "s"
  same in1 = in2

