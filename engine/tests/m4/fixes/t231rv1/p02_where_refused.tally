model p02
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "probe"
index ns = 1..3
input x[n in ns]: int
input ten: int
input two: int

ask aw: any(x[n] > two for n in ns where ten / x[n] > 0)
ask lw: all(x[n] < two for n in ns where ten / x[n] > 0)
ask cw: count(n in ns where ten / x[n] > 0)
ask fw: first(n in ns where ten / x[n] > 0)

version v
  cite s
  governs always
  known 2026-01-01
  ten = 10 "s"
  two = 2 "s"
  x[1] = 0 "ref"
  x[2] = 1 "small"
  x[3] = 5 "big"
