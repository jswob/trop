model p16
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-12-31

source s "probe"
unit PLN: currency minor 0.01
place wallet: accounts PLN lives 2025-01-01..
place world: outside lives 1900-01-01..
input d1: date
input d2: date
input a1: money PLN
input a2: money PLN

move in1: transfers
  on d1
  at d1
  leg cash from world to wallet amount a1
move in2: transfers
  on d2
  at d2
  leg cash from world to wallet amount a2

ask b: bal(wallet, 2026-06-30)
ask bs: bal(wallet, 2026-06-30) in up
ask bs3: bal(wallet, 2026-03-31) in up
ask pa: bal(wallet, 2026-06-30) with a2 = 100.00 PLN
ask pa3: bal(wallet, 2026-03-31) with a2 = 100.00 PLN
ask ph3: bal(wallet, 2026-03-31) with a2 = 120.00 PLN
ask pd: bal(wallet, 2026-06-30) with d2 = 2026-03-05
ask d: diff(bal(wallet, 2026-06-30)) in up against p16

version v
  cite s
  governs always
  known 2025-12-01
  opening[wallet] = 0.00 PLN at 2026-01-01 start "s"
  d1 = 2026-03-05 "s"
  d2 = 2026-05-07 "s"
  a1 = 100.00 PLN "s"
  a2 = 130.00 PLN "s"
  same in1 = in2
