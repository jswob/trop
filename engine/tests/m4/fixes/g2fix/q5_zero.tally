model q5
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2027-12-31

source s "invented"
input d_ok: date
input d_h: date
input d_w: date
input n0: int
input cal: calendar
ask z1: add_business(d_ok, n0, cal)
ask z2: add_business(d_h, n0, cal)
ask z3: add_business(d_w, n0, cal)
version v
  cite s
  governs always
  known 2026-01-01
  d_ok = 2026-03-04 "s"
  d_h = ?"which d?" "s"
  d_w = window(2026-03-02, 2026-03-04) "s"
  n0 = 0 "s"
  cal = calendar(weekends [sat, sun], yearly [01-01]) "s"
