version v
  cite s
  governs always
  known 2026-01-01
  a_h = ?"which a?" "s"
  a_n = none "s"
  a_n2 = none "s"
  a_ok = 2026-01-01 "s"
  a_v = never "s"
  b_h = ?"which b?" "s"
  b_n = none "s"
  b_n2 = none "s"
  b_ok = 2027-01-01 "s"
  b_v = never "s"
  c_h = ?"which c?" "s"
  c_k = discount "s"
  c_k2 = discount "s"
  c_n = none "s"
  c_n2 = none "s"
  c_ok = simple "s"
  c_z = nominal 0 "s"
  c_z2 = nominal 0 "s"
  dc_h = ?"which dc?" "s"
  dc_n = none "s"
  dc_n2 = none "s"
  dc_ok = act365 "s"
  p_h = ?"which p?" "s"
  p_n = none "s"
  p_ok = 100.00 PLN "s"
  r_h = ?"which r?" "s"
  r_m = 1 %/month "s"
  r_m2 = 1 %/month "s"
  r_n = none "s"
  r_ok = 10 %/year "s"
