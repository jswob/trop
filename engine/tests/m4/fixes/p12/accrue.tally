ask h_dc__n_r: accrue(p_ok, r_n, a_ok, b_ok, dc_h, c_ok)
ask h_dc__m_r: accrue(p_ok, r_m, a_ok, b_ok, dc_h, c_ok)
ask h_dc__n_a: accrue(p_ok, r_ok, a_n, b_ok, dc_h, c_ok)
