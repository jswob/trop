model p12_accrue
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2027-12-31

source s "invented"

unit PLN: currency minor 0.01

input a_h: date
input a_n: date
input a_n2: date
input a_ok: date
input a_v: date
input b_h: date
input b_n: date
input b_n2: date
input b_ok: date
input b_v: date
input c_h: compounding
input c_k: compounding
input c_k2: compounding
input c_n: compounding
input c_n2: compounding
input c_ok: compounding
input c_z: compounding
input c_z2: compounding
input dc_h: daycount
input dc_n: daycount
input dc_n2: daycount
input dc_ok: daycount
input p_h: money PLN
input p_n: money PLN
input p_ok: money PLN
input r_h: rate
input r_m: rate
input r_m2: rate
input r_n: rate
input r_ok: rate

ask h_p: accrue(p_h, r_ok, a_ok, b_ok, dc_ok, c_ok)
ask h_r: accrue(p_ok, r_h, a_ok, b_ok, dc_ok, c_ok)
