model p12_last_business
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2027-12-31

source s "invented"

unit PLN: currency minor 0.01

input cal_h: calendar
input cal_n: calendar
input cal_ok: calendar
input mo_h: month
input mo_n: month
input mo_ok: month
input n_h: int
input n_n: int
input n_ok: int

ask h_mo: last_business(mo_h, n_ok, cal_ok)
ask h_n: last_business(mo_ok, n_h, cal_ok)
ask h_cal: last_business(mo_ok, n_ok, cal_h)
ask h_mo__h_n: last_business(mo_h, n_h, cal_ok)
ask h_mo__n_n: last_business(mo_h, n_n, cal_ok)
ask h_mo__n_cal: last_business(mo_h, n_ok, cal_n)
ask h_n__n_mo: last_business(mo_n, n_h, cal_ok)
ask h_n__n_cal: last_business(mo_ok, n_h, cal_n)
ask h_cal__n_mo: last_business(mo_n, n_ok, cal_h)
ask h_cal__n_n: last_business(mo_ok, n_n, cal_h)

version v
  cite s
  governs always
  known 2026-01-01
  cal_h = calendar(weekends [sat, sun], yearly [01-01]) "s"
  cal_n = none "s"
  cal_ok = calendar(weekends [sat, sun], yearly [01-01]) "s"
  mo_h = 2026-03 "s"
  mo_n = none "s"
  mo_ok = 2026-03 "s"
  n_h = 2 "s"
  n_n = none "s"
  n_ok = 2 "s"
