model f13
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "invented"

unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input amt2: money PLN
input w: date
input w2: date
input sp: month

move da: transfers
  on w
  reads konto
  leg cash from world to konto amount if bal(konto) > amt then amt else amt
move pb: transfers
  on w2
  leg cash from world to konto amount amt2

def sm: money PLN = sum(t.cash.amount for t in transfers over sp .. sp)
def cw: int = count(t in transfers over sp .. sp where t.cash.amount > amt2)

ask e_sm: explain sm
ask e_cw: explain cw
ask v_all: sm, cw

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  amt2 = 30.00 PLN "s"
  w = 2026-04-30 "s"
  w2 = 2026-04-10 "s"
  sp = 2026-04 "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
