model f12
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "invented"

unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input w: date
input wb: date
input sp: month

move da: transfers
  on w
  reads konto
  leg cash from world to konto amount if bal(konto) > amt then amt else amt
move db: transfers
  on w
  reads konto
  when wb < w
  leg cash from world to konto amount if bal(konto) > amt then amt else amt

def fa: money PLN = flows(da, sp .. sp)
def fb: money PLN = flows(db, sp .. sp)

ask e_fa: explain fa
ask e_fb: explain fb

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  w = 2026-04-30 "s"
  wb = 2026-04-20 "s"
  sp = 2026-04 "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
