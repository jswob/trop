model f11
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "invented"

unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input w: date
input wa: date
input wb: date
input w2: date
input sp: month

move dyes: transfers
  on w
  reads konto
  when wa < w
  leg cash from world to konto amount if bal(konto) > amt then amt else amt
move dund: transfers
  on w2
  reads konto
  when wb < w2
  leg cash from world to konto amount if bal(konto) > amt then amt else amt

def fy: money PLN = flows(dyes, sp .. sp)
def fu: money PLN = flows(dund, sp .. sp)
def cu: int = count(m in transfers over sp .. sp)

ask e_fy: explain fy
ask e_fu: explain fu
ask e_cu: explain cu
ask e_fy_pin: explain fu with wb = 2026-04-01
ask v_all: fy, fu, cu

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  w = 2026-04-30 "s"
  w2 = 2026-04-29 "s"
  wa = window(2026-04-01, 2026-04-10) "s"
  wb = window(2026-04-20, 2026-05-10) "s"
  sp = 2026-04 "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
