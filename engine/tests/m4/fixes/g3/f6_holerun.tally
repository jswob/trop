model f6
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "invented"

unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input amt_b: money PLN
input w: date
input wh: date
input sp: month

move dh: transfers
  on wh
  leg cash from world to konto amount amt
move dx: transfers
  on w
  reads konto
  leg cash from world to konto amount if wb then amt else amt_b

def wb: bool = bal(konto) > amt
def fl: money PLN = flows(dx, sp .. sp)

ask e_fl: explain fl
ask e_wb: explain wb
ask v_fl: fl

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  amt_b = 70.00 PLN "s"
  w = 2026-04-30 "s"
  wh = window(2026-04-29, 2026-05-02) "s"
  sp = 2026-04 "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
