model b3
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-05-31

source s "probe"
unit PLN: currency minor 0.01
axis rd
  r1 "one"
  r2 "two"
index month = month 2026-01..2026-05
place konto: accounts PLN lives 2026-01-01..
place save: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input bank: observed
input lim: money PLN
input amt: money PLN
input d5: int
input fm: month
input ok[m in month]: bool
input lim2: money PLN

def lm: money PLN
  rule hi = lim when rd == r1
  rule lo = lim2 when rd == r2

move topup[m in month]: transfers
  reads konto, save
  on day_of(m, d5)
  when bal(konto) < lm and ok[m]
  leg cash from save to konto amount min(amt, bal(save))

def fl: money PLN = flows(topup, fm)
ask f: fl with rd = r1
ask fok: fl with rd = r1, ok[2026-02] = true
ask flim: fl with rd = r2, lim2 = 800.00 PLN
ask ef: explain fl with rd = r1
ask iof: inputs-of fl with rd = r1
ask iolim: inputs-of fl with rd = r2, lim2 = 800.00 PLN
ask ob: observed(topup[fm]).cash.amount with rd = r1, ok[2026-02] = true
ask n: count(o in bank over fm where o.fulfils == topup[fm]) with rd = r2
ask loose: sum(o.cash.amount for o in bank over fm where o.fulfils == none) with rd = r1

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"
  opening[save] = 5 000.00 PLN at 2026-01-01 start "s"
  lim = 600.00 PLN "s"
  lim2 = 700.00 PLN "s"
  amt = 400.00 PLN "s"
  d5 = 5 "s"
  fm = 2026-02 "s"
  ok[2026-01] = true "j"
  ok[2026-02] = true assumed "feb guess" "f"
  ok[2026-03] = true "m"
  ok[2026-04] = true "a"
  ok[2026-05] = true "y"

version feb
  cite s
  governs 2026-02
  known 2026-03-01
  covers konto
  bank[r1] = (on: 2026-02-05, kind: transfers, leg cash from save to konto amount 400.00 PLN, fulfils: topup[2026-02]) "the top-up"
