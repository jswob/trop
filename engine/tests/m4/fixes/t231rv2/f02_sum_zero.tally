model f02
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "probe"
index ns = 1..3
input x[n in ns]: int
input h[n in ns]: int
input ten: int

ask sh: sum(x[n] for n in ns where h[n] > 0)
ask sr: sum(x[n] for n in ns where ten / x[n] > 0)
ask sr0: sum(0 for n in ns where ten / x[n] > 0)
ask sh0: sum(0 for n in ns where h[n] > 0)

version v
  cite s
  governs always
  known 2026-01-01
  ten = 10 "s"
  x[1] = 2 "ok"
  x[2] = 0 "ref"
  x[3] = 5 "big"
  h[1] = 1 "s"
  h[2] = ?"h2?" "hole"
  h[3] = 1 "s"
