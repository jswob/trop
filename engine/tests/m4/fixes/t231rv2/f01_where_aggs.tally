model f01
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "probe"
index ns = 1..3
input x[n in ns]: int
input h[n in ns]: int
input ten: int
input four: int
input nine: int

ask aw: any(x[n] > 0 for n in ns where ten / x[n] > 0)
ask awh: any(x[n] > 0 for n in ns where ten / x[n] > 0 and h[n] > 0)
ask awh2: any(x[n] > four for n in ns where h[n] > 0 or ten / x[n] > 0)
ask lwh: all(x[n] > four for n in ns where h[n] > 0 or ten / x[n] > 0)
ask lw: all(x[n] < 0 for n in ns where ten / x[n] > 0)
ask lnone: all(x[n] > 0 for n in ns where ten / x[n] > 0)
ask anone: any(x[n] > nine for n in ns where ten / x[n] > 0)
ask fw2: first(n in ns where n == 1 or ten / x[n] > 0)
ask lt: last(n in ns where ten / x[n] > 0)
ask lt1: last(n in ns where n == 1 and ten / x[n] > 0)
ask sw: sum(x[n] for n in ns where ten / x[n] > 0)
ask s0: sum(0 for n in ns where ten / x[n] > 0)
ask cw: count(n in ns where ten / x[n] > 0)
ask ct: count(x[n] > 0 for n in ns where ten / x[n] > 0)
ask mx: max(x[n] for n in ns where ten / x[n] > 0)
ask a2: any(x[n] > 0 and x[k] > four for n in ns, k in ns where ten / x[n] > 0)
ask a2k: any(x[k] > four for n in ns where ten / x[n] > 0, k in ns where ten / x[k] > 0)
ask l2k: all(x[k] > four for n in ns where ten / x[n] > 0, k in ns where ten / x[k] > 0)
def da: bool = any(x[n] > 0 for n in ns where ten / x[n] > 0)
ask ia: inputs-of da
ask ea: explain da
ask pa: any(x[n] > 0 for n in ns where ten / x[n] > 0) with x[2] = 0
ask pl: all(x[n] < 0 for n in ns where ten / x[n] > 0) with x[1] = 1, x[2] = 0, x[3] = 0

version v
  cite s
  governs always
  known 2026-01-01
  ten = 10 "s"
  four = 4 "s"
  nine = 9 "s"
  x[1] = 2 "ok"
  x[2] = 0 "ref"
  x[3] = 5 "big"
  h[1] = ?"h1?" "hole"
  h[2] = 1 "s"
  h[3] = 1 "s"
