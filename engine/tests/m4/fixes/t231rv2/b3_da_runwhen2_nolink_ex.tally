model da
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-05-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-05
place konto: accounts PLN lives 2026-01-01..
place save: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input bank: observed
input lim: money PLN
input amt: money PLN
input d5: int
input fm: month
input ok[m in month]: bool

move topup[m in month]: transfers
  reads konto, save
  on day_of(m, d5)
  when bal(konto) < lim and ok[m]
  leg cash from save to konto amount min(amt, bal(save))

def fl: money PLN = flows(topup, fm)
ask f: fl
ask ef: explain fl
ask iof: inputs-of fl
ask ob: observed(topup[fm]).cash.amount
ask n: count(o in bank over fm where o.fulfils == topup[fm])

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"
  opening[save] = 5 000.00 PLN at 2026-01-01 start "s"
  lim = 600.00 PLN "s"
  amt = 400.00 PLN "s"
  d5 = 5 "s"
  fm = 2026-02 "s"
  ok[2026-01] = true "j"
  ok[2026-02] = true assumed "feb guess" "f"
  ok[2026-03] = true "m"
  ok[2026-04] = true "a"
  ok[2026-05] = true "y"

