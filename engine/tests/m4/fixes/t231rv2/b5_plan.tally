model b5
  tally 2
  on 2026-05-20
  start 2026-01-01
  end 2026-06-30

source s "invented values"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-06
place pot: accounts PLN lives 2026-01-01..
place landlord: outside lives 1900-01-01..
input bank: observed
input rent_amt: money PLN
input ok[m in month]: bool
input dz[m in month]: int
input ten: int
input d5: int

move rent[m in month where ten / dz[m] > 0]: transfers
  on day_of(m, d5)
  at start_of(m)
  when ok[m]
  leg cash from pot to landlord amount rent_amt

ask o1: observed(rent[2026-01]).cash.amount
ask o2: observed(rent[2026-02]).cash.amount
ask a1: flows(rent, 2026-01)
ask a2: flows(rent, 2026-02)
ask c: bal(pot, 2026-03-31)
ask k1: observed(rent[2026-01]).cash.amount as known 2026-01-25
ask k2: observed(rent[2026-02]).cash.amount as known 2026-01-25
ask n2: count(o in bank over 2026-02 where o.fulfils == rent[2026-02])

version v
  cite s
  governs always
  known 2026-01-01
  rent_amt = 100.00 PLN "s"
  d5 = 5 "s"
  ten = 10 "s"
  ok[2026-01] = true "ok jan"
  ok[2026-02] = ?"feb?" "ok feb"
  ok[2026-03] = true "ok mar"
  ok[2026-04] = true "ok apr"
  ok[2026-05] = true "ok may"
  ok[2026-06] = true "ok jun"
  dz[2026-01] = 0 "z"
  dz[2026-02] = 1 "z"
  dz[2026-03] = 1 "z"
  dz[2026-04] = 1 "z"
  dz[2026-05] = 1 "z"
  dz[2026-06] = 1 "z"
  opening[pot] = 9000.00 PLN at 2026-01-01 start "s"

version jan
  cite s
  governs 2026-01..2026-02
  known 2026-01-21
  covers pot
  bank[a1] = (on: 2026-01-05, kind: transfers, leg cash from pot to landlord amount 100.00 PLN, fulfils: rent[2026-01]) "names jan"
  bank[a2] = (on: 2026-01-20, kind: transfers, leg cash from pot to landlord amount 100.00 PLN, fulfils: rent[2026-02]) "names feb early"
