model f03
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "probe"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
index ns = 1..3
input x[n in ns]: int
input dh[n in ns]: date
input ten: int

ask aw: any(x[n] > 0 for n in ns where ten / x[n] > 0, p in accounts on dh[n])
ask aq: any(ten / x[n] > 0 for n in ns, p in accounts on dh[n])
ask lw: all(x[n] < 0 for n in ns where ten / x[n] > 0, p in accounts on dh[n])
ask lq: all(ten / x[n] < 0 for n in ns, p in accounts on dh[n])
ask ah: any(x[n] > 0 for n in ns, p in accounts on dh[n])
ask ar: any(x[n] > 0 for n in ns where ten / x[n] > 0 and n != 3, p in accounts on dh[n])
ask arr: any(x[n] > 0 for n in ns where n != 3, p in accounts on dh[n])

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  ten = 10 "s"
  x[1] = 2 "ok"
  x[2] = 0 "ref"
  x[3] = 5 "big"
  dh[1] = 2026-02-01 "s"
  dh[2] = 2026-02-01 "s"
  dh[3] = ?"dh3?" "hole"
