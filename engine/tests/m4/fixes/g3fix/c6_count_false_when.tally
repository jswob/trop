model c5
  tally 2
  on 2026-06-20
  start 2026-03-01
  end 2026-06-30

source s "invented"

unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place kb: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input w: date
input lim: money PLN
input lim2: money PLN
input sp: month

move dt: transfers
  on w
  reads konto
  when bal(konto) > lim
  leg cash from world to konto amount amt
move df: transfers
  on w
  reads konto
  when bal(konto) > lim2
  leg cash from world to kb amount amt

def cn: int = count(m in transfers over sp .. sp)
def ff: money PLN = flows(df, sp .. sp)

ask e_cn: explain cn
ask i_cn: inputs-of cn
ask e_ff: explain ff
ask i_ff: inputs-of ff

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  w = 2026-04-30 "s"
  lim = 450.00 PLN "s"
  lim2 = 900.00 PLN "s"
  sp = 2026-04 "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
  opening[kb] = 0.00 PLN at 2026-03-01 start "s"
