model k_pin
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-05-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-05
place konto: accounts PLN lives 2026-01-01..
place pot: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input d5: int
input d20: int
input amt: money PLN
place landlord: outside lives 1900-01-01..
input bank: observed
input ok[m in month]: bool

move rent[m in month]: transfers
  on day_of(m, d5)
  when ok[m]
  leg cash from pot to landlord amount amt

move top[m in month]: transfers
  on day_of(m, d20)
  leg cash from konto to shop amount flows(rent, m)

ask q: flows(top, 2026-02 .. 2026-02)

version v
  cite s
  governs always
  known 2026-01-01
  d5 = 5 "s"
  d20 = 20 "s"
  amt = 10.00 PLN "s"
  ok[2026-01] = true assumed "jan is a guess"
  ok[2026-02] = true "s"
  ok[2026-03] = true "s"
  ok[2026-04] = true "s"
  ok[2026-05] = true "s"

version jan
  cite s
  governs 2026-01
  known 2026-01-21
  covers pot
  bank[a1] = (on: 2026-01-05, kind: transfers, leg cash from pot to landlord amount 10.00 PLN, fulfils: rent[2026-01]) "names jan"
