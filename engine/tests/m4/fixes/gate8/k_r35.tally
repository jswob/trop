model k_r35
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-05-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-05
place konto: accounts PLN lives 2026-01-01..
place pot: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input d5: int
input d20: int
input amt: money PLN
input one: int
input last_n: int
input fee_day: date

move fee[n in one .. last_n]: transfers
  on fee_day
  leg cash from pot to shop amount amt

move top[m in month]: transfers
  on day_of(m, d20)
  leg cash from konto to shop amount flows(fee, m)

ask q: flows(top, 2026-02 .. 2026-02)

version v
  cite s
  governs always
  known 2026-01-01
  d5 = 5 "s"
  d20 = 20 "s"
  amt = 10.00 PLN "s"
  one = 1 "s"
  fee_day = 2026-03-10 "s"

version ch
  cite s
  governs always
  known 2026-02-15
  replace amt = 12.00 PLN "fee's amount changed before top's booking cut"
