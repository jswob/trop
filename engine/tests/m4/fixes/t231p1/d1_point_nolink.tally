model d1
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-03-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-02..2026-02
place konto: accounts PLN lives 2026-01-01..
place save: accounts PLN lives 2026-01-01..
place jar: accounts PLN lives 2026-01-01..
input bank: observed
input lim: money PLN
input amt: money PLN
input keep: money PLN
input d5: int
input de: date

move skim[m in month]: transfers
  reads konto
  before topup
  on day_of(m, d5)
  when bal(konto) > keep
  leg cash from konto to jar amount bal(konto) - keep

move topup[m in month]: transfers
  reads konto
  on day_of(m, d5)
  when bal(konto) < lim
  leg cash from save to konto amount amt

ask sk: flows(skim, 2026-02)
ask f: flows(topup, 2026-02)
ask b: bal(konto, de)
ask j: bal(jar, de)
ask bs: bal(save, de)
ask rs: residuals konto 2026-02

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 300.00 PLN at 2026-01-01 start "s"
  opening[save] = 5 000.00 PLN at 2026-01-01 start "s"
  opening[jar] = 0.00 PLN at 2026-01-01 start "s"
  lim = 500.00 PLN "s"
  amt = 400.00 PLN "s"
  keep = 100.00 PLN "s"
  d5 = 5 "s"
  de = 2026-03-31 "s"

version feb
  cite s
  governs 2026-02
  known 2026-03-01
  covers save
  bank[r1] = (on: 2026-02-05, kind: transfers, leg cash from save to konto amount 400.00 PLN) "same day"
