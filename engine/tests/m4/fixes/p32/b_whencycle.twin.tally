model x1h
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-05-31

source s "probe: o.fulfils naming the reading move's own instance, read at the ask's cut"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-05

place konto: accounts PLN lives 2026-01-01..

place card: accounts PLN lives 2026-01-01..

place shop: outside lives 1900-01-01..

input bank: observed

input base: money PLN

input guess: money PLN

input spend_dom: int

move spend[m in month]: transfers
  on day_of(m, spend_dom)
  at start_of(m)
  when loose[m] < base
  leg cash from konto to shop amount max(0, base - loose[m])

def loose[m in month]: money PLN at start_of(m)
  rule guessed = guess
  rule seen beats guessed = sum(o.cash.amount for o in bank over m where o.cash.from == card) when covered(card, m)

ask l24: loose[m] for m in [2026-02, 2026-04]

ask l4: loose[2026-04]

ask f: flows(spend, 2026-04 .. 2026-04)

version v
  cite s
  governs always
  known 2026-01-01
  base = 300.00 PLN "s"
  guess = 100.00 PLN "s"
  spend_dom = 25 "s"
  opening[konto] = 5000.00 PLN at 2026-01-01 start "s"
  opening[card] = 1000.00 PLN at 2026-01-01 start "s"

version feb
  cite s
  governs 2026-02
  known 2026-02-21
  covers card
  bank[r0204] = (on: 2026-02-04, kind: transfers, leg cash from konto to shop amount 250.00 PLN, fulfils: spend[2026-01]) "names an earlier instance"

version apr
  cite s
  governs 2026-04
  known 2026-04-15
  covers card
  bank[r0405] = (on: 2026-04-05, kind: transfers, leg cash from konto to shop amount 260.00 PLN, fulfils: spend[2026-02]) "names an earlier instance, read at K"
  bank[r0406] = (on: 2026-04-06, kind: transfers, leg cash from card to shop amount 30.00 PLN) "loose"
