model u1
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-06-30

source s "invented for G6a's lists: with uncertain read across a projection's window"

unit PLN: currency minor 0.01

kind promises: transfers uncertain

place konto: accounts PLN lives 2026-01-01..

place hw: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input bank: observed

input pay: money PLN

input amt: money PLN

input amt2: money PLN

input amt4: money PLN

input amt8: money PLN

input amt16: money PLN

input amt32: money PLN

input amt64: money PLN

input d_past: date

input d_pre: date

input d_lo: date

input d_mid: date

input d_hi: date

input d_post: date

input d_kept: date

input d_win: date

input pay_dom: int

index month = month 2026-01..2026-06

move salary[m in month]: transfers
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from world to konto amount pay

move u_past: promises
  on d_past
  leg cash from world to konto amount amt

move u_pre: promises
  on d_pre
  leg cash from world to konto amount amt2

move u_lo: promises
  on d_lo
  leg cash from world to konto amount amt4

move u_mid: promises
  on d_mid
  leg cash from konto to world amount amt8

move u_hi: promises
  on d_hi
  leg cash from world to konto amount amt16

move u_post: promises
  on d_post
  leg cash from world to konto amount amt32

move u_kept: promises
  on d_kept
  leg cash from world to konto amount amt64

move u_win: promises
  on d_win
  leg cash from world to hw amount amt

ask c_plain: bal(konto, 2026-04-30) from 2026-04-01

ask c_unc: bal(konto, 2026-04-30) from 2026-04-01 with uncertain

ask c_inner: bal(konto, 2026-04-29) from 2026-04-02 with uncertain

ask c_lo: bal(konto, 2026-04-01) from 2026-04-01 with uncertain

ask c_hi: bal(konto, 2026-04-30) from 2026-04-30 with uncertain

ask c_after: bal(konto, 2026-06-30) from 2026-05-02 with uncertain

ask c_past: bal(konto, 2026-02-28) from 2026-02-01 with uncertain

ask c_min: min(bal(konto, d) from 2026-04-01 with uncertain for d in 2026-04-01 .. 2026-05-02 step 1 day)

ask c_days: bal(konto, d) from 2026-03-31 with uncertain for d in [2026-03-31, 2026-04-01, 2026-04-15, 2026-04-30, 2026-05-01]

ask c_bal: bal(konto, 2026-05-31) with uncertain

ask c_both: bal(konto, 2026-04-30) from 2026-04-01 with uncertain - bal(konto, 2026-04-30) from 2026-04-01

ask w_unc: bal(hw, 2026-04-30) from 2026-04-01 with uncertain

ask w_plain: bal(hw, 2026-04-30) from 2026-04-01

version v
  cite s
  governs always
  known 2026-01-01
  pay = 1000.00 PLN "s"
  pay_dom = 10 "s"
  amt = 1.00 PLN "s"
  amt2 = 2.00 PLN "s"
  amt4 = 4.00 PLN "s"
  amt8 = 8.00 PLN "s"
  amt16 = 16.00 PLN "s"
  amt32 = 32.00 PLN "s"
  amt64 = 64.00 PLN "s"
  d_past = 2026-02-15 "before the cut, unfulfilled"
  d_pre = 2026-03-31 "the day before the window"
  d_lo = 2026-04-01 "the window's first day"
  d_mid = 2026-04-15 "inside the window"
  d_hi = 2026-04-30 "the window's last day"
  d_post = 2026-05-01 "the day after the window"
  d_kept = 2026-02-20 "before the cut, fulfilled"
  d_win = window(2026-04-10, 2026-04-20) "a hole day inside the window"
  opening[konto] = 500.00 PLN at 2026-01-01 start "s"
  opening[hw] = 100.00 PLN at 2026-01-01 start "s"

version obs
  cite s
  governs 2026-02
  known 2026-02-25
  bank[r0220] = (on: 2026-02-20, kind: transfers, leg cash from world to konto amount 64.00 PLN, fulfils: u_kept) "fulfils an uncertain movement"
