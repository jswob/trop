model x1b
  tally 2
  on 2026-05-20
  start 2026-01-01
  end 2026-06-30

source s "probe: o.fulfils naming instances whose when is false, a hole, or whose keys a later version adds"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-06

place konto: accounts PLN lives 2026-01-01..

place card: accounts PLN lives 2026-01-01..

place landlord: outside lives 1900-01-01..

place shop: outside lives 1900-01-01..

input bank: observed

input rent_amt[m in month]: money PLN

input rent_day[m in month]: date

input base: money PLN

input guess: money PLN

input dom: int

input ok[m in month]: bool

move rent[m in month]: transfers
  on rent_day[m]
  at start_of(m)
  when ok[m]
  leg cash from konto to landlord amount rent_amt[m]

def loose[m in month]: money PLN at start_of(m)
  rule guessed = guess
  rule seen beats guessed = sum(o.cash.amount for o in bank over m where o.fulfils == none) when covered(card, m)

def named[m in month]: money PLN at start_of(m)
  rule none_seen = guess
  rule seen beats none_seen = sum(o.fulfils.cash.amount for o in bank over m where o.fulfils != none) when covered(card, m)

move spend[m in month]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from konto to shop amount max(0, base - loose[m])

ask k: bal(konto, 2026-05-19)

ask f: flows(spend, m) for m in [2026-01, 2026-02, 2026-03, 2026-04]

ask l: loose[m] for m in [2026-01, 2026-02, 2026-03, 2026-04]

ask n: named[m] for m in [2026-01, 2026-02, 2026-03, 2026-04]

version v
  cite s
  governs always
  known 2026-01-01
  base = 300.00 PLN "s"
  guess = 100.00 PLN "s"
  dom = 25 "s"
  rent_amt[2026-01] = 900.00 PLN "s"
  rent_amt[2026-02] = 900.00 PLN "s"
  rent_amt[2026-03] = 900.00 PLN "s"
  rent_day[2026-04] = 2026-04-06 "s"
  ok[2026-01] = true "s"
  ok[2026-02] = false "when false"
  ok[2026-04] = true "s"
  rent_amt[2026-04] = 900.00 PLN "s"
  rent_day[2026-01] = 2026-01-05 "s"
  rent_day[2026-02] = 2026-02-05 "s"
  rent_day[2026-03] = 2026-03-05 "s"
  opening[konto] = 9000.00 PLN at 2026-01-01 start "s"
  opening[card] = 1000.00 PLN at 2026-01-01 start "s"

version jan
  cite s
  governs 2026-01
  known 2026-01-21
  covers card
  bank[r0102] = (on: 2026-01-02, kind: transfers, leg cash from card to shop amount 40.00 PLN) "loose"
  bank[r0105] = (on: 2026-01-05, kind: transfers, leg cash from konto to landlord amount 900.00 PLN, fulfils: rent[2026-01]) "whole"

version feb
  cite s
  governs 2026-02
  known 2026-02-21
  covers card
  bank[r0203] = (on: 2026-02-03, kind: transfers, leg cash from card to shop amount 50.00 PLN) "loose"
  bank[r0205] = (on: 2026-02-05, kind: transfers, leg cash from konto to landlord amount 900.00 PLN, fulfils: rent[2026-02]) "names the refused"

version mar
  cite s
  governs 2026-03
  known 2026-03-21
  covers card
  bank[r0304] = (on: 2026-03-04, kind: transfers, leg cash from card to shop amount 60.00 PLN) "loose"
  bank[r0305] = (on: 2026-03-05, kind: transfers, leg cash from konto to landlord amount 900.00 PLN, fulfils: rent[2026-03]) "names the hole amount"

version apr
  cite s
  governs 2026-04
  known 2026-04-21
  covers card
  bank[r0406] = (on: 2026-04-06, kind: transfers, leg cash from konto to landlord amount 900.00 PLN, fulfils: rent[2026-04]) "names the hole day"
  bank[r0410] = (on: 2026-04-10, kind: transfers, leg cash from card to shop amount 70.00 PLN) "loose"
