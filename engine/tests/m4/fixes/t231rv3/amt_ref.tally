model ar
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-03-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-03
place pot: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input bank: observed
input amt: money PLN
input d5: int
input ten: int
input dz[m in month]: int

move pay[m in month]: transfers
  on day_of(m, d5)
  leg cash from pot to shop amount if ten / dz[m] > 0 then amt else amt

ask ob: observed(pay[2026-02]).cash.amount
ask eq: pay[2026-02] == none
ask dy: pay[2026-02].day
ask ful: count(o in bank over 2026-02 where o.fulfils == pay[2026-02])
ask loose: count(o in bank over 2026-02 where o.fulfils == none)
ask fp: flows(pay, 2026-02)

version v
  cite s
  governs always
  known 2026-01-01
  opening[pot] = 1 000.00 PLN at 2026-01-01 start "s"
  amt = 10.00 PLN "s"
  d5 = 5 "s"
  ten = 10 "s"
  dz[2026-01] = 1 "s"
  dz[2026-02] = 0 "s"
  dz[2026-03] = 1 "s"

version feb
  cite s
  governs 2026-02
  known 2026-03-01
  bank[r1] = (on: 2026-02-05, kind: transfers, leg cash from pot to shop amount 10.00 PLN, fulfils: pay[2026-02]) "p"
