model r4
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2027-12-31

source s "invented"
unit PLN: currency minor 0.01

axis rmode
  half-up "A"
  down "B"

input ry: rate
input p0: money PLN
input ph: money PLN
input d0: date
input d1: date
input e: money PLN
input want: num PLN
input tr: num %

def acc: num PLN = accrue(p0, ry, d0, d1, act365, simple)
def acch: num PLN = accrue(ph, ry, d0, d1, act365, simple)
def rr: money PLN = round(acc, minor(PLN), rmode)
def held: money PLN = e
def lin: num PLN = held * tr

ask h1: acc with ry = 10 %/year
ask h2: acch with ry = 10 %/year
ask h3: rr with ry = 1 %/year
ask h4: explain rr with ry = 1 %/year
ask h5: solve lin == want for e in [0 PLN, 1000 PLN] to 0.01 PLN
ask h6: solve rr == want for p0 in [0 PLN, 10000 PLN] to 0.01 PLN with ry = 3 %/year

version v
  cite s
  governs always
  known 2026-01-01
  ry = ? "which rate?"
  p0 = 1000.10 PLN "s"
  ph = ? "which principal?"
  d0 = 2026-03-01 "s"
  d1 = 2026-04-01 "s"
  e = 1 PLN "s"
  want = 10.0001 "s"
  tr = 3 "s"
