model a12
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31

source s "invented"

unit PLN: currency minor 0.01

input p0: money PLN
input pn: money PLN
input ph: money PLN
input rh: rate
input r: rate
input d0: date
input d1: date

ask q_arith: pn + ph
ask q_arith2: max(pn, ph)
ask q_acc: accrue(pn, rh, d0, d1, act365, simple)
ask q_per: periodic(rh, year, simple) * accrue(pn, r, d0, d1, act365, simple)

version v
  cite s
  governs always
  known 2026-01-01
  p0 = 1000 PLN "s"
  pn = none "s"
  ph = ?"which p?" "s"
  rh = ?"which rate?" "s"
  r = 10 %/year "s"
  d0 = 2026-01-01 "s"
  d1 = 2027-01-01 "s"
