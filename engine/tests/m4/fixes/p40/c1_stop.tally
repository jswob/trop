model c1_stop
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-05-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-05
place konto: accounts PLN lives 2026-01-01..
place pot: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input d5: int
input d20: int
input amt: money PLN
place card: accounts PLN lives 2026-01-01..
index kinds = [a]
input bank: observed
input ten: int
input dz[m in month]: int
input base: money PLN
input d25: int

move spend[m in month where ten / dz[m] > 0, k in kinds]: transfers
  on day_of(m, d25)
  leg cash from konto to shop amount max(0, base - loose[m])

input guess: money PLN

def loose[m in month]: money PLN at start_of(m)
  rule guessed = guess
  rule seen beats guessed = sum(o.cash.amount for o in bank over m where o.fulfils == none) when covered(card, m)

ask f: flows(spend, 2026-02 .. 2026-02)

ask x: sum(o.cash.amount for o in bank over 2026-04 where o.fulfils == none)

ask d: loose[2026-04]

ask e: explain loose[2026-04]

ask f2: flows(spend, 2026-02 .. 2026-02) as known 2026-03-15

ask d2: loose[2026-04] as known 2026-04-15

ask fd: flows(spend, 2026-02 .. 2026-02) + loose[2026-04]

ask df: loose[2026-04] + flows(spend, 2026-02 .. 2026-02)

ask xf: sum(o.cash.amount for o in bank over 2026-04 where o.fulfils == none) + flows(spend, 2026-02 .. 2026-02)

version v
  cite s
  governs always
  known 2026-01-01
  d5 = 5 "s"
  d20 = 20 "s"
  amt = 10.00 PLN "s"
  ten = 10 "s"
  guess = 100.00 PLN "s"
  base = 300.00 PLN "s"
  d25 = 25 "s"
  dz[2026-01] = 1 "s"
  dz[2026-02] = 1 "s"
  dz[2026-03] = 1 "s"
  dz[2026-04] = 1 "s"
  dz[2026-05] = 0 "refused: a division by zero"

version apr
  cite s
  governs 2026-04
  known 2026-04-10
  covers card
  bank[r0404] = (on: 2026-04-04, kind: transfers, leg cash from konto to shop amount 250.00 PLN, fulfils: spend[2026-01, a]) "names jan"
  bank[r0406] = (on: 2026-04-06, kind: transfers, leg cash from card to shop amount 30.00 PLN) "loose"
