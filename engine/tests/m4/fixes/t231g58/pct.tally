model pct
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "probe"
unit PLN: currency minor 0.01
input p: num %
input n: num
input two: int
input c: bool
input ck: bool

def dn: num = p
def dp: num % = n

ask q_pp: p + p
ask q_p2: p * two
ask q_pd: p / two
ask q_neg: -p
ask q_abs: abs(p)
ask q_min: min(p, n)
ask q_ifh: if c then p else n
ask q_sub: n - p
ask q_chk: check p == n + p
ask q_chk2: check dn == dp
ask q_chk3: check dp == n + n
ask a1: p - p
ask a2: p + p - p
ask a3: if ck then p else p - p
ask a4: max(p, p - p)
ask a5: p - p + p
ask a6: p * 0
ask a7: p + n - n
ask d1: dn
ask d2: dp

version v
  cite s
  governs always
  known 2026-01-01
  p = 10 % "s"
  n = 0.1 "s"
  two = 2 "s"
  c = ?"which branch?" "s"
  ck = true "s"
