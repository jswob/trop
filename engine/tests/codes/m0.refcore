unit PLN: currency minor 0.01

index qs = [q1, q2]

axis a1
  lo "low"
  hi "high"

axis a2
  lo "low"
  hi "high"

axis a3
  lo "low"
  hi "high"

axis a4
  lo "low"
  hi "high"

axis a5
  lo "low"
  hi "high"

axis a6
  lo "low"
  hi "high"

axis a7
  lo "low"
  hi "high"

def n: int
  rule base = 0
  rule r1 beats base = 1 when a1 == lo and a2 == lo and a3 == lo and a4 == lo and a5 == lo and a6 == lo and a7 == lo

