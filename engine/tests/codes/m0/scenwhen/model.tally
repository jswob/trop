model hh
  tally 2
  on 2026-01-02
  start 2025-12-30
  end 2026-01-05
  note "T's base for M0's load-code fixtures (invented): two scenarios over it, each a move over the built-in days kept from the scenarios' from by a when (tally 2.1.6, #75, P29), a.tally and b.tally; it loads clean"

source s "T's fixture card (invented)"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2025-01-01..

place world: outside lives 1900-01-01..

input from_day: date

input top_amt: money PLN

input lift_amt: money PLN

ask q: bal(konto, 2026-01-05), top_amt, lift_amt

version v
  cite s
  governs always
  known 2025-12-01
  from_day = 2026-01-01
  top_amt = 1.00 PLN
  lift_amt = 2.00 PLN
  opening[konto] = 10.00 PLN at 2025-12-30 start
