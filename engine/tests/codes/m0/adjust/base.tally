model adjust
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31
  note "T's base for M0's load-code fixtures (invented): a wage raised after it was paid, and the back pay that settles the adjustment; it loads clean"

source card "T's fixture card (invented)"

unit PLN: currency minor 0.01

unit EUR: currency minor 0.01

kind wages: event certain
  leg cash: PLN

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input bank: observed

input wage_amt: money PLN

input wage_dom: int

def net[m in months]: money PLN = wage_amt at start_of(m)

move wage[m in months]: wages
  on day_of(m, wage_dom)
  at start_of(m)
  leg cash from world to konto amount net[m]

ask q: bal(konto, 2026-12-31)

version plan
  cite card
  governs always
  known 2025-12-01
  wage_amt = 5 000.00 "a wage"
  wage_dom = 10 "paid on the 10th"
  opening[konto] = 0 at 2026-01-01 start "the card"

version raise
  cite card
  governs 2026-03..2026-04
  known 2026-05-01
  replace wage_amt = 5 500.00 "a raise for March and April"

version bank_a
  cite card
  governs 2026-05
  known 2026-06-01
  bank[r1] = (on: 2026-05-15, kind: wages, leg cash from world to konto amount 500.00 PLN, fulfils: adjustments[wage[2026-03].cash, raise]) "back pay for March"
