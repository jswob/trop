model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.8 R11 (#195): a movement whose day is refused may fall after any reading, so its refusal stops at none (L §5.19 l.1735). rd[2026-02]'s day is refused (RUN-DIV); konto's statement at 2026-03-10 end doesn't heal it. Items #160 (a member whose day is refused refuses the count: c_day), rest 12 (modelled: md); no-item 6 (after)"

source plan "plan"
source bk "bank"
unit PLN: currency minor 0.01
input g_amt: money PLN
input dom: int
input divisor[m in months]: num
input d7: int
place konto: accounts PLN lives 2019-05-01..
place k9: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..

move rd[m in months]: transfers
  on day_of(m, dom * divisor[m] / divisor[m])
  at start_of(m)
  leg cash from konto to world amount g_amt

move k9m[m in months]: transfers
  on day_of(m, d7)
  at start_of(m)
  leg cash from k9 to world amount g_amt

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  g_amt = 50.00 PLN "plan"
  dom = 5 "plan"
  d7 = 7 "plan"
  divisor[2026-01] = 1 "ok"
  divisor[2026-02] = 0 "zero"
  divisor[2026-03..2026-12] = 1 "ok"
  opening[konto] = 10 000.00 PLN at 2026-01-01 start "w"
  opening[k9] = 1 000.00 PLN at 2026-01-01 start "w"

version st
  cite bk
  governs 2026-03
  known 2026-04-02
  anchor konto
  stated[konto] = 200.00 PLN at 2026-03-10 end "saldo"

ask after: bal(konto, 2026-01-31), bal(konto, 2026-03-10), bal(konto, 2026-03-31)
ask md: bal(konto, 2026-03-31) modelled, bal(k9, 2026-03-31) modelled
ask c_day: count(t in transfers over 2026-02), count(t in transfers over 2026-03-11 .. 2026-03-31)
