model window_moves
  tally 2
  on 2026-08-01
  start 2026-01-01
  end 2026-12-31
  note "T, M2 gate 8 (run 43657284122): movements dated by windows at each edge of a span S = 2026-04-01 .. 2026-05-31, read by flows of each move (walk/move_flows.rs window_in), a binding over each move's kind (book/members.rs window_member), the residual ledger over S's months (book/ledger.rs model_day) and flows of the place (walk/flows.rs place_log, crosses, zero_amount): inside one month (in1), inside across months (in2), wholly after (aft), from S's last day past it (lastx), wholly before (bef), ending on S's first day (hist), across S's start (strad), and a zero amount across a short span (zer)"

source s "s"

unit PLN: currency minor 0.01

kind k_in1: transfers
kind k_in2: transfers
kind k_aft: transfers
kind k_lastx: transfers
kind k_bef: transfers
kind k_hist: transfers
kind k_strad: transfers

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input w_in1: date
input w_in2: date
input w_aft: date
input w_lastx: date
input w_bef: date
input w_hist: date
input w_strad: date
input w_zer: date
input zero: money PLN
input a1: money PLN

move in1: k_in1
  on w_in1
  leg cash from world to konto amount a1

move in2: k_in2
  on w_in2
  leg cash from world to konto amount a1

move aft: k_aft
  on w_aft
  leg cash from world to konto amount a1

move lastx: k_lastx
  on w_lastx
  leg cash from world to konto amount a1

move bef: k_bef
  on w_bef
  leg cash from world to konto amount a1

move hist: k_hist
  on w_hist
  leg cash from world to konto amount a1

move strad: k_strad
  on w_strad
  leg cash from world to konto amount a1

move zer: transfers
  on w_zer
  leg cash from world to konto amount zero

ask f_in1: flows(in1, 2026-04-01 .. 2026-05-31)
ask f_in2: flows(in2, 2026-04-01 .. 2026-05-31)
ask f_aft: flows(aft, 2026-04-01 .. 2026-05-31)
ask f_lastx: flows(lastx, 2026-04-01 .. 2026-05-31)
ask f_bef: flows(bef, 2026-04-01 .. 2026-05-31)
ask f_hist: flows(hist, 2026-04-01 .. 2026-05-31)
ask f_strad: flows(strad, 2026-04-01 .. 2026-05-31)
ask n_in1: count(t in k_in1 over 2026-04-01 .. 2026-05-31)
ask n_in2: count(t in k_in2 over 2026-04-01 .. 2026-05-31)
ask n_aft: count(t in k_aft over 2026-04-01 .. 2026-05-31)
ask n_bef: count(t in k_bef over 2026-04-01 .. 2026-05-31)
ask n_hist: count(t in k_hist over 2026-04-01 .. 2026-05-31)
ask n_strad: count(t in k_strad over 2026-04-01 .. 2026-05-31)
ask r: residuals konto 2026-04 .. 2026-05
ask fk_in: flows(konto, 2026-04-09 .. 2026-04-21)
ask fk_z: flows(konto, 2026-04-21 .. 2026-04-23)
ask fk: flows(konto, 2026-04-01 .. 2026-05-31)

version v
  cite s
  governs always
  known 2026-01-01
  w_in1 = window(2026-04-10, 2026-04-20) "s"
  w_in2 = window(2026-04-25, 2026-05-05) "s"
  w_aft = window(2026-06-10, 2026-07-05) "s"
  w_lastx = window(2026-05-31, 2026-06-02) "s"
  w_bef = window(2026-02-10, 2026-03-05) "s"
  w_hist = window(2026-03-25, 2026-04-01) "s"
  w_strad = window(2026-03-25, 2026-04-05) "s"
  w_zer = window(2026-04-15, 2026-04-25) "s"
  zero = 0.00 PLN "s"
  a1 = 1.00 PLN "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
