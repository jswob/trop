model b1f
  tally 2
  on 2026-04-15
  start 2026-01-01
  end 2026-12-31
  note "T, M2 gate 8 run 43749994847 on 205157a2: five projections from different days read in turn across a month's end (past the four kept walks the one kept first is freed), then the first read again (walk/fork.rs free_projection: a freed walk's key goes with it)"

source card "invented for F6's twin"

unit DUK: currency minor 0.01

axis pay_reading
  low "the lower pay"
  high "the higher pay"

index month = month 2026-01..2026-12

place konto: accounts DUK lives 2026-01-01..

place world: outside lives 2026-01-01..

input pay_low: money DUK

input pay_high: money DUK

input rent: money DUK

input floor: money DUK

input share: num

input late: int

input rent_off: int

input sweep_off: int

input reach: int

def pay: money DUK at reader
  rule base = pay_low
  rule hi beats base = pay_high when pay_reading == high

def room[m in month]: money DUK = min(bal(konto, d) from start_of(m) for d in start_of(m) .. add_days(start_of(m), reach) step 1 day) at start_of(m)

move salary[m in month]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from world to konto amount pay

move rent_pay[m in month]: transfers
  on add_days(start_of(m), rent_off)
  at start_of(m)
  leg cash from konto to world amount rent

move sweep[m in month]: transfers
  on add_days(start_of(m), sweep_off)
  at start_of(m)
  reads konto
  leg cash from konto to world amount round(max(0, room[m] - floor) * share, minor(DUK), down) on add_days(start_of(m), late)

ask f_then: min(bal(konto, d) from 2026-02-01 + bal(konto, d) from 2026-02-02 + bal(konto, d) from 2026-02-03 + bal(konto, d) from 2026-02-04 + bal(konto, d) from 2026-02-05 for d in 2026-02-20 .. 2026-03-10 step 1 day) + bal(konto, 2026-03-20) from 2026-02-01

version v
  cite card
  governs always
  known 2026-01-01
  pay_low = 1000.00
  pay_high = 1300.00
  rent = 900.00
  floor = 200.00
  share = 0.5
  late = 25
  rent_off = 9
  sweep_off = 17
  reach = 15
  opening[konto] = 500.00 at 2026-01-01 start

version later
  cite card
  governs 2026-05-01..
  known 2026-03-01
  replace rent = 950.00 "the rent rose"
