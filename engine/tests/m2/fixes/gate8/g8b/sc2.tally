model sc2
  tally 2
  on 2026-04-10
  start 2026-03-01
  end 2026-04-30
  note "T, M2 gate 8 run 43749994847 on 205157a2: a movement same line in a version known in a window, read as known on its last day, the day after and at the cut (book/same.rs move_lines: the window holds a cut before its last day only)"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place unexplained: outside lives 1900-01-01..
input bank: observed
input keep: money PLN
input d_save: int

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

ask w8_sav: bal(sav, 2026-03-31) as known 2026-04-08
ask w8_konto: bal(konto, 2026-03-31) as known 2026-04-08
ask w9_sav: bal(sav, 2026-03-31) as known 2026-04-09
ask w9_n: count(t in transfers over 2026-03) as known 2026-04-09
ask on_sav: bal(sav, 2026-03-31)

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"

version st_konto
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[a2] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "a"

version st_sav
  cite s
  governs 2026-03
  known window(2026-04-03, 2026-04-08)
  covers sav
  bank[b1] = (on: 2026-03-16, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "b"
  same bank[a2] = bank[b1]
