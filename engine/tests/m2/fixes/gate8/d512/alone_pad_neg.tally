model t
  tally 2
  on 2026-04-10
  start 2026-03-01
  end 2026-04-30
  note "T, M2 gate 8 run 43690242450 on d512fe7b: a reading after a decision whose pad takes a min 0 place below 0 (walk/readings.rs tested_alone)"

source s "s"
unit PLN: currency minor 0.01
kind savings: place PLN min 0
place konto: accounts PLN lives 2026-01-01..
place sav: savings lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input keep: money PLN
input d_save: int

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"
ask b15: bal(konto, 2026-03-15)
ask b31: bal(konto, 2026-03-31)
ask s15: bal(sav, 2026-03-15)
ask s31: bal(sav, 2026-03-31)
ask pd: sum(p.cash.amount for p in pads over 2026-03)

version rd
  cite s
  governs 2026-03..2026-04
  known 2026-04-04
  pad konto from sav
  stated[konto] = 1100.00 PLN after save[2026-03] "saldo"
