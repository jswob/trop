model t
  tally 2
  on 2026-04-10
  start 2026-03-01
  end 2026-04-30
  note "T, M2 gate 8 run 43690242450 on d512fe7b: two plan instances stated same, no observation (book/same.rs same_observed_ids)"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input d15: int
input d10: int
input amt: money PLN
kind wages: transfers
kind shop: transfers
kind twos: event certain
  leg cash: PLN
  leg fee: PLN

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 1000.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"
  d15 = 15 "s"
  d10 = 10 "s"
  amt = 500.00 PLN "s"

move pay[m in months]: wages
  on day_of(m, d10)
  leg cash from world to konto amount amt

move pay2[m in months]: wages
  on day_of(m, d10)
  leg cash from world to konto amount amt

ask b_k: bal(konto, 2026-03-31)
ask f_k: flows(konto, 2026-03-01 .. 2026-03-31)
ask l_k: residuals konto 2026-03
ask n_i: count(t in wages over 2026-03)

version sm
  cite s
  known 2026-01-02
  same pay[2026-03] = pay2[2026-03]
