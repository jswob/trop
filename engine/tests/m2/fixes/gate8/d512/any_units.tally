model t
  tally 2
  on 2026-04-10
  start 2026-03-01
  end 2026-04-30
  note "T, M2 gate 8 run 43690242450 on d512fe7b: the ledger of a place of unit any, a plan in EUR and a row in PLN (book/ledger.rs ledger_units)"

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind mixed: place any signed
place wallet: mixed lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input d10: int
input eur: money EUR

move gift[m in months]: transfers
  on day_of(m, d10)
  leg cash from world to wallet amount eur

ask l: residuals wallet 2026-03

version v
  cite s
  governs always
  known 2026-01-01
  d10 = 10 "s"
  eur = 5.00 EUR "s"

version st
  cite s
  governs 2026-03
  known 2026-04-02
  covers wallet
  bank[r1] = (on: 2026-03-12, kind: transfers, leg cash from world to wallet amount 7.00 PLN) "r1"
