model t
  tally 2
  on 2026-05-10
  start 2026-03-01
  end 2026-04-30
  note "T, M2 gate 8 run 43690242450 on d512fe7b: a reading after m whose fulfilling row is on the run's last day (book/reading.rs last_standing_day, walk/agenda.rs last_standing_in)"

source s "s"
unit PLN: currency minor 0.01
kind savings: place PLN min 0
place konto: accounts PLN lives 2026-01-01..
place sav: savings lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input keep: money PLN
input d_save: int

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"
ask b29: bal(konto, 2026-04-29)
ask b30: bal(konto, 2026-04-30)
ask s30: bal(sav, 2026-04-30)
ask fk: flows(konto, 2026-04-01 .. 2026-04-30)

version st
  cite s
  governs 2026-04
  known 2026-05-02
  covers konto
  bank[o1] = (on: 2026-04-30, kind: transfers, leg cash from konto to sav amount 500.00 PLN, fulfils: save[2026-04]) "o1"

version rd
  cite s
  governs 2026-04..2026-05
  known 2026-05-04
  pad konto from world
  stated[konto] = 90.00 PLN after save[2026-04] "saldo"
