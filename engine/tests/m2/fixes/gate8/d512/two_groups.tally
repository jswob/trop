model t
  tally 2
  on 2026-04-10
  start 2026-03-01
  end 2026-04-30
  note "T, M2 gate 8 run 43690242450 on d512fe7b: two same groups apart, one disagreeing, written right-left (book/same.rs root, written_before, same_differ)"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input d15: int
input d10: int
input amt: money PLN
kind wages: transfers
kind shop: transfers
kind twos: event certain
  leg cash: PLN
  leg fee: PLN

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 1000.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"
  d15 = 15 "s"
  d10 = 10 "s"
  amt = 500.00 PLN "s"

ask l_k: residuals konto 2026-03
ask l_s: residuals sav 2026-03
ask f_k: flows(konto, 2026-03-01 .. 2026-03-31)
ask b_k: bal(konto, 2026-03-31)
ask b_s: bal(sav, 2026-03-31)
ask t_sum: sum(t.cash.amount for t in transfers over 2026-03)
ask t_n: count(t in transfers over 2026-03)

version st_konto
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[a1] = (on: 2026-03-10, kind: transfers, leg cash from konto to sav amount 100.00 PLN) "a1"
  bank[a2] = (on: 2026-03-20, kind: transfers, leg cash from konto to sav amount 200.00 PLN) "a2"

version st_sav
  cite s
  governs 2026-03
  known 2026-04-03
  covers sav
  bank[b1] = (on: 2026-03-10, kind: transfers, leg cash from konto to sav amount 100.00 PLN) "b1"
  bank[b2] = (on: 2026-03-20, kind: transfers, leg cash from konto to sav amount 250.00 PLN) "b2"
  same bank[a1] = bank[b1]
  same bank[b2] = bank[a2]
