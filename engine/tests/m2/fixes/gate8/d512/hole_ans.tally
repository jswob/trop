model hh
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31
  note "T, M2 gate 8 run 43690242450 on d512fe7b: hole bookings, one a later version answers, read whole, up to a day and as known before it (book/adjust.rs answer_holes, hole_booked_before; walk/plan.rs plan_list, list_upto, move_instances, trace_answers)"

source s "s"
unit PLN: currency minor 0.01
input amt[m in months]: money PLN
input dom: int
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..

move pay[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from konto to world amount amt[m]

version v1
  cite s
  governs 2026..
  known 2026-01-01
  dom = 10 "s"
  amt[2026-01] = 100.00 PLN "s"
  amt[2026-04..2026-12] = 100.00 PLN "s"
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "s"

version v1h
  cite s
  governs 2026-02..2026-03
  known 2026-01-01
  amt[2026-02] = ?"How much was February's pay?"
  amt[2026-03] = ?"How much was March's pay?"

version v2
  cite s
  governs 2026-02
  known 2026-04-01
  replace amt[2026-02] = 150.00 PLN "s"

ask b2: bal(konto, 2026-02-28)
ask b3: bal(konto, 2026-03-31)
ask b5: bal(konto, 2026-05-31)
ask k3: bal(konto, 2026-05-31) as known 2026-03-15
ask a2: pay[2026-02].cash.amount
ask a3: pay[2026-03].cash.amount
ask n: count(a in adjustments over 2026)
ask f: flows(pay, 2026-01-01 .. 2026-05-31)
ask e2: explain bal(konto, 2026-02-28)
ask e5: explain pay[2026-02].cash.amount
