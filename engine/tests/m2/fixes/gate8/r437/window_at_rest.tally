model wa_for
  tally 2
  on 2026-08-01
  start 2026-01-01
  end 2026-12-31
  note "T, M2 gate 8 run 43702332507 on 6a58624c: wa_for's asks both engines answer alike: me's for alike on both sides of the law change and mq on pq, whose rows old and new state one day (walk/plan.rs same_body)"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

input wl: date
input pq: date
input pf: date
input pg: date
input a1: money PLN
input go: bool

move md: transfers
  on pq
  at wl
  for month_of(pf)
  leg cash from world to konto amount a1

move me: transfers
  on pq
  at wl
  for month_of(pg)
  leg cash from world to konto amount a1

move mq: transfers
  on pq
  at wl
  leg cash from world to konto amount a1

move mw: transfers
  on pq
  at wl
  when go
  leg cash from world to konto amount a1

ask d3: flows(md, 2026-04-01 .. 2026-04-30, for 2026-03)
ask d4: flows(md, 2026-04-01 .. 2026-04-30, for 2026-04)
ask e5: flows(me, 2026-04-01 .. 2026-04-30, for 2026-05)
ask e4: flows(me, 2026-04-01 .. 2026-04-30, for 2026-04)
ask w: flows(mw, 2026-04-01 .. 2026-04-30)
ask k: bal(konto, 2026-04-30)
ask n: count(t in transfers over 2026-04)

version v
  cite s
  governs always
  known 2026-01-01
  wl = window(2026-03-30, 2026-04-02) "s"
  a1 = 1.00 PLN "s"
  pg = 2026-05-15 "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"

version old
  cite s
  governs 2026-01-01..2026-03-31
  known 2026-01-01
  pq = 2026-04-10 "s"
  pf = 2026-03-15 "s"
  go = true "s"

version new
  cite s
  governs 2026-04-01..
  known 2026-01-01
  pq = 2026-04-10 "s"
  pf = 2026-04-15 "s"
  go = false "s"
ask kp: bal(konto, 2026-04-30) partial
ask mqf: flows(mq, 2026-04-01 .. 2026-04-30)
ask kpm: bal(konto, 2026-04-30) - bal(konto, 2026-03-01) partial
