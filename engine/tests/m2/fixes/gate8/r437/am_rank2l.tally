model t
  tally 2
  on 2026-04-10
  start 2026-03-01
  end 2026-04-30
  note "T, M2 gate 8 run 43702332507: a reading after m whose one fulfilling row has two legs at konto on one day, declared zfee before cash: the reading stands after the last by rank, zfee (walk/agenda.rs booked_rank -> 0, -> 1)"

source s "s"
unit PLN: currency minor 0.01
kind savings: place PLN min 0
place konto: accounts PLN lives 2026-01-01..
place sav: savings lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input fee: money PLN
kind twos: event certain
  leg zfee: PLN
  leg cash: PLN
input keep: money PLN
input d_save: int

move save[m in months]: twos
  on day_of(m, d_save)
  reads konto
  leg zfee from konto to world amount fee
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep - fee)

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  fee = 5.00 PLN "s"
  d_save = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"


version st
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[a1] = (on: 2026-03-14, kind: twos, leg zfee from konto to world amount 5.00 PLN, leg cash from konto to sav amount 500.00 PLN, fulfils: save[2026-03]) "a1"

version rd
  cite s
  governs 2026-03..2026-04
  known 2026-04-04
  pad konto from world
  stated[konto] = 90.00 PLN after save[2026-03] "saldo"
ask l14: last(stated[konto], 2026-03-14)
ask b13: bal(konto, 2026-03-13)
ask b14: bal(konto, 2026-03-14)
ask b31: bal(konto, 2026-03-31)
