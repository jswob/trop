model anyhole
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "synthetic"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind wallets: place any signed

place broker: wallets lives 2026-01-01..
place work: outside lives 1900-01-01..

ask b1: bal(broker, EUR, 2026-03-01)
ask l1: last(stated[broker], 2026-03-01)
ask e2: explain bal(broker, EUR, 2026-03-01)

version v
  cite s
  governs always
  known 2026-01-01
  opening[broker] = 0.00 EUR at 2026-01-01 start "own"

version r2
  cite s
  governs 2026-02
  known 2026-02-16
  anchor broker
  stated[broker] = 4.00 EUR at 2026-02-15 end "saldo"

version r3
  cite s
  governs 2026-02
  known 2026-02-20
  anchor broker
  stated[broker] = ?"not read yet" at 2026-02-18 end "pending"
