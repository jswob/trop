model x_any2
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "synthetic"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
unit etf "fund unit"
kind wallets: place any signed
kind fx: event certain
  leg cash: any

place broker: wallets lives 2026-01-01..
place world: outside lives 1900-01-01..

input eamt: money EUR
input bday: date

move buy: fx
  on bday
  leg cash from world to broker amount eamt

ask b: bal(broker, EUR, 2026-03-01)
ask b2: bal(broker, PLN, 2026-03-01)
ask e: explain bal(broker, EUR, 2026-03-01)
ask e2: explain bal(broker, PLN, 2026-04-01)
ask l1: last(opening[broker], 2026-03-01)
ask l2: last(stated[broker], 2026-04-01)
ask s1: since(stated[broker], 2026-04-01)

version v
  cite s
  governs always
  known 2026-01-01
  eamt = 4.00 EUR "own"
  bday = 2026-02-01 "own"
  opening[broker] = 0.00 EUR at 2026-01-01 start "own"
  opening[broker] = 5.00 PLN at 2026-01-01 start "own"

