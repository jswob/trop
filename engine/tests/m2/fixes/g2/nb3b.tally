model eurnone
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "synthetic"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind wallets: place EUR signed

place broker: wallets lives 2026-01-01..
place work: outside lives 1900-01-01..

ask b1: bal(broker, EUR, 2026-03-01)
ask l1: last(stated[broker], 2026-03-01)
ask e2: explain bal(broker, EUR, 2026-03-01)
ask s1: since(stated[broker], 2026-03-01)
ask s2: since(stated[broker], 2026-02-10)

version v
  cite s
  governs always
  known 2026-01-01
  opening[broker] = 0.00 EUR at 2026-01-01 start "own"

version r1
  cite s
  governs 2026-01
  known 2026-02-01
  anchor broker
  stated[broker] = 2.00 EUR at 2026-01-31 end "jan"

version r2
  cite s
  governs 2026-02
  known 2026-02-16
  anchor broker
  stated[broker] = 4.00 EUR at 2026-02-15 end "saldo"

version r3
  cite s
  governs 2026-02
  known 2026-02-20
  anchor broker
  replace stated[broker] = none at 2026-02-15 end "withdrawn"
