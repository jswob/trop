model anyearly
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "synthetic"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind wallets: place any signed

place broker: wallets lives 2025-01-01..
place work: outside lives 1900-01-01..

ask b1: bal(broker, EUR, 2026-03-01)
ask b0: bal(broker, EUR, 2026-01-20)
ask l1: last(stated[broker], 2026-03-01)
ask l0: last(stated[broker], 2026-01-20)
ask e2: explain bal(broker, EUR, 2026-03-01)

version r1
  cite s
  governs 2026-01
  known 2026-01-11
  anchor broker
  stated[broker] = ?"not read yet" at 2026-01-10 end "pending"

version r2
  cite s
  governs 2026-02
  known 2026-02-16
  anchor broker
  stated[broker] = 4.00 EUR at 2026-02-15 end "saldo"
