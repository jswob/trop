model b2
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "gate B2: inputs-of under windows each merges axis options whose row sets differ"

source card "invented"
unit PLN: currency minor 0.01

axis ax
  lo "low"
  hi "high"

input wd: date
input rate: money PLN
input twice: int

def bonus_amt: money PLN at wd
  rule base = rate
  rule hi beats base = rate * twice when ax == hi

ask each: inputs-of bonus_amt windows each
ask plain: inputs-of bonus_amt
ask each_hi: inputs-of bonus_amt with ax = hi windows each

version v
  cite card
  governs always
  known 2026-01-01
  wd = window(2026-03-28, 2026-04-03) "c"
  twice = 2 "c"

version r1
  cite card
  governs ..2026-03-31
  known 2026-01-01
  rate = 10.00 PLN "c"

version r2
  cite card
  governs 2026-04-01..
  known 2026-01-01
  rate = 12.00 PLN "c"
