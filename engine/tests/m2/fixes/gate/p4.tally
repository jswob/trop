model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source bk "bank"
unit PLN: currency minor 0.01
kind groceries: transfers
  attr cat: text
input bank: observed
input g_amt: money PLN
input g_dom: int
input g_cat: text
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..

move groc[m in months]: groceries
  on day_of(m, g_dom)
  at start_of(m)
  leg cash from konto to world amount g_amt
  attr cat = g_cat

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  g_amt = 500.00 PLN "plan"
  g_dom = 5 "plan"
  g_cat = "plan" "plan"
  opening[konto] = 10 000.00 PLN at 2026-01-01 start "wyciąg"

version statement_02
  cite bk
  governs 2026-02..2026-03
  known window(2026-04-02, 2026-04-20)
  covers konto
  pad konto from unexplained
  bank[r1] = (on: 2026-02-05, kind: groceries, leg cash from konto to world amount 300.00 PLN, cat: "food", fulfils: groc[2026-02]) "l1"
  bank[r3] = (on: 2026-03-05, kind: groceries, leg cash from konto to world amount 300.00 PLN, cat: "food", fulfils: groc[2026-03]) "l3"
  bank[r5] = (on: 2026-03-07, kind: groceries, leg cash from konto to world amount 5.00 PLN, cat: "home") "l5"
  stated[konto] = 8 000.00 PLN at 2026-03-31 end "saldo"

ask f1: flows(groc, 2026-02..2026-03) as known 2026-04-10
ask f2: flows(groc, 2026-02..2026-03) as known 2026-04-10 windows each
ask f3: flows(konto, 2026-02..2026-03) as known 2026-04-10
ask o1: observed(groc[2026-02]).cash.amount as known 2026-04-10
ask o2: observed(groc[2026-02]).cash.amount as known 2026-04-10 windows each
ask b1: bal(konto, 2026-03-31) as known 2026-04-10
ask b2: bal(konto, 2026-03-31) as known 2026-04-10 windows each
ask b3: bal(konto, 2026-03-31) modelled as known 2026-04-10
ask c1: sum(-t.cash.amount for t in groceries over 2026-02..2026-03) as known 2026-04-10
ask c2: count(t in groceries over 2026-02..2026-03) as known 2026-04-10
ask c3: count(o in bank over 2026-02..2026-03) as known 2026-04-10
ask g1: gap(konto, 2026-03-31) as known 2026-04-10
ask r1: residuals konto 2026-02..2026-03 as known 2026-04-10
ask p1: bal(konto, 2026-06-30) from 2026-04-05 as known 2026-04-10
ask p2: bal(konto, 2026-06-30) from 2026-04-05 as known 2026-04-10 windows each
ask z1: flows(groc, 2026-02..2026-03)
