model t
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input keep: money PLN
input d_save: int

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"

version st
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  pad konto from world
  bank[o1] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 500.00 PLN, fulfils: save[2026-03]) "o1"
  stated[konto] = 90.00 PLN after save[2026-03] "saldo"

ask b: bal(konto, 2026-03-14), bal(konto, 2026-03-15), bal(konto, 2026-03-31)
ask m14: bal(konto, 2026-03-14) modelled
ask m15: bal(konto, 2026-03-15) modelled
ask m16: bal(konto, 2026-03-16) modelled
ask m31: bal(konto, 2026-03-31) modelled
ask g: gap(konto, 2026-03-15)
ask r: residuals konto 2026-03
