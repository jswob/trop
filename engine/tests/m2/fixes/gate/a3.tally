model rec
  tally 2
  on 2026-04-10
  start 2026-01-01
  end 2026-12-31
  note "gate probe a3: axis x partial x modelled x residuals x projections"

source s "synthetic"

unit PLN: currency minor 0.01

axis ax
  lo "low"
  hi "high"

place konto: accounts PLN lives 2026-01-01..

place sav: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input bank: observed

input keep: money PLN

input amt: money PLN

input extra[m in months]: money PLN question "extra?"

input d_save: int

input d_bonus: int

def pay_amt: money PLN at reader
  rule base = amt
  rule high beats base = amt + amt when ax == hi

move pay[m in months]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from world to konto amount pay_amt

move bonus[m in months]: transfers
  on day_of(m, d_bonus)
  leg cash from world to konto amount extra[m]

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

ask b1: bal(konto, 2026-06-30)
ask b2: bal(konto, 2026-06-30) partial
ask b3: bal(konto, 2026-06-30) with ax = hi partial
ask b4: bal(konto, 2026-05-10), bal(konto, 2026-05-20) partial
ask b5: bal(konto, 2026-05-10) from 2026-04-11 partial
ask b6: min(bal(konto, d) for d in 2026-04-11 .. 2026-05-12 step 1 day) partial
ask b7: flows(konto, 2026-05-01 .. 2026-05-10) partial
ask b8: sum(t.cash.amount for t in transfers over 2026-05-01 .. 2026-05-10) partial
ask b9: flows(bonus, 2026-05-01 .. 2026-05-10) with ax = lo partial
ask m1: bal(konto, 2026-03-31) modelled
ask m2: bal(konto, 2026-03-31) modelled with ax = hi
ask m3: check bal(konto, 2026-03-31) == bal(konto, 2026-03-31) modelled
ask m4: bal(konto, 2026-03-31) modelled, bal(konto, 2026-03-10) modelled, bal(konto, 2026-03-01) modelled, bal(konto, 2026-02-28) modelled
ask m5: bal(konto, 2026-05-31) modelled partial
ask m6: bal(sav, 2026-03-31) modelled
ask r1: residuals konto 2026-03
ask r2: residuals konto 2026-03 with ax = hi
ask r3: residuals konto 2026-03 with ax = hi as known 2026-02-20
ask r4: residuals konto 2026-03 as known 2026-02-20
ask r5: residuals konto 2026-01-01 .. 2026-05-31 with ax = lo
ask q1: mean(bal(konto, end_of(m)) for m in [2026-01, 2026-02, 2026-03]) with ax = lo
ask q2: mean(extra[m] for m in [2026-04, 2026-05, 2026-06]) partial
ask q3: share(extra[m] > 0 PLN for m in [2026-04, 2026-05, 2026-06])
ask q4: quantile(bal(konto, end_of(m)) for m in [2026-01, 2026-02, 2026-03], 0.5)
ask e1: explain bal(konto, 2026-03-31) modelled with ax = lo
ask e2: explain bal(konto, 2026-03-10) modelled with ax = lo

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  amt = 1000.00 PLN "s"
  d_save = 15 "s"
  d_bonus = 5 "s"
  extra[*] = 0.00 PLN "none"
  extra[2026-05] = ?"What is May's extra?" "May"
  extra[2026-03] = 30.00 PLN "March"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  opening[sav] = 0.00 PLN at 2026-01-01 start "s"

version st_konto
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  anchor konto
  bank[a1] = (on: 2026-03-01, kind: transfers, leg cash from world to konto amount 1000.00 PLN, fulfils: pay[2026-03]) "PENSJA"
  bank[a2] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "NA OSZCZEDNOSCI"
  bank[a3] = (on: 2026-03-20, kind: transfers, leg cash from world to konto amount 50.00 PLN) "DOPLATA"
  stated[konto] = 210.00 PLN at 2026-03-10 end "saldo 10"
  stated[konto] = 100.00 PLN at 2026-03-31 end "saldo"
