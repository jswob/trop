model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31
  note "T, M2 G6 vectors: G6's observed row read by its id (L §5.19): the row, a leg, its day, its fulfils, explain and inputs-of of its attribute, a sum over no member; o5 is held (spec/g6/obsrow_o5)"

source plan "plan"
source bk "bank"
unit PLN: currency minor 0.01
kind groceries: transfers
  attr cat: text
input bank: observed
input g_amt: money PLN
input g_dom: int
input g_cat: text
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..

move groc[m in months]: groceries
  on day_of(m, g_dom)
  at start_of(m)
  leg cash from konto to world amount g_amt
  attr cat = g_cat

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  g_amt = 500.00 PLN "plan"
  g_dom = 5 "plan"
  g_cat = "plan" "plan"
  opening[konto] = 10 000.00 PLN at 2026-01-01 start "wyciąg"

version statement_02
  cite bk
  governs 2026-02..2026-03
  known 2026-04-02
  covers konto
  pad konto from unexplained
  bank[r1] = (on: 2026-02-05, kind: groceries, leg cash from konto to world amount 300.00 PLN, cat: "food", fulfils: groc[2026-02]) "l1"
  bank[r2] = (on: 2026-02-06, kind: groceries, leg cash from konto to world amount 250.00 PLN, cat: "food", fulfils: groc[2026-02]) "l2"
  bank[r3] = (on: 2026-03-05, kind: groceries, leg cash from konto to world amount 300.00 PLN, cat: "food", fulfils: groc[2026-03]) "l3"
  bank[r4] = (on: 2026-03-06, kind: groceries, leg cash from konto to world amount 250.00 PLN, cat: "home", fulfils: groc[2026-03]) "l4"
  bank[r5] = (on: 2026-03-07, kind: groceries, leg cash from konto to world amount 5.00 PLN, cat: "home") "l5"
  stated[konto] = 8 000.00 PLN at 2026-03-31 end "saldo"




ask o1: bank[r9]
ask o2: bank[r5].cash.amount
ask o3: bank[r5]
ask o4: bank[r1].day
ask o5: bank[r5].cat as known 2026-03-01
ask o6: explain bank[r5].cat
ask o7: inputs-of bank[r5].cat
ask o8: sum(t.cash.amount for t in groceries over 2026-07)
ask o9: bank[r1].fulfils
ask o10: count(t in groceries over 2026-03 where t == bank[r4])
