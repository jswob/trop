model p
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31
  note "T, M2 G6 review and fix review (tmp/m2/review-g6.md, review-g6-fix.md): P62, a projection counts a movement whose leg day is in [t, d] though its date is after d (100.00)"
source card "probe"
unit DUK: currency minor 0.01
place konto: accounts DUK lives 2026-01-01..
place world: outside lives 2026-01-01..
input amt: money DUK
input d_mv: date
input d_leg: date
move early: transfers
  on d_mv
  leg cash from world to konto amount amt on d_leg
ask a: bal(konto, 2026-04-30) from 2026-02-01 with uncertain, bal(konto, 2026-04-30) from 2026-02-01, bal(konto, 2026-04-30)
ask b: low(konto, 2026-02-01 .. 2026-04-30) from 2026-02-01 with uncertain
version v
  cite card
  governs always
  known 2026-01-01
  amt = 100.00 DUK "c"
  d_mv = 2026-06-01 "c"
  d_leg = 2026-03-01 "c"
  opening[konto] = 0.00 DUK at 2026-01-01 start "c"
