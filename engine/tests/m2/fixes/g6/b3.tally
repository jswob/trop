model p
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31
  note "T, M2 G6 review and fix review (tmp/m2/review-g6.md, review-g6-fix.md): B3, a partial balance whose decision's day is a hole: the plain hole (L §5.18)"
source card "probe"
unit DUK: currency minor 0.01
place konto: accounts DUK lives 2026-01-01..
place world: outside lives 2026-01-01..
input a: money DUK
input dd: date
input dg: date
input ten: money DUK
move gift: transfers
  on dg
  leg cash from world to konto amount a
move topup: transfers
  on dd
  reads konto
  leg cash from world to konto amount ten + 0 * bal(konto)
ask q: bal(konto, 2026-06-30) partial
ask q2: bal(konto, 2026-06-30)
version v
  cite card
  governs always
  known 2026-01-01
  opening[konto] = 100.00 DUK at 2026-01-01 start "c"
  a = ?"gift amount" "c"
  dd = ?"top-up day" "c"
  ten = 10.00 DUK "c"
  dg = 2026-02-01 "c"
