model t
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-06-30
  note "T, tally 2.1.8 R14 (#198), item #173 SQ-2 and no-item 5: a unitless hole stands for the units the place has a position in at its instant, each up to that unit's next reading. At 2026-02-17 broker holds EUR (opening) and no USD: EUR takes the hole until its reading at 2026-02-25; USD, which arrives on 2026-03-01, starts from zero, not from the hole; no-item 4, a later EUR reading at the hole's instant, no replace, is the narrower claim (eur17)"

source s "s"
unit EUR: currency minor 0.01
unit USD: currency minor 0.01
kind wallets: place any signed
place broker: wallets lives 2026-01-01..
place world: outside lives 1900-01-01..
input usd_in: money USD
input usd_day: date

move buy: transfers
  on usd_day
  leg cash from world to broker amount usd_in

version v1
  cite s
  governs always
  known 2026-01-01
  anchor broker
  usd_in = 7.00 USD "s"
  usd_day = 2026-03-01 "s"
  opening[broker] = 1.00 EUR at 2026-01-01 start "s"

version v2
  cite s
  governs always
  known 2026-03-01
  anchor broker
  stated[broker] = ?"not read" at 2026-02-17 end "s"
  stated[broker] = 3.00 EUR at 2026-02-25 end "s"

version v3
  cite s
  governs always
  known 2026-04-01
  anchor broker
  stated[broker] = 5.00 EUR at 2026-02-17 end "s"

ask e: bal(broker, EUR, 2026-02-16), bal(broker, EUR, 2026-02-20), bal(broker, EUR, 2026-02-26) as known 2026-03-15
ask u: bal(broker, USD, 2026-02-20), bal(broker, USD, 2026-03-05) as known 2026-03-15
ask eur17: bal(broker, EUR, 2026-02-20), bal(broker, USD, 2026-03-05)
