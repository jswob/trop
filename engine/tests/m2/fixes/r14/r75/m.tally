model t
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-06-30
  note "T, tally 2.1.8 R14 (#198): item 75, a unitless hole row beside EUR's reading at one instant, no replace: it loads, EUR's own reading is the narrower claim, PLN takes the hole (a: 4.00 EUR, then the hole)"

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind wallets: place any signed
place broker: wallets lives 2025-01-01..

version v1
  cite s
  governs always
  known 2026-01-01
  anchor broker
  opening[broker] = 1.00 EUR at 2026-01-01 start "s"
  opening[broker] = 2.00 PLN at 2026-01-01 start "s"
  stated[broker] = 4.00 EUR at 2026-02-15 end "s"


version v2
  cite s
  governs always
  known 2026-03-01
  anchor broker
  stated[broker] = ?"not read" at 2026-02-15 end "s"

ask a: bal(broker, EUR, 2026-02-20), bal(broker, PLN, 2026-02-20)
ask a17: bal(broker, EUR, 2026-02-18), bal(broker, PLN, 2026-02-18)
