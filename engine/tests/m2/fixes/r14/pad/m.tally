model t
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-06-30
  note "T, tally 2.1.8 R14 (#198): item #175, a pad's id ends with its unit, so two units padded at one instant are two movements (bp: pads:st:broker@2026-02-15 end:EUR and :PLN); no-item 1, count(p in pads over s) is 2 and explain of an EUR read lists EUR's pad only (cp, ex)"

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind wallets: place any signed
place broker: wallets lives 2025-01-01..
place world: outside lives 1900-01-01..

version v1
  cite s
  governs always
  known 2026-01-01
  opening[broker] = 1.00 EUR at 2026-01-01 start "s"
  opening[broker] = 2.00 PLN at 2026-01-01 start "s"

version st
  cite s
  governs 2026-02
  known 2026-03-01
  pad broker from world
  stated[broker] = 4.00 EUR at 2026-02-15 end "s"
  stated[broker] = 10.00 PLN at 2026-02-15 end "s"

ask bp: bal(broker, EUR, 2026-02-20), bal(broker, PLN, 2026-02-20)
ask cp: count(p in pads over 2026-02)
ask ex: explain bal(broker, EUR, 2026-02-20)
