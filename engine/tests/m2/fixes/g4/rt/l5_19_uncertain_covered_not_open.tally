model t
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "s"
source bk "bank"
unit PLN: currency minor 0.01
kind bonuses: event uncertain
  leg cash: PLN
kind wages: event certain
  leg cash: PLN
input bank: observed
input day: date
input b_amt: money PLN
input w_amt: money PLN
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 2026-01-01..
place unexplained: outside lives 2026-01-01..

move bonus: bonuses
  on day
  leg cash from world to konto amount b_amt

move wage: wages
  on day
  leg cash from world to konto amount w_amt

ask q: bal(konto, 2026-01-31)
ask q2: bal(konto, 2026-01-31) with uncertain

version v
  cite s
  governs always
  known 2026-01-01
  day = 2026-01-15
  b_amt = 100.00 PLN
  w_amt = 50.00 PLN
  opening[konto] = 0 PLN at 2026-01-01 start

version st
  cite bk
  governs 2026-01
  known 2026-02-02
  covers konto
  pad konto from unexplained
