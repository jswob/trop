model g
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source s "s"
source bank_export "bank"
unit PLN: currency minor 0.01

input bank: observed
input pay_day: date
input pay_amt: money PLN

place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

move pay: transfers
  on pay_day
  leg cash from world to konto amount pay_amt

version v
  cite s
  governs always
  known 2025-12-01
  pay_day = 2026-02-02
  pay_amt = 500.00 PLN

version stmt_02
  cite bank_export
  governs 2026-02
  known 2026-03-01
  covers konto
  anchor konto
  bank[r1] = (on: 2026-02-02, kind: transfers, leg cash from world to konto amount 500.00 PLN, fulfils: pay) "line 1"
  stated[konto] = 520.00 PLN at 2026-02-28 end "saldo końcowe"

ask g28: gap(konto, 2026-02-28)
ask g27: gap(konto, 2026-02-27)
ask b28: bal(konto, 2026-02-28)
