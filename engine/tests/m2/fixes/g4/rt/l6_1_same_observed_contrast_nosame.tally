model one
  tally 2
  on 2026-10-25
  start 2024-01-01
  end 2024-12-31

source s "made up"

unit DUK: currency minor 0.01

place acc: accounts DUK lives 2024-01-01..

place other: outside lives 2024-01-01..

input stmt: observed

input g_day: date

input g_amt: money DUK

move gift: transfers
  on g_day
  leg cash from other to acc amount g_amt

ask q: flows(acc, 2024)

version v
  cite s
  governs 2024-05
  known 2024-05-02
  covers acc
  stmt[r1] = (on: 2024-05-02, kind: transfers, leg cash from other to acc amount 5000.00 DUK) "r1"

version plan
  cite s
  governs always
  known 2024-01-01
  g_day = 2024-05-02 "plan"
  g_amt = 5000.00 "plan"
