model t
  tally 2
  on 2026-04-10
  start 2026-03-01
  end 2026-04-30

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place unexplained: outside lives 1900-01-01..
input bank: observed
input keep: money PLN
input d_save: int

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

ask q_save: flows(save, 2026-03-01 .. 2026-03-31)
ask q_obs: observed(save[2026-03]).cash.amount
ask q_sav: bal(sav, 2026-03-31)
ask q_konto: bal(konto, 2026-03-31)
ask q_moved: sum(t.cash.amount for t in transfers over 2026-03)
ask q_n: count(t in transfers over 2026-03)
ask q_flk: flows(konto, 2026-03-01 .. 2026-03-31)
ask q_led: residuals konto 2026-03

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"

ask m20: bal(konto, 2026-03-20) modelled
ask r20: bal(konto, 2026-03-20)
ask m405: bal(konto, 2026-04-05) modelled
ask r405: bal(konto, 2026-04-05)
ask m215: bal(konto, 2026-02-15) modelled
ask m420: bal(konto, 2026-04-20) modelled
ask m515: bal(konto, 2026-05-15) modelled
ask s420: bal(sav, 2026-04-20) modelled

version st_konto
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[a2] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 900.00 PLN, fulfils: save[2026-03]) "a"

version st_sav
  cite s
  governs 2026-03
  known 2026-04-03
  covers sav
  bank[b1] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 900.00 PLN, fulfils: save[2026-03]) "b"
  same bank[a2] = bank[b1]
