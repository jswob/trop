model t
  tally 2
  on 2026-02-15
  start 2026-01-01
  end 2026-06-30
  note "T, tally 2.1.8 §4 item 29 (#179): held over a hole row read past K lists the hole in its own form, held: owed[2026-03] = ?\"...\" (v), read for 2026-03 (refcore prints no line, the engine = ? before 2.1.8)"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input owed[m in months]: money PLN
input dom: int

move pay[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from konto to world amount owed[m]

version v
  cite s
  governs 2026-01..2026-06
  known 2026-01-01
  dom = 10 "s"
  owed[2026-01..2026-02] = 5.00 PLN "s"
  owed[2026-03] = ?"what is owed in March" "s"
  owed[2026-04..2026-06] = 5.00 PLN "s"
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"

ask h: bal(konto, 2026-03-31)
