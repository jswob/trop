model hh
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.8 §4 item 4 (#170): low over a window stays HOLE-IMPRECISE, as its spelled-out min is (l1, l2); windows each answers (l3). No change (the planner's p4)"

source s "s"
unit PLN: currency minor 0.01
input amt: money PLN
input wd: date
input zero: money PLN
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..

move pay: transfers
  on wd
  leg cash from world to konto amount amt

version v1
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  zero = 0.00 PLN "s"
  wd = window(2026-03-05, 2026-03-10) "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "w"

ask l1: min(bal(konto, d) for d in 2026-03-01 .. 2026-04-30 step 1 day)
ask l2: min(bal(konto, d) for d in 2026-03-01 .. 2026-04-30 step 1 day)
ask b1: bal(konto, 2026-03-07)
ask b2: bal(konto, 2026-03-07) >= zero
ask b3: bal(konto, 2026-03-11)
ask b4: min(bal(konto, 2026-03-07), zero)
ask f1: flows(konto, 2026-03)
ask f2: flows(konto, 2026-03-01 .. 2026-03-07)
ask h1: min(bal(konto, d) for d in 2026-03-11 .. 2026-04-30 step 1 day)
