model pw
  tally 2
  on 2026-04-25
  start 2026-01-01
  end 2026-12-31
  note "T, M2 P60 (G6's census of run-time stops): book/observe.rs:216, an observation known in a window that holds the cut, no windows each; tally 2.2 (S-1): the kind mixed is of unit PLN, a model's place being of one unit, and its one place holds only PLN, so every answer is as before"

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
index ks = [a, b]
kind mixed: place PLN signed
place konto: accounts PLN lives 2026-01-01..
place wallet: mixed lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input amt: money PLN
input dk[k in ks]: date
input d0: date
input dd: int

move pay[m in months]: transfers
  on day_of(m, dd)
  leg cash from world to konto amount amt

version v
  cite s
  governs always
  known 2026-01-01
  amt = 10.00 PLN "s"
  d0 = 2026-01-01 "s"
  dd = 10 "s"
  dk[a] = window(2026-03-01, 2026-03-10) "s"
  dk[b] = 2026-03-05 "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  opening[wallet] = 0.00 PLN at 2026-01-01 start "s"

ask q: bal(konto, 2026-03-31) as known 2026-04-10

version st
  cite s
  governs 2026-03
  known window(2026-04-01, 2026-04-20)
  covers konto
  bank[r1] = (on: 2026-03-10, kind: transfers, leg cash from world to konto amount 12.00 PLN) "r1"
