model p
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31
  note "T, M2 P60 (G6's census of run-time stops): eval/convert.rs:403, a move named as an event-key row's value (refcore: LOAD-KEY)"

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
index ks = [a, b]
kind mixed: place any signed
place wallet: mixed lives 2026-01-01..
input y[k in ks]: int
input px: money PLN reading
input z[k in ks, j in ks]: int
kind twos: event certain
  leg cash: PLN
  leg fee: PLN
place konto: accounts PLN lives 2026-01-01..
place jar[k in ks]: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input dom: int
input fx: num PLN/EUR
input x[k in ks]: int
input pday: date
input dk[k in ks]: date
input bank: observed
kind cats: transfers
  attr cat: text
input lo: money PLN
input hi: money PLN
input ids: text
input plaw: date

move pay[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  for m
  leg cash from world to konto amount amt

move buy[m in months]: twos
  on day_of(m, dom)
  at start_of(m)
  leg cash from konto to world amount amt
  leg fee from konto to world amount amt

move put[k in ks]: transfers
  on pday
  at plaw
  leg cash from world to jar[k] amount amt

version v
  cite s
  governs always
  known 2026-01-01
  amt = 10.00 PLN "s"
  dom = 5 "s"
  fx = 4.25 "s"
  x[a] = 1 "s"
  y[a] = 3 "s"
  y[b] = 4 "s"
  z = 1 "s"
  pday = 2026-03-05 "s"
  dk[a] = 2026-03-31 "s"
  dk[b] = 2026-04-30 "s"
  lo = 0.00 PLN "s"
  hi = 0.02 PLN "s"
  ids = "a" "s"
  plaw = 2026-03-01 "s"
  x[b] = 2 "s"
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"
  opening[jar[a]] = 0.00 PLN at 2026-01-01 start "s"
  opening[jar[b]] = 0.00 PLN at 2026-01-01 start "s"

input pick: key transfers
ask q: pick

version pk
  cite s
  governs always
  known 2026-01-01
  pick = pay
