model pw
  tally 2
  on 2026-04-25
  start 2026-01-01
  end 2026-12-31
  note "T, M2 P60 (G6's census of run-time stops): eval/arith.rs:128, a sum over a window (days_between of a window; refcore: RUN-DOMAIN)"

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
index ks = [a, b]
kind mixed: place any signed
place konto: accounts PLN lives 2026-01-01..
place wallet: mixed lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input amt: money PLN
input dk[k in ks]: date
input d0: date
input dd: int

move pay[m in months]: transfers
  on day_of(m, dd)
  leg cash from world to konto amount amt

version v
  cite s
  governs always
  known 2026-01-01
  amt = 10.00 PLN "s"
  d0 = 2026-01-01 "s"
  dd = 10 "s"
  dk[a] = window(2026-03-01, 2026-03-10) "s"
  dk[b] = 2026-03-05 "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  opening[wallet] = 0.00 PLN at 2026-01-01 start "s"

ask q: sum(days_between(d0, dk[k]) for k in ks)
