model wa_for
  tally 2
  on 2026-08-01
  start 2026-01-01
  end 2026-12-31
  note "T, M2 P60 (G6's census of run-time stops): walk/flows.rs:54 and walk/plan.rs imprecise_part, flows for a period of moves whose at is a window crossing a law change, one whose for differs across it and one whose for doesn't; one whose when differs"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

input wl: date
input pq: date
input pf: date
input pg: date
input a1: money PLN
input go: bool

move md: transfers
  on pq
  at wl
  for month_of(pf)
  leg cash from world to konto amount a1

move me: transfers
  on pq
  at wl
  for month_of(pg)
  leg cash from world to konto amount a1

move mw: transfers
  on pq
  at wl
  when go
  leg cash from world to konto amount a1

ask d3: flows(md, 2026-04-01 .. 2026-04-30, for 2026-03)
ask d4: flows(md, 2026-04-01 .. 2026-04-30, for 2026-04)
ask e5: flows(me, 2026-04-01 .. 2026-04-30, for 2026-05)
ask e4: flows(me, 2026-04-01 .. 2026-04-30, for 2026-04)
ask w: flows(mw, 2026-04-01 .. 2026-04-30)
ask k: bal(konto, 2026-04-30)
ask n: count(t in transfers over 2026-04)

version v
  cite s
  governs always
  known 2026-01-01
  wl = window(2026-03-30, 2026-04-02) "s"
  a1 = 1.00 PLN "s"
  pg = 2026-05-15 "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"

version old
  cite s
  governs 2026-01-01..2026-03-31
  known 2026-01-01
  pq = 2026-04-10 "s"
  pf = 2026-03-15 "s"
  go = true "s"

version new
  cite s
  governs 2026-04-01..
  known 2026-01-01
  pq = 2026-04-10 "s"
  pf = 2026-04-15 "s"
  go = false "s"
