model t
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-10-31
  note "T, tally 2.1.8 R13 (#197) and S7 (#174), no-item 7: ten monthly pay windows of three days; January's lowest balance reads one of them, so windows each takes three days (lo; refused RUN-LIMIT before 2.1.8), and the January balance answers on its plain line (bj); lo_plain, the plain twin, is the hole; S7, a line whose hole names all ten windows passes 20 000 day combinations, RUN-LIMIT (lim)"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2025-01-01..
place world: outside lives 1900-01-01..
input pay: money PLN
input rent: money PLN
input pd[m in months]: date
input rd: int

move inc[m in months]: transfers
  on pd[m]
  leg cash from world to konto amount pay

move out[m in months]: transfers
  on day_of(m, rd)
  leg cash from konto to world amount rent

version v
  cite s
  governs always
  known 2025-12-01
  pay = 10.00 PLN "s"
  rent = 100.00 PLN "s"
  rd = 5 "s"
  pd[2026-01] = window(2026-01-10, 2026-01-12) "s"
  pd[2026-02] = window(2026-02-10, 2026-02-12) "s"
  pd[2026-03] = window(2026-03-10, 2026-03-12) "s"
  pd[2026-04] = window(2026-04-10, 2026-04-12) "s"
  pd[2026-05] = window(2026-05-10, 2026-05-12) "s"
  pd[2026-06] = window(2026-06-10, 2026-06-12) "s"
  pd[2026-07] = window(2026-07-10, 2026-07-12) "s"
  pd[2026-08] = window(2026-08-10, 2026-08-12) "s"
  pd[2026-09] = window(2026-09-10, 2026-09-12) "s"
  pd[2026-10] = window(2026-10-10, 2026-10-12) "s"
  opening[konto] = 500.00 PLN at 2026-01-01 start "s"

ask lo_plain: min(bal(konto, d) for d in 2026-01-01 .. 2026-01-31 step 1 day)
ask bj: bal(konto, 2026-01-31)
