model t
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-06-30
  note "T, tally 2.1.8 R13 (#197): rest 1, residuals x span in S names the world (r_in; both parse in S into the span and refuse the file, LOAD-UNIT, before 2.1.8); no-item 6, five clauses at once (r_all)"

source s "s"
unit PLN: currency minor 0.01
index ks = [a, b]
kind buys: transfers
  attr cat: text
place jar[k in ks]: accounts PLN lives 2026-01-01..
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..
input bank: observed
input amt: money PLN
input fd: date
input pdate: date

move put[k in ks]: transfers
  on pdate
  leg cash from world to jar[k] amount amt

move fee: transfers
  on fd
  leg cash from konto to world amount amt

version v
  cite s
  governs always
  known 2026-01-01
  amt = 10.00 PLN "s"
  pdate = 2026-03-02 "s"
  fd = window(2026-03-28, 2026-04-03) "s"
  opening[jar[a]] = 0.00 PLN at 2026-01-01 start "s"
  opening[jar[b]] = 0.00 PLN at 2026-01-01 start "s"
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"

version st
  cite s
  governs 2026-03
  known 2026-04-20
  covers jar[a], jar[b], konto
  pad jar[a] from unexplained
  pad jar[b] from unexplained
  bank[r1] = (on: 2026-03-02, kind: transfers, leg cash from world to jar[a] amount 10.00 PLN, fulfils: put[a]) "r1"
  bank[r2] = (on: 2026-03-04, kind: transfers, leg cash from world to jar[b] amount 12.00 PLN, fulfils: put[b]) "r2"
  bank[r3] = (on: 2026-03-09, kind: buys, leg cash from jar[b] to world amount 3.00 PLN, cat: "food") "r3"
  stated[jar[a]] = 10.00 PLN at 2026-03-31 end "s"
  stated[jar[b]] = 30.00 PLN at 2026-03-31 end "s"

ask r_in: residuals jar[a] 2026-03 in sc
ask r_all: residuals jar[k] 2026-03 by cat for k in ks as known 2026-04-25 in sc windows each
