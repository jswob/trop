model pg
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source card "invented"
unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..
place work: outside lives 1900-01-01..

input wd: date
input amt: money PLN

move g: transfers
  on wd
  leg cash from work to konto amount amt

ask q: sum(m.cash.amount for m in transfers over 2026-04-01 .. 2026-04-30)
version v
  cite card
  governs always
  known 2026-01-01
  amt = 10.00 PLN "c"
  wd = window(2026-03-30, 2026-04-02) "c"
  opening[konto] = 0.00 PLN at 2026-01-01 start "own"
