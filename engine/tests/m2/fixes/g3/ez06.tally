model pe
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source card "invented"
unit PLN: currency minor 0.01

input w1: date
input w2: date

def lt: bool
  rule base = w1 < w2

def d1: date
  rule base = add_days(w1, 0)

ask c: lt windows each
ask d: add_days(w1, 1) windows each

version v
  cite card
  governs always
  known 2026-01-01
  w1 = window(2026-01-01, 2026-06-28) "c"
  w2 = window(2026-01-15, 2026-06-15) "c"
