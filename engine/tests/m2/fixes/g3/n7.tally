model pn7
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source card "invented"
unit PLN: currency minor 0.01

index acct = [a1]

place konto: accounts PLN lives 2026-01-01..
place work: outside lives 1900-01-01..

input wd: date
input amt: money PLN

move mw[k in acct]: transfers
  on wd
  leg cash from work to konto amount amt

ask bw: bal(konto, 2026-04-30)
ask bww: bal(konto, 2026-04-30) windows each
ask aw: mw[a2].cash.amount

version v
  cite card
  governs always
  known 2026-01-01
  wd = window(2026-03-10, 2026-03-20) "c"
  amt = 10.00 PLN "c"
  opening[konto] = 0.00 PLN at 2026-01-01 start "own"

version v2
  cite card
  governs always
  known 2026-03-15
  acct + [a2]
