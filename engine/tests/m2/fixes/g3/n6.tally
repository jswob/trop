model pn6
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source card "invented"
unit PLN: currency minor 0.01

kind tagged: transfers
  attr size: int

place konto: accounts PLN lives 2026-01-01..
place work: outside lives 1900-01-01..

input wd: date
input amt: money PLN
input sz: int

move mw: tagged
  on wd
  attr size = sz
  leg cash from work to konto amount amt

ask sw: mw.size
ask aw: mw.cash.amount
ask bw: bal(konto, 2026-04-30)

version v
  cite card
  governs always
  known 2026-01-01
  wd = window(2026-03-10, 2026-03-20) "c"
  amt = 10.00 PLN "c"
  sz = 1 "c"
  opening[konto] = 0.00 PLN at 2026-01-01 start "own"

version v2
  cite card
  governs always
  known 2026-03-15
  replace sz = 2 "c"
