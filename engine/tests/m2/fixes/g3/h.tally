model ph
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source card "invented"
unit PLN: currency minor 0.01

input a: date
input b: date

ask q: a < b
version v
  cite card
  governs always
  known 2026-01-01
  a = window(2026-01-01, 2026-01-02) "c"
  b = window(2026-01-01, 2026-01-02) "c"
