model bd
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "synthetic"
unit PLN: currency minor 0.01
input x60: money PLN
input x10: money PLN

band za(x: money PLN): num
band zb(x: money PLN): num
band zg(x: money PLN): num

ask a_whole_alone: za(x60) law 2026-09-15
ask a_whole_over: za(x60) law 2026-03-15
ask b_patch: zb(x60) law 2026-03-15
ask c_wording: (zb(x60)) as if {wording 2026-03-01 for [zb]} law 2026-03-15
ask d_wording: (zb(x10)) as if {wording 2026-03-01 for [zb]} law 2026-03-15
ask e_plain: zb(x10) law 2026-03-15
ask f_gap: zg(x10) law 2026-03-15
ask g_gap_wording: (zg(x10)) as if {wording 2026-03-01 for [zg]} law 2026-03-15

version x0
  cite s
  governs always
  known 2026-01-01
  x60 = 60.00 PLN
  x10 = 10.00 PLN

version a1
  cite s
  governs 2026-01..2026-06
  known 2026-01-01
  enters 2026-05-01
  za: [0, 50) = 1 "a"
  za: [50, inf) = 2 "a"
  zb: [0, 50) = 1 "a"
  zb: [50, inf) = 2 "a"

version b1
  cite s
  governs 2026-01..2026-12
  known 2026-01-01
  enters 2026-05-01
  zg: [0, 50) = 1 "a"
  zg: [50, 100) = 2 "a"
  zg: [100, inf) = 3 "a"

version a2
  cite s
  governs 2026-01..2026-12
  known 2026-02-01
  replace za: [0, 100) = 3 "whole"
  replace za: [100, inf) = 4 "whole"
  replace zb: [50, inf) = 5 "patch"

version b2
  cite s
  governs 2026-01..2026-12
  known 2026-02-01
  replace zg: [0, 50) = 6 "gapped patch"
  replace zg: [100, inf) = 8 "gapped patch"

version a3
  cite s
  governs 2026-01..2026-12
  known 2026-03-01
