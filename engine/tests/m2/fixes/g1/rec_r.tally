model rr
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "synthetic"
unit PLN: currency minor 0.01
unit etf "fund unit"

input r1: (a num PLN/etf, note text)
input r2: (a num PLN, note text)
input r3: (a num PLN/etf, note text) reading
input r4: (a num PLN, note text) reading
input n1: num PLN/etf

ask a1: r1 law 2026-03-01
ask a2: r2 law 2026-03-01
ask a3: r3 law 2026-03-01
ask a4: r4 law 2026-03-01
ask a5: n1 law 2026-03-01

version v1
  cite s
  governs always
  known 2026-01-01
  r1 = (a: 12.50 PLN/etf, note: "x")
  r2 = (a: 12.50 PLN, note: "x")
  r3 = (a: 12.50 PLN/etf, note: "x") at 2026-03-01 "w"
  r4 = (a: 12.50 PLN, note: "x") at 2026-03-01 "w"
  n1 = 12.50 PLN/etf
