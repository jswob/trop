model a6
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source plan "plan"
input d: date
input cr: calendar
input cq: calendar
input huge: int
input n3: int
input n300: int

version v
  cite plan
  governs always
  known 2026-01-01
  d = 2026-06-01 "a day"
  huge = 100000000000000000000 "10^20"
  n3 = 3 "three"
  n300 = 300 "300"

version v26
  cite plan
  governs 2026
  known 2026-01-01
  cr = calendar(weekends [sat, sun]) "s"
  cq = calendar(weekends [sat, sun]) "s"

version v28
  cite plan
  governs 2028..
  known 2026-01-01
  cr = calendar(weekends [mon, tue, wed, thu, fri, sat, sun]) "none"

version v25
  cite plan
  governs ..2025
  known 2026-01-01
  cq = calendar(weekends [mon, tue, wed, thu, fri, sat, sun]) "none"

ask q_fwd: add_business(d, huge, cq)
ask x_fwd: add_business(d, huge, cq) in sx
ask x_back: add_business(d, -huge, cq) in sx
ask x_in: add_business(d, n300, cq) in sx
ask x_3: add_business(d, n3, cq) in sx
