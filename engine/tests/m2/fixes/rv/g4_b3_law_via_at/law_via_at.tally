model t
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-06-30

source s "s"
unit PLN: currency minor 0.01

input cutoff: date
input fixday: date

def cutoff_r: date at reader
  rule base = cutoff

def fixed: date at fixday
  rule base = cutoff_r

def amount: num at reader
  rule base = 1

ask q: amount law fixed
ask q2: fixed

version v0
  cite s
  governs always
  known 2026-01-01
  fixday = 2026-03-01 "s"

version v1
  cite s
  governs 2026-01-01..
  known 2026-01-01
  cutoff = 2026-04-01 "s"
