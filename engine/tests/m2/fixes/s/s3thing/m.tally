model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.8 S3 (#178), the clash: a field whose type is a thing (key places) prints bare, so the places balance and unexplained merge into the fixed groups today (r7, r8; both engines); S3 prints cat balance, cat unexplained"

source plan "plan"
source bk "bank"
unit PLN: currency minor 0.01
kind groceries: transfers
  attr cat: key places
kind fees: transfers
input bank: observed
input rent_amt: money PLN
input rent_dom: int
place konto: accounts PLN lives 2019-05-01..
place landlord: outside lives 1900-01-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..
place balance: outside lives 1900-01-01..

move rent[m in months]: transfers
  on day_of(m, rent_dom)
  at start_of(m)
  leg cash from konto to landlord amount rent_amt

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  rent_amt = 2 000.00 PLN "umowa"
  rent_dom = 3 "umowa"
  opening[konto] = 10 000.00 PLN at 2026-01-01 start "wyciąg"

version statement_02
  cite bk
  governs 2026-02
  known 2026-03-02
  covers konto
  pad konto from unexplained
  bank[r1] = (on: 2026-02-03, kind: transfers, leg cash from konto to landlord amount 2 000.00 PLN, fulfils: rent[2026-02]) "line 1"
  bank[r3] = (on: 2026-02-20, kind: groceries, leg cash from konto to world amount 400.00 PLN, cat: world) "line 3"
  bank[r4] = (on: 2026-02-21, kind: groceries, leg cash from konto to world amount 30.00 PLN, cat: world) "line 4"
  bank[r7] = (on: 2026-02-24, kind: groceries, leg cash from konto to world amount 5.00 PLN, cat: balance) "line 7"
  bank[r8] = (on: 2026-02-25, kind: groceries, leg cash from konto to world amount 1.00 PLN, cat: unexplained) "line 8"
  bank[r5] = (on: 2026-02-22, kind: fees, leg cash from konto to world amount 7.00 PLN) "line 5"
  bank[r6] = (on: 2026-02-23, kind: transfers, leg cash from konto to world amount 9.00 PLN) "line 6"
  stated[konto] = 7 548.00 PLN at 2026-02-28 end "saldo"

ask byc: residuals konto 2026-02 by cat
ask led: residuals konto 2026-02
ask gc: count(t in groceries over 2026-02)
