model t
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
  note "T, tally 2.1.8 R16 (#200): item #191 Q5, a reading after m whose standing-in observation is dated before m: m's leg is never counted after it (md: 520.00, 520.00); #169-b, the reading is applied after the observations that stand in for m (b); B5's first form, start keeps its instant under modelled (b5); no-item 1, explain of it lists the movements through d - 1 (ex_st); no-item 2, since of the reading counts from m's day as the walk books it (sn) (the planner's c7)"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input keep: money PLN
input d_save: int
input d_rent: int
input rentamt: money PLN

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

move rent[m in months]: transfers
  on day_of(m, d_rent)
  leg cash from konto to world amount rentamt

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = 15 "s"
  d_rent = 13 "s"
  rentamt = 30.00 PLN "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"

version st
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  anchor konto
  bank[o1] = (on: 2026-03-12, kind: transfers, leg cash from konto to sav amount 500.00 PLN, fulfils: save[2026-03]) "o1"
  bank[o2] = (on: 2026-03-13, kind: transfers, leg cash from konto to world amount 30.00 PLN, fulfils: rent[2026-03]) "o2"
  stated[konto] = 550.00 PLN after save[2026-03] "saldo"

ask b: bal(konto, 2026-03-31)
ask md: bal(konto, 2026-03-14) modelled, bal(konto, 2026-03-31) modelled
ask b5: bal(konto, 2026-03-15 start) modelled, bal(konto, 2026-03-15 start)
ask ex_st: explain bal(konto, 2026-03-15 start) modelled
ask sn: since(stated[konto], 2026-03-20), last(stated[konto], 2026-03-20)
ask unc: bal(konto, 2026-04-30) modelled, bal(konto, 2026-04-30)
ask gp: gap(konto, 2026-03-12), gap(konto, 2026-03-15)
