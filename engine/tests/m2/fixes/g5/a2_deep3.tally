model hh
  tally 2
  on 2027-06-30
  start 2019-06-01
  end 2027-12-31

source s "s"
unit PLN: currency minor 0.01
input base: money PLN question "ile?"
input dom: int
place konto: accounts PLN lives 2019-05-01..
place bank: outside lives 1900-01-01..

def acc[m in months]: money PLN = if pos(m) == 1 then base else acc[m - 1] at start_of(m)

move fee[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from konto to bank amount acc[m]

version v1
  cite s
  governs always
  known 2024-01-01
  dom = 10 "s"
  opening[konto] = 1 000.00 PLN at 2024-01-01 start "s"

version v2
  cite s
  governs always
  known 2027-03-01
  base = 1.00 PLN "s"

ask b0: acc[2027-06]
ask b1: bal(konto, 2027-06-30)
ask b2: bal(konto, 2027-06-30)
