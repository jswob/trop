model p17
  tally 2
  on 2026-10-18
  start 2026-01-01
  end 2026-12-31

source s "synthetic"
unit PLN: currency minor 0.01
kind persons
kind pets
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
input d0: date
input age[p in persons]: int
input lim: int
input amt: money PLN
input dom: int

move pay[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from konto to world amount amt

ask r1: count(p in persons on d0 where p in pets) law 2026-06-30
ask r2: count(p in persons on d0 where age[p] > lim) law 2026-06-30
ask r3: count(p in persons on d0 where age[p] < 0) law 2026-06-30
ask r4: count(p in persons on d0 where age[p] / (lim - lim) > 1) law 2026-06-30
ask r5: count(p in persons on d0 where false) law 2026-06-30
ask r6: count(t in transfers on d0 where t.cash.amount > amt) law 2026-06-30
ask r7: count(t in transfers on d0 where t in pets) law 2026-06-30
ask r8: sum(age[p] for p in persons on d0 where p in pets) law 2026-06-30

version v1
  cite s
  governs always
  known 2026-01-01
  d0 = ?"which day?"
  lim = 50
  amt = 10.00 PLN
  dom = 5
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"
  persons + [ana] lives 1990-01-01..
  persons + [bob] lives 1990-01-01..
  age[ana] = 30
  age[bob] = ?"ile lat?"
