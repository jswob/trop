model t
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
  note "T, tally 2.1.8 R12 (#196), item #169-j: a same line of a version known after K isn't seen at K, so the rows read apart (k_before: refused RUN-RECORD, two unjoined rows fulfil save[2026-03]); seen from its known on (k_after); a backtest's ledger pairs the observations as known on on, their same line with them (led); tally 2.2 (S-5): a same line between two observed rows has no clock, so it sits in the version of its later row; the asks at a cut between the line's known and its rows' went (the clock was their subject), and every other answer is as before"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place unexplained: outside lives 1900-01-01..
input bank: observed
input amt: money PLN
input d15: int

move save[m in months]: transfers
  on day_of(m, d15)
  leg cash from konto to sav amount amt

version v
  cite s
  governs always
  known 2026-01-01
  amt = 900.00 PLN "s"
  d15 = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"

version st_konto
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[a2] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "a"

version st_sav
  cite s
  governs 2026-03
  known 2026-04-03
  covers sav
  bank[b1] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "b"
  same bank[a2] = bank[b1]

version joined
  cite s
  governs 2026-03
  known 2026-04-20

ask k_before: flows(save, 2026-03) as known 2026-04-10
ask k_before_rows: count(o in bank over 2026-03) as known 2026-04-10
ask k_after: flows(save, 2026-03), bal(sav, 2026-03-31) as known 2026-04-25
ask led: residuals sav 2026-03 as known 2026-04-25
