model t
  tally 2
  on 2026-05-10
  start 2026-03-01
  end 2026-06-30
  note "T, tally 2.1.8 R12 (#196), item #169-f: a row, or a row's removal, known in a window that holds the cut makes a read a hole only where that row would be the one read (x_a answers, x_b the hole); a restatement before a removal known in a window stands with its legs that hole (gone)"

source s "s"
unit PLN: currency minor 0.01
index ks = [a, b]
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input x[k in ks]: money PLN

version v
  cite s
  governs always
  known 2026-01-01
  x[a] = 1.00 PLN "s"
  x[b] = 2.00 PLN "s"
  opening[konto] = 0.00 PLN at 2026-03-01 start "s"

version st
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[r1] = (on: 2026-03-03, kind: transfers, leg cash from world to konto amount 7.00 PLN) "r1"
  bank[r2] = (on: 2026-03-05, kind: transfers, leg cash from world to konto amount 9.00 PLN) "r2"

version vw
  cite s
  governs always
  known window(2026-04-01, 2026-04-20)
  replace x[b] = 3.00 PLN "s"

version rm
  cite s
  governs 2026-03
  known window(2026-04-05, 2026-04-20)
  replace bank[r2] = none

ask x_a: x[a] as known 2026-04-10
ask x_b: x[b] as known 2026-04-10
ask gone: bal(konto, 2026-03-04), bal(konto, 2026-03-31) as known 2026-04-10
ask gone_each: bal(konto, 2026-03-31) as known 2026-04-10 windows each
