model t
  tally 2
  on 2026-04-30
  start 2026-03-01
  end 2026-04-30
  note "T, tally 2.1.8 R12 (#196), item #187's known-window comment (rest 13): a same line known in a window that holds the cut. Joined, save[2026-03] is 950.00; unjoined, two rows fulfil it (RUN-RECORD): the read is HOLE-IMPRECISE naming both rows and the version (fl), and windows each prints the refusal before the line is known, 950.00 after (fl_each); a read on which joined and unjoined agree answers (agree)"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place unexplained: outside lives 1900-01-01..
input bank: observed
input amt: money PLN
input d15: int

move save[m in months]: transfers
  on day_of(m, d15)
  leg cash from konto to sav amount amt

version v
  cite s
  governs always
  known 2026-01-01
  amt = 900.00 PLN "s"
  d15 = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"

version st_konto
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[a2] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "a"

version st_sav
  cite s
  governs 2026-03
  known 2026-04-03
  covers sav
  bank[b1] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "b"

version joined
  cite s
  governs 2026-03
  known window(2026-04-05, 2026-04-15)
  same bank[a2] = bank[b1]

ask fl: flows(save, 2026-03) as known 2026-04-10
ask fl_each: flows(save, 2026-03) as known 2026-04-10 windows each
ask agree: bal(konto, 2026-03-31) as known 2026-04-10
