model pi
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "T, M2 G6's last part (BUILD-LOG's fourth turn; tmp/m2/review-g6b.md): B1, a calendar stated same, only the other side has a row, windows each (L 6.1, 4.4)"

source card "invented"
input cal: calendar
input cal2: calendar
input d1: date

ask q: add_business(d1, 1, cal) windows each
ask q2: add_business(d1, 1, cal)

version v
  cite card
  governs always
  known 2026-01-01
  d1 = 2026-05-29 "c"
  cal2 = calendar(weekends [sat, sun], added [window(2026-06-01, 2026-06-02)]) "c"

version sm
  cite card
  known 2026-01-02
  same cal = cal2
