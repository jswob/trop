model p
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31
  note "T, M2 G6's last part (BUILD-LOG's fourth turn; tmp/m2/review-g6b.md): B2, a window read through a same row keeps its name (L 4.4)"

source s "s"
input a: date
input b: date

ask q1: a == a
ask q2: a windows each
ask q3: b == b

version v
  cite s
  governs always
  known 2026-01-01
  a = window(2026-03-01, 2026-03-03) "s"

version sm
  cite s
  known 2026-01-02
  same a = b
