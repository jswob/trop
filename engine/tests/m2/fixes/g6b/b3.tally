model p
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31
  note "T, M2 G6's last part (BUILD-LOG's fourth turn; tmp/m2/review-g6b.md): B3, a removal known in a window that holds the cut (L 4.4, 4.5)"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"

version st
  cite s
  governs 2026-03
  known 2026-04-01
  covers konto
  bank[r1] = (on: 2026-03-10, kind: transfers, leg cash from world to konto amount 12.00 PLN) "r1"

version fx
  cite s
  governs 2026-03
  known window(2026-04-05, 2026-04-20)
  replace bank[r1] = none "r1"

ask q: bal(konto, 2026-03-31) as known 2026-04-10
ask q2: bal(konto, 2026-03-31) as known 2026-04-10 windows each
ask q3: bal(konto, 2026-03-31) as known 2026-04-21
ask q4: bal(konto, 2026-03-31) as known 2026-04-04
