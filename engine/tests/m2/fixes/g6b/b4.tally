model p
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31
  note "T, M2 G6's last part (BUILD-LOG's fourth turn; tmp/m2/review-g6b.md): B4, a version's same line read at a cut before the version is known (L 4.5)"

source s "s"
input x: int
input y: int

version v
  cite s
  governs always
  known 2026-01-01
  x = 3 "s"
  y = 4 "s"

ask q1: x as known 2026-01-01
ask q2: x
ask q3: y as known 2026-03-01

version sm
  cite s
  governs always
  known 2026-03-02
  same x = y
