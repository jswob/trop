model pd
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "T, M2 G6's last part (BUILD-LOG's fourth turn; tmp/m2/review-g6b.md): a def's given row holding a window literal, pinned and copied (G6's pd3; q2, q6 P30)"

source card "invented"
unit PLN: currency minor 0.01

input x: date
input y: date

def dd: date
  rule base = y

def ee: date
  rule base = dd

ask q4: dd
ask q5: dd == ee
version v
  cite card
  governs always
  known 2026-01-01
  x = 2026-01-05 "c"
  y = window(2026-01-01, 2026-01-02) "c"
  given dd = window(2026-01-01, 2026-01-02) "g"
