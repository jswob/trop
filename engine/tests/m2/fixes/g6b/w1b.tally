model px
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "T, M2 G6's last part (BUILD-LOG's fourth turn; tmp/m2/review-g6b.md): a keyed windows each line under an axis binds inside each run (G6's w1b; q5 P29)"

source card "invented"
unit PLN: currency minor 0.01

axis ax
  lo "low"
  hi "high"

index kk = [a, b, c]
input d[k in kk]: date
input e[k in kk]: date
input amt: money PLN

def a2: money PLN
  rule base = amt
  rule hi beats base = amt + amt when ax == hi

ask q4: a2 for k in kk
version v
  cite card
  governs always
  known 2026-01-01
  amt = 10.00 PLN "c"
  d[a] = window(2026-03-01, 2026-03-02) "c"
  d[b] = 2026-01-01 "c"
  d[c] = 2026-01-01 "c"
  e[a] = 2026-01-01 "c"
  e[b] = window(2026-03-01, 2026-03-02) "c"
  e[c] = 2026-01-01 "c"
