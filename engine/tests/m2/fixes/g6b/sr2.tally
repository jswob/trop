model p
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31
  note "T, M2 G6's last part (BUILD-LOG's fourth turn; tmp/m2/review-g6b.md): rows stated same that agree and that disagree, read by a key binding and by explain (review's sr2; q7 B4)"

source s "s"
unit PLN: currency minor 0.01
index ks = [a, e]
input x[k in ks]: int
input y[k in ks]: int
input r[m in months]: money PLN
input t[m in months]: money PLN

version v
  cite s
  governs always
  known 2026-01-01
  x[a] = 1 "s"
  y[a] = 1 "s"
  x[e] = 3 "s"
  y[e] = 4 "s"
  r[2026-03] = 10.00 PLN "s"
  t[2026-03] = 12.00 PLN "s"
  r[2026-04] = 7.00 PLN "s"
  t[2026-04] = 7.00 PLN "s"

ask q1: x[k] + 1 for k in ks
ask q2: y[k] for k in ks
ask q3: x[k] == y[k] for k in ks
ask q4: explain x[a]
ask q5: explain x[e]
ask q6: explain y[e]
ask q7: x[e] as known 2026-01-01
ask q8: r[m] for m in months where m == 2026-03 or m == 2026-04
ask q9: explain t[2026-03] law 2026-03-15
ask q10: explain r[2026-04] law 2026-04-15
ask q11: x[e] == y[e]

version sm
  cite s
  known 2026-01-02
  same x[a] = y[a]
  same x[e] = y[e]
  same r[2026-03] = t[2026-03]
  same r[2026-04] = t[2026-04]
