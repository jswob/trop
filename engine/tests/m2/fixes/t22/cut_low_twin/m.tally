model g5_low_min
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.2 (#211, G5, S-9): cut_low's twin: the min over days it means, the clause on the bal read."

source card "T's card (invented)"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input rent: money PLN

input pay: money PLN

input d_feb: date

input d_mar: date

input d_pay: date

move rent_feb: transfers
  on d_feb
  leg cash from konto to world amount rent

move rent_mar: transfers
  on d_mar
  leg cash from konto to world amount rent

move pay_mar: transfers
  on d_pay
  leg cash from world to konto amount pay

version v_card
  cite card
  governs always
  known 2026-01-01
  rent = 40.00 PLN "the card"
  pay = 100.00 PLN "the card"
  d_feb = 2026-02-05 "the card"
  d_mar = 2026-03-05 "the card"
  d_pay = 2026-03-20 "the card"
  opening[konto] = 500.00 PLN at 2026-01-01 start "the card"

ask q: min(bal(konto, d) from 2026-02-01 for d in 2026-02-01 .. 2026-04-30 step 1 day)
