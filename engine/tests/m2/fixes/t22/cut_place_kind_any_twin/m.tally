model kind_one
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.2 (#211, G2, S-1): cut_place_kind_any's stated twin: one place per unit under a kind of unit one; the value is the sum over them (850.00 + 300.00 PLN)."

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind safes: place one signed
place safe_eur: safes EUR lives 2026-01-01..
place safe_pln: safes PLN lives 2026-01-01..
place market: outside lives 1900-01-01..
input amt_eur: money EUR
input amt_pln: money PLN
input fx: num PLN/EUR
input d1: date

move put_eur: transfers
  on d1
  leg cash from market to safe_eur amount amt_eur

move put_pln: transfers
  on d1
  leg cash from market to safe_pln amount amt_pln

version v
  cite s
  governs always
  known 2026-01-01
  amt_eur = 200.00 EUR "s"
  amt_pln = 300.00 PLN "s"
  fx = 4.25 PLN/EUR "s"
  d1 = 2026-02-20 "s"

ask q: (value(safe_eur, 2026-03-31) in PLN by fx) + (value(safe_pln, 2026-03-31) in PLN by fx)
