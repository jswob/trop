model fx3p
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.2 G1 (#211, plan §3): fx3's def keyed by a movement under paths, the movement's amount random (a bonus of 0 or 1 times amt[work], binomial at one half): the paths' shared cell of in_pln[t] reads the same graph as the axes and the pins, so by_helper splits by work and by path as by_inline does. pm: the means over 40 paths, per work; p3: path 3 replayed."

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
axis work
  yes "in work"
  no "not in work"
place wallet: accounts EUR lives 2025-01-01..
place world: outside lives 1900-01-01..
input fx: num PLN/EUR
input d1: date
input amt[w in work]: money EUR
input mo: month
input p_bonus: num

def bonus: dist = binomial(1, p_bonus) at reader

def pay: money EUR at reader
  rule base = round(amt[work] * (1 + bonus), minor(EUR), half-up)

move in1: transfers
  on d1
  at d1
  leg cash from world to wallet amount pay

def in_pln[t in transfers]: money PLN = round(t.cash.amount * fx, minor(PLN), half-up) at t.day

def by_inline: money PLN at reader
  rule base = sum(round(t.cash.amount * fx, minor(PLN), half-up) for t in transfers over mo where t.cash.to == wallet)
def by_helper: money PLN at reader
  rule base = sum(in_pln[t] for t in transfers over mo where t.cash.to == wallet)

version v
  cite s
  governs always
  known 2025-12-01
  d1 = 2026-03-05 "s"
  amt[yes] = 100.00 EUR "s"
  amt[no] = 300.00 EUR "s"
  mo = 2026-03 "s"
  fx = 4.0 "s"
  p_bonus = 0.5 "s"
  opening[wallet] = 0.00 EUR at 2026-01-01 start "s"

ask pm: mean(by_helper), mean(by_inline) law 2026-06-01 paths 40 seed 11
ask p3: by_helper, by_inline law 2026-06-01 paths 40 seed 11 path 3
ask pw: mean(by_helper), mean(by_inline) with work = yes law 2026-06-01 paths 40 seed 11
