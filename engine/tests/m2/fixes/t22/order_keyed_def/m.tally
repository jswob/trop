model fxorder
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.2 G1 (#211, pick P11, G1's review): two decisions on one day read one place, and b reads a def keyed by a movement. With the fault's fix the def's key records its edge to the movements, so load orders a, then b, and both answer (2.1.8: RUN-ORDER decisions a and b read each other); readers-of a gains the def (classes S-7/d, S-7/e)."

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
axis work
  yes "in work"
  no "not in work"
place wallet: accounts EUR lives 2025-01-01..
place world: outside lives 1900-01-01..
input fx: num PLN/EUR
input d1: date
input amt[w in work]: money EUR
input mo: month

def pay: money EUR at reader
  rule base = amt[work]

move in1: transfers
  on d1
  at d1
  leg cash from world to wallet amount pay

def in_pln[t in transfers]: money PLN = round(t.cash.amount * fx, minor(PLN), half-up) at t.day

def by_inline: money PLN at reader
  rule base = sum(round(t.cash.amount * fx, minor(PLN), half-up) for t in transfers over mo where t.cash.to == wallet)
def by_helper: money PLN at reader
  rule base = sum(in_pln[t] for t in transfers over mo where t.cash.to == wallet)

move a: transfers
  on add_days(d1, 1)
  at d1
  reads wallet
  leg cash from wallet to world amount bal(wallet)

move b: transfers
  on add_days(d1, 1)
  at d1
  reads wallet
  leg cash from world to wallet amount max(bal(wallet), round(in_pln[in1] / fx, minor(EUR), half-up))

version v
  cite s
  governs always
  known 2025-12-01
  d1 = 2026-03-05 "s"
  amt[yes] = 100.00 EUR "s"
  amt[no] = 300.00 EUR "s"
  mo = 2026-03 "s"
  fx = 4.0 "s"
  opening[wallet] = 0.00 EUR at 2026-01-01 start "s"

ask f: bal(wallet, 2026-03-31) law 2026-06-01
ask ra: readers-of a
