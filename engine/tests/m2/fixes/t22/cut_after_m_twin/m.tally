model rec
  tally 2
  on 2026-04-10
  start 2026-01-01
  end 2026-12-31
  note "codes/m2's records family (T, M2 C6): a covered month of two places, konto and sav, each with its own statement; one transfer between them on both, stated same and fulfilling its decision's instance; a reading of konto after a decision the statement fulfils. Each fixture is one edit: a link that names no instance's turn (RUN-RECORD), a same row that doesn't exist, the two rows unjoined, the two disagreeing (HOLE-SAME); tally 2.2 (S-3): its reading after m is stated at the end of the day m stands on, m being the last movement there, so every answer is as before"

source s "synthetic"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place sav: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input bank: observed

input keep: money PLN

input amt: money PLN

input d_save: int

input d_top: int

move pay[m in months]: transfers
  on start_of(m)
  leg cash from world to konto amount amt

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

move top[m in months]: transfers
  on day_of(m, d_top)
  reads konto
  leg cash from world to konto amount max(0 PLN, keep - bal(konto))

ask q_konto: bal(konto, 2026-03-31)

ask q_sav: bal(sav, 2026-03-31)

ask q_moved: sum(t.cash.amount for t in transfers over 2026-03)

ask q_save: flows(save, 2026-03-01 .. 2026-03-31)

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  amt = 1000.00 PLN "s"
  d_save = 15 "s"
  d_top = 20 "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  opening[sav] = 0.00 PLN at 2026-01-01 start "s"

version st_konto
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  anchor konto
  bank[a1] = (on: 2026-03-01, kind: transfers, leg cash from world to konto amount 1000.00 PLN, fulfils: pay[2026-03]) "PENSJA"
  bank[a2] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "NA OSZCZEDNOSCI"
  bank[a3] = (on: 2026-03-20, kind: transfers, leg cash from world to konto amount 50.00 PLN, fulfils: top[2026-03]) "DOPLATA"
  stated[konto] = 200.00 PLN at 2026-03-20 end "saldo"

version st_sav
  cite s
  governs 2026-03
  known 2026-04-03
  covers sav
  anchor sav
  bank[b1] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "Z KONTA"
  same bank[a2] = bank[b1]
