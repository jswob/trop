model pw
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
  note "G4 review, agent's B1: two decisions dated by overlapping windows, an anchor after the first's end."

source s "s"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input d1: date

input d2: date

input amt: money PLN

move dec1: transfers
  on d1
  reads konto
  leg cash from konto to world amount min(amt, bal(konto))

move dec2: transfers
  on d2
  reads konto
  leg cash from konto to world amount min(amt, bal(konto))

version v
  cite s
  governs always
  known 2026-01-01
  amt = 10.00 PLN "s"
  d1 = window(2026-03-05, 2026-03-07) "s"
  d2 = window(2026-03-06, 2026-03-12) "s"
  opening[konto] = 1000.00 PLN at 2026-03-01 start "s"
  opening[konto] = 990.00 PLN at 2026-03-09 start "s"

ask q: bal(konto, 2026-03-10) with d1 = 2026-03-07
