model g4_each_read
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.2 (#211, G4, S-4): the cut clause windows each on a projection read; cut_each_read_twin is its twin."

source card "T's card (invented)"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input pay: money PLN

input w: date

move pay_w: transfers
  on w
  leg cash from world to konto amount pay

version v_card
  cite card
  governs always
  known 2026-01-01
  pay = 100.00 PLN "the card"
  w = window(2026-03-05, 2026-03-07) "the card"
  opening[konto] = 500.00 PLN at 2026-01-01 start "the card"

ask q: bal(konto, 2026-03-06) from 2026-01-01 windows each
