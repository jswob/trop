model g22_min_step_week
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.2 (S-9, C-10 (a), the review of the builder's closing turn): a min over bal stepped by 7 days is the least of the stepped days, not the span's lowest balance; konto is lowest on 2026-03-03 (100.00 PLN), a day the step skips, so w7 is 800.00 PLN where d1 (step 1 day, the recognised shape) is 100.00 PLN"

source card "T's card (invented)"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input out_day: date

input back_day: date

input fee_day: date

input dip_amt: money PLN

input fee_amt: money PLN

move dip: transfers
  on out_day
  leg cash from konto to world amount dip_amt

move back: transfers
  on back_day
  leg cash from world to konto amount dip_amt

move fee: transfers
  on fee_day
  leg cash from konto to world amount fee_amt

version v_card
  cite card
  governs always
  known 2026-01-01
  out_day = 2026-03-03 "the card"
  back_day = 2026-03-04 "the card"
  fee_day = 2026-03-10 "the card"
  dip_amt = 900.00 PLN "the card"
  fee_amt = 200.00 PLN "the card"
  opening[konto] = 1000.00 PLN at 2026-01-01 start "the card"

ask w7: min(bal(konto, d) from 2026-03-01 for d in 2026-03-01 .. 2026-03-31 step 7 day)

ask d1: min(bal(konto, d) from 2026-03-01 for d in 2026-03-01 .. 2026-03-31 step 1 day)

ask w7_days: bal(konto, d) from 2026-03-01 for d in 2026-03-01 .. 2026-03-31 step 7 day
