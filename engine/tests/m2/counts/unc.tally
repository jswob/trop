model days_c
  tally 2
  on 2026-04-15
  start 2026-01-01
  end 2026-12-31
  note "T, M3 C6 (pick P26; the G3 rows of walk/fork.rs): days_c.tally's model, its projection reads taken with uncertain, so each goes through the projection's walk (fence F6), not F5's tree: a read day by day across a month's end (u1), one read twice through a day (u2), four projections across a month's end (u3f), the sweep's room read with uncertain (um), and one read on rising days across two month ends (u4: each later day past the parked walk's plan, which a new plan pass continues); an uncertain gift into konto so the clause adds a movement"

source card "invented for F6's twin"

unit DUK: currency minor 0.01

axis pay_reading
  low "the lower pay"
  high "the higher pay"


kind gifts: event uncertain
  leg cash: DUK

index month = month 2026-01..2026-12

place konto: accounts DUK lives 2026-01-01..

place world: outside lives 2026-01-01..

input pay_low: money DUK

input pay_high: money DUK

input rent: money DUK

input floor: money DUK

input share: num

input late: int

input rent_off: int

input reach: int

def pay: money DUK at reader
  rule base = pay_low
  rule hi beats base = pay_high when pay_reading == high

def room_u[m in month]: money DUK = min(bal(konto, d) from start_of(m) with uncertain for d in start_of(m) .. add_days(start_of(m), reach) step 1 day) at start_of(m)

move salary[m in month]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from world to konto amount pay

move rent_pay[m in month]: transfers
  on add_days(start_of(m), rent_off)
  at start_of(m)
  leg cash from konto to world amount rent

move sweep_u[m in month]: transfers
  on add_days(start_of(m), late)
  at start_of(m)
  reads konto
  leg cash from konto to world amount round(max(0, room_u[m] - floor) * share, minor(DUK), down)

move gift[m in month]: gifts
  on add_days(start_of(m), rent_off)
  at start_of(m)
  leg cash from world to konto amount rent

ask u1: min(bal(konto, d) from 2026-02-01 with uncertain for d in 2026-02-01 .. 2026-03-15 step 1 day where d >= 2026-02-01)
ask u2: bal(konto, d) from 2026-02-03 with uncertain for d in [2026-03-10, 2026-02-20, 2026-03-31, 2026-03-31, 2026-02-03]
ask u3f: min(bal(konto, d) from 2026-02-01 with uncertain + bal(konto, d) from 2026-02-02 with uncertain + bal(konto, d) from 2026-02-03 with uncertain + bal(konto, d) from 2026-02-04 with uncertain for d in 2026-02-20 .. 2026-03-10 step 1 day)
ask um: room_u[m] for m in [2026-02, 2026-03, 2026-07]
ask u4: bal(konto, d) from 2026-02-03 with uncertain for d in [2026-02-20, 2026-03-10, 2026-04-20]

version v
  cite card
  governs always
  known 2026-01-01
  pay_low = 1000.00
  pay_high = 1300.00
  rent = 900.00
  floor = 200.00
  share = 0.5
  late = 25
  rent_off = 9
  reach = 15
  opening[konto] = 500.00 at 2026-01-01 start

version later
  cite card
  governs 2026-05-01..
  known 2026-03-01
  replace rent = 950.00 "the rent rose"
