model r4
  tally 2
  on 2026-04-15
  start 2026-01-01
  end 2026-12-31
  note "T, M2 gate 8 run 43749994847 on 205157a2, the fence's counts (builder's R4, R7): a decision due on two days a month apart reads one projection from a fixed earlier day, a place first booked between the two runs; legs whose amount is a hole or refused on days a kept walk walked"

source card "invented for F6's counts"

unit DUK: currency minor 0.01

index month = month 2026-01..2026-12

place konto: accounts DUK lives 2026-01-01..

place jar: accounts DUK lives 2026-01-01..

place world: outside lives 2026-01-01..

input pay: money DUK

input rent: money DUK

input floor: money DUK

input share: num

input reach: int

input dec_off: int

input dec_from: date

input dec_last: date

input jar_day: date

input tip: money DUK

move salary[m in month]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from world to konto amount pay

move rent_pay[m in month]: transfers
  on add_days(start_of(m), dec_off)
  at start_of(m)
  leg cash from konto to world amount rent

move stock: transfers
  on jar_day
  at jar_day
  leg cash from world to jar amount rent

move dec[m in month]: transfers
  on add_days(start_of(m), dec_off)
  at start_of(m)
  when start_of(m) < dec_last
  reads konto
  leg cash from konto to world amount round(max(0, bal(konto, add_days(start_of(m), reach)) from dec_from - floor) * share, minor(DUK), down)

move tips[m in month]: transfers
  on add_days(start_of(m), reach)
  at start_of(m)
  leg cash from world to konto amount tip

move neg[m in month]: transfers
  on add_days(start_of(m), reach)
  at start_of(m)
  leg cash from jar to world amount rent - pay

ask r4: bal(konto, 2026-03-31)
ask r4j: bal(jar, 2026-03-31)
ask r7: min(bal(konto, d) from 2026-02-01 for d in 2026-02-01 .. 2026-03-15 step 1 day)

version v
  cite card
  governs always
  known 2026-01-01
  pay = 1000.00
  rent = 300.00
  floor = 200.00
  share = 0.5
  reach = 20
  dec_off = 14
  dec_from = 2026-01-10
  dec_last = 2026-03-01
  jar_day = 2026-02-01
  tip = ?"the tip, not yet known"
  opening[konto] = 500.00 at 2026-01-01 start
  opening[jar] = 0.00 at 2026-01-01 start
