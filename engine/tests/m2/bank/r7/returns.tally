part r7_returns
  tally 2
  note "T, M2 (issues #167, #114): the yearly PIT-37 returns of R7. The prototype files one joint return (04-employment.json pit_joint: pit_return@2022 over my_tax and wife_tax); L-26 (art. 6 ust. 8 PIT) bars it beside the ryczałt of 05-side-business, so each spouse files alone (goldens.md: the joint-return pins move by L-26; M1's P7): pit_return@2022 with b empty, tax = zl(max(0, brackets(p.pit.scale, base_a) - p.pit.reduction)), base_a = zl(max(0, the year's income)), due = tax - the year's advances, paid next_year:04-30 bd next, a refund back to konto."

source prototype_ret "the prototype's block 04-employment.json, template pit_return@2022 (engine/spec/verification/blocks)"

kind settles: event certain
  leg pay: PLN
  leg refund: PLN

input return_day: int

input return_month: int

def pit_income[j in job, y in cal_year]: num PLN = sum(gross[j, m] - kup_month - emp_zus[j, m] for m in month where year_of(m) == y) at start_of(y)
  note "employment_pl@2022 income: gross - costs of earning - social contributions, summed over the year"

def pit_due[j in job, y in cal_year]: money PLN = round(max(0, pit_scale(round(max(0, pit_income[j, y]), 1, half-up))), 1, half-up) - sum(emp_pit_adv[j, m] for m in month where year_of(m) == y) at start_of(y)
  note "pit_return@2022 due: v('tax') - v('advances'); pit_scale already takes the reducing amount off"

move pit_return[y in cal_year, j in job on end_of(y)]: settles
  on schedule(month_of(add_months(add_years(start_of(y), 1), return_month - 1)), return_day, following, holidays_pl)
  at start_of(y)
  for y
  leg pay from konto to urzad_skarbowy amount max(0, pit_due[j, y])
  leg refund from urzad_skarbowy to konto amount max(0, -pit_due[j, y])

version returns_2022
  cite prototype_ret
  governs always
  known 2023-12-31
  return_month = 4 "pit_return@2022 due: next_year:04-30, bd next"
  return_day = 30 "next_year:04-30"
