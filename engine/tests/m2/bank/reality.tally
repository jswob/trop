model tropek_bank
  tally 2
  on 2026-10-17
  start 2024-01-01
  end 2027-01-31
  note "T, M2 (issues #167, #114), DONE gate 2: the bank half of the prototype's reality R7 (engine/spec/verification/goldens.md: G2, G4, G5), restated over the prototype's bank history (ledger.json, synthetic, seed 20261017; records/, written by to_tally.py). Its plan is the part of blocks 01-month and 04-employment the ledger's links reach: my pay (my_job, 12 000 gross), my wife's (wife_job, 7 000 gross), each paid in the month after the month it earns, and the rent of 3 200 on the 1st. Everything else in the ledger is an observed movement the plan doesn't hold, with its category."
  note "The pay law is the prototype's employment_pl@2022 as household X writes it (integration/amendments/real11/c1/law/pl/employment.tally) and m1/goldens/y22/model.tally restates it: ZUS, health on the rest, the advance on the running base to whole zloty less a twelfth of the reducing amount. Not stated: ZUS's 30-fold cap, which 144 000 a year doesn't reach; child relief, residence and the return, which no asked figure reads. The prototype ran its 2026 law over its whole past (make-ledger.ts: one run of the model), so the rows here govern from 2024."
  note "The forward half of R7 (the 15th rule, IKE first, the side business, OKI, Marek's claim; G1, G3, G6's and G10's net worth, the pins) is not here: T's hand-off for #114."

source ledger "the prototype's bank history, engine/tests/m2/bank/ledger.json, made by make-ledger.ts (seed 20261017); synthetic"

source prototype "the prototype's blocks 01-month.json and 04-employment.json and its template employment_pl@2022 (engine/spec/verification/blocks)"

unit PLN: currency minor 0.01

kind bank_line: transfers
  attr cat: key category
  note "a row of the prototype's ledger, with its category"

kind job

kind person

index category = [codzienne, czynsz, faktury, inne, inwestycje, pit_firma, pit_roczny, skladki_zus, vat, wynagrodzenie]

index month = month 2024-01..2026-12

index zus_part = [pension, disability, sickness]

place dostawcy: outside lives 2024-01-01..

place ike: accounts PLN lives 2024-01-01..

place klienci: outside lives 2024-01-01..

place konto: accounts PLN lives 2024-01-01..

place maklerskie: accounts PLN lives 2024-01-01..

place pracodawca: outside lives 2024-01-01..

place pracodawca_zony: outside lives 2024-01-01..

place sklepy: outside lives 2024-01-01..

place urzad_skarbowy: outside lives 2024-01-01..

place wynajmujacy: outside lives 2024-01-01..

place zus: outside lives 2024-01-01..

input bank: observed
  note "the ledger's rows, one part a month (records/)"

input ee_rate[z in zus_part]: num

input health_rate: num

input kup_month: money PLN

input learn_first: date

input learn_last: date

input pay_dom[j in job]: int

input pit_reduction_month: money PLN

input prices: num

input rent: money PLN

input salary[j in job, m in month]: money PLN

band pit_scale(x: num PLN): num PLN
  note "art. 27 ust. 1: the tax before reliefs, after the reducing amount"

def emp_zus[j in job, m in month]: money PLN = round(salary[j, m] * ee_rate[pension], minor(PLN), half-up) + round(salary[j, m] * ee_rate[disability], minor(PLN), half-up) + round(salary[j, m] * ee_rate[sickness], minor(PLN), half-up) at start_of(m)

def emp_health[j in job, m in month]: money PLN = round((salary[j, m] - emp_zus[j, m]) * health_rate, minor(PLN), half-up) at start_of(m)

def emp_pit_base[j in job, m in month]: money PLN = round(max(0, salary[j, m] - emp_zus[j, m] - kup_month), 1, half-up) at start_of(m)

def emp_cum[j in job, m in month]: money PLN = sum(emp_pit_base[j, k] for k in month where year_of(k) == year_of(m) and k <= m) at start_of(m)

def emp_pit_adv[j in job, m in month]: money PLN = max(0, round(pit_scale(emp_cum[j, m]) - pit_scale(emp_cum[j, m] - emp_pit_base[j, m]) - pit_reduction_month, 1, half-up)) at start_of(m)
  note "art. 32: the advance on the running base, less a twelfth of the reducing amount, to whole zloty"

def emp_net[j in job, m in month]: money PLN = salary[j, m] - emp_zus[j, m] - emp_health[j, m] - emp_pit_adv[j, m] at start_of(m)

def spend_daily: money PLN at learn_last
  note "01-month.json: spending is hist_daily(codzienne, 365) * index.prices, the average daily spending of the last 365 days of the bank history, following prices (G5)"
  rule learned = round(sum(o.cash.amount for o in bank_line over learn_first .. learn_last where o.cat == codzienne) / (days_between(learn_first, learn_last) + 1) * prices, minor(PLN), half-up) when covered(konto, learn_first .. learn_last)

move my_pay[m in month]: transfers
  on add_months(day_of(m, pay_dom[my_job]), 1)
  at start_of(m)
  for m
  leg cash from pracodawca to konto amount emp_net[my_job, m]

move rent_pay[m in month]: transfers
  on day_of(m, 1)
  at start_of(m)
  for m
  leg cash from konto to wynajmujacy amount rent

move wife_pay[m in month]: transfers
  on add_months(day_of(m, pay_dom[wife_job]), 1)
  at start_of(m)
  for m
  leg cash from pracodawca_zony to konto amount emp_net[wife_job, m]

version household
  cite prototype
  governs always
  known 2023-12-31
  person + [me] lives 1991-02-14..
  person + [wife] lives 1992-07-03..
  job + [my_job] lives 2024-01-01..
  job + [wife_job] lives 2024-01-01..
  salary[my_job] = 12000 "01-month.json: my_job, person me, gross 12 000 (index.wage 1 until 2027)"
  salary[wife_job] = 7000 "04-employment.json: wife_job, person wife, gross 7 000"
  pay_dom[my_job] = 5 "01-month.json: my pay between the 3rd and the 7th of the next month; the 5th, the window's middle"
  pay_dom[wife_job] = 10 "04-employment.json: the wife's pay about the 10th of the next month"
  rent = 3200 "01-month.json: rent 3 200 on the 1st"
  learn_first = 2025-10-17 "01-month.json: hist_daily(codzienne, 365), the 365 days before today (2026-10-17)"
  learn_last = 2026-10-16 "the last of those days, the day before today"
  prices = 1 "01-month.json: index.prices is 1 until 2027-01-01, flat over the learning window (G5)"

version openings
  cite ledger
  governs always
  known 2024-01-01
  opening[ike] = 30000 at 2024-01-01 start "ledger.json row 1, otwarcie"
  opening[konto] = 12000 at 2024-01-01 start "ledger.json row 0, otwarcie"
  opening[maklerskie] = 20000 at 2024-01-01 start "ledger.json row 2, otwarcie"

version employment_pl
  cite prototype
  governs always
  known 2023-12-31
  ee_rate[disability] = 0.015 "employment_pl@2022: the employee's disability share"
  ee_rate[pension] = 0.0976 "employment_pl@2022: the employee's pension share"
  ee_rate[sickness] = 0.0245 "employment_pl@2022: sickness"
  health_rate = 0.09 "employment_pl@2022: health, 9 %"
  kup_month = 250 "employment_pl@2022: costs of earning, 250 a month"
  pit_reduction_month = 300 "employment_pl@2022: a twelfth of 3 600"
  pit_scale: [0, 120000] = x * 0.12 - 3600 "employment_pl@2022: art. 27 ust. 1, first threshold"
  pit_scale: (120000, inf) = 10800 + (x - 120000) * 0.32 "employment_pl@2022: art. 27 ust. 1, second threshold"

ask g2_konto: bal(konto, d) for d in [2026-10-15, 2026-10-16]

ask g4_by_cat: residuals konto 2025-11 .. 2026-01 by cat

ask g4_my_pay: residuals pracodawca 2024-01 .. 2026-10

ask g4_pay: emp_net[j, m] for j in job over .., m in [2024-12, 2025-11, 2025-12]

ask g4_rent: residuals wynajmujacy 2024-01 .. 2026-10

ask g4_wife_pay: residuals pracodawca_zony 2024-01 .. 2026-10

ask g5_spend: spend_daily
