source s "s"
unit PLN: currency minor 0.01
kind savings: place PLN min 0
place konto: accounts PLN lives 2026-01-01..
place sav: savings lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input keep: money PLN
input d_save: int

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"


version st
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[o1] = (on: 2026-03-14, kind: transfers, leg cash from konto to sav amount 500.00 PLN, fulfils: save[2026-03]) "o1"
  bank[o2] = (on: 2026-03-16, kind: transfers, leg cash from sav to world amount 20.00 PLN, fulfils: save[2026-03]) "o2"

version rd
  cite s
  governs 2026-03..2026-04
  known 2026-04-04
  pad konto from world
  stated[konto] = 90.00 PLN after save[2026-03] "saldo"

ask l13: last(stated[konto], 2026-03-13)
ask l14: last(stated[konto], 2026-03-14)
ask l15: last(stated[konto], 2026-03-15)
ask l16: last(stated[konto], 2026-03-16)
ask l31: last(stated[konto], 2026-03-31)
ask ls: last(stated[sav], 2026-03-31)
,,1:0,308:l14: 90.00 PLN
  cut 2026-04-10
l15: 90.00 PLN
  held: stated[konto] = 90.00 PLN (rd), read for 2026-03-15
  cut 2026-04-10
l16: 90.00 PLN
  held: stated[konto] = 90.00 PLN (rd), read for 2026-03-16
  cut 2026-04-10
l31: 90.00 PLN
  held: stated[konto] = 90.00 PLN (rd), read for 2026-03-31
  cut 2026-04-10
,29:spec/gate8/r437_after_m_start,10:spec-sweep,49:run after_m_start.tally --ask l01 l02 l06 b02 b15,1575:19:after_m_start.tally,1546:model t
