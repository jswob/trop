  governs 2026-04-01..
  known 2026-01-01
  rate = 12.00 PLN "c"
,,1:0,192:lw [ax = *]: 0.00 PLN
  held: rate = 12.00 PLN (r2), read for 2026-04-01
  held: rate = 12.00 PLN (r2), read for 2026-04-02
  held: rate = 12.00 PLN (r2), read for 2026-04-03
  cut 2026-03-01
