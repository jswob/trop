  covers konto
  bank[o1] = (on: 2026-03-10, kind: transfers, leg cash from konto to sav amount 10.00 PLN, fulfils: sw[2026-03]) "o1"

version rd
  cite s
  governs 2026-03
  known 2026-04-03
  anchor konto
  stated[konto] = 70.00 PLN after sw[2026-03] "saldo"
