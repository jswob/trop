,15:spec/g4/nb3_atT,12:spec-records,17:run nb3_atT.tally,1375:13:nb3_atT.tally,1352:model nb3
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "synthetic"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
input bank: observed
input d_sw: int
input amt: money PLN
input lim: money PLN

move sw[m in months]: transfers
  on day_of(m, d_sw)
  reads konto
  when last(stated[konto], start_of(m)) < lim
  leg cash from konto to sav amount amt + bal(konto) * 0

ask q_sw: flows(sw, 2026-01-01 .. 2026-04-30)
ask q_konto: bal(konto, 2026-04-30)
ask q_obs: observed(sw[2026-03]).cash.amount
ask q_last: last(stated[konto], 2026-03-31)
ask q_led: residuals konto 2026-03

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 100.00 PLN at 2026-01-01 start "own"
  opening[sav] = 0.00 PLN at 2026-01-01 start "own"
  d_sw = 10 "plan"
  amt = 10.00 PLN "plan"
  lim = 1000.00 PLN "plan"

version rd0
  cite s
  governs 2026-01
  known 2026-01-02
  anchor konto
  stated[konto] = 100.00 PLN at 2026-01-01 end "saldo"

version st
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[o1] = (on: 2026-03-10, kind: transfers, leg cash from konto to sav amount 10.00 PLN, fulfils: sw[2026-03]) "o1"

version rd
  cite s
  governs 2026-03
  known 2026-04-03
  anchor konto
  stated[konto] = 70.00 PLN at 2026-03-10 end "saldo"
