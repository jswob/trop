  known 2026-01-01
  opening[konto] = 100.00 PLN at 2026-01-01 start "own"
  opening[sav] = 0.00 PLN at 2026-01-01 start "own"
  d_sw = 10 "plan"
  amt = 10.00 PLN "plan"
  lim = 0.00 PLN "plan"

version rd0
  cite s
  governs 2026-01
