source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place unexplained: outside lives 1900-01-01..
input bank: observed
input keep: money PLN
input d_save: int

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

ask q_save: flows(save, 2026-03-01 .. 2026-03-31)
ask q_obs: observed(save[2026-03]).cash.amount
ask q_sav: bal(sav, 2026-03-31)
ask q_konto: bal(konto, 2026-03-31)
ask q_moved: sum(t.cash.amount for t in transfers over 2026-03)
ask q_n: count(t in transfers over 2026-03)
ask q_flk: flows(konto, 2026-03-01 .. 2026-03-31)
ask q_led: residuals konto 2026-03

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"

ask b13: bal(konto, 2026-03-13)
ask b14: bal(konto, 2026-03-14)
ask b15: bal(konto, 2026-03-15)
ask b16: bal(konto, 2026-03-16)
ask pd: sum(p.cash.amount for p in pads over 2026-03)
ask un: bal(unexplained, 2026-03-31)
ask e15: explain bal(konto, 2026-03-15)

version st_konto
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[a2] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "a"

version st_sav
  cite s
  governs 2026-03
  known 2026-04-03
  covers sav
  bank[b1] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "b"
  same bank[a2] = bank[b1]

version rd
  cite s
  governs 2026-03..2026-04
  known 2026-04-04
  pad konto from unexplained
  stated[konto] = 90.00 PLN after save[2026-03] "saldo"
,,1:0,1285:q_konto: 90.00 PLN
  pad: konto after save[2026-03], pads:rd:konto@after save[2026-03] of -10.00 PLN
  cut 2026-04-10
q_flk: -960.00 PLN
  pad: konto after save[2026-03], pads:rd:konto@after save[2026-03] of -10.00 PLN
  cut 2026-04-10
q_led: residuals konto 2026-03
  2026-03 balance: model 100.00 PLN, observed 90.00 PLN, difference -10.00 PLN
    balance konto after save[2026-03] (padded): booked 100.00 PLN, stated 90.00 PLN, gap -10.00 PLN
  2026-03 move save: model -950.00 PLN, observed -950.00 PLN, difference 0.00 PLN
    matched save[2026-03] on 2026-03-15: model -950.00 PLN, observed -950.00 PLN, difference 0.00 PLN, timing +0 days
  cut 2026-04-10
b15: 90.00 PLN
  pad: konto after save[2026-03], pads:rd:konto@after save[2026-03] of -10.00 PLN
  cut 2026-04-10
b16: 90.00 PLN
  pad: konto after save[2026-03], pads:rd:konto@after save[2026-03] of -10.00 PLN
  cut 2026-04-10
pd: 10.00 PLN
  cut 2026-04-10
