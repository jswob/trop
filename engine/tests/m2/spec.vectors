  cite s
  governs always
  known 2026-01-01
  p = 10.00 PLN "the card"
  twice = 2 "the card"
  goal = 40.00 PLN "the card"
  opening[konto] = 0.00 PLN at 2026-01-01 start "own"

version bank_q1
  cite s
  governs 2026-01..2026-03
  known 2026-04-02
  covers konto
  anchor konto
  bank[r1] = (on: 2026-01-01, kind: transfers, leg cash from work to konto amount 10.00 PLN, fulfils: pay[2026-01]) "r1"
  bank[r2] = (on: 2026-02-02, kind: transfers, leg cash from work to konto amount 10.00 PLN, fulfils: pay[2026-02]) "r2"
  bank[r3] = (on: 2026-03-01, kind: transfers, leg cash from work to konto amount 12.00 PLN, fulfils: pay[2026-03]) "r3"
  stated[konto] = 32.00 PLN at 2026-03-31 end "saldo"
,,1:0,1668:r_axis [ax = lo]: residuals konto 2026-01 .. 2026-03
  2026-03 move pay: model 10.00 PLN, observed 12.00 PLN, difference 2.00 PLN
    matched pay[2026-03] on 2026-03-01: model 10.00 PLN, observed 12.00 PLN, difference 2.00 PLN, timing +0 days
  2026-01 move pay: model 10.00 PLN, observed 10.00 PLN, difference 0.00 PLN
    matched pay[2026-01] on 2026-01-01: model 10.00 PLN, observed 10.00 PLN, difference 0.00 PLN, timing +0 days
  2026-02 move pay: model 10.00 PLN, observed 10.00 PLN, difference 0.00 PLN
    matched pay[2026-02] on 2026-02-01: model 10.00 PLN, observed 10.00 PLN, difference 0.00 PLN, timing +1 days
  2026-03 balance: model 32.00 PLN, observed 32.00 PLN, difference 0.00 PLN
