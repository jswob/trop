source plan "plan"
source wyciag "bank"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
unit USD: currency minor 0.01
kind wallets: place any signed
kind shopping: transfers
  attr cat: text
input bank: observed
input pln_amt: money PLN
input eur_amt: money EUR
input dom: int
place w: wallets lives 2019-05-01..
place shop: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..

move pay[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from w to shop amount pln_amt

move epay[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from w to shop amount eur_amt

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  pln_amt = 100.00 PLN "umowa"
  eur_amt = 20.00 EUR "umowa"
  dom = 5 "umowa"
  opening[w] = 1 000.00 PLN at 2026-01-01 start "s"
  opening[w] = 1 000.00 EUR at 2026-01-01 start "s"
  opening[w] = 0.00 USD at 2026-01-01 start "s"

version st
  cite wyciag
  governs 2026-02
  known 2026-03-02
  covers w
  pad w from unexplained
  bank[r1] = (on: 2026-02-05, kind: transfers, leg cash from w to shop amount 110.00 PLN, fulfils: pay[2026-02]) "l1"
  bank[r2] = (on: 2026-02-06, kind: transfers, leg cash from w to shop amount 20.00 EUR, fulfils: epay[2026-02]) "l2"
  bank[r3] = (on: 2026-02-07, kind: shopping, leg cash from w to shop amount 3.00 EUR, cat: "food") "l3"
  bank[r4] = (on: 2026-02-08, kind: shopping, leg cash from w to shop amount 4.00 PLN, cat: "food") "l4"
  stated[w] = ?"saldo nieczytelne" at 2026-02-28 end "saldo"

ask led: residuals w 2026-02
ask byc: residuals w 2026-01..2026-02 by cat
ask bp: bal(w, PLN, 2026-03-01)
,,1:0,3276:led: residuals w 2026-02
  ledger EUR:
    2026-02 balance: model 957.00 EUR, observed ?"saldo nieczytelne" (stated[w]), difference ?"saldo nieczytelne" (stated[w])
      balance w 2026-02-28 end (padded): booked 957.00 EUR, stated ?"saldo nieczytelne" (stated[w]), gap ?"saldo nieczytelne" (stated[w])
    2026-02 unexplained: model 0.00 EUR, observed -3.00 EUR, difference -3.00 EUR
      unexplained bank[r3] on 2026-02-07: observed -3.00 EUR
    2026-02 move epay: model -20.00 EUR, observed -20.00 EUR, difference 0.00 EUR
      matched epay[2026-02] on 2026-02-05: model -20.00 EUR, observed -20.00 EUR, difference 0.00 EUR, timing +1 days
  ledger PLN:
    2026-02 balance: model 786.00 PLN, observed ?"saldo nieczytelne" (stated[w]), difference ?"saldo nieczytelne" (stated[w])
      balance w 2026-02-28 end (padded): booked 786.00 PLN, stated ?"saldo nieczytelne" (stated[w]), gap ?"saldo nieczytelne" (stated[w])
    2026-02 move pay: model -100.00 PLN, observed -110.00 PLN, difference -10.00 PLN
      matched pay[2026-02] on 2026-02-05: model -100.00 PLN, observed -110.00 PLN, difference -10.00 PLN, timing +0 days
    2026-02 unexplained: model 0.00 PLN, observed -4.00 PLN, difference -4.00 PLN
      unexplained bank[r4] on 2026-02-08: observed -4.00 PLN
  ledger USD:
    2026-02 balance: model 0.00 USD, observed ?"saldo nieczytelne" (stated[w]), difference ?"saldo nieczytelne" (stated[w])
      balance w 2026-02-28 end (padded): booked 0.00 USD, stated ?"saldo nieczytelne" (stated[w]), gap ?"saldo nieczytelne" (stated[w])
  cut 2026-10-20
byc: residuals w 2026-01 .. 2026-02 by cat
  ledger EUR:
    2026-02 balance: model 957.00 EUR, observed ?"saldo nieczytelne" (stated[w]), difference ?"saldo nieczytelne" (stated[w])
      balance w 2026-02-28 end (padded): booked 957.00 EUR, stated ?"saldo nieczytelne" (stated[w]), gap ?"saldo nieczytelne" (stated[w])
    2026-02 "food": model 0.00 EUR, observed -3.00 EUR, difference -3.00 EUR
      unexplained bank[r3] on 2026-02-07: observed -3.00 EUR
    2026-02 move epay: model -20.00 EUR, observed -20.00 EUR, difference 0.00 EUR
      matched epay[2026-02] on 2026-02-05: model -20.00 EUR, observed -20.00 EUR, difference 0.00 EUR, timing +1 days
  ledger PLN:
    2026-02 balance: model 786.00 PLN, observed ?"saldo nieczytelne" (stated[w]), difference ?"saldo nieczytelne" (stated[w])
      balance w 2026-02-28 end (padded): booked 786.00 PLN, stated ?"saldo nieczytelne" (stated[w]), gap ?"saldo nieczytelne" (stated[w])
    2026-02 move pay: model -100.00 PLN, observed -110.00 PLN, difference -10.00 PLN
      matched pay[2026-02] on 2026-02-05: model -100.00 PLN, observed -110.00 PLN, difference -10.00 PLN, timing +0 days
    2026-02 "food": model 0.00 PLN, observed -4.00 PLN, difference -4.00 PLN
      unexplained bank[r4] on 2026-02-08: observed -4.00 PLN
  ledger USD:
    2026-02 balance: model 0.00 USD, observed ?"saldo nieczytelne" (stated[w]), difference ?"saldo nieczytelne" (stated[w])
      balance w 2026-02-28 end (padded): booked 0.00 USD, stated ?"saldo nieczytelne" (stated[w]), gap ?"saldo nieczytelne" (stated[w])
  cut 2026-10-20
bp: ?"saldo nieczytelne" (stated[w])
  pad: w 2026-02-28 end, pads:st:w@2026-02-28 end of ?"saldo nieczytelne" (stated[w])
  cut 2026-10-20
,14:spec/g5/a1_one,11:spec-ledger,25:run a1_one.tally --ask t1,969:12:a1_one.tally,948:model b
  tally 2
  on 2027-06-30
  start 2027-01-01
  end 2027-12-31

source s "s"
unit PLN: currency minor 0.01
kind ovs: event certain
  leg cash: PLN
place acct: accounts PLN lives 2027-01-01..
place bank: outside lives 2027-01-01..
input fee[m in months]: money PLN question "fee?"
input dom: int
def p[m in months]: money PLN = if pos(m) == 1 then 0 else p[m - 1] + sum(o.cash.amount for o in ovs over m)
move pay[m in months]: transfers
  on start_of(m)
  leg cash from bank to acct amount p[m]
move op[m in months]: ovs
  on start_of(m)
  leg cash from acct to bank amount 1 PLN
move z_fee[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from acct to bank amount fee[m]

version v1
  cite s
  governs always
  known 2027-01-01
  dom = 10 "s"
  opening[acct] = 100.00 PLN at 2027-01-01 start "s"

version v2
  cite s
  governs always
  known 2027-03-01
  fee = 0.50 PLN "s"

ask t1: p[2027-06], bal(acct, 2027-06-30)
,,1:0,526:t1: (5.00 PLN, 106.00 PLN)
  unfulfilled: op[2027-01]
  unfulfilled: op[2027-02]
  unfulfilled: op[2027-03]
  unfulfilled: op[2027-04]
  unfulfilled: op[2027-05]
  unfulfilled: op[2027-06]
  unfulfilled: pay[2027-02]
  unfulfilled: pay[2027-03]
  unfulfilled: pay[2027-04]
  unfulfilled: pay[2027-05]
  unfulfilled: pay[2027-06]
  unfulfilled: z_fee[2027-01]
  unfulfilled: z_fee[2027-02]
  unfulfilled: z_fee[2027-03]
  unfulfilled: z_fee[2027-04]
  unfulfilled: z_fee[2027-05]
  unfulfilled: z_fee[2027-06]
  cut 2027-06-30
