source card "probe"
unit DUK: currency minor 0.01
index ks = [a, b]
place konto: accounts DUK lives 2026-01-01..
place world: outside lives 2026-01-01..
input ga: money DUK
input wibor: rate
input margin: rate
input d[k in ks]: date
input lim: date
input lo: date
input gd: date
move gift: transfers
  on gd
  leg cash from world to konto amount ga
ask q3: d[k] < lim for k in ks where d[k] > lo windows each
ask q4: d[k] < lim for k in ks where d[k] > lo
version v
  cite card
  governs always
  known 2026-01-01
  opening[konto] = 100.00 DUK at 2026-01-01 start "c"
  ga = ?"gift amount" "c"
  wibor = 5.85 %/year "c"
  margin = ?"bank margin" "c"
  d[a] = window(2026-03-01, 2026-03-02) "c"
  d[b] = 2026-05-01 "c"
  lim = 2026-06-01 "c"
  lo = 2026-03-01 "c"
  gd = 2026-02-01 "c"
,,1:0,193:q3 (k = a) [d[a] = 2026-03-02]: true
  cut 2026-01-01
q3 (k = b): true
  cut 2026-01-01
