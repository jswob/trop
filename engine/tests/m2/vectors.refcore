  note "T, M2 gate 8 run 43749994847 on 205157a2: moves whose at is a window crossing a law change on 2026-04-01, legs alike on both sides: an attribute that differs and one that doesn't (ma, mb), a when that differs (mw), one that exists on both (mx) (walk/plan.rs imprecise_body)"

source s "s"
unit PLN: currency minor 0.01
kind ev: event certain
  leg cash: PLN
  attr n: int
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input wl: date
input pq: date
input a1: money PLN
input nv: int
input ns: int
input on1: int

move ma: ev
  on pq
  at wl
  attr n = nv
  leg cash from world to konto amount a1

move mb: ev
  on pq
  at wl
  attr n = ns
  leg cash from world to konto amount a1

move mw: ev
  on pq
  at wl
  when on1 > 0
  attr n = ns
  leg cash from world to konto amount a1

ask n_ma: ma.n
ask n_mb: mb.n
ask f_ma: flows(ma, 2026-04-01 .. 2026-04-30)
ask f_mb: flows(mb, 2026-04-01 .. 2026-04-30)
ask f_mw: flows(mw, 2026-04-01 .. 2026-04-30)
ask c: count(t in ev over 2026-04)
ask b: bal(konto, 2026-04-30)

version v
  cite s
  governs always
  known 2026-01-01
  wl = window(2026-03-30, 2026-04-02) "s"
  a1 = 1.00 PLN "s"
  pq = 2026-04-10 "s"
  ns = 7 "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"

version old
  cite s
  governs 2026-01-01..2026-03-31
  known 2026-01-01
  nv = 1 "s"
  on1 = 1 "s"

version new
  cite s
  governs 2026-04-01..
  known 2026-01-01
  nv = 2 "s"
  on1 = 0 "s"
,,1:0,116:n_ma: ?"date within window(2026-03-30, 2026-04-02) not precise enough for the law date of ma" (ma)
  cut 2026-08-01
