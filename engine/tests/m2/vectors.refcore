version facts_model
  cite modeller
  governs always
  known 2026-10-18
  note "The modeller's classification and the assumptions that stand for the examples' own facts: known from the model's on, as the examples (§4.5)."
  cat[savings] = c_bank "spaargeld is a banktegoed: Wet IB 2001 art. 5.2 lid 2 (2025); Wet rechtsherstel art. 3 lid 3 kolom I"
  cat[shares] = c_other "aandelen are beleggingen, overige bezittingen: 2022 ex. 2 Stap 1 'Beleggingen en andere bezittingen: € 50.000'"
  cat[investments] = c_other "beleggingen are overige bezittingen: 2022 ex. 3 and 2025 ex. 3 Stap 1"
  cat[home_nl] = c_other "a second home is an overige bezitting: 2025 ex. 3 Stap 1 '€ 75.000 + € 200.000'"
  cat[home_abroad] = c_other "a second home abroad is an overige bezitting: 2025 ex. 5 Stap 1 '€ 97.376 + € 250.000'"
  cat[green_inv] = c_green "groene beleggingen: art. 5.13 lid 1 and art. 5.14 (2025)"
  green_ok[ex25_5] = true assumed "the page treats the green investments as qualifying under art. 5.14 without saying so"
  partner_all_year = true assumed "the pages say only 'U hebt een fiscale partner'; the joint heffingvrij vermogen and drempel they apply need partners for the whole year"
  pga = 0 assumed "no persoonsgebonden aftrek is mentioned; the pages tax the voordeel directly (art. 5.1)"
  resident_all_year = true assumed "residence for the whole year is not stated; the pages apply no proration"
