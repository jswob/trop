source fund_prices "REC-07 card: the fund's recorded price at the start of each year, years 0-6"

source plan "REC-07 card: the plan, 1 000.00 at the start of each of 3 years"

unit DUK: currency minor 0.01

unit fu "a unit of the fund"

index yr = int 0..6

input buy: money DUK

input plan_years: int

input price[y in yr]: num DUK/fu

def end_value[s in yr]: money DUK at reader
  rule replay v card_rules = round(units_bought[s] * price[s + plan_years], minor(DUK), half-up)

def units_bought[s in yr]: num fu = sum(buy / price[k] for k in yr where k >= s and k < s + plan_years) at reader

ask best: argmax(end_value[s] for s in yr where s + plan_years <= last(k in yr)) ties by pos(s), max(end_value[s] for s in yr where s + plan_years <= last(k in yr)) law 2026-10-25

ask ends: end_value[s] for s in yr where s + plan_years <= last(k in yr) law 2026-10-25

ask worst: argmin(end_value[s] for s in yr where s + plan_years <= last(k in yr)) ties by pos(s), min(end_value[s] for s in yr where s + plan_years <= last(k in yr)) law 2026-10-25

