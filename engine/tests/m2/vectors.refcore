  on_off[q] = 0 "s"
  on2[p] = 1 "s"
  on2[q] = 1 "s"
  rank[p] = 1 "s"
  rank[q] = 2 "s"
  rank2[p] = 2 "s"
  rank2[q] = 1 "s"
