  governs always
  known 2025-03-01
  row_after[1] = 800.00 "line 3: 03.03.2025;Sklep Rolnik;-200,00;800,00"
  row_after[2] = 1300.00 "line 4: 05.03.2025;Klient Kowal;500,00;1300,00"
  row_after[3] = 1300.00 "line 5: 05.03.2025;Klient Kowal;500,00;1300,00"
  row_after[4] = 1200.00 "line 6: 10.03.2025;Apteka;-100,00;1200,00"
  row_after[5] = 1150.00 "line 7: 12.03.2025;Kawiarnia;-50,00;1150,00"
  row_amt[1] = -200.00 "line 3"
  row_amt[2] = 500.00 "line 4"
  row_amt[3] = 500.00 "line 5"
  row_amt[4] = -100.00 "line 6"
  row_amt[5] = -50.00 "line 7"

