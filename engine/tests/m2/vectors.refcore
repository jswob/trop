  on_off[p] = 1 "s"
  on_off[q] = 0 "s"
  on2[p] = 1 "s"
  on2[q] = 0 "s"
  rank[p] = 1 "s"
  rank[q] = 2 "s"
  rank2[p] = 1 "s"
  rank2[q] = 2 "s"

version new
