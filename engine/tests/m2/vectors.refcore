,12:U:law/LAW-04,12:checks-green,32:run unit/probes/law/LAW-04.tally,5102:28:unit/probes/law/LAW-04.tally,5064:model law04
  tally 2
  on 2026-10-25
  start 2022-01-01
  end 2023-12-31
  note "Probe LAW-04: a rate cut enacted in July for the whole year. The monthly advances keep their booked amounts (the act's adjustments are waived); the return reads what was booked and settles the difference on its own day."
  note "The card's facts and its earlier law are stipulations, known from start (L 4.5). The act is a later dated document: published in July 2022, no day given."

source card "Probe card LAW-04 (tmp/cases/probes/law/LAW-04.md): story, rules 1-2 and question"

unit DUK: currency minor 0.01

kind advance_pays: event certain
  leg cash: DUK

kind waivers: event certain

index mo = month 2022-01..2022-12

index yr = year 2022..2022

place ania: accounts DUK lives 2022-01-01..

place employer: outside lives 2022-01-01..

place tax_office: outside lives 2022-01-01..

input act_day: date question "On what day did the act become known?"

input adv_day: int question "On what day of the month is the advance withheld?"

input adv_rate: num question "What advance rate applies to this month's pay?"

input filed[y in yr]: date question "On what day is the return for this year filed?"

input monthly: money DUK question "What does Ania earn a month?"

input round_mode: rounding question "How are the advances and the tax due rounded to the minor unit?"

input year_rate[y in yr]: num question "What rate does the year's law set for this year's income?"

def adv_amt[m in mo]: money DUK at start_of(m)
  note "the advance on the month's pay at the month's rate"
  rule base v card_payroll = round(adv_rate * monthly, minor(DUK), round_mode)

def due[y in yr]: money DUK at start_of(y)
  note "rule 1: the year's law applied to the year's income"
  rule base v card_return = round(year_rate[y] * income[y], minor(DUK), round_mode)

def income[y in yr]: money DUK = sum(monthly for m in mo where year_of(m) == y) at start_of(y)

def withheld[y in yr]: money DUK at start_of(y)
  note "rule 1: what was withheld is credited: the advances as booked, their settlements included (L 5.14.3)"
  rule base v card_return = flows(advance, y)

move advance[m in mo]: advance_pays
  on day_of(m, adv_day)
  at start_of(m)
  for m
  leg cash from ania to tax_office amount adv_amt[m]

move arrears_paid[y in yr]: transfers
  on filed[y]
  at start_of(y)
  for y
  when due[y] > withheld[y]
  leg cash from ania to tax_office amount due[y] - withheld[y]

move keep_months[a in adjustments on act_day where a.adjusts in advance_pays]: waivers
  on a.day
  fulfils a
  note "rule 2: a change covering a closed period is never booked by rewriting past months: each adjustment the act makes to a booked advance is waived (L 5.14.3); the return settles the year"

move pay[m in mo]: transfers
  on day_of(m, adv_day)
  at start_of(m)
  for m
  leg cash from employer to ania amount monthly
  note "story: Ania earns 8 000.00 DUK a month, paid on the day the advance is withheld"

move refund[y in yr]: transfers
  on filed[y]
  at start_of(y)
  for y
  when withheld[y] > due[y]
  leg cash from tax_office to ania amount withheld[y] - due[y]

ask months_kept: flows(advance[m], m) for m in mo

ask settlement: withheld[2022], due[2022], flows(refund, 2023-04-30), flows(arrears_paid, 2023), flows(ania, 2023-04-30), refund[2022].day

version card_facts
  cite card
  governs always
  known 2022-01-01
  adv_day = 28 assumed "the card gives no day for the monthly pay and its advance; a pay needs a date (L 5.10, Places need dates), so the 28th stands for it; no figure asked depends on the day while June's advance falls before the act is known"
  filed[2022] = 2023-04-30 "story: she files her return on 30 April 2023"
  monthly = 8000 "story: Ania earns 8 000.00 DUK a month in 2022"
  round_mode = half-up assumed "the card states no rounding; every advance and the tax due are whole numbers of minor units, so the mode changes nothing"

version card_payroll
  cite card
  governs always
  known 2022-01-01
  note "story: her advances were 17 % to June and 12 % from July"
  adv_rate = 0.17 governs 2022-01..2022-06 "story: 17 % to June"
  adv_rate = 0.12 governs 2022-07.. "story: 12 % from July"

version card_return
  cite card
  governs always
  known 2022-01-01
  note "rules 1-2: no items; the return's rules point at it"

version card_act
  cite card
  governs 2022
  known 2022-07-31
  note "the act published in July 2022; the card gives no day, so known takes the latest it can be, 31 July (L 4.5, Knowledge)"
  note "rule 2: a change covering a closed period is booked on the day it is settled, never by rewriting past months: the adjustments it makes to the advances are waived (keep_months); the return settles it"
  act_day = 2022-07-31 governs always "story: an act published in July (the latest day it can be, L 4.5)"
  replace adv_rate = 0.12 governs 2022-01..2022-06 "story: the act cuts the rate to 12 % for the whole of 2022 (July to December were 12 % already)"
  year_rate[2022] = 0.12 "story: 12 % for the whole of 2022, which the return applies (rule 1)"
