  known 2026-10-17
  covers konto
  bank[m20260915] = (on: 2026-09-15, kind: transfers, leg cash from marek to konto amount 500.00 PLN) "14-marek.json ledger row 2, pozyczka"

ask g1_net_change: sum(flows(x, 2026-03-12) for x in places over .. where not x in outside)
