unit DUK: currency minor 0.01

input spending[m in months]: money DUK

input window: int

def floor_on[m in months]: money DUK at start_of(m)
  note "the floor on the 15th of month m"
  rule base = round(mean(spending[k] for k in months where k < m and m - k <= window), minor(DUK), half-up)

