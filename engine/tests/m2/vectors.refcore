ask ask_m4: month_a[m4], mon_applies[m4, m], addback[m4, m] for m in [2022-01, 2022-02, 2022-03, 2022-04, 2022-05, 2022-06] law 2026-10-18

ask ask_q1: month_a[q1], mon_applies[q1, m] for m in [2022-01, 2022-02, 2022-03, 2022-04, 2022-05, 2022-06] law 2026-10-18

ask ask_q2: ann_applies[2022, q2, s, b] for s in spouse, b in basis law 2022-04-06 as known 2022-04-06

ask ask_q3: ann_applies[2022, q3, s, b] for s in spouse, b in basis law 2022-04-06 as known 2022-04-06

ask ask_q4: a_basis[q4, sp1, joint], ann_applies[2022, q4, s, b] for s in spouse, b in basis law 2022-04-06 as known 2022-04-06

ask ask_q5: a_basis[q5, sp1, joint], ann_applies[2022, q5, s, b] for s in spouse, b in basis law 2022-04-06 as known 2022-04-06

ask ask_q6: ann_applies[2022, q6, s, b] for s in spouse, b in basis law 2022-04-06 as known 2022-04-06

ask ask_q7: ann_applies[2022, q7, s, b] for s in spouse, b in basis law 2022-04-06 as known 2022-04-06

ask ask_s1: mon_relief[c, m], adv[c, m], adv[c, m] as if {mon_relief[c, m] = 0}, adv_2021[c, m] for c in [s1a, s1b], m in mo law 2022-04-06 as known 2022-04-06

ask ask_s1_total: sum(adv[c, m] for m in mo), sum(adv[c, m] as if {mon_relief[c, m] = 0} for m in mo), sum(adv_2021[c, m] for m in mo) for c in [s1a, s1b] law 2022-04-06 as known 2022-04-06

ask ask_s2: a_rev[j, sp1], ann_relief[2022, j, sp1, individual], tax_ind[2022, j, sp1], tax_ind[2022, j, sp1] as if {ann_relief[2022, j, sp1, individual] = 0}, tax_2021_ind[j, sp1] for j in [s2a, s2b] law 2022-04-06 as known 2022-04-06

ask ask_s3: tax_ind[2022, s3, s], tax_ind[2022, s3, s] as if {ann_relief[2022, s3, s, individual] = 0}, tax_2021_ind[s3, s] for s in spouse law 2022-04-06 as known 2022-04-06

ask ask_s3_basis: a_basis[s3, s, joint], ann_applies[2022, s3, s, b] for s in spouse, b in basis law 2022-04-06 as known 2022-04-06

ask ask_s3_joint: ann_relief[2022, s3, sp1, joint], ann_relief[2022, s3, sp2, joint], joint_base[2022, s3], joint_base[2022, s3] as if {ann_relief[2022, s3, sp1, joint] = 0, ann_relief[2022, s3, sp2, joint] = 0}, tax_joint[2022, s3], tax_2021_joint[s3] law 2022-04-06 as known 2022-04-06

version dz2011_1707
  cite du2011_1707
  governs 2012-03-31..
  known 2011-12-30
  note "ogłoszona 2011-12-30 (Dz.U. 2011 Nr 291, ELI promulgation date); art. 41 pkt 2: art. 4 wchodzi w życie po upływie trzech miesięcy od dnia ogłoszenia, which the consolidated text Dz.U. 2012 poz. 749 gives as 31 March 2012 (footnote 90)"
  note "no items: the version the rounding rules cite. Footnote 90 of Dz.U. 2012 poz. 749 records art. 63 § 1 as 'W brzmieniu ustalonym przez art. 4 pkt 1' of this act. The consolidated texts Dz.U. 2015 poz. 613, 2021 poz. 1540 (in force for 2022) and 2022 poz. 2651 print the same words, so no later act gave § 1 its wording (§4.5, Which act). The enacting text is available, so the consolidated text is not the source (§5.3)"

version lifted_figures
  cite lifted_1_0_1
  governs always
  known 2011-12-30
  a_basis_2 = 2 "inline in tally 1.0.1: a_basis line 103, factor"
  adv_free_12 = 12 "inline in tally 1.0.1: adv_free line 128, factor"

version dz2019_1835
  cite du2019_1835
  governs 2020-01-01..
  known 2019-09-26
  note "ogłoszona 2019-09-26 (ELI promulgation date); art. 8: in force 1 October 2019, except art. 1 pkt 5, in force 1 January 2020. Dz.U. 2021 poz. 2105 leaves art. 32 ust. 1 as it stands (its art. 1 pkt 62 amends ust. 1a, 1c, 1e, 1f and adds 2a, 2b), so the 17% holds through 2022 until poz. 1265 art. 23 ust. 1 replaces it"
  adv_rate = 0.17 "art. 1 pkt 5 lit. a, art. 32 ust. 1 pkt 1: 17% dochodu uzyskanego w danym miesiącu"

version dz2021_2105
  cite du2021_2105
  governs 2022-01-01..
  known 2021-11-23
  note "ogłoszona 2021-11-23; art. 89: in force 1 January 2022, and art. 1 pkt 40, 47 and 62 are not among the exceptions"
  ann_band: (-inf, 68412) = below "art. 26 ust. 4b: co najmniej 68 412 zł"
  ann_band: [68412, 102588] = f1 "art. 26 ust. 4a pkt 1: dla A wynoszącego co najmniej 68 412 zł i nieprzekraczającego kwoty 102 588 zł"
  ann_band: (102588, 133692] = f2 "art. 26 ust. 4a pkt 2: dla A wyższego od 102 588 zł i nieprzekraczającego kwoty 133 692 zł"
  ann_band: (133692, inf) = above "art. 26 ust. 4b: nie przekracza kwoty 133 692 zł"
  ann_c1 = 4566 "art. 26 ust. 4a pkt 1: (A × 6,68% - 4566 zł) ÷ 0,17"
  ann_c2 = 9829 "art. 26 ust. 4a pkt 2: (A × (-7,35%) + 9829 zł) ÷ 0,17"
  ann_r1 = 0.0668 "art. 26 ust. 4a pkt 1: A × 6,68%"
  ann_r2 = -0.0735 "art. 26 ust. 4a pkt 2: A × (-7,35%)"
  formula_div = 0.17 "art. 26 ust. 4a pkt 1-2 and art. 32 ust. 2a pkt 1-2: ÷ 0,17"
  free_amount = 5100 "art. 1 pkt 47 lit. a, art. 27 ust. 1: 17% minus kwota zmniejszająca podatek 5100 zł; art. 32 ust. 3 takes 1/12 of the amount of the first bracket"
  mon_band: (-inf, 5701) = below "art. 32 ust. 2a: w wysokości wynoszącej od 5701 zł"
  mon_band: [5701, 8549] = f1 "art. 32 ust. 2a pkt 1: dla A wynoszącego co najmniej 5701 zł i nieprzekraczającego kwoty 8549 zł"
  mon_band: (8549, 11141] = f2 "art. 32 ust. 2a pkt 2: dla A wyższego od 8549 zł i nieprzekraczającego kwoty 11 141 zł"
  mon_band: (11141, inf) = above "art. 32 ust. 2a: do 11 141 zł"
  mon_c1 = 380.5 "art. 32 ust. 2a pkt 1: (A × 6,68% - 380,50 zł) ÷ 0,17"
  mon_c2 = 819.08 "art. 32 ust. 2a pkt 2: (A × (-7,35%) + 819,08 zł) ÷ 0,17"
  mon_r1 = 0.0668 "art. 32 ust. 2a pkt 1: A × 6,68%"
  mon_r2 = -0.0735 "art. 32 ust. 2a pkt 2: A × (-7,35%)"
  pit_scale: (-inf, 120000] = 0.17 * x - 5100 "art. 1 pkt 47 lit. a, art. 27 ust. 1: do 120 000, 17% minus kwota zmniejszająca podatek 5100 zł"
  pit_scale: (120000, inf) = 15300 + 0.32 * (x - band_lo(pit_scale, x)) "art. 1 pkt 47 lit. a, art. 27 ust. 1: ponad 120 000, 15 300 zł + 32% nadwyżki ponad 120 000 zł"

version example_assumptions
  cite modeller
  governs always
  known 2022-01-01
  note "Assumptions that stand for the MF guides' own facts, known from start like the facts they complete (§4.5); made by the modeller on 2026-10-18"
  biz_net[*, *] = 0 assumed "the guide lists every revenue a spouse had; one it doesn't list as business revenue is none"
  biz_net[q2, sp2] = 65000 assumed "p. 10 states the business revenue, 65 000 zł, and no costs; costs could only lower A, so revenue is taken for A"
  emp_rev[*, *] = 0 assumed "the guide lists every revenue a spouse had; a pension (Q4), a renta (Q7) and an umowa zlecenia (Q5) are not employment revenue"
  waiver[*] = false assumed "no example mentions a request under art. 32 ust. 2b"

