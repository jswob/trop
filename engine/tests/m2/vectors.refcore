source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
index ks = [a, b]
kind mixed: place any signed
place konto: accounts PLN lives 2026-01-01..
place wallet: mixed lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input amt: money PLN
input dk[k in ks]: date
input d0: date
input dd: int

move one: transfers
  on dk[a]
  leg cash from world to konto amount amt

move pay[m in months]: transfers
  on day_of(m, dd)
  leg cash from world to konto amount amt

