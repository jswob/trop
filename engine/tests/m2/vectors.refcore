source acct_open "REC-02 card: the account's opening in March 2025"

source card "REC-02 card: its rules"

source wrzos_export "REC-02 card: Bank Wrzosowy's export for PKB-1201, March 2025: semicolon-separated, decimal comma, dates dd.mm.yyyy, two header lines, a balance-after column"

unit DUK: currency minor 0.01

index row = int 1..5

input opening_bal: money DUK

input row_after[r in row]: money DUK

input row_amt[r in row]: money DUK

def closing: money DUK at reader
  rule last_row v card_rules = row_after[last(r in row)]

def faulty_amt: money DUK = sum(row_amt[r] for r in row where no_effect[r]) at reader

def naive_sum: money DUK = opening_bal + sum(row_amt[r] for r in row) at reader

def no_effect[r in row]: bool at reader
  rule twice v card_rules = row_after[r] == prev_after[r]

def prev_after[r in row]: money DUK at reader
  rule base = row_after[r - 1]
  rule first beats base = opening_bal when pos(r) == 1

def without_faulty: money DUK = opening_bal + sum(row_amt[r] for r in row where not no_effect[r]) at reader

ask closes: check without_faulty == closing law 2026-10-25

ask issues: no_effect[r], row_amt[r] for r in row law 2026-10-25

ask moves_exactly: check naive_sum - without_faulty == faulty_amt law 2026-10-25

ask q: closing, naive_sum, without_faulty law 2026-10-25

