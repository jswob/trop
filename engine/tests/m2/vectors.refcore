  fulfils a

version forecast_2026
  cite modeller
  governs always
  known 2025-12-31
  cost_net = 0 assumed "przed wpisem do CEIDG nie znamy kosztów firmy; wpis je poda" governs 2026-03..
  cost_vat = 0 assumed "przed wpisem do CEIDG nie znamy kosztów firmy; wpis je poda" governs 2026-03..
  etf_return = 0.06 assumed "zwrot ETF 6% rocznie (prototyp)" governs 2027..
  fee_net = 0 assumed "przed umowami B2B nie znamy faktur; umowy je podadzą" governs 2026-03..
  inflation = 0 assumed "indeks cen równy 1 do 2027 roku (prototyp)" governs 2026..2027
  inflation = 0.03 assumed "ceny +3% rocznie (prototyp)" governs 2028..
  oki_from = none assumed "na początek 2026 OKI nie istnieje w prawie"

version home_2026
  cite household
  governs always
  known 2025-12-31
  cost_net = 0 governs 2026-01..2026-02 "przed założeniem działalności"
  cost_vat = 0 governs 2026-01..2026-02 "przed założeniem działalności"
  fee_net = 0 governs 2026-01..2026-02 "przed założeniem działalności"
  keep_floor = 1000 "reguła 15.: zostawiamy 1 000 zł"
  oki_holds = foreign "na OKI będzie ETF zagraniczny"
  rent = 3200 governs 2026-01.. "umowa najmu, § 4"
  salary[wife_acme] = 7000 governs 2026-01.. "umowa o pracę żony, § 3"
  spend_budget[groceries] = 2200 assumed "budżet gospodarstwa na 2026, przed pierwszym wyciągiem"
  spend_budget[health_care] = 300 assumed "budżet gospodarstwa na 2026, przed pierwszym wyciągiem"
  spend_budget[other] = 1500 assumed "budżet gospodarstwa na 2026, przed pierwszym wyciągiem"
  spend_budget[transport] = 600 assumed "budżet gospodarstwa na 2026, przed pierwszym wyciągiem"
  spend_window = none "nie ma jeszcze wyciągu"
  zus_stage = inactive governs 2026-01..2026-02 "przed założeniem działalności"

