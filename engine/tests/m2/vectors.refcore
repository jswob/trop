,20:I:X:wife_net@v3_fast,12:checks-green,382:run real11/v3/asks/core.tally real11/v3/facts/2026.tally real11/v3/law/pl/benefits.tally real11/v3/law/pl/business.tally real11/v3/law/pl/common.tally real11/v3/law/pl/employment.tally real11/v3/law/pl/wrappers.tally real11/v3/loans.tally real11/v3/pays.tally real11/v3/people.tally real11/v3/places.tally real11/v3/reality.tally real11/v3/records/mbank/2026-09.tally --ask wife_net,50076:25:real11/v3/asks/core.tally,1238:part asks_core
  tally 2
  note "Zapisane pytania gospodarstwa. Plan zmiany (OPERATIONS §7) porównuje je przed i po."

ask explain_room: explain room[2026-11] law cut

ask health_settlement: health_settle[y] for y in [2026, 2027, 2028] law cut

ask ike_left: ike_limit[y] - flows(invest[ike], y) for y in [2026, 2027, 2028] law cut

ask konto_balance: bal(konto, d) with uncertain, bal(konto, d) with uncertain - vat_owed[d] for d in [2026-10-31, 2026-12-31, 2027-06-30, 2027-12-31] law cut

ask net_worth: sum(bal(x, d) with uncertain for x in places over .. where not x in outside and ((x in accounts or x in cash or x in claims or x in debts) and unit(x) == PLN)) + sum(value(wunits[w], d) in PLN for w in wrapper) for d in [2026-12-31, 2031-12-31, 2041-12-31, 2059-12-31] law cut

ask pit28: pit28_due[y] for y in [2026, 2027, 2028] law cut

ask pit37: pit37_due[p, y] for p in person over .., y in [2026, 2027, 2028] law cut

ask replay_september: residuals konto 2026-09 law cut

ask social_and_health: zus_social[m], health_month[m] for m in [2026-10, 2027-01, 2028-09] law cut

ask taxes_paid: flows(urzad_skarbowy, y) for y in [2026, 2027, 2028] law cut

ask wife_net: emp_net[wife_acme, m] for m in [2026-10, 2027-01] law cut
,26:real11/v3/facts/2026.tally,4255:part facts_2026
  tally 2
  note "Fakty gospodarstwa z 2026 roku: umowy, rejestracje, wybory, założenia prognozy."

source broker "Wyciągi z rachunku maklerskiego i IKE (notowania jednostek ETF)"

kind waivers: event certain

input spend_waive_on: date

move spend_waive_spend_2026_09[a in adjustments on spend_waive_on where a.adjusts in spend_pays]: waivers
  on a.day
  fulfils a

version forecast_2026
  cite modeller
  governs always
  known 2025-12-31
  cost_net = 0 assumed "przed wpisem do CEIDG nie znamy kosztów firmy; wpis je poda" governs 2026-03..
  cost_vat = 0 assumed "przed wpisem do CEIDG nie znamy kosztów firmy; wpis je poda" governs 2026-03..
  etf_return = 0.06 assumed "zwrot ETF 6% rocznie (prototyp)" governs 2027..
  fee_net = 0 assumed "przed umowami B2B nie znamy faktur; umowy je podadzą" governs 2026-03..
  inflation = 0 assumed "indeks cen równy 1 do 2027 roku (prototyp)" governs 2026..2027
  inflation = 0.03 assumed "ceny +3% rocznie (prototyp)" governs 2028..
  oki_from = none assumed "na początek 2026 OKI nie istnieje w prawie"

version home_2026
  cite household
  governs always
  known 2025-12-31
  cost_net = 0 governs 2026-01..2026-02 "przed założeniem działalności"
  cost_vat = 0 governs 2026-01..2026-02 "przed założeniem działalności"
  fee_net = 0 governs 2026-01..2026-02 "przed założeniem działalności"
  keep_floor = 1000 "reguła 15.: zostawiamy 1 000 zł"
  oki_holds = foreign "na OKI będzie ETF zagraniczny"
  rent = 3200 governs 2026-01.. "umowa najmu, § 4"
  salary[wife_acme] = 7000 governs 2026-01.. "umowa o pracę żony, § 3"
  spend_budget[groceries] = 2200 assumed "budżet gospodarstwa na 2026, przed pierwszym wyciągiem"
  spend_budget[health_care] = 300 assumed "budżet gospodarstwa na 2026, przed pierwszym wyciągiem"
  spend_budget[other] = 1500 assumed "budżet gospodarstwa na 2026, przed pierwszym wyciągiem"
  spend_budget[transport] = 600 assumed "budżet gospodarstwa na 2026, przed pierwszym wyciągiem"
  spend_window = none "nie ma jeszcze wyciągu"
  zus_stage = inactive governs 2026-01..2026-02 "przed założeniem działalności"

version broker_2026_01
  cite broker
  governs 2026-01..2026-06
  known 2026-01-02
  etf_mark = 121 "notowanie z początku stycznia"

version dg_2026
  cite household
  governs always
  known 2026-02-20
  note "wpis do CEIDG od 2026-03-01, umowy B2B z klientami A i B, zgłoszenie do ZUS"
  replace cost_net = 400 governs 2026-03.. "oprogramowanie i biuro, netto"
  replace cost_vat = 92 governs 2026-03.. "VAT naliczony od kosztów"
  fee_net[client_a] = 14000 governs 2026-03.. "umowa B2B z klientem A, § 5"
  fee_net[client_b] = 3000 governs 2026-03.. "umowa B2B z klientem B, § 4"
  sickness_opt = true "ZUS ZUA: dobrowolne ubezpieczenie chorobowe"
  tax_form = ryczalt governs 2026.. "CEIDG: ryczałt od przychodów ewidencjonowanych"
  terms[client_a] = 14 "umowa B2B z klientem A, § 6"
  terms[client_b] = 30 "umowa B2B z klientem B, § 5"
  zus_stage = relief governs 2026-03..2026-08 "ZUS ZZA: ulga na start, 6 miesięcy"
  zus_stage = preferential governs 2026-09..2028-08 "ZUS ZUA: 24 miesiące składek preferencyjnych"
  zus_stage = standard governs 2028-09.. "pełne składki po okresie preferencyjnym"

