  spend_dom[utilities] = 12 "budżet"
  spend_amt[health] = 120.00 PLN "budżet"
  spend_dom[health] = 20 "budżet"
  spend_amt[clothes] = 260.00 PLN "budżet"
  spend_dom[clothes] = 22 "budżet"
  spend_amt[leisure] = 380.00 PLN "budżet"
  spend_dom[leisure] = 26 "budżet"
  opening[konto] = 5000.00 PLN at 2021-01-01 start "wyciąg"
  opening[broker] = 0.00 PLN at 2021-01-01 start "wyciąg"

version tax_law
  cite statute
  governs always
  known 2021-01-01
  tax_rate = 0.17 "art. 1: podatek płacowy"
  law_truncates = false "art. 2: zaokrąglenie do pełnych złotych, połowa w górę"

