source s "s"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place sav: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input amt: money PLN

input keep: money PLN

input dsv: int

move pay[m in months]: transfers
  on start_of(m)
  leg cash from world to konto amount amt

def lim[m in months]: money PLN = bal(konto, start_of(m)) - keep at start_of(m)

move sv[m in months]: transfers
  on day_of(m, dsv)
  reads konto
  leg cash from konto to sav amount max(0 PLN, lim[m])

ask e_sav: explain bal(sav, 2026-03-31)

ask e_lim: explain lim[2026-02]

ask e_konto: explain bal(konto, 2026-02-28)


version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  keep = 30.00 PLN "s"
  dsv = 15 "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  opening[sav] = 0.00 PLN at 2026-01-01 start "s"
,,1:0,810:e_lim: walk-bound, read at 1 walk point
  lim[2026-02] at (2026-02-15, stratum 1, sv[2026-02]): 100.00 PLN
      [1] lim[2026-02] = 100.00 PLN, law date 2026-02-01
          rule base: won
            [2] bal(konto, 2026-02-01) = 130.00 PLN
                balance of konto (PLN) at the end of 2026-02-01
                from: opening v:opening[konto] = 0.00 PLN, 2026-01-01 start (version v, source s, locator "s")
                2026-01-01:
                  pay[2026-01].cash (past): +100.00 PLN
                2026-01-15:
                  sv[2026-01].cash (past): -70.00 PLN
                2026-02-01:
                  pay[2026-02].cash (past): +100.00 PLN
            [3] row v:keep = 30.00 PLN
                version v, source s, "s", locator "s", governs always, known 2026-01-01
  cut 2026-06-30
,15:goldens/bank_g2,15:goldens-records,791:run reality.tally bank.tally records/2024-01.tally records/2024-02.tally records/2024-03.tally records/2024-04.tally records/2024-05.tally records/2024-06.tally records/2024-07.tally records/2024-08.tally records/2024-09.tally records/2024-10.tally records/2024-11.tally records/2024-12.tally records/2025-01.tally records/2025-02.tally records/2025-03.tally records/2025-04.tally records/2025-05.tally records/2025-06.tally records/2025-07.tally records/2025-08.tally records/2025-09.tally records/2025-10.tally records/2025-11.tally records/2025-12.tally records/2026-01.tally records/2026-02.tally records/2026-03.tally records/2026-04.tally records/2026-05.tally records/2026-06.tally records/2026-07.tally records/2026-08.tally records/2026-09.tally records/2026-10.tally --ask g2_konto,316262:13:reality.tally,830:model tropek_bank
  tally 2
  on 2026-10-17
  start 2024-01-01
  end 2027-01-31
  note "T, M2 (issues #167, #114), DONE gate 2: the bank run of the prototype's reality R7 (engine/spec/verification/goldens.md: G2, G4, G5): the bank half (bank.tally) over the prototype's bank history (records/), to 2027-01-31. The forward half and its horizons are r7/."

index cal_year = year 2024..2026

index month = month 2024-01..2026-12

ask g2_konto: bal(konto, d) for d in [2026-10-15, 2026-10-16]

ask g4_by_cat: residuals konto 2025-11 .. 2026-01 by cat

ask g4_my_pay: residuals pracodawca 2024-01 .. 2026-10

ask g4_pay: emp_net[j, m] for j in job over .., m in [2024-12, 2025-11, 2025-12]

