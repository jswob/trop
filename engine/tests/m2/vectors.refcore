  marek_day[back1] = 2026-06-30

version broker_2026_07
  cite broker
  governs 2026-07..
  known 2026-07-01
  etf_mark = 126 "notowanie z początku lipca"

version marek_back_2026_09
  cite household
  governs always
  known 2026-09-15
  marek_amt[back2] = 500 "zwrot od Marka"
  marek_day[back2] = 2026-09-15
  marek_promise = (amt: 800, due: 2026-12-31) "Marek obiecał resztę do końca roku"

version spend_2026_09
  cite household
  governs always
