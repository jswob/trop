model plain
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2027-12-31
  note "T's base for M3's check fixtures (invented): it loads clean with no warning; each fixture of fixtures.tsv adds files to it"

source card "T's fixture card (invented)"

unit PLN: currency minor 0.01

input amt: money PLN

def doubled: money PLN = amt + amt at reader

ask q: doubled law 2026-03-01

version card_2026
  cite card
  governs always
  known 2026-01-01
  amt = 100.00 PLN "the card"
