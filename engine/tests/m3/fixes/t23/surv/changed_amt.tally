model changed_amt
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
  note "T, tally 2.3 (#247), held for #250: a2, known after the start, moves k2's leg to another place and leaves its amount; refcore reads k2's amount as the plan has it (100.00 PLN), the engine reads the whole leg as the hole (book/members.rs mv_field, changed_leg's moved); changed.tally holds the reads both give alike"

source s "invented"

unit PLN: currency minor 0.01

index ks = [k1, k2, k3]

place konto: accounts PLN lives 2026-01-01..
place other: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

input amt[k in ks]: money PLN
input dest[k in ks]: key accounts
input w: date
input d_at: date

move pay[k in ks]: transfers
  on w
  at d_at
  leg cash from world to dest[k] amount amt[k]

version v
  cite s
  governs always
  known 2026-01-01
  d_at = 2026-03-01 "s"
  w = window(2026-03-05, 2026-03-25) "s"
  amt[k1] = 100.00 PLN "s"
  amt[k2] = 100.00 PLN "s"
  amt[k3] = 100.00 PLN "s"
  dest[k1] = konto "s"
  dest[k2] = konto "s"
  dest[k3] = konto "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
  opening[other] = 0.00 PLN at 2026-03-01 start "s"

version a1
  cite s
  governs 2026..
  known 2026-03-20
  replace amt[k1] = 150.00 PLN "s"

version a2
  cite s
  governs 2026..
  known 2026-03-22
  replace dest[k2] = other "s"

ask k2_amt: pay[k2].cash.amount
ask k2_amt_p05: pay[k2].cash.amount with w = 2026-03-05
ask k2_amt_p25: pay[k2].cash.amount with w = 2026-03-25
ask k2_to_p05: pay[k2].cash.to with w = 2026-03-05
ask k2_to_p25: pay[k2].cash.to with w = 2026-03-25
