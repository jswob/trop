model hole_dec
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.3 (#247), the round's mutation run (book/members.rs unread_hole, unread_field, hole_day_member, instance_by_id, mv_field, span_members; walk/plan.rs hole_day_legs): a decision whose day is a window row is a member of every binding over its kind with that hole, its legs' places read as the plan has them, so a where on them is decided; a field of it read by its name is the hole; one whose when is false is no member; a decision on a known day that reads its leg reads the hole (L §5.14, §5.19; ruling 14)"

source s "invented"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2025-01-01..
place other: accounts PLN lives 2025-01-01..
place third: accounts PLN lives 2025-01-01..
place world: outside lives 1900-01-01..

input amt: money PLN
input w: date
input d2: date
input flag: bool
input d0: date

move dw: transfers
  on w
  reads konto
  leg cash from konto to other amount min(bal(konto), amt)

move dn: transfers
  on w
  at d0
  reads konto
  when flag
  leg cash from konto to third amount min(bal(konto), amt)

move dr: transfers
  on d2
  reads dw
  leg cash from world to konto amount dw.cash.amount

version v
  cite s
  governs always
  known 2025-01-01
  amt = 100.00 PLN "s"
  w = window(2026-03-02, 2026-03-06) "s"
  d2 = 2026-03-20 "s"
  d0 = 2026-03-01 "s"
  flag = false "s"
  opening[konto] = 500.00 PLN at 2026-01-01 start "s"

ask to_other: count(x in transfers over 2026-03 where x.cash.to == other)
ask to_third: count(x in transfers over 2026-03 where x.cash.to == third)
ask from_world: count(x in transfers over 2026-03 where x.cash.from == world)
ask direct_to: dw.cash.to
ask direct_amt: dw.cash.amount
ask dr_amt: dr.cash.amount
ask b_other: bal(other, 2026-03-31)
ask b_third: bal(third, 2026-03-31)
