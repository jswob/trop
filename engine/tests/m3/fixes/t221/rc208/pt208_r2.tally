model pt208_r2
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "invented"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

input fee[m in months]: money PLN
input dk[m in months]: date

move pay[m in months]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from world to konto amount fee[m]

version v
  cite s
  governs always
  known 2026-01-01
  dk[2026-03..2026-06] = 2026-06-01 "s"
  opening[konto] = 0.00 PLN at 2026-03-01 start "s"

version f26
  cite s
  governs 2026..
  known 2026-01-01
  fee[2026-03..2026-06] = 10.00 PLN "s"

ask r_flows: flows(konto, m) for m in [2026-03, 2026-04] law dk[m]
ask r_explain: explain fee[m] for m in [2026-03] law dk[m]
ask r_resid: residuals konto m for m in [2026-03] law dk[m]
