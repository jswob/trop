model mini
  tally 2
  on 2026-10-19
  start 2026-10-01
  end 2026-12-31

source s "Założenia modelu"

unit PLN: currency minor 0.01

kind jobs
kind wages: event certain
  leg cash: PLN

place world: outside lives 1900-01-01..

input pay_dom: int
input salary[j in jobs, m in months]: money PLN question "Ile wynosi pensja?"

move wage[m in months, j in jobs over m]: wages
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from world to konto amount salary[j, m]

version home
  cite s
  governs 2026-10..
  known 2026-10-01
  jobs + [acme] lives 2020-02-01..
  accounts + [konto] PLN lives 2019-05-01..
  pay_dom = 10 "umowa"
  salary[acme] = 7 000.00 PLN "umowa"
  opening[konto] = 1 000.00 PLN at 2026-10-01 start "wyciąg"
