model r10
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-06-30
source s "s"
unit PLN: currency minor 0.01
kind savings: place PLN min 0
place pot: savings lives 2025-01-01..
place jar: accounts PLN lives 2025-01-01..
place world: outside lives 1900-01-01..
input small: money PLN
input amt2: money PLN
input other: money PLN
input d0: date
input db: date
input dj: date
move dep: transfers
  on d0
  leg cash from world to pot amount small
move ob: transfers
  on db
  leg cash from pot to world amount amt2
move oj: transfers
  on dj
  leg cash from world to jar amount other
version v
  cite s
  governs always
  known 2025-12-01
  small = 10.00 PLN "s"
  amt2 = 200.00 PLN "s"
  other = 5.00 PLN "s"
  d0 = 2026-04-01 "s"
  db = 2026-04-07 "s"
  dj = 2026-04-03 "s"
  opening[pot] = 50.00 PLN at 2026-01-01 start "s"
  opening[jar] = 0.00 PLN at 2026-01-01 start "s"
ask a0: bal(pot, 2026-04-30)
ask a1: bal(pot, 2026-04-30) with small = 20.00 PLN
ask a2: bal(pot, 2026-04-30) with small = 500.00 PLN
ask a3: bal(pot, 2026-04-30) with amt2 = 300.00 PLN
ask a4: bal(pot, 2026-04-30) with db = 2026-04-08
ask a5: bal(pot, 2026-04-30) with other = 6.00 PLN
ask a6: bal(pot, 2026-04-30) with d0 = 2026-04-02
ask a6b: bal(pot, 2026-04-30) with d0 = 2026-04-10
ask a7: flows(pot, 2026-04) with small = 20.00 PLN
ask a8: flows(ob, 2026-04) with small = 20.00 PLN
ask a8b: flows(ob, 2026-04) with amt2 = 300.00 PLN
ask a9: bal(pot, 2026-04-05) with small = 20.00 PLN
ask a10: bal(jar, 2026-04-30) with small = 20.00 PLN
ask a11: bal(pot, 2026-04-30), bal(jar, 2026-04-30) with small = 20.00 PLN, other = 6.00 PLN
