model u1
  tally 2
  on 2026-03-10
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
unit hour "godzina"
kind funds: unit

kind fund_buys: event certain
  leg units: funds
  leg cash: PLN

input fund: observed
input rate: money PLN
input missing: money PLN
input hrs: num hour
input px[u in funds]: num PLN/u

place konto: accounts PLN lives 2026-01-01..
place konto_eur: accounts EUR lives 2026-01-01..
place market: outside lives 1900-01-01..
place ike: holdings etf lives 2026-01-01..
place ike2: holdings bond lives 2026-01-01..
place ike_cash: accounts PLN lives 2026-01-01..

version units
  cite s
  governs always
  known 2025-01-01
  funds + [etf] lives 2020-01-01..
  funds + [bond] lives 2020-01-01..
  rate = 100.00 PLN
  hrs = 8 hour
  px[etf] = 120 PLN/etf
  px[bond] = 90 PLN/bond
  opening[konto] = 10.00 PLN at 2026-01-01 start "w"
  opening[konto_eur] = 2.00 EUR at 2026-01-01 start "w"
  opening[ike2] = 3 bond at 2026-01-01 start "w"

version register_2026_02
  cite s
  governs 2026-02
  known 2026-03-05
  covers ike
  fund[r3] = (on: 2026-02-02, kind: fund_buys, leg units from market to ike amount 4.2167 etf, leg cash from ike_cash to market amount 500.00 PLN) "register line 3"

ask fund_place: unit(ike), unit(ike2), unit(ike) == etf
ask over_places: sum(1 for x in places over .. where x in holdings and unit(x) == etf)
ask in_where: count(x in places over .. where x in accounts and unit(x) == PLN)
ask bal_unit: unit(bal(ike, 2026-02-28)), unit(bal(konto_eur, 2026-02-28))
ask bal3: unit(bal(ike, etf, 2026-02-28)), unit(bal(ike2, u, 2026-02-28)) for u in funds
ask leg_amt: count(o in fund over 2026-02 where unit(o.units.amount) == etf)
ask priced: px[unit(bal(ike, 2026-02-28))] * bal(ike, 2026-02-28)
ask hole: unit(missing)
ask hole_cmp: unit(missing) == PLN
ask numcur: unit(rate * 0.5), unit(rate / 3)
ask refused_tuple: unit(konto), unit(market)
ask cur_lit: unit(konto) == PLN, unit(konto_eur) == PLN, unit(konto) != EUR
ask pinned: unit(rate) == PLN with rate = 3.00 EUR
def npln: int = sum(1 for x in places over .. where unit(x) == PLN)
ask expl: explain npln
ask use_def: npln
