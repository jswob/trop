model cb
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input w: date
input wa: date
input wb: date
input sp: month
input bank: observed
move pa: transfers
  on wa
  leg cash from world to konto amount amt
move pb: transfers
  on wb
  leg cash from world to konto amount amt
version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  sp = 2026-03 "s"
  w = window(2026-04-28, 2026-05-03) "s"
  wa = window(2026-03-28, 2026-04-02) "s"
  wb = window(2026-03-10, 2026-03-12) "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
version st
  cite s
  governs 2026-03
  known 2026-04-05
  anchor konto
  stated[konto] = 640.00 PLN at 2026-03-20 end "saldo"
version fix
  cite s
  governs 2026-03
  known 2026-04-08
  anchor konto
  replace stated[konto] = 650.00 PLN at 2026-03-20 end "saldo, poprawione"
ask cnt: count(m in transfers over sp)
ask fl: flows(konto, sp)
ask fst: first(m in transfers over sp ..) ties by m.day
ask b20: bal(konto, 2026-03-20)
