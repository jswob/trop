model bk
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input w: date
input d_at: date
move pay: transfers
  on w
  at d_at
  leg cash from world to konto amount amt
version v
  cite s
  governs always
  known 2026-01-01
  d_at = 2026-03-01 "s"
  w = window(2026-03-05, 2026-03-20) "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
version a0
  cite s
  governs 2026..
  known 2026-01-01
  amt = 100.00 PLN "s"
version a1
  cite s
  governs 2026..
  known 2026-03-21
  replace amt = 150.00 PLN "s"
ask a20260331: bal(konto, 2026-03-31) 
ask a20260331_p20260305: bal(konto, 2026-03-31)  with w = 2026-03-05
ask a20260331_p20260306: bal(konto, 2026-03-31)  with w = 2026-03-06
ask a20260331_p20260319: bal(konto, 2026-03-31)  with w = 2026-03-19
ask a20260331_p20260320: bal(konto, 2026-03-31)  with w = 2026-03-20
ask fl: flows(pay, 2026-03)
