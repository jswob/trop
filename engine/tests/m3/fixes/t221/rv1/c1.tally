model c1
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-12-31
source card "invented"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..
input pay: money PLN
input w2: date
move pay_x: transfers
  on w2
  leg cash from world to konto amount pay
version v_card
  cite card
  governs always
  known 2026-01-01
  pay = 100.00 PLN "c"
  w2 = window(2026-03-30, 2026-04-03) "c"
  opening[konto] = 500.00 PLN at 2026-01-01 start "c"
version st
  cite card
  governs 2026-03
  known 2026-04-10
  covers konto
  pad konto from unexplained
  stated[konto] = 595.00 PLN at 2026-03-31 end "s"
version st2
  cite card
  governs 2026-04
  known 2026-04-10
  anchor konto
  stated[konto] = 700.00 PLN at 2026-04-02 end "s2"
