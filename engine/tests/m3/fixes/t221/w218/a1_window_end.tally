model w1
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input keep: money PLN
input d_save: date
move save: transfers
  on d_save
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)
version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = window(2026-03-16, 2026-03-25) "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"
version st
  cite s
  governs 2026-03
  known 2026-01-02
  anchor konto
  stated[konto] = 100.00 PLN at 2026-03-25 end "saldo"
ask b: bal(konto, 2026-03-24), bal(konto, 2026-03-25), bal(konto, 2026-04-30)
