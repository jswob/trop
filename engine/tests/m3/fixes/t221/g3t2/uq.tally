model uq
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind fx: event certain
  leg cash: currencies
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  bank[r1] = (on: 2026-01-10, kind: fx, leg cash from world to konto amount 5.00 PLN) "r1"
ask u1: unit(bank[r1].cash.amount)
ask u2: unit(bank[r1].cash.amount * bank[r1].cash.amount)
ask u3: unit(bank[r1].cash.amount / bank[r1].cash.amount)
