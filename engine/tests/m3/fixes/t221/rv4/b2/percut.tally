model t
  tally 2
  on 2026-04-30
  start 2026-01-01
  end 2026-06-30

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2025-01-01..
place shop: outside lives 1900-01-01..
input bank: observed

version open
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "s"

version stmt
  cite s
  governs 2026-02
  known 2026-03-01
  covers konto
  bank[r1] = (on: 2026-02-10, kind: transfers, leg cash from konto to shop amount 50.00 PLN) "a"

version fix
  cite s
  governs 2026-02
  known 2026-04-01
  replace bank[r1] = (on: 2026-02-10, kind: transfers, leg cash from konto to shop amount 70.00 PLN) "fix"

version mover
  cite s
  governs 2026-02
  known 2026-04-05
  moves stmt to 2026-03

ask q_0402: bal(konto, 2026-04-30) as known 2026-04-02
