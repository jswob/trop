model mini
  tally 2
  on 2026-11-05
  start 2026-10-01
  end 2026-12-31

source s "Oświadczenia gospodarstwa"

unit PLN: currency minor 0.01

kind jobs
kind wages: event certain
  leg cash: PLN

place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

input bank: observed
input pay_dom[j in jobs]: int
input salary[j in jobs, m in months]: money PLN question "Ile wynosi pensja z tej pracy w tym miesiącu?"

move wage[m in months, j in jobs over m]: wages
  on day_of(m, pay_dom[j])
  at start_of(m)
  leg cash from world to konto amount salary[j, m]

version home
  cite s
  governs 2026-10..
  known 2026-10-01
  jobs + [acme] lives 2020-02-01..
  pay_dom = 10 "umowa, § 5"
  salary = 7 000.00 PLN "umowa, § 4"
  opening[konto] = 1 000.00 PLN at 2026-10-01 start "wyciąg"

version st
  cite s
  governs 2026-10..
  known 2026-10-02
  anchor konto
  stated[konto] = 5.00 PLN at 2026-10-20 end "x"

version later
  cite s
  governs 2026-10..
  known 2026-10-03
  anchor konto
  replace stated[konto] = none at 2026-10-20 end

ask q: bal(konto, 2026-10-31)
ask q2: bal(konto, 2026-10-31) as known 2026-10-02
ask q3: residuals konto 2026-10
ask q4: explain bal(konto, 2026-10-31)
