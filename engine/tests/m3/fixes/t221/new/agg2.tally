model ag
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31

source s "invented"

kind ks

input wd[k in ks]: date

version v
  cite s
  governs always
  known 2026-01-01
  ks + [k1, k2] lives 2026-01-01..
  wd[k1] = window(2026-03-05, 2026-03-07) "s"
  wd[k2] = 2026-03-10 "s"

ask m: mean(days_between(2026-03-01, wd[k]) for k in ks on 2026-03-01)
ask q: quantile(days_between(2026-03-01, wd[k]) for k in ks on 2026-03-01, 0.5)
ask x: wd[k1]
