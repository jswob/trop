model r18c1
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "invented"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

kind ks

input x[k in ks]: num
input pick: int

version v
  cite s
  governs always
  known 2026-01-01
  ks + [k1, k2] lives 2026-01-01..
  x[k1] = 1 "s"
  x[k2] = 2 "s"

version law26
  cite s
  governs 2026..
  known 2026-01-01
  pick = 2 "s"

ask q: x[k] for k in ks on 2026-03-01 where x[k] == pick
