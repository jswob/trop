model cal221_3
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "invented"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

input cal1: calendar
input cal2: calendar

version v
  cite s
  governs always
  known 2026-01-01
  cal1 = calendar(weekends [sat, sun], added [one_of([2026-06-22, 2026-06-24])]) "c1"
  cal2 = calendar(weekends [sat, sun], added [one_of([2026-06-22, 2026-06-24])]) "c2"

ask c3: is_business(2026-06-22, cal1) and is_business(2026-06-24, cal2)
