model m
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source plan "p"

unit PLN: currency minor 0.01

kind rents: event certain
  leg cash: PLN

place konto: accounts PLN lives 2026-01-01..

place landlord: outside lives 1900-01-01..

input rent_amt: money PLN

input back_amt: money PLN

input act_day: date

input one: num

input back_day: date

move rent[m in months]: rents
  on start_of(m)
  at start_of(m)
  leg cash from konto to landlord amount rent_amt

move back[a in adjustments over .. where a.adjusts in rents and mean(one for k in months where start_of(k) <= act_day) > 0]: transfers
  on act_day
  at a.day
  leg cash from konto to landlord amount back_amt
  fulfils a

version v
  cite plan
  governs 2026..
  known 2026-01-01
  rent_amt = 900.00 PLN
  back_amt = 100.00 PLN

version v2
  cite plan
  governs 2026..
  known 2026-03-15
  replace rent_amt = 950.00 PLN "raise"

version day
  cite plan
  governs 2026..
  known 2026-01-01
  act_day = 2026-04-05
  back_day = 2026-04-20

ask q: bal(konto, 2026-04-30) law cut

version fx
  cite plan
  governs always
  known 2026-01-01
  one = 1
