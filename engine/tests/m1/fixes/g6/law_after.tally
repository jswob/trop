model hh
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "G6 review B1: a base move before from, read at a law date after it"

source card "card"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input fee: money PLN

input pay_day: date

input law_day: date

move pay: transfers
  on pay_day
  at law_day
  leg cash from world to konto amount fee

version card_2026
  cite card
  governs always
  known 2026-01-01
  fee = 100.00 PLN "the card"
  pay_day = 2026-03-01 "the card"
  law_day = 2026-08-01 "the card"
  opening[konto] = 0.00 PLN at 2026-01-01 start "the card"
