model decided
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "T's vector from M1's property scenario-before-19 (issue #108, invented): law_after.tally's movement before from, read at a law date after it, with a decision before from beside it; E 9 item 3 lists the movement whatever else ran before from"

source card "T's card (invented)"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place savings: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input fee: money PLN

input floor: money PLN

input law_day: date

input pay_day: date

input sweep_day: date

move pay: transfers
  on pay_day
  at law_day
  leg cash from world to konto amount fee

move sweep: transfers
  on sweep_day
  reads konto
  leg cash from konto to savings amount max(0 PLN, bal(konto) - floor)

ask b0: bal(konto, 2026-06-30)

version card_2026
  cite card
  governs always
  known 2026-01-01
  fee = 100.00 "the fee"
  floor = 50.00 "the sweep's floor"
  law_day = 2026-08-01 "the pay's law date, after from"
  opening[konto] = 200.00 at 2026-01-01 start "the opening"
  opening[savings] = 0.00 at 2026-01-01 start "the opening"
  pay_day = 2026-03-01 "the pay's day, before from"
  sweep_day = 2026-02-01 "the decision's day, before from"
