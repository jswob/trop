model t
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01

kind brokerages: place any min 0

input vd: date

place konto: accounts PLN lives 2026-01-01..

ask k: value(broker, vd) in PLN

version v
  cite s
  governs always
  known 2025-12-01
  brokerages + [broker] lives 2026-01-01..
  vd = 2026-06-30
  opening[konto] = 1 000.00 PLN at 2026-01-01 start
  opening[broker] = 50.00 EUR at 2026-01-01 start
