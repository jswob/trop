model t
  tally 2
  on 2026-10-18
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
input day: date
input keep: money PLN
input floor: money PLN
input fee: money PLN
place konto: accounts PLN lives 2025-01-01..
place savings: accounts PLN lives 2025-01-01..
place kasa: accounts PLN lives 2025-01-01..
place world: outside lives 1900-01-01..

move save: transfers
  on day
  reads konto, top
  before spend
  leg cash from konto to savings amount max(0 PLN, bal(konto) - keep - flows(top, day))

move spend: transfers
  on day
  reads kasa
  before top
  leg cash from kasa to world amount min(bal(kasa), fee)

move top: transfers
  on day
  reads konto
  leg cash from world to konto amount max(0 PLN, floor - bal(konto))

ask a: flows(save, 2026-01-15)
ask b: flows(top, 2026-01-15)
ask c: bal(konto, 2026-01-15)

version v
  cite s
  governs always
  known 2026-01-01
  day = 2026-01-15 "s"
  keep = 50.00 PLN "s"
  floor = 80.00 PLN "s"
  fee = 5.00 PLN "s"
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"
  opening[savings] = 0.00 PLN at 2026-01-01 start "s"
  opening[kasa] = 10.00 PLN at 2026-01-01 start "s"
