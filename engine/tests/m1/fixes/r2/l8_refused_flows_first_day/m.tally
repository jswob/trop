model g7_flows_refused_plan
  tally 2
  on 2026-02-15
  start 2026-01-01
  end 2026-03-31

source fixture "invented values"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-03

place konto: accounts PLN lives 2026-01-01..

place box: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input dec_dom: int

input fee_amt: money PLN

input wdiv[m in month]: num

move topup[m in month]: transfers
  on day_of(m, dec_dom)
  when 1 / wdiv[m] > 0
  leg cash from world to (if 1 / wdiv[m] > 0 then box else konto) amount fee_amt

ask q_start: flows(box, 2026-01-01 .. 2026-01-31), flows(konto, 2026-01-01 .. 2026-01-31)

ask q_whole: flows(box, 2026-01-01 .. 2026-03-31), flows(konto, 2026-01-01 .. 2026-03-31)

ask q_ends_before: flows(box, 2026-02-01 .. 2026-02-19), flows(konto, 2026-02-01 .. 2026-02-19)

ask q_ends_on: flows(box, 2026-02-01 .. 2026-02-20), flows(konto, 2026-02-01 .. 2026-02-20)

ask q_ends_after: flows(box, 2026-02-01 .. 2026-02-21), flows(konto, 2026-02-01 .. 2026-02-21)

ask q_starts_before: flows(box, 2026-02-19 .. 2026-03-31), flows(konto, 2026-02-19 .. 2026-03-31)

ask q_starts_on: flows(box, 2026-02-20 .. 2026-03-31), flows(konto, 2026-02-20 .. 2026-03-31)

ask q_starts_after: flows(box, 2026-02-21 .. 2026-03-31), flows(konto, 2026-02-21 .. 2026-03-31)

ask q_one_day: flows(box, 2026-02-20 .. 2026-02-20), flows(konto, 2026-02-20 .. 2026-02-20)

version facts
  cite fixture
  governs always
  known 2025-12-01
  dec_dom = 20 "the day of the month"
  fee_amt = 3.00 "a fee"
  wdiv[2026-01] = 1 "answered"
  wdiv[2026-02] = 0 "a division by zero: the when and the place are refused"
  wdiv[2026-03] = 2 "answered"
  opening[konto] = 100 at 2026-01-01 start
  opening[box] = 0 at 2026-01-01 start
