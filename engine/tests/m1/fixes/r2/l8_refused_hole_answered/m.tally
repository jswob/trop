model h94
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source card "invented"

unit PLN: currency minor 0.01

input dday: date

input amt: money PLN

input div: int

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

move pay: transfers
  on dday
  when 1 / div > 0
  leg cash from world to konto amount amt

ask early: bal(konto, 2026-02-15)
ask late: bal(konto, 2026-06-30)

version v1
  cite card
  governs always
  known 2026-01-01
  dday = 2026-02-01 "c"
  div = 1 "c"
  opening[konto] = 10.00 PLN at 2026-01-01 start "c"

version v2
  cite card
  governs always
  known 2026-03-01
  amt = 100.00 PLN "c"
  replace div = 0 "c"
