model oe
  tally 2
  on 2026-03-15
  start 2026-01-01
  end 2026-03-31
  note "T, M3 C5, gate 8's walk/order.rs own_earlier_obs (E §4.2 step 3, L §5.19): a decision computed less its own observation dated on the run's first day (January), and not less one dated on its own day, booked after it runs (February)"

source fixture "T's fixture (invented values)"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-03

place konto: accounts PLN lives 2026-01-01..

place jar: accounts PLN lives 2026-01-01..

place other: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input bank: observed

input dec_dom: int

input keep: money PLN

input step: money PLN

move sweep[m in month]: transfers
  on day_of(m, dec_dom)
  at start_of(m)
  reads konto, jar
  leg cash from konto to jar amount bal(konto) - bal(jar) - keep

move twin[m in month]: transfers
  on day_of(m, dec_dom)
  at start_of(m)
  reads other
  leg cash from world to other amount bal(other) + step

version facts
  cite fixture
  governs always
  known 2025-12-01
  dec_dom = 20 "the decisions' day of the month"
  keep = 2 000.00 PLN "what konto keeps above the jar"
  step = 1.00 PLN "a small step"

version openings
  cite fixture
  governs always
  known 2025-12-31
  opening[konto] = 3 000.00 PLN at 2026-01-01 start
  opening[jar] = 200.00 PLN at 2026-01-01 start
  opening[other] = 10.00 PLN at 2026-01-01 start

version bank_jan
  cite fixture
  governs 2026-01
  known 2026-02-02
  covers konto
  bank[b20260101] = (on: 2026-01-01, kind: transfers, leg cash from konto to jar amount 700.00 PLN, fulfils: sweep[2026-01]) "the sweep, on the run's first day"

ask q_sweep: explain sweep[2026-01]

ask q_twin: explain twin[2026-01]

ask q_bal: bal(konto, d), bal(jar, d), bal(other, d) for d in [2026-01-19, 2026-01-20, 2026-01-31] law cut

version bank_feb
  cite fixture
  governs 2026-02
  known 2026-03-02
  covers konto
  bank[b20260220] = (on: 2026-02-20, kind: transfers, leg cash from konto to jar amount 650.00 PLN, fulfils: sweep[2026-02]) "the sweep, on its own day"

ask q_sweep_feb: explain sweep[2026-02]

ask q_bal_feb: bal(konto, d), bal(jar, d) for d in [2026-02-19, 2026-02-20, 2026-02-28] law cut
