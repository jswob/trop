model wf
  tally 2
  on 2026-03-31
  start 2026-01-01
  end 2026-03-31
  note "T, M3 C5, gate 8's walk/flows.rs Sums::place_log (L §4.4, §5.14.3; P29): flows over a span after windows opened: one window closed before the span is decided (its movement dated before it), one that crosses the span's start is its hole, a refused movement dated by a window that closed before the span leaves it alone, and movements whose days are holes: a hole in every span, the one whose amount is refused too; a move's flows over a window (flows_hole's question, walk/move_flows.rs), and a user's question whose words end ' for a balance', kept as written (hole/questions.rs Asked::for_read)"

source fixture "T's fixture (invented values)"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place konto_b: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input early_day: date

input cross_day: date

input bad_day: date

input when_day: date

input bad_when_day: date

input early_amt: money PLN

input cross_amt: money PLN

input base_amt: money PLN

input parts: num

input odd_amt: money PLN

input odd_day: date

move early: transfers
  on early_day
  leg cash from world to konto amount early_amt

move cross: transfers
  on cross_day
  leg cash from world to konto amount cross_amt

move maybe: transfers
  on when_day
  leg cash from world to konto amount cross_amt

move bad_maybe: transfers
  on bad_when_day
  leg cash from world to konto_b amount round(base_amt / parts, minor(PLN), half-up)

move odd: transfers
  on odd_day
  leg cash from world to konto amount odd_amt

move bad: transfers
  on bad_day
  leg cash from world to konto_b amount round(base_amt / parts, minor(PLN), half-up)

version facts
  cite fixture
  governs always
  known 2025-12-01
  early_day = window(2026-02-01, 2026-02-10) "some day early in February"
  cross_day = window(2026-02-10, 2026-02-20) "some day in mid-February"
  bad_day = window(2026-02-01, 2026-02-12) "some day early in February"
  when_day = ?"when is the maybe paid?" "unknown"
  bad_when_day = ?"when is the bad one paid?" "unknown"
  early_amt = 100.00 PLN "the early payment"
  cross_amt = 50.00 PLN "the crossing payment"
  base_amt = 90.00 PLN "the base"
  parts = 0 "no parts: a division by zero"
  odd_amt = ?"how much is kept for a balance" "a question whose words end as a window's do"
  odd_day = 2026-02-16 "the odd payment's day"
  opening[konto] = 1 000.00 PLN at 2026-01-01 start
  opening[konto_b] = 1 000.00 PLN at 2026-01-01 start

ask q_mid: flows(konto, 2026-02-15 .. 2026-02-28) law cut

ask q_after_early: flows(konto, 2026-02-11 .. 2026-02-28) law cut

ask q_late: flows(konto, 2026-02-21 .. 2026-02-28) law cut

ask q_whole: flows(konto, 2026-02-01 .. 2026-02-28) law cut

ask q_bad: flows(konto_b, 2026-02-15 .. 2026-02-28) law cut

ask q_bad_late: flows(konto_b, 2026-02-21 .. 2026-02-28) law cut

ask q_move: flows(cross, 2026-02-15 .. 2026-02-28) law cut

ask q_move_whole: flows(early, 2026-02-01 .. 2026-02-28), flows(early, 2026-02-05 .. 2026-02-28) law cut

ask q_odd: flows(odd, 2026-02-01 .. 2026-02-28) law cut
