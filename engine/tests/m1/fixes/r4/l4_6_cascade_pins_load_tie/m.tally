model c7b
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source card "invented"

index ks = [k1, k2]

input r[k in ks]: num

def tot: num = sum(r[k] for k in ks) at reader

ask e: tot as if {r[k1] = 5, r[k1] = 7} law 2026-06-30

version v
  cite card
  governs 2026..
  known 2026-01-01
  r[*] = 1 "c"
