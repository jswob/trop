model c120
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source card "invented"

index qs = [q1, q2]

input ten: num

input w[k in qs]: num

def tot: num = w[q1] + w[q2]

ask s1: solve tot == ten for w[q1] in [0, 100] to 1 with w[*] = 3

ask s2: tot with w[*] = 3

version v
  cite card
  governs always
  known 2026-01-01
  ten = 10 "c"
  w[q1] = 1 "c"
  w[q2] = 2 "c"
