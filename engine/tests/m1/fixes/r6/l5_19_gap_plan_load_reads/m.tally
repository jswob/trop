model g8
  tally 2
  on 2025-01-01
  start 2025-01-01
  end 2025-03-31
unit DUK: currency minor 0.01
source s "s"
place konto: accounts DUK lives 2025-01-01..
place world: outside lives 2025-01-01..
move fee[m in months]: transfers
  on end_of(m)
  leg cash from world to konto amount gap(konto, start_of(m))
version v
  cite s
  governs always
  known 2025-01-01
  anchor konto
  stated[konto] = 5.00 DUK at 2025-01-01 end "s"
ask q: bal(konto, 2025-03-31)
