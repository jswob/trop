model lowc
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-06-30
  note "a one-day low read by a decision on its own day (invented; review-g8.md's list): the plain balance of that day is the decision's own, RUN-CYCLE"

source card "probe card"

unit PLN: currency minor 0.01

kind promises: transfers uncertain

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input rent_amt: money PLN

input rent_day: date

input wage_amt: money PLN

input wage_day: date

input gift_amt: money PLN

input gift_day: date

input odd_amt: money PLN

input a_day: date

input b_day: date

input top_day: date

input odd_day: date

def floor_ahead: money PLN = low(konto, a_day .. b_day) from a_day

def top_up: money PLN = max(0 PLN, -floor_ahead)

move rent: transfers
  on rent_day
  leg cash from konto to world amount rent_amt

move wage: transfers
  on wage_day
  leg cash from world to konto amount wage_amt

move gift: promises
  on gift_day
  leg cash from world to konto amount gift_amt

move topup: transfers
  on top_day
  reads konto
  leg cash from world to konto amount top_up

move odd: transfers
  on odd_day
  leg cash from konto to world amount odd_amt

version card_2026
  cite card
  governs always
  known 2026-01-01
  a_day = 2026-03-01 "the card"
  b_day = 2026-04-30 "the card"
  odd_day = 2026-05-10 "the card"
  top_day = 2026-04-20 "the card"
  gift_amt = 400.00 PLN "the card"
  gift_day = 2026-03-20 "the card"
  odd_amt = ?"what does the odd bill come to?" "the card"
  opening[konto] = 1000.00 PLN at 2026-01-01 start "the card"
  rent_amt = 2500.00 PLN "the card"
  rent_day = 2026-03-10 "the card"
  wage_amt = 3000.00 PLN "the card"
  wage_day = 2026-04-10 "the card"


input c_day: date

def own_low: money PLN = max(0 PLN, -low(konto, c_day .. c_day))

move topc: transfers
  on c_day
  reads konto
  leg cash from world to konto amount own_low

version card_c
  cite card
  governs always
  known 2026-01-01
  c_day = 2026-05-20 "the card"

ask c_bal: bal(konto, 2026-05-31)

ask c_low: low(konto, 2026-05-01 .. 2026-05-31)
