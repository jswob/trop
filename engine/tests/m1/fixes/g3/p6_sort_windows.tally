model p6
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source card "invented"

index ks = [k0, k1, k2, k3, k4, k5, k6, k7, k8, k9, k10, k11, k12, k13, k14, k15, k16, k17, k18, k19, k20, k21, k22, k23, k24, k25, k26, k27, k28, k29]

input v[k in ks]: int

input w[k in ks]: date

ask a: argmin(v[k] for k in ks) ties by w[k]

ask b: first(k in ks where v[k] == v[k0]) ties by w[k]

version v1
  cite card
  governs always
