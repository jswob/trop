model plc
  tally 2
  on 2027-01-01
  start 2027-01-01
  end 2028-12-31
  note "T C10 (invented): F4g's form where the walk refuses an event's leg (RUN-PLACE, its place min 0): the def read through the walk up to the leg's day meets the walk's refusal of the leg; and an ask at an earlier cut, whose version refuses another leg, after the later cut's walks up to those days (MB5's prefix walk, the kept walk's cut)"

source card "T's card (invented)"

unit PLN: currency minor 0.01

kind pot: place PLN min 0

kind ovs: event certain
  leg cash: PLN

input q[m in months]: money PLN

input base: money PLN

place acct: accounts PLN lives 2027-01-01..

place sav: pot lives 2027-01-01..

place bank: outside lives 2027-01-01..

def p[m in months]: money PLN = if pos(m) == 1 then base else p[m - 1] - sum(o.cash.amount for o in ovs over m)

move pay[m in months]: transfers
  on start_of(m)
  leg cash from acct to bank amount p[m]

move op[m in months]: ovs
  on start_of(m)
  leg cash from sav to acct amount q[m]

ask t: p[m] for m in [2027-01, 2027-04]

ask ta: p[2027-03]

ask t3: p[2027-03] as known 2026-12-31

version v0
  cite card
  governs always
  known 2026-12-01
  base = 1000.00 PLN "c"
  q[2027-01] = 10.00 PLN "c"
  q[2027-02] = 20.00 PLN "c"
  q[2027-03] = 5.00 PLN "c"
  q[2027-04] = 40.00 PLN "c"
  opening[acct] = 5000.00 PLN at 2027-01-01 start "c"
  opening[sav] = 25.00 PLN at 2027-01-01 start "c"

version v
  cite card
  governs always
  known 2027-01-01
  replace q[2027-02] = 2.00 PLN "c"
