model two
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "G14 probes: pins formed per binding tuple over two bindings (L §8.2)"

source card "card (invented)"

index qs = [q1, q2]

input v[k in qs]: num

input w2[j in qs, k in qs]: num

def e2[j in qs, k in qs]: num = w2[j, k] + 1

def f[k in qs]: num = v[k] + v[k]

def ge[k in qs]: num = f[k] as if {v[k] = 1}

def gk[k in qs]: num = f[k] as if {v[k] = v[k] + m[k]}

def gw[j in qs]: num = sum(e2[j, k] as if {w2[j, k] = m[j]} for k in qs)

input m[k in qs]: num







version v1
  cite card
  governs always
  known 2026-01-01
  v[q1] = 1 "card"
  v[q2] = 2 "card"
  w2[*, *] = 10 "card"
  m[q1] = 3 "card"
  m[q2] = 4 "card"
