model tl
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31

source s "made up"

unit DUK: currency minor 0.01

axis pa
  lo "lower pay"
  hi "higher pay"

axis da
  early "paid in march"
  late "paid in july"

axis ra
  dn "rounds down"
  upw "rounds up"

place konto: accounts DUK lives 2026-01-01..

place oszcz: accounts DUK lives 2026-01-01..

place world: outside lives 2026-01-01..

input p_lo: money DUK

input p_hi: money DUK

input d1: date

input d2: date

input fee: money DUK

input parts: int

def pay: money DUK at d1
  rule base = p_lo
  rule hi beats base = p_hi when pa == hi

def day: date at d1
  rule base = d1
  rule late beats base = d2 when da == late

def share: money DUK at d2
  rule base = round(pay / parts, minor(DUK), down)
  rule up beats base = round(pay / parts, minor(DUK), up) when ra == upw

move salary: transfers
  on day
  leg cash from world to konto amount pay

move charge: transfers
  on d1
  leg cash from konto to world amount fee

move save: transfers
  on d2
  leg cash from konto to oszcz amount share

ask q_bal_mid: bal(konto, 2026-06-30) law 2026-10-25

ask q_bal_end: bal(konto, 2026-12-31) law 2026-10-25

ask q_oszcz: bal(oszcz, 2026-12-31) law 2026-10-25

ask q_flows_charge: flows(charge, 2026-03-01) law 2026-10-25

ask q_both: bal(konto, 2026-06-30), bal(oszcz, 2026-12-31) law 2026-10-25

ask q_pin: bal(konto, 2026-12-31) with pa = hi law 2026-10-25

ask q_asif: bal(konto, 2026-12-31) as if {da = late} law 2026-10-25

ask q_fee: fee law 2026-10-25

version v
  cite s
  governs always
  known 2026-01-01
  p_lo = 1000.00
  p_hi = 1200.00
  d1 = 2026-03-01
  d2 = 2026-07-01
  fee = 10.00
  parts = 3
