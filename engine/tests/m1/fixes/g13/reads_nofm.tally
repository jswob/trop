model reads
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "T's carried item 2 (issue #108, invented): reads at run (L §2.5, §5.6): a kind-keyed input read at a key a row gives, a stepped range's input at a key no row states, a row for every key of a stepped range, money and fraction ranges"

source card "T's card (invented)"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place savings: accounts PLN lives 2026-01-01..

input at_frac: num

input at_money: money PLN

input by_frac[f in 0.5 .. 2.5 step 0.5]: num

input by_money[a in 0 PLN .. 10 PLN step 1 PLN]: num

input chosen: key accounts

input k_at: int

input rate_of[x in accounts]: num

input rr[k in 1 .. 9 step 2]: num

input star[k in 1 .. 9 step 2]: num

ask d_kind_key: rate_of[chosen]

ask d_places: bal(konto, 2026-06-30), bal(savings, 2026-06-30)

ask d_unstated: rr[k_at]

ask d_star: star[5]

ask d_money: by_money[at_money]

ask d_frac: by_frac[at_frac]

version card_2026
  cite card
  governs always
  known 2026-01-01
  at_frac = 1.5 "the card"
  at_money = 3.00 PLN "the card"
  chosen = savings "the card"
  k_at = 7 "the card"
  rate_of[konto] = 0.01 "the card"
  rate_of[savings] = 0.03 "the card"
  rr[1] = 0.1 "the card"
  rr[3] = 0.3 "the card"
  rr[5] = 0.5 "the card"
  star = 0.5 "the card: every key"
  opening[konto] = 0.00 PLN at 2026-01-01 start "the card"
  opening[savings] = 0.00 PLN at 2026-01-01 start "the card"
