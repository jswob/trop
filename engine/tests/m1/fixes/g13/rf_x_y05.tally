part y05
  tally 2

kind evs: event certain
  leg what: any

input fee: money PLN

move mv: evs
  on d1
  leg what from konto to world amount fee
ask y05: count(m in evs over d1 .. d2 where weekday(m.what.amount) == weekday(d1))

version v_y05
  cite card
  governs always
  known 2026-01-01
  opening[konto] = 100.00 PLN at 2026-01-01 start "c"
  fee = 10.00 PLN "c"
