part a1
  tally 2

index ps = [p0, q1, p2]

input kq: key qs

def x1: key qs = q1 + 1
def x2: key ps = q1 + 1
def x3: bool = kq == q1 + 1
def x4: num = rate[q2 - 1] + rate[kq]
def x5: key qs = if n1 > 0 then q2 - 1 else q1
def x7: bool = x1 == q2

ask a1: x1, x3, x4, x5, x7, rate[x1 - 1]
ask a1b: x2
ask a1c: x1

version v_a1
  cite card
  governs always
  known 2026-01-01
  kq = q2 "c"
