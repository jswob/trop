part r_min_where
  tally 2

input bm[a in 0 PLN .. 20 PLN step 1 PLN]: num

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from konto to world amount fee

def r_min_where_x: money PLN = sum(min(v for v in 0 PLN .. m.what.amount step 1 PLN where v >= fee) for m in evs over d0..d0)

ask r_min_where: r_min_where_x

version v_r_min_where
  cite card
  governs always
  known 2026-01-01
  bm[10 PLN] = 0.5 "c"
