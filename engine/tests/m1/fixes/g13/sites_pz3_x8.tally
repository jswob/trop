part x8
  tally 2

input rr: rate

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from konto to world amount fee

def x8_x: num = sum(m.what.amount * 1 day / 1 month for m in evs over d0..d0)

ask x8: x8_x

version vz
  cite card
  governs always
  known 2026-01-01
  rr = 5 %/year "c"
