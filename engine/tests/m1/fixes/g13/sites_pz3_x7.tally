part x7
  tally 2

input rr: rate

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from konto to world amount fee

def x7_x: num = sum(m.what.amount / m.what.amount + rr for m in evs over d0..d0)

ask x7: x7_x

version vz
  cite card
  governs always
  known 2026-01-01
  rr = 5 %/year "c"
