part r_int_end
  tally 2

input bm[a in 0 PLN .. 20 PLN step 1 PLN]: num

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from konto to world amount fee

def r_int_end_x: int = sum(count(v in 1 .. m.what.amount) for m in evs over d0..d0)

ask r_int_end: r_int_end_x

version v_r_int_end
  cite card
  governs always
  known 2026-01-01
  bm[10 PLN] = 0.5 "c"
