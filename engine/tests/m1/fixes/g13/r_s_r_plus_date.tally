part r_plus_date
  tally 2

input bm[a in 0 PLN .. 20 PLN step 1 PLN]: num

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from konto to world amount fee

def r_plus_date_x: int = count(m for m in evs over d0..d0 where m.what.amount + d0 == d0)

ask r_plus_date: r_plus_date_x

version v_r_plus_date
  cite card
  governs always
  known 2026-01-01
  bm[10 PLN] = 0.5 "c"
