part r_abs_r5
  tally 2

input bm[a in 0 PLN .. 20 PLN step 1 PLN]: num

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from konto to world amount fee

def r_abs_r5_x: money PLN = sum(m.what.amount + r5 for m in evs over d0..d0)

ask r_abs_r5: r_abs_r5_x

version v_r_abs_r5
  cite card
  governs always
  known 2026-01-01
  bm[10 PLN] = 0.5 "c"
