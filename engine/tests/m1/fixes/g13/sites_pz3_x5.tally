part x5
  tally 2

input rr: rate

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from konto to world amount fee

def x5_x: num = sum(m.what.amount * rr * 1 month for m in evs over d0..d0)

ask x5: x5_x

version vz
  cite card
  governs always
  known 2026-01-01
  rr = 5 %/year "c"
