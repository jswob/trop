part r_money_step
  tally 2

input bm[a in 0 PLN .. 20 PLN step 1 PLN]: num

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from konto to world amount fee

def r_money_step_x: int = sum(count(v in 0 PLN .. fee step m.what.amount) for m in evs over d0..d0)

ask r_money_step: r_money_step_x

version v_r_money_step
  cite card
  governs always
  known 2026-01-01
  bm[10 PLN] = 0.5 "c"
