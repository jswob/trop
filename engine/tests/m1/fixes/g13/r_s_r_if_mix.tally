part r_if_mix
  tally 2

input bm[a in 0 PLN .. 20 PLN step 1 PLN]: num

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from konto to world amount fee

def r_if_mix_x: int = count(m for m in evs over d0..d0 where (if n1 > 0 then m.what.amount else d0) == d0)

ask r_if_mix: r_if_mix_x

version v_r_if_mix
  cite card
  governs always
  known 2026-01-01
  bm[10 PLN] = 0.5 "c"
