part x6
  tally 2

input rr: rate

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from konto to world amount fee

def x6_x: num = sum(rr * m.what.amount / m.what.amount for m in evs over d0..d0)

ask x6: x6_x

version vz
  cite card
  governs always
  known 2026-01-01
  rr = 5 %/year "c"
