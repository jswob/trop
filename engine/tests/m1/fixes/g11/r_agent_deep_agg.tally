model d2
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source card "card"

index ms = int 1..34

input inc: num

index two = [a1, a2]

input off[k in two]: int

def acc[k in ms]: num
  rule first beats next = inc when pos(k) == 1
  rule next = acc[k - 1] + inc

def h: num = max(acc[33], acc[34])

def h2: num = max(acc[off[k]] for k in two)

ask v: h

ask v2: h2

ask e_h2: explain h2

ask e_h: explain h

version card_2026
  cite card
  governs always
  known 2026-01-01
  inc = 1
  off[a1] = 33
  off[a2] = 34
