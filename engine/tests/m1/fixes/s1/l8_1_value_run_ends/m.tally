model g
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-06-30

source s "s"
unit PLN: currency minor 0.01
input pay_day: date
input pay_amt: money PLN
place konto: accounts PLN lives 2025-01-01..
place world: outside lives 1900-01-01..

move pay: transfers
  on pay_day
  leg cash from world to konto amount pay_amt

ask va: value(konto, 2026-08-31) in PLN
ask vb: value(konto, 2025-12-31) in PLN
ask vin: value(konto, 2026-06-30) in PLN
ask ba: bal(konto, 2026-08-31)
ask bb: bal(konto, 2025-12-31)

version v
  cite s
  governs always
  known 2025-12-01
  pay_day = 2026-02-02
  pay_amt = 500.00 PLN
  opening[konto] = 0.00 PLN at 2026-01-01 start
