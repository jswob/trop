model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
unit PLN: currency minor 0.01
kind wages: event certain
  leg cash: PLN
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
input wage_amt: money PLN
input wage_day: date

def worth[d in days]: money PLN = bal(konto, d) at d

move wage: wages
  on wage_day
  leg cash from world to konto amount wage_amt

version plan_2026
  cite plan
  governs always
  known 2026-01-01
  wage_amt = 5 000.00 PLN "umowa"
  wage_day = 2026-01-10 "umowa"
  opening[konto] = 0 PLN at 2026-01-01 start "wyciąg"

ask q: worth[2026-01-31]
ask w: explain worth[2026-01-31]
