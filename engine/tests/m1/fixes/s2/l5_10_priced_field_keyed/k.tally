model pr
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "synthetic"
unit PLN: currency minor 0.01
unit etf "fund unit"
index bx = [b1, b2]

place fund: holdings etf priced fp[b1].nav lives 2026-01-01..
place fund2: holdings etf priced fp[b2].nav lives 2026-01-01..

input fp[b in bx]: (nav num PLN/etf, note text) reading

ask a4: value(fund, 2026-03-01) in PLN law 2026-06-30
ask a5: value(fund2, 2026-03-01) in PLN law 2026-06-30

version v1
  cite s
  governs always
  known 2026-01-01
  fp[b1] = (nav: 12.50 PLN/etf, note: "x") at 2026-03-01 "wycena"
  opening[fund] = 10 etf at 2026-01-01 start "own"
  opening[fund2] = 4 etf at 2026-01-01 start "own"
