model r8_reach
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.7, R8's reach (#147), from L §5.5's Fan-out alone: an ask line of any form evaluates every combination of the axes its evaluation reads, and prints one line per distinct result, an axis printed * where every option gives it. Features no item of R8 names: a check whose one side reads an axis (c_*, twin c_plain, which reads none), and explain of a def under an unpinned axis (e_*, twin e_pinned)"

source s "made up"

unit PLN: currency minor 0.01

axis ax
  lo "low"
  hi "high"

input p: money PLN

input twice: int

input asked_on: date

def f: money PLN at asked_on
  rule base = p
  rule hi beats base = p * twice when ax == hi

def plain: money PLN = p at asked_on

ask c_axis: check f == plain law 2026-06-01

ask c_plain: check plain == p law 2026-06-01

ask e_axis: explain f law 2026-06-01

ask e_pinned: explain f with ax = lo law 2026-06-01

version v
  cite s
  governs always
  known 2026-01-01
  p = 10.00 PLN "the card"
  twice = 2 "the card"
  asked_on = 2026-06-01 "the card"
