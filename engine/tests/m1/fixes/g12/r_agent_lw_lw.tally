model bc
  tally 2
  on 2026-03-15
  start 2026-01-01
  end 2026-06-30
  note "review G12: a def's balance cause, readers-of a kind, uncertain legs, readings"

source card "card (invented)"

unit PLN: currency minor 0.01

kind maybe: transfers uncertain

kind pays: event certain
  leg cash: PLN

kind subpays: pays

index month = month 2026-01..2026-06

place konto: accounts PLN lives 2026-01-01..

place jar: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input bank: observed

input fee: money PLN

input bonus: money PLN

input rent_dom: int

input b_day: date

input mark: money PLN

move rent[m in month]: transfers
  on day_of(m, rent_dom)
  leg cash from konto to world amount fee

move gift: maybe
  on b_day
  leg cash from world to konto amount bonus

move salary[m in month]: pays
  on day_of(m, rent_dom)
  leg cash from world to konto amount bonus

def head[m in month]: money PLN = bal(konto, start_of(m)) - fee

def both[m in month]: money PLN = bal(konto, end_of(m)) + bal(jar, end_of(m))

def gap_ok[m in month]: bool = bal(konto, end_of(m)) > mark

def n_pays[m in month]: money PLN = sum(p.cash.amount for p in pays over start_of(m) .. end_of(m))

ask l0: low(konto, 2026-04-01 .. 2026-05-31) with uncertain, low(konto, 2026-04-01 .. 2026-05-31)

ask l1: explain low(konto, 2026-04-01 .. 2026-05-31) with uncertain

ask l2: explain low(konto, 2026-04-01 .. 2026-05-31)

ask l3: explain bal(konto, 2026-04-30) from 2026-03-20 with uncertain

ask e1: explain head[2026-02]

ask e2: explain both[2026-04]

ask e3: explain gap_ok[2026-05]

ask e4: explain bal(konto, 2026-02-28)

ask e5: explain bal(konto, 2026-04-30) with uncertain

ask e6: explain bal(konto, 2026-04-30)

ask e7: explain bal(konto, 2026-05-31) from 2026-04-01 with uncertain

ask e8: explain low(konto, 2026-03-01 .. 2026-05-31) from 2026-03-20

ask e9: explain bal(jar, 2026-03-10)

ask e10: explain gift

ask e11: explain salary[2026-03]

ask r1: readers-of pays

ask r2: readers-of subpays

ask r3: readers-of maybe

ask r4: readers-of konto

ask e12: explain bal(konto, 2025-12-31)

ask e13: explain bal(konto, 2026-07-15)

version card_2026
  cite card
  governs always
  known 2026-01-01
  fee = 40.00 PLN "the card"
  bonus = 15.00 PLN "the card"
  rent_dom = 5 "the card"
  b_day = 2026-04-12 "the card"
  mark = 300.00 PLN "the card"
  opening[konto] = 500.00 PLN at 2026-01-01 start "the card"
  opening[jar] = 0 PLN at 2026-01-01 start "the card"

version bank_feb
  cite card
  governs 2026-02
  known 2026-03-02
  covers konto
  anchor konto
  bank[b0205] = (on: 2026-02-05, kind: transfers, leg cash from konto to world amount 40.00 PLN, fulfils: rent[2026-02]) "the rent"
  bank[b0210] = (on: 2026-02-10, kind: transfers, leg cash from konto to jar amount 25.00 PLN) "a stash"
  stated[konto] = 400.00 PLN at 2026-02-20 end "a balance"
  stated[konto] = 390.00 PLN at 2026-02-28 end "the month's close"
