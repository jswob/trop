model g10_observe
  tally 2
  on 2026-03-15
  start 2026-01-01
  end 2026-03-31
  note "T, issue #41, G10: observations (L §5.19, E §6.1): a transfer between two places two statements cover, one row in each, each booking its own end; a link to an instance that doesn't touch the row's places and one that lacks a leg (RUN-RECORD), each at a place of its own; two rows of different versions that fulfil one instance and disagree (WARN-LEGS) beside two that agree, two of one version that disagree, and two-leg rows that agree; a row a later version restates, read before and after; covered over two versions in turn, over a span half covered, and at a cut on a version's known day; a link whose instance's when reads an assumed row, the register of judging it carried by the row that names it."

source fixture "T's fixture for S's kernel tests (invented values)"

unit PLN: currency minor 0.01

unit etf_unit "a fund unit"

kind buys: event certain
  leg cash: PLN
  leg units: etf_unit

index month = month 2026-01..2026-02

place konto: accounts PLN lives 2026-01-01..

place save: accounts PLN lives 2026-01-01..

place k2: accounts PLN lives 2026-01-01..

place k3: accounts PLN lives 2026-01-01..

place k6: accounts PLN lives 2026-01-01..

place fund: holdings etf_unit priced fund_price lives 2026-01-01..

place fund2: holdings etf_unit priced fund_price lives 2026-01-01..

place shop: outside lives 2026-01-01..

place market: outside lives 2026-01-01..

place world: outside lives 2026-01-01..

input bank: observed

input fund_price[m in month]: num PLN/etf_unit

input rent_amt: money PLN

input rent_dom: int

input fee_day: date

input fee_amt: money PLN

input buy_dom: int

input buy_units[m in month]: num etf_unit

input gift_day: date

input gift_amt: money PLN

input rare_day: date

input rare_ok: bool

input rare_amt: money PLN

move rent[m in month]: transfers
  on day_of(m, rent_dom)
  leg cash from konto to shop amount rent_amt

move fee: transfers
  on fee_day
  leg cash from konto to shop amount fee_amt

move buy[m in month]: buys
  on day_of(m, buy_dom)
  leg cash from konto to market amount round(buy_units[m] * fund_price[m], minor(PLN), half-up)
  leg units from market to fund amount buy_units[m]

move buy2[m in month]: buys
  on day_of(m, buy_dom)
  leg cash from k2 to market amount round(buy_units[m] * fund_price[m], minor(PLN), half-up)
  leg units from market to fund2 amount buy_units[m]

move gift: transfers
  on gift_day
  leg cash from world to save amount gift_amt

move rare: transfers
  on rare_day
  when rare_ok
  leg cash from k6 to shop amount rare_amt

ask q_rare_k6: bal(k6, 2026-02-28) law cut

ask q_rare_konto: bal(konto, 2026-02-28) law cut

ask q_bal: bal(konto, d), bal(save, d), bal(k2, d), bal(k3, d), bal(fund, d) for d in [2026-01-04, 2026-01-10, 2026-01-31, 2026-02-28] law cut

ask q_early: bal(konto, d), bal(save, d) for d in [2026-01-10, 2026-01-31] law cut as known 2026-02-10

ask q_cov: covered(konto, 2026-01-01 .. 2026-02-28), covered(save, 2026-01-01 .. 2026-02-28), covered(save, 2026-01-01 .. 2026-01-31) law cut

ask q_cov_before: covered(konto, 2026-01-01 .. 2026-02-28) law cut as known 2026-03-01

ask q_cov_on: covered(konto, 2026-01-01 .. 2026-02-28) law cut as known 2026-03-02

version facts
  cite fixture
  governs always
  known 2025-12-01
  fund_price[2026-01] = 10 "a unit's price"
  fund_price[2026-02] = 10
  rent_amt = 600.00
  rent_dom = 5 "rent on the 5th"
  fee_day = 2026-01-20 "a fee two rows of one version disagree on"
  fee_amt = 5.00
  buy_dom = 18 "buys on the 18th"
  buy_units[2026-01] = 2 "two units"
  buy_units[2026-02] = 1
  gift_day = 2026-01-15 "a gift into save"
  gift_amt = 9.00
  rare_day = 2026-02-03
  rare_ok = true assumed "the rare payment runs this year"
  rare_amt = 12.00

version openings
  cite fixture
  governs always
  known 2025-12-31
  opening[konto] = 3000 at 2026-01-01 start
  opening[save] = 100 at 2026-01-01 start
  opening[k2] = 500 at 2026-01-01 start
  opening[k3] = 500 at 2026-01-01 start
  opening[k6] = 100 at 2026-01-01 start
  opening[fund] = 0 at 2026-01-01 start
  opening[fund2] = 0 at 2026-01-01 start

version bank_k
  cite fixture
  governs 2026-01
  known 2026-02-05
  covers konto
  bank[k_rent] = (on: 2026-01-05, kind: transfers, leg cash from konto to shop amount 600.00 PLN, fulfils: rent[2026-01]) "the rent"
  bank[k_move] = (on: 2026-01-10, kind: transfers, leg cash from konto to save amount 50.00 PLN) "to savings, as konto's statement shows it"
  bank[k_buy] = (on: 2026-01-18, kind: buys, leg cash from konto to market amount 20.00 PLN, leg units from market to fund amount 2 etf_unit, fulfils: buy[2026-01]) "a purchase, both legs"

version bank_k2
  cite fixture
  governs 2026-02
  known 2026-03-02
  covers konto
  bank[k_rent2] = (on: 2026-02-05, kind: transfers, leg cash from konto to shop amount 600.00 PLN, fulfils: rent[2026-02]) "February's rent"

version bank_s
  cite fixture
  governs 2026-01
  known 2026-02-06
  covers save
  bank[s_move] = (on: 2026-01-10, kind: transfers, leg cash from konto to save amount 50.00 PLN) "to savings, as save's statement shows it"

version bank_x
  cite fixture
  governs 2026-01..2026-02
  known 2026-02-07
  bank[x_rent] = (on: 2026-01-06, kind: transfers, leg cash from konto to shop amount 610.00 PLN, fulfils: rent[2026-01]) "the rent, as the landlord's book has it"
  bank[x_rent2] = (on: 2026-02-05, kind: transfers, leg cash from konto to shop amount 600.00 PLN, fulfils: rent[2026-02]) "February's, agreeing"
  bank[x_fee_a] = (on: 2026-01-20, kind: transfers, leg cash from konto to shop amount 5.00 PLN, fulfils: fee) "the fee"
  bank[x_fee_b] = (on: 2026-01-21, kind: transfers, leg cash from konto to shop amount 6.00 PLN, fulfils: fee) "the fee again, one more"
  bank[x_buy] = (on: 2026-01-18, kind: buys, leg cash from konto to market amount 20.00 PLN, leg units from market to fund amount 2 etf_unit, fulfils: buy[2026-01]) "the purchase, agreeing"

version bank_fix
  cite fixture
  governs 2026-01
  known 2026-02-20
  replace bank[x_rent] = (on: 2026-01-06, kind: transfers, leg cash from konto to shop amount 620.00 PLN, fulfils: rent[2026-01]) "the landlord's book, corrected"

version bank_2
  cite fixture
  governs 2026-01
  known 2026-02-05
  covers k2
  bank[k2_buy] = (on: 2026-01-18, kind: transfers, leg cash from k2 to market amount 20.00 PLN, fulfils: buy2[2026-01]) "a purchase recorded as a transfer: no units leg"

version bank_6
  cite fixture
  governs 2026-02
  known 2026-03-02
  covers k6
  bank[k6_rare] = (on: 2026-02-03, kind: transfers, leg cash from k6 to shop amount 12.00 PLN, fulfils: rare) "the rare payment, whose when reads an assumed row"

version bank_3
  cite fixture
  governs 2026-01
  known 2026-02-05
  covers k3
  bank[k3_gift] = (on: 2026-01-15, kind: transfers, leg cash from k3 to shop amount 9.00 PLN, fulfils: gift) "names the gift into save, which doesn't touch k3 or shop"

