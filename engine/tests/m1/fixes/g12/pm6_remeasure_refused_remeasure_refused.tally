model g11_remeasure_refused
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.2 (issue #34), G11: E §5 step 3, L §5.14.3 Detection, L §8.4: late (known 2026-05-01) re-measures rent[2026-03] at 0 tenants, so its amount is refused (RUN-DIV), and its adjustment is refused with the refusal: unsettled, it refuses what an unfulfilled one makes HOLE-CHANGED, the flows of rent over a span reaching 2026-05-01 and konto's balance from then (q); a binding over adjustments holds it (n), and its change is the refusal (l). The twin before reads konto before 2026-05-01, where it stands. tally 2.1.1 skipped the step: q was (500.00 PLN, 7 000.00 PLN), as if late changed nothing."

source plan "T's invented plan"

source act "T's invented act"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..

place landlord: outside lives 1900-01-01..

input total: money PLN

input tenants[m in months]: int

input dom: int

move rent[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from konto to landlord amount round(total / tenants[m], minor(PLN), half-even)

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  total = 1 000.00 PLN
  dom = 10
  tenants[*] = 2
  opening[konto] = 10 000.00 PLN at 2026-01-01 start

version late
  cite act
  governs 2026-03
  known 2026-05-01
  replace tenants[*] = 0

ask before: bal(konto, 2026-04-30)

ask q: flows(rent, 2026-05-01 .. 2026-05-31), bal(konto, 2026-06-30)

ask n: count(a in adjustments over ..)

ask l: a.change for a in adjustments over ..

ask zm1: explain rent[2026-01]

ask zm2: explain rent[2026-02]

ask zm3: explain rent[2026-03]

ask zm4: explain rent[2026-04]
