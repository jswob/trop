model mv
  tally 2
  on 2026-03-15
  start 2026-01-01
  end 2026-06-30
  note "review G12: a move read by its name in ordinary asks and in moves"

source card "card (invented)"

unit PLN: currency minor 0.01

kind pays: event certain
  leg cash: PLN

index slot = [s1, s2, s3]

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input fee: money PLN

input dom: int

input d1: date

input d2: date

input d3: date

input day_of_slot[s in slot]: date

move rent[s in slot]: pays
  on day_of_slot[s]
  leg cash from konto to world amount fee

move tip: pays
  on d2
  leg cash from konto to world amount rent[s1].cash.amount

move echo: pays
  on d3
  leg cash from konto to world amount echo.cash.amount

def r2: money PLN = rent[s1].cash.amount

def rday: date = rent[s3].day

def self_eq: bool = rent[s1] == rent[s1]

def other_eq: bool = rent[s1] == rent[s2]

def tip_amt: money PLN = tip.cash.amount

ask a1: r2, rday, self_eq, other_eq, tip_amt

ask a2: rent[s1], tip

ask a3: echo

ask a4: explain rent[s1]

ask a5: explain tip

ask a6: explain echo

ask a7: explain r2

ask a8: bal(konto, 2026-03-31)

version card_2026
  cite card
  governs always
  known 2026-01-01
  fee = 40.00 PLN "the card"
  dom = 5 "the card"
  d2 = 2026-02-07 "the card"
  d3 = 2026-03-07 "the card"
  d1 = 2026-01-07 "the card"
  day_of_slot[s1] = 2026-02-05 "the card"
  day_of_slot[s2] = 2026-03-05 "the card"
  day_of_slot[s3] = 2026-04-05 "the card"
  opening[konto] = 500.00 PLN at 2026-01-01 start "the card"
