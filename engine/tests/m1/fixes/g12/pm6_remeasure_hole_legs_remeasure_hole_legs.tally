model g11_remeasure_hole_legs
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.6 (#52's family; MUTANTS-SURVIVORS' against_hole recipe), G11: E §5 step 3: late (known 2026-05-01) makes rent[2026-03]'s when a hole (seats unknown): each leg's adjustment a hole. later (known 2026-07-01) states the seats and makes the March fee a hole, measured against that hole state per leg: the cash leg's amount is known, so its 2026-07-01 adjustment holds the seats question alone; the charge leg's holds the fee's question too. Each leg is measured against its own state, never another leg's."

source plan "T's invented plan"

source act "T's invented act"

unit PLN: currency minor 0.01

kind rentals: event certain
  leg cash: PLN
  leg charge: PLN

place konto_c: accounts PLN lives 2026-01-01..

place konto_f: accounts PLN lives 2026-01-01..

place landlord: outside lives 1900-01-01..

input total: money PLN

input fee[m in months]: money PLN

input dom: int

input seats[m in months]: int

move rent[m in months]: rentals
  on day_of(m, dom)
  at start_of(m)
  when seats[m] > 0
  leg cash from konto_c to landlord amount total
  leg charge from konto_f to landlord amount fee[m]

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  total = 900.00 PLN
  fee[*] = 20.00 PLN
  dom = 10
  seats[*] = 1
  opening[konto_c] = 5 000.00 PLN at 2026-01-01 start
  opening[konto_f] = 1 000.00 PLN at 2026-01-01 start

version late
  cite act
  governs 2026-03
  known 2026-05-01
  replace seats[*] = ?"were the seats taken in March?"

version later
  cite act
  governs 2026-03
  known 2026-07-01
  replace seats[*] = 1
  replace fee[*] = ?"what was March's fee?"

ask c: bal(konto_c, 2026-07-31)

ask f: bal(konto_f, 2026-07-31)

ask l: a.change for a in adjustments over ..

ask zm1: explain rent[2026-01]

ask zm2: explain rent[2026-02]

ask zm3: explain rent[2026-03]

ask zm4: explain rent[2026-04]
