  dest2 = acc_3
  opening[acc_0] = 500.00 DUK at 2025-01-01 start
  opening[acc_1] = 0 DUK at 2025-01-01 start
  opening[acc_2] = 500.00 DUK at 2025-01-01 start
  opening[acc_3] = 0 DUK at 2025-01-01 start

ask zm1: explain mv_0

