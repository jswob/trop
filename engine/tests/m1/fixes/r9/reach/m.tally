model r9_reach
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "T, tally 2.1.7, R9's reach (#148), from L §2.4's Values alone: every value prints in its type's one form wherever it prints, messages too, a key computed at run as its literal, a number that doesn't terminate as a reduced a/b, a date in ISO. Features no item of R9 names: a RUN-KEY message naming a computed number at a stepped range of numbers (k_third; twin k_half, a value of the range), and one naming a computed day at a stepped range of days (d_off; twin d_on)"

source card "T's card (invented)"

input n: int

input three: int

input wk: int

input d0: date

input rate[r in 0 .. 1 step 0.25]: num

input dd[d in 2026-01-01 .. 2026-01-31 step 7 days]: num

ask k_third: rate[n / three]

ask k_half: rate[n / (three - n)]

ask d_off: dd[add_days(d0, three)]

ask d_on: dd[add_days(d0, wk)]

version v_card
  cite card
  governs always
  known 2026-01-01
  n = 1 "the card"
  three = 3 "the card"
  wk = 7 "a week"
  d0 = 2026-01-01 "the card"
  rate[*] = 7 "the card"
  dd[*] = 5 "the card"
