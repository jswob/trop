model gifts
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source card "card"

unit PLN: currency minor 0.01

kind gifts: event certain
  leg cash: PLN

kind big: gifts
  attr size: int

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input amt: money PLN

input sz: int

move small_gift[m in months]: gifts
  on start_of(m)
  leg cash from world to konto amount amt

move big_gift[m in months]: big
  on start_of(m)
  attr size = sz
  leg cash from world to konto amount amt

ask q: bal(konto, 2026-12-31)

version plan
  cite card
  governs always
  known 2025-12-01
  amt = 10.00 "x"
  sz = 3 "x"
  opening[konto] = 0 at 2026-01-01 start "the card"
