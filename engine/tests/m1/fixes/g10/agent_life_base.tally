model lifeb
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "review probe: a plan before from reads lifespan(k) of a thing the scenario ends"

source card "card (invented)"

unit PLN: currency minor 0.01

kind persons: parties

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input pay_day: date

input horizon: date

input hi: money PLN

input lo: money PLN

move pay: transfers
  on pay_day
  leg cash from world to konto amount if lifespan(olek).to < horizon then hi else lo

ask b0: bal(konto, 2026-06-30)

version card_2026
  cite card
  governs always
  known 2026-01-01
  persons + [olek] lives 1990-01-01..
  pay_day = 2026-02-01 "the card"
  horizon = 2027-01-01 "the card"
  hi = 200.00 "the card"
  lo = 100.00 "the card"
  opening[konto] = 0 PLN at 2026-01-01 start "the opening"
