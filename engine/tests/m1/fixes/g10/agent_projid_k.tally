model projk
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "review probe: a decision in a projection's walk reads a later decision's leg by id"
source card "card (invented)"
unit PLN: currency minor 0.01
kind pays: event certain
  leg cash: PLN
kind outs: event certain
  leg cash: PLN
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 2026-01-01..
input floor: money PLN
input x_day: date
input y_day: date
input t0: date
input d1: date
move y[m in months]: pays
  on y_day
  when month_of(y_day) == m
  reads konto
  leg cash from world to konto amount max(floor, bal(konto) - floor)
move x: outs
  on x_day
  reads y
  leg cash from world to konto amount y[month_of(y_day)].cash.amount
ask a_main: bal(konto, d1)
ask a_proj: bal(konto, d1) from t0
ask a_y: y[month_of(y_day)].cash.amount
version v1
  cite card
  governs always
  known 2026-01-01
  floor = 5.00 "card"
  x_day = 2026-05-05 "card"
  y_day = 2026-05-10 "card"
  t0 = 2026-05-01 "card"
  d1 = 2026-06-30 "card"
  opening[konto] = 100.00 PLN at 2026-01-01 start "card"
