model cyc
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "review probe: a cycle member whose when reads the other's flows"
source card "card (invented)"
unit PLN: currency minor 0.01
kind pays: event certain
  leg cash: PLN
place konto: accounts PLN lives 2026-01-01..
place spare: accounts PLN lives 2026-01-01..
place world: outside lives 2026-01-01..
input amt: money PLN
input the_day: date
input d1: date
move zz: pays
  on the_day
  reads b
  when flows(b, the_day .. the_day) > 0 PLN
  leg cash from world to konto amount amt
move b: pays
  on the_day
  reads konto
  leg cash from world to spare amount max(amt, bal(konto) - amt)
ask q: bal(konto, d1)
version v1
  cite card
  governs always
  known 2026-01-01
  amt = 10.00 "card"
  the_day = 2026-05-05 "card"
  d1 = 2026-06-30 "card"
  opening[konto] = 100.00 PLN at 2026-01-01 start "card"
  opening[spare] = 0 PLN at 2026-01-01 start "card"
