model p
  tally 2
  on 2026-04-15
  start 2026-01-01
  end 2026-12-31

source card "invented probe for F5"

unit DUK: currency minor 0.01

index month = month 2026-01..2026-12

place konto: accounts DUK lives 2026-01-01..

input rent_alt: money DUK

input d_to: date

input d_from: date

def alt: money DUK = (bal(konto, d_to) from d_from) as if {rent = rent_alt}

def plain: money DUK = bal(konto, d_to) from d_from

place world: outside lives 2026-01-01..

input pay: money DUK

input rent: money DUK

input off: int

move salary[m in month]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from world to konto amount pay

move rent_pay[m in month]: transfers
  on add_days(start_of(m), off)
  at start_of(m)
  leg cash from konto to world amount rent


ask a_bal_early: bal(konto, 2026-09-30) from 2026-02-01

ask a_bal_late: bal(konto, 2026-09-30) from 2026-06-01

ask a_low_early: low(konto, 2026-02-01 .. 2026-12-31) from 2026-02-01

ask a_low_late: low(konto, 2026-06-05 .. 2026-11-30) from 2026-06-01

ask w_pin: bal(konto, 2026-09-30) from 2026-06-01 with rent = 800.00

ask w_both: plain - alt

ask w_alt_first: alt - plain

ask w_low_pin: low(konto, 2026-06-05 .. 2026-11-30) from 2026-06-01 with pay = 10.00

version v
  cite card
  governs always
  known 2026-01-01
  pay = 1000.00
  rent = 900.00
  off = 9
  opening[konto] = 500.00 at 2026-01-01 start
  rent_alt = 100.00
  d_to = 2026-09-30
  d_from = 2026-06-01
