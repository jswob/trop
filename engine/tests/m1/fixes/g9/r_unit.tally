model p
  tally 2
  on 2026-04-15
  start 2026-01-01
  end 2026-12-31

source card "invented probe for F5"

unit DUK: currency minor 0.01

index month = month 2026-01..2026-12

kind wallet: place any signed

place konto: wallet lives 2026-01-01..

unit EUR: currency minor 0.01

input eur: money EUR

place world: outside lives 2026-01-01..

input pay: money DUK

input rent: money DUK

input off: int

move salary[m in month]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from world to konto amount pay

move rent_pay[m in month]: transfers
  on add_days(start_of(m), off)
  at start_of(m)
  leg cash from konto to world amount rent

move euro[m in month]: transfers
  on add_days(start_of(m), off)
  at start_of(m)
  leg cash from world to konto amount eur

ask u_bal: bal(konto, 2026-09-30) from 2026-06-01

ask u_low: low(konto, 2026-06-05 .. 2026-11-30) from 2026-06-01

ask u_eur: bal(konto, 2026-09-30) from 2026-06-01

version v
  cite card
  governs always
  known 2026-01-01
  pay = 1000.00
  rent = 900.00
  off = 9
  opening[konto] = 500.00 DUK at 2026-01-01 start
  eur = 7.00
