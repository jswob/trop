  amt = 10.00 PLN
  fee_amt = 2.00 EUR
  gate_dom = 10
  div_when[2026-01] = 1
  div_when[2026-02] = 2
  div_when[2026-03] = 0
  u_in = 2026-01-23
  u_late = 2026-01-27
  ext_day = 2026-01-15

