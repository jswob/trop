  governs always
  known 2025-01-01
  pay_dom = 10 assumed "the card gives no payday" "the payroll's day"
  salary = 12000 assumed "illustration: the card gives no gross" "monthly gross"

version raise_2025
  cite what_if
  governs always
  known 2025-01-01
  raised_salary = 13000 assumed "illustration: the card gives no raise" "the what-if's gross"
,,1:0,165:return_check: 2 000.00 DUK
  pinned: gross[2025-03] = 2 000.00 DUK
  law date 2025-01-01, cut 2025-01-01
warning: WARN-UNREAD input raised_salary is read by nothing
