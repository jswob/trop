  save_cap = 100.00 PLN "the card"
  spend_cap = 50.00 PLN "the card"
  opening[konto] = 500.00 PLN at 2026-01-01 start "the card"
  opening[savings] = 0 PLN at 2026-01-01 start "the card"
,,1:0,178:q_decide: (refused: RUN-ORDER decisions save and spend read each other on 2026-04-15, refused: RUN-ORDER decisions save and spend read each other on 2026-04-15)
