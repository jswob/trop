source card "card"

unit PLN: currency minor 0.01

kind gifts: event certain
  leg cash: PLN

kind big: gifts
  attr size: int

kind bigger: big
  attr extra: int

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 2026-01-01..

input amt: money PLN

input sz: int

move small_gift[m in months]: gifts
  on start_of(m)
  leg cash from world to konto amount amt

move big_gift[m in months]: big
  on start_of(m)
  attr size = sz
  leg cash from world to konto amount amt

move bigger_gift[m in months]: bigger
  on start_of(m)
  attr size = sz
  attr extra = sz
  leg cash from world to konto amount amt

ask q: bal(konto, 2026-12-31)

version plan
  cite card
  governs always
  known 2025-12-01
  amt = 10.00 "x"
  sz = 3 "x"
  opening[konto] = 0 at 2026-01-01 start "the card"
,8:r2.tally,160:part r2
  tally 2

def w2[g in gifts]: int
  rule base = 0
  rule b beats base = g.size when g in big and g.size > 0

ask r2: sum(w2[g] for g in gifts over ..)
