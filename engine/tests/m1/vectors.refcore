source card "card"

index ms = int 1..40

input inc: num

def acc[k in ms]: num
  rule first beats next = inc when pos(k) == 1
  rule next = acc[k - 1] + inc

def h: num = max(acc[1], acc[40])

ask v: h

ask e_h: explain h

