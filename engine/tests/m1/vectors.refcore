version base_path
  cite forecast
  governs always
  known 2025-01-01
  assumed "the price index's base path: 3 % a year"
  cpi_change[*] = 0.03 "base path: every year"

version lease_v
  cite lease
  governs always
  known 2025-01-01
  rent_2025 = 2000.00 "2 000.00 a month in 2025"

version probe_v
  cite lease
  governs always
  known 2025-01-01
  inc = 1
  alt = 2
  xa = 10
  xb = 20
  rate[q1] = 0.1
  rate[q2] = 0.05
  rate[q3] = 0.05
  tie2[q1] = 1
  tie2[q2] = 3
  tie2[q3] = 2
,15:ai2_infl8.tally,286:scenario infl8 over scen03
  tally 2
  from 2025-01-01
  note "The override: the price index rises 8 % a year in 2025-2027; after them the base path resumes."

version override_8
  cite what_if
  governs 2025..2027
  known 2025-01-01
  cpi_change[2025..2027] = 0.08 "8 % for 2025-2027"
