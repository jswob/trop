version card_2026
  cite card
  governs always
  known 2026-01-01
  amt = 100.00 PLN
  d = 2026-02-10
  d2 = 2026-05-01
  go = true
  yr = 2026
  rate[q1] = 0.1
  rate[q2] = 0.2
  opening[konto] = 500.00 PLN at 2026-01-01 start
  opening[box] = 0 at 2026-01-01 start
  px = 3 at 2026-03-01 "march price"
  px = 4 at 2026-04-01

