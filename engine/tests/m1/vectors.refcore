ask base: w, wy, n5, d1

version card_2026
  cite card
  governs always
  known 2026-01-01
  w = window(2026-03-03, 2026-03-20) "c"
  wy = window(2026-12-20, 2027-01-10) "c"
  n5 = 5 "c"
  n2 = 2 "c"
