source forecast "SCEN-03 card: the price index's base path, 3 % a year"

source lease "SCEN-03 card: Halina's rent, 2 000.00 a month in 2025, raised each January by the previous year's price-index change, rounded half up to 0.01"

source what_if "SCEN-03 card: the override, 8 % for 2025-2027"

unit DUK: currency minor 0.01

input bond_margin: num question "The card gives no bond formula: what does the bond pay over the index?"

input cpi_change[y in years]: num

input mortgage_margin: num question "The card gives no mortgage formula: what is its margin over the reference rate?"

input pension_amt[y in years]: money DUK question "The card gives no pension formula: what is the pension before indexation?"

input ref_rate[y in years]: num question "The card gives no reference rate REF."

input rent_2025: money DUK

input inc: num

input alt: num

input xa: num

input xb: num

input nothing: num

index ms = int 1..60

index qs = [q1, q2, q3]

input rate[k in qs]: num

input tie2[k in qs]: num

axis reading
  ra "reading A"
  rb "reading B"

def acc[k in ms]: num
  rule first beats next v lease_v = inc when pos(k) == 1
  rule next v lease_v = acc[k - 1] + inc

def acc_as: num = acc[40] as if {inc = alt}

def pick: num
  rule pa = xa when reading == ra
  rule pb = xb when reading == rb

def cheap_t: key qs = argmin(rate[k] for k in qs) ties by tie2[k]

def low_hole: num = min(alt, nothing)

def low_agg_hole: num = min(rate[k] + nothing for k in qs)

def shift[y in years]: money DUK = rent[y] as if {scenario infl8}

def lawed[y in years]: money DUK = rent[y] as if {law start_of(y - 1)}

