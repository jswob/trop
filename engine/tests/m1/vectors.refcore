source forecast "SCEN-03 card: the price index's base path, 3 % a year"

source lease "SCEN-03 card: Halina's rent, 2 000.00 a month in 2025, raised each January by the previous year's price-index change, rounded half up to 0.01"

source what_if "SCEN-03 card: the override, 8 % for 2025-2027"

unit DUK: currency minor 0.01

input bond_margin: num question "The card gives no bond formula: what does the bond pay over the index?"

input cpi_change[y in years]: num

input mortgage_margin: num question "The card gives no mortgage formula: what is its margin over the reference rate?"

input pension_amt[y in years]: money DUK question "The card gives no pension formula: what is the pension before indexation?"

input ref_rate[y in years]: num question "The card gives no reference rate REF."

input rent_2025: money DUK

input inc: num

input alt: num

input xa: num

input xb: num

input nothing: num

index ms = int 1..60

index qs = [q1, q2, q3]

input rate[k in qs]: num

input tie2[k in qs]: num

axis reading
  ra "reading A"
  rb "reading B"

def acc[k in ms]: num
  rule first beats next v lease_v = inc when pos(k) == 1
  rule next v lease_v = acc[k - 1] + inc

def acc_as: num = acc[40] as if {inc = alt}

def pick: num
  rule pa = xa when reading == ra
  rule pb = xb when reading == rb

def cheap_t: key qs = argmin(rate[k] for k in qs) ties by tie2[k]

def low_hole: num = min(alt, nothing)

def low_agg_hole: num = min(rate[k] + nothing for k in qs)

def shift[y in years]: money DUK = rent[y] as if {scenario infl8}

def lawed[y in years]: money DUK = rent[y] as if {law start_of(y - 1)}

ask e_rent_s: explain rent[2026] with scenario infl8

ask e_shift: explain shift[2027]

ask e_lawed: explain lawed[2027]

ask e_acc: explain acc[40]

ask e_acc_as: explain acc_as

ask e_pick: explain pick

ask e_pick_a: explain pick with reading = ra

ask e_pick_x: explain pick with xa = alt

ask e_known: explain rent[2026] with known 2025-06-01

ask e_cheap_t: explain cheap_t

ask e_low_hole: explain low_hole

ask e_low_agg_hole: explain low_agg_hole

ask e_for: explain acc[k] for k in ms where k < 3 with inc = alt

def bond_rate[y in years]: num = cpi_change[y] + bond_margin at start_of(y)

def mortgage_rate[y in years]: num = ref_rate[y] + mortgage_margin at start_of(y)

def pension[y in years]: num DUK = pension_amt[y] * (1 + cpi_change[y]) at start_of(y)

def rent[y in years]: money DUK at start_of(y)
  rule first beats next = rent_2025 when pos(y) == 1
  rule next v lease_v = round(rent[y - 1] * (1 + cpi_change[y - 1]), minor(DUK), half-up)

ask moved: readers-of cpi_change

ask rent_base: rent[2029]

ask rent_over: rent[2029] with scenario infl8

version base_path
  cite forecast
  governs always
  known 2025-01-01
  assumed "the price index's base path: 3 % a year"
  cpi_change[*] = 0.03 "base path: every year"

version lease_v
  cite lease
  governs always
  known 2025-01-01
  rent_2025 = 2000.00 "2 000.00 a month in 2025"

version probe_v
  cite lease
  governs always
  known 2025-01-01
  inc = 1
  alt = 2
  xa = 10
  xb = 20
  rate[q1] = 0.1
  rate[q2] = 0.05
  rate[q3] = 0.05
  tie2[q1] = 1
  tie2[q2] = 3
  tie2[q3] = 2
,15:ai2_infl8.tally,286:scenario infl8 over scen03
  tally 2
  from 2025-01-01
  note "The override: the price index rises 8 % a year in 2025-2027; after them the base path resumes."

version override_8
  cite what_if
  governs 2025..2027
  known 2025-01-01
  cpi_change[2025..2027] = 0.08 "8 % for 2025-2027"
,,1:0,1736:e_rent_s: 2 160.00 DUK
