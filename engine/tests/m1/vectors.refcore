source card "Probe card LAW-06 (tmp/cases/probes/law/LAW-06.md): story, rules 1-3 and question"

unit DUK: currency minor 0.01

index filing = [joint, separate]

index person = [tomek, ania]

index yr = year 2023..2024

input election[y in yr]: key filing question "Which filing election, joint or separate, did Tomek and Ania make for this year?"

input income[p in person, y in yr]: money DUK question "What did this spouse earn in this year?"

input joint_factor: int question "How many times the scale on the shared income does a joint filing pay?"

band scale(x: num DUK): num
  note "rule 3: marginal rates, read with marginal()"

def joint_tax[y in yr]: num DUK at start_of(y)
  note "rule 2: joint, twice the scale on half the combined income"
  rule base v card_law = joint_factor * marginal(scale, sum(income[p, y] for p in person) / joint_factor)

def separate_tax[y in yr]: num DUK at start_of(y)
  note "rule 2: separate, each pays the scale on their own income"
  rule base v card_law = sum(marginal(scale, income[p, y]) for p in person)

def tax[y in yr]: num DUK at start_of(y)
  note "rule 1: no election, no tax: no rule applies without one, so a missing election leaves the tax a hole (L 5.11 step 5)"
  rule joint v card_law = joint_tax[y] when election[y] == joint
  rule separate v card_law = separate_tax[y] when election[y] == separate

ask a_2023: tax[2023]

ask b_2024: joint_tax[2024], separate_tax[2024], election[2024], tax[2024]

