,43:fixes/g13/sites_pz3_model_with_sites_pz3_z4,9:fixes-g13,63:run sites_pz3_model.tally sites_pz3_f4.tally sites_pz3_z4.tally,1695:21:sites_pz3_model.tally,1055:model sites
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "T's carried item 4 (issue #108, invented): the 26 run sites G4a's fix left 'not implemented', one probe per cause class, each a file beside this base; where load refuses the class first, the site is unreachable (bin i)"

source card "T's card (invented)"

unit PLN: currency minor 0.01

index qs = [q1, q2]

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input d0: date

input fee: money PLN

input n1: int

input r5: num PLN

input rate[k in qs]: num

input txt: text

move pay: transfers
  on d0
  leg cash from konto to world amount fee

ask base: d0, fee, n1, r5, rate[q1], rate[q2], txt, bal(konto, 2026-12-31)

version card_2026
  cite card
  governs always
  known 2026-01-01
  d0 = 2026-02-10 "the card"
  fee = 10.00 PLN "the card"
  n1 = 3 "the card"
  r5 = 2.50 PLN "the card"
  rate[q1] = 0.1 "the card"
  rate[q2] = 0.2 "the card"
  txt = "a note" "the card"
  opening[konto] = 100.00 PLN at 2026-01-01 start "the card"
,18:sites_pz3_f4.tally,179:scenario f4 over sites
  tally 2
  from 2026-01-01

version fv4
  cite card
  governs 2026-01-01..
  known 2026-01-01
  replace fee = sites.fee + 0.005 PLN "x"

ask f4: fee in f4
,18:sites_pz3_z4.tally,376:part z4
  tally 2

input ry: num 1/year

input rr: rate

place w2: outside lives 1900-01-01..

kind evs: event certain
  leg what: any

move mv: evs
  on d0
  leg what from world to w2 amount ry

def z4_x: num = sum(rr / m.what.amount for m in evs over d0..d0)

ask z4: z4_x

version vz
  cite card
  governs always
  known 2026-01-01
  ry = 0.05/year "c"
  rr = 5 %/year "c"
,,1:1,84:refused: LOAD-SCENARIO an expression row outside a scenario (sites_pz3_z4.tally:25)
