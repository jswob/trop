source card "invented probe for F5"

unit DUK: currency minor 0.01

index month = month 2026-01..2026-12

place konto: accounts DUK lives 2026-01-01..

input late: int

input hday: date

input hstart: date

place world: outside lives 2026-01-01..

input pay: money DUK

input rent: money DUK

input off: int

move salary[m in month]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from world to konto amount pay

move rent_pay[m in month]: transfers
  on add_days(start_of(m), off)
  at start_of(m)
  leg cash from konto to world amount rent

move split[m in month]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from world to konto amount rent on add_days(start_of(m), late)

move holed: transfers
  on hstart
  at hstart
  leg cash from world to konto amount rent on hday

ask a_bal_early: bal(konto, 2026-09-30) from 2026-02-01

ask a_bal_late: bal(konto, 2026-09-30) from 2026-06-01

ask a_low_early: low(konto, 2026-02-01 .. 2026-12-31) from 2026-02-01

ask a_low_late: low(konto, 2026-06-05 .. 2026-11-30) from 2026-06-01

ask h_from_after: bal(konto, 2026-09-30) from 2026-07-01

version v
  cite card
  governs always
  known 2026-01-01
  pay = 1000.00
  rent = 900.00
  off = 9
  opening[konto] = 500.00 at 2026-01-01 start
  late = 5
  hstart = 2026-06-15
,,1:0,163:a_bal_early: ?"hday: no value at 2026-06-15" (hday)
  unfulfilled: rent_pay[2026-01]
  unfulfilled: salary[2026-01]
  unfulfilled: split[2026-01]
  cut 2026-04-15
,32:fixes/g9/r_act_legday_a_bal_late,8:fixes-g9,39:run r_act_legday.tally --ask a_bal_late,1382:18:r_act_legday.tally,1354:model p
  tally 2
  on 2026-04-15
  start 2026-01-01
  end 2026-12-31

