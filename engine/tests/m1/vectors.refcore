unit DUK: currency minor 0.01

index tmonth = month 2024-01..2024-12

input base_month[m in tmonth]: money DUK

band scale(x: num DUK): num
  note "rule 1: the yearly scale as marginal rates"

def advance[m in tmonth]: money DUK at start_of(m)
  note "rule 2: the tax on the base to date minus the advances already withheld this year"
  rule base v card = tax_to_date[m] - sum(advance[k] for k in tmonth where k < m and year_of(k) == year_of(m))

def base_to_date[m in tmonth]: money DUK = sum(base_month[k] for k in tmonth where k <= m and year_of(k) == year_of(m)) at start_of(m)

def tax_to_date[m in tmonth]: money DUK at start_of(m)
  note "rule 2: the scale's tax on the base to date, rounded half up to 0.01"
  rule base v card = round(marginal(scale, base_to_date[m]), minor(DUK), half-up)

ask q_advances: advance[2024-09], advance[2024-10] law 2026-10-25

