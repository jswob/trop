  w[q2] = 1 "card"
  w[q3] = 1 "card"
  v[r1] = 1 "card"
  v[r2] = 1 "card"
  v[r3] = 1 "card"
  o[q1] = 3 "card"
  o[q2] = 2 "card"
  o[q3] = 1 "card"
  orr[r1] = 3 "card"
  orr[r2] = 2 "card"
  orr[r3] = 1 "card"
