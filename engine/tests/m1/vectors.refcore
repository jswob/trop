source card "card"

unit PLN: currency minor 0.01

index ms = [m1, m2, m3]

kind persons: parties

input d: date

input inc[p in persons]: money PLN

input base: num

input grow: num

input opt[p in persons]: num

def n_on: int = count(p in persons on d)

def tot_inc: money PLN = sum(inc[p] for p in persons on d)

def life_end: date = lifespan(ola).to

def alive: bool = lifespan(ola).to != never

def kut: date = min(d, cut)

def acc[m in ms]: num
  rule first = base when m == m1
  rule next beats first = acc[m - 1] * grow when m > m1

def none_or: num = if opt[ola] == none then base else opt[ola]

def top: key persons = argmax(inc[p] for p in persons on d)

def hi: money PLN = max(inc[p] for p in persons on d)

ask e_n: explain n_on
ask e_tot: explain tot_inc
ask e_life: explain life_end
ask e_alive: explain alive
ask e_kut: explain kut
ask e_acc: explain acc[m3]
ask e_acc1: explain acc[m1]
ask e_none: explain none_or
ask e_top: explain top
ask e_hi: explain hi
ask i_tot: inputs-of tot_inc
ask i_life: inputs-of life_end
ask i_acc: inputs-of acc[m3]
ask i_top: inputs-of top
ask r_inc: readers-of inc
ask r_persons: readers-of persons
ask r_acc: readers-of acc
ask r_base: readers-of base
ask v: n_on, tot_inc, life_end, alive, kut, acc[m3], none_or, top, hi

version card_2026
  cite card
  governs always
  known 2026-01-01
  persons + [ola] lives 1980-01-01..
  persons + [jan] lives 1985-01-01..2026-06-30
  d = 2026-03-01
  base = 2
  grow = 3
  inc[ola] = 100.00 PLN
  inc[jan] = 300.00 PLN "jan's pay"
  opt[ola] = none
,,1:0,3595:e_acc: 18
  [1] acc[m3] = 18
      rule first: beaten by next
      rule next: won
        [2] acc[m2] = 6
            rule first: beaten by next
            rule next: won
              [3] acc[m1] = 2
                  rule first: won
                    [4] row card_2026:base = 2
                        version card_2026, source card, "card", governs always, known 2026-01-01
                  rule next: not applicable
              [5] row card_2026:grow = 3
                  version card_2026, source card, "card", governs always, known 2026-01-01
        (card_2026:grow: see [5])
  cut 2026-12-31
e_acc1: 2
  [1] acc[m1] = 2
      rule first: won
        [2] row card_2026:base = 2
            version card_2026, source card, "card", governs always, known 2026-01-01
      rule next: not applicable
  cut 2026-12-31
e_alive: false
  [1] alive = false
      rule base: won
  cut 2026-12-31
e_hi: 300.00 PLN
  [1] hi = 300.00 PLN
      rule base: won
        [2] row card_2026:d = 2026-03-01
            version card_2026, source card, "card", governs always, known 2026-01-01
        [3] row card_2026:inc[jan] = 300.00 PLN
            version card_2026, source card, "card", locator "jan's pay", governs always, known 2026-01-01
  cut 2026-12-31
e_kut: 2026-03-01
  [1] kut = 2026-03-01
      rule base: won
        [2] row card_2026:d = 2026-03-01
            version card_2026, source card, "card", governs always, known 2026-01-01
  cut 2026-12-31
e_life: never
  [1] life_end = never
      rule base: won
  cut 2026-12-31
e_n: 2
  [1] n_on = 2
      rule base: won
        [2] row card_2026:d = 2026-03-01
            version card_2026, source card, "card", governs always, known 2026-01-01
  cut 2026-12-31
e_none: 2
  [1] none_or = 2
      rule base: won
        [2] row card_2026:opt[ola] = none
            version card_2026, source card, "card", governs always, known 2026-01-01
        [3] row card_2026:base = 2
            version card_2026, source card, "card", governs always, known 2026-01-01
  cut 2026-12-31
e_top: jan
  [1] top = jan
      rule base: won
        [2] row card_2026:d = 2026-03-01
            version card_2026, source card, "card", governs always, known 2026-01-01
        [3] row card_2026:inc[jan] = 300.00 PLN
            version card_2026, source card, "card", locator "jan's pay", governs always, known 2026-01-01
  cut 2026-12-31
e_tot: 400.00 PLN
  [1] tot_inc = 400.00 PLN
      rule base: won
        [2] row card_2026:d = 2026-03-01
            version card_2026, source card, "card", governs always, known 2026-01-01
        [3] row card_2026:inc[jan] = 300.00 PLN
            version card_2026, source card, "card", locator "jan's pay", governs always, known 2026-01-01
        [4] row card_2026:inc[ola] = 100.00 PLN
            version card_2026, source card, "card", governs always, known 2026-01-01
  cut 2026-12-31
i_acc:
  card_2026:base (source card "card")
  card_2026:grow (source card "card")
  cut 2026-12-31
i_life:
  cut 2026-12-31
i_top:
  card_2026:d (source card "card")
  card_2026:inc[jan] (source card "card", locator "jan's pay")
  card_2026:inc[ola] (source card "card")
  cut 2026-12-31
i_tot:
  card_2026:d (source card "card")
  card_2026:inc[jan] (source card "card", locator "jan's pay")
  card_2026:inc[ola] (source card "card")
  cut 2026-12-31
r_acc: e_acc, e_acc1, i_acc, v
r_base: acc, none_or, e_acc, e_acc1, e_none, i_acc, v
r_inc: hi, top, tot_inc, e_hi, e_top, e_tot, i_top, i_tot, v
r_persons: nothing reads persons
v: (2, 400.00 PLN, never, false, 2026-03-01, 18, 2, jan, 300.00 PLN)
  cut 2026-12-31
,15:fixes/g11/r_p_e,9:fixes-g11,15:run r_p_e.tally,765:11:r_p_e.tally,745:model pe
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source card "card"

source statute "statute"

input x: num

input y: num

input flag: bool question "Is it so?"

input lo: bool

def pk: num at reader
  rule a beats b = x when flag
  rule b = y when lo
  rule c beats a v act = y * x

def via: num at reader
  rule base v act = pk + x

ask e_pk: explain pk law 2026-05-01
ask v_pk: pk law 2026-05-01
ask e_via: explain via law 2026-05-01
ask e_via0: explain via law 2026-01-15
ask v_via0: via law 2026-01-15
ask r_e_pk: readers-of e_pk
ask r_x: readers-of x

version card_2026
  cite card
  governs always
  known 2026-01-01
  x = 2
  y = 3
  lo = true

version act
  cite statute
  governs 2026-02-01..
  known 2026-01-10
,,1:0,1057:e_pk: refused: RUN-CONFLICT rules c and b both win for pk on 2026-05-01
  [1] pk = refused: RUN-CONFLICT rules c and b both win for pk on 2026-05-01, law date 2026-05-01
  law date 2026-05-01, cut 2026-12-31
e_via: refused: RUN-CONFLICT rules c and b both win for pk on 2026-05-01
  [1] via = refused: RUN-CONFLICT rules c and b both win for pk on 2026-05-01, law date 2026-05-01
      rule base: won (version act, source statute)
        [2] pk = refused: RUN-CONFLICT rules c and b both win for pk on 2026-05-01, law date 2026-05-01
  law date 2026-05-01, cut 2026-12-31
e_via0: refused: RUN-NO-RULE no rule applies to via on 2026-01-15
  [1] via = refused: RUN-NO-RULE no rule applies to via on 2026-01-15, law date 2026-01-15
  law date 2026-01-15, cut 2026-12-31
r_e_pk: nothing reads e_pk
r_x: pk, via, e_pk, e_via, e_via0, v_pk, v_via0
v_pk: refused: RUN-CONFLICT rules c and b both win for pk on 2026-05-01
  law date 2026-05-01, cut 2026-12-31
v_via0: refused: RUN-NO-RULE no rule applies to via on 2026-01-15
  law date 2026-01-15, cut 2026-12-31
,21:fixes/g11/r_p_pr_sign,9:fixes-g11,21:run r_p_pr_sign.tally,7597:17:r_p_pr_sign.tally,7570:model g9_sign
  tally 2
  on 2026-03-25
  start 2026-01-01
  end 2026-03-31
  note "T, issue #41, G9: booking a leg and the sign rule (L §5.10, §5.14, E §4.2 steps 4-5): claims, debts and a holding broken by a first-batch plan and by a decision's legs, each refused (RUN-PLACE) beside a twin that stays at 0 or nets to 0 in its batch; a claim anchored below zero at a close, which refcore and the engine leave at -5.00 unrefused (S keeps refcore's bytes; the spec round decides, #46), beside a twin anchored at 0; a leg out of a place outside its lifespan (RUN-LIFESPAN) beside a leg of 0 that books nothing; cash below zero in two stretches (WARN-NEGATIVE twice); a hole amount and a hole day, each on places of their own."

source fixture "T's fixture for S's kernel tests (invented values)"

unit PLN: currency minor 0.01

unit etf_unit "a fund unit"

index month = month 2026-01..2026-03

place konto: accounts PLN lives 2026-01-01..

place wallet: cash PLN lives 2026-01-01..

place lent: claims PLN lives 2026-01-01..

place lent2: claims PLN lives 2026-01-01..

place lent3: claims PLN lives 2026-01-01..

place lent4: claims PLN lives 2026-01-01..

place owed: debts PLN lives 2026-01-01..

place fund: holdings etf_unit priced fund_price lives 2026-01-01..

place fund2: holdings etf_unit priced fund_price lives 2026-01-01..

place gone: accounts PLN lives 2026-01-01..2026-02-27

place gone2: accounts PLN lives 2026-01-01..2026-02-27

place box_h: accounts PLN lives 2026-01-01..

place box_d: accounts PLN lives 2026-01-01..

place market: outside lives 2026-01-01..

place world: outside lives 2026-01-01..

input fund_price[m in month]: num PLN/etf_unit

input back_amt[m in month]: money PLN

input lend_amt[m in month]: money PLN

input swing_amt[m in month]: money PLN

input gone2_amt[m in month]: money PLN

input over_amt: money PLN

input payoff_amt[m in month]: money PLN

input sell_units[m in month]: num etf_unit

input spend_amt[m in month]: money PLN

input refill_amt: money PLN

input gone_amt[m in month]: money PLN

input hole_amt: money PLN question "How much came in?"

input hole_day: date question "When does it come?"

input small_amt: money PLN

input mystery_day: date

input first_day: date

input pay_dom: int

input dec_dom: int

input spend_dom: int

input refill_dom: int

move back[m in month]: transfers
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from lent to konto amount back_amt[m]

move swing_out[m in month]: transfers
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from lent2 to konto amount swing_amt[m]

move swing_in[m in month]: transfers
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from konto to lent2 amount lend_amt[m]

move repay[m in month]: transfers
  on day_of(m, dec_dom)
  at start_of(m)
  reads lent3
  leg cash from lent3 to world amount if bal(lent3) > small_amt then bal(lent3) + over_amt else bal(lent3)

move payoff[m in month]: transfers
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from konto to owed amount payoff_amt[m]

move sell[m in month]: etf_sells
  on day_of(m, pay_dom)
  at start_of(m)
  leg units from fund to market amount sell_units[m]

move spend[m in month]: transfers
  on day_of(m, spend_dom)
  at start_of(m)
  leg cash from wallet to world amount spend_amt[m]

move refill[m in month]: transfers
  on day_of(m, refill_dom)
  at start_of(m)
  leg cash from world to wallet amount refill_amt

move into_gone[m in month]: transfers
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from gone to world amount gone_amt[m]

move into_gone2[m in month]: transfers
  on day_of(m, pay_dom)
  at start_of(m)
  leg cash from world to gone2 amount gone2_amt[m]

move dump[m in month]: etf_sells
  on day_of(m, dec_dom)
  at start_of(m)
  reads fund2
  leg units from fund2 to market amount if bal(fund2) > sell_units[m] then sell_units[m] else bal(fund2) + sell_units[m]

move mystery: transfers
  on mystery_day
  at mystery_day
  leg cash from world to box_h amount hole_amt

move vague: transfers
  on hole_day
  at first_day
  leg cash from world to box_d amount small_amt

kind etf_sells: event certain
  leg units: etf_unit

