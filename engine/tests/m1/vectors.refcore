unit PLN: currency minor 0.01

kind persons: parties

input pay_day: date

input amt: money PLN

input cutoff: date

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

move pay: transfers
  on pay_day
  when lifespan(ola).to != never
  leg cash from world to konto amount amt

move pay2: transfers
  on pay_day
  when lifespan(ola).to == never
  leg cash from world to konto amount amt + amt

ask b0: bal(konto, 2026-06-30)

ask l0: lifespan(ola).to

version card_2026
  cite card
  governs always
  known 2026-01-01
  persons + [ola] lives 1980-01-01..
  pay_day = 2026-02-01 "the card"
  amt = 10.00 PLN "the card"
  cutoff = 2026-07-01 "the card"
  opening[konto] = 0 PLN at 2026-01-01 start "the card"
scenario ends over life
  tally 2
  from 2026-07-01

version ends_v
  cite card
  governs 2026-07-01..
  known 2026-01-01
  persons + [ola] lives 1980-01-01..2026-09-30

ask b1: bal(konto, 2026-06-30) in ends

ask l1: lifespan(ola).to in ends
