,53:fixes/g12/pm6_remeasure_hole_legs_remeasure_hole_legs,9:fixes-g12,53:run pm6_remeasure_hole_legs_remeasure_hole_legs.tally,2001:49:pm6_remeasure_hole_legs_remeasure_hole_legs.tally,1942:model g11_remeasure_hole_legs
  tally 2
