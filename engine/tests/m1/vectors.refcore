source card "T's card (invented)"

unit PLN: currency minor 0.01

kind ovs: event certain
  leg cash: PLN

input q[m in months]: money PLN

input base: money PLN

place acct: accounts PLN lives 2027-01-01..

place bank: outside lives 2027-01-01..

def p[m in months]: money PLN = if pos(m) == 1 then base else p[m - 1] - sum(o.cash.amount for o in ovs over m)

move pay[m in months]: transfers
  on start_of(m)
  leg cash from acct to bank amount p[m]

move op[m in months]: ovs
  on start_of(m)
  leg cash from bank to acct amount q[m]

ask t: p[m] for m in [2027-03, 2027-07]

ask t2: p[2027-04]

ask b: bal(acct, 2027-06-30), flows(pay[2027-03], 2027-01-01..2027-12-31)

version v
  cite card
  governs always
  known 2027-01-01
  base = 1000.00 PLN "c"
  q[2027-01] = 10.00 PLN "c"
  q[2027-02] = 20.00 PLN "c"
  q[2027-03] = 30.00 PLN "c"
  q[2027-04] = 40.00 PLN "c"
  q[2027-05] = 50.00 PLN "c"
  q[2027-06] = 60.00 PLN "c"
  q[2027-07] = 70.00 PLN "c"
  opening[acct] = 0 PLN at 2027-01-01 start "c"
,,1:0,228:b: (-5 290.00 PLN, 950.00 PLN)
  cut 2027-01-01
t (m = 2027-03): 950.00 PLN
  cut 2027-01-01
t (m = 2027-07): 730.00 PLN
  cut 2027-01-01
t2: 910.00 PLN
  cut 2027-01-01
warning: WARN-NEGATIVE acct is below zero from 2027-01-01
,23:fixes/g14/t_mb5_pl_t_t3,9:fixes-g14,29:run t_mb5_pl.tally --ask t t3,1421:14:t_mb5_pl.tally,1397:model pl
  tally 2
  on 2027-01-01
  start 2027-01-01
  end 2028-12-31
  note "T C10 (invented): F4g's form where the walk refuses an event's leg (RUN-PLACE, its place min 0): the def read through the walk up to the leg's day meets the walk's refusal of the leg; and an ask at an earlier cut, whose own walk up to that day refuses nothing (MB5's prefix walk)"

source card "T's card (invented)"

unit PLN: currency minor 0.01

kind pot: place PLN min 0

kind ovs: event certain
  leg cash: PLN

input q[m in months]: money PLN

input base: money PLN

place acct: accounts PLN lives 2027-01-01..

place sav: pot lives 2027-01-01..

place bank: outside lives 2027-01-01..

def p[m in months]: money PLN = if pos(m) == 1 then base else p[m - 1] - sum(o.cash.amount for o in ovs over m)

move pay[m in months]: transfers
  on start_of(m)
  leg cash from acct to bank amount p[m]

move op[m in months]: ovs
  on start_of(m)
  leg cash from sav to acct amount q[m]

ask t: p[m] for m in [2027-01, 2027-04]

ask t2: bal(sav, 2027-03-31), bal(acct, 2027-01-31)

ask t3: p[2027-03] as known 2026-12-31

version v
  cite card
  governs always
  known 2027-01-01
  base = 1000.00 PLN "c"
  q[2027-01] = 10.00 PLN "c"
  q[2027-02] = 20.00 PLN "c"
  q[2027-03] = 5.00 PLN "c"
  q[2027-04] = 40.00 PLN "c"
  opening[acct] = 5000.00 PLN at 2027-01-01 start "c"
  opening[sav] = 25.00 PLN at 2027-01-01 start "c"
,,1:0,318:t (m = 2027-01): 1 000.00 PLN
  cut 2027-01-01
t (m = 2027-04): refused: RUN-PLACE sav is -5.00 PLN after the day's observations and plans of 2027-02-01
  cut 2027-01-01
