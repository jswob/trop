  zero_n = 0 "c"
  neg_n = -0.5 "c"
  third = 0.333 "c"
  two_i = 2 "c"
  two_f = 2.0 "c"
  three_pln = 3.00 PLN "c"
  lo_f = 0.5 "c"
  half_n = 0.5 "c"
  hi_f = 2.5 "c"
  big_hi = 999999 "c"
  d_a = 2026-01-31 "c"
  d_b = 2026-12-31 "c"
  by_frac[1.5] = 0.15 "c"
  by_frac[2.0] = 0.2 "c"
  by_money[3 PLN] = 0.3 "c"
  by_third[0.666] = 6 "c"
