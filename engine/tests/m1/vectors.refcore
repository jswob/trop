  card_2026:d (source card "T's invented card")
  card_2026:opening[konto] (source card "T's invented card")
  card_2026:rate[q1] (source card "T's invented card")
  unfulfilled: pay
  cut 2026-12-31
it:
  card_2026:amt (source card "T's invented card")
