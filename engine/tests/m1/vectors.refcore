  governs always
  known 2025-01-01
  rent_2025 = 2000.00 "2 000.00 a month in 2025"

version probe_v
  cite lease
  governs always
  known 2025-01-01
  inc = 1
  alt = 2
  xa = 10
  xb = 20
  rate[q1] = 0.1
  rate[q2] = 0.05
  rate[q3] = 0.05
  tie2[q1] = 1
  tie2[q2] = 3
  tie2[q3] = 2
