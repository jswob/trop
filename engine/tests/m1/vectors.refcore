unit DUK: currency minor 0.01

input cover_ends: date

input policy_end: date

input policy_start: date

input premium: money DUK

def policy_days: int at reader
  note "rule 1: the days in the policy year (actual/actual), both ends counted"
  rule base v card = days_between(policy_start, policy_end) + 1

def refund_365: money DUK at reader
  note "the contrast the question asks: the same refund under actual/365, the unused days' year fraction (L §3.3 dcf); rounded as rule 3"
  rule base = round(premium * dcf(cover_ends, policy_end, act365), minor(DUK), half-up)

def refund_aa: money DUK at reader
  note "rules 1 and 3: premium x unused days / days in the policy year, rounded half up to 0.01"
  rule base v card = round(premium * unused_days / policy_days, minor(DUK), half-up)

def unused_days: int at reader
  note "rule 2: from the day after cover ends to the policy's last day, inclusive"
  rule base v card = days_between(cover_ends, policy_end)

ask q_refund: refund_aa, refund_365, unused_days law 2026-10-25

