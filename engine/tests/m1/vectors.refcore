unit PLN: currency minor 0.01

index qs = [q1, q2]

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input d0: date

input fee: money PLN

input n1: int

input r5: num PLN

input rate[k in qs]: num

input txt: text

move pay: transfers
  on d0
  leg cash from konto to world amount fee

ask base: d0, fee, n1, r5, rate[q1], rate[q2], txt, bal(konto, 2026-12-31)

version card_2026
  cite card
  governs always
  known 2026-01-01
  d0 = 2026-02-10 "the card"
  fee = 10.00 PLN "the card"
  n1 = 3 "the card"
  r5 = 2.50 PLN "the card"
  rate[q1] = 0.1 "the card"
  rate[q2] = 0.2 "the card"
  txt = "a note" "the card"
  opening[konto] = 100.00 PLN at 2026-01-01 start "the card"
,18:sites_pz2_w4.tally,182:scenario w4 over sites
  tally 2
  from 2026-01-01

version vw4
  cite card
  governs 2026-01-01..
  known 2026-01-01
  replace rate[q1] = sites.rate[q9] "x"

ask w4: rate[q1] in w4
,18:sites_pz2_k4.tally,80:part k4
  tally 2

index ps = [p0, q1]

def k4_x: key qs = q1 + 1

ask k4: k4_x
,,1:0,185:scenario w4: refused: LOAD-KEY q9 is not a key of qs (sites_pz2_w4.tally:9)
