  anchor lent4
  stated[lent4] = 0.00 at 2026-02-28 end "the twin: a claim stated at 0"

ask zm1: explain back[2026-01]

ask zm2: explain back[2026-02]

ask zm3: explain back[2026-03]

ask zm4: explain swing_out[2026-01]

ask zm5: explain swing_out[2026-02]

