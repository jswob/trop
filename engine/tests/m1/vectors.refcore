source card "probe card"

unit PLN: currency minor 0.01

unit EUR: currency minor 0.01

kind funds: unit

kind ikes: place any min 0

kind pikes: place any min 0 priced px

kind wikes: place any min 0 priced qx

kind lots: place one min 0 priced px

kind unit_buys: event certain
  leg units: funds

place ike: ikes lives 2026-01-01..

place pike: pikes lives 2026-01-01..

place wike: wikes lives 2026-01-01..

place lot: lots fa lives 2026-01-01..

place market: outside lives 2026-01-01..

input px[u in funds]: num PLN/u

input qx[u in funds]: num PLN/fa

input pl[u in funds]: num PLN/u reading

input buy_day: date

input n3a: num fa

input n2b: num fb

input n5a: num fa

move b1: unit_buys
  on buy_day
  leg units from market to ike amount n3a

move b2: unit_buys
  on buy_day
  leg units from market to ike amount n2b

move b3: unit_buys
  on buy_day
  leg units from market to pike amount n3a

move b4: unit_buys
  on buy_day
  leg units from market to pike amount n2b

move b5: unit_buys
  on buy_day
  leg units from market to wike amount n2b

move b6: unit_buys
  on buy_day
  leg units from market to lot amount n5a

version card_2026
  cite card
  governs always
  known 2026-01-01
  funds + [fa] lives 2026-01-01..
  funds + [fb] lives 2026-01-01..
  buy_day = 2026-02-10 "the card"
  n3a = 3 fa "the card"
  n2b = 2 fb "the card"
  n5a = 5 fa "the card"
  px[fa] = 10 PLN/fa "the card"
  px[fb] = 20 PLN/fb "the card"
  qx[fa] = 7 PLN/fa "the card"
  qx[fb] = 9 PLN/fa "the card"

version readings_2026
  cite card
  governs 2026-01..2026-12
  known 2026-01-01
  pl[fa] = 11 PLN/fa at 2026-03-01 "quoted"
  pl[fb] = 21 PLN/fb at 2026-03-01 "quoted"

def pd[u in funds]: num PLN/u = px[u] + px[u]

def pz[u in funds]: num PLN/u = 0

ask d1: value(ike, 2026-03-31) in PLN by pd

ask d2: value(ike, 2026-03-31) in PLN by pz

ask d3: value(ike, 2026-03-31) in PLN by px[fa]

def po[u in funds]: num PLN/u = 1

def pi[u in funds]: num PLN/u = if u == fa then 0 else px[u]

ask d4: value(ike, 2026-03-31) in PLN by po

ask d5: value(ike, 2026-03-31) in PLN by pi

ask d6: value(lot, 2026-03-31) in PLN by pz[fa]

ask d7: value(lot, 2026-03-31) in PLN by pz

ask z1: pz[fa]

ask z2: po[fb] + po[fb]

ask z3: pi[fa]

ask z4: pz[fa] * n3a
,,1:1,94:refused: LOAD-PRICE value(lot) by pz[fa]: lot's price already gives its fa (b1_kpd.tally:115)
,28:fixes/g14/b2_base_with_b2_b2,9:fixes-g14,29:run b2_base.tally b2_b2.tally,577:13:b2_base.tally,387:model two
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  note "G14 probes: pins formed per binding tuple over two bindings (L §8.2)"

