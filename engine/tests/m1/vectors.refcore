unit PLN: currency minor 0.01

index ks = [k1, k2]

index mos = month 2026-01..2026-12

kind pays: transfers

input d1: date

input d2: date

input d3: date

input a: money PLN

input b: money PLN

input big: money PLN

input keep: money PLN

input ten: num

input cap[k in ks]: money PLN

input prio[k in ks]: int

place konto: accounts PLN lives 2026-01-01..

place savings: accounts PLN lives 2026-01-01..

place sink: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

move sweep: transfers
  on d2
  reads savings
  leg cash from savings to sink amount bal(savings)

move save: transfers
  on d1
  reads konto
  leg cash from konto to savings amount min(cap[k2], bal(konto))

ask q: bal(konto, 2026-06-30), bal(savings, 2026-06-30), bal(sink, 2026-06-30)

