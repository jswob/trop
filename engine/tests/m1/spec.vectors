source card "invented"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..
place ko2: accounts PLN lives 2026-01-01..
place world: outside lives 2026-01-01..
place w: outside lives 2026-01-01..

input amt: money PLN
input dd: date

move top: transfers
  on dd
  leg cash from world to konto amount amt

move top2: transfers
  on dd
  leg cash from world to ko2 amount amt

ask b1: bal(konto, 2026-02-27), bal(konto, 2026-02-28), bal(konto, 2026-03-31), bal(konto, 2026-01-15 start), bal(konto, 2026-01-15)
ask b2: bal(ko2, 2026-02-09), bal(ko2, 2026-02-10), bal(ko2, 2026-02-28), bal(w, PLN, 2026-02-28)
ask b3: gap(konto, 2026-02-28), gap(ko2, 2026-02-28)
ask b4: explain bal(konto, 2026-03-31)
ask b5: explain bal(ko2, 2026-03-31)
ask b6: bal(konto, 2026-02-28), bal(ko2, 2026-02-28) as known 2026-03-01

version v
  cite card
  governs 2026-01..2026-02
  known 2026-03-05
  anchor konto
  pad ko2 from w
  opening[konto] = 0 at 2026-01-01 start "base"
  opening[ko2] = 5.00 PLN at 2026-01-01 start "base"
  stated[konto] = 100 at 2026-02-28 end "base"
  stated[konto] = 30 at 2026-01-15 end "base"
  stated[ko2] = 40 at 2026-02-28 end "base"

version facts
  cite card
  governs always
  known 2026-01-01
  amt = 10.00 PLN
  dd = 2026-02-10
,15:r137_none.tally,953:scenario s3 over rb
  tally 2
  from 2026-01-01
  note "T C15 (the #137 review's s3): replace = none removes the readings and their pad; the balance is booked on from the earlier reading (L §5.19; issue #137)"

version s3_v
  cite card
  governs 2026-01..2026-02
  known 2026-03-01
  anchor konto
  pad ko2 from w
  replace stated[konto] = none at 2026-02-28 end "s3"
  replace stated[ko2] = none at 2026-02-28 end "s3"

ask s3a: bal(konto, 2026-01-15), bal(konto, 2026-02-20), bal(konto, 2026-02-28), bal(konto, 2026-03-31) in s3
ask s3b: bal(ko2, 2026-01-01 start), bal(ko2, 2026-02-28), bal(ko2, 2026-03-31), bal(w, PLN, 2026-03-31) in s3
ask s3c: gap(konto, 2026-02-28), gap(ko2, 2026-02-28) in s3
