model fault
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-06-30
  note "the builder's own reality for the planted fault (invented)"

source card "the builder's card (invented)"

unit PLN: currency minor 0.01

input rent_day: date

input pay_day: date

input rent_amt: money PLN

input pay_amt: money PLN

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

move rent: transfers
  on rent_day
  leg cash from konto to world amount rent_amt

move pay: transfers
  on pay_day
  leg cash from world to konto amount pay_amt

ask q: bal(konto, 2026-01-31), bal(konto, 2026-05-31)

version card_2026
  cite card
  governs always
  known 2026-01-01
  rent_day = 2026-02-10 "the card"
  pay_day = 2026-04-10 "the card"
  rent_amt = 40.00 PLN "the card"
  pay_amt = 100.00 PLN "the card"
  opening[konto] = 500.00 PLN at 2026-01-01 start "the card"
