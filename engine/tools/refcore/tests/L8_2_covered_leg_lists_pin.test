# tally 2.2.1 P35 (L §8.2 l.2248, "an entry is listed under a result exactly when a read in its set gave it", whatever
# the form of the line, its outcome, or the way a movement came not to count): N1, a covered leg the pin puts after the read day lists the pin
# (review g2 pad/r5). Before W8: no line.
=== r5.tally
model r5
  tally 2
  on 2026-06-20
  start 2026-01-01
  end 2026-12-31
source card "invented"
unit PLN: currency minor 0.01
kind buys: transfers
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..
input bank: observed
input pay: money PLN
input w: date
input w2: date
input w5: date
input w6: date
input w7: date
move pay_w: transfers
  on w
  leg cash from world to konto amount pay
move pay_x: transfers
  on w2
  leg cash from world to konto amount pay
move pay_y: transfers
  on w5
  leg cash from world to konto amount pay
move pay_z: transfers
  on w6
  leg cash from world to konto amount pay
move pay_a: transfers
  on w7
  leg cash from world to konto amount pay
version v_card
  cite card
  governs always
  known 2026-01-01
  pay = 100.00 PLN "c"
  w = window(2026-03-05, 2026-03-07) "c"
  w2 = window(2026-03-30, 2026-04-02) "c"
  w5 = 2026-03-15 "c"
  w6 = 2026-05-10 "c"
  w7 = 2026-04-15 "c"
  opening[konto] = 500.00 PLN at 2026-01-01 start "c"
version st
  cite card
  governs 2026-03
  known 2026-04-10
  covers konto
  pad konto from unexplained
  stated[konto] = 700.00 PLN at 2026-03-31 end "s"
  bank[r1] = (on: 2026-03-06, kind: transfers, leg cash from world to konto amount 100.00 PLN, fulfils: pay_w) "r1"
  bank[r2] = (on: 2026-03-20, kind: buys, leg cash from konto to world amount 5.00 PLN) "r2"
version st2
  cite card
  governs 2026-04
  known 2026-05-10
  covers konto
  pad konto from unexplained
  stated[konto] = 800.00 PLN at 2026-04-30 end "s"
ask v1: bal(konto, 2026-04-05)
ask v2: bal(konto, 2026-04-05) with w2 = 2026-03-31
ask v3: bal(konto, 2026-04-05) with w5 = 2026-03-20
ask v3b: bal(konto, 2026-04-05) with w5 = 2026-04-12
ask v3c: bal(konto, 2026-04-05) with w5 = 2026-05-12
ask v4: bal(konto, 2026-05-05)
ask v5: bal(konto, 2026-05-05) with w5 = 2026-03-20
ask v6: bal(konto, 2026-05-05) with w7 = 2026-04-20
ask v6b: bal(konto, 2026-05-05) with w7 = 2026-04-20, w2 = 2026-03-31
ask v7: bal(konto, 2026-03-20) with w5 = 2026-03-18
ask v8: bal(konto, 2026-03-10) with w5 = 2026-03-18
ask v9: bal(konto, 2026-04-05) with w = 2026-03-06
ask v10: flows(konto, 2026-03) with w5 = 2026-03-20
ask v11: sum(p.cash.amount for p in pads over 2026-03) with w5 = 2026-03-20
ask v11b: sum(p.cash.amount for p in pads over 2026-03 .. 2026-04) with w5 = 2026-03-20, w7 = 2026-04-20
ask v12: residuals konto 2026-03 .. 2026-04
ask v13: explain bal(konto, 2026-04-05) with w5 = 2026-03-20
ask v14: bal(konto, 2026-04-05) with w5 = 2026-03-20 as known 2026-04-20
ask v15: bal(konto, 2026-05-20) with w6 = 2026-05-12, w5 = 2026-03-20
=== expect v3b v3c v8
v3b: 700.00 PLN
  pinned: w5 = 2026-04-12
  pad: konto 2026-03-31 end, pads:st:konto@2026-03-31 end of 105.00 PLN
  cut 2026-06-20
v3c: 700.00 PLN
  pinned: w5 = 2026-05-12
  pad: konto 2026-03-31 end, pads:st:konto@2026-03-31 end of 105.00 PLN
  cut 2026-06-20
v8: 600.00 PLN
  pinned: w5 = 2026-03-18
  cut 2026-06-20
