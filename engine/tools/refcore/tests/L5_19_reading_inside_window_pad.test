# tally 2.2.1 P32, N1 with a pad: the pad's own instant is the stated 700.00 PLN; from 2026-04-03 the hole, flows
# the hole. tally 2.2 printed the hole at the pad and 800.00 PLN after.
=== c3.tally
model c3
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-12-31
source card "invented"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..
input pay: money PLN
input w2: date
move pay_x: transfers
  on w2
  leg cash from world to konto amount pay
version v_card
  cite card
  governs always
  known 2026-01-01
  pay = 100.00 PLN "c"
  w2 = window(2026-04-01, 2026-04-03) "c"
  opening[konto] = 500.00 PLN at 2026-01-01 start "c"
version st2
  cite card
  governs 2026-04
  known 2026-04-10
  pad konto from unexplained
  stated[konto] = 700.00 PLN at 2026-04-02 end "s2"
ask a20260402: bal(konto, 2026-04-02) 
ask a20260402_p20260401: bal(konto, 2026-04-02)  with w2 = 2026-04-01
ask a20260402_p20260402: bal(konto, 2026-04-02)  with w2 = 2026-04-02
ask a20260402_p20260403: bal(konto, 2026-04-02)  with w2 = 2026-04-03
ask a20260403: bal(konto, 2026-04-03) 
ask a20260403_p20260401: bal(konto, 2026-04-03)  with w2 = 2026-04-01
ask a20260403_p20260402: bal(konto, 2026-04-03)  with w2 = 2026-04-02
ask a20260403_p20260403: bal(konto, 2026-04-03)  with w2 = 2026-04-03
ask a20260405: bal(konto, 2026-04-05) 
ask a20260405_p20260401: bal(konto, 2026-04-05)  with w2 = 2026-04-01
ask a20260405_p20260402: bal(konto, 2026-04-05)  with w2 = 2026-04-02
ask a20260405_p20260403: bal(konto, 2026-04-05)  with w2 = 2026-04-03
ask fl: flows(konto, 2026-04)
ask fl_p01: flows(konto, 2026-04) with w2 = 2026-04-01
ask fl_p03: flows(konto, 2026-04) with w2 = 2026-04-03
=== expect
a20260402: 700.00 PLN
  pad: konto 2026-04-02 end, pads:st2:konto@2026-04-02 end of ?"date within window(2026-04-01, 2026-04-03) not precise enough for a balance" (pay_x)
  cut 2026-04-20
a20260402_p20260401: 700.00 PLN
  pad: konto 2026-04-02 end, pads:st2:konto@2026-04-02 end of 100.00 PLN
  cut 2026-04-20
a20260402_p20260402: 700.00 PLN
  pad: konto 2026-04-02 end, pads:st2:konto@2026-04-02 end of 100.00 PLN
  cut 2026-04-20
