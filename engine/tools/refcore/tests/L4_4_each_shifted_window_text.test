# tally 2.1.8 R13 (STOP-REPORT 4 of T's re-run, pick P37; T's m2/fixes/g3/i2, plan §14's K1 gate): qs compares x2,
# a def over the December added window, with add_days(x1, 183), x1's June window shifted, which prints as the same
# window: windows each takes December, then June under each of its days, as stored. 27f44590 kept the first window
# its question's text carried and printed qs as one hole.
=== m.tally
model pi
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source card "invented"
unit PLN: currency minor 0.01

input cal: calendar
input d1: date
input d2: date
input gap: int

ask q: add_business(d1, 1, cal) windows each
ask r: add_business(d2, 1, cal) law 2026-11-30 windows each
ask qr: x1 < x2 windows each
ask qs: x2 == add_days(x1, gap) windows each
ask qp: x2 == add_days(x1, gap)
ask qd: x2 law 2026-05-01 windows each

def x1: date at d1
  rule base = add_business(d1, 1, cal)

def x2: date at d2
  rule base = add_business(d2, 1, cal)

version v
  cite card
  governs always
  known 2026-01-01
  d1 = 2026-05-29 "c"
  d2 = 2026-11-30 "c"
  gap = 183 "c"

version c1
  cite card
  governs ..2026-06-30
  known 2026-01-01
  cal = calendar(weekends [sat, sun], added [window(2026-06-01, 2026-06-02)]) "c"

version c2
  cite card
  governs 2026-07-01..
  known 2026-01-01
  cal = calendar(weekends [sat, sun], added [window(2026-12-01, 2026-12-02)]) "c"
=== expect qd qs
qd [added window(2026-12-01, 2026-12-02) = 2026-12-01]: 2026-12-02
  held: cal = calendar(weekends [sat, sun]) (c2), read for 2026-12-01
  held: cal = calendar(weekends [sat, sun]) (c2), read for 2026-12-02
  law date 2026-05-01, cut 2026-03-01
qd [added window(2026-12-01, 2026-12-02) = 2026-12-02]: 2026-12-01
  held: cal = calendar(weekends [sat, sun]) (c2), read for 2026-12-01
  law date 2026-05-01, cut 2026-03-01
qs [added window(2026-12-01, 2026-12-02) = 2026-12-01, added window(2026-06-01, 2026-06-02) = 2026-06-01]: true
  held: cal = calendar(weekends [sat, sun]) (c2), read for 2026-12-01
  held: cal = calendar(weekends [sat, sun]) (c2), read for 2026-12-02
  cut 2026-03-01
qs [added window(2026-12-01, 2026-12-02) = 2026-12-01, added window(2026-06-01, 2026-06-02) = 2026-06-02]: false
  held: cal = calendar(weekends [sat, sun]) (c2), read for 2026-12-01
  held: cal = calendar(weekends [sat, sun]) (c2), read for 2026-12-02
  cut 2026-03-01
qs [added window(2026-12-01, 2026-12-02) = 2026-12-02, added window(2026-06-01, 2026-06-02) = 2026-06-01]: false
  held: cal = calendar(weekends [sat, sun]) (c2), read for 2026-12-01
  cut 2026-03-01
qs [added window(2026-12-01, 2026-12-02) = 2026-12-02, added window(2026-06-01, 2026-06-02) = 2026-06-02]: true
  held: cal = calendar(weekends [sat, sun]) (c2), read for 2026-12-01
  cut 2026-03-01
