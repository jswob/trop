# tally 2.1.8 R16, L §4.6, E §4.2 step 1 (T's fixes/gate8/r437_after_m_end): only the standing-in legs the walk
# books count, inside [S, E] and before the cut: o1 on E, not o3 after E.
=== m.tally
model t
  tally 2
  on 2026-04-10
  start 2026-03-01
  end 2026-03-31
  note "T, M2 gate 8 run 43702332507: last of a reading after m, m fulfilled by o1 at konto on the run's last day E (03-31), o3 at konto on 04-02 past E, the cut after E: the reading stands on E (book/reading.rs last_standing_day > to ==, > to >=; walk/agenda.rs last_standing_in || to &&)"

source s "s"
unit PLN: currency minor 0.01
kind savings: place PLN min 0
place konto: accounts PLN lives 2026-01-01..
place sav: savings lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input keep: money PLN
input d_save: int

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = 15 "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"


version st
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[o1] = (on: 2026-03-31, kind: transfers, leg cash from konto to sav amount 500.00 PLN, fulfils: save[2026-03]) "o1"
  bank[o2] = (on: 2026-03-16, kind: transfers, leg cash from sav to world amount 20.00 PLN, fulfils: save[2026-03]) "o2"

version late
  cite s
  governs 2026-04
  known 2026-04-03
  bank[o3] = (on: 2026-04-02, kind: transfers, leg cash from konto to sav amount 5.00 PLN, fulfils: save[2026-03]) "o3"

version rd
  cite s
  governs 2026-03
  known 2026-04-04
  pad konto from world
  stated[konto] = 90.00 PLN after save[2026-03] "saldo"

ask l16: last(stated[konto], 2026-03-16)
ask l30: last(stated[konto], 2026-03-30)
ask l31: last(stated[konto], 2026-03-31)
ask b16: bal(konto, 2026-03-16)
ask b30: bal(konto, 2026-03-30)
ask b31: bal(konto, 2026-03-31)
=== expect
b16: 1 050.00 PLN
  cut 2026-04-10
b30: 1 050.00 PLN
  cut 2026-04-10
b31: 90.00 PLN
  pad: konto after save[2026-03], pads:rd:konto@after save[2026-03] of -460.00 PLN
  cut 2026-04-10
l16: ?"stated[konto] has no reading on or before 2026-03-16" (stated[konto])
  cut 2026-04-10
l30: ?"stated[konto] has no reading on or before 2026-03-30" (stated[konto])
  cut 2026-04-10
l31: 90.00 PLN
  cut 2026-04-10
warning: WARN-LEGS the two observations of save[2026-03] disagree: bank[o1] (500.00 PLN) and bank[o3] (5.00 PLN)
warning: WARN-LEGS the two observations of save[2026-03] disagree: bank[o2] (20.00 PLN) and bank[o3] (5.00 PLN)
