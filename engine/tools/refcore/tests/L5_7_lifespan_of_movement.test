# L §5.7, §8.4 (tally 2.1.7 R5, issue #144; #136): a movement has its day, not a lifespan, and load's types
# show it: LOAD-UNIT lifespan of <x>: a movement has its day, not a lifespan. 2.1.6's refcore crashed at run.
# (T's G14 vectors b6_model, b6_l3.)
=== b6_model.tally
model rv
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source card "card"

unit PLN: currency minor 0.01

index qs = [q1, q2]

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input w: date

input wy: date

input n5: int

input n2: int

input d1: date

input d2: date

input rr: rate

input t[r in 1 %/year .. 5 %/year step 1 %/year]: num

input kh: int

input r2[n in 1 .. 3, f in 0 .. n step 0.5]: num

ask base: w, wy, n5, d1

version card_2026
  cite card
  governs always
  known 2026-01-01
  w = window(2026-03-03, 2026-03-20) "c"
  wy = window(2026-12-20, 2027-01-10) "c"
  n5 = 5 "c"
  n2 = 2 "c"
  d1 = 2026-01-01 "c"
  d2 = 2027-03-10 "c"
  rr = 2 %/year "c"
  t[2 %/year] = 7 "c"
  r2[1, 0.5] = 3 "c"
=== b6_l3.tally
part l3
  tally 2

input fee3: money PLN

move mv3: transfers
  on d1
  leg cash from konto to world amount fee3

ask l3: lifespan(mv3).from

version vl3
  cite card
  governs always
  known 2026-01-01
  fee3 = 10.00 PLN "c"
=== expect
refused: LOAD-UNIT lifespan of key transfers: a movement has its day, not a lifespan ...
