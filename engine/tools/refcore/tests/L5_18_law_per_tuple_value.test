# tally 2.2.1, 208.R2 (L §5.18: every clause stands on every form): an ask's law that reads its ask-level
# for is read per tuple on a value form too, each tuple at its own law date (v2, v4: 2026-04-01 for b). Before
# W11: REFCORE-NOT-YET (KeyError).
=== m.tally
model pw
  tally 2
  on 2026-04-25
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
index ks = [a, b]
place konto: accounts PLN lives 2026-01-01..
place jar[k in ks]: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input amt: money PLN
input dk[k in ks]: date
input dj: date
input dd: int
input d0: date
input lk[k in ks]: date
input lk2[k in ks]: date
input amt2: money PLN
input rt: money PLN

move one[k in ks]: transfers
  on dk[k]
  at d0
  leg cash from world to jar[k] amount amt

move two: transfers
  on dj
  at d0
  leg cash from world to konto amount amt2

move pay[m in months]: transfers
  on day_of(m, dd)
  at start_of(m)
  leg cash from world to konto amount amt

version v
  cite s
  governs always
  known 2026-01-01
  amt = 10.00 PLN "s"
  dk[a] = window(2026-03-01, 2026-03-10) "s"
  dk[b] = 2026-03-05 "s"
  amt2 = 5.00 PLN "s"
  dd = 10 "s"
  d0 = 2026-01-01 "s"
  lk[a] = 2026-03-01 "s"
  lk[b] = 2026-03-01 "s"
  lk2[a] = 2026-03-01 "s"
  lk2[b] = 2026-04-01 "s"
  dj = window(2026-03-02, 2026-03-04) "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  opening[jar[a]] = 0.00 PLN at 2026-01-01 start "s"
  opening[jar[b]] = 0.00 PLN at 2026-01-01 start "s"

version st
  cite s
  governs 2026-03
  known 2026-04-01
  covers konto, jar[a], jar[b]
  bank[r1] = (on: 2026-03-10, kind: transfers, leg cash from world to konto amount 12.00 PLN) "r1"
  bank[r2] = (on: 2026-03-03, kind: transfers, leg cash from world to konto amount 5.00 PLN) "r2"
  bank[r3] = (on: 2026-03-06, kind: transfers, leg cash from world to jar[a] amount 10.00 PLN) "r3"
  bank[r4] = (on: 2026-03-05, kind: transfers, leg cash from world to jar[b] amount 10.00 PLN) "r4"
version vr
  cite s
  governs 2026-03
  known 2026-01-01
  rt = 1.00 PLN "s"
version vr2
  cite s
  governs 2026-04
  known 2026-01-01
  rt = 2.00 PLN "s"
ask v1: dk[k] for k in ks law lk[k]
ask v2: dk[k] for k in ks law lk2[k]
ask v3: dk[k] for k in ks law 2026-03-01
ask v4: rt for k in ks law lk2[k]
=== expect v1 v2 v3 v4
v1 (k = a): window(2026-03-01, 2026-03-10)
  law date 2026-03-01, cut 2026-04-25
v1 (k = b): 2026-03-05
  law date 2026-03-01, cut 2026-04-25
v2 (k = a): window(2026-03-01, 2026-03-10)
  law date 2026-03-01, cut 2026-04-25
v2 (k = b): 2026-03-05
  law date 2026-04-01, cut 2026-04-25
v3 (k = a): window(2026-03-01, 2026-03-10)
  law date 2026-03-01, cut 2026-04-25
v3 (k = b): 2026-03-05
  law date 2026-03-01, cut 2026-04-25
v4 (k = a): 1.00 PLN
  law date 2026-03-01, cut 2026-04-25
v4 (k = b): 2.00 PLN
  law date 2026-04-01, cut 2026-04-25
