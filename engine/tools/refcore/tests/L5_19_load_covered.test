# L §8.3 LOAD-COVERED: "<def> aggregates observations over a span with no covered() guard" (L §5.19): spent sums
# the bank rows over a month without covered(konto, m).
# Own reality: konto opens at 5 000.00 PLN, savings at 0; amt = 1 000.00 PLN, dom = 5.
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source bank "bank"
unit PLN: currency minor 0.01
input bank_rows: observed
input amt: money PLN
input dom: int
place konto: accounts PLN lives 2019-05-01..
place savings: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..

def spent[m in months]: money PLN = sum(o.cash.amount for o in bank_rows over m)

version stmt
  cite bank
  governs 2026-02
  known 2026-03-02
  covers konto
  pad konto from unexplained
  bank_rows[r1] = (on: 2026-02-05, kind: transfers, leg cash from konto to world amount 100.00 PLN) "line 1"

ask q: spent[2026-02]

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  amt = 1 000.00 PLN "own"
  dom = 5 "own"
  opening[konto] = 5 000.00 PLN at 2026-01-01 start "wyciąg"
  opening[savings] = 0 PLN at 2026-01-01 start "wyciąg"
=== expect
refused: LOAD-COVERED ...
