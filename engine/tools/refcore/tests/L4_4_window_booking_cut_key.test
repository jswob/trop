# tally 2.1.8 §4 (#169-e), L §5.14.3 and L §4.4: v2, known 2026-03-15, adds the key a2 inside mw[a2]'s day window,
# so whether mw[a2] existed at its booking cut is open: the balance after it is the window's hole (bw). 2.1.7's
# refcore read the key at the last cut and booked it (20.00 PLN). T's fixes/g3/n7.
# tally 2.2 (2.2-4): the clause `windows each` is cut; its asks are the plain line, the hole with each unknown day it
# carries named (`unknown day:`, 2.2-11). A caller who takes the window as one day pins its cell.
=== m.tally
model pn7
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source card "invented"
unit PLN: currency minor 0.01

index acct = [a1]

place konto: accounts PLN lives 2026-01-01..
place work: outside lives 1900-01-01..

input wd: date
input amt: money PLN

move mw[k in acct]: transfers
  on wd
  leg cash from work to konto amount amt

ask bw: bal(konto, 2026-04-30)
ask bww: bal(konto, 2026-04-30)
ask aw: mw[a2].cash.amount

version v
  cite card
  governs always
  known 2026-01-01
  wd = window(2026-03-10, 2026-03-20) "c"
  amt = 10.00 PLN "c"
  opening[konto] = 0.00 PLN at 2026-01-01 start "own"

version v2
  cite card
  governs always
  known 2026-03-15
  acct + [a2]
=== expect
aw: ?"date within window(2026-03-10, 2026-03-20) not precise enough for the booking cut of mw[a2]" (mw[a2])
  unknown day: wd
  cut 2026-06-30
bw: ?"date within window(2026-03-10, 2026-03-20) not precise enough for the booking cut of mw[a2]" (mw[a2])
  unknown day: wd
  unfulfilled: mw[a1]
  cut 2026-06-30
bww: ?"date within window(2026-03-10, 2026-03-20) not precise enough for the booking cut of mw[a2]" (mw[a2])
  unknown day: wd
  unfulfilled: mw[a1]
  cut 2026-06-30
