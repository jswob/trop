# tally 2.2.1, B5's sibling (the review's inv_a, a change not undone): six cuts in one run, each as asked alone.
# tally 2.2 refused with ENGINE-INVARIANT.
=== inv_a.tally
model inv_a
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input w: date
input d_at: date
move pay: transfers
  on w
  at d_at
  leg cash from world to konto amount amt
version v
  cite s
  governs always
  known 2026-01-01
  d_at = 2026-03-01 "s"
  w = window(2026-03-05, 2026-03-20) "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
version a0
  cite s
  governs 2026..
  known 2026-01-01
  amt = 100.00 PLN "s"
version a1
  cite s
  governs 2026..
  known 2026-03-08
  replace amt = 150.00 PLN "s"
ask now: bal(konto, 2026-03-31)
ask k10: bal(konto, 2026-03-31) as known 2026-03-10
ask k07: bal(konto, 2026-03-31) as known 2026-03-07
ask k05: bal(konto, 2026-03-31) as known 2026-03-05
ask k04: bal(konto, 2026-03-31) as known 2026-03-04
ask k21: bal(konto, 2026-03-31) as known 2026-03-21
=== expect
k04: 600.00 PLN
  cut 2026-03-04
k05: 600.00 PLN
  cut 2026-03-05
k07: 600.00 PLN
  unfulfilled: pay
  cut 2026-03-07
k10: ?"date within window(2026-03-05, 2026-03-20) not precise enough for the booking cut of pay" (pay)
  unknown day: w
  unfulfilled: pay
  cut 2026-03-10
k21: ?"date within window(2026-03-05, 2026-03-20) not precise enough for the booking cut of pay" (pay)
  unknown day: w
  unfulfilled: pay
  cut 2026-03-21
now: ?"date within window(2026-03-05, 2026-03-20) not precise enough for the booking cut of pay" (pay)
  unknown day: w
  unfulfilled: pay
  cut 2026-06-10
