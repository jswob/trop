# tally 2.1.8 R16 (#171, vector 5), L §5.11, §5.16: quantile(t for b, q) is type 1 over its terms, its range of q
# included: a level outside (0, 1] that only the run gives (a row's 1.01, a def's 0) is RUN-DOMAIN at that line; 1
# and 0.5 answer. 2.1.7 answered the largest or smallest term (T's probe p3 q1-q3).
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source s "s"
index ks = [a, b, c]
input v[k in ks]: num
input lv[k in ks]: num
def lz: num = lv[a] - lv[a]

version v1
  cite s
  governs always
  known 2026-01-01
  v[a] = 1 "s"
  v[b] = 2 "s"
  v[c] = 3 "s"
  lv[a] = 1.01 "s"
  lv[b] = 1 "s"
  lv[c] = 0.5 "s"

ask q1: quantile(v[k] for k in ks, lv[a])
ask q2: quantile(v[k] for k in ks, lz)
ask q3: quantile(v[k] for k in ks, lv[b])
ask q4: quantile(v[k] for k in ks, lv[c])
ask q5: quantile(v[k] for k in ks, 0.5)
=== expect
q1: refused: RUN-DOMAIN quantile has no meaning for the level 1.01
  cut 2026-10-20
q2: refused: RUN-DOMAIN quantile has no meaning for the level 0
  cut 2026-10-20
q3: 3
  cut 2026-10-20
q4: 2
  cut 2026-10-20
q5: 2
  cut 2026-10-20
