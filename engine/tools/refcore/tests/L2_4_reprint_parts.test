def arrive[m in events, p in parties]: num at m.day
  note "everything is ania's"
  note "a second note"
  rule base = if p == ania then 1 else 0

def b_part: money PLN = bal(konto, 2026-06-30) of (ania, w1) at 2026-06-30

def l_part[m in events]: money PLN = m.cash.amount of ania / 2 at m.day

def v_part: money PLN = value(konto, 2026-06-30) in PLN of ania at 2026-06-30

version v
  cite s
  governs always
  known 2026-01-01
  stated[konto] = 10 PLN at 2026-03-31 end
  stated[konto] of ania = 10 PLN at 2026-03-31 end
