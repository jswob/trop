# L §4.4 (tally 2.1.8 R13, #191 Q4): a window that only an explain's part outside the pins meets is a window the
# line meets: the part is something the form prints, so the line is split by it. Inside the pin ax = hi, f is
# rate - rate at pd and reads no window; outside it, under ax = lo, f is bonus_amt, read at the window wd, 10.00 PLN
# through March and 12.00 PLN from April. A block prints its first sub-window's derivation. 2.1.7's refcore printed
# the first day's derivation unlabelled; the engine printed the hole.
=== m.tally
model w_each
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source card "invented"
unit PLN: currency minor 0.01

axis ax
  lo "low"
  hi "high"

input pd: date
input wd: date
input rate: money PLN
input twice: int

def bonus_amt: money PLN at wd
  rule base = rate
  rule hi beats base = rate * twice when ax == hi

def f: money PLN at pd
  rule base = bonus_amt
  rule hi beats base = rate - rate when ax == hi

version v
  cite card
  governs always
  known 2026-01-01
  pd = 2026-04-01 "c"
  wd = window(2026-03-28, 2026-04-03) "c"
  twice = 2 "c"

version r1
  cite card
  governs ..2026-03-31
  known 2026-01-01
  rate = 10.00 PLN "c"

version r2
  cite card
  governs 2026-04-01..
  known 2026-01-01
  rate = 12.00 PLN "c"

ask q4: explain f with ax = hi windows each
=== expect
q4 [wd = 2026-03-28 .. 2026-03-31]: 0.00 PLN
  [1] the pins, evaluated outside them
    [2] pin ax = hi
  [3] inside the pins: 0.00 PLN
    [4] row v:pd = 2026-04-01
        version v, source card, "invented", locator "c", governs always, known 2026-01-01
    [5] f = 0.00 PLN, law date 2026-04-01
        rule base: beaten by hi
        rule hi: won
          [6] row r2:rate = 12.00 PLN
              version r2, source card, "invented", locator "c", governs 2026-04-01.., known 2026-01-01
  [7] outside the pins [ax = lo]: 10.00 PLN
    (v:pd: see [4])
    [8] f = 10.00 PLN, law date 2026-04-01
        rule base: won
          [9] row v:wd = window(2026-03-28, 2026-04-03)
              version v, source card, "invented", locator "c", governs always, known 2026-01-01
          [10] bonus_amt = 10.00 PLN, law date 2026-03-28
              rule base: won
                [11] row r1:rate = 10.00 PLN
                    version r1, source card, "invented", locator "c", governs ..2026-03-31, known 2026-01-01
              rule hi: not applicable
        rule hi: not applicable
  [12] outside the pins [ax = hi]: 0.00 PLN
    (v:pd: see [4])
    [13] f = 0.00 PLN, law date 2026-04-01
        rule base: beaten by hi
        rule hi: won
          (r2:rate: see [6])
  pinned: ax = hi
  held: rate = 12.00 PLN (r2), read for 2026-04-01
  cut 2026-03-01
q4 [wd = 2026-04-01 .. 2026-04-03]: 0.00 PLN
  [1] the pins, evaluated outside them
    [2] pin ax = hi
  [3] inside the pins: 0.00 PLN
    [4] row v:pd = 2026-04-01
        version v, source card, "invented", locator "c", governs always, known 2026-01-01
    [5] f = 0.00 PLN, law date 2026-04-01
        rule base: beaten by hi
        rule hi: won
          [6] row r2:rate = 12.00 PLN
              version r2, source card, "invented", locator "c", governs 2026-04-01.., known 2026-01-01
  [7] outside the pins [ax = lo]: 12.00 PLN
    (v:pd: see [4])
    [8] f = 12.00 PLN, law date 2026-04-01
        rule base: won
          [9] row v:wd = window(2026-03-28, 2026-04-03)
              version v, source card, "invented", locator "c", governs always, known 2026-01-01
          [10] bonus_amt = 12.00 PLN, law date 2026-04-01
              rule base: won
                (r2:rate: see [6])
              rule hi: not applicable
        rule hi: not applicable
  [11] outside the pins [ax = hi]: 0.00 PLN
    (v:pd: see [4])
    [12] f = 0.00 PLN, law date 2026-04-01
        rule base: beaten by hi
        rule hi: won
          (r2:rate: see [6])
  pinned: ax = hi
  held: rate = 12.00 PLN (r2), read for 2026-04-01
  cut 2026-03-01
