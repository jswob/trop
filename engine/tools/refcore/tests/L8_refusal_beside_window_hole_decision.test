# tally 2.2.1 P41, the fix review's F6 (P31): a decision's refusal stands beside a window's hole when no place it names
# in reads is under it: RUN-DIV as both pins (review g1fix rf_dec); rf_dec2, reading konto, stays the hole.
# Before W8: the hole.
=== rf_dec.tally
model rf_dec
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place konto2: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input zero: num
input w: date
input d_bad: date

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  zero = 0 "s"
  d_bad = 2026-05-10 "s"
  w = window(2026-02-27, 2026-03-03) "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
  opening[konto2] = 500.00 PLN at 2026-03-01 start "s"

move px: transfers
  on w
  leg cash from world to konto amount amt
move dbad: transfers
  on d_bad
  reads konto2
  leg cash from konto to world amount if bal(konto2) > 0 PLN then round(amt / zero, minor(PLN), half-up) else amt
ask b: bal(konto, 2026-05-31)
ask b_p0227: bal(konto, 2026-05-31) with w = 2026-02-27
ask b_p0302: bal(konto, 2026-05-31) with w = 2026-03-02
=== expect
b: refused: RUN-DIV division by zero
  cut 2026-06-10
b_p0227: refused: RUN-DIV division by zero
  pinned: w = 2026-02-27
  left out: px, 1 instances, first 2026-02-27
  cut 2026-06-10
b_p0302: refused: RUN-DIV division by zero
  pinned: w = 2026-03-02
  unfulfilled: px
  cut 2026-06-10
