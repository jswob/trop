# tally 2.3.1 (E §5 step 1, l.247: "a leg's field it changes reads as that hole"; G1's review): a2, known
# after the start, moves k2's leg to another place (`to`) on a window day: k2_to is the window's hole, k2_from
# stays world. Before: k2_from the hole too.
=== p13_moved_leg.tally
model changed_amt
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
  note "T, tally 2.3 (#247), held for #250: a2, known after the start, moves k2's leg to another place and leaves its amount; refcore reads k2's amount as the plan has it (100.00 PLN), the engine reads the whole leg as the hole (book/members.rs mv_field, changed_leg's moved); changed.tally holds the reads both give alike"

source s "invented"

unit PLN: currency minor 0.01

index ks = [k1, k2, k3]

place konto: accounts PLN lives 2026-01-01..
place other: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

input amt[k in ks]: money PLN
input dest[k in ks]: key accounts
input w: date
input d_at: date

move pay[k in ks]: transfers
  on w
  at d_at
  leg cash from world to dest[k] amount amt[k]

version v
  cite s
  governs always
  known 2026-01-01
  d_at = 2026-03-01 "s"
  w = window(2026-03-05, 2026-03-25) "s"
  amt[k1] = 100.00 PLN "s"
  amt[k2] = 100.00 PLN "s"
  amt[k3] = 100.00 PLN "s"
  dest[k1] = konto "s"
  dest[k2] = konto "s"
  dest[k3] = konto "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
  opening[other] = 0.00 PLN at 2026-03-01 start "s"

version a1
  cite s
  governs 2026..
  known 2026-03-20
  replace amt[k1] = 150.00 PLN "s"

version a2
  cite s
  governs 2026..
  known 2026-03-22
  replace dest[k2] = other "s"

version a3
  cite s
  governs 2026..
  known 2026-03-24
  replace amt[k3] = 100.00 PLN "s"
ask k2_amt: pay[k2].cash.amount
ask k2_to: pay[k2].cash.to
ask k2_from: pay[k2].cash.from
ask k2_day: pay[k2].cash.day
ask k2_leg: pay[k2].cash
ask k1_amt: pay[k1].cash.amount
ask k1_to: pay[k1].cash.to
ask k3_amt: pay[k3].cash.amount
ask k3_to: pay[k3].cash.to
ask b_s: sum(t.cash.amount for t in transfers over 2026-03)
ask b_w: sum(t.cash.amount for t in transfers over 2026-03 where t.cash.from == world)
ask b_c: count(t in transfers over 2026-03 where t.cash.to == other)
ask b_k: bal(other, 2026-06-30)
ask b_old: pay[k2].cash.amount as known 2026-03-21
=== expect k2_from k2_to k2_leg k2_amt
k2_from: world
  cut 2026-06-10
k2_to: ?"date within window(2026-03-05, 2026-03-25) not precise enough for the day of pay[k2]" (w)
  unknown day: w
  cut 2026-06-10
k2_leg: (from: world, to: ?"date within window(2026-03-05, 2026-03-25) not precise enough for the day of pay[k2]" (w), amount: 100.00 PLN, day: ?"date within window(2026-03-05, 2026-03-25) not precise enough for the day of pay[k2]" (w))
  unknown day: w
  cut 2026-06-10
k2_amt: 100.00 PLN
  cut 2026-06-10
