# tally 2.2.1 P53 (L §5.19 S-223): a correction is tested against the version of each earlier
# statement of the row: fix2 is refused, stmt still covering konto on the day (review g4fix
# s223/cc_mid_moved). Before W14: fix1 refused.
=== options exit=1
=== cc_mid_moved.tally
model t
  tally 2
  on 2026-04-30
  start 2026-01-01
  end 2026-06-30

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2025-01-01..
place sav: accounts PLN lives 2025-01-01..
place shop: outside lives 1900-01-01..
input bank: observed

version open
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "s"
  opening[sav] = 0.00 PLN at 2026-01-01 start "s"

version stmt
  cite s
  governs 2026-02
  known 2026-03-01
  covers konto
  bank[r1] = (on: 2026-02-10, kind: transfers, leg cash from konto to shop amount 50.00 PLN) "a"

version fix1
  cite s
  governs 2026-02
  known 2026-04-01
  covers konto
  replace bank[r1] = (on: 2026-02-10, kind: transfers, leg cash from konto to shop amount 60.00 PLN) "f1"

version fix2
  cite s
  governs 2026-02
  known 2026-04-05
  replace bank[r1] = (on: 2026-02-10, kind: transfers, leg cash from konto to shop amount 70.00 PLN) "f2"

version mover
  cite s
  governs 2026-02
  known 2026-04-05
  moves fix1 to 2026-03

ask q: bal(konto, 2026-04-30)
ask q_0315: bal(konto, 2026-04-30) as known 2026-03-15
ask q_0402: bal(konto, 2026-04-30) as known 2026-04-02
ask q_0407: bal(konto, 2026-04-30) as known 2026-04-07
=== expect
refused: LOAD-COVERS replace bank[r1] of konto: fix2 doesn't cover konto on 2026-02-10 (cc_mid_moved.tally:39)
