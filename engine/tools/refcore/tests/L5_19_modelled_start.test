# tally 2.1.8 R16 (B5's first form, gate/a7), L §5.19: bal(x, d start) modelled is the plain read's instant: from
# the reading of 2026-03-10 (210.00 PLN), save[2026-03] of the 15th not yet counted at the 15th's start; at its end
# 100.00 PLN. explain lists the movements through d - 1 only, under the head ..., modelled (vector 1). 2.1.7 dropped
# start and printed 100.00 PLN.
=== m.tally
model rec
  tally 2
  on 2026-04-10
  start 2026-01-01
  end 2026-12-31
  note "gate probe a3: axis x partial x modelled x residuals x projections"

source s "synthetic"

unit PLN: currency minor 0.01

axis ax
  lo "low"
  hi "high"

place konto: accounts PLN lives 2026-01-01..

place sav: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input bank: observed

input keep: money PLN

input amt: money PLN

input extra[m in months]: money PLN question "extra?"

input d_save: int

input d_bonus: int

def pay_amt: money PLN at reader
  rule base = amt
  rule high beats base = amt + amt when ax == hi

move pay[m in months]: transfers
  on start_of(m)
  at start_of(m)
  leg cash from world to konto amount pay_amt

move bonus[m in months]: transfers
  on day_of(m, d_bonus)
  leg cash from world to konto amount extra[m]

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)


version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  amt = 1000.00 PLN "s"
  d_save = 15 "s"
  d_bonus = 5 "s"
  extra[*] = 0.00 PLN "none"
  extra[2026-05] = ?"What is May's extra?" "May"
  extra[2026-03] = 30.00 PLN "March"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  opening[sav] = 0.00 PLN at 2026-01-01 start "s"

version st_konto
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  anchor konto
  bank[a1] = (on: 2026-03-01, kind: transfers, leg cash from world to konto amount 1000.00 PLN, fulfils: pay[2026-03]) "PENSJA"
  bank[a2] = (on: 2026-03-15, kind: transfers, leg cash from konto to sav amount 950.00 PLN, fulfils: save[2026-03]) "NA OSZCZEDNOSCI"
  bank[a3] = (on: 2026-03-20, kind: transfers, leg cash from world to konto amount 50.00 PLN) "DOPLATA"
  stated[konto] = 210.00 PLN at 2026-03-10 end "saldo 10"
  stated[konto] = 100.00 PLN at 2026-03-31 end "saldo"

ask s1: bal(konto, 2026-03-15 start) modelled, bal(konto, 2026-03-15) modelled with ax = lo
ask s2: explain bal(konto, 2026-03-15 start) modelled with ax = lo
=== expect
s1: (210.00 PLN, 100.00 PLN)
  pinned: ax = lo
  anchor: konto 2026-03-10 end, stated 210.00 PLN, difference -890.00 PLN
  cut 2026-04-10
s2: 210.00 PLN
  balance of konto (PLN) at the start of 2026-03-15, modelled
  from: anchor st_konto:stated[konto] 2026-03-10 end = 210.00 PLN, 2026-03-10 end (version st_konto, source s, locator "saldo 10"), gap role anchor, gap -890.00 PLN
  no movement
  pinned: ax = lo
  cut 2026-04-10
warning: WARN-NEGATIVE konto is below zero from 2026-03-15
