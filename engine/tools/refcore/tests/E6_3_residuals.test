# E §6.3 the residual ledger (L §5.18 residuals).  Own reality: konto opens at 10 000.00 PLN; wage 5 000.00 PLN on
# day 10, rent 2 000.00 PLN on day 3 each month.  Statements cover konto in February (rent observed as planned, the
# wage 5 300.00 PLN on the 12th, groceries 400.00 PLN fulfilling nothing, stated 15 800.00 PLN at 2026-02-28 end) and
# March (rent only, stated 13 800.00 PLN); January is covered by none, so it prints no line.
# Hand-checked from the stated rules (signs: a flow into konto +, out -; differences observed - model):
#   matched rent: 0.00, timing +0 days; matched wage: 5 300 - 5 000 = +300.00, timing 2026-02-12 - 2026-02-10 =
#   +2 days; unexplained groceries: -400.00; expected but missing wage[2026-03]: -5 000.00 (it is modelled past on
#   a covered day, E §6.2); balance 2026-02-28: booked 13 000 (January, booked) - 2 000 + 5 300 - 400 = 15 900,
#   stated 15 800, gap -100.00 (padded); balance 2026-03-31: booked 15 800 (the pad made it the statement's) - 2 000
#   = 13 800, gap 0.00 ("whatever its gap (0.00 included)").
# Groups by month and move id (balance lines in `balance`, unexplained in `unexplained`), sorted by the absolute
# total difference, biggest first, ties by month then group name (E §6.3 Order).
# back: the backtest (K = 2026-01-15 < on): the model at cut K, where the statements aren't known, so the balances
# are the forecast's: 16 000 at February's end (gap -200.00) and 19 000 at March's (gap -5 200.00); the observations
# as known on `on` (E §6.3).
# byp: `by payee` (a field of the observed input): the unexplained line goes by its payee; lines with no
# observation, or whose observations lack the field, go by their move (E §6.3 Grouping).
# The layout is this interpreter's.
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source bank_2026_02 "bank"
source bank_2026_03 "bank"
unit PLN: currency minor 0.01
kind wages: event certain
  leg cash: PLN
kind groceries: transfers
  attr payee: text
input bank: observed
input wage_amt: money PLN
input rent_amt: money PLN
input wage_dom: int
input rent_dom: int
place konto: accounts PLN lives 2019-05-01..
place landlord: outside lives 1900-01-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..

move wage[m in months]: wages
  on day_of(m, wage_dom)
  at start_of(m)
  leg cash from world to konto amount wage_amt

move rent[m in months]: transfers
  on day_of(m, rent_dom)
  at start_of(m)
  leg cash from konto to landlord amount rent_amt

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  wage_amt = 5 000.00 PLN "umowa"
  rent_amt = 2 000.00 PLN "umowa najmu"
  wage_dom = 10 "umowa"
  rent_dom = 3 "umowa najmu"
  opening[konto] = 10 000.00 PLN at 2026-01-01 start "wyciąg"

version statement_02
  cite bank_2026_02
  governs 2026-02
  known 2026-03-02
  covers konto
  pad konto from unexplained
  bank[r1] = (on: 2026-02-03, kind: transfers, leg cash from konto to landlord amount 2 000.00 PLN, fulfils: rent[2026-02]) "line 1"
  bank[r2] = (on: 2026-02-12, kind: wages, leg cash from world to konto amount 5 300.00 PLN, fulfils: wage[2026-02]) "line 2"
  bank[r3] = (on: 2026-02-20, kind: groceries, leg cash from konto to world amount 400.00 PLN, payee: "BIEDRONKA") "line 3"
  stated[konto] = 15 800.00 PLN at 2026-02-28 end "saldo"

version statement_03
  cite bank_2026_03
  governs 2026-03
  known 2026-04-02
  covers konto
  pad konto from unexplained
  bank[r4] = (on: 2026-03-03, kind: transfers, leg cash from konto to landlord amount 2 000.00 PLN, fulfils: rent[2026-03]) "line 4"
  stated[konto] = 13 800.00 PLN at 2026-03-31 end "saldo"

ask led: residuals konto 2026-01..2026-03
ask back: residuals konto 2026-01..2026-03 as known 2026-01-15
ask byp: residuals konto 2026-02 by payee
=== expect
back: residuals konto 2026-01 .. 2026-03
  2026-03 balance: model 19 000.00 PLN, observed 13 800.00 PLN, difference -5 200.00 PLN
    balance konto 2026-03-31 end (padded): booked 19 000.00 PLN, stated 13 800.00 PLN, gap -5 200.00 PLN
  2026-03 move wage: model 5 000.00 PLN, observed 0.00 PLN, difference -5 000.00 PLN
    expected but missing wage[2026-03] on 2026-03-10: model 5 000.00 PLN
  2026-02 unexplained: model 0.00 PLN, observed -400.00 PLN, difference -400.00 PLN
    unexplained bank[r3] on 2026-02-20: observed -400.00 PLN
  2026-02 move wage: model 5 000.00 PLN, observed 5 300.00 PLN, difference 300.00 PLN
    matched wage[2026-02] on 2026-02-10: model 5 000.00 PLN, observed 5 300.00 PLN, difference 300.00 PLN, timing +2 days
  2026-02 balance: model 16 000.00 PLN, observed 15 800.00 PLN, difference -200.00 PLN
    balance konto 2026-02-28 end (padded): booked 16 000.00 PLN, stated 15 800.00 PLN, gap -200.00 PLN
  2026-02 move rent: model -2 000.00 PLN, observed -2 000.00 PLN, difference 0.00 PLN
    matched rent[2026-02] on 2026-02-03: model -2 000.00 PLN, observed -2 000.00 PLN, difference 0.00 PLN, timing +0 days
  2026-03 move rent: model -2 000.00 PLN, observed -2 000.00 PLN, difference 0.00 PLN
    matched rent[2026-03] on 2026-03-03: model -2 000.00 PLN, observed -2 000.00 PLN, difference 0.00 PLN, timing +0 days
  cut 2026-01-15
byp: residuals konto 2026-02 by payee
  2026-02 "BIEDRONKA": model 0.00 PLN, observed -400.00 PLN, difference -400.00 PLN
    unexplained bank[r3] on 2026-02-20: observed -400.00 PLN
  2026-02 move wage: model 5 000.00 PLN, observed 5 300.00 PLN, difference 300.00 PLN
    matched wage[2026-02] on 2026-02-10: model 5 000.00 PLN, observed 5 300.00 PLN, difference 300.00 PLN, timing +2 days
  2026-02 balance: model 15 900.00 PLN, observed 15 800.00 PLN, difference -100.00 PLN
    balance konto 2026-02-28 end (padded): booked 15 900.00 PLN, stated 15 800.00 PLN, gap -100.00 PLN
  2026-02 move rent: model -2 000.00 PLN, observed -2 000.00 PLN, difference 0.00 PLN
    matched rent[2026-02] on 2026-02-03: model -2 000.00 PLN, observed -2 000.00 PLN, difference 0.00 PLN, timing +0 days
  cut 2026-10-20
led: residuals konto 2026-01 .. 2026-03
