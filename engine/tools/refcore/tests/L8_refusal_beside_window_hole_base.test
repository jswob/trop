# tally 2.2.1 P31, B4's base twin: px on a window across the run's start beside the same refused move: b0531 is
# RUN-DIV, as both pins. tally 2.2 printed the window's hole.
=== ot2.tally
model ot2
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input zero: num
input w: date
input d_bad: date
move bad: transfers
  on d_bad
  leg cash from konto to world amount round(amt / zero, minor(PLN), half-up)
version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  zero = 0 "s"
  d_bad = 2026-05-10 "s"
  w = window(2026-02-27, 2026-03-03) "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
move px: transfers
  on w
  leg cash from world to konto amount amt
ask b0531: bal(konto, 2026-05-31)
ask p0227: bal(konto, 2026-05-31) with w = 2026-02-27
ask p0302: bal(konto, 2026-05-31) with w = 2026-03-02
=== expect
b0531: refused: RUN-DIV division by zero
  cut 2026-06-10
p0227: refused: RUN-DIV division by zero
  pinned: w = 2026-02-27
  left out: px, 1 instances, first 2026-02-27
  cut 2026-06-10
p0302: refused: RUN-DIV division by zero
  pinned: w = 2026-03-02
  unfulfilled: px
  cut 2026-06-10
