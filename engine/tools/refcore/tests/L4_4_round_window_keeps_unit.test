# tally 2.2.1 (the builder's m1 record fixes/g13/rf_w_model_with_rf_w_w15): round over a window whose
# pinned days give 1.00 PLN and 0.00 PLN is the hole, never RUN-DOMAIN: an interval taken in turn keeps its
# unit (num_at). Before W8: refused RUN-DOMAIN.
=== rf_w_model.tally
model rv
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source card "card"

unit PLN: currency minor 0.01

index qs = [q1, q2]

place konto: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input w: date

input wy: date

input n5: int

input n2: int

input d1: date

input d2: date

input rr: rate

input t[r in 1 %/year .. 5 %/year step 1 %/year]: num

input kh: int

input r2[n in 1 .. 3, f in 0 .. n step 0.5]: num

ask base: w, wy, n5, d1

version card_2026
  cite card
  governs always
  known 2026-01-01
  w = window(2026-03-03, 2026-03-20) "c"
  wy = window(2026-12-20, 2027-01-10) "c"
  n5 = 5 "c"
  n2 = 2 "c"
  d1 = 2026-01-01 "c"
  d2 = 2027-03-10 "c"
  rr = 2 %/year "c"
  t[2 %/year] = 7 "c"
  r2[1, 0.5] = 3 "c"
=== rf_w_w15p.tally
part w15
  tally 2

ask w15: round(age(w, d2) * 1.00 PLN, 0.01 PLN, down)
ask w15_lo: round(age(w, d2) * 1.00 PLN, 0.01 PLN, down) with w = 2026-03-03
ask w15_hi: round(age(w, d2) * 1.00 PLN, 0.01 PLN, down) with w = 2026-03-20
ask w15_v: age(w, d2) * 1.00 PLN
=== expect w15 w15_lo w15_hi
w15: ?"date within window(2026-03-03, 2026-03-20) not precise enough for a print" (w)
  unknown day: w
  cut 2026-03-01
w15_lo: 1.00 PLN
  pinned: w = 2026-03-03
  cut 2026-03-01
w15_hi: 0.00 PLN
  pinned: w = 2026-03-20
  cut 2026-03-01
warning: WARN-UNREAD input kh is read by nothing
warning: WARN-UNREAD input n2 is read by nothing
warning: WARN-UNREAD input r2 is read by nothing
warning: WARN-UNREAD input rr is read by nothing
warning: WARN-UNREAD input t is read by nothing
warning: WARN-UNREAD place konto is read by nothing
warning: WARN-UNREAD place world is read by nothing
