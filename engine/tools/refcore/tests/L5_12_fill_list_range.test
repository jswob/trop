# L §5.12 fill sides over a key list ([1, 2]) and a stepped range (1 .. n_years) (L §5.11 binds).  Arcs t >= o in
# order (o, t): (1,1) min(100, 30) = 30, R = 70; (1,2) min(70, 80) = 70, R = 0; (1,3) R = 0: 0; (2,1) is no arc: 0
# (Outputs); (2,2) min(50, 80 - 70 = 10) = 10, R = 40; (2,3) min(40, 80) = 40.
=== m.tally
model fl
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
input credit[o in yrs]: money PLN
input room[t in yrs]: money PLN
input n_years: int
index yrs = int 1..3

fill absorb
  supply credit[o] for o in [1, 2]
  demand room[t] for t in 1 .. n_years
  arc t >= o
  order o, t

version v
  cite s
  governs always
  known 2020-01-01
  credit[1] = 100.00 PLN
  credit[2] = 50.00 PLN
  credit[3] = 0.00 PLN
  room[1] = 30.00 PLN
  room[2] = 80.00 PLN
  room[3] = 80.00 PLN
  n_years = 3

ask f1: absorb.taken[o, t] for o in [1, 2], t in 1 .. n_years
=== expect
f1 (o = 1, t = 1): 30.00 PLN
  cut 2026-12-31
f1 (o = 1, t = 2): 70.00 PLN
  cut 2026-12-31
f1 (o = 1, t = 3): 0.00 PLN
  cut 2026-12-31
f1 (o = 2, t = 1): 0.00 PLN
  cut 2026-12-31
f1 (o = 2, t = 2): 10.00 PLN
  cut 2026-12-31
f1 (o = 2, t = 3): 40.00 PLN
  cut 2026-12-31
