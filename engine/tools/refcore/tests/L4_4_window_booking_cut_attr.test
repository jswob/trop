# tally 2.1.8 §4 (#169-e), L §5.14.3 and L §4.4: v2, known 2026-03-15, changes mw's size inside mw's day window, so
# its booking cut, min(day, K), is open across v2's known: the size is the window's hole (sw), its amount agrees (aw).
# 2.1.7's refcore read the attributes at the first cut (sw 1). T's fixes/g3/n6.
# tally 2.2 (2.2-4): the clause `windows each` is cut; its asks are the plain line, the hole with each unknown day it
# carries named (`unknown day:`, 2.2-11). A caller who takes the window as one day pins its cell.
=== m.tally
model pn6
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source card "invented"
unit PLN: currency minor 0.01

kind tagged: transfers
  attr size: int

place konto: accounts PLN lives 2026-01-01..
place work: outside lives 1900-01-01..

input wd: date
input amt: money PLN
input sz: int

move mw: tagged
  on wd
  attr size = sz
  leg cash from work to konto amount amt

ask sw: mw.size
ask sww: mw.size
ask aw: mw.cash.amount
ask bw: bal(konto, 2026-04-30)

version v
  cite card
  governs always
  known 2026-01-01
  wd = window(2026-03-10, 2026-03-20) "c"
  amt = 10.00 PLN "c"
  sz = 1 "c"
  opening[konto] = 0.00 PLN at 2026-01-01 start "own"

version v2
  cite card
  governs always
  known 2026-03-15
  replace sz = 2 "c"
=== expect
aw: 10.00 PLN
  cut 2026-06-30
bw: 10.00 PLN
  unfulfilled: mw
  cut 2026-06-30
sw: ?"date within window(2026-03-10, 2026-03-20) not precise enough for the booking cut of mw" (mw)
  unknown day: wd
  cut 2026-06-30
sww: ?"date within window(2026-03-10, 2026-03-20) not precise enough for the booking cut of mw" (mw)
  unknown day: wd
  cut 2026-06-30
