# tally 2.2.1 P41, the fix review's F1: +, -, abs, pow, round over windows of 517 days times 1000 are read from their ends
# (review g1fix big). Before W8: the hole for each.
=== big.tally
model a1
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31
source card "invented"
input w: date
input w2: date
input wl: date
input wl2: date
input d0: date
input d1: date
input de: date
input n0: num
input n2: num
input n3: num
input n4: num
input n8: num
input n9: num
input n10: num
input n20: num
input n27: num
input n33: num
input n100: num
input n171: num
input n1000: num
input m1: num
input m7: num
input m8: num
input m100: num
input m1x: num
input mm: month
input md: month
version v_card
  cite card
  governs always
  known 2026-01-01
  w = window(2026-03-10, 2026-03-12) "c"
  w2 = window(2026-03-20, 2026-03-21) "c"
  wl = window(2026-01-01, 2027-06-01) "c"
  wl2 = window(2026-01-01, 2026-12-31) "c"
  d0 = 2026-03-11 "c"
  d1 = 2026-03-01 "c"
  de = 2025-12-30 "c"
  n0 = 0 "c"
  n2 = 2 "c"
  n3 = 3 "c"
  n4 = 4 "c"
  n8 = 8 "c"
  n9 = 9 "c"
  n10 = 10 "c"
  n20 = 20 "c"
  n27 = 27 "c"
  n33 = 33 "c"
  n100 = 100 "c"
  n171 = 171 "c"
  n1000 = 1000 "c"
  m1 = -1 "c"
  m7 = -7 "c"
  m8 = -8 "c"
  m100 = -100 "c"
  m1x = -1 "c"
  mm = 2026-02 "c"
  md = 2026-03 "c"
def xl: num = days_between(de, wl)
def yl: num = days_between(de, wl2)
ask big_add: xl + yl > m1
ask big_add_p: xl + yl > m1 with wl = 2026-01-01, wl2 = 2026-01-01
ask big_sub: xl - yl < n1000
ask big_mul1: xl * n1000 > n0
ask big_abs: abs(xl * n1000) >= n0
ask big_abs_neg: abs(xl * m1) > n0
ask big_pow: pow(xl * n1000, n2) > n0
ask big_round: round(xl * n1000, 1, half-up) > n0
ask big_dayof: day_of(md, xl * n1000) > d1
ask mid_add: days_between(d1, w) * n1000 + days_between(d1, w2) > n0
ask mid_add_p: days_between(d1, w) * n1000 + days_between(d1, w2) > n0 with w = 2026-03-10, w2 = 2026-03-20
=== expect big_add big_sub big_abs big_pow big_round big_add_p
big_add: true
  cut 2026-01-01
big_sub: true
  cut 2026-01-01
big_abs: true
  cut 2026-01-01
big_pow: true
  cut 2026-01-01
big_round: true
  cut 2026-01-01
big_add_p: true
  pinned: wl = 2026-01-01
  pinned: wl2 = 2026-01-01
  cut 2026-01-01
warning: WARN-UNREAD input d0 is read by nothing
warning: WARN-UNREAD input m100 is read by nothing
warning: WARN-UNREAD input m1x is read by nothing
warning: WARN-UNREAD input m7 is read by nothing
warning: WARN-UNREAD input m8 is read by nothing
warning: WARN-UNREAD input mm is read by nothing
warning: WARN-UNREAD input n10 is read by nothing
warning: WARN-UNREAD input n100 is read by nothing
warning: WARN-UNREAD input n171 is read by nothing
warning: WARN-UNREAD input n20 is read by nothing
warning: WARN-UNREAD input n27 is read by nothing
warning: WARN-UNREAD input n3 is read by nothing
warning: WARN-UNREAD input n33 is read by nothing
warning: WARN-UNREAD input n4 is read by nothing
warning: WARN-UNREAD input n8 is read by nothing
warning: WARN-UNREAD input n9 is read by nothing
