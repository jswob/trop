# L §4.4 (tally 2.1.8 R13, X1; c3n n2): a window used as a key (a) is the unknown the plain hole carries; with a =
# 2026-03-01 the read b[2026-03-01] is a window of its own, taken in turn (nested), and with a = 2026-03-02 the
# answer carries none. The same lines as 2.1.7's refcore: a guard.
=== m.tally
model t
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-06-30

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2025-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input w1: date
input w2: date
input w3: date
input a: date
input b[d in days]: date

move m1: transfers
  on w1
  leg cash from world to konto amount amt

move m2: transfers
  on w2
  leg cash from world to konto amount amt

move m3: transfers
  on w3
  leg cash from world to konto amount amt

version v
  cite s
  governs always
  known 2025-12-01
  amt = 100.00 PLN "s"
  w1 = window(2026-03-05, 2026-03-07) "s"
  w2 = window(2026-03-06, 2026-03-08) "s"
  w3 = window(2026-05-01, 2026-05-03) "s"
  a = window(2026-03-01, 2026-03-02) "s"
  b[2026-03-01] = window(2026-04-01, 2026-04-02) "s"
  b[2026-03-02] = 2026-05-01 "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"

ask n1: b[a] > 2026-04-01
ask n2: b[a] > 2026-04-01 windows each
=== expect
n1: ?"date within window(2026-03-01, 2026-03-02) not precise enough for a key" (a)
  cut 2026-01-01
n2 [a = 2026-03-01, b[2026-03-01] = 2026-04-01]: false
  cut 2026-01-01
n2 [a = 2026-03-01, b[2026-03-01] = 2026-04-02]: true
  cut 2026-01-01
n2 [a = 2026-03-02]: true
  cut 2026-01-01
