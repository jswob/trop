# tally 2.3.1 R5 (L §5.18 l.1610, G2 review B2): a check whose side is none prints no difference (c1 to c4).
# Before: a Python TypeError or AttributeError (REFCORE-NOT-YET).
=== a5_none.tally
model a5
  tally 2
  on 2026-10-25
  start 2026-01-01
  end 2026-12-31

source s "invented"

index ks = [k1, k2, k3]
index ms = month 2026-01..2026-12
input a: key ks
input m1: key ms
input c: bool
def dn: key ks = if c then k2 else none
ask c1: check a == k1
ask c2: check dn == k1
ask c3: check m1 == 2026-01
ask c4: check k1 == dn
version v
  cite s
  governs always
  known 2026-01-01
  a = none "s"
  m1 = none "s"
  c = false "s"
=== expect
c1: differs: a = none, k1 = k1
  cut 2026-10-25
c2: differs: dn = none, k1 = k1
  cut 2026-10-25
c3: differs: m1 = none, 2026-01 = 2026-01
  cut 2026-10-25
c4: differs: k1 = k1, dn = none
  cut 2026-10-25
