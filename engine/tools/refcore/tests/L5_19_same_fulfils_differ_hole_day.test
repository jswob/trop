# tally 2.1.8 P50, R11 (#180), L §8 (G2 of group 4's fix review, agent/b2_cut): a count or sum of a binding over a
# day with no value (dh), where one of the instances it could meet is refused by S1's two fulfils, is refused, as
# with a where: hd and hs RUN-RECORD. A cut before the same line (k1, k3) answers. aa343e62 gave dh's hole.
=== m.tally
model p
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
kind pays: event certain
  leg cash: PLN
place konto: accounts PLN lives 2026-01-01..
place work: outside lives 1900-01-01..
input amt[m in months]: money PLN
input dh: date
input bank: observed
input card: observed
def tot[m in months]: money PLN = sum(p.cash.amount for p in pays over m)

move pay[m in months]: pays
  on start_of(m)
  leg cash from work to konto amount amt[m]

ask b3: bal(konto, 2026-03-31)
ask t2: tot[2026-02]
ask t3: tot[2026-03]
ask c3: count(p in pays over 2026-03)

version v
  cite s
  governs always
  known 2026-01-01
  amt[2026-01..2026-06] = 10.00 PLN "plan"
  opening[konto] = 0.00 PLN at 2026-01-01 start "own"

version b
  cite s
  governs 2026-03
  known 2026-03-10
  bank[o1] = (on: 2026-03-01, kind: pays, leg cash from work to konto amount 11.00 PLN, fulfils: pay[2026-03]) "b1"
  card[o1] = (on: 2026-03-01, kind: pays, leg cash from work to konto amount 11.00 PLN, fulfils: pay[2026-02]) "c1"

version sm
  cite s
  known 2026-03-11
  same bank[o1] = card[o1]
ask fp: flows(pay, 2026-03)
ask ob: observed(pay[2026-03])
ask c2: count(p in pays over 2026-02)
ask k1: count(p in pays over 2026-03) as known 2026-03-10
ask k2: count(p in pays over 2026-03) as known 2026-03-11
ask k3: tot[2026-02] as known 2026-03-10
ask hd: count(p in pays on dh)
ask hs: sum(p.cash.amount for p in pays on dh)
ask ob1: count(x in bank over 2026-03)
ask ob2: count(x in card over 2026-01..2026-06)
ask ob3: count(x in bank over 2026-04)
=== expect
b3: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  unfulfilled: pay[2026-01]
  unfulfilled: pay[2026-02]
  unfulfilled: pay[2026-03]
  cut 2026-06-30
c2: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-06-30
c3: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-06-30
fp: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-06-30
hd: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-06-30
hs: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-06-30
k1: 2
  cut 2026-03-10
k2: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-03-11
k3: 0.00 PLN
  cut 2026-03-10
ob: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-06-30
ob1: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-06-30
ob2: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-06-30
ob3: 0
  cut 2026-06-30
t2: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-06-30
t3: refused: RUN-RECORD bank[o1] and card[o1] are stated same and fulfil pay[2026-03] and pay[2026-02]
  cut 2026-06-30
