# tally 2.2.1 (#237, 237.1), L §8.2's pad: row: "a balance, a flows or a binding that counts a pad movement": sp
# and a10 sum the pads of 04-10 start (200.00) and end (150.00), so both are listed, and each pad's own amount lists
# itself (each). 350.00 PLN stands (plan §5 under #237). tally 2.2 listed the pads a pad rests on, not the pad
# counted (the planner's 237/cp.tally).
=== cp.tally
model chain_pads
  tally 2
  on 2026-05-31
  start 2026-03-01
  end 2026-05-31
  note "T, M3 C7, #192 row 40 (G4 fix NB-3, chain_pads at a continued walk's start): two decisions reading pads up to their own day, the second's walk continuing the first's, pads in March and April"

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input d_save: int

move save[m in months]: transfers
  on day_of(m, d_save)
  reads pads
  leg cash from konto to sav amount max(0 PLN, sum(p.cash.amount for p in pads over start_of(m) .. day_of(m, d_save)))


version v
  cite s
  governs always
  known 2026-01-01
  d_save = 15 "s"
  opening[konto] = 1000.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"

version rd
  cite s
  governs 2026-03
  known 2026-04-04
  pad konto from world
  stated[konto] = 1100.00 PLN at 2026-03-15 start "saldo"
  stated[konto] = 1500.00 PLN at 2026-03-15 end "saldo"

version rd4
  cite s
  governs 2026-04
  known 2026-05-04
  pad konto from world
  stated[konto] = 1300.00 PLN at 2026-04-10 start "saldo"
  stated[konto] = 1450.00 PLN at 2026-04-10 end "saldo"
  stated[konto] = 1600.00 PLN at 2026-04-20 end "saldo"

ask sp: sum(p.cash.amount for p in pads over 2026-04-01 .. 2026-04-15)
ask a10: sum(p.cash.amount for p in pads over 2026-04-10 .. 2026-04-10)
ask each: p.cash.amount for p in pads over 2026-03-01 .. 2026-05-31
ask fr: p.cash.from for p in pads over 2026-04-01 .. 2026-04-15
ask fl: flows(konto, 2026-04-01 .. 2026-04-15)
=== expect sp a10 each
sp: 350.00 PLN
  pad: konto 2026-03-15 end, pads:rd:konto@2026-03-15 end of 500.00 PLN
  pad: konto 2026-04-10 end, pads:rd4:konto@2026-04-10 end of 150.00 PLN
  pad: konto 2026-04-10 start, pads:rd4:konto@2026-04-10 start of -200.00 PLN
  cut 2026-05-31
a10: 350.00 PLN
  pad: konto 2026-03-15 end, pads:rd:konto@2026-03-15 end of 500.00 PLN
  pad: konto 2026-04-10 end, pads:rd4:konto@2026-04-10 end of 150.00 PLN
  pad: konto 2026-04-10 start, pads:rd4:konto@2026-04-10 start of -200.00 PLN
  cut 2026-05-31
each (p = pads:rd:konto@2026-03-15 end): 500.00 PLN
  pad: konto 2026-03-15 end, pads:rd:konto@2026-03-15 end of 500.00 PLN
  pad: konto 2026-03-15 start, pads:rd:konto@2026-03-15 start of 100.00 PLN
  unfulfilled: save[2026-03]
  cut 2026-05-31
each (p = pads:rd:konto@2026-03-15 start): 100.00 PLN
  pad: konto 2026-03-15 start, pads:rd:konto@2026-03-15 start of 100.00 PLN
  cut 2026-05-31
each (p = pads:rd4:konto@2026-04-10 end): 150.00 PLN
  pad: konto 2026-04-10 end, pads:rd4:konto@2026-04-10 end of 150.00 PLN
  pad: konto 2026-04-10 start, pads:rd4:konto@2026-04-10 start of -200.00 PLN
  cut 2026-05-31
each (p = pads:rd4:konto@2026-04-10 start): 200.00 PLN
  pad: konto 2026-03-15 end, pads:rd:konto@2026-03-15 end of 500.00 PLN
  pad: konto 2026-04-10 start, pads:rd4:konto@2026-04-10 start of -200.00 PLN
  cut 2026-05-31
each (p = pads:rd4:konto@2026-04-20 end): 500.00 PLN
  pad: konto 2026-03-15 end, pads:rd:konto@2026-03-15 end of 500.00 PLN
  pad: konto 2026-04-10 end, pads:rd4:konto@2026-04-10 end of 150.00 PLN
  pad: konto 2026-04-10 start, pads:rd4:konto@2026-04-10 start of -200.00 PLN
  pad: konto 2026-04-20 end, pads:rd4:konto@2026-04-20 end of 500.00 PLN
  unfulfilled: save[2026-04]
  cut 2026-05-31
