# L §6.1 (round 14): "Two places of which neither is outside must also be of one unit and name one price input, if any
# (LOAD-SAME)"; L §8.3 LOAD-SAME "places of two units or two price inputs". a.wsp holds PLN, b.wsp EUR: LOAD-SAME.
# (Writer 6's U-17, was REFCORE-UNSPECIFIED §6.1.)
=== options pin=bytes
=== joint.tally
model family
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31
  use a = "ana.tally" sha256 "e438b0e9e801813f005290db20ae57dbafcfc06810324f3ba998080e5c2db6c3"
  use b = "ben.tally" sha256 "598f710ad3fe2f72da484592193b1efb0d450d811b1d51d0bcc7de7cd13ee6c6"
  same a.wsp = b.wsp
ask w: bal(a.wsp, 2026-06-01)
=== ana.tally
model ana
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
kind persons
place wsp: accounts PLN lives 2019-01-01..
input income[p in persons]: money PLN

version v
  cite s
  governs always
  known 2025-12-01
  persons + [ana, ola] lives 2000-01-01..
  income[ana] = 100.00 PLN "umowa"
  income[ola] = 10.00 PLN "umowa"
  opening[wsp] = 1 000.00 PLN at 2026-01-01 start "wyciąg"
=== ben.tally
model ben
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind persons
place wsp: accounts EUR lives 2019-01-01..
input pocket[p in persons]: money PLN

version v
  cite s
  governs always
  known 2025-12-01
  persons + [ben, ola_k] lives 2000-01-01..
  pocket[ben] = 50.00 PLN "umowa"
  pocket[ola_k] = 5.00 PLN "umowa"
  opening[wsp] = 1 000.00 EUR at 2026-01-01 start "wyciąg"
=== expect
refused: LOAD-SAME same a.wsp = b.wsp: places of two units ...
