# tally 2.1.8 §4 (#187), L §6.1 l.1806: facts about rows stated same are read together, a price's included: rent
# and rent_b, both 2 000.00 PLN in 2026 prices, read 2 100.00 PLN at a 2027 law date; fee (100.00) and fee_b (120.00)
# disagree, and HOLE-SAME names each priced value (105 and 126 in 2027). 2.1.7's refcore read a same row unpriced
# (rent 2 000 PLN in 2027). Neither rent_b nor fee is read by name, and neither warns WARN-UNREAD: a read of one side
# reads the other (2.1.7 warned).
=== m.tally
model t
  tally 2
  on 2026-10-18
  start 2026-01-01
  end 2028-12-31

source s "synthetic"
unit PLN: currency minor 0.01

index ty = year 2026..2028

input inflation: num
input rent: money PLN prices 2026 by cpi
input rent_b: money PLN prices 2026 by cpi
input fee: money PLN prices 2026 by cpi
input fee_b: money PLN prices 2026 by cpi

def cpi[y in ty]: num at start_of(y)
  rule initial = 1 when pos(y) == 1
  rule next = cpi[y - 1] * (1 + inflation) when pos(y) > 1

version v
  cite s
  governs always
  known 2026-01-01
  inflation = 5 %
  rent = 2 000.00 PLN
  rent_b = 2 000.00 PLN
  fee = 100.00 PLN
  fee_b = 120.00 PLN
  same rent = rent_b
  same fee = fee_b

ask r6: rent law 2026-06-30
ask r7: rent law 2027-06-30
ask f7: fee_b law 2027-06-30
=== expect
f7: ?"fee and fee_b are one, but the value differs on 2027-06-30: 105 PLN (v:fee) and 126 PLN (v:fee_b)" (fee, fee_b)
  law date 2027-06-30, cut 2026-10-18
r6: 2 000 PLN
  law date 2026-06-30, cut 2026-10-18
r7: 2 100 PLN
  law date 2027-06-30, cut 2026-10-18
