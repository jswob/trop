# L §6.5 change 4 (a child is born), copied whole (round 5 text) except its opening reading (writer 3's), over the
# base excerpt.  `replace parent = false` restates the base's closed-world row for the persons known on
# 2029-05-14, ola included (L §4.6 step 1, §6.2), from 2029-05; parent[ola, ana] and parent[ola, ben] state more
# keys and win by precedence (L §4.6 step 3.2; L §5.3 "rows at different stated keys are ordered by precedence").
# So parent[ana, ola] = false, parent[ola, ana] = true, parent[ana, ben] = false; residence[ola, 2029-06] = pl.
# held (L §8.2): every row read is open-ended; the law date 2029-06-01 is not after the cut 2029-12-31: none.
=== household.tally
model household
  tally 2
  on 2029-12-31
  start 2026-01-01
  end 2040-12-31

source household "the household's own records"
unit PLN: currency minor 0.01
index instalments = [equal, decreasing]
index overpay_choices = [shorter, lower]
index pit_brackets = [low, high]
index countries = [pl, de]

kind persons
kind jobs
kind loans

input loan_terms[l in loans]: (principal money PLN, months int, plan key instalments)
input overpay[l in loans, m in months]: (amount money PLN, choice key overpay_choices)
input parent[c in persons, k in persons]: bool
input pay_dom[j in jobs]: int
input pit_free: money PLN
input pit_rate[b in pit_brackets]: num
input residence[p in persons, m in months]: key countries
input salary[j in jobs, m in months]: money PLN question "Ile wynosi pensja brutto z tej pracy w tym miesiącu?"
input works_for[j in jobs]: key persons

version home_2026
  cite household
  governs 2026-10..
  known 2026-10-19
  persons + [ana] lives 1990-04-02..
  persons + [ben] lives 1988-11-30..
  jobs + [ana_acme] lives 2020-02-01..
  jobs + [ben_bolt] lives 2021-09-01..
  parent = false "brak dzieci"
  pay_dom = 10 "umowy o pracę, § 5"
  residence = pl "meldunek w Krakowie"
  works_for[ana_acme] = ana
  works_for[ben_bolt] = ben
=== change4.tally
part change4
  tally 2

source birth_ola "Akt urodzenia Oli, USC Kraków"

version ola_born
  cite birth_ola
  governs 2029-05..
  known 2029-05-14
  persons + [ola] lives 2029-05-12..
  replace parent = false "brak innych relacji rodzicielskich"
  parent[ola, ana] = true
  parent[ola, ben] = true
  residence[ola] = pl "rezydencja od urodzenia"

ask q1: parent[ana, ola], parent[ola, ana], parent[ana, ben], residence[ola, 2029-06] law 2029-06-01
=== expect
q1: (false, true, false, pl)
  law date 2029-06-01, cut 2029-12-31
