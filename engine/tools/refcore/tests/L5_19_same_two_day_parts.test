# tally 2.3.1 rulings 17 B (G1's review, f10): a `same` group's first-day hole part at a place that keeps parts
# ends at the last side's day, as its balance's hole does (the parts walk's `unsame`). Before: p8 stopped,
# REFCORE-NOT-YET (a hole part's amount formatted as a number).
=== f10_two_day_parts.tally
model f10
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-12-31

source s "probe"
unit PLN: currency minor 0.01
kind persons: parties
kind savings: place PLN min 0
  owned by arrive
  step minor(PLN)
  takes k for w order (if k.owner == ania then 0 else 1)
place acc: savings lives 2026-01-01..
place world: outside lives 1900-01-01..
input d1: date
input d2: date
input a: money PLN

def arrive[m in events, p in parties]: num at m.day
  rule base = (if p == ania then 1 else 0)

move x1: transfers
  on d1
  leg cash from world to acc amount a
move x2: transfers
  on d2
  leg cash from world to acc amount a

ask b4: bal(acc, 2026-03-04)
ask b6: bal(acc, 2026-03-06)
ask b8: bal(acc, 2026-03-08)
ask p6: bal(acc, 2026-03-06) of p for p in parties on 2026-03-06
ask p8: bal(acc, 2026-03-08) of p for p in parties on 2026-03-08
ask e8: explain bal(acc, 2026-03-08)
ask k8: bal(acc, 2026-03-08) as known 2026-03-01

version cast
  cite s
  known 2026-01-01
  persons + [ania] lives 1988-04-12..
  persons + [tomek] lives 1986-09-03..

version v
  cite s
  governs always
  known 2025-12-01
  opening[acc] = 0.00 PLN at 2026-01-01 start "s"
  d1 = 2026-03-05 "s"
  d2 = 2026-03-07 "s"
  a = 100.00 PLN "s"

version later
  cite s
  governs always
  known 2026-03-02
  same x1 = x2
=== expect b6 b8 p6 p8
b6: ?"x1 and x2 are one, but leg cash differs on 2026-03-05, 2026-03-07: 100.00 PLN (x1) and 100.00 PLN (x2)" (x1, x2)
  unfulfilled: x1
  cut 2026-06-10
b8: 100.00 PLN
  unfulfilled: x1
  unfulfilled: x2
  cut 2026-06-10
p6 (p = ania): ?"x1 and x2 are one, but leg cash differs on 2026-03-05, 2026-03-07: 100.00 PLN (x1) and 100.00 PLN (x2)" (x1, x2)
  unfulfilled: x1
  cut 2026-06-10
p6 (p = tomek): ?"x1 and x2 are one, but leg cash differs on 2026-03-05, 2026-03-07: 100.00 PLN (x1) and 100.00 PLN (x2)" (x1, x2)
  unfulfilled: x1
  cut 2026-06-10
p8 (p = ania): ?"acc: 100.00 PLN may be ania's: x1 and x2 are one, but leg cash differs on 2026-03-05: 2026-03-05 (x1) and 2026-03-07 (x2)" (acc)
  unfulfilled: x1
  unfulfilled: x2
  cut 2026-06-10
p8 (p = tomek): ?"acc: 100.00 PLN may be tomek's: x1 and x2 are one, but leg cash differs on 2026-03-05: 2026-03-05 (x1) and 2026-03-07 (x2)" (acc)
  unfulfilled: x1
  unfulfilled: x2
  cut 2026-06-10
