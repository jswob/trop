# tally 2.3.1 rulings 17 A: beside a domain hole, a refused term or `where` (x[3] / x[n]) is one member's, and
# a true member decides: tr, wr true. Before: the hole.
=== f04_domhole_min.tally
model f04
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31
source s "probe"
place konto: accounts PLN lives 2026-01-01..
unit PLN: currency minor 0.01
index ns = 1..3
input x[n in ns]: int
input dh[n in ns]: date
ask wr: any(x[n] > 0 for n in ns where x[3] / x[n] > 0, p in accounts on dh[n])
ask tr: any(x[3] / x[n] > 0 for n in ns, p in accounts on dh[n])
version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  x[1] = 0 "s"
  x[2] = 5 "s"
  x[3] = 5 "s"
  dh[1] = 2026-02-01 "s"
  dh[2] = 2026-02-01 "s"
  dh[3] = ?"dh3?" "s"
=== expect
tr: true
  cut 2026-06-30
wr: true
  cut 2026-06-30
