# tally 2.3.1 R6 (E §5 step 1, one instance, one answer): spend[2026-02], false at its booking and made to exist
# by v2 (known 2026-03-01), exists as known now: x2 false, its leg read at A0 = 0, and its day 2026-02-25;
# as known 2026-02-28 it doesn't (kd RUN-NONE). Before: d2 RUN-NONE beside x2 false.
=== i3_later.tally
model i3_later
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-05-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-05
place konto: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input okw[m in month]: bool
input amt: money PLN
input d25: int
input fm: month

move spend[m in month]: transfers
  on day_of(m, d25)
  when okw[m]
  leg cash from konto to shop amount amt

ask d2: spend[fm].day
ask a2: spend[fm].cash.amount
ask x2: spend[fm] == none
ask f2: flows(spend, fm)
ask b: bal(konto, 2026-03-31)
ask kd: spend[fm].day as known 2026-02-28
ask ka: spend[fm].cash.amount as known 2026-02-28
ask kf: flows(spend, fm) as known 2026-02-28

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "s"
  amt = 10.00 PLN "s"
  d25 = 25 "s"
  fm = 2026-02 "s"
  okw[2026-01] = true "s"
  okw[2026-02] = false "s"
  okw[2026-03] = true "s"
  okw[2026-04] = true "s"
  okw[2026-05] = true "s"

version v2
  cite s
  governs always
  known 2026-03-01
  replace okw[2026-02] = true "late: feb did happen"
=== expect d2 a2 x2 kd
d2: 2026-02-25
  cut 2026-04-20
a2: 0.00 PLN
  cut 2026-04-20
x2: false
  cut 2026-04-20
kd: refused: RUN-NONE spend[2026-02] doesn't exist: a field read of it
  cut 2026-02-28
