# tally 2.2.1 (S-224a, #224), L §8.3 LOAD-VERSION: "tally <N>: this engine runs tally 2", where the files agree on
# a version other than 2 (O §5, VER-1: "another tally version is refused at load"). tally 2.2 ran a reality stating
# tally 3 and answered (the planner's misc/v3.tally).
=== v3.tally
model p
  tally 3
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31
source card "probe"
unit DUK: currency minor 0.01
place konto: accounts DUK lives 2026-01-01..
place world: outside lives 2026-01-01..
input floor: money DUK
input a1: money DUK
input a2: money DUK
input a3: money DUK
input a4: money DUK
input a5: money DUK
input a6: money DUK
input d_jan: date
input d_t: date
input d_late: date
input d_10: date
input d_12: date
input d_15: date
input d_to: date
input d_20: date
input d_25: date
input d_6: date
move ab1: transfers
  on d_t
  leg cash from world to konto amount a3
move late: transfers
  on d_late
  reads konto
  leg cash from world to konto amount max(0 DUK, floor - bal(konto, d_to) from d_t)
ask a: bal(konto, 2026-03-31), bal(konto, 2026-03-05)
ask b: bal(konto, 2026-03-31) from 2026-02-01, bal(konto, 2026-03-31) from 2026-03-01, bal(konto, 2026-03-31) from 2026-03-02
version v
  cite card
  governs always
  known 2026-01-01
  floor = 5000.00 DUK "c"
  a1 = 100.00 DUK "c"
  a2 = 10.00 DUK "c"
  a3 = 1000.00 DUK "c"
  a4 = 20.00 DUK "c"
  a5 = 3.00 DUK "c"
  a6 = 7.00 DUK "c"
  d_jan = 2026-01-15 "c"
  d_t = 2026-03-01 "c"
  d_late = 2026-03-05 "c"
  d_10 = 2026-03-10 "c"
  d_12 = 2026-03-12 "c"
  d_15 = 2026-03-15 "c"
  d_to = 2026-03-31 "c"
  d_20 = 2026-03-20 "c"
  d_25 = 2026-03-25 "c"
  d_6 = 2026-03-06 "c"
  opening[konto] = 0.00 DUK at 2026-01-01 start "c"
=== expect
refused: LOAD-VERSION tally 3: this engine runs tally 2
