# E §5 step 4: "Take the versions ... in known order; those with one known are one step"; "a step of several versions
# makes one adjustment, which each of them that passed step 2 names, printed under the first in ASCII order".
# E6_3_residuals_adjustment.test's model, net = wage_amt + bonus, with raise_2026 (+500.00) and bonus_2026 (+100.00)
# both known 2026-05-01 and governing March: one adjustment of wage[2026-03].cash, δ = +600.00 PLN, printed
# adjustments[wage[2026-03].cash, bonus_2026]; bank[r1] names it by raise_2026 and settles it in full (led: matched,
# difference 0.00); konto holds the five wages of January to May and the 600.00 PLN: 25 600.00 PLN, nothing remaining
# (b). (Was REFCORE-UNSPECIFIED §5.14.3.)
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source act "act"
source bank_export "bank"
unit PLN: currency minor 0.01
kind wages: event certain
  leg cash: PLN
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
input wage_amt: money PLN
input bonus: money PLN
input wage_dom: int
input bank: observed
def net[m in months]: money PLN = wage_amt + bonus at start_of(m)

move wage[m in months]: wages
  on day_of(m, wage_dom)
  at start_of(m)
  leg cash from world to konto amount net[m]

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  wage_amt = 5 000.00 PLN "umowa"
  bonus = 0 PLN "umowa"
  wage_dom = 10 "umowa"
  opening[konto] = 0 PLN at 2026-01-01 start "wyciąg"

version raise_2026
  cite act
  governs 2026-03
  known 2026-05-01
  replace wage_amt = 5 500.00 PLN "aneks"

version bonus_2026
  cite act
  governs 2026-03
  known 2026-05-01
  replace bonus = 100.00 PLN "aneks"

version back_pay
  cite bank_export
  governs 2026-05
  known 2026-05-20
  covers konto 2026-05-15..2026-05-15
  bank[r1] = (on: 2026-05-15, kind: wages, leg cash from world to konto amount 600.00 PLN, fulfils: adjustments[wage[2026-03].cash, raise_2026]) "line 1"

ask led: residuals konto 2026-05
ask b: bal(konto, 2026-05-31)
=== expect
b: 25 600.00 PLN
  unfulfilled: wage[2026-01]
  unfulfilled: wage[2026-02]
  unfulfilled: wage[2026-03]
  unfulfilled: wage[2026-04]
  unfulfilled: wage[2026-05]
  cut 2026-10-20
led: residuals konto 2026-05
  2026-05 move wage: model 600.00 PLN, observed 600.00 PLN, difference 0.00 PLN
    matched adjustments[wage[2026-03].cash, bonus_2026] on 2026-05-01: model 600.00 PLN, observed 600.00 PLN, difference 0.00 PLN, timing +14 days
  cut 2026-10-20
