  law date 2026-06-30, cut 2026-12-31
a2: 3 (standard error 0; 5 paths; horizon 2026-06-30; maritz-jarrett N 5, m 3, weights [0.05792, 0.25952, 0.36512, 0.25952, 0.05792] (binomial tail = Beta polynomial), sum 1)
  law date 2026-06-30, cut 2026-12-31
a3: 5 (standard error 0.700776; 5 paths; horizon 2026-06-30; maritz-jarrett N 5, m 3, weights [0.05792, 0.25952, 0.36512, 0.25952, 0.05792] (binomial tail = Beta polynomial), sum 1)
  law date 2026-06-30, cut 2026-12-31
a4: 5 (standard error 0.976381; 6 paths; horizon 2026-06-30; maritz-jarrett N 6, m 6, weights [1/46656 (0.0000214334705075446), 7/5184 (0.00135030864197531), 665/46656 (0.0142532578875171), 3367/46656 (0.0721664951989026), 427/1728 (0.247106481481481), 31031/46656 (0.665102023319616)] (binomial tail = Beta polynomial), sum 1)
  law date 2026-06-30, cut 2026-12-31
a5: 2 (standard error 1.418013; 5 of 8 paths; horizon 2026-06-30; maritz-jarrett N 5, m 2, weights [0.26272, 0.40032, 0.24992, 0.08032, 0.00672] (binomial tail = Beta polynomial), sum 1)
  law date 2026-06-30, cut 2026-12-31
