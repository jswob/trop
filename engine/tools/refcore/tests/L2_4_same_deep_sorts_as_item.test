# L §2.4 Version items (tally 2.1.7 R9, issue #148; #96, 2.1.6 P33): a same item sorts as an item whose target
# and keys are its left side's: `same a.b.c` by the target a.b.c, before amt. 2.1.6's refcore sorted a side deeper
# than a.x by its parse node's form, after rate. (T's M0 format vector same_deep_beside_rows.)
=== options reprint
=== same_deep_beside_rows.tally
model same_deep_beside_rows
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31

source s "s"

index qs = [q1, q2]

input amt: num

input day: date

input rate[k in qs]: num

version v
  cite s
  governs always
  known 2026-01-01
  rate[q1] = 0.1
  day = 2026-02-10
  amt = 1
  same b.x = rate[q1]
  same a.b.c = rate[q1]
