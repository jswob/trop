model t
  tally 2
  on 2016-03-01
  start 2015-11-01
  end 2016-10-31

source s "s"
band b(n: int): int
input four: int
input five: int

version v
  cite s
  governs 2015-11..
  known 2015-09-07
  b: [0, 4] = 1
  b: [5, 18) = 2
