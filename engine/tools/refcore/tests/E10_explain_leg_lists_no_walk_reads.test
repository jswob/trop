# tally 2.1.8 P50, E §10 (group 4's fix review, agent/s6_reads_agree s4): an explain lists what the value read:
# bank[a1].cash.amount reads its row alone. Checking whether the walk refused the leg builds the walk, which reads
# pay's d_p and amt; with amt changed the value is the same, so neither is listed. 82d68fc7 listed both.
=== m.tally
model t
  tally 2
  on 2026-04-10
  start 2026-03-01
  end 2026-04-30

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place card: accounts PLN lives 2026-01-01..
input bank: observed
input amt: money PLN
input d_p: int

move pay[m in months]: transfers
  on day_of(m, d_p)
  leg cash from konto to sav amount amt

version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  d_p = 10 "s"
  opening[konto] = 1000.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"
  opening[card] = 0.00 PLN at 2026-03-01 start "s"

version st_sav
  cite s
  governs 2026-03
  known 2026-04-03
  covers sav
  bank[c1] = (on: 2026-03-10, kind: transfers, leg cash from konto to sav amount 100.00 PLN) "c"

version st_konto
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  bank[b1] = (on: 2026-03-10, kind: transfers, leg cash from konto to sav amount 100.00 PLN, fulfils: pay[2026-03]) "a"

version st_card
  cite s
  governs 2026-03
  known 2026-04-03
  covers card
  bank[a1] = (on: 2026-03-10, kind: transfers, leg cash from konto to sav amount 100.00 PLN) "b"
  same bank[c1] = bank[b1]
  same bank[a1] = bank[c1]







ask s1: sum(o.cash.amount for o in bank over 2026-03)
ask s2: x.cash.amount for x in transfers over 2026-03
ask s3: count(o in bank over 2026-03)
ask s4: explain bank[a1].cash.amount
ask s5: bank[a1].cash.amount
=== expect
s1: 300.00 PLN
  cut 2026-04-10
s2 (x = bank[a1]): 100.00 PLN
  cut 2026-04-10
s3: 3
  cut 2026-04-10
s4: 100.00 PLN
  [1] row st_card:bank[a1] = (from: konto, to: sav, amount: 100.00 PLN, day: 2026-03-10)
      version st_card, source s, "s", locator "b", on 2026-03-10, known 2026-04-03
  cut 2026-04-10
s5: 100.00 PLN
  cut 2026-04-10
warning: WARN-UNREAD place card is read by nothing
