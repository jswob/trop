=== ana.tally
model ana
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
kind persons
place wsp: accounts PLN lives 2019-01-01..
input income[p in persons]: money PLN
kind homes: place PLN min 0
input val: money PLN
place flat: homes priced val lives 2020-01-01..

version v
  cite s
  governs always
  known 2025-12-01
  persons + [ana, ola] lives 2000-01-01..
  income[ana] = 100.00 PLN "umowa"
  income[ola] = 10.00 PLN "umowa"
  opening[wsp] = 1 000.00 PLN at 2026-01-01 start "wyciąg"
  val = 100.00 PLN "wycena"
  opening[flat] = 1 PLN at 2026-01-01 start "akt"
