# Round 18, C3-4 (follows). L §5.16: "A cdf below its support's lower end (or at it, for a continuous distribution) is
# exactly 0"; at a discrete one's lower end it is the pmf there (the table): binomial(10, 0.5) pmf(0) = 0.5^10 = 1/1024 =
# 0.0009765625; negbin(2, 2), p = size/(size + mean) = 0.5, pmf(0) = C(1, 0)·0.5²·0.5⁰ = 0.25; discrete(1, 1) over
# [ka, kb] at ka = 1/2; uniform(0, 10), continuous, at its lower end 0.
=== m.tally
model t
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source s "s"
index ks = [ka, kb]
input w[k in ks]: num
input n10: int
input p: num
input mb: num
input sz: int
input z: int

version v
  cite s
  governs always
  known 2026-01-01
  w[*] = 1
  n10 = 10
  p = 0.5
  mb = 2
  sz = 2
  z = 0

ask q1: cdf(binomial(n10, p), z), cdf(negbin(mb, sz), z), cdf(discrete(w[k] for k in ks), ka), cdf(uniform(z, n10), z)
=== expect
q1: (0.0009765625, 0.25, 0.5, 0)
  cut 2026-12-31
