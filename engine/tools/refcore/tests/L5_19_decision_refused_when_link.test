# tally 2.3.1 rulings 16 Q1 (a decision's form; G2's review finding 5): topup[2026-02]'s `when` is refused, so
# its run is, and bank[r1]'s link with it: ob (observed), ful (`o.fulfils == topup[fm]`) and loose refused.
# Before: ob 400.00 PLN, ful 1, loose 30.00 PLN.
# tally 2.3.1 rulings 22 (part 1, a link names): the row stands in for the tuple it names by the name alone; no link is refused, judged at a point or re-walked, and only a field read through o.fulfils reaches step 7's mark. Re-stored.
=== dl_whenref.tally
model dl
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-05-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-05
place konto: accounts PLN lives 2026-01-01..
place save: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input bank: observed
input lim: money PLN
input zz: int
input amt: money PLN
input d5: int
input fm: month
input de: date

move topup[m in month]: transfers
  reads konto
  on day_of(m, d5)
  when bal(konto) < lim / zz
  leg cash from save to konto amount amt

def fl: money PLN = flows(topup, fm)
def bl: money PLN = bal(konto, de)
ask f: fl
ask ef: explain fl
ask iof: inputs-of fl
ask b: bl
ask eb: explain bl
ask ob: observed(topup[fm]).cash.amount
ask dy: topup[fm].day
ask ful: count(o in bank over fm where o.fulfils == topup[fm])
ask loose: sum(o.cash.amount for o in bank over fm where o.fulfils == none)

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"
  opening[save] = 5 000.00 PLN at 2026-01-01 start "s"
  lim = 600.00 PLN "s"

  amt = 400.00 PLN "s"
  d5 = 5 "s"
  zz = 0 "s"
  fm = 2026-02 "s"
  de = 2026-03-31 "s"

version feb
  cite s
  governs 2026-02
  known 2026-03-01
  covers konto
  bank[r1] = (on: 2026-02-05, kind: transfers, leg cash from save to konto amount 400.00 PLN, fulfils: topup[2026-02]) "the top-up"
  bank[r2] = (on: 2026-02-10, kind: transfers, leg cash from konto to shop amount 30.00 PLN) "loose"
=== expect
b: refused: RUN-DIV division by zero
  cut 2026-04-20
dy: refused: RUN-DIV division by zero
  cut 2026-04-20
eb: refused: RUN-DIV division by zero
  [1] bl = refused: RUN-DIV division by zero
      rule base: won
        [2] row v:de = 2026-03-31
            version v, source s, "probe", locator "s", governs always, known 2026-01-01
        [3] bal(konto, 2026-03-31) = refused: RUN-DIV division by zero
  cut 2026-04-20
ef: refused: RUN-DIV division by zero
  [1] fl = refused: RUN-DIV division by zero
      rule base: won
        [2] row v:fm = 2026-02
            version v, source s, "probe", locator "s", governs always, known 2026-01-01
        [3] row v:d5 = 5
            version v, source s, "probe", locator "s", governs always, known 2026-01-01
        [4] running read bal(konto) = 100.00 PLN, the balance up to this point of 2026-01-05
        [5] row v:lim = 600.00 PLN
            version v, source s, "probe", locator "s", governs always, known 2026-01-01
        [6] row v:zz = 0
            version v, source s, "probe", locator "s", governs always, known 2026-01-01
  cut 2026-04-20
f: refused: RUN-DIV division by zero
  cut 2026-04-20
ful: 1
  cut 2026-04-20
iof:
  v:d5 (source s "probe", locator "s")
  v:fm (source s "probe", locator "s")
  v:opening[konto] (source s "probe", locator "s")
  cut 2026-04-20
loose: 30.00 PLN
  cut 2026-04-20
ob: 400.00 PLN
  cut 2026-04-20
