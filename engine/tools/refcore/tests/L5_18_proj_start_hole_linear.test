# tally 2.1.8 R15, L §5.18 (B9 of group 3's review, r15_b3): a projection is its start balance plus the legs it
# counts, so a start balance that holds a hole keeps the linear form under partial: b7 9 999.00 PLN + -1 x Feb's
# hole, as the plain b5; b3 and b6 add March's. 3b9f51f1 printed them plain.
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source bk "bank"
unit PLN: currency minor 0.01
input g_amt: money PLN
input dom: int
input divisor[m in months]: num
input hamt[m in months]: money PLN
place konto: accounts PLN lives 2019-05-01..
place k2: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
kind maybes: transfers uncertain
input uamt: money PLN
move gift: maybes
  on dgift
  at dgift
  leg cash from world to k2 amount uamt
input dgift: date

move groc[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from konto to world amount round(g_amt * divisor[m] / divisor[m], minor(PLN), half-even)

move hm[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from k2 to world amount hamt[m]

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  g_amt = 500.00 PLN "plan"
  dom = 5 "plan"
  divisor[2026-01] = 1 "ok"
  divisor[2026-02] = 0 "zero"
  divisor[2026-03..2026-12] = 1 "ok"
  hamt[2026-01] = 1.00 PLN "ok"
  hamt[2026-02] = ?"how much in Feb" "hole"
  hamt[2026-03] = ?"how much in Mar" "hole"
  hamt[2026-04..2026-12] = 1.00 PLN "ok"
  opening[konto] = 10 000.00 PLN at 2026-01-01 start "w"
  opening[k2] = 10 000.00 PLN at 2026-01-01 start "w"

version st
  cite bk
  governs 2026-03
  known 2026-04-02
  anchor konto
  anchor k2
  stated[konto] = 200.00 PLN at 2026-03-10 end "saldo"
  stated[k2] = 200.00 PLN at 2026-03-10 end "saldo"

index ks = [a, b]
input z[k in ks]: money PLN
input two: num
version zz
  cite plan
  governs always
  known 2026-01-01
  z[a] = 10.00 PLN "s"
  two = 2 "s"
  uamt = ?"gift size" "hole"
  dgift = 2026-03-20 "s"
  z[b] = ?"z of b" "s"

ask b3: bal(k2, 2026-03-31) from 2026-03-05 partial
ask b4: bal(k2, 2026-03-31) from 2026-03-05
ask b5: bal(k2, 2026-03-04) partial
ask b6: bal(k2, 2026-03-31) from 2026-03-06 partial
ask b7: bal(k2, 2026-03-04) from 2026-03-04 partial
ask b8: explain bal(k2, 2026-03-31) from 2026-03-05
=== expect
b3: 9 999.00 PLN + -1 × ?"how much in Feb" (hamt[2026-02]) + -1 × ?"how much in Mar" (hamt[2026-03])
  unfulfilled: hm[2026-01]
  unfulfilled: hm[2026-02]
  cut 2026-10-20
b4: ?"how much in Feb" (hamt[2026-02]) ?"how much in Mar" (hamt[2026-03])
  unfulfilled: hm[2026-01]
  unfulfilled: hm[2026-02]
  cut 2026-10-20
b5: 9 999.00 PLN + -1 × ?"how much in Feb" (hamt[2026-02])
  unfulfilled: hm[2026-01]
  unfulfilled: hm[2026-02]
  cut 2026-10-20
b6: 9 999.00 PLN + -1 × ?"how much in Feb" (hamt[2026-02]) + -1 × ?"how much in Mar" (hamt[2026-03])
  unfulfilled: hm[2026-01]
  unfulfilled: hm[2026-02]
  unfulfilled: hm[2026-03]
  cut 2026-10-20
b7: 9 999.00 PLN + -1 × ?"how much in Feb" (hamt[2026-02])
  unfulfilled: hm[2026-01]
  unfulfilled: hm[2026-02]
  cut 2026-10-20
b8: ?"how much in Feb" (hamt[2026-02]) ?"how much in Mar" (hamt[2026-03])
  projection of k2 (PLN) from 2026-03-05 to the end of 2026-03-31
  holder: ask b8 (an ask line leaves out nothing, L §5.14.1)
  clauses: windows none, random none, without uncertain
  start: ?"how much in Feb" (hamt[2026-02]) at the start of 2026-03-05
  counted:
    2026-03-05:
      hm[2026-03].cash (plan): hole: ?"how much in Mar" (hamt[2026-03])
  left out: none
  unfulfilled: hm[2026-01]
  unfulfilled: hm[2026-02]
  cut 2026-10-20
warning: WARN-NEGATIVE konto is below zero from 2026-04-05
warning: WARN-UNREAD input two is read by nothing
warning: WARN-UNREAD input z is read by nothing
