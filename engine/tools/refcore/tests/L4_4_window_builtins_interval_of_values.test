# tally 2.2.1 (#221, the lead's pick P25 on the builder's STOP-REPORT), L §4.4 l.668: "Each operation gives the
# interval of its values over the days its own arguments can take": round (b_round, b_round_m), exp, ln and sqrt
# (b_exp, b_ln, b_sqrt) and overlap_days of two windows (b_ovl) give the interval of their values, a hole only where
# a comparison can't decide it; abs and an even pow of an interval across 0 hold 0 (b_abs_m1: abs of -4.50 .. 1.50 PLN
# is 0 .. 4.50 PLN, so > 1.50 PLN is undecided). is_business over a window whose days disagree is the hole by l.669
# (b_isb). tally 2.2.1's W4 held round and overlap_days of two windows by their own names, stopped on exp, ln, sqrt,
# and gave abs of an interval across 0 from its two ends alone.
=== bi.tally
model bi
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31
source s "s"
unit PLN: currency minor 0.01
input w: date
input d0: date
input dz: date
input k2: int
input k3: num
input k5: int
input k10: num
input p: money PLN
input c: money PLN
input st: money PLN
input cal: calendar
version v
  cite s
  governs always
  known 2026-01-01
  w = window(2026-03-03, 2026-03-07) "s"
  d0 = 2026-03-01 "s"
  dz = 2026-12-31 "s"
  k2 = 2 "s"
  k3 = 3 "s"
  k5 = 5 "s"
  k10 = 10 "s"
  p = 1.50 PLN "s"
  c = 2.00 PLN "s"
  st = 0.01 PLN "s"
  cal = calendar(weekends [sat, sun]) "s"
ask b_round: round(days_between(d0, w) / k3, 1, half-up) > 0
ask b_round_m: round((days_between(d0, w) - k5) * p / k3, st, half-even) > 0 PLN
ask b_abs: abs(days_between(d0, w) - k5) > 1
ask b_abs_m: abs((days_between(d0, w) - k5) * p) > c
ask b_abs_m1: abs((days_between(d0, w) - k5) * p) > p
ask b_pow: pow(days_between(d0, w) - k5, k2) > 1
ask b_exp: (exp(days_between(d0, w) / k10) to 0.001) > 1
ask b_ln: (ln(days_between(d0, w)) to 0.001) > 0
ask b_sqrt: (sqrt(days_between(d0, w)) to 0.001) > 1
ask b_dcf: dcf(w, dz, act365) > 0
ask b_ovl: overlap_days(w, add_days(w, 1), 2026-03) > 0
ask b_ovl2: overlap_days(w, d0, 2026-03) >= 0
ask b_age: age_months(d0, w) >= 0
ask b_year: year_of(w) == 2026
ask b_mon: month_of(w) == 2026-03
ask b_week: weekday(w) >= 1
ask b_isb: is_business(w, cal)
ask b_addb: add_business(w, 1, cal) > d0
ask b_min: min(days_between(d0, w) - k5, 0) <= 0
=== expect
b_abs: ?"date within window(2026-03-03, 2026-03-07) not precise enough for abs(days_between(d0, w) - k5) > 1" (w)
  unknown day: w
  cut 2026-01-01
b_abs_m: ?"date within window(2026-03-03, 2026-03-07) not precise enough for abs((days_between(d0, w) - k5) * p) > c" (w)
  unknown day: w
  cut 2026-01-01
b_abs_m1: ?"date within window(2026-03-03, 2026-03-07) not precise enough for abs((days_between(d0, w) - k5) * p) > p" (w)
  unknown day: w
  cut 2026-01-01
b_addb: true
  cut 2026-01-01
b_age: true
  cut 2026-01-01
b_dcf: true
  cut 2026-01-01
b_exp: true
  cut 2026-01-01
b_isb: ?"date within window(2026-03-03, 2026-03-07) not precise enough for is_business(w, cal)" (w)
  unknown day: w
  cut 2026-01-01
b_ln: true
  cut 2026-01-01
b_min: true
  cut 2026-01-01
b_mon: true
  cut 2026-01-01
b_ovl: ?"date within window(2026-03-03, 2026-03-07) not precise enough for overlap_days(w, add_days(w, 1), 2026-03) > 0" (w)
  unknown day: w
  cut 2026-01-01
b_ovl2: true
  cut 2026-01-01
b_pow: ?"date within window(2026-03-03, 2026-03-07) not precise enough for pow(days_between(d0, w) - k5, k2) > 1" (w)
  unknown day: w
  cut 2026-01-01
b_round: true
  cut 2026-01-01
b_round_m: ?"date within window(2026-03-03, 2026-03-07) not precise enough for round((days_between(d0, w) - k5) * p / k3, st, half-even) > 0 PLN" (w)
  unknown day: w
  cut 2026-01-01
b_sqrt: true
  cut 2026-01-01
b_week: true
  cut 2026-01-01
b_year: true
  cut 2026-01-01
