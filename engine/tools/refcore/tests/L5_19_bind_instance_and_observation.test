# L §5.19: "a bind over an event kind includes the observations of that kind, counting a planned instance and the
# observations that fulfil it once: by the observations where they are booked (Booking an observation, below), otherwise
# by the instance". bank[r1] fulfils rent; no version covers konto, so the observation isn't booked, and the binding
# counts the instance once: q = 1, n = 2 000.00 PLN. (Was REFCORE-UNSPECIFIED §5.19, a binding holding both.)
=== m.tally
model hh
  tally 2
  on 2026-04-01
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2019-01-01..
place landlord: outside lives 1900-01-01..
input rent_amt: money PLN
input rent_day: date
input bank: observed

move rent: transfers
  on rent_day
  leg cash from konto to landlord amount rent_amt

version v
  cite s
  governs always
  known 2025-12-01
  rent_amt = 2 000.00 PLN "umowa"
  rent_day = 2026-03-05 "umowa"
  opening[konto] = 5 000.00 PLN at 2026-01-01 start "wyciąg"

version stmt
  cite s
  governs 2026-03
  known 2026-03-10
  bank[r1] = (on: 2026-03-05, kind: transfers, leg cash from konto to landlord amount 2 000.00 PLN, fulfils: rent) "linia 1"

ask q: count(x in transfers over 2026-03)
ask n: sum(x.cash.amount for x in transfers over 2026-03)
=== expect
n: 2 000.00 PLN
  cut 2026-04-01
q: 1
  cut 2026-04-01
