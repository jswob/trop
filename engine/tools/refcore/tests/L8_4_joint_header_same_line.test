# tally 2.2.1, 221.8 (L §8.3): LOAD-SAME for a header's same line is at the line of the same (review g3
# hdr/h4). Before W12: line 1.
=== h4.tally
model h4
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31
  same one = one

  same fee[a2] = fee[a1]
