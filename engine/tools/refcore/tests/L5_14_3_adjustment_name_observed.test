# L §5.14.3 (round 12b): an adjustment's "name is adjustments[m[keys].leg, V], the adjusted leg and the version, so
# an observed row settles it with fulfils: adjustments[rent[2026-03].cash, v2]"; L §5.19 fulfils "settles an
# adjustment"; E §5 step 5: a settlement leg "counts +amount when it runs the adjusted leg's way", the remainder is δ
# less that sum. raise_2026 (known 2026-05-01) makes March's wage 5 500.00 PLN; wage[2026-03] was booked at 5 000.00 on
# 2026-03-10, so δ = +500.00 PLN (E §5 step 3). The bank row of 2026-05-15 (world -> konto, 500.00 PLN, booked: konto is
# covered that day, E §4.2 step 1) settles it: remainder 0, no HOLE-CHANGED (a: five wages of 5 000.00 plus 500.00).
# Under a cut before the row is known (b) the adjustment is unsettled: HOLE-CHANGED with its question and the
# `adjustment:` line (L §8.1, §8.2). An observation's `fulfils` reads the adjustment (e).
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source act "act"
source bank_export "bank"
unit PLN: currency minor 0.01
kind wages: event certain
  leg cash: PLN
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
input wage_amt: money PLN
input wage_dom: int
input bank: observed
def net[m in months]: money PLN = wage_amt at start_of(m)

move wage[m in months]: wages
  on day_of(m, wage_dom)
  at start_of(m)
  leg cash from world to konto amount net[m]

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  wage_amt = 5 000.00 PLN "umowa"
  wage_dom = 10 "umowa"
  opening[konto] = 0 PLN at 2026-01-01 start "wyciąg"

version raise_2026
  cite act
  governs 2026-03
  known 2026-05-01
  replace wage_amt = 5 500.00 PLN "aneks"

version back_pay
  cite bank_export
  governs 2026-05
  known 2026-05-20
  covers konto 2026-05-15..2026-05-15
  bank[r1] = (on: 2026-05-15, kind: wages, leg cash from world to konto amount 500.00 PLN, fulfils: adjustments[wage[2026-03].cash, raise_2026]) "line 1"

ask a: bal(konto, 2026-05-31)
ask b: bal(konto, 2026-05-31) as known 2026-05-10
ask c: count(x in adjustments over 2026), sum(x.change for x in adjustments over 2026)
ask d: flows(konto, 2026-05)
ask e: count(o in bank over 2026 where o.fulfils != none)
=== expect
a: 25 500.00 PLN
  unfulfilled: wage[2026-01]
  unfulfilled: wage[2026-02]
  unfulfilled: wage[2026-03]
  unfulfilled: wage[2026-04]
  unfulfilled: wage[2026-05]
  cut 2026-10-20
b: ?"wage[2026-03] on 2026-03-10 changed after it was paid (version raise_2026); is back pay due, and when?" (wage[2026-03])
  adjustment: wage[2026-03] by 500.00 PLN on 2026-05-01 (version raise_2026), remaining 500.00 PLN
  unfulfilled: wage[2026-01]
  unfulfilled: wage[2026-02]
  unfulfilled: wage[2026-03]
  unfulfilled: wage[2026-04]
  cut 2026-05-10
c: (1, 500.00 PLN)
  cut 2026-10-20
d: 5 500.00 PLN
  unfulfilled: wage[2026-05]
  cut 2026-10-20
e: 1
  cut 2026-10-20
