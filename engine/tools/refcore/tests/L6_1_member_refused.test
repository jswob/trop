# L §6.1: a member is a closed model that "stays reproducible alone"; one that doesn't load alone (ben's gift_in is
# undeclared, LOAD-NAME) refuses the joint model.
=== options pin=bytes
=== joint.tally
model family
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31
  use a = "ana.tally" sha256 "0b0615a67a4ae71646df39a5edbd8b0a4fe46b72c4f53654cfa7eaa10b6a9a81"
  use b = "ben.tally" sha256 "81dddba70438b1ac12069d806714fa5449f1d8ae6a7148c1cce5ee655448928f"
=== ana.tally
model ana
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2019-01-01..
place world: outside lives 1900-01-01..
place to_ben: outside lives 1900-01-01..
input wage_amt: money PLN
input pay_dom: int
input gift_amt: money PLN
input gift_day: date

move wage[m in months]: transfers
  on day_of(m, pay_dom)
  leg cash from world to konto amount wage_amt

move gift: transfers
  on gift_day
  leg cash from konto to to_ben amount gift_amt

version v
  cite s
  governs always
  known 2025-12-01
  wage_amt = 1 000.00 PLN "umowa"
  pay_dom = 10 "umowa"
  gift_amt = 300.00 PLN "plan"
  gift_day = 2026-03-15 "plan"
  opening[konto] = 500.00 PLN at 2026-01-01 start "wyciąg"

ask q: bal(konto, 2026-12-31)
=== ben.tally
model ben
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2019-01-01..
place from_ana: outside lives 1900-01-01..
input gift_day: date

move gift_in_m: transfers
  on gift_day
  leg cash from from_ana to konto amount gift_in

version v
  cite s
  governs always
  known 2025-12-01
  gift_in = 300.00 PLN "plan"
  gift_day = 2026-03-15 "plan"
  opening[konto] = 200.00 PLN at 2026-01-01 start "wyciąg"

ask q: bal(konto, 2026-12-31)
=== expect
refused: member b: LOAD-NAME ...
