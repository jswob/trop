# tally 2.1.8 §4 (#169-c, P24), L §4.6 Readings and L §5.19 l.1728: a reading replaced by `replace ... = none` is removed,
# so the reading before it is the last: from r3's known, last is r1's 3.00 EUR (l1), since counts from r1's day (24),
# and a plain read at the removed instant has no reading (p1); before r3 is known, r2's 4.00 EUR is the last (l2).
# 2.1.7's refcore took the none as the last reading (a hole for last, since from 2026-02-15, none for p1).
=== m.tally
model rm
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "synthetic"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind wallets: place EUR signed

place broker: wallets lives 2026-01-01..
place work: outside lives 1900-01-01..

ask l1: last(stated[broker], 2026-03-01)
ask l2: last(stated[broker], 2026-03-01) as known 2026-02-17
ask s1: since(stated[broker], 2026-03-01)
ask p1: stated[broker] with law 2026-02-15
ask p0: stated[broker] with law 2026-02-05
version v
  cite s
  governs always
  known 2026-01-01
  opening[broker] = 0.00 EUR at 2026-01-01 start "own"

version r1
  cite s
  governs 2026-02
  known 2026-02-06
  anchor broker
  stated[broker] = 3.00 EUR at 2026-02-05 end "first"

version r2
  cite s
  governs 2026-02
  known 2026-02-16
  anchor broker
  stated[broker] = 4.00 EUR at 2026-02-15 end "saldo"

version r3
  cite s
  governs 2026-02
  known 2026-02-20
  anchor broker
  replace stated[broker] = none at 2026-02-15 end "withdrawn"
=== expect
l1: 3.00 EUR
  held: stated[broker] = 3.00 EUR (r1), read for 2026-03-01
  cut 2026-06-30
l2: 4.00 EUR
  held: stated[broker] = 4.00 EUR (r2), read for 2026-03-01
  cut 2026-02-17
p0: 3.00 EUR
  pinned: law 2026-02-05
  law date 2026-02-05, cut 2026-06-30
p1: ?"stated[broker] has no reading at 2026-02-15" (stated[broker])
  pinned: law 2026-02-15
  law date 2026-02-15, cut 2026-06-30
s1: 24
  cut 2026-06-30
warning: WARN-UNREAD place work is read by nothing
