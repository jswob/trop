# tally 2.2.1 R18 (L §4.3: a move binds its keys in the order written; a read that states its own day needs no law
# date; the engine's move_read_dated):
# clause 1: region in last(rd[region], d0) in a key's where waits for the at: the twin's bytes
# (m3/fixes/lawdate/g1_d_last). tally 2.2: the guard.
=== g1_d_last.tally
model m
  tally 2
  on 2026-01-31
  start 2026-01-01
  end 2026-01-31

source s "s"

unit PLN: currency minor 0.01

place konto: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..

index wk = day 2026-01-05..2026-01-11
index regions = [pl, de]

input fee: money PLN
input cal[r in regions]: calendar
input region: key regions
input d0: date
input d1: date
input rd[r in regions]: date reading

move pay[d in wk where last(rd[region], d) == d0]: transfers
  on d
  at d
  leg cash from konto to shop amount fee

version v
  cite s
  governs always
  known 2026-01-01
  fee = 10.00 PLN
  d0 = 2026-01-02
  d1 = 2026-01-20
  rd[pl] = 2026-01-02 at 2026-01-01
  rd[de] = 2026-01-07 at 2026-01-07
  opening[konto] = 100.00 PLN at 2026-01-01 start "w"

version c
  cite s
  governs 2026..
  known 2026-01-01
  region = pl
  cal[pl] = calendar(weekends [sat, sun])
  cal[de] = calendar(weekends [sun])

ask q: bal(konto, 2026-01-31)
=== expect
q: 30.00 PLN
  unfulfilled: pay[2026-01-05]
  unfulfilled: pay[2026-01-06]
  unfulfilled: pay[2026-01-07]
  unfulfilled: pay[2026-01-08]
  unfulfilled: pay[2026-01-09]
  unfulfilled: pay[2026-01-10]
  unfulfilled: pay[2026-01-11]
  held: rd[pl] = 2026-01-02 (v), read for 2026-01-05
  held: rd[pl] = 2026-01-02 (v), read for 2026-01-06
  held: rd[pl] = 2026-01-02 (v), read for 2026-01-07
  held: rd[pl] = 2026-01-02 (v), read for 2026-01-08
  held: rd[pl] = 2026-01-02 (v), read for 2026-01-09
  held: rd[pl] = 2026-01-02 (v), read for 2026-01-10
  held: rd[pl] = 2026-01-02 (v), read for 2026-01-11
  cut 2026-01-31
warning: WARN-UNREAD input cal is read by nothing
warning: WARN-UNREAD input d1 is read by nothing
