# tally 2.3.1 R6: a hole `when` after a refused `where`: refused, not the hole (the order: false or `none` ends
# the read; else refused; else hole). Unchanged: a guard of the order.
=== w5_whenhole.tally
model w
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-05-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-05
place konto: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input dz[m in month]: int
input ten: int
input amt: money PLN
input dd[m in month]: date
input okw[m in month]: bool

move spend[m in month where ten / dz[m] > 0]: transfers
  on dd[m]
  when okw[m]
  leg cash from konto to shop amount amt

ask f2: flows(spend, 2026-02)
ask f5: flows(spend, 2026-05)
ask b3: bal(konto, 2026-03-31)
ask b5: bal(konto, 2026-05-31)
ask c: count(t in transfers over 2026-01 .. 2026-03)
ask n: count(t in transfers over 2026-01 .. 2026-05)
ask e5: spend[2026-05].day

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "s"
  ten = 10 "s"
  amt = 10.00 PLN "s"
  dz[2026-01] = 1 "s"
  dz[2026-02] = 1 "s"
  dz[2026-03] = 1 "s"
  dz[2026-04] = 1 "s"
  dz[2026-05] = 0 "s"
  dd[2026-01] = 2026-01-25 "s"
  dd[2026-02] = 2026-02-25 "s"
  dd[2026-03] = 2026-03-25 "s"
  dd[2026-04] = 2026-04-25 "s"
  okw[2026-01] = true "s"
  okw[2026-02] = true "s"
  okw[2026-03] = true "s"
  okw[2026-04] = true "s"
  dd[2026-05] = 2026-05-25 "s"
  okw[2026-05] = ?"is may on?" "s"
=== expect
b3: 970.00 PLN
  cut 2026-01-01
b5: refused: RUN-DIV division by zero
  cut 2026-01-01
c: 3
  cut 2026-01-01
e5: refused: RUN-DIV division by zero
  cut 2026-01-01
f2: 10.00 PLN
  cut 2026-01-01
f5: refused: RUN-DIV division by zero
  cut 2026-01-01
n: refused: RUN-DIV division by zero
  cut 2026-01-01
