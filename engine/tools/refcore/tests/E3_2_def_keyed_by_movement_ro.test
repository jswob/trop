# tally 2.2 (CHANGES.md 2.2-10, pick P14): the fault's fix is at the trimming, and the dependency graph is tally
# 2.1.8's. readers-of a kind, its move and the move's inputs, an observed input among them, beside a def keyed by the
# kind (in_pln): the def's key records no read, so readers-of transfers doesn't list in_pln. Expect: tally 2.1.8's
# refcore, byte for byte.
=== m.tally
model fx1
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
axis work
  yes "in work"
  no "not in work"
place wallet: accounts EUR lives 2025-01-01..
place world: outside lives 1900-01-01..
input fx: num PLN/EUR
input d1: date
input amt[w in work]: money EUR
input mo: month
input bank: observed

def pay: money EUR at reader
  rule base = amt[work]

move in1: transfers
  on d1
  at d1
  leg cash from world to wallet amount pay

def in_pln[t in transfers]: money PLN = round(t.cash.amount * fx, minor(PLN), half-up) at t.day

def by_inline: money PLN at reader
  rule base = sum(round(t.cash.amount * fx, minor(PLN), half-up) for t in transfers over mo where t.cash.to == wallet)
def by_helper: money PLN at reader
  rule base = sum(in_pln[t] for t in transfers over mo where t.cash.to == wallet)

version v
  cite s
  governs always
  known 2025-12-01
  d1 = 2026-03-05 "s"
  amt[yes] = 100.00 EUR "s"
  amt[no] = 300.00 EUR "s"
  mo = 2026-03 "s"
  fx = 4.0 "s"
  opening[wallet] = 0.00 EUR at 2026-01-01 start "s"

ask r1: readers-of transfers
ask r2: readers-of in1
ask r3: readers-of amt
ask r4: readers-of fx
ask r5: readers-of d1
ask r6: readers-of bank
ask r7: readers-of pay
=== expect
r1: by_helper, by_inline
r2: by_helper, by_inline
r3: pay, in1, by_helper, by_inline
r4: by_inline, in_pln, by_helper
r5: in1, by_helper, by_inline
r6: by_helper, by_inline
r7: in1, by_helper, by_inline
warning: WARN-UNREAD def by_helper is read by nothing
warning: WARN-UNREAD def by_inline is read by nothing
