# tally 2.2.1 (#231, 231.R2), L §5.18's diff row: added "only in S": the def extra is declared in scenario sa alone,
# so diff(extra) in sa against mini is 1 added in each fan-out cell. tally 2.2 compared it with the def read in mini,
# changed against ?"bump: no value" (the critic's ax/).
=== reality.tally
model mini
  tally 2
  on 2026-11-05
  start 2026-10-01
  end 2026-12-31

source s "Oświadczenia gospodarstwa"

unit PLN: currency minor 0.01

kind jobs
kind wages: event certain
  leg cash: PLN

place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..

input bank: observed
input pay_dom[j in jobs]: int
input salary[j in jobs, m in months]: money PLN question "Ile wynosi pensja z tej pracy w tym miesiącu?"

move wage[m in months, j in jobs over m]: wages
  on day_of(m, pay_dom[j])
  at start_of(m)
  leg cash from world to konto amount salary[j, m]

version home
  cite s
  governs 2026-10..
  known 2026-10-01
  jobs + [acme] lives 2020-02-01..
  pay_dom = 10 "umowa, § 5"
  salary = 7 000.00 PLN "umowa, § 4"
  opening[konto] = 1 000.00 PLN at 2026-10-01 start "wyciąg"
=== sa.tally
scenario sa over mini
  tally 2
  from 2026-12-01

axis cut_reading
  floor "rounds down"
  exact "no rounding"

input bump: money PLN

def extra: money PLN
  rule lo = bump when cut_reading == floor
  rule hi = bump + bump when cut_reading == exact

version c
  cite s
  governs always
  known 2026-10-19
  bump = 1.00 PLN "x"

ask qa: extra in sa
ask qd: diff(extra) in sa against mini
ask qb: bal(konto, 2026-12-31) in sa
=== expect qd
qd [cut_reading = floor]: diff in sa against mini: 0 changed, 1 added, 0 removed, 0 unchanged
  added extra: 1.00 PLN
  world: mini
  world: sa
  reading: cut_reading = floor
  cut 2026-11-05
qd [cut_reading = exact]: diff in sa against mini: 0 changed, 1 added, 0 removed, 0 unchanged
  added extra: 2.00 PLN
  world: mini
  world: sa
  reading: cut_reading = exact
  cut 2026-11-05
