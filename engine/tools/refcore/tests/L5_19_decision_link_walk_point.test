# tally 2.3.1 R6, C-9 (L §5.19's link heading, E §4.2 step 3): a row's link to a decision whose `when` reads a
# running balance is judged at the instance's walk point, so the reality loads. topup[2026-01] books 400.00 PLN
# (konto 500.00), so on 2026-02-05 `bal(konto) < lim` is false: topup[2026-02] doesn't exist and bank[r1]'s link
# is refused (b, f); loose answers. Before: the whole reality LOAD-READS (`bal(konto) with no day outside a
# decision`).
=== dec_link.tally
model dec_link
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-05-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-05
place konto: accounts PLN lives 2026-01-01..
place save: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input bank: observed
input lim: money PLN
input amt: money PLN
input d5: int

move topup[m in month]: transfers
  reads konto
  on day_of(m, d5)
  when bal(konto) < lim
  leg cash from save to konto amount amt

ask loose: sum(o.cash.amount for o in bank over 2026-02 where o.fulfils == none)
ask b: bal(konto, 2026-03-31)
ask f: flows(topup, 2026-02)

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"
  opening[save] = 5 000.00 PLN at 2026-01-01 start "s"
  lim = 500.00 PLN "s"
  amt = 400.00 PLN "s"
  d5 = 5 "s"

version feb
  cite s
  governs 2026-02
  known 2026-03-01
  covers konto
  bank[r1] = (on: 2026-02-05, kind: transfers, leg cash from save to konto amount 400.00 PLN, fulfils: topup[2026-02]) "the top-up"
  bank[r2] = (on: 2026-02-10, kind: transfers, leg cash from konto to shop amount 30.00 PLN) "loose"
=== expect
b: refused: RUN-RECORD observation bank[r1] fulfils topup[2026-02], which doesn't exist or doesn't touch its places
  unfulfilled: topup[2026-01]
  cut 2026-04-20
f: refused: RUN-RECORD observation bank[r1] fulfils topup[2026-02], which doesn't exist or doesn't touch its places
  cut 2026-04-20
loose: 30.00 PLN
  cut 2026-04-20
