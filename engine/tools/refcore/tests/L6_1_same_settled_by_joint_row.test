# L §6.1 same: a fact on which two things stated same disagree is a hole; "the joint model settles it with a version
# row of its own that states the value". The joint model's version states opening[a.wsp] = 950.00 PLN: w and t read it.
=== options pin=bytes
=== joint.tally
model family
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31
  use a = "ana.tally" sha256 "e438b0e9e801813f005290db20ae57dbafcfc06810324f3ba998080e5c2db6c3"
  use b = "ben2.tally" sha256 "795167065e30dd1086ef212ec914fd31c83a1e871abe08a262b7b21edd3b6858"
  same a.wsp = b.wsp

source joint_s "ustalenie"
unit PLN: currency minor 0.01

version settle
  cite joint_s
  governs always
  known 2026-01-02
  opening[a.wsp] = 950.00 PLN at 2026-01-01 start "uzgodnione saldo"

ask w: bal(a.wsp, 2026-06-01)
ask t: sum(bal(p, 2026-06-01) for p in accounts on 2026-06-01)
=== ana.tally
model ana
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
kind persons
place wsp: accounts PLN lives 2019-01-01..
input income[p in persons]: money PLN

version v
  cite s
  governs always
  known 2025-12-01
  persons + [ana, ola] lives 2000-01-01..
  income[ana] = 100.00 PLN "umowa"
  income[ola] = 10.00 PLN "umowa"
  opening[wsp] = 1 000.00 PLN at 2026-01-01 start "wyciąg"
=== ben2.tally
model ben
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
kind persons
place wsp: accounts PLN lives 2019-01-01..
input pocket[p in persons]: money PLN

version v
  cite s
  governs always
  known 2025-12-01
  persons + [ben, ola_k] lives 2000-01-01..
  pocket[ben] = 50.00 PLN "umowa"
  pocket[ola_k] = 5.00 PLN "umowa"
  opening[wsp] = 900.00 PLN at 2026-01-01 start "wyciąg"
=== expect w t
w: 950.00 PLN
  cut 2026-01-05
t: 950.00 PLN
  cut 2026-01-05
