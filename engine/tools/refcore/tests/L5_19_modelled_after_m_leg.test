# tally 2.1.8 R16 (#191 Q5, c7), L §5.19: m's leg is never counted after a reading after m: the reading on the
# 12th less the rent of the 13th gives 520.00 PLN on the 14th and on the 31st, though save is dated the 15th. The
# engine counted save after the reading (-400.00 PLN); 2.1.7's refcore dropped the reading (1 020.00, 100.00).
=== m.tally
model t
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30

source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input keep: money PLN
input d_save: int
input d_rent: int
input rentamt: money PLN

move save[m in months]: transfers
  on day_of(m, d_save)
  reads konto
  leg cash from konto to sav amount max(0 PLN, bal(konto) - keep)

move rent[m in months]: transfers
  on day_of(m, d_rent)
  leg cash from konto to world amount rentamt

version v
  cite s
  governs always
  known 2026-01-01
  keep = 100.00 PLN "s"
  d_save = 15 "s"
  d_rent = 13 "s"
  rentamt = 30.00 PLN "s"
  opening[konto] = 1050.00 PLN at 2026-03-01 start "s"
  opening[sav] = 0.00 PLN at 2026-03-01 start "s"

version st
  cite s
  governs 2026-03
  known 2026-04-02
  covers konto
  anchor konto
  bank[o1] = (on: 2026-03-12, kind: transfers, leg cash from konto to sav amount 500.00 PLN, fulfils: save[2026-03]) "o1"
  bank[o2] = (on: 2026-03-13, kind: transfers, leg cash from konto to world amount 30.00 PLN, fulfils: rent[2026-03]) "o2"
  stated[konto] = 550.00 PLN after save[2026-03] "saldo"

ask md: bal(konto, 2026-03-14) modelled, bal(konto, 2026-03-31) modelled
=== expect
md: (520.00 PLN, 520.00 PLN)
  cut 2026-06-10
