# L §5.19 One movement on two statements: rows stated same are one movement, "its fulfils ... stated on either row,
# or on both alike"; L §5.14.3: a settlement's remainder is the change less what settles it. The back pay of 500.00 for
# wage[2026-03]'s raise is on two statements that both cover konto, stated same, both naming the adjustment (M2 patch
# case P35, P46, G4's fix review item 2, its probes adj_both and adj_same): it settles the adjustment once, so flows of
# wage in May is 5 000.00 + 500.00 and no remaining line is listed, as with the link on one row (refcore settled it
# twice: 6 000.00, remaining -500.00 PLN).
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source act "act"
source bank_export "bank"
unit PLN: currency minor 0.01
kind wages: event certain
  leg cash: PLN
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
input wage_amt: money PLN
input wage_dom: int
input bank: observed
def net[m in months]: money PLN = wage_amt at start_of(m)

move wage[m in months]: wages
  on day_of(m, wage_dom)
  at start_of(m)
  leg cash from world to konto amount net[m]

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  wage_amt = 5 000.00 PLN "umowa"
  wage_dom = 10 "umowa"
  opening[konto] = 0 PLN at 2026-01-01 start "wyciąg"

version raise_2026
  cite act
  governs 2026-03
  known 2026-05-01
  replace wage_amt = 5 500.00 PLN "aneks"

version back_pay
  cite bank_export
  governs 2026-05
  known 2026-05-20
  covers konto 2026-05-15..2026-05-15
  bank[r1] = (on: 2026-05-15, kind: wages, leg cash from world to konto amount 500.00 PLN, fulfils: adjustments[wage[2026-03].cash, raise_2026]) "line 1"

version card
  cite bank_export
  governs 2026-05
  known 2026-05-21
  covers konto 2026-05-15..2026-05-15
  bank[c1] = (on: 2026-05-15, kind: wages, leg cash from world to konto amount 500.00 PLN, fulfils: adjustments[wage[2026-03].cash, raise_2026]) "card 1"
  same bank[r1] = bank[c1]

ask fw: flows(wage, 2026-05-01 .. 2026-05-31)
ask fw3: flows(wage, 2026-03-01 .. 2026-05-31)
ask bk: bal(konto, 2026-05-31)
=== expect
bk: 25 500.00 PLN
  unfulfilled: wage[2026-01]
  unfulfilled: wage[2026-02]
  unfulfilled: wage[2026-03]
  unfulfilled: wage[2026-04]
  unfulfilled: wage[2026-05]
  cut 2026-10-20
fw: 5 500.00 PLN
  unfulfilled: wage[2026-05]
  cut 2026-10-20
fw3: 15 500.00 PLN
  unfulfilled: wage[2026-03]
  unfulfilled: wage[2026-04]
  unfulfilled: wage[2026-05]
  cut 2026-10-20
