# tally 2.3.1 rulings 22 (1, 3; L §5.19: a link names; the row stands in for the instance its fulfils names, by
# the name alone; a name the model doesn't hold is the residual ledger's to report): rent[2026-01] doesn't exist
# (its `when` is false) and bank[a1] names it: the row is booked from its own fields (c, c1), counted by the name
# (n 1, ob 100.00 PLN, a 100.00 PLN), the ledger's line unexplained. The critic's p1_badlink. Before: every
# reader RUN-RECORD `… which doesn't exist or doesn't touch its places`.
=== p1_badlink.tally
model first
  tally 2
  on 2026-05-20
  start 2026-01-01
  end 2026-06-30

source s "invented values"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-06
place pot: accounts PLN lives 2026-01-01..
place landlord: outside lives 1900-01-01..
input bank: observed
input rent_amt: money PLN
input ok[m in month]: bool
input d5: int
input jm: month

move rent[m in month]: transfers
  on day_of(m, d5)
  at start_of(m)
  when ok[m]
  leg cash from pot to landlord amount rent_amt

ask a: flows(rent, 2026-01)
ask b: flows(rent, 2026-03)
ask c: bal(pot, 2026-03-31)
ask ob: observed(rent[jm]).cash.amount
ask n: count(o in bank over jm where o.fulfils == rent[jm])
ask loose: sum(o.cash.amount for o in bank over jm where o.fulfils == none)
ask dy: rent[jm].day
ask fp: flows(pot, 2026-01)
ask c1: bal(pot, 2026-01-31)
ask rs: residuals pot 2026-01
ask ex: count(t in transfers over 2026-01)

version v
  cite s
  governs always
  known 2026-01-01
  rent_amt = 100.00 PLN "s"
  d5 = 5 "s"
  jm = 2026-01 "s"
  ok[2026-01] = false "ok jan"
  ok[2026-02] = true "ok feb"
  ok[2026-03] = true "ok mar"
  ok[2026-04] = true "ok apr"
  ok[2026-05] = true "ok may"
  ok[2026-06] = true "ok jun"
  opening[pot] = 9000.00 PLN at 2026-01-01 start "s"

version jan
  cite s
  governs 2026-01
  known 2026-01-21
  covers pot
  bank[a1] = (on: 2026-01-05, kind: transfers, leg cash from pot to landlord amount 100.00 PLN, fulfils: rent[2026-01]) "names jan"
=== expect
a: 100.00 PLN
  cut 2026-05-20
b: 100.00 PLN
  unfulfilled: rent[2026-03]
  cut 2026-05-20
c: 8 700.00 PLN
  unfulfilled: rent[2026-02]
  unfulfilled: rent[2026-03]
  cut 2026-05-20
c1: 8 900.00 PLN
  cut 2026-05-20
dy: refused: RUN-NONE rent[2026-01] doesn't exist: a field read of it
  cut 2026-05-20
ex: 1
  cut 2026-05-20
fp: -100.00 PLN
  cut 2026-05-20
loose: 0
  cut 2026-05-20
n: 1
  cut 2026-05-20
ob: 100.00 PLN
  cut 2026-05-20
rs: residuals pot 2026-01
  2026-01 unexplained: model 0.00 PLN, observed -100.00 PLN, difference -100.00 PLN
    unexplained bank[a1] on 2026-01-05: observed -100.00 PLN
  cut 2026-05-20
