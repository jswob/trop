  same a.y = b.y
  same b.x = a.x
  note "n"

source s "src"

unit PLN: currency minor 0.01

unit hour "h"

kind beta

kind zeta: assets

kind alpha: zeta

input x: int

ask q: x

version v1
  cite s
  governs 2026..
  known window(2026-01-01, 2026-06-30)
  replace x = 3

version a3
  cite s
  governs 2026..
  known 2026-03-01
  replace x = 4

version v2
  cite s
  governs 2026..
  known 2026-03-01
  x = 2
sha256 ...
