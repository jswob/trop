# L §6.1 Consolidation: "an internal leg with no written link is listed and makes the group total a hole naming it"; L
# §8.1 HOLE-SAME "<movement> crosses to <member> with no link". As L6_1_same_observation_move without the same line
# linking a_g1 to d.gift: two movements in transfers (n = 2), and a_g1's leg into d.konto (through a.to_d) a hole there.
=== options pin=bytes
=== joint.tally
model family
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31
  use a = "ana.tally" sha256 "3f23d6cf64e65f9269838a9bf4129fc234d80754fcf890a98a39c5b90892143f"
  use d = "dora.tally" sha256 "1d8cb31883ef20021727b7b2f9bf3d65a92dce46c2954d0134d7c5522b8d8ba8"
  same a.to_d = d.konto

ask n: count(x in transfers over 2026-01)
ask t: sum(bal(p, 2026-01-31) for p in accounts on 2026-01-31)
ask kd: bal(d.konto, 2026-01-31)
=== ana.tally
model ana
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source bank_export "wyciąg"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2019-01-01..
place to_d: outside lives 1900-01-01..
input a_stmt: observed

version opening_2026
  cite bank_export
  governs always
  known 2026-01-01
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "saldo"

version statement_01
  cite bank_export
  governs 2026-01
  known 2026-02-01
  covers konto
  a_stmt[a_g1] = (on: 2026-01-12, kind: transfers, leg cash from konto to to_d amount 100.00 PLN) "przelew dla D"
=== dora.tally
model dora
  tally 2
  on 2026-03-01
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2019-01-01..
place from_a: outside lives 1900-01-01..
input gift_amt: money PLN
input gift_day: date

move gift: transfers
  on gift_day
  leg cash from from_a to konto amount gift_amt

version v
  cite s
  governs always
  known 2025-12-01
  gift_amt = 100.00 PLN "umowa"
  gift_day = 2026-01-12 "umowa"
  opening[konto] = 0 PLN at 2026-01-01 start "saldo"
=== expect n t kd
n: 2
...
t: ?"a.a_stmt[a_g1] crosses to d with no link" (a.a_stmt[a_g1])
...
kd: ?"a.a_stmt[a_g1] crosses to d with no link" (a.a_stmt[a_g1])
...
