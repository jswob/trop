# L §5.11 Ties are stated: "argmin/argmax anywhere two candidates can share a value, take ties by e: among tied
# candidates, the one with the least e ... A tie met at run with no ties by is refused (RUN-TIE); index order never
# breaks a tie."  cost[a] = cost[b] = 1, cost[c] = 2: argmin ties a and b; ties by rank picks the least rank (b).
=== m.tally
model t
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source s "s"

index options = [a, b, c]
input cost[o in options]: int
input rank[o in options]: int

version v
  cite s
  governs always
  known 2026-01-01
  cost[a] = 1
  cost[b] = 1
  cost[c] = 2
  rank[a] = 2
  rank[b] = 1
  rank[c] = 3

ask q1: argmin(cost[o] for o in options)
ask q2: argmin(cost[o] for o in options) ties by rank[o]
=== expect
q1: refused: RUN-TIE ...
  cut 2026-12-31
q2: b
  cut 2026-12-31
