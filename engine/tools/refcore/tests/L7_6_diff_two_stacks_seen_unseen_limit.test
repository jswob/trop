# tally 2.1.8 S7 (L §7.6 item 6, RUN-LIMIT; item 16 of the fourth turn, the builder's last fix, b3_15): fifteen
# same lines known in a window that holds d's cut, 2^15 seen and unseen choices, past 20 000, on a diff whose
# worlds sit on two stacks: d is refused, as the one-world line c is. 42c4100a printed the first choice's diff.
=== m.tally
model sev
  tally 2
  on 2026-05-31
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
input bank: observed
input amt: money PLN
place konto: accounts PLN lives 2026-01-01..
place sav: accounts PLN lives 2026-01-01..

version v1
  cite s
  governs 2026..
  known 2026-01-01
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "s"
  opening[sav] = 0.00 PLN at 2026-01-01 start "s"

version st_konto
  cite s
  governs 2026-04
  known 2026-04-02
  covers konto
  bank[a1] = (on: 2026-04-02, kind: transfers, leg cash from konto to sav amount 1.00 PLN) "a1"
  bank[a2] = (on: 2026-04-03, kind: transfers, leg cash from konto to sav amount 2.00 PLN) "a2"
  bank[a3] = (on: 2026-04-04, kind: transfers, leg cash from konto to sav amount 3.00 PLN) "a3"
  bank[a4] = (on: 2026-04-05, kind: transfers, leg cash from konto to sav amount 4.00 PLN) "a4"
  bank[a5] = (on: 2026-04-06, kind: transfers, leg cash from konto to sav amount 5.00 PLN) "a5"
  bank[a6] = (on: 2026-04-07, kind: transfers, leg cash from konto to sav amount 6.00 PLN) "a6"
  bank[a7] = (on: 2026-04-08, kind: transfers, leg cash from konto to sav amount 7.00 PLN) "a7"
  bank[a8] = (on: 2026-04-09, kind: transfers, leg cash from konto to sav amount 8.00 PLN) "a8"
  bank[a9] = (on: 2026-04-10, kind: transfers, leg cash from konto to sav amount 9.00 PLN) "a9"
  bank[a10] = (on: 2026-04-11, kind: transfers, leg cash from konto to sav amount 10.00 PLN) "a10"
  bank[a11] = (on: 2026-04-12, kind: transfers, leg cash from konto to sav amount 11.00 PLN) "a11"
  bank[a12] = (on: 2026-04-13, kind: transfers, leg cash from konto to sav amount 12.00 PLN) "a12"
  bank[a13] = (on: 2026-04-14, kind: transfers, leg cash from konto to sav amount 13.00 PLN) "a13"
  bank[a14] = (on: 2026-04-15, kind: transfers, leg cash from konto to sav amount 14.00 PLN) "a14"
  bank[a15] = (on: 2026-04-16, kind: transfers, leg cash from konto to sav amount 15.00 PLN) "a15"

version st_sav
  cite s
  governs 2026-04
  known 2026-04-03
  covers sav
  bank[b1] = (on: 2026-04-02, kind: transfers, leg cash from konto to sav amount 1.00 PLN) "b1"
  bank[b2] = (on: 2026-04-03, kind: transfers, leg cash from konto to sav amount 2.00 PLN) "b2"
  bank[b3] = (on: 2026-04-04, kind: transfers, leg cash from konto to sav amount 3.00 PLN) "b3"
  bank[b4] = (on: 2026-04-05, kind: transfers, leg cash from konto to sav amount 4.00 PLN) "b4"
  bank[b5] = (on: 2026-04-06, kind: transfers, leg cash from konto to sav amount 5.00 PLN) "b5"
  bank[b6] = (on: 2026-04-07, kind: transfers, leg cash from konto to sav amount 6.00 PLN) "b6"
  bank[b7] = (on: 2026-04-08, kind: transfers, leg cash from konto to sav amount 7.00 PLN) "b7"
  bank[b8] = (on: 2026-04-09, kind: transfers, leg cash from konto to sav amount 8.00 PLN) "b8"
  bank[b9] = (on: 2026-04-10, kind: transfers, leg cash from konto to sav amount 9.00 PLN) "b9"
  bank[b10] = (on: 2026-04-11, kind: transfers, leg cash from konto to sav amount 10.00 PLN) "b10"
  bank[b11] = (on: 2026-04-12, kind: transfers, leg cash from konto to sav amount 11.00 PLN) "b11"
  bank[b12] = (on: 2026-04-13, kind: transfers, leg cash from konto to sav amount 12.00 PLN) "b12"
  bank[b13] = (on: 2026-04-14, kind: transfers, leg cash from konto to sav amount 13.00 PLN) "b13"
  bank[b14] = (on: 2026-04-15, kind: transfers, leg cash from konto to sav amount 14.00 PLN) "b14"
  bank[b15] = (on: 2026-04-16, kind: transfers, leg cash from konto to sav amount 15.00 PLN) "b15"

version link1
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a1] = bank[b1]

version link2
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a2] = bank[b2]

version link3
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a3] = bank[b3]

version link4
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a4] = bank[b4]

version link5
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a5] = bank[b5]

version link6
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a6] = bank[b6]

version link7
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a7] = bank[b7]

version link8
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a8] = bank[b8]

version link9
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a9] = bank[b9]

version link10
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a10] = bank[b10]

version link11
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a11] = bank[b11]

version link12
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a12] = bank[b12]

version link13
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a13] = bank[b13]

version link14
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a14] = bank[b14]

version link15
  cite s
  governs always
  known window(2026-05-01, 2026-05-20)
  same bank[a15] = bank[b15]

ask c: count(t in transfers over 2026-04) as known 2026-05-10
ask d: diff(count(t in transfers over 2026-04)) in sc against sd as known 2026-05-10
ask e: count(t in transfers over 2026-04-01 .. 2026-04-03) as known 2026-05-10
ask z: count(t in transfers over 2026-03) as known 2026-05-10
=== sc.tally
scenario sc over sev
  tally 2
  from 2026-01-01

version sc_v
  cite s
  governs 2026-01-01..
  known 2026-01-01
  amt = 1.00 PLN "s"
=== sd.tally
scenario sd over sev
  tally 2
  from 2026-01-01

version sd_v
  cite s
  governs 2026-01-01..
  known 2026-01-01
  amt = 1.00 PLN "s"
=== expect c d
c: refused: RUN-LIMIT seen and unseen over more than 20 000 choices
d: refused: RUN-LIMIT seen and unseen over more than 20 000 choices
warning: WARN-UNREAD input amt is read by nothing
