# tally 2.2.1 P32 (L §5.19 l.1726, E §4.1 step 2), the first engine review's N1 and N8: a reading's instant inside a
# window is an edge. At the anchor's own instant (2026-04-02 end) the balance is the stated 700.00 PLN, as every pin;
# from the next instant it is the window's hole, past the window's end too, as the pins differ (700.00, 800.00). tally
# 2.2 printed the hole at the anchor and 800.00 PLN after the window.
=== c2.tally
model c2
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-12-31
source card "invented"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..
input pay: money PLN
input w2: date
move pay_x: transfers
  on w2
  leg cash from world to konto amount pay
version v_card
  cite card
  governs always
  known 2026-01-01
  pay = 100.00 PLN "c"
  w2 = window(2026-04-01, 2026-04-03) "c"
  opening[konto] = 500.00 PLN at 2026-01-01 start "c"
version st2
  cite card
  governs 2026-04
  known 2026-04-10
  anchor konto
  stated[konto] = 700.00 PLN at 2026-04-02 end "s2"
ask a20260401: bal(konto, 2026-04-01) 
ask a20260401_p20260401: bal(konto, 2026-04-01)  with w2 = 2026-04-01
ask a20260401_p20260402: bal(konto, 2026-04-01)  with w2 = 2026-04-02
ask a20260401_p20260403: bal(konto, 2026-04-01)  with w2 = 2026-04-03
ask a20260402: bal(konto, 2026-04-02) 
ask a20260402_p20260401: bal(konto, 2026-04-02)  with w2 = 2026-04-01
ask a20260402_p20260402: bal(konto, 2026-04-02)  with w2 = 2026-04-02
ask a20260402_p20260403: bal(konto, 2026-04-02)  with w2 = 2026-04-03
ask a20260403: bal(konto, 2026-04-03) 
ask a20260403_p20260401: bal(konto, 2026-04-03)  with w2 = 2026-04-01
ask a20260403_p20260402: bal(konto, 2026-04-03)  with w2 = 2026-04-02
ask a20260403_p20260403: bal(konto, 2026-04-03)  with w2 = 2026-04-03
ask a20260405: bal(konto, 2026-04-05) 
ask a20260405_p20260401: bal(konto, 2026-04-05)  with w2 = 2026-04-01
ask a20260405_p20260402: bal(konto, 2026-04-05)  with w2 = 2026-04-02
ask a20260405_p20260403: bal(konto, 2026-04-05)  with w2 = 2026-04-03
=== expect
a20260401: ?"date within window(2026-04-01, 2026-04-03) not precise enough for a balance" (pay_x)
  unknown day: w2
  cut 2026-04-20
a20260401_p20260401: 600.00 PLN
  pinned: w2 = 2026-04-01
  unfulfilled: pay_x
  cut 2026-04-20
a20260401_p20260402: 500.00 PLN
  pinned: w2 = 2026-04-02
  cut 2026-04-20
a20260401_p20260403: 500.00 PLN
  pinned: w2 = 2026-04-03
  cut 2026-04-20
a20260402: 700.00 PLN
  anchor: konto 2026-04-02 end, stated 700.00 PLN, difference ?"date within window(2026-04-01, 2026-04-03) not precise enough for a balance" (pay_x)
  cut 2026-04-20
