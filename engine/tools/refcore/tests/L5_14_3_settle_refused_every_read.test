# L §5.14.3 How a settlement leg counts, E §3.2 (tally 2.1.2, issue #44, the S-close coordinator's ruling of 2026-11-03,
# confirmed by the user at G-SP1: "Confirm both"): turn swaps t[2026-03]'s places, so bank[r1], settling it, is refused
# (RUN-RECORD), and every read that settles the adjustment meets that refusal, in any order. tally 2.1.1's refcore
# marked the adjustment linked before the refusal, so of two reads in one ask the later took the HOLE-CHANGED hole
# (?"t[2026-03] on 2026-03-10 changed after it was paid ..."), and swapping them swapped the answers.
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source act "act"
source bank_export "bank"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2019-05-01..
place konto2: accounts PLN lives 2019-05-01..
input amt: money PLN
input dom: int
input src: key accounts
input dst: key accounts
input bank: observed
def s_[m in months]: key accounts = src at start_of(m)
def d_[m in months]: key accounts = dst at start_of(m)

move t[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from s_[m] to d_[m] amount amt

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  amt = 100.00 PLN "umowa"
  dom = 10 "umowa"
  src = konto "umowa"
  dst = konto2 "umowa"
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "wyciąg"
  opening[konto2] = 0 PLN at 2026-01-01 start "wyciąg"

version turn
  cite act
  governs 2026-03
  known 2026-05-01
  replace src = konto2 "aneks"
  replace dst = konto "aneks"

version settle
  cite bank_export
  governs 2026-05
  known 2026-05-20
  bank[r1] = (on: 2026-05-15, kind: transfers, leg cash from konto2 to konto amount 100.00 PLN, fulfils: adjustments[t[2026-03].cash, turn]) "line 1"

ask q: flows(t, 2026-05-01 .. 2026-05-31), bal(konto, 2026-06-30)
ask q2: bal(konto, 2026-06-30), flows(t, 2026-05-01 .. 2026-05-31)
=== expect
q: (refused: RUN-RECORD settlement bank[r1] of adjustments[t[2026-03].cash, turn]: the leg is turned round, refused: RUN-RECORD settlement bank[r1] of adjustments[t[2026-03].cash, turn]: the leg is turned round)
  unfulfilled: t[2026-05]
  cut 2026-10-20
q2: (refused: RUN-RECORD settlement bank[r1] of adjustments[t[2026-03].cash, turn]: the leg is turned round, refused: RUN-RECORD settlement bank[r1] of adjustments[t[2026-03].cash, turn]: the leg is turned round)
  unfulfilled: t[2026-05]
  cut 2026-10-20
