# tally 2.3.1 R1, #248 face (b): a hole law date's balance at the lifespan's end (spec-2.3's j3q): q the hole of
# the law date; a pinned day keeps its answer (q_p10 0.00 PLN, q_p15 refused). Before: q RUN-LIFESPAN.
=== j3q.tally
model m
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source plan "p"

unit PLN: currency minor 0.01

kind rents: event certain
  leg cash: PLN

place konto: accounts PLN lives 2026-01-01..

place spare: accounts PLN lives 2026-01-01..2026-06-30

place landlord: outside lives 1900-01-01..

input rent_amt: money PLN

input back_amt: money PLN

input act_day: date

input back_day: date

input zero: int

input one_amt: money PLN

input gap_day: date

input d_open: date

input win_day: date

move rent[m in months]: rents
  on start_of(m)
  at start_of(m)
  leg cash from konto to landlord amount rent_amt

move shut[p in accounts on d_open where act_day < back_day]: transfers
  on d_open
  at win_day
  leg cash from p to landlord amount back_amt

version v
  cite plan
  governs 2026..
  known 2026-01-01
  rent_amt = 900.00 PLN
  back_amt = 100.00 PLN

version v2
  cite plan
  governs 2026..
  known 2026-03-15
  replace rent_amt = 950.00 PLN "raise"

version day
  cite plan
  governs 2026..
  known 2026-01-01
  act_day = 2026-04-05
  back_day = 2026-04-20

version day2
  cite plan
  governs 2026-03-15..
  known 2026-01-02
  replace act_day = 2026-04-25

version fixed
  cite plan
  governs always
  known 2026-01-01
  zero = 0
  one_amt = 1.00 PLN
  d_open = 2026-01-01
  win_day = ?"which law date?"
  opening[spare] = 100.00 PLN at 2026-01-01 start "w"

ask q: bal(spare, 2026-06-30) law cut
ask q2: bal(konto, 2026-05-31) law cut

ask qe9: explain bal(spare, 2026-06-30) law cut
ask qj: bal(spare, d) for d in [2026-01-01, 2026-03-09, 2026-03-21] law cut

ask qw: win_day
ask qa1: act_day < back_day law 2026-03-10
ask qa2: act_day < back_day law 2026-03-15
ask qk: bal(konto, 2026-01-31) law cut
ask q_p10: bal(spare, 2026-06-30) with win_day = 2026-03-10 law cut
ask q_p14: bal(spare, 2026-06-30) with win_day = 2026-03-14 law cut
ask q_p15: bal(spare, 2026-06-30) with win_day = 2026-03-15 law cut
ask q_p20: bal(spare, 2026-06-30) with win_day = 2026-03-20 law cut
ask sd: shut[spare].day law cut
ask n_t: count(t in transfers over 2026-01) law cut
ask q_may: bal(spare, 2026-05-31) law cut
ask q_jul: bal(konto, 2026-07-31) law cut
=== expect q q_p10 q_p15 n_t
q: ?"which law date?" (win_day)
  law date 2026-06-30, cut 2026-06-30
q_p10: 0.00 PLN
  pinned: win_day = 2026-03-10
  unfulfilled: shut[spare]
  law date 2026-06-30, cut 2026-06-30
q_p15: refused: RUN-LIFESPAN spare ends on 2026-06-30 holding 100.00 PLN
  law date 2026-06-30, cut 2026-06-30
n_t: ?"which law date?" (win_day)
  law date 2026-06-30, cut 2026-06-30
