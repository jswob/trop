# L §5.11 Recurrences: "A def may read itself ... at an earlier key of an ordered index (x[k - 1])"; the read sits
# under a guard (when pos(y) > 1).  x[1] = start (rule first); later keys add step to the earlier key:
# x[2] = start + step, x[3] = start + step + step.  start = 10, step = 1 (rows).
=== m.tally
model t
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source s "s"

index ks = 1..3
input start0: int
input step: int

def x[k in ks]: int at reader
  rule first = start0
  rule later beats first = x[k - 1] + step when pos(k) > 1

version v
  cite s
  governs always
  known 2026-01-01
  start0 = 10
  step = 1

ask q1: x[k] for k in ks law 2026-06-30
=== expect
q1 (k = 1): 10
  law date 2026-06-30, cut 2026-12-31
q1 (k = 2): 11
  law date 2026-06-30, cut 2026-12-31
q1 (k = 3): 12
  law date 2026-06-30, cut 2026-12-31
