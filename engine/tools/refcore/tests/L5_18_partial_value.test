# tally 2.1.8 R15 (vector 1), L §5.18, §5.10: value is a sum of positions times prices: a hole number of units at
# a known price is linear (the price the coefficient), a known number at a hole price too (the units); both holes are
# a product of two holes, the plain hole naming both.
=== m.tally
model t
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-06-30

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
unit etf "a fund unit"
kind funds: place one min 0
kind unit_buys: event certain
  leg units: etf
place f1: funds etf lives 2026-01-01..
place f2: funds etf lives 2026-01-01..
place f3: funds etf lives 2026-01-01..
place konto: accounts PLN lives 2026-01-01..
place market: outside lives 2026-01-01..
index ks = [a, b]
input n1: num etf
input n2: num etf
input px1: num PLN/etf
input px2: num PLN/etf
input amt: money PLN
input bday: date
input pday: date
input fx: num PLN/EUR
input rate: num
input h: money PLN
input k: money PLN
input c[x in ks]: bool

move b1: unit_buys
  on bday
  leg units from market to f1 amount n1
move b2: unit_buys
  on bday
  leg units from market to f2 amount n2
move b3: unit_buys
  on bday
  leg units from market to f3 amount n1
move pay: transfers
  on pday
  leg cash from market to konto amount amt

version v
  cite s
  governs always
  known 2026-01-01
  n1 = ?"how many units" "s"
  n2 = 3 etf "s"
  px1 = 5 PLN/etf "s"
  px2 = ?"what price" "s"
  amt = ?"how much" "s"
  bday = 2026-01-10 "s"
  pday = 2026-02-05 "s"
  fx = 4 PLN/EUR "s"
  rate = 2 "s"
  h = ?"what is h" "s"
  k = 10.00 PLN "s"
  c[a] = true "s"
  c[b] = ?"is b" "s"
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"

ask v1a: value(f1, 2026-02-01) in PLN by px1 partial
ask v1b: value(f2, 2026-02-01) in PLN by px2 partial
ask v1c: value(f3, 2026-02-01) in PLN by px2 partial
=== expect
v1a: 0 PLN + 5 PLN/etf × ?"how many units" (n1)
  unfulfilled: b1
  cut 2026-06-10
v1b: 0 PLN + 3 etf × ?"what price" (px2)
  unfulfilled: b2
  cut 2026-06-10
v1c: ?"how many units" (n1) ?"what price" (px2)
  unfulfilled: b3
  cut 2026-06-10
warning: WARN-UNREAD input c is read by nothing
warning: WARN-UNREAD input fx is read by nothing
warning: WARN-UNREAD input h is read by nothing
warning: WARN-UNREAD input k is read by nothing
warning: WARN-UNREAD input rate is read by nothing
