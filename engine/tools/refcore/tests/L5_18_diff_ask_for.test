# tally 2.1.8 R13.1 (item 3 of the follow-up): a diff's ask-level for is the body per binding tuple, each block under
# the head naming its tuple (h2, h3 with the diff's own for inside). 2.1.8's first refcore stopped
# REFCORE-NOT-YET (KeyError: 'k'). The review's B1_diff_for.
=== m.tally
model pw
  tally 2
  on 2026-04-25
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
index ks = [a, b]
place konto: accounts PLN lives 2026-01-01..
place jar[k in ks]: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input amt: money PLN
input dk[k in ks]: date
input dj: date
input dd: int
input d0: date
input amt2: money PLN

move one[k in ks]: transfers
  on dk[k]
  at d0
  leg cash from world to jar[k] amount amt

move two: transfers
  on dj
  at d0
  leg cash from world to konto amount amt2

move pay[m in months]: transfers
  on day_of(m, dd)
  at start_of(m)
  leg cash from world to konto amount amt

version v
  cite s
  governs always
  known 2026-01-01
  amt = 10.00 PLN "s"
  dk[a] = window(2026-03-01, 2026-03-10) "s"
  dk[b] = 2026-03-05 "s"
  amt2 = 5.00 PLN "s"
  dd = 10 "s"
  d0 = 2026-01-01 "s"
  dj = window(2026-03-02, 2026-03-04) "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  opening[jar[a]] = 0.00 PLN at 2026-01-01 start "s"
  opening[jar[b]] = 0.00 PLN at 2026-01-01 start "s"

version st
  cite s
  governs 2026-03
  known 2026-04-01
  covers konto, jar[a], jar[b]
  bank[r1] = (on: 2026-03-10, kind: transfers, leg cash from world to konto amount 12.00 PLN) "r1"
  bank[r2] = (on: 2026-03-03, kind: transfers, leg cash from world to konto amount 5.00 PLN) "r2"
  bank[r3] = (on: 2026-03-06, kind: transfers, leg cash from world to jar[a] amount 10.00 PLN) "r3"
  bank[r4] = (on: 2026-03-05, kind: transfers, leg cash from world to jar[b] amount 10.00 PLN) "r4"
ask h2: diff(dk[k]) in sd against pw for k in [b] law 2026-03-01
ask h3: diff(dk[j] for j in ks) in sd against pw for k in ks law 2026-03-01
=== B1_diff_for_sc.tally
scenario sc over pw
  tally 2
  from 2026-01-01

version sc_v
  cite s
  governs 2026-01-01..
  known 2026-01-01
  replace amt2 = 7.00 PLN "s"
=== B1_diff_for_sd.tally
scenario sd over pw
  tally 2
  from 2026-01-01

version sd_v
  cite s
  governs 2026-01-01..
  known 2026-01-01
  replace dk[b] = 2026-03-07 "s"
=== expect
h2 (k = b): diff in sd against pw: 1 changed, 0 added, 0 removed, 0 unchanged
  changed dk[k]: 2026-03-07 against 2026-03-05
  world: pw
  world: sd
  law date 2026-03-01, cut 2026-04-25
h3 (k = a): diff in sd against pw: 1 changed, 0 added, 0 removed, 1 unchanged
  changed (j = b): 2026-03-07 against 2026-03-05
  world: pw
  world: sd
  law date 2026-03-01, cut 2026-04-25
h3 (k = b): diff in sd against pw: 1 changed, 0 added, 0 removed, 1 unchanged
  changed (j = b): 2026-03-07 against 2026-03-05
  world: pw
  world: sd
  law date 2026-03-01, cut 2026-04-25
