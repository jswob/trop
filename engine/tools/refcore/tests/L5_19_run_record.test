# L §5.19 / §8.4 RUN-RECORD: "observation <r> fulfils <instance>, which doesn't exist": pay[2026-02]'s when is false
# (skip[2026-02] = true), and an observation of February's statement fulfils it.
# Own reality: konto opens at 5 000.00 PLN, savings at 0; amt = 1 000.00 PLN, dom = 5.
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source bank "bank"
unit PLN: currency minor 0.01
input bank_rows: observed
input amt: money PLN
input dom: int
place konto: accounts PLN lives 2019-05-01..
place savings: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..

input skip[m in months]: bool
move pay[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  when not skip[m]
  leg cash from konto to world amount amt

version stmt
  cite bank
  governs 2026-02
  known 2026-03-02
  covers konto
  pad konto from unexplained
  bank_rows[r1] = (on: 2026-02-05, kind: transfers, leg cash from konto to savings amount 100.00 PLN, fulfils: pay[2026-02]) "line 1"

ask q: bal(konto, 2026-02-28)

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  amt = 1 000.00 PLN "own"
  dom = 5 "own"
  opening[konto] = 5 000.00 PLN at 2026-01-01 start "wyciąg"
  opening[savings] = 0 PLN at 2026-01-01 start "wyciąg"
  skip = false "own"
  skip[2026-02] = true "own"
=== expect
q: refused: RUN-RECORD observation bank_rows[r1] fulfils pay[2026-02], which doesn't exist or doesn't touch its places
  unfulfilled: pay[2026-01]
  cut 2026-10-20
