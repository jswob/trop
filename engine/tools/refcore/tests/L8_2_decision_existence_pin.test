# tally 2.3.1 C-9 (G2's review finding 3): a pinned `lim` that decided the decision's existence is listed under
# every reader resting on its link, refused ones included (fp, lp, bp `pinned: lim = 500.00 PLN`). Before: lp
# had no pin line.
# tally 2.3.1 rulings 22 (part 1, a link names): the row stands in for the tuple it names by the name alone; no link is refused, judged at a point or re-walked, and only a field read through o.fulfils reaches step 7's mark. Re-stored.
=== dl_pin.tally
model dl
  tally 2
  on 2026-04-20
  start 2026-01-01
  end 2026-05-31

source s "probe"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-05
place konto: accounts PLN lives 2026-01-01..
place save: accounts PLN lives 2026-01-01..
place shop: outside lives 1900-01-01..
input bank: observed
input lim: money PLN
input amt: money PLN
input d5: int
input fm: month
input de: date

move topup[m in month]: transfers
  reads konto
  on day_of(m, d5)
  when bal(konto) < lim
  leg cash from save to konto amount amt

def fl: money PLN = flows(topup, fm)
def bl: money PLN = bal(konto, de)
ask f: fl
ask fp: fl with lim = 500.00 PLN
ask bp: bl with lim = 500.00 PLN
ask b: bl
ask lp: sum(o.cash.amount for o in bank over fm where o.fulfils == none) with lim = 500.00 PLN
ask l: sum(o.cash.amount for o in bank over fm where o.fulfils == none)

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 100.00 PLN at 2026-01-01 start "s"
  opening[save] = 5 000.00 PLN at 2026-01-01 start "s"
  lim = 600.00 PLN "s"
  amt = 400.00 PLN "s"
  d5 = 5 "s"
  fm = 2026-02 "s"
  de = 2026-03-31 "s"

version feb
  cite s
  governs 2026-02
  known 2026-03-01
  covers konto
  bank[r1] = (on: 2026-02-05, kind: transfers, leg cash from save to konto amount 400.00 PLN, fulfils: topup[2026-02]) "the top-up"
  bank[r2] = (on: 2026-02-10, kind: transfers, leg cash from konto to shop amount 30.00 PLN) "loose"
=== expect
b: 870.00 PLN
  unfulfilled: topup[2026-01]
  cut 2026-04-20
bp: 870.00 PLN
  pinned: lim = 500.00 PLN
  unfulfilled: topup[2026-01]
  cut 2026-04-20
f: 400.00 PLN
  unfulfilled: topup[2026-01]
  cut 2026-04-20
fp: 400.00 PLN
  cut 2026-04-20
l: 30.00 PLN
  cut 2026-04-20
lp: 30.00 PLN
  cut 2026-04-20
