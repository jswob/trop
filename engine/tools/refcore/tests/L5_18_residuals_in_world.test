# L §2.3 rule 4, §5.18 (tally 2.1.8 R13 rest 1): `in S` after a residuals span names the world S, as after every
# body: rs reads sc's row r2, and its register names the world; rp is the base's ledger. 2.1.7's refcore and the
# engine parsed `in sc` into the span.
=== m.tally
model rf
  tally 2
  on 2026-04-10
  start 2026-03-01
  end 2026-06-30

source s "s"
unit PLN: currency minor 0.01
index ks = [a, b]
place jar[k in ks]: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input bank: observed
input amt[k in ks]: money PLN
input pd: date

move pay[k in ks]: transfers
  on pd
  leg cash from world to jar[k] amount amt[k]

version v
  cite s
  governs always
  known 2026-01-01
  amt[a] = 10.00 PLN "s"
  pd = 2026-03-10 "s"
  amt[b] = 20.00 PLN "s"
  opening[jar[a]] = 0.00 PLN at 2026-03-01 start "s"
  opening[jar[b]] = 0.00 PLN at 2026-03-01 start "s"

version st
  cite s
  governs 2026-03
  known 2026-04-02
  covers jar[a], jar[b]
  bank[r1] = (on: 2026-03-10, kind: transfers, leg cash from world to jar[a] amount 12.00 PLN) "r1"

ask rs: residuals jar[b] 2026-03 in sc
ask rp: residuals jar[b] 2026-03
=== sc.tally
scenario sc over rf
  tally 2
  from 2026-01-01
  note "x"

version vs
  cite s
  governs 2026-03
  known 2026-04-02
  bank[r2] = (on: 2026-03-12, kind: transfers, leg cash from world to jar[b] amount 5.00 PLN) "r2"
=== expect
rp: residuals jar[b] 2026-03
  2026-03 move pay: model 20.00 PLN, observed 0.00 PLN, difference -20.00 PLN
    expected but missing pay[b] on 2026-03-10: model 20.00 PLN
  cut 2026-04-10
rs: residuals jar[b] 2026-03
  2026-03 move pay: model 20.00 PLN, observed 0.00 PLN, difference -20.00 PLN
    expected but missing pay[b] on 2026-03-10: model 20.00 PLN
  2026-03 unexplained: model 0.00 PLN, observed 5.00 PLN, difference 5.00 PLN
    unexplained bank[r2] on 2026-03-12: observed 5.00 PLN
  world: sc
  cut 2026-04-10
