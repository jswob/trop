# tally 2.2.1 P30 (L §4.4 l.667 to l.671): an operation decides over an interval only what holds for every value
# the interval can hold; its ends stand for them only where it is monotone and gives a value everywhere between.
# The review's e2: round where the values agree is one value, where they all refuse the refusal (N2's rest: r_agree,
# r_cmp, r_ref); pow of -1 (pl, B1); day_of and add_days of a half (dofh, adh, B2); a divisor whose interval holds 0 is
# the hole (dvc, dv1, dve, dvw2: B3, N6); one window named in two arguments of one operation is one day, overlap_days(w,
# w, k) 1 as days_between(w, w) 0 (ovw, dbw: N9). tally 2.2 printed 1, true, RUN-NOT-INT, false, RUN-DIV and the hole
# for ovw.
=== e2.tally
model e2
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31
source card "invented"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
input w: date
input w1: date
input wl: date
input d0: date
input d1: date
input n2: num
input n3: num
input n100: num
input m1: num
input k1: num
input mm: month
input de: date
input mar: date
input step0: num
input n18: num
input n20: num
input n5: num
version v_card
  cite card
  governs always
  known 2026-01-01
  w = window(2026-03-10, 2026-03-12) "c"
  w1 = window(2026-03-10, 2026-03-10) "c"
  wl = window(2026-01-01, 2027-06-01) "c"
  d0 = 2026-03-11 "c"
  d1 = 2026-03-01 "c"
  n2 = 2 "c"
  n3 = 3 "c"
  n100 = 100 "c"
  m1 = -1 "c"
  k1 = 1 "c"
  mm = 2026-02 "c"
  de = 2025-12-30 "c"
  mar = 2026-03-01 "c"
  step0 = 0 "c"
  n18 = 18 "c"
  n20 = 20 "c"
  n5 = 5 "c"
  opening[konto] = 0.00 PLN at 2026-01-01 start "c"
ask r_agree: round(days_between(d1, w) / n100, 1, half-up)
ask r_agree_a: round(days_between(d1, w) / n100, 1, half-up) with w = 2026-03-10
ask r_agree_b: round(days_between(d1, w) / n100, 1, half-up) with w = 2026-03-11
ask r_agree_c: round(days_between(d1, w) / n100, 1, half-up) with w = 2026-03-12
ask r_cmp: round(days_between(d1, w) / n3, 1, half-up) > k1
ask r_cmp_a: round(days_between(d1, w) / n3, 1, half-up) > k1 with w = 2026-03-10
ask r_cmp_c: round(days_between(d1, w) / n3, 1, half-up) > k1 with w = 2026-03-12
ask r_ref: round(days_between(d1, w) / n100, step0, half-up)
ask r_ref_a: round(days_between(d1, w) / n100, step0, half-up) with w = 2026-03-10
ask pl: pow(m1, days_between(de, wl))
ask pl_a: pow(m1, days_between(de, wl)) with wl = 2026-01-01
ask pl_b: pow(m1, days_between(de, wl)) with wl = 2026-01-02
ask pl_c: pow(m1, days_between(de, wl)) with wl = 2027-06-01
ask pl_cmp: pow(m1, days_between(de, wl)) > 0
ask dofh: day_of(mm, days_between(d1, w) / n2)
ask dofh_a: day_of(mm, days_between(d1, w) / n2) with w = 2026-03-10
ask dofh_b: day_of(mm, days_between(d1, w) / n2) with w = 2026-03-11
ask adh: add_days(d1, days_between(d1, w) / n2)
ask adh_b: add_days(d1, days_between(d1, w) / n2) with w = 2026-03-11
ask dvc: days_between(d1, w) / days_between(d0, w) > n100
ask dvc_a: days_between(d1, w) / days_between(d0, w) > n100 with w = 2026-03-10
ask dvc_b: days_between(d1, w) / days_between(d0, w) > n100 with w = 2026-03-11
ask dvc_c: days_between(d1, w) / days_between(d0, w) > n100 with w = 2026-03-12
ask dv1: n2 / days_between(d0, w) > n3
ask dv1_b: n2 / days_between(d0, w) > n3 with w = 2026-03-11
ask dve: n2 / days_between(w, d0 + 1 day)
ask dve_a: n2 / days_between(w, d0 + 1 day) with w = 2026-03-10
ask dve_c: n2 / days_between(w, d0 + 1 day) with w = 2026-03-12
ask dvw2: days_between(d1, w) / days_between(w, d0 + 1 day)
ask ovw: overlap_days(w, w, month_of(mar))
ask ovw_a: overlap_days(w, w, month_of(mar)) with w = 2026-03-10
ask dbw: days_between(w, w)
ask dbw_c: days_between(w, w) == 0
=== expect
adh: ?"date within window(2026-03-10, 2026-03-12) not precise enough for add_days" (w)
  unknown day: w
  cut 2026-01-01
adh_b: 2026-03-06
  pinned: w = 2026-03-11
  cut 2026-01-01
dbw: 0
  cut 2026-01-01
dbw_c: true
  cut 2026-01-01
dofh: ?"date within window(2026-03-10, 2026-03-12) not precise enough for day_of" (w)
  unknown day: w
  cut 2026-01-01
dofh_a: refused: RUN-NOT-INT 4.5 is not an integer
  pinned: w = 2026-03-10
  cut 2026-01-01
dofh_b: 2026-02-05
  pinned: w = 2026-03-11
  cut 2026-01-01
dv1: ?"date within window(2026-03-10, 2026-03-12) not precise enough for arithmetic" (w)
  unknown day: w
  cut 2026-01-01
dv1_b: refused: RUN-DIV division by zero
  pinned: w = 2026-03-11
  cut 2026-01-01
dvc: ?"date within window(2026-03-10, 2026-03-12) not precise enough for arithmetic" (w)
  unknown day: w
  cut 2026-01-01
dvc_a: false
  pinned: w = 2026-03-10
  cut 2026-01-01
dvc_b: refused: RUN-DIV division by zero
  pinned: w = 2026-03-11
  cut 2026-01-01
dvc_c: false
  pinned: w = 2026-03-12
  cut 2026-01-01
dve: ?"date within window(2026-03-10, 2026-03-12) not precise enough for arithmetic" (w)
  unknown day: w
  cut 2026-01-01
dve_a: 1
  pinned: w = 2026-03-10
  cut 2026-01-01
dve_c: refused: RUN-DIV division by zero
  pinned: w = 2026-03-12
  cut 2026-01-01
dvw2: ?"date within window(2026-03-10, 2026-03-12) not precise enough for arithmetic" (w)
  unknown day: w
  cut 2026-01-01
ovw: 1
  cut 2026-01-01
ovw_a: 1
  pinned: w = 2026-03-10
  cut 2026-01-01
pl: ?"date within window(2026-01-01, 2027-06-01) not precise enough for a print" (wl)
  unknown day: wl
  cut 2026-01-01
pl_a: 1
  pinned: wl = 2026-01-01
  cut 2026-01-01
pl_b: -1
  pinned: wl = 2026-01-02
  cut 2026-01-01
pl_c: 1
  pinned: wl = 2027-06-01
  cut 2026-01-01
pl_cmp: ?"date within window(2026-01-01, 2027-06-01) not precise enough for pow(m1, days_between(de, wl)) > 0" (wl)
  unknown day: wl
  cut 2026-01-01
r_agree: 0
  cut 2026-01-01
r_agree_a: 0
  pinned: w = 2026-03-10
  cut 2026-01-01
r_agree_b: 0
  pinned: w = 2026-03-11
  cut 2026-01-01
r_agree_c: 0
  pinned: w = 2026-03-12
  cut 2026-01-01
r_cmp: true
  cut 2026-01-01
r_cmp_a: true
  pinned: w = 2026-03-10
  cut 2026-01-01
r_cmp_c: true
  pinned: w = 2026-03-12
  cut 2026-01-01
r_ref: refused: RUN-DOMAIN round with a step 0 that is not positive
  cut 2026-01-01
r_ref_a: refused: RUN-DOMAIN round with a step 0 that is not positive
  pinned: w = 2026-03-10
  cut 2026-01-01
