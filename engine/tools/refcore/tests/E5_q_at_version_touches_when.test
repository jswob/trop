# E §5 step 1 under a `?` law date (tally 2.3, #247; P10, H2): version x states `go`, which pay's `when`
# names: x touches the instance's read set, so its adjustment is the hole, as under the window twin. Before:
# 0 (a `?` law date measured nothing the version changed).
=== m.tally
model b2dq
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
source s "s"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2026-01-01..
place sv: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input go: bool
input w: date
input dd: date
input de: date
move pay: transfers
  on dd
  at w
  when go
  leg cash from world to konto amount amt
move dec: transfers
  on de
  at w
  reads sv
  leg cash from sv to world amount min(bal(sv), amt)
version v
  cite s
  governs always
  known 2026-01-01
  w = ?"which law day?" "s"
  dd = 2026-03-10 "s"
  de = 2026-03-12 "s"
  go = true "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
  opening[sv] = 500.00 PLN at 2026-03-01 start "s"
version a0
  cite s
  governs 2026..
  known 2026-01-01
  amt = 100.00 PLN "s"
version x
  cite s
  governs always
  known 2026-03-20
  replace go = false "s"
ask n: count(a in adjustments over ..)
ask sm: sum(a.change for a in adjustments over ..)
ask ids: a.change for a in adjustments over ..
ask ids_p03: a.change for a in adjustments over .. with w = 2026-03-03
=== expect
ids (a = adjustments[pay.cash, x]): ?"which law day?" (w)
ids_p03 (a = adjustments[pay.cash, x]): -100.00 PLN
  pinned: w = 2026-03-03
  cut 2026-06-10
n: ?"which law day?" (w)
  cut 2026-06-10
sm: ?"which law day?" (w)
  cut 2026-06-10
