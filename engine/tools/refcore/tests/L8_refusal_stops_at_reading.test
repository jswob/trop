# L §8 Refusals outrank holes (tally 2.1.8 R11, #191 Q2): a refused movement is refused "exactly where a hole movement
# would be a hole, from the same day and up to the same reading: a place's balance after a later reading is what the
# reading states, its gap refused". groc[2026-02]'s amount divides by zero (RUN-DIV) and konto is anchored at 200.00
# PLN on 2026-03-10: before the reading konto is refused (a), after it 200.00 PLN, plain (b, c) and modelled (e) alike,
# and the gap is refused (d). The hole twin hm[2026-02] at k2 gives the same shape (h). 2.1.7's refcore kept konto
# refused after the reading (b, c).
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source bk "bank"
unit PLN: currency minor 0.01
input g_amt: money PLN
input dom: int
input divisor[m in months]: num
input hamt[m in months]: money PLN
place konto: accounts PLN lives 2019-05-01..
place k2: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..

move groc[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from konto to world amount round(g_amt * divisor[m] / divisor[m], minor(PLN), half-even)

move hm[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from k2 to world amount hamt[m]

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  g_amt = 50.00 PLN "plan"
  dom = 5 "plan"
  divisor[2026-01] = 1 "ok"
  divisor[2026-02] = 0 "zero"
  divisor[2026-03..2026-12] = 1 "ok"
  hamt[2026-01] = 1.00 PLN "ok"
  hamt[2026-02] = ?"how much in Feb" "hole"
  hamt[2026-03..2026-12] = 1.00 PLN "ok"
  opening[konto] = 10 000.00 PLN at 2026-01-01 start "w"
  opening[k2] = 10 000.00 PLN at 2026-01-01 start "w"

version st
  cite bk
  governs 2026-03
  known 2026-04-02
  anchor konto
  anchor k2
  stated[konto] = 200.00 PLN at 2026-03-10 end "saldo"
  stated[k2] = 200.00 PLN at 2026-03-10 end "saldo"

ask a: bal(konto, 2026-03-09)
ask b: bal(konto, 2026-03-10)
ask c: bal(konto, 2026-04-30)
ask d: gap(konto, 2026-03-10)
ask e: bal(konto, 2026-03-31) modelled
ask h: bal(k2, 2026-03-09), bal(k2, 2026-04-30), gap(k2, 2026-03-10)
=== expect
a: refused: RUN-DIV division by zero
  unfulfilled: groc[2026-01]
  unfulfilled: groc[2026-03]
  cut 2026-10-20
b: 200.00 PLN
  anchor: konto 2026-03-10 end, stated 200.00 PLN, difference refused: RUN-DIV division by zero
  cut 2026-10-20
c: 150.00 PLN
  anchor: konto 2026-03-10 end, stated 200.00 PLN, difference refused: RUN-DIV division by zero
  unfulfilled: groc[2026-04]
  cut 2026-10-20
d: refused: RUN-DIV division by zero
  unfulfilled: groc[2026-01]
  unfulfilled: groc[2026-03]
  cut 2026-10-20
e: 200.00 PLN
  cut 2026-10-20
h: (?"how much in Feb" (hamt[2026-02]), 199.00 PLN, ?"how much in Feb" (hamt[2026-02]))
  anchor: k2 2026-03-10 end, stated 200.00 PLN, difference ?"how much in Feb" (hamt[2026-02])
  unfulfilled: hm[2026-01]
  unfulfilled: hm[2026-02]
  unfulfilled: hm[2026-03]
  unfulfilled: hm[2026-04]
  cut 2026-10-20
warning: WARN-NEGATIVE konto is below zero from 2026-08-05
