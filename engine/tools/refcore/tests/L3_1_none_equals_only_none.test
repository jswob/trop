# tally 2.3.1 S7, N245.1, the critic's C-8 (L §3.1: none equals only none, x == v false, x != v true; any other
# comparison, membership included, RUN-NONE): q_eq, q_ne, q_cnt 1; q_in refused. Unchanged: a guard.
=== none_eq.tally
model none_eq
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "probe"
unit PLN: currency minor 0.01
index ks = [a, b, c]
index st = [single, married]
input status[k in ks]: key st
input lim[k in ks]: int
input five: int

ask q_eq: status[k] == married for k in ks
ask q_ne: status[k] != married for k in ks
ask q_cnt: count(k in ks where status[k] == married)
ask q_num: count(k in ks where lim[k] == five)
ask q_in: count(k in ks where status[k] in [married])

version v
  cite s
  governs always
  known 2026-01-01
  status[a] = married "s"
  status[b] = single "s"
  status[c] = none "s"
  lim[a] = 5 "s"
  lim[b] = 6 "s"
  lim[c] = none "s"
  five = 5 "s"
=== expect
q_cnt: 1
  cut 2026-06-30
q_eq (k = a): true
  cut 2026-06-30
q_eq (k = b): false
  cut 2026-06-30
q_eq (k = c): false
  cut 2026-06-30
q_in: refused: RUN-NONE a value is none here: a membership test
  cut 2026-06-30
q_ne (k = a): false
  cut 2026-06-30
q_ne (k = b): true
  cut 2026-06-30
q_ne (k = c): true
  cut 2026-06-30
q_num: 1
  cut 2026-06-30
