# tally 2.1.8 R14 (#173 SQ-3, P25 reopened), L §5.10: a unitless replace replaces every unit's reading at its
# instant, so a hole replacing EUR's reading loads and is the hole for PLN too.
=== m.tally
model t
  tally 2
  on 2026-06-10
  start 2026-01-01
  end 2026-06-30

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01
kind wallets: place any signed
place broker: wallets lives 2025-01-01..

version v1
  cite s
  governs always
  known 2026-01-01
  anchor broker
  opening[broker] = 1.00 EUR at 2026-01-01 start "s"
  opening[broker] = 2.00 PLN at 2026-01-01 start "s"
  stated[broker] = 4.00 EUR at 2026-02-15 end "s"


version v2
  cite s
  governs always
  known 2026-03-01
  anchor broker
  replace stated[broker] = ?"not read" at 2026-02-15 end "s"

ask a: bal(broker, EUR, 2026-02-20), bal(broker, PLN, 2026-02-20)
=== expect
a: (?"not read" (stated[broker]), ?"not read" (stated[broker]))
  anchor: broker 2026-02-15 end, stated ?"not read" (stated[broker]), difference ?"not read" (stated[broker])
  cut 2026-06-10
