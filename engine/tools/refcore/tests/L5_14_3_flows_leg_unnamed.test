# L §5.14.3: "a move whose kind has several legs names the leg, `flows(buy.eur, 2026)` (LOAD-LEG otherwise)": the
# bare move of a two-leg kind is refused at load.
=== m.tally
model t
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01

kind fx_buys: event certain
  leg eur: EUR
  leg cash: PLN

input buy_day: date
input eur_amt: money EUR
input pln_amt: money PLN

place konto: accounts PLN lives 2026-01-01..
place eurkonto: accounts EUR lives 2026-01-01..
place market: outside lives 1900-01-01..

move buy: fx_buys
  on buy_day
  leg eur from market to eurkonto amount eur_amt
  leg cash from konto to market amount pln_amt

version v
  cite s
  governs always
  known 2025-12-01
  buy_day = 2026-03-02
  eur_amt = 100.00 EUR
  pln_amt = 425.00 PLN
  opening[konto] = 1 000.00 PLN at 2026-01-01 start
  opening[eurkonto] = 0 EUR at 2026-01-01 start

ask q: flows(buy, 2026)
=== expect
refused: LOAD-LEG ...
