# E §6.3 matched (round 12): "an adjustment that observations settle, against its change δ on V.known". The model of
# L5_14_3_adjustment_name_observed.test: raise_2026 (known 2026-05-01) changes wage[2026-03] by δ = +500.00 PLN; bank[r1]
# (500.00 PLN into konto on 2026-05-15) settles adjustments[wage[2026-03].cash, raise_2026]: one matched line on
# 2026-05-01, model 500.00, observed 500.00, difference 0.00, timing +14 days, grouped by the adjusted move. The layout
# is this interpreter's. (Was REFCORE-UNSPECIFIED E §6.3, writer 5's T-103.)
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source act "act"
source bank_export "bank"
unit PLN: currency minor 0.01
kind wages: event certain
  leg cash: PLN
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
input wage_amt: money PLN
input wage_dom: int
input bank: observed
def net[m in months]: money PLN = wage_amt at start_of(m)

move wage[m in months]: wages
  on day_of(m, wage_dom)
  at start_of(m)
  leg cash from world to konto amount net[m]

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  wage_amt = 5 000.00 PLN "umowa"
  wage_dom = 10 "umowa"
  opening[konto] = 0 PLN at 2026-01-01 start "wyciąg"

version raise_2026
  cite act
  governs 2026-03
  known 2026-05-01
  replace wage_amt = 5 500.00 PLN "aneks"

version back_pay
  cite bank_export
  governs 2026-05
  known 2026-05-20
  covers konto 2026-05-15..2026-05-15
  bank[r1] = (on: 2026-05-15, kind: wages, leg cash from world to konto amount 500.00 PLN, fulfils: adjustments[wage[2026-03].cash, raise_2026]) "line 1"

ask led: residuals konto 2026-05
=== expect
led: residuals konto 2026-05
  2026-05 move wage: model 500.00 PLN, observed 500.00 PLN, difference 0.00 PLN
    matched adjustments[wage[2026-03].cash, raise_2026] on 2026-05-01: model 500.00 PLN, observed 500.00 PLN, difference 0.00 PLN, timing +14 days
  cut 2026-10-20
