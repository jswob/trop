# L §5.10 Value (round 7b): "`by p` names: an input or def of type `num CUR/u`, keyed by unit ... or an expression of
# that type written with its keys (`by etf_price[month_of(d)]`)"; L §2.3 valuex.  eurkonto holds 100.00 EUR from
# 2026-03-02; eur_px[2026-06] = 4.25 PLN/EUR, so value(eurkonto, 2026-06-30) in PLN = 100 x 4.25 = 425 PLN ("value
# multiplies exactly; nothing in it rounds"), from the ask (q1) and from a def keyed by days (q2).  q3: by a def
# keyed by unit (px_def[EUR] = 4.00 PLN/EUR): 400 PLN.  (Was LOAD-PARSE cannot parse: value(...) by a price input.)
=== m.tally
model t
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
unit EUR: currency minor 0.01

kind fx_buys: event certain
  leg eur: EUR
  leg cash: PLN

input eur_px[m in months]: num PLN/EUR
input base_px: num PLN/EUR
input buy_day: date
input eur_amt: money EUR
input pln_amt: money PLN

place konto: accounts PLN lives 2026-01-01..
place eurkonto: accounts EUR lives 2026-01-01..
place market: outside lives 1900-01-01..

def worth[d in days]: num PLN = value(eurkonto, d) in PLN by eur_px[month_of(d)] at d
def px_def[u in currencies]: num PLN/u = base_px

move buy: fx_buys
  on buy_day
  leg eur from market to eurkonto amount eur_amt
  leg cash from konto to market amount pln_amt

version v
  cite s
  governs always
  known 2025-12-01
  base_px = 4 PLN/EUR
  buy_day = 2026-03-02
  eur_amt = 100.00 EUR
  pln_amt = 425.00 PLN
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "wyciąg"
  opening[eurkonto] = 0 EUR at 2026-01-01 start "wyciąg"

version px
  cite s
  governs 2026..
  known 2025-12-01
  eur_px[2026-06] = 4.25 PLN/EUR

ask q1: value(eurkonto, 2026-06-30) in PLN by eur_px[2026-06]
ask q2: worth[2026-06-30]
ask q3: value(eurkonto, 2026-06-30) in PLN by px_def
=== expect
q1: 425 PLN
...
q2: 425 PLN
...
q3: 400 PLN
...
