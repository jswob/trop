  stated[konto] = 9 PLN at 2026-02-01 end "wyciąg"
  stated[konto] = 3 PLN at 2026-03-01 start "wyciąg"
  stated[konto] = 5 PLN at 2026-03-01 end "wyciąg"
sha256 ...
