# L §6.5 change 2 (a law change for the coming year), copied whole, over the base excerpt (as in L6_5_change1),
# with earlier rows of pit_free and pit_rate added, since the excerpt doesn't show them and replace needs an earlier
# row (L §4.6 step 2).  "Only the changed figures appear, each saying that it replaces the earlier row from 2028.
# Every other figure stays in force from its own version (§4.6)."
=== household.tally
model household
  tally 2
  on 2029-12-31
  start 2026-01-01
  end 2040-12-31

source household "the household's own records"
unit PLN: currency minor 0.01
index instalments = [equal, decreasing]
index overpay_choices = [shorter, lower]
index pit_brackets = [low, high]
index countries = [pl, de]

kind persons
kind jobs
kind loans

input loan_terms[l in loans]: (principal money PLN, months int, plan key instalments)
input overpay[l in loans, m in months]: (amount money PLN, choice key overpay_choices)
input parent[c in persons, k in persons]: bool
input pay_dom[j in jobs]: int
input pit_free: money PLN
input pit_rate[b in pit_brackets]: num
input residence[p in persons, m in months]: key countries
input salary[j in jobs, m in months]: money PLN question "Ile wynosi pensja brutto z tej pracy w tym miesiącu?"
input works_for[j in jobs]: key persons

version home_2026
  cite household
  governs 2026-10..
  known 2026-10-19
  persons + [ana] lives 1990-04-02..
  persons + [ben] lives 1988-11-30..
  jobs + [ana_acme] lives 2020-02-01..
  jobs + [ben_bolt] lives 2021-09-01..
  parent = false "brak dzieci"
  pay_dom = 10 "umowy o pracę, § 5"
  residence = pl "meldunek w Krakowie"
  works_for[ana_acme] = ana
  works_for[ben_bolt] = ben

version pit_2026_figures
  cite household
  governs 2026..
  known 2026-01-01
  pit_free = 30 000.00 PLN
  pit_rate[low] = 12 %
  pit_rate[high] = 32 %
=== change2.tally
part change2
  tally 2

source pit_2028 "Ustawa z 2027-11-20 o zmianie ustawy o PIT, Dz.U. 2027 poz. ..."

version pit_2028_figures
  cite pit_2028
  governs 2028..
  known 2027-11-20
  replace pit_free = 36 000.00 PLN "art. 1 pkt 3"
  replace pit_rate[low] = 11 % "art. 1 pkt 4"

ask q1: pit_free, pit_rate[low], pit_rate[high] law 2027-06-30
ask q2: pit_free, pit_rate[low], pit_rate[high] law 2028-06-30
=== expect q1 q2
q1: (30 000.00 PLN, 0.12, 0.32)
  law date 2027-06-30, cut 2029-12-31
q2: (36 000.00 PLN, 0.11, 0.32)
  law date 2028-06-30, cut 2029-12-31
