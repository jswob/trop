# L §5.13: "The weights must be >= 0 with Σw > 0; otherwise refused (RUN-WEIGHTS)".
=== m.tally
model t
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01

index parts = [a1, a2, a3]
input tot: money PLN
input w[j in parts]: num
input hm: rounding
def sn[j in parts]: money PLN = prorata(tot, w[i] for i in parts, j, minor(PLN), hm, rest none) at reader
def sl[j in parts]: money PLN = prorata(tot, w[i] for i in parts, j, minor(PLN), hm, rest last) at reader
def sg[j in parts]: money PLN = prorata(tot, w[i] for i in parts, j, minor(PLN), rest largest ties by pos(i)) at reader
def sx[j in parts]: money PLN = prorata(tot, w[i] for i in parts, j, minor(PLN), rest largest) at reader
def sw[j in parts]: money PLN = prorata(tot, w[i] for i in parts, j, 1 PLN, rest largest) at reader

version v
  cite s
  governs 2026..
  known 2026-01-01
  tot = 100.00 PLN
  w[a1] = 0
  w[a2] = 0
  w[a3] = 0
  hm = half-even

ask a: sn[a1] law 2026-06-30
=== expect
a: refused: RUN-WEIGHTS ...
  law date 2026-06-30, cut 2026-12-31
