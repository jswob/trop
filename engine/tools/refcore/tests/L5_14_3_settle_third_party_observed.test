# E §5 step 5 (round 12): a settlement leg counts "-amount when it runs the other way, out of its to or into its from
# (a clawback paid to a third party)". raise_2026 cuts March's wage to 4 500.00 PLN: δ = -500.00 PLN on the leg world ->
# konto. The bank row pays 500.00 PLN from konto to zus, out of the adjusted leg's `to`: it counts -500.00, the
# remainder is -500 - (-500) = 0, so no HOLE-CHANGED and no adjustment: line (L §5.14.3). konto at 2026-05-31: five
# wages of 5 000.00 less 500.00. (Was REFCORE-UNSPECIFIED §5.14.3, writer 5's T-67.)
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source act "act"
source bank_export "bank"
unit PLN: currency minor 0.01
kind wages: event certain
  leg cash: PLN
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
place zus: outside lives 1900-01-01..
place savings: accounts PLN lives 2019-05-01..
input wage_amt: money PLN
input wage_dom: int
input bank: observed
def net[m in months]: money PLN = wage_amt at start_of(m)

move wage[m in months]: wages
  on day_of(m, wage_dom)
  at start_of(m)
  leg cash from world to konto amount net[m]

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  wage_amt = 5 000.00 PLN "umowa"
  wage_dom = 10 "umowa"
  opening[konto] = 0 PLN at 2026-01-01 start "wyciąg"

version raise_2026
  cite act
  governs 2026-03
  known 2026-05-01
  replace wage_amt = 4 500.00 PLN "aneks"

version back_pay
  cite bank_export
  governs 2026-05
  known 2026-05-20
  covers konto 2026-05-15..2026-05-15
  bank[r1] = (on: 2026-05-15, kind: wages, leg cash from konto to zus amount 500.00 PLN, fulfils: adjustments[wage[2026-03].cash, raise_2026]) "line 1"

ask a: bal(konto, 2026-05-31)
ask c: count(x in adjustments over 2026), sum(x.change for x in adjustments over 2026)
ask d: flows(konto, 2026-05)
=== expect
a: 24 500.00 PLN
  unfulfilled: wage[2026-01]
  unfulfilled: wage[2026-02]
  unfulfilled: wage[2026-03]
  unfulfilled: wage[2026-04]
  unfulfilled: wage[2026-05]
  cut 2026-10-20
c: (1, -500.00 PLN)
  cut 2026-10-20
d: 4 500.00 PLN
  unfulfilled: wage[2026-05]
  cut 2026-10-20
