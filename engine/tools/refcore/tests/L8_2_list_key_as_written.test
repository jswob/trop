# tally 2.2.1 (#207, 207.4), L §8.2 `unfulfilled: <move>[keys]`, a key as written (2.1.7's R9): ml[1.5]. tally 2.2
# printed the interpreter's object (T's m2/fixes/p60/num_list_key.tally).
=== nl.tally
model pw
  tally 2
  on 2026-04-25
  start 2026-01-01
  end 2026-12-31
  note "T, M2 P60 (G6's census of run-time stops): walk/tuples.rs:403, a move keyed by a list of numbers not integers"

source s "s"
unit PLN: currency minor 0.01
place sav: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input dm: date

move ml[x in [1.5, 2]]: transfers
  on dm
  leg cash from world to sav amount amt

version v
  cite s
  governs always
  known 2026-01-01
  amt = 10.00 PLN "s"
  dm = 2026-03-31 "s"
  opening[sav] = 0.00 PLN at 2026-01-01 start "s"

ask q: bal(sav, 2026-06-30)
=== expect
q: 20.00 PLN
  unfulfilled: ml[1.5]
  unfulfilled: ml[2]
  cut 2026-04-25
