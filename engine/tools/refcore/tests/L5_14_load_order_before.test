# L §5.14.2: "An order that contradicts a read of m's legs is refused (LOAD-ORDER)": up reads down's legs and states
# before down.
# Own reality: konto opens at 5 000.00 PLN, savings at 0.
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source bank "bank"
unit PLN: currency minor 0.01
input bank_rows: observed
input amt: money PLN
input dom: int
place konto: accounts PLN lives 2019-05-01..
place savings: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..

move down[d in days]: transfers
  on d
  reads savings
  leg cash from savings to konto amount max(0 PLN, -bal(savings))

move up[d in days]: transfers
  on d
  reads down
  before down
  leg cash from konto to savings amount down[d].cash.amount

ask q: bal(savings, 2026-03-31)

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  amt = 1 000.00 PLN "own"
  dom = 5 "own"
  opening[konto] = 5 000.00 PLN at 2026-01-01 start "wyciąg"
  opening[savings] = 0 PLN at 2026-01-01 start "wyciąg"
=== expect
refused: LOAD-ORDER ...
