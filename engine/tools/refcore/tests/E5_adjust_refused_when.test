# E §5 step 3 (tally 2.1.2, issue #34, the user's "A: the refusal spreads"): late (known 2026-05-01) re-measures
# rent[2026-03]'s when at 0 seats, so the instance is refused at that cut (RUN-DIV), and its adjustment with it: q's reads
# reaching 2026-05-01 are refused; reads before stand. tally 2.1.1's refcore skipped the step: q was (500.00 PLN,
# 7 000.00 PLN).
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source act "act"
unit PLN: currency minor 0.01
place konto: accounts PLN lives 2019-05-01..
place landlord: outside lives 1900-01-01..
input total: money PLN
input tenants[m in months]: int
input dom: int
input seats[m in months]: int

move rent[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  when dom / seats[m] > 0
  leg cash from konto to landlord amount round(total / tenants[m], minor(PLN), half-even)

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  total = 1 000.00 PLN "umowa"
  dom = 10 "umowa"
  tenants[*] = 2 "umowa"
  seats[*] = 1 "umowa"
  opening[konto] = 10 000.00 PLN at 2026-01-01 start "wyciąg"

version late
  cite act
  governs 2026-03
  known 2026-05-01
  replace seats[*] = 0 "aneks"

ask before: bal(konto, 2026-04-30)
ask q: flows(rent, 2026-05-01 .. 2026-05-31), bal(konto, 2026-06-30)
ask early: flows(rent, 2026-03-01 .. 2026-04-30)
=== expect
before: 8 000.00 PLN
  unfulfilled: rent[2026-01]
  unfulfilled: rent[2026-02]
  unfulfilled: rent[2026-03]
  unfulfilled: rent[2026-04]
  cut 2026-10-20
early: 1 000.00 PLN
  unfulfilled: rent[2026-03]
  unfulfilled: rent[2026-04]
  cut 2026-10-20
q: (refused: RUN-DIV division by zero, refused: RUN-DIV division by zero)
  unfulfilled: rent[2026-01]
  unfulfilled: rent[2026-02]
  unfulfilled: rent[2026-03]
  unfulfilled: rent[2026-04]
  unfulfilled: rent[2026-05]
  unfulfilled: rent[2026-06]
  cut 2026-10-20
