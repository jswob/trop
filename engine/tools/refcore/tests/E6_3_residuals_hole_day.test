# E §6.3 Grouping (round 12): "An instance that nothing fulfils whose day is a hole, or a window not inside one month,
# prints an expected-but-missing line in a group of its own named ?, first among the groups, with its day's questions;
# it counts in no month's totals"; balance: "a hole when the booked balance is one". E6_3_residuals.test's model plus
# bonus (700.00 PLN into konto) on bonus_day, a stated hole: the ? group comes first with the line on the day's
# question, model 700.00 PLN, difference -700.00 PLN (an expected but missing line's is - model); February's balance
# line is a hole. The layout is this interpreter's. (Was REFCORE-UNSPECIFIED E §6.3, writer 5's T-102.)
=== m.tally
model hh
  tally 2
  on 2026-10-20
  start 2026-01-01
  end 2026-12-31

source plan "plan"
source bank_2026_02 "bank"
source bank_2026_03 "bank"
unit PLN: currency minor 0.01
kind wages: event certain
  leg cash: PLN
kind groceries: transfers
  attr payee: text
input bank: observed
input wage_amt: money PLN
input rent_amt: money PLN
input wage_dom: int
input rent_dom: int
input bonus_day: date
input bonus_amt: money PLN
place konto: accounts PLN lives 2019-05-01..
place landlord: outside lives 1900-01-01..
place world: outside lives 1900-01-01..
place unexplained: outside lives 1900-01-01..

move wage[m in months]: wages
  on day_of(m, wage_dom)
  at start_of(m)
  leg cash from world to konto amount wage_amt

move bonus: transfers
  on bonus_day
  leg cash from world to konto amount bonus_amt

move rent[m in months]: transfers
  on day_of(m, rent_dom)
  at start_of(m)
  leg cash from konto to landlord amount rent_amt

version plan_2026
  cite plan
  governs 2026..
  known 2026-01-01
  wage_amt = 5 000.00 PLN "umowa"
  rent_amt = 2 000.00 PLN "umowa najmu"
  wage_dom = 10 "umowa"
  rent_dom = 3 "umowa najmu"
  opening[konto] = 10 000.00 PLN at 2026-01-01 start "wyciąg"

version bonus_terms
  cite plan
  governs always
  known 2026-01-01
  bonus_amt = 700.00 PLN "umowa"
  bonus_day = ?"which day is the bonus paid?" "umowa"

version statement_02
  cite bank_2026_02
  governs 2026-02
  known 2026-03-02
  covers konto
  pad konto from unexplained
  bank[r1] = (on: 2026-02-03, kind: transfers, leg cash from konto to landlord amount 2 000.00 PLN, fulfils: rent[2026-02]) "line 1"
  bank[r2] = (on: 2026-02-12, kind: wages, leg cash from world to konto amount 5 300.00 PLN, fulfils: wage[2026-02]) "line 2"
  bank[r3] = (on: 2026-02-20, kind: groceries, leg cash from konto to world amount 400.00 PLN, payee: "BIEDRONKA") "line 3"
  stated[konto] = 15 800.00 PLN at 2026-02-28 end "saldo"

version statement_03
  cite bank_2026_03
  governs 2026-03
  known 2026-04-02
  covers konto
  pad konto from unexplained
  bank[r4] = (on: 2026-03-03, kind: transfers, leg cash from konto to landlord amount 2 000.00 PLN, fulfils: rent[2026-03]) "line 4"
  stated[konto] = 13 800.00 PLN at 2026-03-31 end "saldo"

ask led: residuals konto 2026-02
=== expect
led: residuals konto 2026-02
  ?: model 700.00 PLN, observed 0.00 PLN, difference -700.00 PLN
    expected but missing bonus on ?"which day is the bonus paid?" (bonus_day): model 700.00 PLN
  2026-02 balance: model ? ...
    balance konto 2026-02-28 end (padded): booked ? ...
  2026-02 unexplained: model 0.00 PLN, observed -400.00 PLN, difference -400.00 PLN
    unexplained bank[r3] on 2026-02-20: observed -400.00 PLN
  2026-02 move wage: model 5 000.00 PLN, observed 5 300.00 PLN, difference 300.00 PLN
    matched wage[2026-02] on 2026-02-10: model 5 000.00 PLN, observed 5 300.00 PLN, difference 300.00 PLN, timing +2 days
  2026-02 move rent: model -2 000.00 PLN, observed -2 000.00 PLN, difference 0.00 PLN
    matched rent[2026-02] on 2026-02-03: model -2 000.00 PLN, observed -2 000.00 PLN, difference 0.00 PLN, timing +0 days
  cut 2026-10-20
