# tally 2.1.8 §4 (#169-e), L §4.4 and L §4.3: moves whose at is a window crossing a law change on 2026-04-01 are
# evaluated once per law-date class, and each part of the body is decided only where every class agrees: md's for
# differs (flows by for is the hole), mk2's binding where differs (q is bound on one side only: the hole), mq's and
# mk's agree. 2.1.7's refcore compared the legs alone and read for, the attributes and the where at the first class.
# T's fixes/gate8/at_window_mk2.
=== m.tally
model at_window_mk2
  tally 2
  on 2026-08-01
  start 2026-01-01
  end 2026-12-31

source s "s"

unit PLN: currency minor 0.01

index ks = [p, q]

place konto: accounts PLN lives 2026-01-01..

place jar[k in ks]: accounts PLN lives 2026-01-01..

place world: outside lives 1900-01-01..

input wl: date

input pq: date

input pf: date

input aq: money PLN

input on_off[k in ks]: int

input on2[k in ks]: int

input rank[k in ks]: int

input rank2[k in ks]: int

input a1: money PLN

move mq: transfers
  on pq
  at wl
  leg cash from world to konto amount aq

move md: transfers
  on pq
  at wl
  for month_of(pf)
  leg cash from world to konto amount a1

move mk[k in ks where on_off[k] > 0]: transfers
  on pq
  at wl
  leg cash from world to jar[k] amount a1

move mk2[k in ks where on2[k] > 0]: transfers
  on pq
  at wl
  leg cash from world to jar[k] amount a1

move ta[k in ks]: transfers
  on pq
  at wl
  reads jar
  ties by rank[k]
  leg cash from world to jar[k] amount max(a1, bal(jar[k]))

ask f_mq: flows(mq, 2026-04-01 .. 2026-04-30)
ask f_md: flows(md, 2026-04-01 .. 2026-04-30)
ask f_mk: flows(mk, 2026-04-01 .. 2026-04-30)
ask f_mk2: flows(mk2, 2026-04-01 .. 2026-04-30)
ask f_ta: flows(ta, 2026-04-01 .. 2026-04-30)

version v
  cite s
  governs always
  known 2026-01-01
  wl = window(2026-03-30, 2026-04-02) "s"
  a1 = 1.00 PLN "s"
  opening[konto] = 0.00 PLN at 2026-01-01 start "s"
  opening[jar[p]] = 0.00 PLN at 2026-01-01 start "s"
  opening[jar[q]] = 0.00 PLN at 2026-01-01 start "s"

version old
  cite s
  governs 2026-01-01..2026-03-31
  known 2026-01-01
  pq = 2026-04-10 "s"
  pf = 2026-03-15 "s"
  aq = 5.00 PLN "s"
  on_off[p] = 1 "s"
  on_off[q] = 0 "s"
  on2[p] = 1 "s"
  on2[q] = 0 "s"
  rank[p] = 1 "s"
  rank[q] = 2 "s"
  rank2[p] = 1 "s"
  rank2[q] = 2 "s"

version new
  cite s
  governs 2026-04-01..
  known 2026-01-01
  pq = 2026-04-10 "s"
  pf = 2026-04-15 "s"
  aq = 5.00 PLN "s"
  on_off[p] = 1 "s"
  on_off[q] = 0 "s"
  on2[p] = 1 "s"
  on2[q] = 1 "s"
  rank[p] = 1 "s"
  rank[q] = 2 "s"
  rank2[p] = 2 "s"
  rank2[q] = 1 "s"
=== expect
f_md: 1.00 PLN
  unfulfilled: md
  cut 2026-08-01
f_mk: 1.00 PLN
  unfulfilled: mk[p]
  cut 2026-08-01
f_mk2: ?"date within window(2026-03-30, 2026-04-02) not precise enough for the law date of mk2" (mk2)
  unknown day: wl
  unfulfilled: mk2[p]
  cut 2026-08-01
f_mq: 5.00 PLN
  unfulfilled: mq
  cut 2026-08-01
f_ta: ?"date within window(2026-03-30, 2026-04-02) not precise enough for the law date of mk2" (mk2)
  unknown day: wl
  unfulfilled: mk2[p]
  unfulfilled: mk[p]
  unfulfilled: ta[p]
  unfulfilled: ta[q]
  cut 2026-08-01
warning: WARN-UNREAD input rank2 is read by nothing
