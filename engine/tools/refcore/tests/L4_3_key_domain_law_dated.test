# tally 2.2.1, L §4.3 as it stands (§3's law-date rows):
# 235.1 (P28): a key's on reads law-dated act_day before the at, which reads that key: LOAD-LAWDATE at load
# (m3/fixes/lawdate/b3_mean). tally 2.2: the interpreter guard at run.
=== options exit=1
=== b3_mean.tally
model m
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source plan "p"

unit PLN: currency minor 0.01

index month = month 2026-01..2026-12

kind rents: event certain
  leg cash: PLN

place konto: accounts PLN lives 2026-01-01..

place landlord: outside lives 1900-01-01..

input rent_amt: money PLN

input back_amt: money PLN

input act_day: date

input d0: date

input d1: date

input one: num

move rent[m in months]: rents
  on start_of(m)
  at start_of(m)
  leg cash from konto to landlord amount rent_amt

move back[a in adjustments on if mean(one for k in month where start_of(k) <= act_day) > 0 then d0 else d1 where a.adjusts in rents]: transfers
  on act_day
  at a.day
  leg cash from konto to landlord amount back_amt
  fulfils a

version v
  cite plan
  governs 2026..
  known 2026-01-01
  rent_amt = 900.00 PLN
  back_amt = 100.00 PLN

version day
  cite plan
  governs 2026..
  known 2026-01-01
  act_day = 2026-04-05

ask q: bal(konto, 2026-04-30) law cut

version fx
  cite plan
  governs always
  known 2026-01-01
  d0 = 2026-03-15
  d1 = 2026-03-16
  one = 1
=== expect
refused: LOAD-LAWDATE move back's key a reads law-dated act_day with no law date: its at reads a (b3_mean.tally:37)
