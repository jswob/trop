# tally 2.1.8 R16 (#183), L §5.14.1, E §4.3 step 2: a decision dated before t is computed in the walk the
# projection continues, and its leg dated in the window is counted there by its own day: 100.00 DUK, as the plain
# balance.
=== m.tally
model p
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31

source s "s"
unit DUK: currency minor 0.01
place konto: accounts DUK lives 2026-01-01..
place world: outside lives 2026-01-01..
input amt: money DUK
input mday: date
input nday: date
input lday: date

move late: transfers
  on mday
  leg cash from world to konto amount amt on lday

move early: transfers
  on nday
  reads konto
  leg cash from world to konto amount amt + 0 * bal(konto) on lday

version v
  cite s
  governs always
  known 2026-01-01
  opening[konto] = 0.00 DUK at 2026-01-01 start "s"
  amt = 50.00 DUK "s"
  mday = 2026-06-01 "s"
  nday = 2026-01-15 "s"
  lday = 2026-03-01 "s"

ask b: bal(konto, 2026-04-30)
ask p: bal(konto, 2026-04-30) from 2026-02-01
ask lo: low(konto, 2026-03-01 .. 2026-04-30) from 2026-02-01
=== expect
b: 100.00 DUK
  cut 2026-01-01
lo: 100.00 DUK
  cut 2026-01-01
p: 100.00 DUK
  cut 2026-01-01
