# tally 2.3.1 R2 item 6 for a binding over a kind (G2's review finding 4): January's link reads go only to the
# readers whose span holds January (a, c), not to March's sum (sm) or the counts (n, nr). Before: sm, n and nr
# held `assumed: jan is a guess`.
=== first_bind.tally
model first
  tally 2
  on 2026-05-20
  start 2026-01-01
  end 2026-06-30

source s "invented values"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-06
place pot: accounts PLN lives 2026-01-01..
place landlord: outside lives 1900-01-01..
input bank: observed
input rent_amt: money PLN
input ok[m in month]: bool
input d5: int

move rent[m in month]: transfers
  on day_of(m, d5)
  at start_of(m)
  when ok[m]
  leg cash from pot to landlord amount rent_amt

ask a: flows(rent, 2026-01)
ask b: flows(rent, 2026-03)
ask c: bal(pot, 2026-03-31)
ask n: count(t in transfers over 2026-02 .. 2026-03)
ask sm: sum(t.cash.amount for t in transfers over 2026-03)
ask nr: count(t in transfers over 2026-03 where t.cash.amount > 0.00 PLN)

version v
  cite s
  governs always
  known 2026-01-01
  rent_amt = 100.00 PLN "s"
  d5 = 5 "s"
  ok[2026-01] = true assumed "jan is a guess" "ok jan"
  ok[2026-02] = true "ok feb"
  ok[2026-03] = true "ok mar"
  ok[2026-04] = true "ok apr"
  ok[2026-05] = true "ok may"
  ok[2026-06] = true "ok jun"
  opening[pot] = 9000.00 PLN at 2026-01-01 start "s"

version jan
  cite s
  governs 2026-01
  known 2026-01-21
  covers pot
  bank[a1] = (on: 2026-01-05, kind: transfers, leg cash from pot to landlord amount 100.00 PLN, fulfils: rent[2026-01]) "names jan"
=== expect
a: 100.00 PLN
  assumed: jan is a guess (ok[2026-01])
  cut 2026-05-20
b: 100.00 PLN
  unfulfilled: rent[2026-03]
  cut 2026-05-20
c: 8 700.00 PLN
  assumed: jan is a guess (ok[2026-01])
  unfulfilled: rent[2026-02]
  unfulfilled: rent[2026-03]
  cut 2026-05-20
n: 2
  unfulfilled: rent[2026-02]
  unfulfilled: rent[2026-03]
  cut 2026-05-20
nr: 1
  unfulfilled: rent[2026-03]
  cut 2026-05-20
sm: 100.00 PLN
  unfulfilled: rent[2026-03]
  cut 2026-05-20
