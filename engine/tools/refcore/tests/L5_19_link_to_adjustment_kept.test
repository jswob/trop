# tally 2.3.1 rulings 22 (4; L §5.14.3): a link to an adjustment stays §5.14.3's: one naming an adjustment no
# version made by the cut is RUN-RECORD (c), its move's flows the HOLE-CHANGED hole (fa), o.fulfils none (n 0).
# The critic's P1-C3. A guard: unchanged.
=== a1_adj_none.tally
model a1
  tally 2
  on 2026-05-20
  start 2026-01-01
  end 2026-06-30

source s "invented values"
unit PLN: currency minor 0.01
index month = month 2026-01..2026-06
place pot: accounts PLN lives 2026-01-01..
place pot2: accounts PLN lives 2026-01-01..
place landlord: outside lives 1900-01-01..
place world2: outside lives 1900-01-01..
input bank: observed
input rent_amt: money PLN
input d5: int

move rent[m in month]: transfers
  on day_of(m, d5)
  at start_of(m)
  leg cash from pot to landlord amount rent_amt

ask c: bal(pot, 2026-03-31)
ask c2: bal(pot2, 2026-03-31)
ask a: flows(rent, 2026-01)
ask f3: flows(rent, 2026-03)
ask fa: flows(rent, 2026-01-01..2026-03-31)
ask n: count(o in bank over 2026-03 where o.fulfils != none)
ask rs: residuals pot 2026-03

version v
  cite s
  governs always
  known 2026-01-01
  rent_amt = 100.00 PLN "s"
  d5 = 5 "s"
  opening[pot] = 9000.00 PLN at 2026-01-01 start "s"
  opening[pot2] = 500.00 PLN at 2026-01-01 start "s"

version v2
  cite s
  governs always
  known 2026-02-01
  replace rent_amt = 50.00 PLN "s"

version mar
  cite s
  governs 2026-03
  known 2026-04-01
  covers pot2
  bank[a1] = (on: 2026-03-10, kind: transfers, leg cash from landlord to pot amount 50.00 PLN, fulfils: adjustments[rent[2026-03].cash, v2]) "refund"
=== expect
a: 100.00 PLN
  unfulfilled: rent[2026-01]
  cut 2026-05-20
c: refused: RUN-RECORD bank[a1] fulfils adjustments[rent[2026-03].cash, v2], which no version made by the cut
  adjustment: rent[2026-01] by -50.00 PLN on 2026-02-01 (version v2), remaining -50.00 PLN
  unfulfilled: rent[2026-01]
  unfulfilled: rent[2026-02]
  unfulfilled: rent[2026-03]
  cut 2026-05-20
c2: 500.00 PLN
  cut 2026-05-20
f3: ?"rent[2026-01] on 2026-01-05 changed after it was paid (version v2); is back pay due, and when?" (rent[2026-01])
  unfulfilled: rent[2026-03]
  cut 2026-05-20
fa: ?"rent[2026-01] on 2026-01-05 changed after it was paid (version v2); is back pay due, and when?" (rent[2026-01])
  unfulfilled: rent[2026-01]
  unfulfilled: rent[2026-02]
  unfulfilled: rent[2026-03]
  cut 2026-05-20
n: 0
  cut 2026-05-20
rs: residuals pot 2026-03
  2026-03 unexplained: model 0.00 PLN, observed 50.00 PLN, difference 50.00 PLN
    unexplained bank[a1] on 2026-03-10: observed 50.00 PLN
  cut 2026-05-20
