  end 2026-12-31

source s "s"
index ks = [ka, kb]
input w[k in ks]: num
def draw: dist = discrete(w[k] for k in ks) at reader

version v
  cite s
  governs 2026..
  known 2026-01-01
  w[ka] = 1
  w[kb] = 1

ask a: share(draw == ka) + paths() law 2026-06-30 paths 4 seed 1
