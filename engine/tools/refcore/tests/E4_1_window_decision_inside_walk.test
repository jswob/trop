# tally 2.2.1 P41, the fix review's F5 (E §4.1 step 2): flows of a window-dated decision read inside a walk is
# HOLE-IMPRECISE naming the window, never 0 (review g1fix n3_walk). Before W8: b2 500.00 PLN.
=== n3_walk.tally
model n3
  tally 2
  on 2026-06-10
  start 2026-03-01
  end 2026-06-30
source s "s"
unit PLN: currency minor 0.01
index qs = 1..2
place konto: accounts PLN lives 2026-01-01..
place konto2: accounts PLN lives 2026-01-01..
place world: outside lives 1900-01-01..
input amt: money PLN
input w: date
input w3: date
input dy_day: date
input sp45: month
input sp45b: month
version v
  cite s
  governs always
  known 2026-01-01
  amt = 100.00 PLN "s"
  w = window(2026-04-29, 2026-05-02) "s"
  w3 = window(2026-04-10, 2026-04-12) "s"
  dy_day = 2026-06-05 "s"
  sp45 = 2026-04 "s"
  sp45b = 2026-05 "s"
  opening[konto] = 500.00 PLN at 2026-03-01 start "s"
  opening[konto2] = 500.00 PLN at 2026-03-01 start "s"
move dx: transfers
  on w
  reads konto
  leg cash from world to konto amount if bal(konto) > 0 PLN then amt else amt
move dy: transfers
  on dy_day
  reads konto2, dx
  leg cash from world to konto2 amount if bal(konto2) > 0 PLN then flows(dx, sp45 .. sp45b) else amt
ask b2: bal(konto2, 2026-06-30)
ask b2_p29: bal(konto2, 2026-06-30) with w = 2026-04-29
ask b2_p02: bal(konto2, 2026-06-30) with w = 2026-05-02
ask fy: flows(dy, 2026-06)
ask cnt: count(m in transfers over 2026-06)
=== expect b2 b2_p02 b2_p29
b2: ?"date within window(2026-04-29, 2026-05-02) not precise enough for flows of dx" (w)
  unknown day: w
  unfulfilled: dy
  cut 2026-06-10
b2_p02: 600.00 PLN
  pinned: w = 2026-05-02
  unfulfilled: dx
  unfulfilled: dy
  cut 2026-06-10
b2_p29: 600.00 PLN
  pinned: w = 2026-04-29
  unfulfilled: dx
  unfulfilled: dy
  cut 2026-06-10
warning: WARN-UNREAD input w3 is read by nothing
