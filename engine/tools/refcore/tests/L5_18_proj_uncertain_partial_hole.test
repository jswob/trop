# tally 2.1.8 R15, L §5.18, §5.14 (B3 of group 3's review, agent/t8): a projection with uncertain partial whose
# value holds a hole (gift[2026-03]) keeps the uncertain repayments (2 x 500.00 from 02-15 to 04-30) in its known
# part: a 2 030.00 PLN + 1 x the hole; d, without uncertain, 1 030.00 PLN + 1 x the hole. bc289ba5 printed a as d.
=== m.tally
model u
  tally 2
  on 2026-01-01
  start 2026-01-01
  end 2026-12-31

source own "own"
unit PLN: currency minor 0.01
kind promises: event uncertain
  leg cash: PLN
kind gifts: event certain
  leg cash: PLN
place konto: accounts PLN lives 2020-01-01..
place friend: outside lives 1900-01-01..
input owed[m in months]: money PLN
input repay_dom: int
input gift[m in months]: money PLN

move repay[m in months]: promises
  on day_of(m, repay_dom)
  at start_of(m)
  leg cash from friend to konto amount owed[m]

move g[m in months]: gifts
  on day_of(m, repay_dom)
  at start_of(m)
  leg cash from friend to konto amount gift[m]

version v
  cite own
  governs 2026..
  known 2026-01-01
  owed = 500.00 PLN "note"
  repay_dom = 1 "note"
  gift = 10.00 PLN "note"
  gift[2026-03] = ?"gift in march" "note"
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "statement"

ask a: bal(konto, 2026-04-30) from 2026-02-15 with uncertain partial
ask b: bal(konto, 2026-04-30) with uncertain partial
ask c: bal(konto, 2026-04-30) from 2026-02-15 with uncertain
ask d: bal(konto, 2026-04-30) from 2026-02-15 partial
=== expect
a: 2 030.00 PLN + 1 × ?"gift in march" (gift[2026-03])
  uncertain: repay[2026-03]
  uncertain: repay[2026-04]
  held: gift[2026-02] = 10.00 PLN (v), read for 2026-02
  held: gift[2026-04] = 10.00 PLN (v), read for 2026-04
  held: owed[2026-03] = 500.00 PLN (v), read for 2026-03
  held: owed[2026-04] = 500.00 PLN (v), read for 2026-04
  held: repay_dom = 1 (v), read for 2026-02-01
  held: repay_dom = 1 (v), read for 2026-03-01
  held: repay_dom = 1 (v), read for 2026-04-01
  cut 2026-01-01
b: 3 030.00 PLN + 1 × ?"gift in march" (gift[2026-03])
  uncertain: repay[2026-01]
  uncertain: repay[2026-02]
  uncertain: repay[2026-03]
  uncertain: repay[2026-04]
  held: gift[2026-02] = 10.00 PLN (v), read for 2026-02
  held: gift[2026-04] = 10.00 PLN (v), read for 2026-04
  held: owed[2026-02] = 500.00 PLN (v), read for 2026-02
  held: owed[2026-03] = 500.00 PLN (v), read for 2026-03
  held: owed[2026-04] = 500.00 PLN (v), read for 2026-04
  held: repay_dom = 1 (v), read for 2026-02-01
  held: repay_dom = 1 (v), read for 2026-03-01
  held: repay_dom = 1 (v), read for 2026-04-01
  cut 2026-01-01
c: ?"gift in march" (gift[2026-03])
  held: gift[2026-02] = 10.00 PLN (v), read for 2026-02
  held: gift[2026-04] = 10.00 PLN (v), read for 2026-04
  held: repay_dom = 1 (v), read for 2026-02-01
  held: repay_dom = 1 (v), read for 2026-03-01
  held: repay_dom = 1 (v), read for 2026-04-01
  cut 2026-01-01
d: 1 030.00 PLN + 1 × ?"gift in march" (gift[2026-03])
  held: gift[2026-02] = 10.00 PLN (v), read for 2026-02
  held: gift[2026-04] = 10.00 PLN (v), read for 2026-04
  held: repay_dom = 1 (v), read for 2026-02-01
  held: repay_dom = 1 (v), read for 2026-03-01
  held: repay_dom = 1 (v), read for 2026-04-01
  cut 2026-01-01
