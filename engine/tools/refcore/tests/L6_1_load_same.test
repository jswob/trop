# L §6.1: "Two places of which neither is outside must be of one kind (LOAD-SAME)"; L §8.3 LOAD-SAME "same <p> = <q>:
# places of kinds <K> and <K'>". a.wsp is an account, b.wsp cash.
=== options pin=bytes
=== joint.tally
model family
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31
  use a = "ana.tally" sha256 "e438b0e9e801813f005290db20ae57dbafcfc06810324f3ba998080e5c2db6c3"
  use b = "ben3.tally" sha256 "26ed9b077ac6f610878868d7e2ad32a9260915247efaa09bb3c32b6db05a9e09"
  same a.wsp = b.wsp

ask w: bal(a.wsp, 2026-06-01)
ask t: sum(bal(p, 2026-06-01) for p in accounts on 2026-06-01)
=== ana.tally
model ana
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
kind persons
place wsp: accounts PLN lives 2019-01-01..
input income[p in persons]: money PLN

version v
  cite s
  governs always
  known 2025-12-01
  persons + [ana, ola] lives 2000-01-01..
  income[ana] = 100.00 PLN "umowa"
  income[ola] = 10.00 PLN "umowa"
  opening[wsp] = 1 000.00 PLN at 2026-01-01 start "wyciąg"
=== ben3.tally
model ben
  tally 2
  on 2026-01-05
  start 2026-01-01
  end 2026-12-31

source s "umowa"
unit PLN: currency minor 0.01
kind persons
place wsp: cash PLN lives 2019-01-01..
input pocket[p in persons]: money PLN

version v
  cite s
  governs always
  known 2025-12-01
  persons + [ben, ola_k] lives 2000-01-01..
  pocket[ben] = 50.00 PLN "umowa"
  pocket[ola_k] = 5.00 PLN "umowa"
  opening[wsp] = 1 000.00 PLN at 2026-01-01 start "wyciąg"
=== expect
refused: LOAD-SAME same a.wsp = b.wsp: places of kinds accounts and cash ...
