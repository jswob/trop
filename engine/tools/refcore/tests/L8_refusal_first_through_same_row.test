# tally 2.1.8 R11 (pick P26; item 18 of the fourth turn, the engine's 5ae84cca, the review of group 1's fix N3):
# add_business past the edge where cq is stated same as cr, whose row from 2028-03-01 has no business day. cq's own
# rows bound no day there; the walk reads the rows the same line follows too, so f meets RUN-DOMAIN first, with
# no hole before it, and it stands before the edge's RUN-LIMIT, as g, reading cr itself, does. db514fb2 printed
# f: refused: RUN-LIMIT.
=== m.tally
model n3
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source plan "plan"
input d: date
input cr: calendar
input cq: calendar
input huge: int

version v
  cite plan
  governs always
  known 2026-01-01
  d = 2026-06-01 "a day"
  huge = 100000000000000000000 "10^20"

version v26
  cite plan
  governs 2026
  known 2026-01-01
  cq = calendar(weekends [sat, sun]) "s"

version vr
  cite plan
  governs 2026-01-01..2028-02-29
  known 2026-01-01
  cr = calendar(weekends [sat, sun]) "s"

version vz
  cite plan
  governs 2028-03-01..
  known 2026-01-01
  cr = calendar(weekends [mon, tue, wed, thu, fri, sat, sun]) "s"

version link
  cite plan
  governs always
  known 2026-01-01
  same cq = cr

ask f: add_business(d, huge, cq)
ask g: add_business(d, huge, cr)
=== expect
f: refused: RUN-DOMAIN calendar cq has no business day
  held: cr = calendar(weekends [mon, tue, wed, thu, fri, sat, sun]) (vz), read for 2028-03-01
  cut 2026-12-31
g: refused: RUN-DOMAIN calendar cr has no business day
  held: cr = calendar(weekends [mon, tue, wed, thu, fri, sat, sun]) (vz), read for 2028-03-01
  cut 2026-12-31
