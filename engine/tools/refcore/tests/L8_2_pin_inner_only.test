# L §8.2 One read set (tally 2.1.7 R7, issue #146; T's SR-6) and L §4.6 step 2 (R4): in p_inner the inner as if pins
# r[k1] = 5 at the only read of r[k1], so the ask's with pin r[k1] = 9 is in no read: tot is 6 and only pinned: r[k1]
# = 5 is listed. p_with reads the with pin (10); p_both reads both, 10 + 6 = 16, and lists both. 2.1.7's first refcore
# listed an ask's with pins under every line, read or not.
=== sr6.tally
model sr6
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source card "T's card (invented)"

index ks = [k1, k2]

input r[k in ks]: num

input reader: date

def tot: num = r[k1] + r[k2] at reader

ask p_inner: tot as if {r[k1] = 5} with r[k1] = 9 law 2026-06-30

ask p_with: tot with r[k1] = 9 law 2026-06-30

ask p_both: tot + (tot as if {r[k1] = 5}) with r[k1] = 9 law 2026-06-30


version v
  cite card
  governs always
  known 2026-01-01
  r[*] = 1 "c"
  r[k1] = 2 "the narrower row"
  reader = 2026-06-30 "the day tot reads at"
=== expect
p_both: 16
  pinned: r[k1] = 5
  pinned: r[k1] = 9
  law date 2026-06-30, cut 2026-06-30
p_inner: 6
  pinned: r[k1] = 5
  law date 2026-06-30, cut 2026-06-30
p_with: 10
  pinned: r[k1] = 9
  law date 2026-06-30, cut 2026-06-30
warning: WARN-UNREAD input reader is read by nothing
