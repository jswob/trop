# tally 2.1.8 S4 (#179), E §10 a movement instance: "a version that answers a hole booking prints `answered at
# <cut> (version <V>):` before its rows", the derivation under that version's known after the one at the booking
# cut. At cut 2026-02-20 (e0) nothing answers it. The M2 engine's form (T's spec/g5/p4_inp_e3); 2.1.7's refcore
# printed the hole and no such line.
=== m.tally
model hh
  tally 2
  on 2026-06-30
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01
input amt[m in months]: money PLN question "Ile?"
input dom: int
place konto: accounts PLN lives 2019-05-01..
place world: outside lives 1900-01-01..

move pay[m in months]: transfers
  on day_of(m, dom)
  at start_of(m)
  leg cash from konto to world amount amt[m]

version v1
  cite s
  governs 2026..
  known 2026-01-01
  dom = 10 "s"
  amt[2026-01] = 100.00 PLN "s"
  opening[konto] = 1 000.00 PLN at 2026-01-01 start "s"

version v2
  cite s
  governs 2026..
  known 2026-03-01
  amt[2026-02] = 200.00 PLN "s"

ask e1: explain pay[2026-02]
ask e0: explain pay[2026-02] as known 2026-02-20
=== expect
e0: pay[2026-02]
  plan, day 2026-02-10, booking cut 2026-02-10, status past
  leg cash from konto to world amount ?"Ile?" (amt[2026-02])
  derivation at 2026-02-10:
    [1] row v1:dom = 10
        version v1, source s, "s", locator "s", governs 2026-01-01.., known 2026-01-01
  cut 2026-02-20
e1: pay[2026-02]
  plan, day 2026-02-10, booking cut 2026-02-10, status past
  leg cash from konto to world amount 200.00 PLN
  derivation at 2026-02-10:
    [1] row v1:dom = 10
        version v1, source s, "s", locator "s", governs 2026-01-01.., known 2026-01-01
  answered at 2026-03-01 (version v2):
    [1] row v1:dom = 10
        version v1, source s, "s", locator "s", governs 2026-01-01.., known 2026-01-01
    [2] row v2:amt[2026-02] = 200.00 PLN
        version v2, source s, "s", locator "s", governs 2026-01-01.., known 2026-03-01
  cut 2026-06-30
