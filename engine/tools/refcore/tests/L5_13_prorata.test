# L §5.13: raw_j = 100.00 × 1/3 = 33.333...  rest none: each rounded half-even to 0.01: 33.33.  rest last: each
# but the last rounded, the last takes the rest: 33.33, 33.33, 33.34.  rest largest: each rounded down (33.33), the
# one leftover unit goes to the largest remainder; all three tie, so ties by pos(i) decides: the smallest, a1
# (ascending, as fill's and the aggregates' ties by, reported).  Without ties by the tie changes the result:
# RUN-TIE (D-5).  Steps of minor(PLN) give money.
=== m.tally
model t
  tally 2
  on 2026-12-31
  start 2026-01-01
  end 2026-12-31

source s "s"
unit PLN: currency minor 0.01

index parts = [a1, a2, a3]
input tot: money PLN
input w[j in parts]: num
input hm: rounding
def sn[j in parts]: money PLN = prorata(tot, w[i] for i in parts, j, minor(PLN), hm, rest none) at reader
def sl[j in parts]: money PLN = prorata(tot, w[i] for i in parts, j, minor(PLN), hm, rest last) at reader
def sg[j in parts]: money PLN = prorata(tot, w[i] for i in parts, j, minor(PLN), rest largest ties by pos(i)) at reader
def sx[j in parts]: money PLN = prorata(tot, w[i] for i in parts, j, minor(PLN), rest largest) at reader
def sw[j in parts]: money PLN = prorata(tot, w[i] for i in parts, j, 1 PLN, rest largest) at reader

version v
  cite s
  governs 2026..
  known 2026-01-01
  tot = 100.00 PLN
  w[a1] = 1
  w[a2] = 1
  w[a3] = 1
  hm = half-even

ask a: sn[j], sl[j], sg[j] for j in parts law 2026-06-30
ask b: sx[a1] law 2026-06-30
=== expect
a (j = a1): (33.33 PLN, 33.33 PLN, 33.34 PLN)
  law date 2026-06-30, cut 2026-12-31
a (j = a2): (33.33 PLN, 33.33 PLN, 33.33 PLN)
  law date 2026-06-30, cut 2026-12-31
a (j = a3): (33.33 PLN, 33.34 PLN, 33.33 PLN)
  law date 2026-06-30, cut 2026-12-31
b: refused: RUN-TIE ...
  law date 2026-06-30, cut 2026-12-31
