#!/bin/sh
# nextest's run-wrapper for gate 8's coverage map (R-133; tools/mutants-cov.toml): each test's
# LLVM profile in a file of its own, named by the hash of its binary id and name, beside a
# .test file holding its binary and that name. A rule file: only the `rules` role edits it.
set -eu
key="$NEXTEST_BINARY_ID $NEXTEST_TEST_NAME"
if command -v sha256sum >/dev/null 2>&1; then
  h="$(printf '%s' "$key" | sha256sum)"
else
  h="$(printf '%s' "$key" | shasum -a 256)"
fi
h="${h%% *}"
printf '%s\n%s\n' "$1" "$key" > "$MUTANTS_COV_OUT/$h.test"
LLVM_PROFILE_FILE="$MUTANTS_COV_OUT/$h.%p.profraw"
export LLVM_PROFILE_FILE
exec "$@"
