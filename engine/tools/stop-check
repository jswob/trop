#!/usr/bin/env bash
# The Stop hook (R-83): build role only. An internal error refuses the stop (exit 2).
# In every role it also appends the turn's line to TALLY_TURN_LOG, which launch sets; the
# other roles' stops never wait on it.
if [ "${TALLY_ROLE:-}" != build ]; then
  if [ -n "${TALLY_TURN_LOG:-}" ] && d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; then
    python3 -I -B "$d/stop_check.py" "$@" > /dev/null 2>&1
  fi
  exit 0
fi
d="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" || exit 2
python3 -I -B "$d/stop_check.py" "$@"
c=$?
if [ "$c" -eq 0 ] || [ "$c" -eq 2 ]; then exit "$c"; fi
echo "engine stop-check: internal error (exit $c); refusing the stop (R-83)" >&2
exit 2
