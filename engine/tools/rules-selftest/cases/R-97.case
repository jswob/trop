# R-97: the budgets. engine/tools/perf times the rows from the protected budget table
# (tools/perf-budgets.toml); after S a miss fails, a counted run with no counters' line
# fails, and a bench's hard limit reaches gungraun's command line (D4-2, BUILDER §13.3).

case: wall-over-budget-after-s
tool: run
expect: BUDGET P8-10 wall(1w)
--- replace tools/perf-budgets.toml
recipe = "check:I:A:a05_ania@c05-ania"
wall_s = 1.0
--- with
recipe = "check:I:A:a05_ania@c05-ania"
wall_s = 0.0000001
--- run
tools/perf row P8-10 --runs 1 --warmups 0 --bin /usr/bin/true

case: counted-run-without-stats
tool: run
expect: no `stats:` line
--- run
tools/perf counts P8-15 --bin /usr/bin/true

case: limit-reaches-the-command-line
tool: run
exit: any
expect: --callgrind-limits=ir=1000
--- replace tools/perf-budgets.toml
recipe = "bench:p8_m1"
wall_s = 0.0000000555
instructions = 1048
--- with
recipe = "bench:p8_m1"
wall_s = 0.0000000555
instructions = 1000
--- run
tools/perf limits p8_m1

# Pick P56 (issue #128, 2026-11-09): P8-M4's wall is its run with the projection less the
# plain run, so perf subtracts the median of the bench id the row's `less` names. The planted
# medians are 202 ms and 200 ms, then 205 ms and 200 ms: the row's wall is the difference.
# Pick P58 (2026-11-10): that wall is information, so the row sets no wall_s to judge it by;
# its instruction limit is the guard.

case: less-subtracts-the-plain-median
tool: run
exit: any
expect: R-97 less: 2.00 ms (criterion, 202.00 ms less P8-M4-plain's 200.00 ms); 5.00 ms; information, no wall_s; instructions set
--- write zz-crit/criterion/P8-M4/new/estimates.json
{"median": {"point_estimate": 202000000.0}}
--- write zz-crit/criterion/P8-M4-plain/new/estimates.json
{"median": {"point_estimate": 200000000.0}}
--- write zz-crit-over/criterion/P8-M4/new/estimates.json
{"median": {"point_estimate": 205000000.0}}
--- write zz-crit-over/criterion/P8-M4-plain/new/estimates.json
{"median": {"point_estimate": 200000000.0}}
--- run
python3 -I -B -c "
import sys; sys.path.insert(0, 'tools'); import perf
r = perf.row_of('P8-M4')
w, how = perf.criterion_wall(r, 'zz-crit')
o, _ = perf.criterion_wall(r, 'zz-crit-over')
print(f'R-97 less: {perf.seconds(w)} ({how}); {perf.seconds(o)}; ' + ('judged' if 'wall_s' in r else 'information, no wall_s') + ('; instructions set' if 'instructions' in r else '; no limit'))
"
