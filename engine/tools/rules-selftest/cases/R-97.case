# R-97: the budgets. engine/tools/perf times the rows from the protected budget table
# (tools/perf-budgets.toml); after S a miss fails, a counted run with no counters' line
# fails, and a bench's hard limit reaches gungraun's command line (D4-2, BUILDER §13.3).

case: wall-over-budget-after-s
tool: run
expect: BUDGET P8-10 wall(1w)
--- replace tools/perf-budgets.toml
recipe = "check:I:A:a05_ania@c05-ania"
wall_s = 1.0
--- with
recipe = "check:I:A:a05_ania@c05-ania"
wall_s = 0.0000001
--- run
tools/perf row P8-10 --runs 1 --warmups 0 --bin /usr/bin/true

# Pick P6 (issue #226, 2026-11-18): P8-1, a conversation turn, is `turn:`: its vectors run in
# order, each a cold process, and each output is judged against its own vector's digest, so a
# turn whose any process answers wrong fails. /usr/bin/true prints nothing: all three are wrong.

case: turn-judges-each-process
tool: run
expect: 3 processes a run: changes/check/c7 changes/run/b7 changes/run/c7
expect: changes/run/b7: WRONG
expect: changes/run/c7: WRONG
--- run
tools/perf row P8-1 --runs 1 --warmups 0 --bin /usr/bin/true

case: counted-run-without-stats
tool: run
expect: no `stats:` line
--- run
tools/perf counts P8-15 --bin /usr/bin/true

case: limit-reaches-the-command-line
tool: run
exit: any
expect: --callgrind-limits=ir=1000
--- replace tools/perf-budgets.toml
recipe = "bench:p8_m1"
wall_s = 0.0000000555
instructions = 1048
--- with
recipe = "bench:p8_m1"
wall_s = 0.0000000555
instructions = 1000
--- run
tools/perf limits p8_m1

# Pick P56 (issue #128, 2026-11-09): P8-M4's wall is its run with the projection less the
# plain run, so perf subtracts the median of the bench id the row's `less` names. The planted
# medians are 202 ms and 200 ms, then 205 ms and 200 ms: the row's wall is the difference.
# Pick P58 (2026-11-10): that wall is information, so the row sets no wall_s to judge it by;
# its instruction limit is the guard.

case: less-subtracts-the-plain-median
tool: run
exit: any
expect: R-97 less: 2.00 ms (criterion, 202.00 ms less P8-M4-plain's 200.00 ms); 5.00 ms; information, no wall_s; instructions set
--- write zz-crit/criterion/P8-M4/new/estimates.json
{"median": {"point_estimate": 202000000.0}}
--- write zz-crit/criterion/P8-M4-plain/new/estimates.json
{"median": {"point_estimate": 200000000.0}}
--- write zz-crit-over/criterion/P8-M4/new/estimates.json
{"median": {"point_estimate": 205000000.0}}
--- write zz-crit-over/criterion/P8-M4-plain/new/estimates.json
{"median": {"point_estimate": 200000000.0}}
--- run
python3 -I -B -c "
import sys; sys.path.insert(0, 'tools'); import perf
r = perf.row_of('P8-M4')
w, how = perf.criterion_wall(r, 'zz-crit')
o, _ = perf.criterion_wall(r, 'zz-crit-over')
print(f'R-97 less: {perf.seconds(w)} ({how}); {perf.seconds(o)}; ' + ('judged' if 'wall_s' in r else 'information, no wall_s') + ('; instructions set' if 'instructions' in r else '; no limit'))
"

# Pick P5 (a) (issue #252, 2026-11-22): a load row (`load:`, P8-L2 and P8-L10) runs T's run
# list, engine/tests/m4/load/runs.tsv, each run once and cold, a line each, and judges the row
# by its slowest run's wall and its largest peak; an output is checked where the list holds a
# sha256 (P8-L2's), reported where it holds `-` (P8-L10's). /usr/bin/true prints nothing, so
# P8-L2's one run is wrong, and P8-L10's named runs are reported, unjudged.

case: load-judges-each-run
tool: run
exit: any
expect: P8-L2 d11_full: wall
expect: BUDGET P8-L2 WRONG output: d11_full
--- run
tools/perf row P8-L2 --bin /usr/bin/true

# Planted runs of P8-L10 beside T's (since U2, 2026-11-23, T's list holds c1_r2 alone), so
# the case doesn't hang on how many runs the list holds.
case: load-runs-by-name
tool: run
exit: any
expect: P8-L10 zz_a: wall
expect: sha256 e3b0c44298fc reported (runs.tsv holds -)
expect: 2 of 3 runs (--runs), each once, cold; 2 unjudged (sha256 -)
--- append tests/m4/load/runs.tsv
P8-L10	zz_a	engine	a.tally	zz	-
P8-L10	zz_b	engine	b.tally	zz	-
--- run
tools/perf row P8-L10 --runs c1_r2,zz_a --bin /usr/bin/true

case: load-run-name-unknown
tool: run
exit: any
expect: --runs: zz_none is no run of P8-L10
--- run
tools/perf row P8-L10 --runs zz_none --bin /usr/bin/true

# A run the watchdog stops (memcap.py's kill at 8 GB, a signal) misses whatever its wall: the
# planted binary stops itself with SIGTERM, as memcap does.
case: load-run-killed-misses
tool: run
exit: any
expect: P8-L10 c1_r2: wall
expect: killed by signal 15 (memcap at 8 GB)
expect: killed at 8 GB or 90 s (D4-7): c1_r2
--- write zz-term.sh
#!/bin/sh
kill -TERM $$
--- run
chmod +x zz-term.sh
tools/perf row P8-L10 --runs c1_r2 --bin "$PWD/zz-term.sh"

# F7's count row (issue #252, 2026-11-23): F7-c1r2 runs P8-L10's c1_r2 on the counted build and
# holds its def misses to 1.2 x G6c's final count (226 609), so a change that brings the move's
# whole list back at every past cut fails a PR. The planted binary prints a counters' line over it.
case: load-count-over-budget
tool: run
exit: any
expect: COUNT F7-c1r2 c1_r2 def_misses 300 000 > 226 609
--- write zz-stats.sh
#!/bin/sh
echo "stats: def_misses=300000 days_stepped=1 walks_shared=0"
--- run
chmod +x zz-stats.sh
tools/perf counts F7-c1r2 --bin "$PWD/zz-stats.sh"

# The process step after M4 (2026-11-24; the user's "Sounds resonable", 2026-11-23): P8-2's 1x
# twin is a `run:` row, R7 to 2056, and it reports (`blocks = "report"`): a miss prints beside
# its budget, marked `report`, and the command passes, since no tag waits on it until the long
# runs' remedy. The planted budget is one any run misses.
case: report-row-prints-and-passes
tool: run
exit: any
expect: report P8-2 wall(1w): median
expect: reported, no tag waits on it
expect: perf row passed
--- replace tools/perf-budgets.toml
r7/joint.tally records/ --ask pin_2056"
wall_s = 1.0
--- with
r7/joint.tally records/ --ask pin_2056"
wall_s = 0.0000001
--- run
tools/perf row P8-2 --runs 1 --warmups 0 --bin /usr/bin/true && echo "perf row passed"

# The growth with the horizon (the same words): `perf growth` times [growth]'s two horizons of
# one text, reads each header's start and end, and prints the table and the ratios; it judges
# nothing, so the command passes. R7's to2028 and to2050 span 1 643 and 9 587 days.
case: growth-prints-both-horizons
tool: run
exit: any
expect: | short: `r7/to2028.tally` | 2024-01-01 .. 2028-06-30 | 1643 |
expect: | long: `r7/to2050.tally` | 2024-01-01 .. 2050-03-31 | 9587 |
expect: growth: the span x5.84; time x
expect: perf growth passed
--- run
tools/perf growth --runs 1 --warmups 0 --bin /usr/bin/true && echo "perf growth passed"

# A run that gives no figure (a refusal, a kill) leaves no ratio: the command fails.
case: growth-run-without-figure
tool: run
expect: growth short:
expect: exited 1: no figure
--- run
tools/perf growth --runs 1 --warmups 0 --bin /usr/bin/false

# Pick P33 of M4 (2026-11-23), under the same words: `perf counts` reads the exit code first.
# 69 ("not implemented", a later milestone's check) is `not built`, for a check row and a load
# row, and the job stays green; an answer (0) is judged against the budget; any other code
# fails, whatever its counters' line says.
case: count-not-built-passes
tool: run
exit: any
expect: not built P8-15: the engine stops "not implemented" (exit 69), nothing counted
expect: F7-c1r2 c1_r2: not built (exit 69
expect: not built F7-c1r2: 1 run stops "not implemented"
expect: perf counts passed
--- write zz-69.sh
#!/bin/sh
echo "not implemented: a later milestone's form"
echo "stats: def_misses=0 days_stepped=0 walks_shared=0"
exit 69
--- run
chmod +x zz-69.sh
tools/perf counts P8-15 F7-c1r2 --bin "$PWD/zz-69.sh" && echo "perf counts passed"

case: count-answer-is-judged
tool: run
exit: any
expect: ok P8-15 counts(1w): def_misses 70, days_stepped 12, walks_shared 0
expect: perf counts passed
--- write zz-0.sh
#!/bin/sh
echo "stats: def_misses=70 days_stepped=12 walks_shared=0"
--- run
chmod +x zz-0.sh
tools/perf counts P8-15 --bin "$PWD/zz-0.sh" && echo "perf counts passed"

case: count-other-exit-fails
tool: run
expect: COUNT P8-15: exit 1, not an answer: a run that didn't answer counts nothing (refused: planted)
--- write zz-1.sh
#!/bin/sh
echo "refused: planted"
echo "stats: def_misses=0 days_stepped=0 walks_shared=0"
exit 1
--- run
chmod +x zz-1.sh
tools/perf counts P8-15 --bin "$PWD/zz-1.sh"
