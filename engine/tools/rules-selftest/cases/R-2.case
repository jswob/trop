# R-2: no unwrap or expect outside tests; tests may use them. Clippy sees the method
# calls; the ast-grep rule no-unwrap-path sees them written as paths (map(Option::unwrap)).

case: unwrap
tool: clippy
expect: clippy::unwrap_used
--- module
/// Planted.
pub fn planted(v: Option<u8>) -> u8 {
    v.unwrap()
}

case: expect
tool: clippy
expect: clippy::expect_used
--- module
/// Planted.
pub fn planted(v: Option<u8>) -> u8 {
    v.expect("planted")
}

case: tests-may-unwrap
tool: clippy-tests
expect: pass
--- module
#[cfg(test)]
mod tests {
    #[test]
    fn planted() {
        let v = core::hint::black_box(Some(1_u8));
        assert_eq!(v.unwrap(), 1, "planted");
        assert_eq!(v.expect("planted"), 1, "planted");
    }
}

case: unwrap-method-ref
tool: ast-grep
expect: no-unwrap-path
--- module
/// Planted.
pub fn planted(v: &[Option<u8>]) -> Vec<u8> {
    v.iter().copied().map(Option::unwrap).collect()
}

case: result-expect-path
tool: ast-grep
expect: no-unwrap-path
--- module
/// Planted.
pub fn planted(v: Result<(), crate::NotImplemented>) {
    core::result::Result::expect(v, "planted");
}

case: tests-may-unwrap-path
tool: ast-grep
expect: pass
--- module
#[cfg(test)]
mod tests {
    #[test]
    fn planted() {
        let v = core::hint::black_box(Some(1_u8));
        assert_eq!(Option::unwrap(v), 1, "planted");
    }
}
