# R-85: once the kernel is set, a library file in neither list fails, and the mutants
# config follows the kernel.

case: unlisted-library-file
tool: run
expect: in neither the kernel nor the protected non-kernel list (R-85)
--- module
/// Planted: a library file outside both lists.
pub fn planted() -> u8 {
    1
}
--- run
tools/check-rules

case: mutants-config-differs
tool: run
expect: examine_globs differs from tools/kernel.toml's kernel (R-85)
--- replace .cargo/mutants.toml
  "crates/tally/src/hole/**",
--- with
  "crates/tally/src/hole/*.rs",
--- run
tools/check-rules
