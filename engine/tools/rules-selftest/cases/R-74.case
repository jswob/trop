--- module
/// Planted.
pub fn planted(a: u8) -> u8 {
    if a > 1 {
        if a > 2 {
            if a > 3 {
                if a > 4 {
                    if a > 5 {
                        if a > 6 {
                            return 7;
                        }
                    }
                }
            }
        }
    }
    0
}
