# R-77: every pull request runs the full check, with the tests of every gating milestone
# (tools/milestones.toml, issue #14). Each case writes its own marker and plants its own
# red test, so none depends on how far the engine is built.

case: gating-milestone-red
tool: run
expect: FAIL gating: S gates
--- write tools/milestones.toml
milestones = ["S", "M0", "M1", "M2", "M3", "M4", "M5a", "M5b", "M5c", "M6", "M7", "M8", "M9"]
gating = ["S"]
--- append tests/runner/Cargo.toml

[[test]]
name = "s_planted"
path = "milestone/s_planted.rs"
test = false
--- write tests/runner/milestone/s_planted.rs
//! Planted: a red test of milestone S.

#[test]
fn planted_red() {
    assert!(core::hint::black_box(false), "planted");
}
--- run
tools/check step gating

case: gating-milestone-red-release
tool: run
expect: FAIL gating-release: S gates
--- write tools/milestones.toml
milestones = ["S", "M0", "M1", "M2", "M3", "M4", "M5a", "M5b", "M5c", "M6", "M7", "M8", "M9"]
gating = ["S"]
--- append tests/runner/Cargo.toml

[[test]]
name = "s_planted"
path = "milestone/s_planted.rs"
test = false
--- write tests/runner/milestone/s_planted.rs
//! Planted: a red test of milestone S.

#[test]
fn planted_red() {
    assert!(core::hint::black_box(false), "planted");
}
--- run
tools/check step gating-release

case: next-milestone-reported-not-failing
tool: run
exit: any
expect: milestone-report: S:
expect: the report step passed
--- write tools/milestones.toml
milestones = ["S", "M0", "M1", "M2", "M3", "M4", "M5a", "M5b", "M5c", "M6", "M7", "M8", "M9"]
gating = []
--- append tests/runner/Cargo.toml

[[test]]
name = "s_planted"
path = "milestone/s_planted.rs"
test = false
--- write tests/runner/milestone/s_planted.rs
//! Planted: a red test of milestone S.

#[test]
fn planted_red() {
    assert!(core::hint::black_box(false), "planted");
}
--- run
tools/check step milestone-report && echo "the report step passed"

case: gating-unknown-milestone
tool: run
expect: FAIL gating: tools/milestones.toml: gating names S1, which isn't a milestone
--- write tools/milestones.toml
milestones = ["S", "M0", "M1", "M2", "M3", "M4", "M5a", "M5b", "M5c", "M6", "M7", "M8", "M9"]
gating = ["S1"]
--- run
tools/check step gating

case: gating-out-of-order
tool: run
expect: FAIL gating: tools/milestones.toml: gating must be the first milestones in build order
--- write tools/milestones.toml
milestones = ["S", "M0", "M1", "M2", "M3", "M4", "M5a", "M5b", "M5c", "M6", "M7", "M8", "M9"]
gating = ["M0"]
--- run
tools/check step gating

case: test-target-in-no-milestone
tool: run
expect: FAIL gating: tally-runner's test target planted has test = false but names no milestone
--- append tests/runner/Cargo.toml

[[test]]
name = "planted"
path = "milestone/planted.rs"
test = false
--- write tests/runner/milestone/planted.rs
//! Planted: a test hidden from every run.

#[test]
fn planted_hidden() {
    assert!(core::hint::black_box(false), "planted");
}
--- run
tools/check step gating

case: gungraun-bench-broken
tool: run
expect: FAIL gungraun-build: error[E0308]
--- append tools/gungraun/benches/p8_m1.rs

/// Planted: a bench that no longer compiles against the library, as the stub bench did (issue #26).
const PLANTED: u8 = "a mismatched type";
--- run
tools/check step gungraun-build

# The logged red (the review after S, 2026-11-03, issue #8): commit-check takes a
# commit's `Logged-Red:` lines only from T's re-run commit, followed on the branch by a
# commit to engine/crates/. Each case commits in the scratch and takes the commits back.

case: logged-red-outside-tests
tool: run
exit: any
expect: outside engine/tests/: only T's re-run commit may be red (R-77)
--- write crates/tally/src/planted.txt
planted
--- run
git add -A && git -c user.name=rules-selftest -c user.email=rules-selftest@invalid commit -q -m "planted: a red commit outside the tests" -m "Logged-Red: g1/planted"
git -c user.name=rules-selftest -c user.email=rules-selftest@invalid commit -q --allow-empty -m "planted: nothing"
tools/commit-check HEAD~2
git reset -q --hard HEAD~2

case: logged-red-without-the-builder
tool: run
exit: any
expect: a logged red with no later commit changing engine/crates/ on the branch (R-77)
--- write tests/planted.txt
planted
--- run
git add -A && git -c user.name=rules-selftest -c user.email=rules-selftest@invalid commit -q -m "planted: T's re-run, red" -m "Logged-Red: g1/planted"
tools/commit-check HEAD~1
git reset -q --hard HEAD~1

case: logged-red-without-ids
tool: run
exit: any
expect: a Logged-Red line names no vector id (R-77)
--- write tests/planted.txt
planted
--- write crates/tally/src/planted.txt
planted
--- run
git add tests/planted.txt && git -c user.name=rules-selftest -c user.email=rules-selftest@invalid commit -q -m "planted: T's re-run, red" -m "Logged-Red:"
git add -A && git -c user.name=rules-selftest -c user.email=rules-selftest@invalid commit -q -m "planted: the builder's fix"
tools/commit-check HEAD~2
git reset -q --hard HEAD~2

case: logged-red-then-the-builder
tool: run
exit: any
expect: commit-check: logged red:
expect: commit-check: 0 rule-changing commits, no attribution line
--- write tests/planted.txt
planted
--- write crates/tally/src/planted.txt
planted
--- run
git add tests/planted.txt && git -c user.name=rules-selftest -c user.email=rules-selftest@invalid commit -q -m "planted: T's re-run, red" -m "Logged-Red: g1/planted"
git add -A && git -c user.name=rules-selftest -c user.email=rules-selftest@invalid commit -q -m "planted: the builder's fix"
tools/commit-check HEAD~2
git reset -q --hard HEAD~2
