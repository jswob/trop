--- write crates/tally/src/walk/zz_gate.rs
//! Planted for R-133's cases.
pub fn planted() -> u8 {
    7
}
--- write zz-gate/list.in
{"key": "@KEY@", "mutants": [{"name": "crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0", "file": "crates/tally/src/walk/zz_gate.rs", "package": "tally", "genre": "FnValue", "replacement": "0", "function": {"function_name": "planted", "return_type": "-> u8", "span": {"start": {"line": 2, "column": 1}, "end": {"line": 4, "column": 2}}}, "span": {"start": {"line": 3, "column": 5}, "end": {"line": 3, "column": 6}}, "diff": "--- crates/tally/src/walk/zz_gate.rs\n+++ replace planted -> u8 with 0\n@@ -1,4 +1,4 @@\n //! Planted for R-133's cases.\n pub fn planted() -> u8 {\n-    7\n+    0\n }\n"}]}
--- write zz-gate/plan.in
{"key": "@KEY@", "shards": [[]], "o1": [], "killers": {}, "order": []}
--- write zz-gate/map.in
{"key": "@KEY@", "args": [], "tests": {}}
--- run
k="$(tools/mutants-gate key)" || exit 1
for f in list plan map; do sed "s/@KEY@/$k/g" "zz-gate/$f.in" > "zz-gate/$f.json"; done
tools/mutants-gate shard 0/1 zz-gate/list.json zz-gate/map.json zz-gate/plan.json zz-gate/out

# The plan builds the last run's survivors with the kernel at opt-level 1 (overflow checks
# and debug assertions stay on), and nextest's exit 100 is a catch. The planted history
# says the mutant was missed; the fake cargo records what it was asked to build.

case: survivor-at-opt-level-1-caught-on-100
tool: run
exit: any
expect: --config profile.mutants.package.tally.opt-level=1
expect: "summary": "CaughtMutant"
--- write crates/tally/src/walk/zz_gate.rs
//! Planted for R-133's cases.
pub fn planted() -> u8 {
    7
}
--- write zz-bin/cargo
#!/bin/sh
# a fake cargo: nextest's build passes and is recorded, its test run fails a test (exit 100); anything else is the real cargo's
if [ "$1" != nextest ]; then exec "$REAL_CARGO" "$@"; fi
case " $* " in *" --no-run "*) echo "$*" >> zz-gate/builds.txt; exit 0 ;; esac
echo "        FAIL [   0.010s] (1/1) tally-runner::s_kernel tests::planted_t"
exit 100
--- write zz-gate/list.in
{"key": "@KEY@", "mutants": [{"name": "crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0", "file": "crates/tally/src/walk/zz_gate.rs", "package": "tally", "genre": "FnValue", "replacement": "0", "function": {"function_name": "planted", "return_type": "-> u8", "span": {"start": {"line": 2, "column": 1}, "end": {"line": 4, "column": 2}}}, "span": {"start": {"line": 3, "column": 5}, "end": {"line": 3, "column": 6}}, "diff": "--- crates/tally/src/walk/zz_gate.rs\n+++ replace planted -> u8 with 0\n@@ -1,4 +1,4 @@\n //! Planted for R-133's cases.\n pub fn planted() -> u8 {\n-    7\n+    0\n }\n"}]}
--- write zz-gate/history.json
{"mutants": {"crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0": {"build": 10.0, "test": 40.0, "o1": false, "summary": "MissedMutant", "killer": null}}, "tests": {}}
--- write zz-gate/map.in
{"key": "@KEY@", "args": [], "tests": {"tally-runner::s_kernel tests::planted_t": {"crates/tally/src/walk/zz_gate.rs": [[2, 4]]}}}
--- run
k="$(tools/mutants-gate key)" || exit 1
for f in list map; do sed "s/@KEY@/$k/g" "zz-gate/$f.in" > "zz-gate/$f.json"; done
tools/mutants-gate plan zz-gate/list.json zz-gate/history.json 1 zz-gate/plan.json
chmod +x zz-bin/cargo
REAL_CARGO="$(command -v cargo)" PATH="$PWD/zz-bin:$PATH" tools/mutants-gate shard 0/1 zz-gate/list.json zz-gate/map.json zz-gate/plan.json zz-gate/out
cat zz-gate/builds.txt
grep -o '"summary": "CaughtMutant"' zz-gate/out/mutants.out/outcomes.json

# Q6 (issue #138, the user's "yes, now", 2026-11-13): mutants-local pays T's baseline and
# the coverage map once per tree, keyed on check's memo key with the targets; a second
# single-mutant proof on the same tree reuses them, and any change to the tree pays again.
# The baseline, the map, the list and the judging are planted stand-ins that log their calls.
case: local-baseline-and-map-once-per-tree
tool: run
exit: any
expect: first: baseline map judged
expect: again: judged
expect: after an edit: baseline map judged
expect: another target: baseline map judged
--- write zz_reuse.py
"""Planted: tools/mutants-gate's local mode with its costly parts logged, not run."""
import os
import sys

sys.path.insert(0, "tools")
import mutants_gate as g

calls = []


def baseline(work, extra=(), expr=None):
    calls.append("baseline")
    g.dump_json(os.path.join(work, "times.json"), {})
    return True


def coverage(out, extra=(), expr=None):
    calls.append("map")
    g.dump_json(out, {})


def judge_all(*args, **kwargs):
    calls.append("judged")
    return {}


g.baseline, g.coverage, g.judge_all = baseline, coverage, judge_all
g.put_back = lambda: None
g.selection = lambda: ["--test=planted"]
g.features_of = lambda args: []
g.list_mutants = lambda *args, **kwargs: [{"name": "planted"}]
g.local(["crates/tally/src/lib.rs"], None, sys.argv[2:])
print(f"{sys.argv[1]}:", " ".join(calls))
--- run
python3 -I -B zz_reuse.py first
python3 -I -B zz_reuse.py again
printf '\n// planted after the first run\n' >> crates/tally/src/lib.rs
python3 -I -B zz_reuse.py "after an edit"
python3 -I -B zz_reuse.py "another target" --test=planted-too
