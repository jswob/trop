# R-88: a mutant's tests run under the memory cap (issue #40). The mutants profile runs
# every test through tools/test-memcap, which ends a test past 2048 MB and says so, so a
# mutant that allocates without bound can't take the machine down. The planted test
# grows by 64 MB at a time, for ever.

case: runaway-test-memory
tool: run
expect: test-memcap: ended at
--- append tests/runner/src/lib.rs

#[cfg(test)]
mod planted_runaway {
    #[test]
    fn grows_for_ever() {
        let mut held: Vec<Vec<u8>> = Vec::new();
        loop {
            held.push(vec![1_u8; 64 << 20]);
        }
    }
}
--- run
cargo nextest run --locked -p tally-runner --cargo-profile mutants --profile mutants --lib -E 'test(=planted_runaway::grows_for_ever)'

# Since 2026-11-06 a mutant ends at its first failing test, and the tests still running are
# ended then (nextest's fail-fast max-fail 1, terminate immediate): the planted slow test
# would pass after 100 s if the run waited for it.

case: first-failure-ends-the-rest
tool: run
expect: Cancelling due to test failure: immediately terminating 1 test still running
expect: planted_failfast::runs_long
--- append tests/runner/src/lib.rs

#[cfg(test)]
mod planted_failfast {
    #[test]
    fn fails_at_once() {
        assert!(core::hint::black_box(false), "planted");
    }

    #[test]
    fn runs_long() {
        std::thread::sleep(std::time::Duration::from_secs(100));
    }
}
--- run
cargo nextest run --locked -p tally-runner --cargo-profile mutants --profile mutants --lib -E 'test(/^planted_failfast::/)'

# P13 (issue #108, 2026-11-08): `mutants-local --next` adds the next milestone's tests, each
# only if it is green in the unmutated run just before the mutants: a test red there would
# count as catching every mutant. The planted baseline holds one green and one red test of a
# next-milestone target; the filter keeps the green one and leaves the red one out, and a
# baseline whose summary doesn't match its lines keeps none.

case: next-red-at-the-baseline-is-left-out
tool: run
exit: any
expect: R-88 --next: kept tests::m1_green; left out tests::m1_red
--- write zz-next-baseline.log
        PASS [   0.104s] (1/2) tally-runner::m1_planted tests::m1_green
        FAIL [   0.110s] (2/2) tally-runner::m1_planted tests::m1_red
  stderr ───

    thread 'tests::m1_red' panicked at milestone/m1_planted.rs:9:5:
    1 of 3 vectors of g1 differ from refcore:
    g1/planted: exit 0, refcore 1

────────────
     Summary [   0.214s] 2 tests run: 1 passed, 1 failed, 0 skipped
        FAIL [   0.110s] (2/2) tally-runner::m1_planted tests::m1_red
error: test run failed
--- run
python3 -I -B -c "
import sys; sys.path.insert(0, 'tools'); import mutants_local as m
e, g, r = m.next_filter(open('zz-next-baseline.log').read(), ['m1_planted', 'm1_other'])
ok = e is not None and 'test(=tests::m1_green)' in e and 'm1_red' not in e and e.startswith('not (')
print('R-88 --next: kept ' + ' '.join(t for _, t in g) + '; left out ' + ' '.join(t for _, t in r) if ok else 'R-88 --next broken: ' + repr(e))
"

case: next-unreadable-baseline-keeps-none
tool: run
exit: any
expect: R-88 --next: no filter from a baseline that didn't run
--- write zz-next-baseline.log
error[E0425]: cannot find function `run_faulted` in crate `tally_cli`
error: could not compile `tally-runner` (test "m1_planted") due to 1 previous error
--- run
python3 -I -B -c "
import sys; sys.path.insert(0, 'tools'); import mutants_local as m
e, g, r = m.next_filter(open('zz-next-baseline.log').read(), ['m1_planted'])
print('R-88 --next: no filter from a baseline that didn\'t run' if e is None else 'R-88 --next broken: ' + repr(e))
"

# P55 (issue #108, 2026-11-09): `mutants-local --fences` adds the fences' equivalence tests,
# tools/milestones.toml's `fence_catchers`, as catchers of a local batch: F5's `walk_oracle`
# whole and `tally`'s `walk::lows::tests`. The filter selects each test target by its binary
# and each lib module by its tests' path; an entry that names both a target and a module is
# refused.

case: fences-select-their-tests
tool: run
exit: any
expect: R-88 --fences: binary_id(=tally-cli::walk_oracle) | (binary_id(=tally) & test(/^walk::lows::tests::/))
--- run
python3 -I -B -c "
import sys; sys.path.insert(0, 'tools'); import milestones, mutants_local as m
print('R-88 --fences: ' + m.fence_filter_of(milestones.fence_catchers()))
"

case: fence-catcher-naming-both-is-refused
tool: run
exit: any
expect: each fence_catchers entry is { package, test } or
--- replace tools/milestones.toml
  { package = "tally", lib = "walk::lows::tests::" },
--- with
  { package = "tally", lib = "walk::lows::tests::", test = "walk_oracle" },
--- run
python3 -I -B -c "
import sys; sys.path.insert(0, 'tools'); import milestones
try:
    milestones.fence_catchers()
    print('R-88 --fences: accepted')
except milestones.MilestoneError as e:
    print(e)
"

# 2026-11-12 (the mutation study; the user's "Okay, let's make these changes"): gate 8 runs
# through tools/mutants-gate. The baseline fails on a T test slower than 20 s, which T then
# splits: on a runner 3x slower it would take 60 s, half the profile's 120 s kill, so a kill
# means a hang, not a slow runner.

# Since 2026-11-12 (pick P73, issue #108): the limit is on the median runner. The baseline
# runner's speed is the median, over the tests the plan's history also times, of the
# baseline's time over the history's; each test's time counts over that speed, a test the
# history lacks too. On a runner 1.75x slower every test passes; a test over 20 s there
# still fails, and so does a history too thin to tell the speed.

case: baseline-test-over-20-s
tool: run
expect: FAIL R-88: tally-runner::s_kernel tests::planted_slow took 21.5 s on the median runner, over 20 s
