# R-133 (2026-11-12, the mutation study; the user's "Okay, let's make these changes"): gate 8's
# coverage map is the commit's own. tools/mutants-gate keys the map, the mutants' list and the
# plan with the tree's key, and a shard refuses one whose key isn't its tree's; check-rules
# refuses code the compiler runs in the kernel, which no test's profile records.
#
# The shard cases plant one kernel function, crates/tally/src/walk/zz_gate.rs's `planted`,
# one mutant of it, and a map, a list and a plan that name them. A fake `cargo` in zz-bin/
# answers nextest's build and test runs (every other command goes to the real cargo), so no
# mutant is built for real.

case: map-key-wrong
tool: run
expect: FAIL mutants-gate: the coverage map's key 0000000000000000 isn't this tree's
--- write crates/tally/src/walk/zz_gate.rs
//! Planted for R-133's cases.
pub fn planted() -> u8 {
    7
}
--- write zz-gate/list.in
{"key": "@KEY@", "mutants": [{"name": "crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0", "file": "crates/tally/src/walk/zz_gate.rs", "package": "tally", "genre": "FnValue", "replacement": "0", "function": {"function_name": "planted", "return_type": "-> u8", "span": {"start": {"line": 2, "column": 1}, "end": {"line": 4, "column": 2}}}, "span": {"start": {"line": 3, "column": 5}, "end": {"line": 3, "column": 6}}, "diff": "--- crates/tally/src/walk/zz_gate.rs\n+++ replace planted -> u8 with 0\n@@ -1,4 +1,4 @@\n //! Planted for R-133's cases.\n pub fn planted() -> u8 {\n-    7\n+    0\n }\n"}]}
--- write zz-gate/plan.in
{"key": "@KEY@", "shards": [["crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0"]], "o1": [], "killers": {}, "order": []}
--- write zz-gate/map.in
{"key": "0000000000000000", "args": [], "tests": {"tally-runner::s_kernel tests::planted_t": {"crates/tally/src/walk/zz_gate.rs": [[2, 4]]}}}
--- run
k="$(tools/mutants-gate key)" || exit 1
for f in list plan map; do sed "s/@KEY@/$k/g" "zz-gate/$f.in" > "zz-gate/$f.json"; done
tools/mutants-gate shard 0/1 zz-gate/list.json zz-gate/map.json zz-gate/plan.json zz-gate/out

# The study's planted change (REPORT §4.4): a map made before a kernel file changed is stale.
# The list and the plan are made again after the change, as the baseline job would; the map
# made before it is refused, so its tests can't be used for the changed code.

case: map-key-stale-after-a-change
tool: run
expect: FAIL mutants-gate: the coverage map's key
expect: R-133 planted: the key changed
--- write crates/tally/src/walk/zz_gate.rs
//! Planted for R-133's cases.
pub fn planted() -> u8 {
    7
}
--- write zz-gate/list.in
{"key": "@KEY@", "mutants": [{"name": "crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0", "file": "crates/tally/src/walk/zz_gate.rs", "package": "tally", "genre": "FnValue", "replacement": "0", "function": {"function_name": "planted", "return_type": "-> u8", "span": {"start": {"line": 2, "column": 1}, "end": {"line": 4, "column": 2}}}, "span": {"start": {"line": 3, "column": 5}, "end": {"line": 3, "column": 6}}, "diff": "--- crates/tally/src/walk/zz_gate.rs\n+++ replace planted -> u8 with 0\n@@ -1,4 +1,4 @@\n //! Planted for R-133's cases.\n pub fn planted() -> u8 {\n-    7\n+    0\n }\n"}]}
--- write zz-gate/plan.in
{"key": "@KEY@", "shards": [["crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0"]], "o1": [], "killers": {}, "order": []}
--- write zz-gate/map.in
{"key": "@KEY@", "args": [], "tests": {}}
--- run
before="$(tools/mutants-gate key)" || exit 1
sed "s/@KEY@/$before/g" zz-gate/map.in > zz-gate/map.json
# a change the unmutated output doesn't show, in another kernel file: the map's tests may now enter planted()
printf '\n/// R-133 planted: a check that every caller now runs.\npub fn planted_caller() -> u8 {\n    crate::walk::zz_gate::planted()\n}\n' >> crates/tally/src/walk/zz_gate.rs
after="$(tools/mutants-gate key)" || exit 1
[ "$before" != "$after" ] && echo "R-133 planted: the key changed, $before to $after"
for f in list plan; do sed "s/@KEY@/$after/g" "zz-gate/$f.in" > "zz-gate/$f.json"; done
tools/mutants-gate shard 0/1 zz-gate/list.json zz-gate/map.json zz-gate/plan.json zz-gate/out

# nextest's exit is the verdict only when it is 0 (missed) or 100 (caught); any other exit,
# such as 2, is the run's error and fails the shard, never a verdict. The mutated file is
# put back.

case: nextest-exit-2-fails-the-shard
tool: run
expect: FAIL mutants-gate: crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0: nextest exited 2, which is no verdict
expect: R-133: zz_gate.rs put back
--- write crates/tally/src/walk/zz_gate.rs
//! Planted for R-133's cases.
pub fn planted() -> u8 {
    7
}
--- write zz-bin/cargo
#!/bin/sh
# a fake cargo: nextest's build passes, its test run exits 2; anything else is the real cargo's
if [ "$1" != nextest ]; then exec "$REAL_CARGO" "$@"; fi
case " $* " in *" --no-run "*) exit 0 ;; esac
exit 2
--- write zz-gate/list.in
{"key": "@KEY@", "mutants": [{"name": "crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0", "file": "crates/tally/src/walk/zz_gate.rs", "package": "tally", "genre": "FnValue", "replacement": "0", "function": {"function_name": "planted", "return_type": "-> u8", "span": {"start": {"line": 2, "column": 1}, "end": {"line": 4, "column": 2}}}, "span": {"start": {"line": 3, "column": 5}, "end": {"line": 3, "column": 6}}, "diff": "--- crates/tally/src/walk/zz_gate.rs\n+++ replace planted -> u8 with 0\n@@ -1,4 +1,4 @@\n //! Planted for R-133's cases.\n pub fn planted() -> u8 {\n-    7\n+    0\n }\n"}]}
--- write zz-gate/plan.in
{"key": "@KEY@", "shards": [["crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0"]], "o1": [], "killers": {}, "order": []}
--- write zz-gate/map.in
{"key": "@KEY@", "args": [], "tests": {"tally-runner::s_kernel tests::planted_t": {"crates/tally/src/walk/zz_gate.rs": [[2, 4]]}}}
--- run
cp crates/tally/src/walk/zz_gate.rs zz-gate/original.rs
k="$(tools/mutants-gate key)" || exit 1
for f in list plan map; do sed "s/@KEY@/$k/g" "zz-gate/$f.in" > "zz-gate/$f.json"; done
chmod +x zz-bin/cargo
REAL_CARGO="$(command -v cargo)" PATH="$PWD/zz-bin:$PATH" tools/mutants-gate shard 0/1 zz-gate/list.json zz-gate/map.json zz-gate/plan.json zz-gate/out
cmp -s crates/tally/src/walk/zz_gate.rs zz-gate/original.rs && echo "R-133: zz_gate.rs put back"
exit 1

# A mutant whose function no T test enters is built and, when it builds, missed without a
# test run (R-84): no test can tell it from the code.

case: uncovered-mutant-is-missed-unrun
tool: run
exit: any
expect: "summary": "MissedMutant"
expect: no T test enters the mutated function: missed without a test run
expect: R-133: no test run
--- write crates/tally/src/walk/zz_gate.rs
//! Planted for R-133's cases.
pub fn planted() -> u8 {
    7
}
--- write zz-bin/cargo
#!/bin/sh
# a fake cargo: nextest's build passes, and a test run leaves zz-gate/tests-ran; anything else is the real cargo's
if [ "$1" != nextest ]; then exec "$REAL_CARGO" "$@"; fi
case " $* " in *" --no-run "*) exit 0 ;; esac
touch zz-gate/tests-ran
exit 100
--- write zz-gate/list.in
{"key": "@KEY@", "mutants": [{"name": "crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0", "file": "crates/tally/src/walk/zz_gate.rs", "package": "tally", "genre": "FnValue", "replacement": "0", "function": {"function_name": "planted", "return_type": "-> u8", "span": {"start": {"line": 2, "column": 1}, "end": {"line": 4, "column": 2}}}, "span": {"start": {"line": 3, "column": 5}, "end": {"line": 3, "column": 6}}, "diff": "--- crates/tally/src/walk/zz_gate.rs\n+++ replace planted -> u8 with 0\n@@ -1,4 +1,4 @@\n //! Planted for R-133's cases.\n pub fn planted() -> u8 {\n-    7\n+    0\n }\n"}]}
--- write zz-gate/plan.in
{"key": "@KEY@", "shards": [["crates/tally/src/walk/zz_gate.rs:3:5: replace planted -> u8 with 0"]], "o1": [], "killers": {}, "order": []}
--- write zz-gate/map.in
{"key": "@KEY@", "args": [], "tests": {"tally-runner::s_kernel tests::planted_t": {"crates/tally/src/walk/agenda.rs": [[2, 4]]}}}
--- run
k="$(tools/mutants-gate key)" || exit 1
for f in list plan map; do sed "s/@KEY@/$k/g" "zz-gate/$f.in" > "zz-gate/$f.json"; done
chmod +x zz-bin/cargo
REAL_CARGO="$(command -v cargo)" PATH="$PWD/zz-bin:$PATH" tools/mutants-gate shard 0/1 zz-gate/list.json zz-gate/map.json zz-gate/plan.json zz-gate/out
grep -o '"summary": "MissedMutant"' zz-gate/out/mutants.out/outcomes.json
cat zz-gate/out/mutants.out/log/000-0000.log
[ -e zz-gate/tests-ran ] || echo "R-133: no test run"

# check-rules: no code in the kernel that the compiler runs. A `const fn` called in a
# constant's initializer runs at build time, so no test enters it, and a mutant of it would be
# judged missed without a test run while it changes what the tests see.

case: const-fn-in-the-kernel
tool: run
expect: a `const fn` in the kernel: code run at compile time, which gate 8's coverage map can't see (R-133)
--- write crates/tally/src/walk/zz_gate.rs
//! Planted for R-133's cases.
pub const fn planted() -> u8 {
    7
}
--- run
tools/check-rules

case: static-set-by-a-call-in-the-kernel
tool: run
expect: a `static` set by a call in the kernel: code run at compile time, which gate 8's coverage map can't see (R-133)
--- write crates/tally/src/walk/zz_gate.rs
//! Planted for R-133's cases.
pub static PLANTED: u8 = core::hint::black_box(7);
--- run
tools/check-rules
