# R-110: the exception list equals the committed lock.

case: new-exception-not-locked
tool: run
expect: not in EXCEPTIONS.lock
--- append tests/runner/src/lib.rs
/// Planted.
#[expect(clippy::needless_return, reason = "R-66: a planted exception with a proper reason")]
pub fn planted() -> u8 {
    return 1;
}
--- run
tools/exceptions --check

case: locked-exception-gone
tool: run
expect: in EXCEPTIONS.lock but gone
--- replace deny.toml
  { crate = "syn@2.0.119", reason = "R-55: dev only; zerocopy-derive (criterion via half) is still on syn 2 while serde_derive is on syn 3" },
--- with
--- run
tools/exceptions --check

case: report-only-line-full
# A new report-only hit (R-124's own type parameter) not in the lock fails the full
# check and the commit (the review after S, 2026-11-03, issue #8).
tool: run
expect: not in EXCEPTIONS.lock: report-only
--- module
/// Planted.
pub fn planted<T: Copy>(v: T) -> T {
    v
}
--- run
tools/exceptions --check

case: report-only-line-fast
# The same hit in `check fast` (and so the Stop hook) is a report line, not a failure.
tool: run
exit: any
expect: report-only lines differ from EXCEPTIONS.lock
expect: fast-passed
--- module
/// Planted.
pub fn planted<T: Copy>(v: T) -> T {
    v
}
--- run
tools/exceptions --check --fast && echo fast-passed

case: new-exception-not-locked-fast
# A counted exception missing from the lock fails `check fast` as before.
tool: run
expect: not in EXCEPTIONS.lock: tests
--- append tests/runner/src/lib.rs
/// Planted.
#[expect(clippy::needless_return, reason = "R-66: a planted exception with a proper reason")]
pub fn planted() -> u8 {
    return 1;
}
--- run
tools/exceptions --check --fast
