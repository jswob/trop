# R-80: the rule files and the spec are checksummed (check-frozen); the files the
# builder edits are checked against a frozen copy (check-rules).

case: spec-byte
tool: run
expect: spec: VERSION changed
--- append spec/VERSION
x
--- run
tools/check-frozen

case: spec-new-file
tool: run
expect: spec: planted.md is not listed
--- write spec/planted.md
planted
--- run
tools/check-frozen

case: rule-file-byte
tool: run
expect: rules: engine/clippy.toml changed
--- append clippy.toml
# planted
--- run
tools/check-frozen

case: ast-grep-rule-byte
tool: run
expect: rules: engine/tools/ast-grep/rules/no-float.yml changed
--- append tools/ast-grep/rules/no-float.yml
# planted
--- run
tools/check-frozen

case: new-rule-file
tool: run
expect: is a rule file but not in RULES.sha256
--- write tools/planted.py
# planted
--- run
tools/check-frozen

case: lints-table-edited
tool: run
expect: differs from the frozen copy (R-80)
--- replace Cargo.toml
unwrap_used = "forbid"
--- with
unwrap_used = "deny"
--- run
tools/check-rules

case: profile-edited
tool: run
expect: differs from the frozen copy (R-80)
--- replace Cargo.toml
overflow-checks = true
lto = "fat"
--- with
overflow-checks = false
lto = "fat"
--- run
tools/check-rules

case: member-lints-removed
tool: run
expect: [lints] must be exactly `workspace = true`
--- replace crates/tally/Cargo.toml
[lints]
workspace = true
--- with
[lints.clippy]
unwrap_used = "allow"
--- run
tools/check-rules

case: patch-section
tool: run
expect: a [patch] section (R-80)
--- append Cargo.toml
[patch.crates-io]
itoa = { path = "@FAKES@/itoa-0.0.1" }
--- run
tools/check-rules

case: cargo-config
tool: run
expect: an unexpected config file (R-80)
--- write .cargo/config.toml
[build]
rustflags = ["--cap-lints=allow"]
--- run
tools/check-rules

case: crate-outside-the-workspace
tool: run
expect: isn't a workspace member, so the workspace lints don't reach it
--- write crates/zz-planted/Cargo.toml
[package]
name = "zz-planted"
version = "0.1.0"
edition = "2024"
--- write crates/zz-planted/src/lib.rs
//! Planted.
--- run
tools/check-rules

case: root-script-edited
tool: run
expect: differs from the frozen copy (R-80)
--- replace ../package.json
"engine:check": "cd engine && tools/check full",
--- with
"engine:check": "cd engine && tools/check fast",
--- run
tools/check-rules

case: oracle-byte
tool: run
expect: refcore: refcore/HANDOVER.md changed
--- append tools/refcore/HANDOVER.md
planted
--- run
tools/check-frozen

case: oracle-new-file
tool: run
expect: refcore: refcore/planted.py is not listed
--- write tools/refcore/planted.py
# planted
--- run
tools/check-frozen

case: oracle-off-the-pin
tool: run
expect: engine/tools/refcore_fast/layer.py
--- append tools/refcore_fast/layer.py
# planted
--- run
tools/check-frozen

case: version-off-the-pin
tool: run
expect: but tools/frozen.toml pins
--- append spec/VERSION
tally-9.9
--- run
tools/check-frozen

case: builder-skill-byte
tool: run
expect: rules: .claude/skills/engine-rust/references/numbers.md changed
--- append ../.claude/skills/engine-rust/references/numbers.md
planted
--- run
tools/check-frozen

case: reviewer-agent-byte
tool: run
expect: rules: .claude/agents/engine-reviewer.md changed
--- append ../.claude/agents/engine-reviewer.md
planted
--- run
tools/check-frozen

# The sums tool (the retro after M0, decision 3): any role rewrites the two checksum files,
# but only in a merge, and only when every protected file in it is a parent's version or
# git's clean merge of both. Each case merges in the scratch and takes it all back.

case: sums-outside-a-merge
tool: run
expect: it runs only in a merge
--- run
tools/sums

case: sums-hand-edit-in-a-merge
tool: run
exit: any
expect: so a hand edit (R-112)
--- run
export GIT_AUTHOR_NAME=rules-selftest GIT_AUTHOR_EMAIL=rules-selftest@invalid GIT_COMMITTER_NAME=rules-selftest GIT_COMMITTER_EMAIL=rules-selftest@invalid
start=$(git rev-parse HEAD); here=$(git symbolic-ref --short HEAD)
git switch -qc planted-side && echo '# side' >> clippy.toml && git commit -qam 'planted: side'
git switch -q "$here" && echo '# main' >> tests/GAPS.md && git commit -qam 'planted: main'
git merge -q --no-ff --no-commit planted-side
echo '# by hand' >> sgconfig.yml
tools/sums
git merge --abort; git reset -q --hard "$start"; git branch -qD planted-side

case: sums-clean-merge-passes
tool: run
exit: any
expect: sums: staged engine/tests/TESTS.sha256 and engine/tools/RULES.sha256
--- run
export GIT_AUTHOR_NAME=rules-selftest GIT_AUTHOR_EMAIL=rules-selftest@invalid GIT_COMMITTER_NAME=rules-selftest GIT_COMMITTER_EMAIL=rules-selftest@invalid
start=$(git rev-parse HEAD); here=$(git symbolic-ref --short HEAD)
git switch -qc planted-side && echo '# side' >> clippy.toml && git commit -qam 'planted: side'
git switch -q "$here" && echo '# main' >> tests/GAPS.md && git commit -qam 'planted: main'
git merge -q --no-ff --no-commit planted-side
tools/sums
git merge --abort; git reset -q --hard "$start"; git branch -qD planted-side

case: sums-merge-commit-both-sides-pass
tool: run
exit: any
expect: now `git commit --amend --no-edit`
--- run
export GIT_AUTHOR_NAME=rules-selftest GIT_AUTHOR_EMAIL=rules-selftest@invalid GIT_COMMITTER_NAME=rules-selftest GIT_COMMITTER_EMAIL=rules-selftest@invalid
start=$(git rev-parse HEAD); here=$(git symbolic-ref --short HEAD)
git switch -qc planted-side && echo '# side' >> tests/GAPS.md && git commit -qam 'planted: side'
git switch -q "$here" && { echo '# main'; cat tests/GAPS.md; } > zz-gaps && mv zz-gaps tests/GAPS.md && git commit -qam 'planted: main'
git merge -q --no-ff -m 'planted: the merge' planted-side
tools/sums --check && tools/sums
git reset -q --hard "$start"; git branch -qD planted-side
