# R-52: every dependency is on an allow-list; both runs keep one.

case: unlisted-crate
tool: deny
expect: not-allowed
text: zz-unlisted
--- fake zz-unlisted 0.0.1
--- replace crates/tally/Cargo.toml
[dependencies]
--- with
[dependencies]
zz-unlisted = { path = "@FAKES@/zz-unlisted-0.0.1", version = "0.0.1" }

case: unlisted-crate-shipped
