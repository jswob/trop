# A file changed during a green run: the keys before and after differ, so nothing is kept,
# and the tree as it was before the run is checked again.
case: memo-file-changed-during-the-run
tool: run
exit: any
expect: check quick: the tree changed during the run, so this green isn't remembered
expect: the tree after the run: FAIL planted: the planted step ran
expect: the tree before the run: FAIL planted: the planted step ran
--- write zz_memo.py
"""Planted: as in memo-tracked-file-edited."""
import sys

sys.path.insert(0, "tools")
import check


def red(env, log):
    return "the planted step ran: the memo didn't answer"


def changing(env, log):
    with open("BUILD-LOG.md", "a", encoding="utf-8") as f:
        f.write("planted during the run\n")


what, mode = sys.argv[1], sys.argv[2]
check.steps = lambda m: [("planted", changing if what == "changing" else red, {})]
sys.argv = ["check", mode, *sys.argv[3:]]
sys.exit(check.main())
--- run
unset CI GITHUB_ACTIONS
python3 -I -B zz_memo.py changing quick
python3 -I -B zz_memo.py run quick | sed 's/^/the tree after the run: /'
git checkout -q -- BUILD-LOG.md
python3 -I -B zz_memo.py run quick | sed 's/^/the tree before the run: /'

# Which runs a kept green answers: the same or a larger mode, never with --fresh, never on CI.
case: memo-modes-fresh-and-ci
tool: run
exit: any
expect: quick after a green full: check quick: green on this tree already
expect: commit after a green quick: FAIL planted
expect: quick --fresh: FAIL planted
expect: quick on CI: FAIL planted
expect: quick with CI set: FAIL planted
--- write zz_memo.py
"""Planted: as in memo-tracked-file-edited."""
import sys

sys.path.insert(0, "tools")
import check


def red(env, log):
    return "the planted step ran: the memo didn't answer"


what, mode = sys.argv[1], sys.argv[2]
if what == "keep":
    check.memo_keep(mode, check.memo_key())
else:
    check.steps = lambda m: [("planted", red, {})]
    sys.argv = ["check", mode, *sys.argv[3:]]
    sys.exit(check.main())
--- run
unset CI GITHUB_ACTIONS
python3 -I -B zz_memo.py keep full
python3 -I -B zz_memo.py run quick | sed 's/^/quick after a green full: /'
rm -f target/check-memo/full
python3 -I -B zz_memo.py keep quick
python3 -I -B zz_memo.py run commit | sed 's/^/commit after a green quick: /'
python3 -I -B zz_memo.py run quick --fresh | sed 's/^/quick --fresh: /'
GITHUB_ACTIONS=true python3 -I -B zz_memo.py run quick | sed 's/^/quick on CI: /'
CI=true python3 -I -B zz_memo.py run quick | sed 's/^/quick with CI set: /'
