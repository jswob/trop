# Database Configuration
DB_HOST=localhost
DB_PORT=5440
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=app_db

# Test Database Configuration
TEST_DB_PORT=5441
TEST_DB_NAME=app_test_db

# E2E Database Configuration
E2E_DB_PORT=5442
E2E_DB_NAME=app_e2e_db

# API Configuration
API_PORT=3001

# Web Configuration
WEB_PORT=5173

# Docker Configuration (names the containers and the snapshot volumes; one per app on a machine)
COMPOSE_PROJECT_NAME=app
POSTGRES_CONTAINER_NAME=postgres

# Authentication
AUTH_PASSWORD=your-login-password
JWT_SECRET=your-random-256-bit-hex-string

# LLM evals (apps/evals): one OpenRouter key covers every model
OPENROUTER_API_KEY=

# Security (production only — leave unset for local dev)
# WEB_ORIGIN=https://your-app.vercel.app
